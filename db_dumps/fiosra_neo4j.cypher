UNWIND [{concept_id:"5452be89-53f7-54a8-830a-22612b7bc3ad", kc_id:"5452be89-53f7-54a8-830a-22612b7bc3ad", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply omnichannel strategy: A coordinated approach to customer interactions across channels, including buying, receiving, and returning. Read chapter 18’s brief multi-channel wording alongside section 17.2’s integrated customer experience. Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Apply omnichannel strategy", canonical_key:"apply_omnichannel_strategy", status:"approved"}}, {concept_id:"78713a94-c782-54a3-8e49-26c3d504668f", kc_id:"78713a94-c782-54a3-8e49-26c3d504668f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain online retailing: a business model that allows consumers to search and purchase products remotely over the Internet Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain online retailing", canonical_key:"explain_online_retailing", status:"approved"}}, {concept_id:"26a1f9c0-0d49-5efa-8af0-88addea6ee1c", kc_id:"26a1f9c0-0d49-5efa-8af0-88addea6ee1c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply original markup: the markup a business has decided upon at the onset of the offering, which includes planned sales and overhead Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Apply original markup", canonical_key:"apply_original_markup", status:"approved"}}, {concept_id:"1a13eaf9-d698-56ee-a527-77c92fd0c319", kc_id:"1a13eaf9-d698-56ee-a527-77c92fd0c319", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product traceability: the ability to track all processes for a product from the procurement of raw materials to production, consumption, and disposal Source: chapter 18 Key Terms, printed page 643; related section 18.6.", label:"Explain product traceability", canonical_key:"explain_product_traceability", status:"approved"}}, {concept_id:"2d072e7d-a715-5dae-a062-d7ef22246784", kc_id:"2d072e7d-a715-5dae-a062-d7ef22246784", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain rack jobbers: wholesalers (or manufacturers) that agree with retailers to display and sell a product in a retail store Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain rack jobbers", canonical_key:"explain_rack_jobbers", status:"approved"}}, {concept_id:"7db88ca3-108f-582a-9a9e-a435eecc8ffd", kc_id:"7db88ca3-108f-582a-9a9e-a435eecc8ffd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain regional shopping centers: commonly referred to as “malls”; collection of stores that offer general merchandise or fashion-oriented offerings Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain regional shopping centers", canonical_key:"explain_regional_shopping_centers", status:"approved"}}, {concept_id:"dc4655dc-0d1b-53cf-91e6-69f7f869f2a3", kc_id:"dc4655dc-0d1b-53cf-91e6-69f7f869f2a3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain retailing: the process of selling goods and services to consumers Source: chapter 18 Key Terms, printed page 643; related section 18.1.", label:"Explain retailing", canonical_key:"explain_retailing", status:"approved"}}, {concept_id:"35461780-a1b2-5f1a-8c01-a437ab835bb1", kc_id:"35461780-a1b2-5f1a-8c01-a437ab835bb1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain social commerce: a blend of e-commerce and social media Source: chapter 18 Key Terms, printed page 643; related section 18.4.", label:"Explain social commerce", canonical_key:"explain_social_commerce", status:"approved"}}, {concept_id:"c8e13c6a-a592-5916-aedd-48c727f90a1d", kc_id:"c8e13c6a-a592-5916-aedd-48c727f90a1d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain specialty stores: retailers that focus on selling a single type of product or a single product line Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain specialty stores", canonical_key:"explain_specialty_stores", status:"approved"}}, {concept_id:"00e11ba0-4921-577a-a5a6-b601fcc17818", kc_id:"00e11ba0-4921-577a-a5a6-b601fcc17818", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain specialty wholesalers: wholesalers that focus on a limited line of products but carry the line in some depth Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain specialty wholesalers", canonical_key:"explain_specialty_wholesalers", status:"approved"}}, {concept_id:"e38f143e-d65f-5efa-89a9-5a1fdb6dc281", kc_id:"e38f143e-d65f-5efa-89a9-5a1fdb6dc281", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain store retailer: a traditional brick-and-mortar establishment where products are displayed for customers to purchase Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain store retailer", canonical_key:"explain_store_retailer", status:"approved"}}, {concept_id:"badb245b-4073-57dc-a8ba-9e5b88d7f048", kc_id:"badb245b-4073-57dc-a8ba-9e5b88d7f048", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain strip malls: classified by an attached row of retail stores offering both products and services Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain strip malls", canonical_key:"explain_strip_malls", status:"approved"}}, {concept_id:"cf9b7799-b5b5-5511-a19f-c2c634c9a0e3", kc_id:"cf9b7799-b5b5-5511-a19f-c2c634c9a0e3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain supermarket: retailer that mostly focuses on a product mix of grocery items but also carries household and personal items and offers limited services Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain supermarket", canonical_key:"explain_supermarket", status:"approved"}}, {concept_id:"089ad54d-8265-5491-a077-a8be89df52b7", kc_id:"089ad54d-8265-5491-a077-a8be89df52b7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain superstores: very large retailers that have characteristics of both supermarkets and department stores Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain superstores", canonical_key:"explain_superstores", status:"approved"}}, {concept_id:"59854631-4f4d-5f66-ab1f-ddfe07cfdf90", kc_id:"59854631-4f4d-5f66-ab1f-ddfe07cfdf90", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain telemarketing: the attempted sale, or marketing, of goods and services to potential customers via telephone Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain telemarketing", canonical_key:"explain_telemarketing", status:"approved"}}, {concept_id:"72f3ac0c-6d9a-51a4-a918-79eb0f6d5c35", kc_id:"72f3ac0c-6d9a-51a4-a918-79eb0f6d5c35", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain television home shopping: a business practice in which products or services are sold via television Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain television home shopping", canonical_key:"explain_television_home_shopping", status:"approved"}}, {concept_id:"4cef6d65-ba12-5311-b85f-36e09ea2a177", kc_id:"4cef6d65-ba12-5311-b85f-36e09ea2a177", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain truck jobbers: wholesalers that make calls to retailers carrying goods on a truck Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain truck jobbers", canonical_key:"explain_truck_jobbers", status:"approved"}}, {concept_id:"7606cb39-cbf6-5015-97cb-b4fb73216503", kc_id:"7606cb39-cbf6-5015-97cb-b4fb73216503", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain warehouse clubs: retailers that sell goods in bulk at discounted prices Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain warehouse clubs", canonical_key:"explain_warehouse_clubs", status:"approved"}}, {concept_id:"c13881da-c8ae-5ff8-ab4b-42d25cdc0562", kc_id:"c13881da-c8ae-5ff8-ab4b-42d25cdc0562", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain wholesaling: the business of buying goods in bulk at a discount from a manufacturer or other distribution channel member and selling them retailers for a higher price Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain wholesaling", canonical_key:"explain_wholesaling", status:"approved"}}, {concept_id:"d59a43bc-7192-54de-968b-364e562c4e3f", kc_id:"d59a43bc-7192-54de-968b-364e562c4e3f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain consumer-oriented marketing: marketing strategies focused on customer needs and solving their problems Source: chapter 19 Key Terms, printed page 665; related section 19.4.", label:"Explain consumer-oriented marketing", canonical_key:"explain_consumer_oriented_marketing", status:"approved"}}] AS row
