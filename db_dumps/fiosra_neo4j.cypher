51Z'), rung:2, rationale:"Metacognitive transfer to recognizing agency bias in economic history.", status:"approved", misconception_id:"MISC_INDIA_AS_PASSIVE_TRADE_RECIPIENT_3F1680"}}, {probe_id:"PROBE_36F717A0", properties:{kc_id:"CON_EVALUATING_IMPERIAL_FRAGMENTATION_AS_PROCESS_FD1177", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.154Z'), probe_text:"What major cultural achievements occurred during the post-Mauryan fragmentation period?", created_at:datetime('2026-09-20T10:01:52.154Z'), rung:0, rationale:"Disrupts the decline narrative with specific cultural evidence.", status:"approved", misconception_id:"MISC_FRAGMENTATION_EQUALS_DECLINE_FALLACY_A847DA"}}, {probe_id:"PROBE_1936F305", properties:{kc_id:"CON_EVALUATING_IMPERIAL_FRAGMENTATION_AS_PROCESS_FD1177", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.155Z'), probe_text:"How did regional successor states develop new forms of political legitimacy different from Mauryan centralism?", created_at:datetime('2026-09-20T10:01:52.155Z'), rung:1, rationale:"Re-anchors to political innovation rather than decay.", status:"approved", misconception_id:"MISC_FRAGMENTATION_EQUALS_DECLINE_FALLACY_A847DA"}}, {probe_id:"PROBE_69A0726F", properties:{kc_id:"CON_EVALUATING_IMPERIAL_FRAGMENTATION_AS_PROCESS_FD1177", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.156Z'), probe_text:"Why do historians and students tend to equate political centralization with progress and fragmentation with decline?", created_at:datetime('2026-09-20T10:01:52.156Z'), rung:2, rationale:"Metacognitive recognition of centralization bias in political history.", status:"approved", misconception_id:"MISC_FRAGMENTATION_EQUALS_DECLINE_FALLACY_A847DA"}}, {probe_id:"PROBE_6FB5D558", properties:{kc_id:"CON_ASSESSING_DELHI_SULTANATE_ECONOMIC_POLICIES_EC9E8E", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2