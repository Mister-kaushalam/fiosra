UNWIND [{concept_id:"e516fd62-21d5-5b5f-8da5-60f938c2bafa", kc_id:"e516fd62-21d5-5b5f-8da5-60f938c2bafa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brokers: individuals or businesses that bring buyers and sellers together, usually for a commission Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain brokers", canonical_key:"explain_brokers", status:"approved"}}, {concept_id:"e6fff05e-98a5-547b-b64b-b735d601a68c", kc_id:"e6fff05e-98a5-547b-b64b-b735d601a68c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain business objectives and goals: achievable outcomes that provide a framework for achieving success Source: chapter 4 Key Terms, printed page 148; related section 4.3.", label:"Explain business objectives and goals", canonical_key:"explain_business_objectives_and_goals", status:"approved"}}, {concept_id:"37a5a6c6-bb64-5eb5-94c9-835962801fe3", kc_id:"37a5a6c6-bb64-5eb5-94c9-835962801fe3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain business-to-business (B2B): a transaction or business conducted between one business and another Source: chapter 4 Key Terms, printed page 148; related section 4.1.", label:"Explain business-to-business (B2B)", canonical_key:"explain_business_to_business_b2b", status:"approved"}}, {concept_id:"8fac20af-6f91-545d-8557-299b0a0cdaf8", kc_id:"8fac20af-6f91-545d-8557-299b0a0cdaf8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain buy classes: buying situations that are distinguished on four characteristics: newness to decision makers, number of alternatives to be considered, uncertainty inherent in the buying situation, and the amount of information needed for making a buying decision Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain buy classes", canonical_key:"explain_buy_classes", status:"approved"}}, {concept_id:"01712ec5-cf8e-515f-a047-f8aeac0b5a19", kc_id:"01712ec5-cf8e-515f-a047-f8aeac0b5a19", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain buyers: the people in the buying center who handle the paperwork of the actual purchase Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain buyers", canonical_key:"explain_buyers", status:"approved"}}, {concept_id:"c953315f-0754-5b04-aa2a-93ea089500f5", kc_id:"c953315f-0754-5b04-aa2a-93ea089500f5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain buying center: groups of people within organizations who make purchasing decisions Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain buying center", canonical_key:"explain_buying_center", status:"approved"}}, {concept_id:"0ba18286-8ebe-505b-9823-52b472e7ef9d", kc_id:"0ba18286-8ebe-505b-9823-52b472e7ef9d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain competition: the rivalry between companies selling similar products and services with the goal of achieving revenue, profit and market share growth Source: chapter 4 Key Terms, printed page 148; related section 4.3.", label:"Explain competition", canonical_key:"explain_competition", status:"approved"}}, {concept_id:"54301af1-3258-5ed9-98bb-9d16baab06b7", kc_id:"54301af1-3258-5ed9-98bb-9d16baab06b7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain deciders: the people in the buying center who ultimately determine any part of the entire buying decision Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain deciders", canonical_key:"explain_deciders", status:"approved"}}, {concept_id:"6c31b559-e926-5ef0-b61d-8f7093f6a54f", kc_id:"6c31b559-e926-5ef0-b61d-8f7093f6a54f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze derived demand: market demand for a good or service that results from a demand for a related good or service Source: chapter 4 Key Terms, printed page 148; related section 4.1.", label:"Analyze derived demand", canonical_key:"analyze_derived_demand", status:"approved"}}, {concept_id:"a3386d12-f952-5ee1-a22d-13cdb3e9ed16", kc_id:"a3386d12-f952-5ee1-a22d-13cdb3e9ed16", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze direct demand: the demand for a commodity for direct consumption purposes Source: chapter 4 Key Terms, printed page 148; related section 4.1.", label:"Analyze direct demand", canonical_key:"analyze_direct_demand", status:"approved"}}, {concept_id:"15ca22a6-d126-51d3-99e1-852608afe363", kc_id:"15ca22a6-d126-51d3-99e1-852608afe363", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain economic factors: factors that affect the economy, such as interest rates, tax rates, laws, policies, wages, and government actions Source: chapter 4 Key Terms, printed page 148; related section 4.3.", label:"Explain economic factors", canonical_key:"explain_economic_factors", status:"approved"}}, {concept_id:"e3f758d3-4129-50af-bf26-5f38df6f27ed", kc_id:"e3f758d3-4129-50af-bf26-5f38df6f27ed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain expertise: expert skill or knowledge in a particular field Source: chapter 4 Key Terms, printed page 148; related section 4.3.", label:"Explain expertise", canonical_key:"explain_expertise", status:"approved"}}, {concept_id:"e05d7798-6986-581e-93f4-8c9526867a90", kc_id:"e05d7798-6986-581e-93f4-8c9526867a90", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain Foreign Corrupt Practices Act (FCPA): a US statute that prohibits firms and individuals from paying bribes to foreign officials Source: chapter 4 Key Terms, printed page 148; related section 4.5.", label:"Explain Foreign Corrupt Practices Act (FCPA)", canonical_key:"explain_foreign_corrupt_practices_act_fcpa", status:"approved"}}, {concept_id:"7af6a648-fc41-5e14-a85c-f8c1854b95a7", kc_id:"7af6a648-fc41-5e14-a85c-f8c1854b95a7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain gatekeepers: individuals in the buying center who control information and/or access to decision makers and influencers Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain gatekeepers", canonical_key:"explain_gatekeepers", status:"approved"}}, {concept_id:"4ed011b2-62c2-56d6-bc28-ab9b5096d803", kc_id:"4ed011b2-62c2-56d6-bc28-ab9b5096d803", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain government markets: purchases made by the governing bodies of nations, states, or communities Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain government markets", canonical_key:"explain_government_markets", status:"approved"}}, {concept_id:"a4487939-b0af-5adf-8c16-052cee271cfc", kc_id:"a4487939-b0af-5adf-8c16-052cee271cfc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze influence: the capacity to have an effect on the character, development, or behavior of someone or something Source: chapter 4 Key Terms, printed page 148; related section 4.3.", label:"Analyze influence", canonical_key:"analyze_influence", status:"approved"}}, {concept_id:"69c0119c-3c69-5957-9abc-ab3b1f4bb80d", kc_id:"69c0119c-3c69-5957-9abc-ab3b1f4bb80d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze influencers: individuals whose views influence other members of the buying center in making the final decision Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Analyze influencers", canonical_key:"analyze_influencers", status:"approved"}}, {concept_id:"0ea15e6c-a73a-5680-9941-c3ed8aa02317", kc_id:"0ea15e6c-a73a-5680-9941-c3ed8aa02317", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain initiator: the person in the buying center who first suggests or thinks of the idea of buying the product or service Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain initiator", canonical_key:"explain_initiator", status:"approved"}}, {concept_id:"55cfc922-8301-5485-807a-f12b8dd4087a", kc_id:"55cfc922-8301-5485-807a-f12b8dd4087a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain institutions: organizations, establishments, foundations, societies, or the like devoted to the promotion of a particular cause or program, especially one of a public, educational, or charitable character Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain institutions", canonical_key:"explain_institutions", status:"approved"}}, {concept_id:"c2b92c28-99ab-58d3-8af0-1d6a291a816b", kc_id:"c2b92c28-99ab-58d3-8af0-1d6a291a816b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain modified rebuy: a buying situation in which an individual or organization buys goods that have been purchased previously but changes either the supplier or some element of the previous order Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain modified rebuy", canonical_key:"explain_modified_rebuy", status:"approved"}}] AS row
