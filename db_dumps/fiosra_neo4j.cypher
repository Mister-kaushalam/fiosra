UNWIND [{concept_id:"5c1d035c-54c6-5f77-917e-a0806fee82dc", kc_id:"5c1d035c-54c6-5f77-917e-a0806fee82dc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain puffery: providing unrealistic and unsubstantiated claims about a product Source: chapter 13 Key Terms, printed page 467; related section 13.5.", label:"Explain puffery", canonical_key:"explain_puffery", status:"approved"}}, {concept_id:"d0280934-539c-568f-9507-6ec21d513ad7", kc_id:"d0280934-539c-568f-9507-6ec21d513ad7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain pulsing schedule: process of running steady promotions followed by a period of heavy promotions Source: chapter 13 Key Terms, printed page 467; related section 13.4.", label:"Explain pulsing schedule", canonical_key:"explain_pulsing_schedule", status:"approved"}}, {concept_id:"a69ec8fa-1cba-5136-9453-021db1e95bf1", kc_id:"a69ec8fa-1cba-5136-9453-021db1e95bf1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain rational appeals: information communicated to the consumer based on how they will benefit Source: chapter 13 Key Terms, printed page 467; related section 13.4.", label:"Explain rational appeals", canonical_key:"explain_rational_appeals", status:"approved"}}, {concept_id:"0857462e-8e6c-5894-8b33-0edf3dce2732", kc_id:"0857462e-8e6c-5894-8b33-0edf3dce2732", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain rebates: sales promotion strategy in which consumers must provide key information to a company in exchange for dollars off the product Source: chapter 13 Key Terms, printed page 467; related section 13.1.", label:"Explain rebates", canonical_key:"explain_rebates", status:"approved"}}, {concept_id:"157007ec-8338-5db5-9ad6-cbced84a9107", kc_id:"157007ec-8338-5db5-9ad6-cbced84a9107", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain receiver: intended message recipient Source: chapter 13 Key Terms, printed page 467; related section 13.2.", label:"Explain receiver", canonical_key:"explain_receiver", status:"approved"}}, {concept_id:"eb8da405-085b-5bd4-98d8-00db636eb7ba", kc_id:"eb8da405-085b-5bd4-98d8-00db636eb7ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain return on customer investment (ROCI): a marginal analysis that shows the efficiency of marketing communication spending Source: chapter 13 Key Terms, printed page 467; related section 13.4.", label:"Explain return on customer investment (ROCI)", canonical_key:"explain_return_on_customer_investment_roci", status:"approved"}}, {concept_id:"99df8e89-cd72-5464-9f17-d50c7e1d51f0", kc_id:"99df8e89-cd72-5464-9f17-d50c7e1d51f0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain sales promotion: promotion that creates an incentive to purchase; provides for a fairly immediate increase in sales in the short term Source: chapter 13 Key Terms, printed page 467; related section 13.1.", label:"Explain sales promotion", canonical_key:"explain_sales_promotion", status:"approved"}}, {concept_id:"f797dc40-1770-5664-91bc-f9c3dd0fb66e", kc_id:"f797dc40-1770-5664-91bc-f9c3dd0fb66e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sender: source of a message; can be an organization or person Source: chapter 13 Key Terms, printed page 467; related section 13.2.", label:"Explain sender", canonical_key:"explain_sender", status:"approved"}}, {concept_id:"a2399658-eb18-5f9a-8a38-0d12a4c5ee1d", kc_id:"a2399658-eb18-5f9a-8a38-0d12a4c5ee1d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain advertising: paid communication messages that identify a brand or organization and are intended to reach a large number of recipients Source: chapter 14 Key Terms, printed page 498; related section 14.1.", label:"Explain advertising", canonical_key:"explain_advertising", status:"approved"}}, {concept_id:"3bec54f5-3b14-53fd-bbf9-e63761a90119", kc_id:"3bec54f5-3b14-53fd-bbf9-e63761a90119", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain aided recall: a type of advertising posttest that uses cues to assist a sample audience in recalling brands and products in an advertisement Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain aided recall", canonical_key:"explain_aided_recall", status:"approved"}}, {concept_id:"ab83efc4-4c2f-5648-9195-154c6a105fba", kc_id:"ab83efc4-4c2f-5648-9195-154c6a105fba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain all-you-can-afford approach: advertising budget approach that ensures everything else in the organization is budgeted for and then sets aside the remaining funds for advertising Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain all-you-can-afford approach", canonical_key:"explain_all_you_can_afford_approach", status:"approved"}}, {concept_id:"7a326020-0f87-508e-b02c-96f27d780afc", kc_id:"7a326020-0f87-508e-b02c-96f27d780afc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply attitude tests: a type of advertising posttest that investigates the attitudes of a sample target audience toward a product or service Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply attitude tests", canonical_key:"apply_attitude_tests", status:"approved"}}, {concept_id:"0a429e62-5ab1-5366-824a-87e8ee423082", kc_id:"0a429e62-5ab1-5366-824a-87e8ee423082", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brand awareness: metric used to determine if audiences can recall information about a brand Source: chapter 14 Key Terms, printed page 498; related section 14.3.", label:"Explain brand awareness", canonical_key:"explain_brand_awareness", status:"approved"}}, {concept_id:"88941862-a4f9-594d-a5bd-5e33950dbea1", kc_id:"88941862-a4f9-594d-a5bd-5e33950dbea1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brand recognition: the ability of a campaign audience to recognize and identify a specific brand Source: chapter 14 Key Terms, printed page 498; related section 14.3.", label:"Explain brand recognition", canonical_key:"explain_brand_recognition", status:"approved"}}, {concept_id:"942e93b4-9baa-5ad3-8034-07baca24b72f", kc_id:"942e93b4-9baa-5ad3-8034-07baca24b72f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain comparative advertising: type of advertising that showcases the benefits and values of one product as compared to its competitors Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain comparative advertising", canonical_key:"explain_comparative_advertising", status:"approved"}}, {concept_id:"26fcccdd-d60d-550f-91d6-0d6ffa816f9f", kc_id:"26fcccdd-d60d-550f-91d6-0d6ffa816f9f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain competitive-parity approach: advertising budget strategy that relies on setting budgets based on the expected budgets of competitors Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain competitive-parity approach", canonical_key:"explain_competitive_parity_approach", status:"approved"}}, {concept_id:"6c338792-9e49-597b-a8e3-e8f62d683d87", kc_id:"6c338792-9e49-597b-a8e3-e8f62d683d87", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply conversion rate: the percentage of an audience that has completed a desired action Source: chapter 14 Key Terms, printed page 498; related section 14.3.", label:"Apply conversion rate", canonical_key:"apply_conversion_rate", status:"approved"}}, {concept_id:"f734aea5-1f39-5d5d-8ede-cf7b508e7280", kc_id:"f734aea5-1f39-5d5d-8ede-cf7b508e7280", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain engagement: any interaction with advertising content Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain engagement", canonical_key:"explain_engagement", status:"approved"}}, {concept_id:"acd7256d-dce5-5e57-8b21-f85c78d45a6d", kc_id:"acd7256d-dce5-5e57-8b21-f85c78d45a6d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain frequency: how many times someone is exposed to an advertisement in a given time period or how many times an advertisement is shown in a time period Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain frequency", canonical_key:"explain_frequency", status:"approved"}}, {concept_id:"80b89035-7e0e-53a8-bcff-32a08b447ebd", kc_id:"80b89035-7e0e-53a8-bcff-32a08b447ebd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain impact: how quickly members of the audience receive an advertising message Source: chapter 14 Key Terms, printed page 498; related section 14.4.", label:"Explain impact", canonical_key:"explain_impact", status:"approved"}}] AS row
