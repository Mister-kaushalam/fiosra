UNWIND [{kc_id:"KC_af477ade", properties:{label:"Diwani Administration"}}, {kc_id:"KC_5bdd6b03", properties:{label:"Diwani Administration"}}, {kc_id:"KC_HIST_ANCIEN_REGIME", properties:{bloom_level:2, estimated_difficulty:0.3, domain:"history", description:"Understanding the corporate structure, divine-right monarchy, and institutional gridlock of 18th-century France.", label:"Ancien Régime Social and Institutional Order"}}, {kc_id:"KC_HIST_THREE_ESTATES", properties:{bloom_level:2, estimated_difficulty:0.35, domain:"history", description:"Analyzing the legal divisions between First (Clergy), Second (Nobility), and Third (Commoners/Bourgeoisie) estates and tax exemptions.", label:"The Three Estates and Fiscal Privileges"}}, {kc_id:"KC_HIST_FRENCH_DEBT", properties:{bloom_level:3, estimated_difficulty:0.5, domain:"history", description:"Tracing the sovereign debt crisis from the Seven Years' War and American Revolution, compounding interest, and royal borrowing limits.", label:"Crown Debt and Structural Fiscal Impasse"}}, {kc_id:"KC_HIST_POPULAR_SOV", properties:{bloom_level:3, estimated_difficulty:0.55, domain:"history", description:"Understanding how Enlightenment concepts of natural rights, social contracts, and popular sovereignty challenged divine right.", label:"Enlightenment Philosophy and Popular Sovereignty"}}, {kc_id:"KC_HIST_ESTATES_GENERAL", properties:{bloom_level:4, estimated_difficulty:0.6, domain:"history", description:"Analyzing the electoral process, Cahiers de Doléances, and procedural standoff over voting by order versus voting by head.", label:"Convocation and Voting Crisis of the Estates-General"}}, {kc_id:"KC_HIST_TENNIS_COURT_OATH", properties:{bloom_level:4, estimated_difficulty:0.65, domain:"history", description:"Examining the self-proclamation of the Third Estate as the National Assembly and the pledge to establish a constitutional monarchy.", label:"The National Assembly and Tennis Court Oath"}}, {kc_id:"KC_HIST_BASTILLE_FALL", properties:{bloom_level:4, estimated_difficulty:0.6, domain:"history", description:"Evaluating the tactical panic, gunpowder search, seizure of the fortress, and political intervention of the Parisian urban crowd.", label:"Storming of the Bastille and Popular Mobilization"}}, {kc_id:"KC_HIST_DECL_RIGHTS_MAN", properties:{bloom_level:5, estimated_difficulty:0.7, domain:"history", description:"Analyzing the foundational tenets of civic equality, liberty, property, legal limits, and initial exclusions of women and colonial subjects.", label:"Declaration of the Rights of Man and of the Citizen"}}, {kc_id:"KC_HIST_TIMELINE_SEQUENCING", properties:{bloom_level:2, estimated_difficulty:0.25, domain:"history", description:"Placing events in chronological order and recognizing immediate antecedents vs. broader epochs.", label:"Chronological Reasoning and Periodization"}}, {kc_id:"KC_HIST_CAUSE_AND_EFFECT", properties:{bloom_level:4, estimated_difficulty:0.55, domain:"history", description:"Distinguishing between structural preconditions, medium-term catalysts, and immediate short-term triggers.", label:"Multi-Causal Historical Analysis"}}, {kc_id:"KC_HIST_PRIMARY_SOURCE_ANALYSIS", properties:{bloom_level:4, estimated_difficulty:0.6, domain:"history", description:"Evaluating provenance, audience, purpose, and credibility of historical documents and material evidence.", label:"Primary Source Interrogation and Provenance"}}, {kc_id:"KC_HIST_PERSPECTIVE_AND_BIAS", properties:{bloom_level:4, estimated_difficulty:0.65, domain:"history", description:"Identifying authorial bias, contemporary ideological frameworks, and avoiding anachronistic moralizing.", label:"Historiographical Perspective and Contextualization"}}, {kc_id:"KC_HIST_HISTORICAL_ARGUMENT", properties:{bloom_level:5, estimated_difficulty:0.75, domain:"history", description:"Constructing coherent historiographical claims supported by corroborated primary and secondary sources.", label:"Evidence-Backed Historical Argumentation"}}, {kc_id:"KC_LANG_READING_COMPREHENSION", properties:{bloom_level:2, estimated_difficulty:0.2, domain:"language", description:"Extracting explicit information and decoding implied authorial tone and subtext.", label:"Literal and Inferential Reading Comprehension"}}, {kc_id:"KC_LANG_ARGUMENT_IDENTIFICATION", properties:{bloom_level:3, estimated_difficulty:0.4, domain:"language", description:"Distinguishing central claims, supporting premises, factual assertions, and opinions.", label:"Argument Identification and Claim Parsing"}}, {kc_id:"KC_LANG_EVIDENCE_EVALUATION", properties:{bloom_level:4, estimated_difficulty:0.6, domain:"language", description:"Assessing the sufficiency, relevance, and representative strength of evidence used to support arguments.", label:"Source Credibility and Evidence Evaluation"}}, {kc_id:"KC_LANG_CLAIM_CONSTRUCTION", properties:{bloom_level:5, estimated_difficulty:0.65, domain:"language", description:"Drafting precise, contestable analytical thesis statements backed by warrants and textual justification.", label:"Thesis Formulation and Reasoning Construction"}}, {kc_id:"KC_LANG_STRUCTURED_ESSAY", properties:{bloom_level:5, estimated_difficulty:0.7, domain:"language", description:"Organizing sustained analytical writing with clear transitions, unified paragraphs, and evidence integration.", label:"Structured Analytical Essay Composition"}}] AS row
CREATE (n:KnowledgeComponent{kc_id: row.kc_id}) SET n += row.properties;
