d"}}, {concept_id:"c30163a6-357c-5c63-b770-242308b92e52", kc_id:"c30163a6-357c-5c63-b770-242308b92e52", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply customer-driven marketing strategy: a marketing strategy that shifts the focus from the product or service to its users Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Apply customer-driven marketing strategy", canonical_key:"apply_customer_driven_marketing_strategy", status:"approved"}}, {concept_id:"bb1eceea-8fe6-500e-a1ee-962246abc2fb", kc_id:"bb1eceea-8fe6-500e-a1ee-962246abc2fb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain delight needs: an added value that a customer might receive from a seller without prior expectation or request for the same Source: chapter 1 Key Terms, printed page 38; related section 1.5.", label:"Explain delight needs", canonical_key:"explain_delight_needs", status:"approved"}}, {concept_id:"117a30ec-03c1-5d3e-91ab-d755935bd37a", kc_id:"117a30ec-03c1-5d3e-91ab-d755935bd37a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain desired object: a physical good, service, or experience that consumers expect will satisfy their wants and/or needs Source: chapter 1 Key Terms, printed page 38; related section 1.5.", label:"Explain desired object", canonical_key:"explain_desired_object", status:"approved"}}, {concept_id:"2868dd5a-6cf2-5772-89a3-10f4ef73a487", kc_id:"2868dd5a-6cf2-5772-89a3-10f4ef73a487", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Evaluate ethical marketing: process that emphasizes trustworthy, transparent, social, and culturally sensitive marketing policies Source: chapter 1 Key Terms, printed page 38; related section 1.7.", label:"Evaluate ethical marketing", canonical_key:"evaluate_ethical_marketing", status:"approved"}}, {concept_id:"b61f67d2-121d-51d9-a6ed-c0871b6c9562", kc_id:"b61f67d2-121d-51d9-a6ed-c0871b6c9562", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain exchange process: the process of satisfying a need or want by giving something of value in exchange Source: chapter 1 Key Terms, printed page 38; related section 1.5.", label:"Explain exchange process", canonical_key:"explain_exchange_process", status:"approved"}}, {concept_id:"e1c20505-c18e-5aa9-91ad-911caa20109e", kc_id:"e1c20505-c18e-5aa9-91ad-911caa20109e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain external interested parties: a person or organization that does not have a direct relationship with a company but is affected by the operations of the business Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Explain external interested parties", canonical_key:"explain_external_interested_parties", status:"approved"}}, {concept_id:"c27451e2-b875-5831-a229-8a36da4696fb", kc_id:"c27451e2-b875-5831-a229-8a36da4696fb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze form utility: the value given to a product by virtue of the fact that the materials and components that comprise it have been combined to make the finished product Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Analyze form utility", canonical_key:"analyze_form_utility", status:"approved"}}, {concept_id:"c8a49b26-5145-5115-a489-e98fcb477e36", kc_id:"c8a49b26-5145-5115-a489-e98fcb477e36", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain interested parties: a group that has an interest in a company or organization and can either affect or be affected by it; often referred to as “stakeholders” Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Explain interested parties", canonical_key:"explain_interested_parties", status:"approved"}}, {concept_id:"8827966c-f8c2-5ed8-adce-92c33c165d54", kc_id:"8827966c-f8c2-5ed8-adce-92c33c165d54", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain internal interested parties: those persons whose interest in a company comes through a direct relationship such as employment, ownership, or investment Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Explain internal interested parties", canonical_key:"explain_internal_interested_parties", status:"approved"}}, {concept_id:"2ce97a92-3746-5b02-86eb-620a5f37847f", kc_id:"2ce97a92-3746-5b02-86eb-620a5f37847f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain internal marketing: the promotion of a company’s objectives, products, and services to internal parties, such as employees, owners, managers, and shareholders Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Explain internal marketing", canonical_key:"explain_internal_marketing", status:"approved"}}, {concept_id:"46469fe0-f77c-59fe-bce5-2181e844dba5", kc_id:"46469fe0-f77c-59fe-bce5-2181e844dba5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain internet advertising: a set of tools for delivering promotional messages to people worldwide, using the internet as a global marketing platform Source: chapter 1 Key Terms, printed page 38; related section 1.2.", label:"Explain internet advertising", canonical_key:"explain_internet_advertising", status:"approved"}}, {concept_id:"4dc72be3-9b53-50c9-8733-df4545c10b1b", kc_id:"4dc72be3-9b53-50c9-8733-df4545c10b1b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain macroenvironment: the set of external factors and forces, not controlled by the company, that influence its operations Source: chapter 1 Key Terms, printed page 38; related section 1.3.", label:"Explain macroenvironment", canonical_key:"explain_macroenvironment", status:"approved"}}, {concept_id:"a133dce9-5c76-57a7-95f7-de94c7834e21", kc_id:"a133dce9-5c76-57a7-95f7-de94c7834e21", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing: the activities a company undertakes to promote the buying or selling of a product or service Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Explain marketing", canonical_key:"explain_marketing", status:"approved"}}] AS row
