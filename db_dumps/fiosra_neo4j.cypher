UNWIND [{concept_id:"e28c05dd-0cf8-5cc7-aab5-bfdaa223ab89", kc_id:"e28c05dd-0cf8-5cc7-aab5-bfdaa223ab89", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain discount store: retailer that sells a broad range of products at lower prices than competitors Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain discount store", canonical_key:"explain_discount_store", status:"approved"}}, {concept_id:"5630bd82-0b2e-5788-a8a2-1235a4a2e2a8", kc_id:"5630bd82-0b2e-5788-a8a2-1235a4a2e2a8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain drop shippers: a wholesaler business model where retailers use suppliers to ship products directly to the end consumer Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain drop shippers", canonical_key:"explain_drop_shippers", status:"approved"}}, {concept_id:"9cd9e7b5-c800-5c69-9e76-259e567e9b6f", kc_id:"9cd9e7b5-c800-5c69-9e76-259e567e9b6f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain factory outlets: retailers that offer overstocked merchandise at discounted prices Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain factory outlets", canonical_key:"explain_factory_outlets", status:"approved"}}, {concept_id:"610526bf-7345-5bd4-8854-af8b626e9c50", kc_id:"610526bf-7345-5bd4-8854-af8b626e9c50", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Evaluate false or misleading advertising: an unethical marketing practice by which consumers are given false or misleading information about a product or service Source: chapter 18 Key Terms, printed page 643; related section 18.7.", label:"Evaluate false or misleading advertising", canonical_key:"evaluate_false_or_misleading_advertising", status:"approved"}}, {concept_id:"982b2c74-c4df-5efd-aa83-4f72d30b0479", kc_id:"982b2c74-c4df-5efd-aa83-4f72d30b0479", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain freestanding retail locations: store retailers that are not attached to any other retailer or establishment Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain freestanding retail locations", canonical_key:"explain_freestanding_retail_locations", status:"approved"}}, {concept_id:"9260a982-846a-5f79-8da0-359eb21d6377", kc_id:"9260a982-846a-5f79-8da0-359eb21d6377", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain full-service wholesalers: wholesalers that offer retailers the most complete range of services, such as buying, selling, storage, transportation, sorting, and financing Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain full-service wholesalers", canonical_key:"explain_full_service_wholesalers", status:"approved"}}, {concept_id:"409d613e-b7bd-5590-883b-4831468f3128", kc_id:"409d613e-b7bd-5590-883b-4831468f3128", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain general-merchandise (full-line) wholesalers: wholesalers that offer an extensive list of merchandise for sale Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain general-merchandise (full-line) wholesalers", canonical_key:"explain_general_merchandise_full_line_wholesaler", status:"approved"}}, {concept_id:"badef868-8bb4-5608-8a04-38deaaa18cd6", kc_id:"badef868-8bb4-5608-8a04-38deaaa18cd6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply gross margin: net sales minus the cost of goods sold Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Apply gross margin", canonical_key:"apply_gross_margin", status:"approved"}}, {concept_id:"50fc5373-2136-5aad-b5a2-30428f8558e9", kc_id:"50fc5373-2136-5aad-b5a2-30428f8558e9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain intermediaries: companies that act as liaisons between the buyer and seller Source: chapter 18 Key Terms, printed page 643; related section 18.1.", label:"Explain intermediaries", canonical_key:"explain_intermediaries", status:"approved"}}, {concept_id:"f2e7fd64-2ab9-5629-94f3-7dd1507ec890", kc_id:"f2e7fd64-2ab9-5629-94f3-7dd1507ec890", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply keystone pricing: a pricing strategy that doubles the price from the wholesaler or manufacturer Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Apply keystone pricing", canonical_key:"apply_keystone_pricing", status:"approved"}}, {concept_id:"2a076171-7a0f-569d-9668-53329da90206", kc_id:"2a076171-7a0f-569d-9668-53329da90206", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain limited-service wholesalers: wholesalers that offer a limited range of services to retailers to increase value Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain limited-service wholesalers", canonical_key:"explain_limited_service_wholesalers", status:"approved"}}, {concept_id:"2b6cef5f-bdb6-51a0-95e6-bfb850a37588", kc_id:"2b6cef5f-bdb6-51a0-95e6-bfb850a37588", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply maintained markup: the actual markup on the merchandise that is sold to the consumer Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Apply maintained markup", canonical_key:"apply_maintained_markup", status:"approved"}}, {concept_id:"20155a3a-b0b3-5e14-80d8-d370acbed896", kc_id:"20155a3a-b0b3-5e14-80d8-d370acbed896", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain manufacturer’s agents: independent contractors who act as salespeople for multiple manufacturers to sell similar (but not competing) products to retailers Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain manufacturer’s agents", canonical_key:"explain_manufacturer_s_agents", status:"approved"}}, {concept_id:"fd8f845a-501c-5f83-82e3-744aba0b9651", kc_id:"fd8f845a-501c-5f83-82e3-744aba0b9651", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain markdown: a price decrease for a product that is at the end of its life cycle or season Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain markdown", canonical_key:"explain_markdown", status:"approved"}}, {concept_id:"86156539-cfc6-523b-88f7-e1656042c6bd", kc_id:"86156539-cfc6-523b-88f7-e1656042c6bd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply markup: the amount added to the cost retailers purchase goods for Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Apply markup", canonical_key:"apply_markup", status:"approved"}}, {concept_id:"8044f13e-7cff-5f73-ab8b-08f97d9657ca", kc_id:"8044f13e-7cff-5f73-ab8b-08f97d9657ca", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain merchandise: the goods that are being offered for sale by a retailer Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain merchandise", canonical_key:"explain_merchandise", status:"approved"}}, {concept_id:"58b87da8-fd05-55f3-8bad-6ed851a85f61", kc_id:"58b87da8-fd05-55f3-8bad-6ed851a85f61", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain merchant wholesalers: wholesalers that engage in buying, storing, and physically handling products in large quantities and selling those products in smaller quantities to retailers Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain merchant wholesalers", canonical_key:"explain_merchant_wholesalers", status:"approved"}}, {concept_id:"075f032b-588b-548d-ae2d-ad7409af5622", kc_id:"075f032b-588b-548d-ae2d-ad7409af5622", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain non-store retailers: retailers that operate outside of traditional brick-and-mortar locations Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain non-store retailers", canonical_key:"explain_non_store_retailers", status:"approved"}}, {concept_id:"57cde906-e62a-55e2-ac29-9d9910bd347f", kc_id:"57cde906-e62a-55e2-ac29-9d9910bd347f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain off-price retailers: retailers that provide high-quality goods at lower prices Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain off-price retailers", canonical_key:"explain_off_price_retailers", status:"approved"}}, {concept_id:"4c6f91ab-ec1f-5682-937f-f5b462a415f7", kc_id:"4c6f91ab-ec1f-5682-937f-f5b462a415f7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain omnichannel marketing: Coordination of multiple channels into a connected customer experience. The brief chapter 18 glossary wording emphasizes multiple channels; the connected purchasing, receiving, and returning perspective in section 17.2 clarifies how this differs from merely multichannel operation. Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain omnichannel marketing", canonical_key:"explain_omnichannel_marketing", status:"approved"}}] AS row
