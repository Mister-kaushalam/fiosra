etime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain occupation: an activity or task with which one occupies oneself, usually the productive activity, service, trade, or craft for which one is regularly paid Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain occupation", canonical_key:"explain_occupation", status:"approved"}}, {concept_id:"93f6befe-072d-5978-932b-d6bbbd74eb0f", kc_id:"93f6befe-072d-5978-932b-d6bbbd74eb0f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain perception: the manner in which sensory information is organized, interpreted, and consciously experienced Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain perception", canonical_key:"explain_perception", status:"approved"}}, {concept_id:"e9ec1776-8341-58a1-b024-8ed3722c2a18", kc_id:"e9ec1776-8341-58a1-b024-8ed3722c2a18", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain personality: the combination of characteristics or qualities that form an individual’s distinctive character Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain personality", canonical_key:"explain_personality", status:"approved"}}, {concept_id:"56a8ce97-bb7e-5cf1-8c72-ab571ecc8278", kc_id:"56a8ce97-bb7e-5cf1-8c72-ab571ecc8278", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product differentiation: a marketing strategy in which a brand identifies the one thing that makes it genuinely different from competitors Source: chapter 3 Key Terms, printed page 120; related section 3.4.", label:"Explain product differentiation", canonical_key:"explain_product_differentiation", status:"approved"}}, {concept_id:"882b021e-21a4-57db-9a16-632e106ad508", kc_id:"882b021e-21a4-57db-9a16-632e106ad508", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain reference groups: groups that consumers compare themselves to or associate with Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain reference groups", canonical_key:"explain_reference_groups", status:"approved"}}, {concept_id:"7e8c3b26-5a25-5bbb-84e0-24d9cf926110", kc_id:"7e8c3b26-5a25-5bbb-84e0-24d9cf926110", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze roles: the set of norms, values, behaviors, and personality characteristics attached to a status Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Analyze roles", canonical_key:"analyze_roles", status:"approved"}}, {concept_id:"0ed7d359-41e9-59ed-bfcc-7634684d5d81", kc_id:"0ed7d359-41e9-59ed-bfcc-7634684d5d81", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain selective attention: the process of directing one’s awareness to relevant stimuli while ignoring irrelevant stimuli in the environment Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain selective attention", canonical_key:"explain_selective_attention", status:"approved"}}, {concept_id:"f073bf90-ee4a-5f26-a763-c16a67daf923", kc_id:"f073bf90-ee4a-5f26-a763-c16a67daf923", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"threshold", definition:"Analyze selective distortion: a tendency of people to interpret information in a manner that supports what they already believe Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Analyze selective distortion", canonical_key:"analyze_selective_distortion", status:"approved"}}, {concept_id:"288ba33b-d932-5fb8-b20e-2364e8203ebd", kc_id:"288ba33b-d932-5fb8-b20e-2364e8203ebd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain selective retention: the tendency of people to retain only part of the information to which they are exposed Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain selective retention", canonical_key:"explain_selective_retention", status:"approved"}}, {concept_id:"babb9135-7eab-5d81-81da-9cda10636f13", kc_id:"babb9135-7eab-5d81-81da-9cda10636f13", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain social class: a group of people within a society that possesses the same or similar socioeconomic status Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain social class", canonical_key:"explain_social_class", status:"approved"}}, {concept_id:"9ab58cad-6f42-5f9b-aeb9-14ecaf42e397", kc_id:"9ab58cad-6f42-5f9b-aeb9-14ecaf42e397", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain social factors: factors that are prevalent in the society where a consumer lives Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain social factors", canonical_key:"explain_social_factors", status:"approved"}}, {concept_id:"c1264d51-7ec8-554a-a8cb-1a3030a0eb53", kc_id:"c1264d51-7ec8-554a-a8cb-1a3030a0eb53", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze status: the relative social, professional, or other standing of an individual Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Analyze status", canonical_key:"analyze_status", status:"approved"}}, {concept_id:"53e65cfc-5591-5183-b569-a042340f2ffb", kc_id:"53e65cfc-5591-5183-b569-a042340f2ffb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain subculture: a cultural group within a larger culture, often having beliefs or interests at variance with those in the larger culture Source: chapter 3 Key Terms, printed page 120; related section 3.2.", label:"Explain subculture", canonical_key:"explain_subculture", status:"approved"}}, {concept_id:"7b194f65-b823-5f5c-ab92-e5c9a75bd5e9", kc_id:"7b194f65-b823-5f5c-ab92-e5c9a75bd5e9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain variety-seeking buying behavior: the buying tendencies of consumers who do not have a high involvement with a product when there are significant differences between brands Source: chapter 3 Key Terms, printed page 120; related section 3.1.", label:"Explain variety-seeking buying behavior", canonical_key:"explain_variety_seeking_buying_behavior", status:"approved"}}, {concept_id:"2a818560-7359-5b1d-8129-67950a461884", kc_id:"2a818560-7359-5b1d-8129-67950a461884", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain authority: the right to give orders, supervise the work of others, and make certain decisions Source: chapter 4 Key Terms, printed page 148; related section 4.2.", label:"Explain authority", canonical_key:"explain_authority", status:"approved"}}, {concept_id:"683ca285-be29-5516-9d65-5c6e03acf330", kc_id:"683ca285-be29-5516-9d65-5c6e03acf330", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain B2B buying process: encompasses 8 stages: problem recognition, need description, product specification, supplier search, proposal selection, supplier selection, order-routine specification, performance review Source: chapter 4 Key Terms, printed page 148; related section 4.4.", label:"Explain B2B buying process", canonical_key:"explain_b2b_buying_process", status:"approved"}}, {concept_id:"e7e813dc-63cd-5840-a30e-b7bf592ea4a5", kc_id:"e7e813dc-63cd-5840-a30e-b7bf592ea4a5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain bill of materials: a comprehensive inventory of the raw materials, assemblies, subassemblies, parts, and components Source: chapter 4 Key Terms, printed page 148; related section 4.4.", label:"Explain bill of materials", canonical_key:"explain_bill_of_materials", status:"approved"}}] AS row
