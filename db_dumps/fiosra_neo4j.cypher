UNWIND [{concept_id:"c219507a-9f2a-5b63-80dd-b72fe708cab4", kc_id:"c219507a-9f2a-5b63-80dd-b72fe708cab4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing concept: marketing philosophy that firms should analyze the needs of their customers and then make decisions to satisfy those needs better than the competition Source: chapter 1 Key Terms, printed page 38; related section 1.4.", label:"Explain marketing concept", canonical_key:"explain_marketing_concept", status:"approved"}}, {concept_id:"8bfc0c6b-e28e-5ce1-a5f1-1d2c2ebfd5b2", kc_id:"8bfc0c6b-e28e-5ce1-a5f1-1d2c2ebfd5b2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing environment: all of the internal and external factors that drive and influence an organization’s marketing activities Source: chapter 1 Key Terms, printed page 38; related section 1.3.", label:"Explain marketing environment", canonical_key:"explain_marketing_environment", status:"approved"}}, {concept_id:"41c8f5e6-df58-50a3-b822-0d11051d2685", kc_id:"41c8f5e6-df58-50a3-b822-0d11051d2685", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing mix: the set of actions or tactics that a company uses to promote its brand or product in the market Source: chapter 1 Key Terms, printed page 38; related section 1.2.", label:"Explain marketing mix", canonical_key:"explain_marketing_mix", status:"approved"}}, {concept_id:"dbbc7b44-c133-5838-a0b7-8a5762ddf061", kc_id:"dbbc7b44-c133-5838-a0b7-8a5762ddf061", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing process: the series of steps that assist businesses in planning, analyzing, implementing, and adjusting their marketing strategy Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Explain marketing process", canonical_key:"explain_marketing_process", status:"approved"}}, {concept_id:"e79ed921-3d80-5123-a146-3690a80a07ce", kc_id:"e79ed921-3d80-5123-a146-3690a80a07ce", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply marketing strategy: a plan of action designed to promote or sell a product or service Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Apply marketing strategy", canonical_key:"apply_marketing_strategy", status:"approved"}}, {concept_id:"60e5b0a6-1376-5e4b-a939-1b022f5c3572", kc_id:"60e5b0a6-1376-5e4b-a939-1b022f5c3572", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain microenvironment: those factors or elements in a firm’s immediate environment that affect its performance and decision-making Source: chapter 1 Key Terms, printed page 38; related section 1.3.", label:"Explain microenvironment", canonical_key:"explain_microenvironment", status:"approved"}}, {concept_id:"e47ec223-5c22-56eb-986e-ff9d8c819989", kc_id:"e47ec223-5c22-56eb-986e-ff9d8c819989", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain organizational culture: beliefs and behaviors that determine how a company’s employees and management interact and handle customer relationships Source: chapter 1 Key Terms, printed page 38; related section 1.3.", label:"Explain organizational culture", canonical_key:"explain_organizational_culture", status:"approved"}}, {concept_id:"ee998526-97c9-5ec3-9a7f-8f263b12eafd", kc_id:"ee998526-97c9-5ec3-9a7f-8f263b12eafd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply PESTLE analysis: a strategic framework used to assess the political, economic, social, technological, legal, and environmental factors affecting an organization Source: chapter 1 Key Terms, printed page 38; related section 1.3.", label:"Apply PESTLE analysis", canonical_key:"apply_pestle_analysis", status:"approved"}}, {concept_id:"cf215412-07f9-593b-990f-42d233afdedb", kc_id:"cf215412-07f9-593b-990f-42d233afdedb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain place: the geographical location in which the company sells its products and/or provides its services Source: chapter 1 Key Terms, printed page 38; related section 1.2.", label:"Explain place", canonical_key:"explain_place", status:"approved"}}, {concept_id:"cbb37df9-c4d5-5086-8fca-41c743883c42", kc_id:"cbb37df9-c4d5-5086-8fca-41c743883c42", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze place utility: making goods and/or services physically available or accessible to potential customers Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Analyze place utility", canonical_key:"analyze_place_utility", status:"approved"}}, {concept_id:"35041794-f127-5a1e-a1ef-a592237c7df2", kc_id:"35041794-f127-5a1e-a1ef-a592237c7df2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze possession utility: the amount of usefulness or perceived value from owning a product Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Analyze possession utility", canonical_key:"analyze_possession_utility", status:"approved"}}, {concept_id:"638d7624-95f1-5a74-b479-371ef1372194", kc_id:"638d7624-95f1-5a74-b479-371ef1372194", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain price: the cost that consumers pay in order to acquire a product or service Source: chapter 1 Key Terms, printed page 38; related section 1.2.", label:"Explain price", canonical_key:"explain_price", status:"approved"}}, {concept_id:"2deb6ad9-6e70-5979-b97b-ca7414ce3308", kc_id:"2deb6ad9-6e70-5979-b97b-ca7414ce3308", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product: anything that can be offered to a market that might satisfy a want or need Source: chapter 1 Key Terms, printed page 38; related section 1.1.", label:"Explain product", canonical_key:"explain_product", status:"approved"}}, {concept_id:"9b883aec-8ca0-5832-975b-a7dac24868e0", kc_id:"9b883aec-8ca0-5832-975b-a7dac24868e0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product concept: the orientation that consumers will favor those products that offer the most quality, performance, or innovative features Source: chapter 1 Key Terms, printed page 38; related section 1.4.", label:"Explain product concept", canonical_key:"explain_product_concept", status:"approved"}}, {concept_id:"0e2bd26f-772e-578e-ae5c-1e702d60a594", kc_id:"0e2bd26f-772e-578e-ae5c-1e702d60a594", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain production concept: the orientation that consumers will always acquire products that are cheaper and more readily available Source: chapter 1 Key Terms, printed page 38; related section 1.4.", label:"Explain production concept", canonical_key:"explain_production_concept", status:"approved"}}, {concept_id:"2ed14598-0906-5cb0-a256-337e2067468e", kc_id:"2ed14598-0906-5cb0-a256-337e2067468e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain promotion: any type of marketing communication used to inform audiences of the relative merits or a product, service, or brand Source: chapter 1 Key Terms, printed page 38; related section 1.2.", label:"Explain promotion", canonical_key:"explain_promotion", status:"approved"}}, {concept_id:"605f067b-e693-5935-ae86-a1a0a3481890", kc_id:"605f067b-e693-5935-ae86-a1a0a3481890", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain real needs: the value the customer is going to derive from the stated good or service Source: chapter 1 Key Terms, printed page 38; related section 1.5.", label:"Explain real needs", canonical_key:"explain_real_needs", status:"approved"}}, {concept_id:"d1600bab-0621-53e4-95f8-5210c3d7fa2d", kc_id:"d1600bab-0621-53e4-95f8-5210c3d7fa2d", properties:{course_id:"