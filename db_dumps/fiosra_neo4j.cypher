16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain product development: the sixth step in the new product development process, in which a potential new product undergoes development; may include the creation of a prototype Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain product development", canonical_key:"explain_product_development", status:"approved"}}, {concept_id:"7f8adf65-2055-5288-a9c3-4677f6deefd2", kc_id:"7f8adf65-2055-5288-a9c3-4677f6deefd2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product evaluation: the third stage in the consumer adoption process, in which consumers examine, compare, and evaluate the product prior to purchase Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain product evaluation", canonical_key:"explain_product_evaluation", status:"approved"}}, {concept_id:"bba12909-eb54-5783-a466-e24eea51694d", kc_id:"bba12909-eb54-5783-a466-e24eea51694d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product idea: concept of a new product that a company could potentially offer to the market Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain product idea", canonical_key:"explain_product_idea", status:"approved"}}, {concept_id:"b02dac22-aa07-56e0-8ad7-b94a5a6fb6b9", kc_id:"b02dac22-aa07-56e0-8ad7-b94a5a6fb6b9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product interest: stage in the consumer adoption process in which the product has piqued the 