UNWIND [{concept_id:"87b83be5-e36e-5e19-979d-c84b26b951bd", kc_id:"87b83be5-e36e-5e19-979d-c84b26b951bd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain dynamically continuous innovation: changes to a product or service that require little change to consumer habits Source: chapter 10 Key Terms, printed page 366; related section 10.1.", label:"Explain dynamically continuous innovation", canonical_key:"explain_dynamically_continuous_innovation", status:"approved"}}, {concept_id:"44f3b780-75d6-5941-961e-5c3acfbca81b", kc_id:"44f3b780-75d6-5941-961e-5c3acfbca81b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain early adopters: consumers who are willing to try new products typically before others but not as early as innovators Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain early adopters", canonical_key:"explain_early_adopters", status:"approved"}}, {concept_id:"df15fc9d-58b4-5da0-a0f6-92f7bb0266aa", kc_id:"df15fc9d-58b4-5da0-a0f6-92f7bb0266aa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain early majority: consumers who are initially reluctant to risk trying a new product but accept innovation Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain early majority", canonical_key:"explain_early_majority", status:"approved"}}, {concept_id:"7ddd75df-e373-5f41-8585-b46b6c95a544", kc_id:"7ddd75df-e373-5f41-8585-b46b6c95a544", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain evaluation of results: the ninth and final step in the new product development process, in which a company evaluates product launch performance based on predetermined metrics Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain evaluation of results", canonical_key:"explain_evaluation_of_results", status:"approved"}}, {concept_id:"9bb77256-3c0a-55f3-b10a-1d1cbf8e1aa4", kc_id:"9bb77256-3c0a-55f3-b10a-1d1cbf8e1aa4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain external sources: in product development, sources of ideas for new products or services from those outside the organization Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain external sources", canonical_key:"explain_external_sources", status:"approved"}}, {concept_id:"8472270f-f0a2-5580-96e3-70c50a4757cc", kc_id:"8472270f-f0a2-5580-96e3-70c50a4757cc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain idea generation: the first step in the new product development process, in which many new ideas for a product are developed Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain idea generation", canonical_key:"explain_idea_generation", status:"approved"}}, {concept_id:"e3307b1b-fb94-5fc6-85b9-98964de41d57", kc_id:"e3307b1b-fb94-5fc6-85b9-98964de41d57", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain idea screening and evaluation: the second step in the new product development process, in which ideas are filtered to those most likely to turn a profit Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain idea screening and evaluation", canonical_key:"explain_idea_screening_and_evaluation", status:"approved"}}, {concept_id:"9857bd94-d259-54e8-bddb-8a03e9541890", kc_id:"9857bd94-d259-54e8-bddb-8a03e9541890", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain improvements and revisions to existing products: improvements to existing products that fine tune or perfect them Source: chapter 10 Key Terms, printed page 366; related section 10.1.", label:"Explain improvements and revisions to existing products", canonical_key:"explain_improvements_and_revisions_to_existing_p", status:"approved"}}, {concept_id:"23f9d62b-a877-5549-ae3a-3bee2e1076f8", kc_id:"23f9d62b-a877-5549-ae3a-3bee2e1076f8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain innovators: consumers who are the first to take a risk and buy new products as soon as they are available Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain innovators", canonical_key:"explain_innovators", status:"approved"}}, {concept_id:"26e2205a-68d6-56a7-971b-eed75c6de909", kc_id:"26e2205a-68d6-56a7-971b-eed75c6de909", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain intellectual property: collective term used to describe patents, copyrights, and trademarks Source: chapter 10 Key Terms, printed page 366; related section 10.6.", label:"Explain intellectual property", canonical_key:"explain_intellectual_property", status:"approved"}}, {concept_id:"c7cdf399-0654-544c-adbf-d39eac3e4f39", kc_id:"c7cdf399-0654-544c-adbf-d39eac3e4f39", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain internal sources: in product development, sources of ideas for new products or services from those inside the organization Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain internal sources", canonical_key:"explain_internal_sources", status:"approved"}}, {concept_id:"ee4a52d1-9ed7-5f05-893c-7a4b0cea11a6", kc_id:"ee4a52d1-9ed7-5f05-893c-7a4b0cea11a6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain laggards: consumers who are skeptical of new ideas and are reluctant to try new products Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain laggards", canonical_key:"explain_laggards", status:"approved"}}, {concept_id:"f8f55ba9-dc9e-5487-9fa3-b9a9961b926d", kc_id:"f8f55ba9-dc9e-5487-9fa3-b9a9961b926d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain late majority: consumers who are slow to catch on to the popularity of new services, products, ideas, or solutions Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain late majority", canonical_key:"explain_late_majority", status:"approved"}}, {concept_id:"640ee4dc-8a57-5406-ab96-d3bb7318adf0", kc_id:"640ee4dc-8a57-5406-ab96-d3bb7318adf0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain market attractiveness: the measure of potential value; considers factors like short- and long-term profit, market growth rate, how much competition currently exists in the market, the cost of entry into the market, and how much the product satisfies the needs of customers in the target market Source: chapter 10 Key Terms, printed page 366; related section 10.4.", label:"Explain market attractiveness", canonical_key:"explain_market_attractiveness", status:"approved"}}, {concept_id:"a9c7dac0-85b7-5134-bef6-eddd6e6b0775", kc_id:"a9c7dac0-85b7-5134-bef6-eddd6e6b0775", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply market strategy development: the fourth step in the new product development process, in which a preliminary marketing strategy is developed Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Apply market strategy development", canonical_key:"apply_market_strategy_development", status:"approved"}}, {concept_id:"501e06a9-1bfe-5ac9-881a-792ee0118cd6", kc_id:"501e06a9-1bfe-5ac9-881a-792ee0118cd6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze marketing synergy: the fit between the needs of the new product development project and the company’s marketing capabilities Source: chapter 10 Key Terms, printed page 366; related section 10.4.", label:"Analyze marketing synergy", canonical_key:"analyze_marketing_synergy", status:"approved"}}, {concept_id:"c57534cb-95e6-5639-afda-8bf9952542f5", kc_id:"c57534cb-95e6-5639-afda-8bf9952542f5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain new-to-the-firm products: products that are new to a company but not to the world Source: chapter 10 Key Terms, printed page 366; related section 10.1.", label:"Explain new-to-the-firm products", canonical_key:"explain_new_to_the_firm_products", status:"approved"}}, {concept_id:"c706dc10-1990-5baf-b7a9-400c9c8a5005", kc_id:"c706dc10-1990-5baf-b7a9-400c9c8a5005", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain new-to-the-world products: new product inventions that create new markets Source: chapter 10 Key Terms, printed page 366; related section 10.1.", label:"Explain new-to-the-world products", canonical_key:"explain_new_to_the_world_products", status:"approved"}}, {concept_id:"2f9ef406-055c-5f02-aee1-66d68afb96dd", kc_id:"2f9ef406-055c-5f02-aee1-66d68afb96dd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain patents: the right to exclude others from making, using, or offering for sale an invention Source: chapter 10 Key Terms, printed page 366; related section 10.6.", label:"Explain patents", canonical_key:"explain_patents", status:"approved"}}, {concept_id:"ffc6018f-7c16-558d-bf23-525754143921", kc_id:"ffc6018f-7c16-558d-bf23-525754143921", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze personal influence: communication between individuals in which individuals can affect the purchasing decision of others because of their authority, knowledge, or position Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Analyze personal influence", canonical_key:"analyze_personal_influence", status:"approved"}}] AS row
