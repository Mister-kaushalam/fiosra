UNWIND [{concept_id:"4edb4a93-4946-5d66-a681-4009461cbc46", kc_id:"4edb4a93-4946-5d66-a681-4009461cbc46", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess affordable, percentage-of-sales, competitive parity, objective-and-task, and return-based budgeting against campaign goals and constraints. Source: section 14.2, printed page 477.", label:"Compare advertising budget methods", canonical_key:"compare_advertising_budget_methods", status:"approved"}}, {concept_id:"e62bdda5-17dc-56db-aacf-854821b02c4c", kc_id:"e62bdda5-17dc-56db-aacf-854821b02c4c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Match portfolio, jury, theater, recall, attitude, inquiry, and sales tests to timing and the outcome each can actually measure. Source: section 14.2, printed page 477.", label:"Compare pretests and posttests", canonical_key:"compare_pretests_and_posttests", status:"approved"}}, {concept_id:"982e7976-6543-5d05-b809-1f5884c16356", kc_id:"982e7976-6543-5d05-b809-1f5884c16356", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Compare credibility, image, leads, and cost advantages with limited message control, uncertain coverage, and measurement difficulty. Source: section 14.5, printed page 492.", label:"Assess public relations trade-offs", canonical_key:"assess_public_relations_trade_offs", status:"approved"}}, {concept_id:"31ac5d77-dc3d-5c0c-b120-49c3d1bfe2ba", kc_id:"31ac5d77-dc3d-5c0c-b120-49c3d1bfe2ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess substantiation, vulnerable audiences, harmful-product promotion, selective truth telling, and verification in advertising and PR. Source: section 14.6, printed page 494.", label:"Evaluate truth, children, harmful products, and PR transparency", canonical_key:"evaluate_truth_children_harmful_products_and_pr_", status:"approved"}}, {concept_id:"eb8f3136-edcd-57ed-95c8-a45b8d0023ff", kc_id:"eb8f3136-edcd-57ed-95c8-a45b8d0023ff", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Diagnose the prospect's concern, provide relevant evidence, and distinguish a genuine mismatch from an unanswered question. Source: section 15.3, printed page 511.", label:"Handle objections constructively", canonical_key:"handle_objections_constructively", status:"approved"}}, {concept_id:"3a7b97d9-e785-566c-9f2f-e1adf45c7bdf", kc_id:"3a7b97d9-e785-566c-9f2f-e1adf45c7bdf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Seek an appropriate purchase commitment and support delivery, satisfaction, and continuing relationships after the sale. Source: section 15.3, printed page 511.", label:"Close and follow up responsibly", canonical_key:"close_and_follow_up_responsibly", status:"approved"}}, {concept_id:"acf0b31e-9b59-56d3-a28c-a98a04cc1afc", kc_id:"acf0b31e-9b59-56d3-a28c-a98a04cc1afc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Distinguish stimulus-response, formula, and need-satisfaction presentations and adapt the approach to the buying situation. Source: section 15.3, printed page 511.", label:"Compare presentation formats", canonical_key:"compare_presentation_formats", status:"approved"}}, {concept_id:"a08c15db-ff04-547c-8c9c-77a6e38c0ac9", kc_id:"a08c15db-ff04-547c-8c9c-77a6e38c0ac9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Compare territorial, product, and customer-market structures and account coverage needs. Source: section 15.4, printed page 516.", label:"Design sales-force structure", canonical_key:"design_sales_force_structure", status:"approved"}}, {concept_id:"0f6ae546-86ff-56b7-a9f3-f49da898b023", kc_id:"0f6ae546-86ff-56b7-a9f3-f49da898b023", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Relate account coverage, workload, recruiting, selection, and training to sales objectives. Source: section 15.4, printed page 516.", label:"Estimate sales-force size and capability", canonical_key:"estimate_sales_force_size_and_capability", status:"approved"}}, {concept_id:"f51b3a52-37c5-545d-bf78-e21417da0ccd", kc_id:"f51b3a52-37c5-545d-bf78-e21417da0ccd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Evaluate commission-only, salary-only, salary-plus-commission, and bonus combinations in terms of motivation, service, and incentives. Source: section 15.4, printed page 516.", label:"Compare sales compensation designs", canonical_key:"compare_sales_compensation_designs", status:"approved"}}, {concept_id:"11d7571c-2e32-5b41-a054-11355b038e9a", kc_id:"11d7571c-2e32-5b41-a054-11355b038e9a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Distinguish end-consumer incentives from channel allowances, cooperative advertising, cash bonuses, dealer conferences, and push incentives. Source: section 15.6, printed page 525.", label:"Compare consumer and trade promotions", canonical_key:"compare_consumer_and_trade_promotions", status:"approved"}}, {concept_id:"c57d0abe-d757-5453-b5f7-9863dd571f34", kc_id:"c57d0abe-d757-5453-b5f7-9863dd571f34", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Analyze misleading terms, hidden fees, kickbacks, expense misuse, and inflated sales records as threats to customer and organizational trust. Source: section 15.7, printed page 529.", label:"Evaluate sales conduct and reporting", canonical_key:"evaluate_sales_conduct_and_reporting", status:"approved"}}, {concept_id:"400bb09e-3513-5da8-be2c-53595820b9bc", kc_id:"400bb09e-3513-5da8-be2c-53595820b9bc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Compare mail, catalogs, telephone, television, websites, email, content, video, and events by targeting, response, and relationship objectives. Source: section 16.1, printed page 540.", label:"Integrate direct and digital response channels", canonical_key:"integrate_direct_and_digital_response_channels", status:"approved"}}, {concept_id:"c9f692f7-9f66-5608-b6d9-106660889804", kc_id:"c9f692f7-9f66-5608-b6d9-106660889804", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess Facebook, Instagram, LinkedIn, Pinterest, Twitter, and podcast examples using the textbook's publication-era audience and format descriptions. Source: section 16.2, printed page 550.", label:"Select social platforms for an audience", canonical_key:"select_social_platforms_for_an_audience", status:"approved"}}, {concept_id:"2243d48e-eb8c-5e95-bfd2-d78556385377", kc_id:"2243d48e-eb8c-5e95-bfd2-d78556385377", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Coordinate responsive pages, readable emails, appropriate applications, and short memorable URLs around mobile user behavior. Source: section 16.2, printed page 550.", label:"Design usable mobile marketing", canonical_key:"design_usable_mobile_marketing", status:"approved"}}, {concept_id:"75979f4b-b2b4-5504-9827-8be9a1550c3f", kc_id:"75979f4b-b2b4-5504-9827-8be9a1550c3f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze different units of web activity and avoid equating exposure or time on site with successful customer outcomes. Source: section 16.3, printed page 560.", label:"Distinguish visitors, sessions, page views, and duration", canonical_key:"distinguish_visitors_sessions_page_views_and_dur", status:"approved"}}, {concept_id:"babfdde9-822f-5e70-9b55-9949fc6869c5", kc_id:"babfdde9-822f-5e70-9b55-9949fc6869c5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Use clicks divided by impressions, spend divided by clicks, and spend divided by acquisitions or defined actions, with consistent periods and attribution. Source: section 16.3, printed page 560.", label:"Calculate CTR, CPC, and CPA", canonical_key:"calculate_ctr_cpc_and_cpa", status:"approved"}}, {concept_id:"26a9a72f-2d2a-5fc5-b13b-258657a78e81", kc_id:"26a9a72f-2d2a-5fc5-b13b-258657a78e81", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess transparency about consumer data, tracking practices, and the reliability and disclosure of reviews. Source: section 16.4, printed page 566.", label:"Evaluate tracking, consent, and online reviews", canonical_key:"evaluate_tracking_consent_and_online_reviews", status:"approved"}}, {concept_id:"73e7d727-339d-53fa-b3e5-9ada898b8039", kc_id:"73e7d727-339d-53fa-b3e5-9ada898b8039", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Consider coverage, information, convenience, assortment, pre- and post-sale service, perishability, bulk, technical complexity, unit value, life-cycle stage, and profitability. Source: section 17.3, printed page 587.", label:"Choose channels for product and buyer requirements", canonical_key:"choose_channels_for_product_and_buyer_requiremen", status:"approved"}}, {concept_id:"a1dedca7-75d8-5ce2-a012-0b31fd9b9791", kc_id:"a1dedca7-75d8-5ce2-a012-0b31fd9b9791", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Use performance, capability, incentives, collaboration, and conflict resolution to align channel members. Source: section 17.4, printed page 593.", label:"Select and motivate channel partners", canonical_key:"select_and_motivate_channel_partners", status:"approved"}}] AS row
