"explain_strategic_business_unit", status:"approved"}}, {concept_id:"d503d6ef-859e-560f-a269-cd0d743c0721", kc_id:"d503d6ef-859e-560f-a269-cd0d743c0721", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply strategy: set of plans, actions, and goals that outlines how a business will compete Source: chapter 2 Key Terms, printed page 84; related section 2.1.", label:"Apply strategy", canonical_key:"apply_strategy", status:"approved"}}, {concept_id:"b97971ab-2e32-53e5-84cd-14c25dad8bd7", kc_id:"b97971ab-2e32-53e5-84cd-14c25dad8bd7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply SWOT analysis: identification of internal strengths and weaknesses and external opportunities and threats impacting a business Source: chapter 2 Key Terms, printed page 84; related section 2.2.", label:"Apply SWOT analysis", canonical_key:"apply_swot_analysis", status:"approved"}}, {concept_id:"c88b8633-1785-5254-9974-6506008e6083", kc_id:"c88b8633-1785-5254-9974-6506008e6083", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain vision statement: aspirational statement that articulates what an organization aims to achieve Source: chapter 2 Key Terms, printed page 84; related section 2.1.", label:"Explain vision statement", canonical_key:"explain_vision_statement", status:"approved"}}] AS row
