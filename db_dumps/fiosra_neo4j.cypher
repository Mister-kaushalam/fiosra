UNWIND [{concept_id:"CON_ASSESSING_THE_GOLDEN_AGE_NARRATIVE_BECF5C", kc_id:"CON_ASSESSING_THE_GOLDEN_AGE_NARRATIVE_BECF5C", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:01:51.669Z'), level:"atomic_concept", concept_type:"threshold", created_at:datetime('2026-09-20T10:01:51.669Z'), definition:"Critically evaluating the characterization of the Gupta period as India's Golden Age by examining whose perspectives it centers, what evidence supports achievements, and what limitations or regional variations it obscures.", label:"Assessing the Golden Age Narrative", canonical_key:"ASSESSING_THE_GOLDEN_AGE_NARRATIVE", status:"approved"}}, {concept_id:"CON_ANALYZING_TRANS_REGIONAL_TRADE_NETWORKS_B9A598", kc_id:"CON_ANALYZING_TRANS_REGIONAL_TRADE_NETWORKS_B9A598", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:01:51.675Z'), level:"atomic_concept", concept_type:"method", created_at:datetime('2026-09-20T10:01:51.675Z'), definition:"Examining the Silk Road, Indian Ocean maritime trade, and Deccan trade routes through numismatic, archaeological, and textual evidence to understand inter-civilizational economic and cultural exchange.", label:"Analyzing Trans-Regional Trade Networks", canonical_key:"ANALYZING_TRANS_REGIONAL_TRADE_NETWORKS", status:"approved"}}, {concept_id:"CON_EVALUATING_IMPERIAL_FRAGMENTATION_AS_PROCESS_FD1177", kc_id:"CON_EVALUATING_IMPERIAL_FRAGMENTATION_AS_PROCESS_FD1177", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:01:51.678Z'), level:"atomic_concept", concept_type:"threshold", created_at:datetime('2026-09-20T10:01:51.678Z'), definition:"Understanding post-Mauryan political fragmentation not as decline but as a period of regionalization, cultural diversification, and new forms of political legitimacy across successor states.", label:"Evaluating Imperial Fragmentation as Process", canonical_key:"EVALUATING_IMPERIAL_FRAGMENTATION_AS_PROCESS", status:"approved"}}, {concept_id:"57b9cc86-f02b-595d-823d-9c949a525932", kc_id:"57b9cc86-f02b-595d-823d-9c949a525932", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"course_theme", concept_type:"domain", definition:"Explain, apply, analyze, evaluate, and design customer-value-oriented marketing across strategy, buyer behavior, research, offerings, communication, channels, and sustainability. The five modules are an adaptation of the attached textbook, not its original unit titles.", label:"BUS C150 Principles of Marketing", canonical_key:"bus_c150_principles_of_marketing", status:"approved"}}, {concept_id:"d923175d-4abd-5f79-a514-e5b7fccb80b8", kc_id:"d923175d-4abd-5f79-a514-e5b7fccb80b8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"strand", concept_type:"domain", definition:"Chapters 1–2: value creation, the marketing process and environment, customer relationships, strategic planning, portfolios, marketing plans, performance metrics, and ethics.", label:"Marketing Foundations and Strategy", canonical_key:"marketing_foundations_and_strategy", status:"approved"}}, {concept_id:"aca0f5b8-9044-5157-8f53-0345731f6a7a", kc_id:"aca0f5b8-9044-5157-8f53-0345731f6a7a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"strand", concept_type:"domain", definition:"Chapters 3–8: consumer and organizational decisions, segmentation, targeting and positioning, research and intelligence, global markets, diversity and inclusion.", label:"Markets, Buyer Behavior, Research, and Diversity", canonical_key:"markets_buyer_behavior_research_and_diversity", status:"approved"}}, {concept_id:"49ffa2ee-e78b-5710-b90a-fda35c1f176e", kc_id:"49ffa2ee-e78b-5710-b90a-fda35c1f176e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"strand", concept_type:"domain", definition:"Chapters 9–12: offerings and brands, product life cycles, innovation and adoption, services and quality, costs, demand, and pricing decisions.", label:"Products, Innovation, Services, and Pricing", canonical_key:"products_innovation_services_and_pricing", status:"approved"}}, {concept_id:"235411ba-1d04-5353-a4e1-7965f9eb6757", kc_id:"235411ba-1d04-5353-a4e1-7965f9eb6757", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"strand", concept_type:"domain", definition:"Chapters 13–16: communication and campaign planning, advertising, public relations, personal selling, promotion, direct and digital channels, and measurement.", label:"Integrated Marketing Communications and Selling", canonical_key:"integrated_marketing_communications_and_selling", status:"approved"}}, {concept_id:"7af6cac1-159b-5ea0-a4eb-da11f18f30db", kc_id:"7af6cac1-159b-5ea0-a4eb-da11f18f30db", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"strand", concept_type:"domain", definition:"Chapters 17–19: distribution channels, supply chains and logistics, retail and wholesale strategy, sustainability, stakeholder responsibility, and purpose.", label:"Distribution, Retailing, and Sustainable Marketing", canonical_key:"distribution_retailing_and_sustainable_marketing", status:"approved"}}, {concept_id:"3c245547-5292-5f3e-8a16-a7dbf4063750", kc_id:"3c245547-5292-5f3e-8a16-a7dbf4063750", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"method", definition:"Section 1.1, printed page 12, chapter 1 (Marketing and Customer Value). Learning outcomes: Define and describe marketing. Describe the benefits of marketing to the organization, its interested parties, and society. Explain the marketing process.", label:"Marketing and the Marketing Process", canonical_key:"marketing_and_the_marketing_process", status:"approved"}}, {concept_id:"4375e29e-c040-5ff0-bef2-8780e3c95d2e", kc_id:"4375e29e-c040-5ff0-bef2-8780e3c95d2e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 1.2, printed page 18, chapter 1 (Marketing and Customer Value). Learning outcomes: Define and describe the marketing mix. List and explain the 4Ps of marketing.", label:"The Marketing Mix and the 4Ps of Marketing", canonical_key:"the_marketing_mix_and_the_4ps_of_marketing", status:"approved"}}, {concept_id:"c3645d92-fdb5-5416-98a4-8f9b9d6fd8c4", kc_id:"c3645d92-fdb5-5416-98a4-8f9b9d6fd8c4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 1.3, printed page 22, chapter 1 (Marketing and Customer Value). Learning outcomes: Define and describe the marketing environment. Explain the components of the marketing environment. Identify and describe the internal factors of the marketing environment. List and describe the components of the micro- and macroenvironments.", label:"Factors Comprising and Affecting the Marketing Environment", canonical_key:"factors_comprising_and_affecting_the_marketing_e", status:"approved"}}, {concept_id:"776f9dc7-2e04-54c9-a20c-287358eb071b", kc_id:"776f9dc7-2e04-54c9-a20c-287358eb071b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 1.4, printed page 27, chapter 1 (Marketing and Customer Value). Learning outcomes: Describe the production concept. Define the product concept. Discuss the selling concept. Explain the marketing concept. Summarize the societal marketing concept and its features.", label:"Evolution of the Marketing Concept", canonical_key:"evolution_of_the_marketing_concept", status:"approved"}}, {concept_id:"df15926d-7537-55c2-af5a-2c5e145b763b", kc_id:"df15926d-7537-55c2-af5a-2c5e145b763b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 1.5, printed page 30, chapter 1 (Marketing and Customer Value). Learning outcomes: Explain how an organization identifies consumer needs and wants. Describe the process through which an organization satisfies consumer needs and wants.", label:"Determining Consumer Needs and Wants", canonical_key:"determining_consumer_needs_and_wants", status:"approved"}}, {concept_id:"14483042-18ec-58a4-a45f-b8c010401a53", kc_id:"14483042-18ec-58a4-a45f-b8c010401a53", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 1.6, printed page 33, chapter 1 (Marketing and Customer Value). Learning outcomes: Define customer relationship management (CRM). Describe the impact of CRM on customer loyalty and retention. Explain how CRM builds customer equity.", label:"Customer Relationship Management (CRM)", canonical_key:"customer_relationship_management_crm", status:"approved"}}, {concept_id:"4530ff68-e62d-5539-9f7b-d496c2223262", kc_id:"4530ff68-e62d-5539-9f7b-d496c2223262", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 1.7, printed page 35, chapter 1 (Marketing and Customer Value). Learning outcomes: Define ethical marketing. Describe the importance of ethical marketing. Explain the dos and don’ts of ethical marketing.", label:"Ethical Marketing", canonical_key:"ethical_marketing", status:"approved"}}, {concept_id:"b34f5380-7296-5b23-91f5-1f8d89afb0e2", kc_id:"b34f5380-7296-5b23-91f5-1f8d89afb0e2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"method", definition:"Section 2.1, printed page 48, chapter 2 (Strategic Planning in Marketing). Learning outcomes: Define strategic planning and list the steps in the strategic planning process. Write an effective vision statement and mission statement. Describe the role of company values. Perform a gap analysis. Write SMART objectives and goals. Summarize ways to monitor progress of the strategic plan.", label:"Developing a Strategic Plan", canonical_key:"developing_a_strategic_plan", status:"approved"}}, {concept_id:"22325226-5391-5267-abab-6452201afd92", kc_id:"22325226-5391-5267-abab-6452201afd92", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"method", definition:"Section 2.2, printed page 55, chapter 2 (Strategic Planning in Marketing). Learning outcomes: Explain the role of marketing in the strategic planning process. Discuss the business portfolio and identify planning tools. Describe a SWOT analysis. List and describe marketing strategies based on analytics.", label:"The Role of Marketing in the Strategic Planning Process", canonical_key:"the_role_of_marketing_in_the_strategic_planning_", status:"approved"}}, {concept_id:"a5421e02-2776-544b-9b5d-f44fbe4376be", kc_id:"a5421e02-2776-544b-9b5d-f44fbe4376be", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"method", definition:"Section 2.3, printed page 64, chapter 2 (Strategic Planning in Marketing). Learning outcomes: Explain the purpose of a marketing plan. List and discuss elements that should be included in a marketing plan.", label:"Purpose and Structure of the Marketing Plan", canonical_key:"purpose_and_structure_of_the_marketing_plan", status:"approved"}}, {concept_id:"a4167932-691e-5998-ae30-ac6bdc26e761", kc_id:"a4167932-691e-5998-ae30-ac6bdc26e761", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"method", definition:"Section 2.4, printed page 72, chapter 2 (Strategic Planning in Marketing). Learning outcomes: Define marketing metrics. Explain key performance indicators (KPIs). Provide examples of business objective KPIs. Characterize sales/revenue generation KPIs. Provide examples of market share KPIs. Classify and discuss customer support KPIs.", label:"Marketing Plan Progress Using Metrics", canonical_key:"marketing_plan_progress_using_metrics", status:"approved"}}] AS row
