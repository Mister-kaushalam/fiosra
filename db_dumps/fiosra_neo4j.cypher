UNWIND [{concept_id:"a1702ed9-3168-5047-91af-c47d707d4fdd", kc_id:"a1702ed9-3168-5047-91af-c47d707d4fdd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain direct-mail marketing: a type of direct marketing that involves marketers sending mail directly to people’s homes or places of business; for example, catalogs and postcards Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain direct-mail marketing", canonical_key:"explain_direct_mail_marketing", status:"approved"}}, {concept_id:"8410b151-c2b4-59ae-b779-f73d77caa4d6", kc_id:"8410b151-c2b4-59ae-b779-f73d77caa4d6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain direct-response television marketing: a type of direct marketing that is designed to compel viewers to take some immediate action such, as calling a phone number or visiting a website presented during a television commercial Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain direct-response television marketing", canonical_key:"explain_direct_response_television_marketing", status:"approved"}}, {concept_id:"c85933a7-2c44-53ed-a3e4-8d03940bbea2", kc_id:"c85933a7-2c44-53ed-a3e4-8d03940bbea2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain email marketing: a type of direct marketing that is highly personal and designed to build relationships with consumers Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain email marketing", canonical_key:"explain_email_marketing", status:"approved"}}, {concept_id:"91159f38-e5a1-5283-a24c-762aba0faa92", kc_id:"91159f38-e5a1-5283-a24c-762aba0faa92", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain impression: when users see an online ad Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain impression", canonical_key:"explain_impression", status:"approved"}}, {concept_id:"b596724e-7f48-5be6-a656-d4efd8402810", kc_id:"b596724e-7f48-5be6-a656-d4efd8402810", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain integrated social media marketing: involves creating a clear, consistent, and synergistic message across all social media platforms Source: chapter 16 Key Terms, printed page 569; related section 16.2.", label:"Explain integrated social media marketing", canonical_key:"explain_integrated_social_media_marketing", status:"approved"}}, {concept_id:"02e660a0-c2e5-5b88-a216-f84f157cd94f", kc_id:"02e660a0-c2e5-5b88-a216-f84f157cd94f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing emails: emails that are promotional in nature and typically involve a marketing offer Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain marketing emails", canonical_key:"explain_marketing_emails", status:"approved"}}, {concept_id:"57457686-d720-5d45-b5de-4687c3a475f4", kc_id:"57457686-d720-5d45-b5de-4687c3a475f4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain mobile marketing: using multiple digital marketing channels that are designed to reach consumers on their smartphones and tablets Source: chapter 16 Key Terms, printed page 569; related section 16.2.", label:"Explain mobile marketing", canonical_key:"explain_mobile_marketing", status:"approved"}}, {concept_id:"372ef1db-9746-523e-b167-ab18fcc4bebe", kc_id:"372ef1db-9746-523e-b167-ab18fcc4bebe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain mobile-friendly emails: emails whose images, text, and links display in a way that is easy to read when accessed via a mobile device Source: chapter 16 Key Terms, printed page 569; related section 16.2.", label:"Explain mobile-friendly emails", canonical_key:"explain_mobile_friendly_emails", status:"approved"}}, {concept_id:"7f51aa85-a2fa-585b-9d76-30484404d4ee", kc_id:"7f51aa85-a2fa-585b-9d76-30484404d4ee", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain new visitors: people who are first visiting your website, also known as new users Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain new visitors", canonical_key:"explain_new_visitors", status:"approved"}}, {concept_id:"95946239-4fb1-51e5-b678-efa6e61c0925", kc_id:"95946239-4fb1-51e5-b678-efa6e61c0925", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain online direct marketing: uses a rich collection of online tools, such as websites and email, to target individual consumers with an offer designed to compel consumers to take some action, such as visit a website or make an online purchase Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain online direct marketing", canonical_key:"explain_online_direct_marketing", status:"approved"}}, {concept_id:"119d549a-05fa-53b7-8843-c39840607f74", kc_id:"119d549a-05fa-53b7-8843-c39840607f74", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain online video marketing: involves creating videos that tell a story about a product, company, or brand that is designed to drive consumer engagement through activities such as liking, sharing, and retweeting Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain online video marketing", canonical_key:"explain_online_video_marketing", status:"approved"}}, {concept_id:"288ae470-3673-5d52-998e-34bc01692312", kc_id:"288ae470-3673-5d52-998e-34bc01692312", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain organic search: the list of websites on a search engine results page that have not been paid for by marketers Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain organic search", canonical_key:"explain_organic_search", status:"approved"}}, {concept_id:"6eb9b6c8-1a2f-59a2-a150-81cc3f4ac62e", kc_id:"6eb9b6c8-1a2f-59a2-a150-81cc3f4ac62e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain page views: a metric related to how many total pages have been viewed on your website Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain page views", canonical_key:"explain_page_views", status:"approved"}}, {concept_id:"67e2ecb1-6a61-5e54-a265-b233b058d135", kc_id:"67e2ecb1-6a61-5e54-a265-b233b058d135", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain paid search: a type of digital advertising where marketers pay search engines like Google and Bing to place their ads in sponsored spots at the top or bottom of a search results page Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain paid search", canonical_key:"explain_paid_search", status:"approved"}}, {concept_id:"f4dd7e80-b4b7-5895-8764-7324b73cf2ec", kc_id:"f4dd7e80-b4b7-5895-8764-7324b73cf2ec", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain paid social: a type of digital marketing advertising where a company pays a social media company to display a digital advertisement to targeted customers on its platform Source: chapter 16 Key Terms, printed page 569; related section 16.2.", label:"Explain paid social", canonical_key:"explain_paid_social", status:"approved"}}, {concept_id:"f1ce1948-fb9a-578f-8555-1963f6440835", kc_id:"f1ce1948-fb9a-578f-8555-1963f6440835", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain podcasts: often free, on-demand, downloadable audio recordings that cover a variety of topics and are typically made available on a weekly or monthly basis Source: chapter 16 Key Terms, printed page 569; related section 16.2.", label:"Explain podcasts", canonical_key:"explain_podcasts", status:"approved"}}, {concept_id:"c534dabc-6abe-531f-906e-fe35138f566c", kc_id:"c534dabc-6abe-531f-906e-fe35138f566c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain responsive web design: designing a website that is configured to adapt to any device, making it easy for visitors to read and interact with its features Source: chapter 16 Key Terms, printed page 569; related section 16.2.", label:"Explain responsive web design", canonical_key:"explain_responsive_web_design", status:"approved"}}, {concept_id:"6b7b0ddb-1b64-5be9-a729-bff4183da4fc", kc_id:"6b7b0ddb-1b64-5be9-a729-bff4183da4fc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain returning visitors: visitors or users who have been to your website before Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain returning visitors", canonical_key:"explain_returning_visitors", status:"approved"}}, {concept_id:"27058dcd-b221-5773-8e49-d40d1196afb0", kc_id:"27058dcd-b221-5773-8e49-d40d1196afb0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sales funnel: a visual representation of the customer journey from product awareness to product purchase Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain sales funnel", canonical_key:"explain_sales_funnel", status:"approved"}}, {concept_id:"ad3da9a0-1c02-523d-802f-c07773bd200e", kc_id:"ad3da9a0-1c02-523d-802f-c07773bd200e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain search trends: data points that indicate how frequently a term is searched Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain search trends", canonical_key:"explain_search_trends", status:"approved"}}] AS row
