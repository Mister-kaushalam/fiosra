UNWIND [{concept_id:"ff102a34-473c-5f8d-9e4e-eb00fe7ad3ba", kc_id:"ff102a34-473c-5f8d-9e4e-eb00fe7ad3ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain productivity: the efficiency and output of employees Source: chapter 11 Key Terms, printed page 398; related section 11.2.", label:"Explain productivity", canonical_key:"explain_productivity", status:"approved"}}, {concept_id:"758ecee9-9da8-5bbd-b603-c80e749dcd74", kc_id:"758ecee9-9da8-5bbd-b603-c80e749dcd74", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply RATER framework of service quality: theoretical model that focuses on the five dimensions of service excellence: reliability, assurance, tangibles, empathy, and responsiveness Source: chapter 11 Key Terms, printed page 398; related section 11.3.", label:"Apply RATER framework of service quality", canonical_key:"apply_rater_framework_of_service_quality", status:"approved"}}, {concept_id:"bd0d48fb-46e2-55af-bfe6-711813a0e9ac", kc_id:"bd0d48fb-46e2-55af-bfe6-711813a0e9ac", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain reliability: in terms of the RATER model, the organization’s capability to produce an accurate, dependable, and on-time service Source: chapter 11 Key Terms, printed page 398; related section 11.3.", label:"Explain reliability", canonical_key:"explain_reliability", status:"approved"}}, {concept_id:"1e0e2317-0423-5527-913b-4e2d88708b78", kc_id:"1e0e2317-0423-5527-913b-4e2d88708b78", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain responsiveness: in terms of the RATER model, promptness and willingness to provide satisfactory and quick service Source: chapter 11 Key Terms, printed page 398; related section 11.3.", label:"Explain responsiveness", canonical_key:"explain_responsiveness", status:"approved"}}, {concept_id:"e5705e68-f1f9-58ca-8d73-5df485f0780d", kc_id:"e5705e68-f1f9-58ca-8d73-5df485f0780d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain service encounter: a consumer’s direct contact with a service provider Source: chapter 11 Key Terms, printed page 398; related section 11.2.", label:"Explain service encounter", canonical_key:"explain_service_encounter", status:"approved"}}, {concept_id:"64ffa9f4-d697-53f0-a9da-5c8bfa679302", kc_id:"64ffa9f4-d697-53f0-a9da-5c8bfa679302", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"threshold", definition:"Analyze service inseparability: concept where services must be produced and consumed concurrently Source: chapter 11 Key Terms, printed page 398; related section 11.1.", label:"Analyze service inseparability", canonical_key:"analyze_service_inseparability", status:"approved"}}, {concept_id:"af02b0d2-bfee-5961-a2d2-82168929d0c7", kc_id:"af02b0d2-bfee-5961-a2d2-82168929d0c7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain Service Marketing Triangle: a visual representation of a strategic model that outlines the importance of people in a company’s ability to keep its service promises Source: chapter 11 Key Terms, printed page 398; related section 11.2.", label:"Explain Service Marketing Triangle", canonical_key:"explain_service_marketing_triangle", status:"approved"}}, {concept_id:"1ba99a18-859c-50df-8524-0669225238bf", kc_id:"1ba99a18-859c-50df-8524-0669225238bf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"threshold", definition:"Analyze service perishability: concept that states services cannot be stored in inventory for future use or sale Source: chapter 11 Key Terms, printed page 398; related section 11.1.", label:"Analyze service perishability", canonical_key:"analyze_service_perishability", status:"approved"}}, {concept_id:"fffffb3b-22ae-51fe-89d5-05bc5255a8c2", kc_id:"fffffb3b-22ae-51fe-89d5-05bc5255a8c2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain service variability: concept that states the quality of the service depends on who, when, where, and how it is provided Source: chapter 11 Key Terms, printed page 398; related section 11.1.", label:"Explain service variability", canonical_key:"explain_service_variability", status:"approved"}}, {concept_id:"1a7c0a24-b738-5874-8257-3339a0ba620b", kc_id:"1a7c0a24-b738-5874-8257-3339a0ba620b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply service-profit chain model: model that establishes relationships between profitability, employee satisfaction, loyalty, and productivity Source: chapter 11 Key Terms, printed page 398; related section 11.2.", label:"Apply service-profit chain model", canonical_key:"apply_service_profit_chain_model", status:"approved"}}, {concept_id:"e5a4a751-e073-5a03-923f-7652848a9d1b", kc_id:"e5a4a751-e073-5a03-923f-7652848a9d1b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain services: nonphysical, intangible economic activities Source: chapter 11 Key Terms, printed page 398; related section 11.1.", label:"Explain services", canonical_key:"explain_services", status:"approved"}}, {concept_id:"de635425-ae8a-5fc1-802c-2c3bb9e0fe64", kc_id:"de635425-ae8a-5fc1-802c-2c3bb9e0fe64", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain tangibles: in terms of the RATER model, the physical appearance of both the facility and its employees Source: chapter 11 Key Terms, printed page 398; related section 11.3.", label:"Explain tangibles", canonical_key:"explain_tangibles", status:"approved"}}, {concept_id:"e1104e7a-4127-5ca7-88f0-b08e978cf099", kc_id:"e1104e7a-4127-5ca7-88f0-b08e978cf099", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain artificial time constraints: pricing strategy that creates a sense of urgency in buyers’ minds Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Explain artificial time constraints", canonical_key:"explain_artificial_time_constraints", status:"approved"}}, {concept_id:"b63be0c6-ab71-592d-8dc7-a0080cc16f5c", kc_id:"b63be0c6-ab71-592d-8dc7-a0080cc16f5c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply break-even pricing: pricing strategy in which marketers choose a price that will cover all the costs of manufacturing Source: chapter 12 Key Terms, printed page 430; related section 12.4.", label:"Apply break-even pricing", canonical_key:"apply_break_even_pricing", status:"approved"}}, {concept_id:"b4f7ece5-9689-5980-ba69-ed990f563e05", kc_id:"b4f7ece5-9689-5980-ba69-ed990f563e05", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply bundle pricing: pricing strategy that promotes purchasing multiple items at once; used to prod customers to purchase (and spend) more than they may have otherwise Source: chapter 12 Key Terms, printed page 430; related section 12.5.", label:"Apply bundle pricing", canonical_key:"apply_bundle_pricing", status:"approved"}}, {concept_id:"129c3543-ae8d-58e0-8fb2-238c41f8ece2", kc_id:"129c3543-ae8d-58e0-8fb2-238c41f8ece2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain competition-based objective: product pricing based on the prices of a company’s competitors Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain competition-based objective", canonical_key:"explain_competition_based_objective", status:"approved"}}, {concept_id:"4f280ee1-95ea-5769-84fa-f80a70c1d2b8", kc_id:"4f280ee1-95ea-5769-84fa-f80a70c1d2b8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain consumer confidence: an economic indicator that measures the degree of optimism that consumers have regarding the overall state of the country’s economy and their own financial situations Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain consumer confidence", canonical_key:"explain_consumer_confidence", status:"approved"}}, {concept_id:"80a63d03-7d24-5984-9c56-a2f3a963c501", kc_id:"80a63d03-7d24-5984-9c56-a2f3a963c501", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze cost-based objective: product pricing based on the costs of doing business Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze cost-based objective", canonical_key:"analyze_cost_based_objective", status:"approved"}}, {concept_id:"41f8aa6e-08ff-5fdc-b1d9-665522f14713", kc_id:"41f8aa6e-08ff-5fdc-b1d9-665522f14713", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze cross-elasticity of demand: The responsiveness of demand for one offering to a change in another offering’s price. Source caution: the glossary describes a price-to-price change; the learnable demand relationship concerns quantity demanded relative to another price, not merely two prices. Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze cross-elasticity of demand", canonical_key:"analyze_cross_elasticity_of_demand", status:"approved"}}, {concept_id:"e3930a2c-043e-53e5-ba4b-730148bf05e3", kc_id:"e3930a2c-043e-53e5-ba4b-730148bf05e3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze customer value–based objective: product pricing based on a company’s understanding of the value-added benefits of a product Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze customer value–based objective", canonical_key:"analyze_customer_value_based_objective", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"c918099a-049f-5f11-b63f-c852275614cc", kc_id:"c918099a-049f-5f11-b63f-c852275614cc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain customer-driven objective: product pricing based on what a customer is willing to pay for a product or service Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain customer-driven objective", canonical_key:"explain_customer_driven_objective", status:"approved"}}, {concept_id:"f846d95c-a832-5ce2-984f-6c38736adf30", kc_id:"f846d95c-a832-5ce2-984f-6c38736adf30", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Evaluate deceptive price advertising: an unethical pricing practice in which the advertised price of a product is misleading to consumers Source: chapter 12 Key Terms, printed page 430; related section 12.6.", label:"Evaluate deceptive price advertising", canonical_key:"evaluate_deceptive_price_advertising", status:"approved"}}, {concept_id:"8925463f-2c96-5110-92b7-8173e5f5cc3a", kc_id:"8925463f-2c96-5110-92b7-8173e5f5cc3a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze demand: a buyer’s ability and willingness to purchase a specific product or service Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze demand", canonical_key:"analyze_demand", status:"approved"}}, {concept_id:"8e95b1af-c79f-515a-ad6b-7326f0541939", kc_id:"8e95b1af-c79f-515a-ad6b-7326f0541939", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze demand curve: a graph that illustrates the relationship between demand and price Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze demand curve", canonical_key:"analyze_demand_curve", status:"approved"}}, {concept_id:"9e1b2a8d-60f1-569e-a3cf-4209b77d4645", kc_id:"9e1b2a8d-60f1-569e-a3cf-4209b77d4645", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze demand elasticity: measure of the change in the quantity demanded in relation to the change in its price Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze demand elasticity", canonical_key:"analyze_demand_elasticity", status:"approved"}}, {concept_id:"85ac1e2b-4085-50e1-b06a-e9e8b487f963", kc_id:"85ac1e2b-4085-50e1-b06a-e9e8b487f963", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze discretionary income: a household’s money that is left over after all taxes and necessities are paid Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze discretionary income", canonical_key:"analyze_discretionary_income", status:"approved"}}, {concept_id:"6e167aac-68ca-548f-9376-bf424c577505", kc_id:"6e167aac-68ca-548f-9376-bf424c577505", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply economy pricing: setting a price much lower than competitors to sell high volumes of a product Source: chapter 12 Key Terms, printed page 430; related section 12.5.", label:"Apply economy pricing", canonical_key:"apply_economy_pricing", status:"approved"}}, {concept_id:"721f2c55-9cfd-56d8-95c8-f5cf24ebc29b", kc_id:"721f2c55-9cfd-56d8-95c8-f5cf24ebc29b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze fixed costs: costs of doing business that do not change based on number of units produced Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze fixed costs", canonical_key:"analyze_fixed_costs", status:"approved"}}, {concept_id:"be7e4b91-634f-50f9-8a92-1449f4f2008f", kc_id:"be7e4b91-634f-50f9-8a92-1449f4f2008f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze income effect: the perception buyers have of how price changes will affect their income Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze income effect", canonical_key:"analyze_income_effect", status:"approved"}}, {concept_id:"aba85de0-f404-5d13-b7ea-50e27996a825", kc_id:"aba85de0-f404-5d13-b7ea-50e27996a825", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain inflation: an economic measure of the rate of rising prices of goods and services in an economy Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain inflation", canonical_key:"explain_inflation", status:"approved"}}, {concept_id:"64871246-bf2d-5b78-9079-48901452db22", kc_id:"64871246-bf2d-5b78-9079-48901452db22", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain market share–oriented objective: setting prices at, below, or above competitors in an effort to increase market share Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain market share–oriented objective", canonical_key:"explain_market_share_oriented_objective", status:"approved"}}, {concept_id:"9810ba22-4d9b-544c-9a43-35d2373a9ef1", kc_id:"9810ba22-4d9b-544c-9a43-35d2373a9ef1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Evaluate monopoly gouging: when a seller increases the prices of goods and services that are not considered fair or competitive Source: chapter 12 Key Terms, printed page 430; related section 12.6.", label:"Evaluate monopoly gouging", canonical_key:"evaluate_monopoly_gouging", status:"approved"}}, {concept_id:"fb807032-bd76-50d7-97cf-d045c8e704e6", kc_id:"fb807032-bd76-50d7-97cf-d045c8e704e6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply odd-even pricing: psychological pricing strategy that uses prices that end with odd or even numbers to attract customers Source: chapter 12 Key Terms, printed page 430; related section 12.5.", label:"Apply odd-even pricing", canonical_key:"apply_odd_even_pricing", status:"approved"}}, {concept_id:"414a1a35-7df2-5d17-add6-8de8eaa972a1", kc_id:"414a1a35-7df2-5d17-add6-8de8eaa972a1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply penetration pricing: new product or service strategy that sets the lowest price possible in order to reach the majority of the market in the introduction stage Source: chapter 12 Key Terms, printed page 430; related section 12.4.", label:"Apply penetration pricing", canonical_key:"apply_penetration_pricing", status:"approved"}}, {concept_id:"8bb2be40-c5c8-52d5-9d48-a039ca8d6573", kc_id:"8bb2be40-c5c8-52d5-9d48-a039ca8d6573", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply predatory pricing: when a company prices goods or services so low that other companies cannot compete Source: chapter 12 Key Terms, printed page 430; related section 12.6.", label:"Apply predatory pricing", canonical_key:"apply_predatory_pricing", status:"approved"}}, {concept_id:"e2d4896b-2212-53e6-8519-e4ae5b7c0684", kc_id:"e2d4896b-2212-53e6-8519-e4ae5b7c0684", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply prestige pricing: a strategy marketers use to set high prices knowing that demand will increase with higher prices because the higher price increases the perceived value of the product Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Apply prestige pricing", canonical_key:"apply_prestige_pricing", status:"approved"}}, {concept_id:"fa14ad60-11a1-58a9-bd7e-c51ea8857155", kc_id:"fa14ad60-11a1-58a9-bd7e-c51ea8857155", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain price: the exchange of something of value between a buyer and seller Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Explain price", canonical_key:"explain_price", status:"approved"}}, {concept_id:"1463ad9a-8bcd-5b57-a0a5-aeeb4021efad", kc_id:"1463ad9a-8bcd-5b57-a0a5-aeeb4021efad", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain price anchoring: a frame of reference for a buyer to set an expectation of a price Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Explain price anchoring", canonical_key:"explain_price_anchoring", status:"approved"}}, {concept_id:"b0fbf8c8-15da-58de-84f1-887c3f6b57ba", kc_id:"b0fbf8c8-15da-58de-84f1-887c3f6b57ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain price appearance: the way in which a customer perceives a price based on how it is visually represented Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Explain price appearance", canonical_key:"explain_price_appearance", status:"approved"}}, {concept_id:"cefcb6c0-71b5-5332-a373-7b21db62c439", kc_id:"cefcb6c0-71b5-5332-a373-7b21db62c439", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain price discrimination: selling goods and services at different prices to different customers Source: chapter 12 Key Terms, printed page 430; related section 12.6.", label:"Explain price discrimination", canonical_key:"explain_price_discrimination", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"00217b5a-2658-5c04-806c-0e627c89895a", kc_id:"00217b5a-2658-5c04-806c-0e627c89895a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain price fixing: two or more companies agreeing to set certain prices in the market Source: chapter 12 Key Terms, printed page 430; related section 12.6.", label:"Explain price fixing", canonical_key:"explain_price_fixing", status:"approved"}}, {concept_id:"5dffc3ed-404f-5562-85a1-393c897b4241", kc_id:"5dffc3ed-404f-5562-85a1-393c897b4241", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Evaluate price gouging: when companies take advantage of a situation, typically an emergency or natural disaster, and charge exceptionally high prices for products or services Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Evaluate price gouging", canonical_key:"evaluate_price_gouging", status:"approved"}}, {concept_id:"c2998542-f37e-5c3e-b013-0fff3a7d62d7", kc_id:"c2998542-f37e-5c3e-b013-0fff3a7d62d7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain price skimming: pricing strategy in which a company initially sets a high price for a product or service and lowers it over time as new segments of the market are reached Source: chapter 12 Key Terms, printed page 430; related section 12.4.", label:"Explain price skimming", canonical_key:"explain_price_skimming", status:"approved"}}, {concept_id:"1128e7f2-fbe3-5a6f-a043-a0a96ef21721", kc_id:"1128e7f2-fbe3-5a6f-a043-a0a96ef21721", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply product line pricing: setting a higher price for some product lines and lower price points for others in order to capture various target markets Source: chapter 12 Key Terms, printed page 430; related section 12.5.", label:"Apply product line pricing", canonical_key:"apply_product_line_pricing", status:"approved"}}, {concept_id:"a3d04248-5237-5ac4-9c40-0fe7bf6d7791", kc_id:"a3d04248-5237-5ac4-9c40-0fe7bf6d7791", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze profit: the financial gain of a company Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Analyze profit", canonical_key:"analyze_profit", status:"approved"}}, {concept_id:"3c2e37e3-d906-5aee-bbd7-6e866a36c789", kc_id:"3c2e37e3-d906-5aee-bbd7-6e866a36c789", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sales-oriented objective: setting prices based on the goal of increasing the volume of sales Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain sales-oriented objective", canonical_key:"explain_sales_oriented_objective", status:"approved"}}, {concept_id:"f8cc3403-eea0-518b-a51c-e5c70a15964e", kc_id:"f8cc3403-eea0-518b-a51c-e5c70a15964e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain substitutes: products and services that are similar to the one being offered Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain substitutes", canonical_key:"explain_substitutes", status:"approved"}}, {concept_id:"1e8d81ac-d4c5-5762-a149-fe2cf73083ef", kc_id:"1e8d81ac-d4c5-5762-a149-fe2cf73083ef", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain target return objective: setting prices so they return a specific profit during a given period of time Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Explain target return objective", canonical_key:"explain_target_return_objective", status:"approved"}}, {concept_id:"5b906b07-0326-5279-ac6d-4539a6ed752e", kc_id:"5b906b07-0326-5279-ac6d-4539a6ed752e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze total costs: total expenses of doing business Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Analyze total costs", canonical_key:"analyze_total_costs", status:"approved"}}, {concept_id:"27dd1a72-7eac-5a92-9166-fd70ee8f18d3", kc_id:"27dd1a72-7eac-5a92-9166-fd70ee8f18d3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain total revenue: the money generated from normal business operations Source: chapter 12 Key Terms, printed page 430; related section 12.1.", label:"Explain total revenue", canonical_key:"explain_total_revenue", status:"approved"}}, {concept_id:"f36f7649-3c7c-5e23-a3cb-a7646b043092", kc_id:"f36f7649-3c7c-5e23-a3cb-a7646b043092", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply unemployment rate: A measure of unemployment within the relevant labor force, used in section 12.3 to assess economic conditions. Distinguish unemployed people in the labor force from everyone outside paid work; the glossary’s shorthand does not provide the full denominator. Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Apply unemployment rate", canonical_key:"apply_unemployment_rate", status:"approved"}}, {concept_id:"f3893ba9-51ef-536f-9584-e2e40d01f647", kc_id:"f3893ba9-51ef-536f-9584-e2e40d01f647", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze variable costs: costs that vary based on the number of units produced Source: chapter 12 Key Terms, printed page 430; related section 12.3.", label:"Analyze variable costs", canonical_key:"analyze_variable_costs", status:"approved"}}, {concept_id:"ba749f50-2441-572d-995b-6497bdf4a75f", kc_id:"ba749f50-2441-572d-995b-6497bdf4a75f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply 5A framework: map of the consumer’s various need states as they find out about a product and finally decide to purchase Source: chapter 13 Key Terms, printed page 467; related section 13.4.", label:"Apply 5A framework", canonical_key:"apply_5a_framework", status:"approved"}}, {concept_id:"44a3e8c8-a152-5b6f-a958-9bbf26c21f61", kc_id:"44a3e8c8-a152-5b6f-a958-9bbf26c21f61", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain advertising: a paid form of nonpersonal communication about a product, service, or idea Source: chapter 13 Key Terms, printed page 467; related section 13.1.", label:"Explain advertising", canonical_key:"explain_advertising", status:"approved"}}, {concept_id:"bb7a288e-ab20-5149-831e-fb5fca59c9e8", kc_id:"bb7a288e-ab20-5149-831e-fb5fca59c9e8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain buy one get one (BOGO): promotion strategy in which consumers are offered the opportunity to buy one product at regular price and get a second item free Source: chapter 13 Key Terms, printed page 467; related section 13.1.", label:"Explain buy one get one (BOGO)", canonical_key:"explain_buy_one_get_one_bogo", status:"approved"}}, {concept_id:"d8a5ecea-916e-5b67-8180-f3324bd4fa42", kc_id:"d8a5ecea-916e-5b67-8180-f3324bd4fa42", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain communication channel: delivery mechanism that takes the message from the company to the consumer Source: chapter 13 Key Terms, printed page 467; related section 13.4.", label:"Explain communication channel", canonical_key:"explain_communication_channel", status:"approved"}}, {concept_id:"a516a39e-7267-5950-adfa-29088bf587bf", kc_id:"a516a39e-7267-5950-adfa-29088bf587bf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain continuous promotional schedule: process of conducting promotions year-round on a regular schedule Source: chapter 13 Key Terms, printed page 467; related section 13.4.", label:"Explain continuous promotional schedule", canonical_key:"explain_continuous_promotional_schedule", status:"approved"}}, {concept_id:"0868a787-a61c-59d5-8b31-d7258825f76d", kc_id:"0868a787-a61c-59d5-8b31-d7258825f76d", properties:{course_id:"8a