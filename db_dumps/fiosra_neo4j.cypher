UNWIND [{concept_id:"3395ae4d-1d07-5b43-9315-5f495e7891f4", kc_id:"3395ae4d-1d07-5b43-9315-5f495e7891f4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain whole channel: the design of the international channels that incorporates all members, including the manufacturing, retailer, and wholesaler sites as well as transportation Source: chapter 7 Key Terms, printed page 250; related section 7.4.", label:"Explain whole channel", canonical_key:"explain_whole_channel", status:"approved"}}, {concept_id:"16c7f61a-3b69-5d86-82c0-026b73cc8191", kc_id:"16c7f61a-3b69-5d86-82c0-026b73cc8191", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain acculturation: the process by which a person’s family cultural patterns change because of direct and constant contact with a different culture Source: chapter 8 Key Terms, printed page 298; related section 8.4.", label:"Explain acculturation", canonical_key:"explain_acculturation", status:"approved"}}, {concept_id:"141da85a-090a-53e0-bccb-680c443e08a3", kc_id:"141da85a-090a-53e0-bccb-680c443e08a3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain adaptation: the process of adjusting a company’s work efforts, goods, or services in response to specific needs, tastes, or expectations—whether real or perceived—from different groups of consumers Source: chapter 8 Key Terms, printed page 298; related section 8.1.", label:"Explain adaptation", canonical_key:"explain_adaptation", status:"approved"}}, {concept_id:"0be3db89-d538-5267-b3ac-45ad2bd246c4", kc_id:"0be3db89-d538-5267-b3ac-45ad2bd246c4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races Source: chapter 8 Key Terms, printed page 298; related section 8.4.", label:"Explain Asian population", canonical_key:"explain_asian_population", status:"approved"}}, {concept_id:"853a393d-8af8-57e2-88cd-dc880ebd979c", kc_id:"853a393d-8af8-57e2-88cd-dc880ebd979c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain Black population: second largest multicultural group in the United States; made up of three different subethnicities: single race, Black Hispanic, or Black mixed with another race (White or Native American) Source: chapter 8 Key Terms, printed page 298; related section 8.4.", label:"Explain Black population", canonical_key:"explain_black_population", status:"approved"}}, {concept_id:"b90716c0-79b0-5989-a5cd-1996053edb0c", kc_id:"b90716c0-79b0-5989-a5cd-1996053edb0c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain company centric: a company’s approach to focusing decisions and execution from the perspective of the organization rather than the customers Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain company centric", canonical_key:"explain_company_centric", status:"approved"}}, {concept_id:"51f342d2-873a-5508-b205-1a14603df105", kc_id:"51f342d2-873a-5508-b205-1a14603df105", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain consumers with disabilities: sociodemographic group living with some type of disability related to mobility, learning, intellectual, or other types of functions; a very diverse group because disabilities span cultural, social, and demographic factors Source: chapter 8 Key Terms, printed page 298; related section 8.5.", label:"Explain consumers with disabilities", canonical_key:"explain_consumers_with_disabilities", status:"approved"}}, {concept_id:"8049f377-86ef-5f96-93d3-505bcc697023", kc_id:"8049f377-86ef-5f96-93d3-505bcc697023", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain cultural duality: characteristic of a multicultural individual for whom cultures overlap with each other and the person feels a sense of belonging to both at the same time Source: chapter 8 Key Terms, printed page 298; related section 8.4.", label:"Explain cultural duality", canonical_key:"explain_cultural_duality", status:"approved"}}, {concept_id:"df05515c-e57f-5748-aac0-2c47bea42c0d", kc_id:"df05515c-e57f-5748-aac0-2c47bea42c0d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain cultural identity: how a person identifies with a given culture, ethnicity, or social group, which instills a sense of belonging that influences personal thinking and actions Source: chapter 8 Key Terms, printed page 298; related section 8.4.", label:"Explain cultural identity", canonical_key:"explain_cultural_identity", status:"approved"}}, {concept_id:"79b1f36b-c139-5cfe-8095-a0ead1b80135", kc_id:"79b1f36b-c139-5cfe-8095-a0ead1b80135", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain culture: objective and subjective elements like social norms, beliefs, behaviors, accomplishments, customs, arts, language, foods, and skills that characterize a particular group of individuals’ way of life Source: chapter 8 Key Terms, printed page 298; related section 8.3.", label:"Explain culture", canonical_key:"explain_culture", status:"approved"}}, {concept_id:"8b9cb2da-2649-5c88-bbc5-ddc4659f0f11", kc_id:"8b9cb2da-2649-5c88-bbc5-ddc4659f0f11", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain customer centric: a company’s focus on putting targeted customers first regarding any decisions about its goods, services, or experiences to create satisfaction and strengthen loyalty Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain customer centric", canonical_key:"explain_customer_centric", status:"approved"}}, {concept_id:"46757a5a-8e38-5b16-af90-c5573b2e1823", kc_id:"46757a5a-8e38-5b16-af90-c5573b2e1823", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain diversity marketing", canonical_key:"explain_diversity_marketing", status:"approved"}}, {concept_id:"73448d58-09a7-501d-b170-71619ac5f928", kc_id:"73448d58-09a7-501d-b170-71619ac5f928", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain diversity marketing intelligence (DMiQ): the capability of identifying, accepting, and valuing the diverseness of consumers within a market and using this knowledge to tailor the marketing mix accordingly Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain diversity marketing intelligence (DMiQ)", canonical_key:"explain_diversity_marketing_intelligence_dmiq", status:"approved"}}, {concept_id:"39613f35-205a-5f51-9c61-dc9f25617d97", kc_id:"39613f35-205a-5f51-9c61-dc9f25617d97", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain generational population: sociodemographic category based on birth year clusters that includes Lost Generation (1883–1900), Greatest Generation (1901–1927), Traditionalist/Silent Generation (1928–1945), baby boomers (1946–1964), Generation X (1965–1980), millennials/Generation Y (1981–1996), Zoomers/ Generation Z (1997–2009), and Generation Alpha (2010–2024) Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain generational population", canonical_key:"explain_generational_population", status:"approved"}}, {concept_id:"6636f717-49ab-571e-9cbb-7775ee71ec55", kc_id:"6636f717-49ab-571e-9cbb-7775ee71ec55", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain Hispanic population: largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe Source: chapter 8 Key Terms, printed page 298; related section 8.4.", label:"Explain Hispanic population", canonical_key:"explain_hispanic_population", status:"approved"}}, {concept_id:"4b0a308b-45ef-52b3-a32c-e2366dd82b40", kc_id:"4b0a308b-45ef-52b3-a32c-e2366dd82b40", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain LGBTQIA+ population: community composed of individuals who express a diversity of genders, preferences, and sexual orientations that include lesbian, gay, bisexual, transsexual, queer/questioning, intersex, asexual, and other sexual identities Source: chapter 8 Key Terms, printed page 298; related section 8.5.", label:"Explain LGBTQIA+ population", canonical_key:"explain_lgbtqia_population", status:"approved"}}, {concept_id:"d8381db9-a946-56d8-a004-d7766e1d48a2", kc_id:"d8381db9-a946-56d8-a004-d7766e1d48a2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain marginalized consumers: populations of consumers that have been pushed to the margins of society and are often excluded in mainstream advertising Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain marginalized consumers", canonical_key:"explain_marginalized_consumers", status:"approved"}}, {concept_id:"4d23a585-6e17-5f7a-a6b9-6459325b53c0", kc_id:"4d23a585-6e17-5f7a-a6b9-6459325b53c0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing mix: the four key elements—product, price, place, and promotion—that shape the development and execution of marketing objectives to reach a target market Source: chapter 8 Key Terms, printed page 298; related section 8.1.", label:"Explain marketing mix", canonical_key:"explain_marketing_mix", status:"approved"}}, {concept_id:"38c6db16-03d4-55f7-9ebc-ad765114c277", kc_id:"38c6db16-03d4-55f7-9ebc-ad765114c277", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain multicultural identity: having an affinity with multiple racial or ethnic groups that a person has been exposed to and self-categorizing as being part of more than one of them Source: chapter 8 Key Terms, printed page 298; related section 8.3.", label:"Explain multicultural identity", canonical_key:"explain_multicultural_identity", status:"approved"}}, {concept_id:"f579e00b-735a-569a-bc61-9c91a5e5844f", kc_id:"f579e00b-735a-569a-bc61-9c91a5e5844f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain multicultural marketing: a subcategory of diversity marketing aimed at intentionally targeting audiences based on different racial, ethnic, and cultural identities and backgrounds Source: chapter 8 Key Terms, printed page 298; related section 8.3.", label:"Explain multicultural marketing", canonical_key:"explain_multicultural_marketing", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"38cc3a7f-34ba-57e6-aebf-96a78e6b01db", kc_id:"38cc3a7f-34ba-57e6-aebf-96a78e6b01db", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain Native American, Alaska Native population: multicultural group of individuals of a single race and mixed races who are native to the United States and its territories including American Indians, Alaska Natives, Native Hawaiians, and American Samoans Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain Native American, Alaska Native population", canonical_key:"explain_native_american_alaska_native_population", status:"approved"}}, {concept_id:"4cff5761-924e-50d8-81e4-61e349e4d203", kc_id:"4cff5761-924e-50d8-81e4-61e349e4d203", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain sociodemographic marketing: a subcategory of diversity marketing aimed at intentionally targeting audiences based on shared social and demographic characteristics such as gender and sexual orientation, age or generation, family structure, religion, education, income level, and disability Source: chapter 8 Key Terms, printed page 298; related section 8.5.", label:"Explain sociodemographic marketing", canonical_key:"explain_sociodemographic_marketing", status:"approved"}}, {concept_id:"d1a6a173-fc50-5b3f-91f7-4b578c9577ac", kc_id:"d1a6a173-fc50-5b3f-91f7-4b578c9577ac", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sociodemographics: the combination of social and demographic factors that characterize specific consumer groups in the market Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain sociodemographics", canonical_key:"explain_sociodemographics", status:"approved"}}, {concept_id:"24bba33b-a66e-5a80-839f-d8b001d15c76", kc_id:"24bba33b-a66e-5a80-839f-d8b001d15c76", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain socioeconomically disadvantaged population: disadvantaged community that lacks social resources and infrastructure to reduce poverty; members tend to be in low-income households, experience financial insecurity, and have less access to education Source: chapter 8 Key Terms, printed page 298; related section 8.2.", label:"Explain socioeconomically disadvantaged population", canonical_key:"explain_socioeconomically_disadvantaged_populati", status:"approved"}}, {concept_id:"cf4c21e3-348a-541a-aa69-ea9461288995", kc_id:"cf4c21e3-348a-541a-aa69-ea9461288995", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain standardization: the process of purposefully applying identical or consistent guidelines to goods or services to achieve uniformity Source: chapter 8 Key Terms, printed page 298; related section 8.1.", label:"Explain standardization", canonical_key:"explain_standardization", status:"approved"}}, {concept_id:"d12b7ffd-523b-59ca-abeb-4be80206d0b4", kc_id:"d12b7ffd-523b-59ca-abeb-4be80206d0b4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Evaluate tokenism: the practice of including an individual from either a minority group or an underrepresented community in marketing efforts simply as a symbol Source: chapter 8 Key Terms, printed page 298; related section 8.6.", label:"Evaluate tokenism", canonical_key:"evaluate_tokenism", status:"approved"}}, {concept_id:"7e818c27-a8b1-5b37-b16b-82342b65e0e1", kc_id:"7e818c27-a8b1-5b37-b16b-82342b65e0e1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain actual product: product available for purchase Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain actual product", canonical_key:"explain_actual_product", status:"approved"}}, {concept_id:"4e22a903-0c7f-5818-95bc-288741d57573", kc_id:"4e22a903-0c7f-5818-95bc-288741d57573", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain augmented product: product having unseen aspects essential to customers Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain augmented product", canonical_key:"explain_augmented_product", status:"approved"}}, {concept_id:"e7e83723-60b0-50be-93e6-53f057ab3926", kc_id:"e7e83723-60b0-50be-93e6-53f057ab3926", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brand: an intangible asset with tangible value; made up of promotion efforts and customer meaning Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain brand", canonical_key:"explain_brand", status:"approved"}}, {concept_id:"e7ecbb75-5cf7-55e0-a74e-53c6105f7743", kc_id:"e7ecbb75-5cf7-55e0-a74e-53c6105f7743", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brand engagement: measure of how deeply the customer identifies emotionally with a brand Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain brand engagement", canonical_key:"explain_brand_engagement", status:"approved"}}, {concept_id:"649c0ea7-fa07-5f9a-aca1-500125c49435", kc_id:"649c0ea7-fa07-5f9a-aca1-500125c49435", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze brand equity: the additional value that a brand has over a substitute Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Analyze brand equity", canonical_key:"analyze_brand_equity", status:"approved"}}, {concept_id:"e8da8bec-9f05-51b9-b9d5-90c75b70af24", kc_id:"e8da8bec-9f05-51b9-b9d5-90c75b70af24", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brand extensions: products that leverage the brand name to new product categories Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain brand extensions", canonical_key:"explain_brand_extensions", status:"approved"}}, {concept_id:"eeee4bbc-a9b5-547f-a7f9-b4b963e5c148", kc_id:"eeee4bbc-a9b5-547f-a7f9-b4b963e5c148", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brand lift: measure of customer and noncustomer perception of a product over time Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain brand lift", canonical_key:"explain_brand_lift", status:"approved"}}, {concept_id:"900ab1d9-3129-5fc7-bd85-4e76e70fe37c", kc_id:"900ab1d9-3129-5fc7-bd85-4e76e70fe37c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain brand name: the official name of a brand Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain brand name", canonical_key:"explain_brand_name", status:"approved"}}, {concept_id:"9184cd97-0f28-55e4-a6f5-55d14d17c37c", kc_id:"9184cd97-0f28-55e4-a6f5-55d14d17c37c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain brand positioning: the way a brand signals emotions in consumers’ minds Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain brand positioning", canonical_key:"explain_brand_positioning", status:"approved"}}, {concept_id:"828292d6-bd8c-5dc4-a252-9f8f16434fac", kc_id:"828292d6-bd8c-5dc4-a252-9f8f16434fac", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain brand preference: measure of the degree to which a brand is preferred over others in the category Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain brand preference", canonical_key:"explain_brand_preference", status:"approved"}}, {concept_id:"cab5bc19-e138-5409-947a-72cab12b6514", kc_id:"cab5bc19-e138-5409-947a-72cab12b6514", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze brand value: the financial asset associated with a brand Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Analyze brand value", canonical_key:"analyze_brand_value", status:"approved"}}, {concept_id:"498f33cc-51a3-5f5a-b39a-69c83b335b70", kc_id:"498f33cc-51a3-5f5a-b39a-69c83b335b70", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain branding: the process of developing a brand Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain branding", canonical_key:"explain_branding", status:"approved"}}, {concept_id:"1a199f95-54ee-56ab-b4d7-2beb6f73e72f", kc_id:"1a199f95-54ee-56ab-b4d7-2beb6f73e72f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain capital items: assets valuable to a business that also have tangible value Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain capital items", canonical_key:"explain_capital_items", status:"approved"}}, {concept_id:"7b9cd7b4-260b-5a4b-a131-d6fe53f05c2d", kc_id:"7b9cd7b4-260b-5a4b-a131-d6fe53f05c2d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain co-brand: to bring the equity of two brands together for greater value Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain co-brand", canonical_key:"explain_co_brand", status:"approved"}}] AS row
