UNWIND [{concept_id:"d7d06f5b-0a16-5713-a964-7b066c766426", kc_id:"d7d06f5b-0a16-5713-a964-7b066c766426", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain channel member (intermediary): a company that works in a network with other companies to help gets products from manufacturers to final consumers Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Explain channel member (intermediary)", canonical_key:"explain_channel_member_intermediary", status:"approved"}}, {concept_id:"3d0662d6-6f8c-5e70-962d-97d040be40db", kc_id:"3d0662d6-6f8c-5e70-962d-97d040be40db", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain contractual VMS: independent companies that have joined together by contract for a mutually beneficial purpose Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain contractual VMS", canonical_key:"explain_contractual_vms", status:"approved"}}, {concept_id:"02fc1adc-dfae-5973-b4f4-e71920bd3f5c", kc_id:"02fc1adc-dfae-5973-b4f4-e71920bd3f5c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain corporate VMS: when one member of the distribution channel owns the other members Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain corporate VMS", canonical_key:"explain_corporate_vms", status:"approved"}}, {concept_id:"9433c9e5-782e-5bd5-8e74-099dff278f1a", kc_id:"9433c9e5-782e-5bd5-8e74-099dff278f1a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze customer-perceived value: the overall perception that a consumer has about a company, brand, or product and is measured by what the consumer is willing to pay in return for the features and benefits in the market offering Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Analyze customer-perceived value", canonical_key:"analyze_customer_perceived_value", status:"approved"}}, {concept_id:"e420833a-87f8-5e2d-ae21-f812de05a434", kc_id:"e420833a-87f8-5e2d-ae21-f812de05a434", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain direct channel: when companies sell and distribute their products directly to consumers Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain direct channel", canonical_key:"explain_direct_channel", status:"approved"}}, {concept_id:"5eef05de-1b56-55e2-bbbc-6ec7b9cd497b", kc_id:"5eef05de-1b56-55e2-bbbc-6ec7b9cd497b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain direct marketing channel: when a manufacturer does not use intermediaries but rather involves the manufacturer distributing its market offering directly to consumers Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain direct marketing channel", canonical_key:"explain_direct_marketing_channel", status:"approved"}}, {concept_id:"785c6e6b-c67f-5a02-8655-9101e1cb9b14", kc_id:"785c6e6b-c67f-5a02-8655-9101e1cb9b14", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain disintermediation: the process of removing an intermediary from a marketing channel Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Explain disintermediation", canonical_key:"explain_disintermediation", status:"approved"}}, {concept_id:"c80c985e-0ab3-5f21-8b68-8e01b64e7261", kc_id:"c80c985e-0ab3-5f21-8b68-8e01b64e7261", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain distribution: the process of making products and services available and accessible to consumers to purchase Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Explain distribution", canonical_key:"explain_distribution", status:"approved"}}, {concept_id:"27d57e3b-37b6-584d-998c-6397ca4dfaed", kc_id:"27d57e3b-37b6-584d-998c-6397ca4dfaed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain distributor: a type of intermediary that takes ownership of the product and tends to align itself closely with a manufacturer Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain distributor", canonical_key:"explain_distributor", status:"approved"}}, {concept_id:"a0790f46-e059-5940-a663-3354ae6c1de3", kc_id:"a0790f46-e059-5940-a663-3354ae6c1de3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain exclusive distribution: a strategy that involves allowing a limited number of intermediaries to distribute a company’s market offering Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain exclusive distribution", canonical_key:"explain_exclusive_distribution", status:"approved"}}, {concept_id:"6c12c295-cca6-513f-a94e-887956c5b9ca", kc_id:"6c12c295-cca6-513f-a94e-887956c5b9ca", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain facilitating functions: activities such as financing and information sharing in the marketing channel Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain facilitating functions", canonical_key:"explain_facilitating_functions", status:"approved"}}, {concept_id:"f3467134-765a-59af-8a31-9d83cc0289b0", kc_id:"f3467134-765a-59af-8a31-9d83cc0289b0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain final consumer: the end user of a good or service Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain final consumer", canonical_key:"explain_final_consumer", status:"approved"}}, {concept_id:"6c8b1548-f109-50fd-a337-cd27556e885f", kc_id:"6c8b1548-f109-50fd-a337-cd27556e885f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze horizontal conflict: when there is disagreement among firms at the same level in the marketing channel Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Analyze horizontal conflict", canonical_key:"analyze_horizontal_conflict", status:"approved"}}, {concept_id:"25f44f8a-38ba-59c9-8d13-d4918dbf034b", kc_id:"25f44f8a-38ba-59c9-8d13-d4918dbf034b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain horizontal marketing system: a group of unrelated companies that offer products and services in a shared space Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain horizontal marketing system", canonical_key:"explain_horizontal_marketing_system", status:"approved"}}, {concept_id:"01bd204d-cf18-5937-872b-47860a16c6e6", kc_id:"01bd204d-cf18-5937-872b-47860a16c6e6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain indirect channel: involves the utilization of one or more intermediaries to distribute a market offering to consumers Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain indirect channel", canonical_key:"explain_indirect_channel", status:"approved"}}, {concept_id:"28a36719-cf14-5529-9747-856bdf218e83", kc_id:"28a36719-cf14-5529-9747-856bdf218e83", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain intensive distribution: a distribution strategy that entails distributing a company’s market offering through all possible intermediaries Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain intensive distribution", canonical_key:"explain_intensive_distribution", status:"approved"}}, {concept_id:"abfeacbf-a088-57c9-be2c-7adda1330dec", kc_id:"abfeacbf-a088-57c9-be2c-7adda1330dec", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain inventory management: a function that involves identifying the type of inventory and how much a company has on hand at any given time Source: chapter 17 Key Terms, printed page 605; related section 17.6.", label:"Explain inventory management", canonical_key:"explain_inventory_management", status:"approved"}}, {concept_id:"f6ff68c5-86db-5dfd-be07-17c7987b2dc4", kc_id:"f6ff68c5-86db-5dfd-be07-17c7987b2dc4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply inventory turnover rate: a metric that measures how quickly inventory is turned over, or sold Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Apply inventory turnover rate", canonical_key:"apply_inventory_turnover_rate", status:"approved"}}, {concept_id:"eedeaebe-baac-5808-8677-d3f88cf7e65b", kc_id:"eedeaebe-baac-5808-8677-d3f88cf7e65b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain logistical functions: the handling, packing, inventorying, transporting, warehousing, and ensuring the security of products as they make their way to the customer Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain logistical functions", canonical_key:"explain_logistical_functions", status:"approved"}}, {concept_id:"379c93ea-311b-597f-93b6-b6e076251718", kc_id:"379c93ea-311b-597f-93b6-b6e076251718", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain logistics: the coordination of all supply chain activities, such as warehousing, inventory management, and transportation Source: chapter 17 Key Terms, printed page 605; related section 17.6.", label:"Explain logistics", canonical_key:"explain_logistics", status:"approved"}}] AS row
