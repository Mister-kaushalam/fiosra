UNWIND [{concept_id:"12953b56-1f17-5726-b41f-0184e2cd2c5f", kc_id:"12953b56-1f17-5726-b41f-0184e2cd2c5f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain marketing channel", canonical_key:"explain_marketing_channel", status:"approved"}}, {concept_id:"ab45dfc0-25ab-57ea-a6c0-5c282e8efe00", kc_id:"ab45dfc0-25ab-57ea-a6c0-5c282e8efe00", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain multichannel distribution system: where a single company sets up multiple distribution channels to reach customers Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain multichannel distribution system", canonical_key:"explain_multichannel_distribution_system", status:"approved"}}, {concept_id:"3a3d3353-2df2-592d-a783-2425194bbe76", kc_id:"3a3d3353-2df2-592d-a783-2425194bbe76", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain omnichannel marketing system: multichannel approach whereby companies give consumers a variety of ways to purchase, receive, and return products Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain omnichannel marketing system", canonical_key:"explain_omnichannel_marketing_system", status:"approved"}}, {concept_id:"837de390-1242-5562-9575-6194134d3853", kc_id:"837de390-1242-5562-9575-6194134d3853", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply order accuracy rate: a metric that measures the percentage of orders that are processed, fulfilled, and shipped to consumers without any errors Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Apply order accuracy rate", canonical_key:"apply_order_accuracy_rate", status:"approved"}}, {concept_id:"6ba8d8bc-debb-5034-8cbf-c751448d47c2", kc_id:"6ba8d8bc-debb-5034-8cbf-c751448d47c2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain percentage of on-time shipments: a metric used to evaluate how well a channel member meets its promise of delivering goods on time Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Explain percentage of on-time shipments", canonical_key:"explain_percentage_of_on_time_shipments", status:"approved"}}, {concept_id:"2134dd09-0502-5d6f-955c-23119de1c006", kc_id:"2134dd09-0502-5d6f-955c-23119de1c006", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"threshold", definition:"Analyze perishability: relates to the likelihood that a product will spoil, decay, or expire if not used in a timely manner Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Analyze perishability", canonical_key:"analyze_perishability", status:"approved"}}, {concept_id:"d61b285c-0dca-553c-94ba-69a23a4e64f3", kc_id:"d61b285c-0dca-553c-94ba-69a23a4e64f3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain post-sale service: all activities provided by a company that reinforce the value of the product or service for the buyer Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain post-sale service", canonical_key:"explain_post_sale_service", status:"approved"}}, {concept_id:"45503b09-bab2-5368-b7b8-8217f908e9d7", kc_id:"45503b09-bab2-5368-b7b8-8217f908e9d7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain pre-sale service: all activities provided by a company that help a buyer make a purchase decision Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain pre-sale service", canonical_key:"explain_pre_sale_service", status:"approved"}}, {concept_id:"e02d1b11-acc1-5ec3-a977-69d0061fe2a1", kc_id:"e02d1b11-acc1-5ec3-a977-69d0061fe2a1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain producer: a company that supplies the raw materials that manufacturers need to create consumer products Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain producer", canonical_key:"explain_producer", status:"approved"}}, {concept_id:"18acaecc-b250-5182-b3cb-bb1d686f1f94", kc_id:"18acaecc-b250-5182-b3cb-bb1d686f1f94", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain producer to retailer to consumer channel: when manufacturers or producers sell to retailers without the use of wholesalers or distributors Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain producer to retailer to consumer channel", canonical_key:"explain_producer_to_retailer_to_consumer_channel", status:"approved"}}, {concept_id:"371ac29e-3232-59d4-a0f5-29f1e4ef63f3", kc_id:"371ac29e-3232-59d4-a0f5-29f1e4ef63f3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product life cycle: the various stages that a product goes through from its introduction phase, to its growth and maturity phase, and in some cases to its decline phase Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain product life cycle", canonical_key:"explain_product_life_cycle", status:"approved"}}, {concept_id:"a8179597-192b-5f84-9246-bdc80f434bd7", kc_id:"a8179597-192b-5f84-9246-bdc80f434bd7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain purchasing: the process of buying materials needed to manufacture products Source: chapter 17 Key Terms, printed page 605; related section 17.5.", label:"Explain purchasing", canonical_key:"explain_purchasing", status:"approved"}}, {concept_id:"7ef9edde-9529-538f-b45d-a06648987ae3", kc_id:"7ef9edde-9529-538f-b45d-a06648987ae3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain retailer: a type of intermediary where retailers take ownership of the product and their sole focus is on reaching the end user or customer directly Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain retailer", canonical_key:"explain_retailer", status:"approved"}}, {concept_id:"a73c6ca7-7e1b-5095-87dd-3d6dfb3236c9", kc_id:"a73c6ca7-7e1b-5095-87dd-3d6dfb3236c9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain selective distribution: a strategy that includes choosing more than one, but fewer than all possible intermediaries to distribute a company’s market offering Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain selective distribution", canonical_key:"explain_selective_distribution", status:"approved"}}, {concept_id:"289e5860-4750-5bac-81b6-d3d10d724403", kc_id:"289e5860-4750-5bac-81b6-d3d10d724403", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain standardized: products that have no difference in how they are manufactured Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain standardized", canonical_key:"explain_standardized", status:"approved"}}, {concept_id:"086730c2-c654-50e1-bfc8-52c9f6d96afe", kc_id:"086730c2-c654-50e1-bfc8-52c9f6d96afe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain supply chain: a network between a company and its suppliers to produce and distribute a specific product to the final buyer Source: chapter 17 Key Terms, printed page 605; related section 17.5.", label:"Explain supply chain", canonical_key:"explain_supply_chain", status:"approved"}}, {concept_id:"566bec21-9123-5468-a6f7-230e66c9ae1f", kc_id:"566bec21-9123-5468-a6f7-230e66c9ae1f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain supply chain management: all members and activities from the procurement and transformation of raw materials into finished goods through their distribution to targeted consumers Source: chapter 17 Key Terms, printed page 605; related section 17.5.", label:"Explain supply chain management", canonical_key:"explain_supply_chain_management", status:"approved"}}, {concept_id:"8f359a03-dcc7-52f8-b553-7bba5f06e5f7", kc_id:"8f359a03-dcc7-52f8-b553-7bba5f06e5f7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sustainability: a company’s effort to reduce its impact on the environment as products move from source procurement through production through distribution to final consumers Source: chapter 17 Key Terms, printed page 605; related section 17.7.", label:"Explain sustainability", canonical_key:"explain_sustainability", status:"approved"}}, {concept_id:"4ea8e1c6-98cb-55bb-9cf8-eb7f12e47c16", kc_id:"4ea8e1c6-98cb-55bb-9cf8-eb7f12e47c16", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain sustainable sourcing: the process of considering suppliers’ social, ethical, and environmental performance Source: chapter 17 Key Terms, printed page 605; related section 17.7.", label:"Explain sustainable sourcing", canonical_key:"explain_sustainable_sourcing", status:"approved"}}, {concept_id:"e93752c3-3194-5ac5-b94e-90a73e786e94", kc_id:"e93752c3-3194-5ac5-b94e-90a73e786e94", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain target market coverage: resources and capabilities needed to reach consumers in a company’s target market Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain target market coverage", canonical_key:"explain_target_market_coverage", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"c5e3b914-caf1-5a02-9372-19f64f01f392", kc_id:"c5e3b914-caf1-5a02-9372-19f64f01f392", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain third-party logistics (3PL) provider: a company that is contracted by a channel member to handle one or more of the functional areas of logistics; often warehouses, distribution centers, or fulfillment centers that have expertise in managing certain logistical activities Source: chapter 17 Key Terms, printed page 605; related section 17.6.", label:"Explain third-party logistics (3PL) provider", canonical_key:"explain_third_party_logistics_3pl_provider", status:"approved"}}, {concept_id:"e16af073-a9df-5dca-acbb-ad0f4303f230", kc_id:"e16af073-a9df-5dca-acbb-ad0f4303f230", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain time to ship: also known as order cycle time, the length of time from when a customer places an order to when it reaches them Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Explain time to ship", canonical_key:"explain_time_to_ship", status:"approved"}}, {concept_id:"a51a6791-8fd5-50ac-b913-7f30fe909307", kc_id:"a51a6791-8fd5-50ac-b913-7f30fe909307", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain total number of orders: the sum of all orders that a company received in a given time period Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Explain total number of orders", canonical_key:"explain_total_number_of_orders", status:"approved"}}, {concept_id:"431e7ad6-7f1f-5551-abce-624464b9584e", kc_id:"431e7ad6-7f1f-5551-abce-624464b9584e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain total units in storage: a metric used to evaluate warehouse efficiency that changes as items are sold and leave the warehouse and new inventory moves in Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Explain total units in storage", canonical_key:"explain_total_units_in_storage", status:"approved"}}, {concept_id:"7fb08194-80f1-5c2f-b333-c2a832ff14fe", kc_id:"7fb08194-80f1-5c2f-b333-c2a832ff14fe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain transactional functions: buying, selling, and risk-bearing that goes along with the movement of products along the marketing channel Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain transactional functions", canonical_key:"explain_transactional_functions", status:"approved"}}, {concept_id:"0f4c130a-e99f-50d7-91fc-a0cc827167b1", kc_id:"0f4c130a-e99f-50d7-91fc-a0cc827167b1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze unit value: the price that a company charges for one unit or item Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Analyze unit value", canonical_key:"analyze_unit_value", status:"approved"}}, {concept_id:"cefdff90-d964-5e80-af13-d2a77029ffe9", kc_id:"cefdff90-d964-5e80-af13-d2a77029ffe9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze vertical conflict: a conflict that exists between different levels of a vertical channel Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Analyze vertical conflict", canonical_key:"analyze_vertical_conflict", status:"approved"}}, {concept_id:"cab01be0-0cd9-5fa7-b4fa-5e2ec74d2cee", kc_id:"cab01be0-0cd9-5fa7-b4fa-5e2ec74d2cee", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain vertical marketing system: companies in the marketing channel that work together in a coordinated, collaborative, and customer-centric way Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain vertical marketing system", canonical_key:"explain_vertical_marketing_system", status:"approved"}}, {concept_id:"ff52fcc7-27da-5649-8bf0-ee395b4243f1", kc_id:"ff52fcc7-27da-5649-8bf0-ee395b4243f1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain warehousing: the stocking, maintaining, and controlling of products while they await the next step in their journey to the final consumer Source: chapter 17 Key Terms, printed page 605; related section 17.6.", label:"Explain warehousing", canonical_key:"explain_warehousing", status:"approved"}}, {concept_id:"429f4075-538d-5201-bcd0-94b10c82ec14", kc_id:"429f4075-538d-5201-bcd0-94b10c82ec14", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain wholesaler: similar to distributors in that they take ownership of products; buys products in large quantities for the purpose of distributing an assortment of products to retailers Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain wholesaler", canonical_key:"explain_wholesaler", status:"approved"}}, {concept_id:"91c6f8cf-1f3a-550c-a28b-1138044c7846", kc_id:"91c6f8cf-1f3a-550c-a28b-1138044c7846", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain automatic vending: the use of an electronic device that dispenses a product Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain automatic vending", canonical_key:"explain_automatic_vending", status:"approved"}}, {concept_id:"df49b413-464d-5efe-a528-c8667728d99f", kc_id:"df49b413-464d-5efe-a528-c8667728d99f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain cash-and-carry wholesalers: wholesalers that offer a limited line of fast-moving goods that they sell to retailers for cash Source: chapter 18 Key Terms, printed page 643; related section 18.5.", label:"Explain cash-and-carry wholesalers", canonical_key:"explain_cash_and_carry_wholesalers", status:"approved"}}, {concept_id:"28d676f9-8b61-5c1a-9538-b6e609912364", kc_id:"28d676f9-8b61-5c1a-9538-b6e609912364", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain category killers: large superstores, most often chains stores, that are bigger, cheaper, and more convenient than competitors Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain category killers", canonical_key:"explain_category_killers", status:"approved"}}, {concept_id:"452437ed-5f4f-5f24-a2cf-d638afba377a", kc_id:"452437ed-5f4f-5f24-a2cf-d638afba377a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain category management: grouping similar products into categories based on customer usage Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain category management", canonical_key:"explain_category_management", status:"approved"}}, {concept_id:"ac72050f-34c0-59e4-98be-8ca6362c073e", kc_id:"ac72050f-34c0-59e4-98be-8ca6362c073e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain central business district (CBD): the commercial and business center of a given city or town Source: chapter 18 Key Terms, printed page 643; related section 18.3.", label:"Explain central business district (CBD)", canonical_key:"explain_central_business_district_cbd", status:"approved"}}, {concept_id:"18d5fd1d-6917-5fcc-a7a0-fdccf29facef", kc_id:"18d5fd1d-6917-5fcc-a7a0-fdccf29facef", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain convenience store: a small retail business that stocks a limited range of everyday items such as groceries, snacks, soft drinks, tobacco, toiletries, and lottery tickets Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain convenience store", canonical_key:"explain_convenience_store", status:"approved"}}, {concept_id:"775d7a7e-1bf0-59df-b954-b8a4f8f84f23", kc_id:"775d7a7e-1bf0-59df-b954-b8a4f8f84f23", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain department stores: larger retailers that have separated areas—or departments—for similar product lines Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain department stores", canonical_key:"explain_department_stores", status:"approved"}}, {concept_id:"01080609-f0e6-549f-a811-8b3350b5f910", kc_id:"01080609-f0e6-549f-a811-8b3350b5f910", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain digital wallets: software-based systems that allow for secure transactions Source: chapter 18 Key Terms, printed page 643; related section 18.4.", label:"Explain digital wallets", canonical_key:"explain_digital_wallets", status:"approved"}}, {concept_id:"07c8d6af-164f-5e19-a519-5b88e23a8911", kc_id:"07c8d6af-164f-5e19-a519-5b88e23a8911", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain direct mail: solicited or unsolicited advertising of products and services to prospective customers through the mail Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain direct mail", canonical_key:"explain_direct_mail", status:"approved"}}, {concept_id:"9aa55ed1-de4a-5e4b-a702-83f2f066d2df", kc_id:"9aa55ed1-de4a-5e4b-a702-83f2f066d2df", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain direct selling: a marketing strategy that involves selling products and services directly to the consumer in a non-retail setting Source: chapter 18 Key Terms, printed page 643; related section 18.2.", label:"Explain direct selling", canonical_key:"explain_direct_selling", status:"approved"}}] AS row
