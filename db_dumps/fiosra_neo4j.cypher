UNWIND [{concept_id:"d3fbd7bc-a05a-57e9-b66b-e58fa618fce1", kc_id:"d3fbd7bc-a05a-57e9-b66b-e58fa618fce1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 5, Closing Company Case, task 4. Case context: Travelers Point Distillery In early 2000, several friends got together to tell stories and drink bourbon. It was obvious that friends and stories come together with good bourbon. The best stories included the rich family history of Master Distiller Mel Lytton. Dating back to the 1880s and into prohibition, Mel’s…. Learner task: Develop a perceptual map of the bourbon brands currently selling for $40–60 per bottle.", label:"Ch. 5 Closing Company Case, task 4: Develop a perceptual map of the bourbon brands currently selling for $40–60 per bottle.", canonical_key:"ch_5_closing_company_case_task_4_develop_a_perce", status:"approved"}}, {concept_id:"4075db87-8457-5e48-b829-f000ada3f475", kc_id:"4075db87-8457-5e48-b829-f000ada3f475", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Applied Marketing Knowledge: Discussion Questions, task 1. Learner task: Why is it vital for companies to understand and use customer insights in gathering and managing marketing information?", label:"Ch. 6 Discussion Questions, task 1: Why is it vital for companies to understand and use customer insights in gathering and…", canonical_key:"ch_6_discussion_questions_task_1_why_is_it_vital", status:"approved"}}, {concept_id:"62e7908f-7d3e-5b42-aa7f-c4bfe6f8074f", kc_id:"62e7908f-7d3e-5b42-aa7f-c4bfe6f8074f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Applied Marketing Knowledge: Discussion Questions, task 2. Learner task: Public policies and laws supporting ethics in marketing research have resulted in companies like Meta (formerly Facebook) being accused of intruding upon consumer privacy, misusing information gathered from users, and exploiting children. As a consumer, how do you feel about companies tracing your digital footprint? As a marketer, what value do you see in tracing consumers’ online activities?", label:"Ch. 6 Discussion Questions, task 2: Public policies and laws supporting ethics in marketing research have resulted in…", canonical_key:"ch_6_discussion_questions_task_2_public_policies", status:"approved"}}, {concept_id:"1c3f85df-e37e-5ccc-94c9-174eb970cdd4", kc_id:"1c3f85df-e37e-5ccc-94c9-174eb970cdd4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Applied Marketing Knowledge: Discussion Questions, task 3. Learner task: What are the seven steps necessary in designing a marketing research project?", label:"Ch. 6 Discussion Questions, task 3: What are the seven steps necessary in designing a marketing research project", canonical_key:"ch_6_discussion_questions_task_3_what_are_the_se", status:"approved"}}, {concept_id:"5c630a96-d65f-5247-958f-d4bd796f357f", kc_id:"5c630a96-d65f-5247-958f-d4bd796f357f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Applied Marketing Knowledge: Discussion Questions, task 4. Learner task: List two reasons why quantitative research data is better utilized to measure a population’s attitudes and potential responses to new product releases than qualitative data. List two reasons why qualitative data is most often collected to provide deeper insights into consumer behavior.", label:"Ch. 6 Discussion Questions, task 4: List two reasons why quantitative research data is better utilized to measure a…", canonical_key:"ch_6_discussion_questions_task_4_list_two_reason", status:"approved"}}, {concept_id:"c4c64971-a1dc-5e2a-a49d-f9bfd5b89f17", kc_id:"c4c64971-a1dc-5e2a-a49d-f9bfd5b89f17", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Applied Marketing Knowledge: Discussion Questions, task 5. Learner task: Research codes of conduct are published by the American Marketing Association, the American Association for Public Opinion Research, the Council of American Survey Research Organizations, and the Marketing Research Association in order to define standards of ethical behavior. List three overlapping areas these organizations have identified as important in regulating the marketing industry.", label:"Ch. 6 Discussion Questions, task 5: Research codes of conduct are published by the American Marketing Association, the…", canonical_key:"ch_6_discussion_questions_task_5_research_codes_", status:"approved"}}, {concept_id:"4050cfee-09f5-5570-84f3-434844974594", kc_id:"4050cfee-09f5-5570-84f3-434844974594", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Critical Thinking Exercises, task 1. Learner task: Draw a diagram depicting a marketing information system. Show how the marketing research process connects marketing managers with the marketing environment in order to collect information through internal records, marketing intelligence, and marketing research. Remember that the overall intent is first to assess information needs in order to reduce information gaps between the company and its customers, target markets, suppliers, and prospective clients. Amassing timely information allows firms to address these gaps, design the method for collecting information, manage and implement the data collection process, analyze the results, and disseminate results and their implications.", label:"Ch. 6 Critical Thinking Exercises, task 1: Draw a diagram depicting a marketing information system", canonical_key:"ch_6_critical_thinking_exercises_task_1_draw_a_d", status:"approved"}}, {concept_id:"a905cbd5-f2af-585d-86fc-9c1a7b6b2b02", kc_id:"a905cbd5-f2af-585d-86fc-9c1a7b6b2b02", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Critical Thinking Exercises, task 2. Learner task: Conduct a survey of five college students via email, social media, telephone, or in person to learn more about the student demographic. Explain that you are collecting data for a classroom assignment only and will not identify them by name. Ask these questions: A. If you could adopt a rescue animal today, what would it be? B. What is the best pizza topping? C. Would you rather sneeze for an hour or have hiccups for an hour? D. Would you rather get $1 million right now or $10,000 per month for a lifetime? E. What is your least favorite food? 2a. Summarize and report your results in a chart. 2b. C and D are structurally different questions than A, B, and E. What is different between these questions? 2c. Can your findings be applied to all college…", label:"Ch. 6 Critical Thinking Exercises, task 2: Conduct a survey of five college students via email, social media, telephone, or in…", canonical_key:"ch_6_critical_thinking_exercises_task_2_conduct_", status:"approved"}}, {concept_id:"654ee1a9-03d4-57fd-bbe0-8da201aae056", kc_id:"654ee1a9-03d4-57fd-bbe0-8da201aae056", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Critical Thinking Exercises, task 3. Learner task: The US Census gathers and disseminates detailed big data about US residents. Visit Explore Census Data (https://openstax.org/r/datacensus) and type your hometown into the search box. The results will include maps, web pages mentioning your hometown, and tables of information gathered by the decennial census as well as the American Community Survey. What method was used to collect this data? Do these tables represent probability or nonprobability samples? Why might these tables be important informational sources for marketers? Check out the table reporting age and sex. What is the median age? Does this statistic surprise you?", label:"Ch. 6 Critical Thinking Exercises, task 3: The US Census gathers and disseminates detailed big data about US residents", canonical_key:"ch_6_critical_thinking_exercises_task_3_the_us_c", status:"approved"}}, {concept_id:"9b2ae258-a23e-58b8-a1ea-3e8fb372e888", kc_id:"9b2ae258-a23e-58b8-a1ea-3e8fb372e888", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Building Your Personal Brand, task 1. Learner task: If you’re a curious person, you may enjoy a career in data science, marketing research, or consumer insights. Businesses report that there is a growing need for data specialists—analysts, engineers, scientists, translators, and cybersecurity managers—to grasp the power of data insights to drive major business initiatives. Business professionals across organizations depend on analytical know-how to make informed decisions with real-time insights. Ongoing data evolution requires data scientists to learn and adopt new technology to accelerate organizational data strategies. For budding professionals in the data science/consumer insights field, it’s essential to have foundational knowledge in applied mathematics, statistics, data analytics and…", label:"Ch. 6 Building Your Personal Brand, task 1: If you’re a curious person, you may enjoy a career in data science, marketing…", canonical_key:"ch_6_building_your_personal_brand_task_1_if_you_", status:"approved"}}, {concept_id:"7adf76dd-fd44-5895-9d82-cb4743308e11", kc_id:"7adf76dd-fd44-5895-9d82-cb4743308e11", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, What Do Marketers Do?, task 1. Learner task: Research is a part of many career paths for marketers and business personnel. Financial planners, human resource managers, logistics analysts, and marketing strategists all use research on a daily basis. Most businesses now rely upon customer loyalty and product/service ratings as they attempt to gain distinction among competitors. Many companies now ask consumers to rate their products and services. That rating is the next best thing to asking friends and family members for product suggestions. Customers want proof that products or services are reputable. Customer reviews are vital in providing personalized experience and insights to promote customer relationships. Speak to a consumer insights specialist from a local advertising agency or a…", label:"Ch. 6 What Do Marketers Do?, task 1: Research is a part of many career paths for marketers and business personnel", canonical_key:"ch_6_what_do_marketers_do_task_1_research_is_a_p", status:"approved"}}, {concept_id:"91326e2a-9c4e-5829-a491-41f4e6ee2a55", kc_id:"91326e2a-9c4e-5829-a491-41f4e6ee2a55", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Marketing Plan Exercise, task 1. Learner task: Complete the following information about the company and products/services you chose to focus on for this marketing plan exercise. You may need to conduct research to gather necessary information. Instructions: Using the Marketing Plan Template file you created from Marketing and Consumer Value and expanded upon in Strategic Planning in Marketing and Market Segmentation, Targeting, and Positioning, complete the following section of your marketing plan: Current Market Situation/Situation Analysis. Once complete, submit the marketing plan to your instructor for grading and feedback.", label:"Ch. 6 Marketing Plan Exercise, task 1: Complete the following information about the company and products/services you chose…", canonical_key:"ch_6_marketing_plan_exercise_task_1_complete_the", status:"approved"}}, {concept_id:"f7d6c25e-9693-5fdd-8181-fef09a7419de", kc_id:"f7d6c25e-9693-5fdd-8181-fef09a7419de", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Closing Company Case, task 1. Case context: Nordstrom One day a customer walked into an upscale fashion retail store in Anchorage, Alaska, to return a set of tires. The store had a wide selection of shoes, clothes, and accessories, but no tires. However, the store that previously occupied the space did sell tires. After much discussion, a Nordstrom store…. Learner task: Nordstrom is legendary for providing the best customer experience. What are some of the ways Nordstrom has gathered marketing research from the consumer?", label:"Ch. 6 Closing Company Case, task 1: Nordstrom is legendary for providing the best customer experience", canonical_key:"ch_6_closing_company_case_task_1_nordstrom_is_le", status:"approved"}}, {concept_id:"fe6bdc34-8b50-5491-85f1-fcf63f225f41", kc_id:"fe6bdc34-8b50-5491-85f1-fcf63f225f41", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Closing Company Case, task 2. Case context: Nordstrom One day a customer walked into an upscale fashion retail store in Anchorage, Alaska, to return a set of tires. The store had a wide selection of shoes, clothes, and accessories, but no tires. However, the store that previously occupied the space did sell tires. After much discussion, a Nordstrom store…. Learner task: When Nordstrom analyzes the data found in its online sales platforms, what type of marketing research is it using?", label:"Ch. 6 Closing Company Case, task 2: When Nordstrom analyzes the data found in its online sales platforms, what type of…", canonical_key:"ch_6_closing_company_case_task_2_when_nordstrom_", status:"approved"}}, {concept_id:"e5c8192f-cbf6-520f-a260-f66c1af0e88a", kc_id:"e5c8192f-cbf6-520f-a260-f66c1af0e88a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Closing Company Case, task 3. Case context: Nordstrom One day a customer walked into an upscale fashion retail store in Anchorage, Alaska, to return a set of tires. The store had a wide selection of shoes, clothes, and accessories, but no tires. However, the store that previously occupied the space did sell tires. After much discussion, a Nordstrom store…. Learner task: In what ways has Nordstrom used data to enhance the customer experience?", label:"Ch. 6 Closing Company Case, task 3: In what ways has Nordstrom used data to enhance the customer experience", canonical_key:"ch_6_closing_company_case_task_3_in_what_ways_ha", status:"approved"}}, {concept_id:"5c8f6de7-f551-5979-a22b-eb87ca320fe9", kc_id:"5c8f6de7-f551-5979-a22b-eb87ca320fe9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 6, Closing Company Case, task 4. Case context: Nordstrom One day a customer walked into an upscale fashion retail store in Anchorage, Alaska, to return a set of tires. The store had a wide selection of shoes, clothes, and accessories, but no tires. However, the store that previously occupied the space did sell tires. After much discussion, a Nordstrom store…. Learner task: Nordstrom realized a connection between online shopping and in-store shopping. It developed methods to capture the online customer and increase in-store sales. In what ways was Nordstrom able to understand customer shopping behaviors?", label:"Ch. 6 Closing Company Case, task 4: Nordstrom realized a connection between online shopping and in-store shopping", canonical_key:"ch_6_closing_company_case_task_4_nordstrom_reali", status:"approved"}}, {concept_id:"0fe1c3d1-585d-5fac-a299-d260e0f82b43", kc_id:"0fe1c3d1-585d-5fac-a299-d260e0f82b43", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 7, Applied Marketing Knowledge: Discussion Questions, task 1. Learner task: Why do most global organizations envision the world as a huge market without borders?", label:"Ch. 7 Discussion Questions, task 1: Why do most global organizations envision the world as a huge market without borders", canonical_key:"ch_7_discussion_questions_task_1_why_do_most_glo", status:"approved"}}, {concept_id:"a45fd6eb-aab4-5fd7-99aa-f183ad31552b", kc_id:"a45fd6eb-aab4-5fd7-99aa-f183ad31552b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 7, Applied Marketing Knowledge: Discussion Questions, task 2. Learner task: Describe the differences between exporting products, forming joint ventures, and licensing products.", label:"Ch. 7 Discussion Questions, task 2: Describe the differences between exporting products, forming joint ventures, and…", canonical_key:"ch_7_discussion_questions_task_2_describe_the_di", status:"approved"}}, {concept_id:"b4728451-ee23-57cd-9a9d-646e028d72f1", kc_id:"b4728451-ee23-57cd-9a9d-646e028d72f1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 7, Applied Marketing Knowledge: Discussion Questions, task 3. Learner task: What factors do companies consider when determining a foreign country’s market attractiveness?", label:"Ch. 7 Discussion Questions, task 3: What factors do companies consider when determining a foreign country’s market…", canonical_key:"ch_7_discussion_questions_task_3_what_factors_do", status:"approved"}}, {concept_id:"27317a4b-bfe3-5504-87b6-39649164a3c2", kc_id:"27317a4b-bfe3-5504-87b6-39649164a3c2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 7, Applied Marketing Knowledge: Discussion Questions, task 4. Learner task: Adding value to the delivery network is tricky and complex for international sellers. With whom do these sellers usually partner to move products seamlessly through distribution channels?", label:"Ch. 7 Discussion Questions, task 4: Adding value to the delivery network is tricky and complex for international sellers", canonical_key:"ch_7_discussion_questions_task_4_adding_value_to", status:"approved"}}] AS row
