UNWIND [{concept_id:"8b7926ca-a392-5656-bfcd-8fbae9fe8b8b", kc_id:"8b7926ca-a392-5656-bfcd-8fbae9fe8b8b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain impressions: quantifying how many times an advertisement appears in a medium Source: chapter 14 Key Terms, printed page 498; related section 14.3.", label:"Explain impressions", canonical_key:"explain_impressions", status:"approved"}}, {concept_id:"b41af69c-e1d7-5a43-a301-6b463721c02e", kc_id:"b41af69c-e1d7-5a43-a301-6b463721c02e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain informative advertising: a type of advertising intended to raise awareness of a product through educational communication to increase demand of the product Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain informative advertising", canonical_key:"explain_informative_advertising", status:"approved"}}, {concept_id:"7fe5625b-de57-57d7-bd50-837f19c23461", kc_id:"7fe5625b-de57-57d7-bd50-837f19c23461", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply inquiry test: a type of advertising posttest that runs two or more similar ads on a limited scale and determines which of the ads are most recalled by and effective for respondents Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply inquiry test", canonical_key:"apply_inquiry_test", status:"approved"}}, {concept_id:"098a1d8d-08a5-5452-b17b-43e642ef8659", kc_id:"098a1d8d-08a5-5452-b17b-43e642ef8659", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain institutional advertisements: advertisements intended to create a positive image or support for an entire organization Source: chapter 14 Key Terms, printed page 498; related section 14.1.", label:"Explain institutional advertisements", canonical_key:"explain_institutional_advertisements", status:"approved"}}, {concept_id:"dd74f55c-a773-5ca7-b756-67e6c6d337df", kc_id:"dd74f55c-a773-5ca7-b756-67e6c6d337df", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply jury tests: a form of pretesting in which the respondents discuss the advertisements that are most likely to induce a purchase Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply jury tests", canonical_key:"apply_jury_tests", status:"approved"}}, {concept_id:"08255636-689f-5bc6-8c8f-465388ab73c6", kc_id:"08255636-689f-5bc6-8c8f-465388ab73c6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain key performance indicators (KPIs): indicators (metrics) that measure how an advertising campaign is achieving certain goals or objectives Source: chapter 14 Key Terms, printed page 498; related section 14.3.", label:"Explain key performance indicators (KPIs)", canonical_key:"explain_key_performance_indicators_kpis", status:"approved"}}, {concept_id:"4c270b1b-6c3c-5ca6-b413-c8560216f980", kc_id:"4c270b1b-6c3c-5ca6-b413-c8560216f980", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain lobbying: networking and other efforts that have the intention of influencing public policy and law Source: chapter 14 Key Terms, printed page 498; related section 14.4.", label:"Explain lobbying", canonical_key:"explain_lobbying", status:"approved"}}, {concept_id:"99d6dee3-f2bd-5129-a9dd-ed54e2123621", kc_id:"99d6dee3-f2bd-5129-a9dd-ed54e2123621", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain objective-and-task approach: advertising budget strategy that is based on the objectives set previously for the advertising plan Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain objective-and-task approach", canonical_key:"explain_objective_and_task_approach", status:"approved"}}, {concept_id:"98c9fa7c-5927-5be3-870b-e2bf65398cef", kc_id:"98c9fa7c-5927-5be3-870b-e2bf65398cef", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain percentage-of-sales approach: advertising budget strategy that utilizes prior years’ sales or predicted year’s sales and sets a percentage of those sales aside for advertising Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain percentage-of-sales approach", canonical_key:"explain_percentage_of_sales_approach", status:"approved"}}, {concept_id:"f1a76bdc-fc1a-51b3-8f2e-8300c79f3300", kc_id:"f1a76bdc-fc1a-51b3-8f2e-8300c79f3300", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain persuasive advertising: a type of advertising that aims to highlight the benefits of a product or service being advertised Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain persuasive advertising", canonical_key:"explain_persuasive_advertising", status:"approved"}}, {concept_id:"90e171bd-8e35-533a-907f-acc56f668b20", kc_id:"90e171bd-8e35-533a-907f-acc56f668b20", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply portfolio tests: a type of advertising pretest that consists of respondents browsing through various versions of an advertisement and then being asked to recall certain details from each Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply portfolio tests", canonical_key:"apply_portfolio_tests", status:"approved"}}, {concept_id:"4b980652-295e-598c-87e3-0de0bc4e614a", kc_id:"4b980652-295e-598c-87e3-0de0bc4e614a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain press relations: efforts to establish and maintain positive relationships with those in the media by sending press releases and other stories that help to maintain a positive image of the brand Source: chapter 14 Key Terms, printed page 498; related section 14.4.", label:"Explain press relations", canonical_key:"explain_press_relations", status:"approved"}}, {concept_id:"44d5847b-71c3-54b4-b866-c89e54c58aee", kc_id:"44d5847b-71c3-54b4-b866-c89e54c58aee", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply pretesting advertising: research that predicts the performance of an advertisement before it airs Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply pretesting advertising", canonical_key:"apply_pretesting_advertising", status:"approved"}}, {concept_id:"d56da37d-582b-5883-91a6-aaef93669495", kc_id:"d56da37d-582b-5883-91a6-aaef93669495", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product advertisements: advertisements that promote a specific product within the organization’s product mix Source: chapter 14 Key Terms, printed page 498; related section 14.1.", label:"Explain product advertisements", canonical_key:"explain_product_advertisements", status:"approved"}}, {concept_id:"dc110e76-3908-566f-9925-d25db9e54d5b", kc_id:"dc110e76-3908-566f-9925-d25db9e54d5b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain public affairs: efforts to influence public policy and engage with public officials and trade associations Source: chapter 14 Key Terms, printed page 498; related section 14.4.", label:"Explain public affairs", canonical_key:"explain_public_affairs", status:"approved"}}, {concept_id:"89c6d1b8-02f3-5ac6-aec1-7677b77d9abe", kc_id:"89c6d1b8-02f3-5ac6-aec1-7677b77d9abe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost. Source: chapter 14 Key Terms, printed page 498; related section 14.4.", label:"Explain public relations", canonical_key:"explain_public_relations", status:"approved"}}, {concept_id:"8fa52922-3826-55d0-8371-24aebf09fadc", kc_id:"8fa52922-3826-55d0-8371-24aebf09fadc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain publicity: notice or attention given by the media Source: chapter 14 Key Terms, printed page 498; related section 14.4.", label:"Explain publicity", canonical_key:"explain_publicity", status:"approved"}}, {concept_id:"ed03a1d6-de19-5d78-ab29-0f09a1b8a025", kc_id:"ed03a1d6-de19-5d78-ab29-0f09a1b8a025", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply pull strategy: advertising strategy intended to bring audiences to the product Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply pull strategy", canonical_key:"apply_pull_strategy", status:"approved"}}, {concept_id:"260e5a3a-ba93-5185-995f-22c13c886bb5", kc_id:"260e5a3a-ba93-5185-995f-22c13c886bb5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply push strategy: advertising strategy aimed at pushing the brand in front of an audience Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply push strategy", canonical_key:"apply_push_strategy", status:"approved"}}, {concept_id:"bfc46748-bc6b-506c-8646-f664db30af44", kc_id:"bfc46748-bc6b-506c-8646-f664db30af44", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain reach: the estimated number of potential customers you can reach with an advertising campaign Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain reach", canonical_key:"explain_reach", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"79b7de14-9542-5374-bad0-a97bd5af94a6", kc_id:"79b7de14-9542-5374-bad0-a97bd5af94a6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain reminder advertising: advertising aimed at bringing a product back into the forefront of the consumer’s mind Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain reminder advertising", canonical_key:"explain_reminder_advertising", status:"approved"}}, {concept_id:"8ee8fc06-6f14-5bfa-a50b-bc0a95dab139", kc_id:"8ee8fc06-6f14-5bfa-a50b-bc0a95dab139", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain return on ad spend (ROAS): metric that measures the amount of revenue earned for every dollar spent on advertising Source: chapter 14 Key Terms, printed page 498; related section 14.3.", label:"Explain return on ad spend (ROAS)", canonical_key:"explain_return_on_ad_spend_roas", status:"approved"}}, {concept_id:"ea887c4c-ae98-587b-9cef-7eb7fda4d1ac", kc_id:"ea887c4c-ae98-587b-9cef-7eb7fda4d1ac", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain return-on-investment (ROI) approach: advertising budget strategy that focuses on every dollar spent on advertising; a return of that dollar—plus some—is expected Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain return-on-investment (ROI) approach", canonical_key:"explain_return_on_investment_roi_approach", status:"approved"}}, {concept_id:"c70e30cc-ca42-59d9-809a-cd0cf68091b5", kc_id:"c70e30cc-ca42-59d9-809a-cd0cf68091b5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply sales test: a type of posttest in advertising that determines how many sales will be made based on a test market Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply sales test", canonical_key:"apply_sales_test", status:"approved"}}, {concept_id:"927c6642-ed94-5917-ac05-f6bcb4bc081e", kc_id:"927c6642-ed94-5917-ac05-f6bcb4bc081e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply theater tests: a form of advertising pretest in which the audience is shown advertisements—usually television ads—in the context that they would be shown to the entire market Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Apply theater tests", canonical_key:"apply_theater_tests", status:"approved"}}, {concept_id:"5614b2d7-7feb-5fb6-a83e-c43fa3edce90", kc_id:"5614b2d7-7feb-5fb6-a83e-c43fa3edce90", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain unaided recall: a type of advertising posttest that does not use any cues or prompts to test the recollection of the advertisement message Source: chapter 14 Key Terms, printed page 498; related section 14.2.", label:"Explain unaided recall", canonical_key:"explain_unaided_recall", status:"approved"}}, {concept_id:"fe999bb3-c829-52eb-ba74-70bb9f588bb1", kc_id:"fe999bb3-c829-52eb-ba74-70bb9f588bb1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain adaptive selling: an approach to personal selling in which selling behaviors are altered during the sales interaction or across customer interactions, based on information about the nature of the selling situation Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain adaptive selling", canonical_key:"explain_adaptive_selling", status:"approved"}}, {concept_id:"984387f9-4456-5ef9-aaf3-c846a491a4e3", kc_id:"984387f9-4456-5ef9-aaf3-c846a491a4e3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply AIDA model: the model consumers go through when becoming interested in a product. First the product must grab their attention, then they gain interest, they have a desire for the product, and they act to acquire the product Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Apply AIDA model", canonical_key:"apply_aida_model", status:"approved"}}, {concept_id:"ca72cf0a-22f6-555c-9bd8-76fd547bcf02", kc_id:"ca72cf0a-22f6-555c-9bd8-76fd547bcf02", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain ambiguous terms and conditions: when a contract is unclear and misleading Source: chapter 15 Key Terms, printed page 533; related section 15.7.", label:"Explain ambiguous terms and conditions", canonical_key:"explain_ambiguous_terms_and_conditions", status:"approved"}}, {concept_id:"33318848-f047-5766-bbd6-4e0bc0144da7", kc_id:"33318848-f047-5766-bbd6-4e0bc0144da7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain approach: the stage of the sales process where the salesperson makes the initial approach to introduce the product to the customer Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain approach", canonical_key:"explain_approach", status:"approved"}}, {concept_id:"0230e390-c0a0-5ad7-92af-9d02f273e2db", kc_id:"0230e390-c0a0-5ad7-92af-9d02f273e2db", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain commission: the compensation paid to salespeople based on a fixed formula related to the salesperson’s activity or performance Source: chapter 15 Key Terms, printed page 533; related section 15.4.", label:"Explain commission", canonical_key:"explain_commission", status:"approved"}}, {concept_id:"d284922a-1e96-5148-baab-795238730809", kc_id:"d284922a-1e96-5148-baab-795238730809", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain consultative selling: focuses on the expertise of a salesperson with problem solving Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain consultative selling", canonical_key:"explain_consultative_selling", status:"approved"}}, {concept_id:"1a42441b-6075-5708-b1fe-38903d081ff4", kc_id:"1a42441b-6075-5708-b1fe-38903d081ff4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain contest: a marketing or consumer sales promotion technique that involves collection, matching, or use of skill to complete a project or activity with the goal of a prize or reward for the player Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain contest", canonical_key:"explain_contest", status:"approved"}}, {concept_id:"6b1ef92a-ef44-506c-b123-4b35a7fb1d71", kc_id:"6b1ef92a-ef44-506c-b123-4b35a7fb1d71", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain cooperative advertising: an approach to paying for local advertising or retail advertising whereby the details are handled by a local retail store but is partly or fully paid for by a national manufacturer whose product is featured in the ad Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain cooperative advertising", canonical_key:"explain_cooperative_advertising", status:"approved"}}, {concept_id:"b70ed5c5-f4f4-51ce-9a9e-ad4ed3b0b39a", kc_id:"b70ed5c5-f4f4-51ce-9a9e-ad4ed3b0b39a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain coupon: a printed certificate entitling the bearer to a stated price reduction or special value on a specific product Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain coupon", canonical_key:"explain_coupon", status:"approved"}}, {concept_id:"54c5894d-3335-5901-8521-24db52936c6e", kc_id:"54c5894d-3335-5901-8521-24db52936c6e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain credit terms: credit terms of the agreement between the buyer and seller with length of time and payments to be made Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain credit terms", canonical_key:"explain_credit_terms", status:"approved"}}, {concept_id:"151bf51b-2cc6-50d3-b718-0f2e811e8551", kc_id:"151bf51b-2cc6-50d3-b718-0f2e811e8551", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain customer relationship management: the process sales personnel undertake to work with the customer to build the relationship and move into the role of a trusted advisor Source: chapter 15 Key Terms, printed page 533; related section 15.4.", label:"Explain customer relationship management", canonical_key:"explain_customer_relationship_management", status:"approved"}}, {concept_id:"343292d6-0a95-5716-916f-06636e8b310b", kc_id:"343292d6-0a95-5716-916f-06636e8b310b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply formula selling: an approach in which the sales presentation is designed to move the customer through the stages in the decision-making process, such as get the customer’s attention, develop interest, build desire, and secure action Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Apply formula selling", canonical_key:"apply_formula_selling", status:"approved"}}, {concept_id:"f2c75ed4-6592-5ae3-a51b-b0133327e7cd", kc_id:"f2c75ed4-6592-5ae3-a51b-b0133327e7cd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Evaluate hidden fees: also called undisclosed fees and are fees that are not made known to the buyer Source: chapter 15 Key Terms, printed page 533; related section 15.7.", label:"Evaluate hidden fees", canonical_key:"evaluate_hidden_fees", status:"approved"}}, {concept_id:"f59aca93-0946-546d-aaa7-fd37c549d2c9", kc_id:"f59aca93-0946-546d-aaa7-fd37c549d2c9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain inside order taker: a salesclerk or order clerk that is employed for a company that address questions and complete the final sale Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain inside order taker", canonical_key:"explain_inside_order_taker", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"21d30b53-35e8-5d56-b68c-599101aff70c", kc_id:"21d30b53-35e8-5d56-b68c-599101aff70c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Evaluate kickbacks: illegal payment for preferential or improper service Source: chapter 15 Key Terms, printed page 533; related section 15.7.", label:"Evaluate kickbacks", canonical_key:"evaluate_kickbacks", status:"approved"}}, {concept_id:"a2af8ff1-c4aa-5be3-848a-afd3683c3642", kc_id:"a2af8ff1-c4aa-5be3-848a-afd3683c3642", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain lead response time: The elapsed time taken by a sales team to respond to a new lead or customer request, as explained in section 15.4. Source inconsistency: the glossary supplies an unrelated analytics definition; this node follows the substantive section. Source: chapter 15 Key Terms, printed page 533; related section 15.4.", label:"Explain lead response time", canonical_key:"explain_lead_response_time", status:"approved"}}, {concept_id:"4aace521-f47a-5e8d-a257-5e9ebf896bb5", kc_id:"4aace521-f47a-5e8d-a257-5e9ebf896bb5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze loyalty programs: a form of promotion focused on repeat purchases and frequently attached to a sales receipt, punch card, or stamp card Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Analyze loyalty programs", canonical_key:"analyze_loyalty_programs", status:"approved"}}, {concept_id:"f5c83d63-b80a-542c-9cc8-7f5612c680f4", kc_id:"f5c83d63-b80a-542c-9cc8-7f5612c680f4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain missionary salespeople: individuals who have the power to influence the customer to purchase a product or service Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain missionary salespeople", canonical_key:"explain_missionary_salespeople", status:"approved"}}, {concept_id:"f0c85765-943f-54bb-8fc1-a68bb05a6d67", kc_id:"f0c85765-943f-54bb-8fc1-a68bb05a6d67", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain need/satisfaction format: a type of customized sales presentation in which the salesperson first identifies the prospective customer’s needs and then tries to offer a solution that satisfies those needs Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain need/satisfaction format", canonical_key:"explain_need_satisfaction_format", status:"approved"}}, {concept_id:"4f3afad2-4b70-5442-b714-0fafb4de6681", kc_id:"4f3afad2-4b70-5442-b714-0fafb4de6681", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply opportunity win rate: the number of sales closed divided by the total number of opportunities created; calculates another opportunity to track sales Source: chapter 15 Key Terms, printed page 533; related section 15.4.", label:"Apply opportunity win rate", canonical_key:"apply_opportunity_win_rate", status:"approved"}}, {concept_id:"40713e9c-3e13-5e4f-93b1-6752c4c79c47", kc_id:"40713e9c-3e13-5e4f-93b1-6752c4c79c47", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain order getters: highly trained salespeople who know their products, services involved, and competition across the street Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain order getters", canonical_key:"explain_order_getters", status:"approved"}}, {concept_id:"3a4c0afd-5916-598f-9758-33776abc8018", kc_id:"3a4c0afd-5916-598f-9758-33776abc8018", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain order takers: sales personnel that are responsible for taking orders from customers by identifying the customer and finding the right product fit Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain order takers", canonical_key:"explain_order_takers", status:"approved"}}, {concept_id:"2c79559c-cc5c-55dd-bc0a-9ce47df9c7d9", kc_id:"2c79559c-cc5c-55dd-bc0a-9ce47df9c7d9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain outside order takers: salespeople out in the trenches, visiting customers and delivering inventory to retailers and wholesalers Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain outside order takers", canonical_key:"explain_outside_order_takers", status:"approved"}}, {concept_id:"84ca04e2-a912-5854-b5e3-568260c4642b", kc_id:"84ca04e2-a912-5854-b5e3-568260c4642b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain personal selling: communication between a buyer and seller. The primary responsibility is to build a relationship with the buyer. Source: chapter 15 Key Terms, printed page 533; related section 15.1.", label:"Explain personal selling", canonical_key:"explain_personal_selling", status:"approved"}}, {concept_id:"068e9b23-79f0-5681-80d8-e77ae9b46c55", kc_id:"068e9b23-79f0-5681-80d8-e77ae9b46c55", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain point-of-purchase displays: displays that allow manufacturers to showcase their products in a way that stands out from all the other products in the store Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain point-of-purchase displays", canonical_key:"explain_point_of_purchase_displays", status:"approved"}}, {concept_id:"452d84a3-95b4-5819-b858-133422d051ae", kc_id:"452d84a3-95b4-5819-b858-133422d051ae", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain pre-approach stage: the stage of the sales process where the salesperson will work to understand the needs of the customer and begin working with them to become a customer Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain pre-approach stage", canonical_key:"explain_pre_approach_stage", status:"approved"}}, {concept_id:"931f856c-d942-5d4b-8083-d3428f5e3eb2", kc_id:"931f856c-d942-5d4b-8083-d3428f5e3eb2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain premiums: a promotional tool that is often defined in three forms: merchandise offered at a lower price or free; an item of value, other than the product; souvenir merchandise Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain premiums", canonical_key:"explain_premiums", status:"approved"}}, {concept_id:"6b5e938d-905d-5cc8-95f0-e5755426699e", kc_id:"6b5e938d-905d-5cc8-95f0-e5755426699e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain presentation: the stage of the sales process where the salesperson showcases the features about a product that will be of most benefit to the prospect based on the needs uncovered during the pre-approach and approach stages Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain presentation", canonical_key:"explain_presentation", status:"approved"}}, {concept_id:"6dbd7e89-32f4-5312-9162-f4aebf21e34e", kc_id:"6dbd7e89-32f4-5312-9162-f4aebf21e34e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain prospect: a potential qualified customer who has the willingness, financial capacity, authority, and eligibility to buy the salesperson’s offering Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain prospect", canonical_key:"explain_prospect", status:"approved"}}, {concept_id:"890f6491-fc1f-5b4e-a949-01c3851f60f0", kc_id:"890f6491-fc1f-5b4e-a949-01c3851f60f0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain qualification: the process the salesperson undertakes to make sure the sales lead is a good fit for the product they are selling Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain qualification", canonical_key:"explain_qualification", status:"approved"}}, {concept_id:"0efc73d9-5524-5005-8d92-e344107c765d", kc_id:"0efc73d9-5524-5005-8d92-e344107c765d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain quantitative assessments: numbers driven and based on inputs and outputs of the sales cycle Source: chapter 15 Key Terms, printed page 533; related section 15.4.", label:"Explain quantitative assessments", canonical_key:"explain_quantitative_assessments", status:"approved"}}, {concept_id:"dd10fd6c-0774-5633-b5c5-0e09804c5b73", kc_id:"dd10fd6c-0774-5633-b5c5-0e09804c5b73", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain rebates: a form of promotion that rewards consumers for sending information to the company Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain rebates", canonical_key:"explain_rebates", status:"approved"}}, {concept_id:"1438c790-0ec5-5526-9c2d-f0d741c8e0a0", kc_id:"1438c790-0ec5-5526-9c2d-f0d741c8e0a0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain relationship selling: a method of personal selling used to better understand the needs and wants of the buyer Source: chapter 15 Key Terms, printed page 533; related section 15.1.", label:"Explain relationship selling", canonical_key:"explain_relationship_selling", status:"approved"}}, {concept_id:"0a17e8d3-2ad5-553b-9b64-e981b4691871", kc_id:"0a17e8d3-2ad5-553b-9b64-e981b4691871", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sales force automation: a software tool that helps organizations acquire customers Source: chapter 15 Key Terms, printed page 533; related section 15.4.", label:"Explain sales force automation", canonical_key:"explain_sales_force_automation", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"a0ef9388-6128-5d2c-9b91-9eb9687b8da9", kc_id:"a0ef9388-6128-5d2c-9b91-9eb9687b8da9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sales leads: a database of potential customers that sales professionals work to create and develop through lead generation Source: chapter 15 Key Terms, printed page 533; related section 15.4.", label:"Explain sales leads", canonical_key:"explain_sales_leads", status:"approved"}}, {concept_id:"903f5048-3c3a-57b3-8dbb-98806b9d5c17", kc_id:"903f5048-3c3a-57b3-8dbb-98806b9d5c17", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain sales promotion: a short-term way of enticing the consumer to purchase a product or service Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain sales promotion", canonical_key:"explain_sales_promotion", status:"approved"}}, {concept_id:"67cddb08-bd9e-5ddd-bda0-e4ca69f0bffd", kc_id:"67cddb08-bd9e-5ddd-bda0-e4ca69f0bffd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain samples: providing consumers with a free sample of a product is a form of promotion Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain samples", canonical_key:"explain_samples", status:"approved"}}, {concept_id:"c021d825-17ed-5f21-81fb-880d6a086966", kc_id:"c021d825-17ed-5f21-81fb-880d6a086966", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain selling process: includes all of the steps the salesperson will implement as they work with the buyer to become a customer Source: chapter 15 Key Terms, printed page 533; related section 15.3.", label:"Explain selling process", canonical_key:"explain_selling_process", status:"approved"}}, {concept_id:"04aa3d30-4d9f-500d-89c6-878eafdfeffe", kc_id:"04aa3d30-4d9f-500d-89c6-878eafdfeffe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain support personnel: fulfill the responsibilities that assist the sales team in supporting the customer and completing the sale Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain support personnel", canonical_key:"explain_support_personnel", status:"approved"}}, {concept_id:"cc12133e-ded7-5668-9cd1-2ca1898cec08", kc_id:"cc12133e-ded7-5668-9cd1-2ca1898cec08", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sweepstakes: a marketing or consumer sales promotion that involves the offering of prizes to participants, where winners are selected by chance and no consideration is required Source: chapter 15 Key Terms, printed page 533; related section 15.6.", label:"Explain sweepstakes", canonical_key:"explain_sweepstakes", status:"approved"}}, {concept_id:"ac3bb977-1c14-5b13-bbb5-33fa94dfc6f7", kc_id:"ac3bb977-1c14-5b13-bbb5-33fa94dfc6f7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain team selling: the practice of involving a group of people familiar with the viewpoints and concerns of a customer’s key decision makers to sell and service a major account Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain team selling", canonical_key:"explain_team_selling", status:"approved"}}, {concept_id:"88cdbf4f-68a8-5ac4-9f0a-5e20fbf11fdd", kc_id:"88cdbf4f-68a8-5ac4-9f0a-5e20fbf11fdd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain technical specialist: a salesperson who has extensive product knowledge and uses this knowledge as the focal aspect of the sales presentation Source: chapter 15 Key Terms, printed page 533; related section 15.2.", label:"Explain technical specialist", canonical_key:"explain_technical_specialist", status:"approved"}}, {concept_id:"989e4888-80ed-585b-bb21-7e807b4cbf91", kc_id:"989e4888-80ed-585b-bb21-7e807b4cbf91", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain affiliates: people or companies that earn a commission for driving traffic to another person’s or company’s website where they make a purchase Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain affiliates", canonical_key:"explain_affiliates", status:"approved"}}, {concept_id:"f3f33a3e-63b4-5f02-9eb2-934789c056df", kc_id:"f3f33a3e-63b4-5f02-9eb2-934789c056df", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain blog: an online journal of interests, beliefs, and other topics published by a person, a group of people, or an organization Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain blog", canonical_key:"explain_blog", status:"approved"}}, {concept_id:"0fe332fa-9f7c-5f59-9caf-c00023b3d417", kc_id:"0fe332fa-9f7c-5f59-9caf-c00023b3d417", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply bounce rate: a metric that online marketers use to measure what percentage of visitors who visit the site, view one page, and then leave Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Apply bounce rate", canonical_key:"apply_bounce_rate", status:"approved"}}, {concept_id:"6fd65bb0-02ad-5b79-91c5-d73c29513ff7", kc_id:"6fd65bb0-02ad-5b79-91c5-d73c29513ff7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain call center: a centralized space where agents or representatives answer inbound calls and place outbound calls Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain call center", canonical_key:"explain_call_center", status:"approved"}}, {concept_id:"a1b571c8-ef14-52c7-a382-ef3754e175d6", kc_id:"a1b571c8-ef14-52c7-a382-ef3754e175d6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain catalog marketing: also known as direct mail order and is one of the oldest forms of promotion, which typically includes a variety of products often vividly displayed in a high-gloss magazine-like format Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain catalog marketing", canonical_key:"explain_catalog_marketing", status:"approved"}}, {concept_id:"71f8f395-3848-5e3d-9355-ba2a4a54290f", kc_id:"71f8f395-3848-5e3d-9355-ba2a4a54290f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply click-through rate (CTR): the percentage of people who click on an online ad Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Apply click-through rate (CTR)", canonical_key:"apply_click_through_rate_ctr", status:"approved"}}, {concept_id:"58c5f936-d2d0-5589-aebf-b64c6d564399", kc_id:"58c5f936-d2d0-5589-aebf-b64c6d564399", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain client reviews: involve feedback that a customer or client posts directly to a platform that can accessed by consumers during the buying process Source: chapter 16 Key Terms, printed page 569; related section 16.4.", label:"Explain client reviews", canonical_key:"explain_client_reviews", status:"approved"}}, {concept_id:"c50a0fef-ff98-5d3e-92e4-b0967a648b60", kc_id:"c50a0fef-ff98-5d3e-92e4-b0967a648b60", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain content marketing: creating and distributing online content that is valuable and relevant to a company’s target customers Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain content marketing", canonical_key:"explain_content_marketing", status:"approved"}}, {concept_id:"eb4f3eac-a702-54f7-a81d-8e64825645ea", kc_id:"eb4f3eac-a702-54f7-a81d-8e64825645ea", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain conversions: happen when a company turns a visitor into a customer Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain conversions", canonical_key:"explain_conversions", status:"approved"}}, {concept_id:"14ec6a88-03a2-5a7f-9e49-3f12e10d5ea7", kc_id:"14ec6a88-03a2-5a7f-9e49-3f12e10d5ea7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply cost per acquisition (CPA): also known as cost per action or cost per conversion, relates to the aggregate or cumulative cost of acquiring a customer and can be measured by channel or campaign Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Apply cost per acquisition (CPA)", canonical_key:"apply_cost_per_acquisition_cpa", status:"approved"}}, {concept_id:"a806da2d-a3ba-5e3f-ad27-21521f450872", kc_id:"a806da2d-a3ba-5e3f-ad27-21521f450872", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply cost per click (CPC): the cost companies pay search engines for each click that a search advertisement receives, which is based on the keywords a company bids on Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Apply cost per click (CPC)", canonical_key:"apply_cost_per_click_cpc", status:"approved"}}, {concept_id:"23ef84c5-329d-573e-84fa-da2afef2cf80", kc_id:"23ef84c5-329d-573e-84fa-da2afef2cf80", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain direct marketing: using communication tools that directly engage with individual consumers for the ultimate purpose of calling them to take some marketing action Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain direct marketing", canonical_key:"explain_direct_marketing", status:"approved"}}] AS row
