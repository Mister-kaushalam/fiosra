UNWIND [{concept_id:"01cc6a2f-1fd2-5284-82b6-8f822c50b0a1", kc_id:"01cc6a2f-1fd2-5284-82b6-8f822c50b0a1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain convenience products: products that consumers can purchase easily, quickly, and without a lot of thoughtful decision-making Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain convenience products", canonical_key:"explain_convenience_products", status:"approved"}}, {concept_id:"0b64f3cc-3226-53a6-a2a6-6d6432659f3a", kc_id:"0b64f3cc-3226-53a6-a2a6-6d6432659f3a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain core product: product solution that the customer is actually buying: convenience, ego, ease, flexibility, etc. Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain core product", canonical_key:"explain_core_product", status:"approved"}}, {concept_id:"4da3b2ad-01d6-534a-ac6a-90757267d524", kc_id:"4da3b2ad-01d6-534a-ac6a-90757267d524", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze cost of goods sold: expenses directly attributable to the product or service Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Analyze cost of goods sold", canonical_key:"analyze_cost_of_goods_sold", status:"approved"}}, {concept_id:"52112a5d-5600-5e86-8372-6e84d65de281", kc_id:"52112a5d-5600-5e86-8372-6e84d65de281", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain cradle-to-cradle packaging design: product design that eliminates waste from the life cycle of package Source: chapter 9 Key Terms, printed page 337; related section 9.8.", label:"Explain cradle-to-cradle packaging design", canonical_key:"explain_cradle_to_cradle_packaging_design", status:"approved"}}, {concept_id:"23b82e2a-0751-5d6b-a619-d96286a48103", kc_id:"23b82e2a-0751-5d6b-a619-d96286a48103", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain customer experience: the overarching impression that customers have of a brand Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain customer experience", canonical_key:"explain_customer_experience", status:"approved"}}, {concept_id:"2bb5f0d6-2f2f-5110-ae24-8fff4bf82cac", kc_id:"2bb5f0d6-2f2f-5110-ae24-8fff4bf82cac", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain decline stage: part of the product life cycle characterized by a significant decrease in sales and profitability Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain decline stage", canonical_key:"explain_decline_stage", status:"approved"}}, {concept_id:"ffca6ed0-3009-5c50-b278-e62c24594f2e", kc_id:"ffca6ed0-3009-5c50-b278-e62c24594f2e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain divest: to sell a brand or discontinue a product to protect a portfolio Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain divest", canonical_key:"explain_divest", status:"approved"}}, {concept_id:"5e54afb4-a591-550e-9328-7eb5ddf96656", kc_id:"5e54afb4-a591-550e-9328-7eb5ddf96656", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply gross profit margin: Revenue minus cost of goods sold, divided by revenue and expressed as a percentage. Gross profit precedes other operating expenses; it is not profit before all costs. Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Apply gross profit margin", canonical_key:"apply_gross_profit_margin", status:"approved"}}, {concept_id:"a2c22f52-e7f0-5d29-a049-bf0cdc8691bf", kc_id:"a2c22f52-e7f0-5d29-a049-bf0cdc8691bf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain growth stage: part of the product life cycle characterized by increasing sales; stage when copycat brands may enter the market Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain growth stage", canonical_key:"explain_growth_stage", status:"approved"}}, {concept_id:"e575d819-0c23-5fd1-8af9-5cd269ea6c38", kc_id:"e575d819-0c23-5fd1-8af9-5cd269ea6c38", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain hard-core loyals: tried-and-true customers who will generally only purchase one brand in a category Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain hard-core loyals", canonical_key:"explain_hard_core_loyals", status:"approved"}}, {concept_id:"1fca48e8-0b29-5135-ba2e-39d0e322e479", kc_id:"1fca48e8-0b29-5135-ba2e-39d0e322e479", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain harvest: to reduce all unnecessary expenses to retain any remaining revenue Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain harvest", canonical_key:"explain_harvest", status:"approved"}}, {concept_id:"75ea2e8d-d5c5-54ad-ae36-0e36252e7ab2", kc_id:"75ea2e8d-d5c5-54ad-ae36-0e36252e7ab2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain introduction stage: part of the product life cycle when consumer awareness is building and sales are starting to grow Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain introduction stage", canonical_key:"explain_introduction_stage", status:"approved"}}, {concept_id:"0ac8a4bb-3631-5207-87c4-d0b88609612f", kc_id:"0ac8a4bb-3631-5207-87c4-d0b88609612f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain licensed brands: brands that provide the likeness of their brand as a fee for use Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain licensed brands", canonical_key:"explain_licensed_brands", status:"approved"}}, {concept_id:"2b442559-94d2-59d0-bf1d-7af763abe67f", kc_id:"2b442559-94d2-59d0-bf1d-7af763abe67f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain line extensions: products that create new opportunities for an existing product and brand Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain line extensions", canonical_key:"explain_line_extensions", status:"approved"}}, {concept_id:"87c4bc3e-b986-54e0-9763-98672c672955", kc_id:"87c4bc3e-b986-54e0-9763-98672c672955", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain manufactured materials and parts: products used to create a product Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain manufactured materials and parts", canonical_key:"explain_manufactured_materials_and_parts", status:"approved"}}, {concept_id:"25c7ccc4-c587-5c97-a4ff-09cdf5990818", kc_id:"25c7ccc4-c587-5c97-a4ff-09cdf5990818", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain market modification: an extension of a product to new customers Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain market modification", canonical_key:"explain_market_modification", status:"approved"}}, {concept_id:"e40bcb39-b12f-5855-bec4-2184d9463907", kc_id:"e40bcb39-b12f-5855-bec4-2184d9463907", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain maturity stage: part of the product life cycle when sales growth slows and profitability levels off Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain maturity stage", canonical_key:"explain_maturity_stage", status:"approved"}}, {concept_id:"47b5f693-2009-50e8-ba71-b77f9b7a7813", kc_id:"47b5f693-2009-50e8-ba71-b77f9b7a7813", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain multibrands: new brand names within a company’s existing product category Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain multibrands", canonical_key:"explain_multibrands", status:"approved"}}, {concept_id:"fe6e9880-3e2c-53d6-a566-ab779e1a9aed", kc_id:"fe6e9880-3e2c-53d6-a566-ab779e1a9aed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain national brands: name brands that sell a product or service under its corporate name and identity Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain national brands", canonical_key:"explain_national_brands", status:"approved"}}, {concept_id:"4b2adbfd-bc14-5137-8237-d1934de32245", kc_id:"4b2adbfd-bc14-5137-8237-d1934de32245", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply net profit margin: Net profit after relevant expenses divided by revenue, expressed as a percentage; distinguish this from gross profit margin, which subtracts cost of goods sold before other expenses. Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Apply net profit margin", canonical_key:"apply_net_profit_margin", status:"approved"}}] AS row
