UNWIND [{concept_id:"2d216c6b-1059-5b8c-8a2b-2fdf103049d6", kc_id:"2d216c6b-1059-5b8c-8a2b-2fdf103049d6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Compare visible artifacts and symbols with underlying values, beliefs, meanings, and behavioral norms. Source: section 8.3, printed page 271.", label:"Distinguish tangible and intangible culture", canonical_key:"distinguish_tangible_and_intangible_culture", status:"approved"}}, {concept_id:"52c88ec3-17c9-5671-8ffe-2ac0830e9d04", kc_id:"52c88ec3-17c9-5671-8ffe-2ac0830e9d04", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Use Hofstede's dimension to discuss relative emphasis on individual and group relationships without assigning fixed traits to every member. Source: section 8.3, printed page 271.", label:"Analyze individualism and collectivism", canonical_key:"analyze_individualism_and_collectivism", status:"approved"}}, {concept_id:"eeab1793-45ba-5b1d-9eb6-c8eb86d3972d", kc_id:"eeab1793-45ba-5b1d-9eb6-c8eb86d3972d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Use the dimension to examine expectations about unequal power and authority while recognizing within-group variation. Source: section 8.3, printed page 271.", label:"Analyze power distance", canonical_key:"analyze_power_distance", status:"approved"}}, {concept_id:"85840bee-132e-58e2-88d4-7362612f107b", kc_id:"85840bee-132e-58e2-88d4-7362612f107b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Examine cultural responses to ambiguity and uncertainty without equating a group tendency with an immutable individual trait. Source: section 8.3, printed page 271.", label:"Analyze uncertainty avoidance", canonical_key:"analyze_uncertainty_avoidance", status:"approved"}}, {concept_id:"9edb7abe-c718-51a9-b0a6-2c4abb999359", kc_id:"9edb7abe-c718-51a9-b0a6-2c4abb999359", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Explain the framework's terminology for achievement-competition versus care-quality-of-life orientations without treating it as biological sex or individual gender identity. Source: section 8.3, printed page 271.", label:"Interpret masculinity and femininity in Hofstede's framework", canonical_key:"interpret_masculinity_and_femininity_in_hofstede", status:"approved"}}, {concept_id:"9ef7c90b-fb16-598a-8a14-2ee814a5849a", kc_id:"9ef7c90b-fb16-598a-8a14-2ee814a5849a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze how time horizons and traditions may affect value propositions and planning without assuming uniform behavior. Source: section 8.3, printed page 271.", label:"Compare long-term and short-term orientation", canonical_key:"compare_long_term_and_short_term_orientation", status:"approved"}}, {concept_id:"7e370d8c-d0f9-59db-a692-2e401c99eff7", kc_id:"7e370d8c-d0f9-59db-a692-2e401c99eff7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Interpret cultural regulation of gratification without treating national scores as complete predictions of individual demand. Source: section 8.3, printed page 271.", label:"Compare indulgence and restraint", canonical_key:"compare_indulgence_and_restraint", status:"approved"}}, {concept_id:"bf037a85-50ab-5ec8-b0c2-4558f1bc5fbd", kc_id:"bf037a85-50ab-5ec8-b0c2-4558f1bc5fbd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Recognize variations in cultural connection, language, and identity across and within Hispanic, Black, and Asian communities. Source: section 8.4, printed page 278.", label:"Use the acculturation spectrum", canonical_key:"use_the_acculturation_spectrum", status:"approved"}}, {concept_id:"b438b477-1d21-5105-9052-198da5a7d1d2", kc_id:"b438b477-1d21-5105-9052-198da5a7d1d2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Discuss the textbook's named cohorts from the Lost Generation through Generation Alpha while separating cohort conventions, life stage, and individual variation. Source: section 8.5, printed page 287.", label:"Compare generational cohorts responsibly", canonical_key:"compare_generational_cohorts_responsibly", status:"approved"}}, {concept_id:"de0d698a-d436-524d-ab16-75456fff3f48", kc_id:"de0d698a-d436-524d-ab16-75456fff3f48", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Interpret population stagnation, older consumers' spending, and changing sociodemographics within the publication's time and geography. Source: section 8.5, printed page 287.", label:"Assess demographic trends as dated evidence", canonical_key:"assess_demographic_trends_as_dated_evidence", status:"approved"}}, {concept_id:"3dfbf058-06d9-562a-b502-071a4d3b7c3a", kc_id:"3dfbf058-06d9-562a-b502-071a4d3b7c3a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess research, representation, organizational practices, and the fit between customer values and marketing action. Source: section 8.6, printed page 294.", label:"Distinguish inclusion from token representation", canonical_key:"distinguish_inclusion_from_token_representation", status:"approved"}}, {concept_id:"d9acb117-41a0-5ab9-9169-097b5b8c6eed", kc_id:"d9acb117-41a0-5ab9-9169-097b5b8c6eed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"threshold", definition:"Explain core, actual, and augmented product levels from section 9.1's body and diagram. Flag that its learning outcome says four levels while the substantive exposition presents three. Source: section 9.1, printed page 308.", label:"Reconcile the source's product-level inconsistency", canonical_key:"reconcile_the_source_s_product_level_inconsisten", status:"approved"}}, {concept_id:"3078eab1-8c02-5b6b-ad3f-3b619ba2f86f", kc_id:"3078eab1-8c02-5b6b-ad3f-3b619ba2f86f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Use Tesla, Godiva, and Dell examples to assess range boundaries, target segments, brand perceptions, and cannibalization risks. Source: section 9.2, printed page 313.", label:"Compare upward, downward, and two-way stretching", canonical_key:"compare_upward_downward_and_two_way_stretching", status:"approved"}}, {concept_id:"b4608cee-0cac-5a83-b151-96c8be1b2cdd", kc_id:"b4608cee-0cac-5a83-b151-96c8be1b2cdd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Relate introduction, growth, maturity, and decline to pricing, promotion, market or product modification, harvesting, and divestment. Source: section 9.4, printed page 318.", label:"Select life-cycle strategies under uncertainty", canonical_key:"select_life_cycle_strategies_under_uncertainty", status:"approved"}}, {concept_id:"0f73336b-b1ae-51c9-b4b4-5b78f07fe7e7", kc_id:"0f73336b-b1ae-51c9-b4b4-5b78f07fe7e7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess protection, identification, information, differentiation, convenience, and promotional value alongside product safety. Source: section 9.7, printed page 329.", label:"Evaluate packaging and labeling functions", canonical_key:"evaluate_packaging_and_labeling_functions", status:"approved"}}, {concept_id:"f7fb766b-0ca7-5181-aafe-12f92a3fb0ed", kc_id:"f7fb766b-0ca7-5181-aafe-12f92a3fb0ed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Evaluate material reduction, reuse, recycling, and cradle-to-cradle design in relation to waste and the product life cycle. Source: section 9.8, printed page 332.", label:"Compare packaging sustainability strategies", canonical_key:"compare_packaging_sustainability_strategies", status:"approved"}}, {concept_id:"3d29dacb-8d30-5b66-bb8e-f5b07e5fcc71", kc_id:"3d29dacb-8d30-5b66-bb8e-f5b07e5fcc71", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess misleading package sizes, labels, environmental claims, and product protection from the consumer's perspective. Source: section 9.9, printed page 335.", label:"Evaluate packaging honesty and safety", canonical_key:"evaluate_packaging_honesty_and_safety", status:"approved"}}, {concept_id:"bbda6ea4-52cc-5675-8a4c-0fb719d5e66a", kc_id:"bbda6ea4-52cc-5675-8a4c-0fb719d5e66a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Distinguish repeated trial-and-purchase observation, controlled retail tests, and simulated buying environments when testing new products. Source: section 10.2, printed page 349.", label:"Compare sales-wave, controlled, and simulated test markets", canonical_key:"compare_sales_wave_controlled_and_simulated_test", status:"approved"}}, {concept_id:"42fb3c14-e8c0-525f-a5b2-3e194df38e25", kc_id:"42fb3c14-e8c0-525f-a5b2-3e194df38e25", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Measure how long new users take to recognize the offering's benefit, contrasting immediate digital delivery with delayed value realization. Source: section 10.3, printed page 353.", label:"Interpret time to value", canonical_key:"interpret_time_to_value", status:"approved"}}, {concept_id:"f2f7976f-0d19-5ce5-9193-0c00de392d77", kc_id:"f2f7976f-0d19-5ce5-9193-0c00de392d77", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Use the textbook's new-user-to-total-user formulation with an explicit period and population and distinguish it from retention and market penetration. Source: section 10.3, printed page 353.", label:"Calculate and qualify adoption rate", canonical_key:"calculate_and_qualify_adoption_rate", status:"approved"}}] AS row
