UNWIND [{concept_id:"c00916a8-49cc-5ad7-bae0-921daa795f72", kc_id:"c00916a8-49cc-5ad7-bae0-921daa795f72", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"threshold", definition:"Reproduce the source's sales-minus-marketing-cost calculation while identifying its omission of product costs, other expenses, and a causal counterfactual; avoid labeling it net business profit. Source: section 10.3, printed page 353.", label:"Audit the textbook's simplified marketing ROI", canonical_key:"audit_the_textbook_s_simplified_marketing_roi", status:"approved"}}, {concept_id:"417db177-f19d-5668-b446-b797f90873be", kc_id:"417db177-f19d-5668-b446-b797f90873be", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Consider lack of customer value, weak research, timing, competition, positioning, organizational fit, and execution rather than a single universal cause. Source: section 10.4, printed page 356.", label:"Diagnose new-product failure", canonical_key:"diagnose_new_product_failure", status:"approved"}}, {concept_id:"969d7a01-8089-5075-9acf-a4496e588f80", kc_id:"969d7a01-8089-5075-9acf-a4496e588f80", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Explain how perceived improvement over alternatives affects adoption rather than equating novelty with value. Source: section 10.5, printed page 361.", label:"Analyze relative advantage", canonical_key:"analyze_relative_advantage", status:"approved"}}, {concept_id:"9fcd2e49-2d96-5951-9b3a-cdf467d2db37", kc_id:"9fcd2e49-2d96-5951-9b3a-cdf467d2db37", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Assess the fit of a new offering with existing values, needs, habits, and practices. Source: section 10.5, printed page 361.", label:"Analyze innovation compatibility", canonical_key:"analyze_innovation_compatibility", status:"approved"}}, {concept_id:"5f6025b8-5341-5155-89e4-fed35158b698", kc_id:"5f6025b8-5341-5155-89e4-fed35158b698", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Assess how difficulty of understanding or using an offering can slow adoption and shape support needs. Source: section 10.5, printed page 361.", label:"Analyze innovation complexity", canonical_key:"analyze_innovation_complexity", status:"approved"}}, {concept_id:"883dd021-ce53-57ba-b811-7249df1d23c2", kc_id:"883dd021-ce53-57ba-b811-7249df1d23c2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Evaluate foreseeable product risks, testing, safety, and responsibilities alongside intellectual-property obligations. Source: section 10.6, printed page 364.", label:"Exercise due care in product development", canonical_key:"exercise_due_care_in_product_development", status:"approved"}}, {concept_id:"052290fc-8838-5971-aa10-a3c8981cef51", kc_id:"052290fc-8838-5971-aa10-a3c8981cef51", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Distinguish people processing, possession processing, mental stimulus processing, and information processing using tangible versus intangible actions and recipient. Source: section 11.1, printed page 376.", label:"Classify the four service-processing categories", canonical_key:"classify_the_four_service_processing_categories", status:"approved"}}, {concept_id:"cd194049-ac52-59fe-88d4-67694eebc830", kc_id:"cd194049-ac52-59fe-88d4-67694eebc830", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Separate knowledge, policy, delivery, communication, and customer gaps and select interventions at the responsible point. Source: section 11.3, printed page 390.", label:"Diagnose the five service-quality gaps", canonical_key:"diagnose_the_five_service_quality_gaps", status:"approved"}}, {concept_id:"89791b0f-01a9-5f52-94b9-91001220d957", kc_id:"89791b0f-01a9-5f52-94b9-91001220d957", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Relate honest communication, fair treatment, confidentiality, and actual service delivery to customer satisfaction and trust. Source: section 11.4, printed page 395.", label:"Evaluate service fairness and promises", canonical_key:"evaluate_service_fairness_and_promises", status:"approved"}}, {concept_id:"020a9160-c0dd-5452-b078-f036dd58f0e8", kc_id:"020a9160-c0dd-5452-b078-f036dd58f0e8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Calculate total revenue as price times quantity and profit as total revenue minus total costs, distinguishing revenue effects from margin effects. Source: section 12.1, printed page 406.", label:"Apply the profit equation", canonical_key:"apply_the_profit_equation", status:"approved"}}, {concept_id:"3a9093c0-a77f-5a82-a77f-1ebc08dc5a73", kc_id:"3a9093c0-a77f-5a82-a77f-1ebc08dc5a73", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Evaluate costs, customers, channels of distribution, competition, and compatibility in a coherent pricing decision. Source: section 12.2, printed page 411.", label:"Integrate the five critical Cs of pricing", canonical_key:"integrate_the_five_critical_cs_of_pricing", status:"approved"}}, {concept_id:"a44a0962-c290-5744-9399-6da04af21438", kc_id:"a44a0962-c290-5744-9399-6da04af21438", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Relate fixed costs to unit contribution, price minus unit variable cost, and distinguish break-even from a target profit. Source: section 12.3, printed page 415.", label:"Calculate break-even volume", canonical_key:"calculate_break_even_volume", status:"approved"}}, {concept_id:"36272571-fa68-52db-8f64-b5961ab04711", kc_id:"36272571-fa68-52db-8f64-b5961ab04711", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Compare percentage change in quantity demanded with percentage change in price and assess implications for revenue within the specified context. Source: section 12.3, printed page 415.", label:"Interpret own-price demand elasticity", canonical_key:"interpret_own_price_demand_elasticity", status:"approved"}}, {concept_id:"4abd3b3b-7d6e-55dd-83bd-adcce09aa452", kc_id:"4abd3b3b-7d6e-55dd-83bd-adcce09aa452", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Explain how available alternatives, budget pressure, and time to adjust affect price responsiveness. Source: section 12.3, printed page 415.", label:"Evaluate substitute availability, income, and time", canonical_key:"evaluate_substitute_availability_income_and_time", status:"approved"}}, {concept_id:"3a81b8c3-0cf2-5309-a58a-833c517e4062", kc_id:"3a81b8c3-0cf2-5309-a58a-833c517e4062", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Analyze a core product and the complementary supplies needed to use it, considering total customer cost and dependence. Source: section 12.5, printed page 425.", label:"Evaluate captive-product pricing", canonical_key:"evaluate_captive_product_pricing", status:"approved"}}, {concept_id:"f6d74f98-e9db-5078-8e62-6db7c8844591", kc_id:"f6d74f98-e9db-5078-8e62-6db7c8844591", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess whether promotional methods reinforce a coherent positioning while allowing channel-appropriate expression. Source: section 13.3, printed page 450.", label:"Audit cross-channel message consistency", canonical_key:"audit_cross_channel_message_consistency", status:"approved"}}, {concept_id:"54ec9d06-0b3d-58d4-933c-60735d249e55", kc_id:"54ec9d06-0b3d-58d4-933c-60735d249e55", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Trace aware, appeal, ask, act, and advocate and align communication objectives with the relevant customer state. Source: section 13.4, printed page 453.", label:"Apply the five-A customer path", canonical_key:"apply_the_five_a_customer_path", status:"approved"}}, {concept_id:"cd8b388a-48a8-59f7-8f9c-145495b350fa", kc_id:"cd8b388a-48a8-59f7-8f9c-145495b350fa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Select audience, objectives, message, budget, strategies and tactics, promotional tools, schedule, and evaluation as coordinated decisions. Source: section 13.4, printed page 453.", label:"Design an IMC plan", canonical_key:"design_an_imc_plan", status:"approved"}}, {concept_id:"48a2213d-96d4-5412-be03-cc3a4cc647d5", kc_id:"48a2213d-96d4-5412-be03-cc3a4cc647d5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Distinguish steady exposure, on-off bursts, and a continuing baseline with peaks, considering seasonality and budget. Source: section 13.4, printed page 453.", label:"Compare continuous, flighting, and pulsing schedules", canonical_key:"compare_continuous_flighting_and_pulsing_schedul", status:"approved"}}, {concept_id:"30680c29-d634-5f42-a420-3fe9d648f782", kc_id:"30680c29-d634-5f42-a420-3fe9d648f782", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Distinguish the textbook's roles for FTC, FCC, FDA, and CAN-SPAM-related requirements; treat legal descriptions as publication-era educational material. Source: section 13.5, printed page 464.", label:"Evaluate communication oversight and disclosure", canonical_key:"evaluate_communication_oversight_and_disclosure", status:"approved"}}] AS row
