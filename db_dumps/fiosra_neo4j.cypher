_concept", concept_type:"domain", definition:"Explain customs: mannerisms or behaviors that are considered characteristics within a social system Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain customs", canonical_key:"explain_customs", status:"approved"}}, {concept_id:"d9db235d-d3c3-556a-ba7b-bddbefc9431c", kc_id:"d9db235d-d3c3-556a-ba7b-bddbefc9431c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze discretionary income: the money individuals and households are left with after paying taxes and other living expenses, such as food and shelter Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Analyze discretionary income", canonical_key:"analyze_discretionary_income", status:"approved"}}, {concept_id:"2923270c-9731-5138-a944-7e22ea0c13db", kc_id:"2923270c-9731-5138-a944-7e22ea0c13db", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze disposable income: the money individuals and households are left with after paying taxes Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Analyze disposable income", canonical_key:"analyze_disposable_income", status:"approved"}}, {concept_id:"05ff710d-1284-5dea-a7be-7a73ed87599b", kc_id:"05ff710d-1284-5dea-a7be-7a73ed87599b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain dumping: the practice in which a company manufactures a very large of number of goods and exports them to a foreign market to see cheaply Source: chapter 7 Key Terms, printed page 250; related section 7.5.", label:"Explain dumping", canonical_key:"explain_dumping", status:"approved"}}, {concept_id:"79b663d4-ab26-59a8-9280-1d4733e8c265", kc_id:"79b663d4-ab26-59a8-9280-1d4733e8c265", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain economic infrastructure: the physical facilities of an economy that benefit product and distribution Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain economic infrastructure", canonical_key:"explain_economic_infrastructure", status:"approved"}}, {concept_id:"94347d78-9a7e-5289-9b88-400d8353354c", kc_id:"94347d78-9a7e-5289-9b88-400d8353354c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain embargoes: trading bans on a product with a specific country; imposed between countries that have different political ideologies Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain embargoes", canonical_key:"explain_embargoes", status:"approved"}}, {concept_id:"26a3709b-91f2-59ee-b7e7-6ab473cab113", kc_id:"26a3709b-91f2-59ee-b7e7-6ab473cab113", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"threshold", definition:"Analyze ethnocentrism: an assumption that the business landscape or culture of an international market is the same as the home country or personal culture Source: chapter 7 Key Terms, printed page 250; related section 7.1.", label:"Analyze ethnocentrism", canonical_key:"analyze_ethnocentrism", status:"approved"}}, {concept_id:"12850bea-ffcc-587a-9277-13a4137cc77d", kc_id:"12850bea-ffcc-587a-9277-13a4137cc77d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply exchange rate: the rate at which one country’s currency can be exchanged for that of another country Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Apply exchange rate", canonical_key:"apply_exchange_rate", status:"approved"}}, {concept_id:"f881cb5a-2fb4-5f4a-b79a-030091429d46", kc_id:"f881cb5a-2fb4-5f4a-b79a-030091429d46", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain exporting: when a firm makes a product or service in one country and sells it in others Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain exporting", canonical_key:"explain_exporting", status:"approved"}}, {concept_id:"27f01503-1aed-566b-935f-a882d277ca78", kc_id:"27f01503-1aed-566b-935f-a882d277ca78", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain foreign direct investment (FDI): the process of establishing operations within a foreign country Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain foreign direct investment (FDI)", canonical_key:"explain_foreign_direct_investment_fdi", status:"approved"}}] AS row
