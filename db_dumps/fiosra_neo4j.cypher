ype:"domain", definition:"Explain supplies and services: goods and services that are typically disposed of and do not contain a tangible value Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain supplies and services", canonical_key:"explain_supplies_and_services", status:"approved"}}, {concept_id:"f1d237b1-f6de-5c24-8d95-ef74fbb7e27a", kc_id:"f1d237b1-f6de-5c24-8d95-ef74fbb7e27a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain switchers: customers who continually change their purchasing behaviors Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain switchers", canonical_key:"explain_switchers", status:"approved"}}, {concept_id:"f4481890-7430-5f99-bf8b-0b365eaaac5b", kc_id:"f4481890-7430-5f99-bf8b-0b365eaaac5b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain trademarks (service marks): symbols that show legal ownership of a brand name or brand mark Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain trademarks (service marks)", canonical_key:"explain_trademarks_service_marks", status:"approved"}}, {concept_id:"56ebd997-47ec-5847-93e7-faa479e2659d", kc_id:"56ebd997-47ec-5847-93e7-faa479e2659d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain unsought products: consumer goods that a buyer doesn’t anticipate purchasing Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain unsought products", canonical_key:"explain_unsought_products", status:"approved"}}, {concept_id:"503e7702-2672-5415-8c6a-f6371bec091b", kc_id:"503e7702-2672-5415-8c6a-f6371bec091b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain additions to existing product lines: product line extensions that involve changes to styles or flavors Source: chapter 10 Key Terms, printed page 366; related section 10.1.", label:"Explain additions to existing product lines", canonical_key:"explain_additions_to_existing_product_lines", status:"approved"}}, {concept_id:"b0fabce4-d249-5cc3-a09b-36176dc5741c", kc_id:"b0fabce4-d249-5cc3-a09b-36176dc5741c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply business analysis: the fifth step in the new product development process, in which a potential new product is evaluated Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Apply business analysis", canonical_key:"apply_business_analysis", status:"approved"}}, {concept_id:"3a87a287-377f-581f-b25b-28c4ee3ab0a3", kc_id:"3a87a287-377f-581f-b25b-28c4ee3ab0a3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain commercialization: the eighth step in the new product development process, in which the product is launched with full-scale production, distribution, advertising, and sales promotion Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain commercialization", canonical_key:"explain_commercialization", status:"approved"}}, {concept_id:"60800f22-8f77-5d38-95da-5ae3b39bbe5f", kc_id:"60800f22-8f77-5d38-95da-5ae3b39bbe5f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain communicability: the ability to communicate to the audience the benefits of using a particular product or service Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain communicability", canonical_key:"explain_communicability", status:"approved"}}, {concept_id:"af97067a-f982-5409-897a-88bf38cc993d", kc_id:"af97067a-f982-5409-897a-88bf38cc993d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply concept development and testing: the third step in the new product development process, in which a product concept is developed into a detailed idea Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Apply concept development and testing", canonical_key:"apply_concept_development_and_testing", status:"approved"}}, {concept_id:"ef18e9f8-ffad-5963-86bf-16979642652d", kc_id:"ef18e9f8-ffad-5963-86bf-16979642652d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply concept testing: market research method in which customers are presented with a description of a product or service Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Apply concept testing", canonical_key:"apply_concept_testing", status:"approved"}}, {concept_id:"78b76c03-3c8c-55b5-bbfd-47ef4bbbe4c4", kc_id:"78b76c03-3c8c-55b5-bbfd-47ef4bbbe4c4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain consumer adoption process: stages consumers go through in adopting a new product Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain consumer adoption process", canonical_key:"explain_consumer_adoption_process", status:"approved"}}, {concept_id:"12eae43d-13e4-57ca-9bd8-f681b7d43a29", kc_id:"12eae43d-13e4-57ca-9bd8-f681b7d43a29", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain continuous innovation: category of “newness” in which the existing product undergoes only marginal changes that do not alter consumer habits Source: chapter 10 Key Terms, printed page 366; related section 10.1.", label:"Explain continuous innovation", canonical_key:"explain_continuous_innovation", status:"approved"}}, {concept_id:"3add400e-fc91-5ea6-b9bc-73a7a9d67538", kc_id:"3add400e-fc91-5ea6-b9bc-73a7a9d67538", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain copyrights: original works of authorship that include software, songs, television shows, and motion pictures Source: chapter 10 Key Terms, printed page 366; related section 10.6.", label:"Explain copyrights", canonical_key:"explain_copyrights", status:"approved"}}, {concept_id:"ee30142b-5641-56b7-9d4d-cdfd7838bb6a", kc_id:"ee30142b-5641-56b7-9d4d-cdfd7838bb6a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain crowdsourcing: using the input of a large group of people for market testing Source: chapter 10 Key Terms, printed page 366; related section 10.2.", label:"Explain crowdsourcing", canonical_key:"explain_crowdsourcing", status:"approved"}}, {concept_id:"382cee7f-3eb2-5fe8-8ba9-d353f67eaa13", kc_id:"382cee7f-3eb2-5fe8-8ba9-d353f67eaa13", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain diffusion of innovation: theory about how products gain momentum and spread through a population or society Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain diffusion of innovation", canonical_key:"explain_diffusion_of_innovation", status:"approved"}}, {concept_id:"1cc00a0f-ea62-5bb9-9c4a-16472ec4b5b8", kc_id:"1cc00a0f-ea62-5bb9-9c4a-16472ec4b5b8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain discontinuous innovation: new-to-the-world products that require a significant change in consumer behavior when adopted Source: chapter 10 Key Terms, printed page 366; related section 10.1.", label:"Explain discontinuous innovation", canonical_key:"explain_discontinuous_innovation", status:"approved"}}, {concept_id:"9e223f40-60b5-5580-b368-e2851cc029e6", kc_id:"9e223f40-60b5-5580-b368-e2851cc029e6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain divisibility: the ability of a consumer to give a product a “test run” before purchasing it Source: chapter 10 Key Terms, printed page 366; related section 10.5.", label:"Explain divisibility", canonical_key:"explain_divisibility", status:"approved"}}] AS row
