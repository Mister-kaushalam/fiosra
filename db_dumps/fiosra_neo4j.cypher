UNWIND [{start: {concept_id:"9e19e1b9-0f4a-5a09-9f65-fed003424ff0"}, end: {concept_id:"08255636-689f-5bc6-8c8f-465388ab73c6"}, properties:{rationale:"Selecting advertising indicators requires first linking measurable performance to a defined objective."}}, {start: {concept_id:"3eaf0de3-4b9d-5a2c-8e96-4299a25a3af5"}, end: {concept_id:"14ec6a88-03a2-5a7f-9e49-3f12e10d5ea7"}, properties:{rationale:"Campaign acquisition-cost analysis requires distinguishing acquisition expenditure from exposure and activity."}}, {start: {concept_id:"fbc8550e-b99b-5ae2-bca9-c95a23e03b19"}, end: {concept_id:"78b76c03-3c8c-55b5-bbfd-47ef4bbbe4c4"}, properties:{rationale:"New-product adoption applies the prior distinction between awareness, evaluation, purchase, and later behavior."}}, {start: {concept_id:"93f6befe-072d-5978-932b-d6bbbd74eb0f"}, end: {concept_id:"5a33f67e-dbf4-511d-b5e6-538f777ee883"}, properties:{rationale:"Explaining decoding errors requires understanding that receivers actively interpret information."}}, {start: {concept_id:"0ed7d359-41e9-59ed-bfcc-7634684d5d81"}, end: {concept_id:"bfc46748-bc6b-506c-8646-f664db30af44"}, properties:{rationale:"Interpreting potential advertising exposure requires distinguishing exposure from actual attention."}}, {start: {concept_id:"79aaa815-d5ec-591c-a85e-38e392c735a3"}, end: {concept_id:"3a7b97d9-e785-566c-9f2f-e1adf45c7bdf"}, properties:{rationale:"Post-sale follow-up requires understanding why customers can experience doubt after commitment."}}, {start: {concept_id:"c953315f-0754-5b04-aa2a-93ea089500f5"}, end: {concept_id:"ac3bb977-1c14-5b13-bbb5-33fa94dfc6f7"}, properties:{rationale:"Designing a team account approach requires identifying multiple organizational buying roles."}}, {start: {concept_id:"6c31b559-e926-5ef0-b61d-8f7093f6a54f"}, end: {concept_id:"566bec21-9123-5468-a6f7-230e66c9ae1f"}, properties:{rationale:"Linking upstream supply requirements to downstream customers requires understanding derived demand."}}, {start: {con