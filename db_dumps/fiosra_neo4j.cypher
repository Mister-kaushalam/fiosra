UNWIND [{concept_id:"CON_MEDIEVAL_INDIA_ED0FFD", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.681Z'), level:"strand", concept_type:"domain", created_at:datetime('2026-09-20T10:01:51.681Z'), definition:"Political, cultural, and economic developments during the medieval period including the Delhi Sultanate, Mughal Empire, regional kingdoms, Bhakti and Sufi movements, and Indo-Islamic synthesis.", label:"Medieval India", canonical_key:"MEDIEVAL_INDIA", status:"approved"}}, {concept_id:"CON_DELHI_SULTANATE_ADMINISTRATION_AND_ECONOMY_61F484", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.683Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.683Z'), definition:"The five dynasties of the Delhi Sultanate (1206-1526), their administrative systems including the iqta system, market controls under Alauddin Khalji, economic policies, and military organization.", label:"Delhi Sultanate Administration and Economy", canonical_key:"DELHI_SULTANATE_ADMINISTRATION_AND_ECONOMY", status:"approved"}}, {concept_id:"CON_MUGHAL_EMPIRE_AND_IMPERIAL_CONSOLIDATION_A8C34D", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.686Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.686Z'), definition:"The Mughal Empire (1526-1857) from Babur's conquest through Akbar's mansabdari system and sulh-i-kul, Shah Jahan's architectural patronage, and Aurangzeb's territorial expansion.", label:"Mughal Empire and Imperial Consolidation", canonical_key:"MUGHAL_EMPIRE_AND_IMPERIAL_CONSOLIDATION", status:"approved"}}, {concept_id:"CON_CULTURAL_SYNCRETISM_IN_MUGHAL_INDIA_45247D", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.693Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.693Z'), definition:"The blending of Hindu, Islamic, Persian, and Central Asian cultural elements in Mughal architecture, painting, music, literature, and cuisine, producing distinctly Indo-Islamic artistic traditions.", label:"Cultural Syncretism in Mughal India", canonical_key:"CULTURAL_SYNCRETISM_IN_MUGHAL_INDIA", status:"approved"}}, {concept_id:"CON_BHAKTI_AND_SUFI_DEVOTIONAL_MOVEMENTS_898E7F", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.7Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.7Z'), definition:"The Bhakti saints (Kabir, Mirabai, Guru Nanak) and Sufi orders (Chishti, Suhrawardi) as parallel devotional movements challenging caste hierarchies, emphasizing personal religious experience, and fostering Hindu-Muslim interaction.", label:"Bhakti and Sufi Devotional Movements", canonical_key:"BHAKTI_AND_SUFI_DEVOTIONAL_MOVEMENTS", status:"approved"}}, {concept_id:"CON_MUGHAL_DECLINE_AND_RISE_OF_REGIONAL_POWERS_712429", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.703Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.703Z'), definition:"The weakening of Mughal authority after Aurangzeb, rise of the Marathas under Shivaji and later Peshwas, the Sikh Empire under Ranjit Singh, and fragmentation into regional successor states.", label:"Mughal Decline and Rise of Regional Powers", canonical_key:"MUGHAL_DECLINE_AND_RISE_OF_REGIONAL_POWERS", status:"approved"}}, {concept_id:"CON_COLONIAL_INDIA_469CBF", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.708Z'), level:"strand", concept_type:"domain", created_at:datetime('2026-09-20T10:01:51.708Z'), definition:"The impact of British colonial rule on India including East India Company expansion, economic exploitation, social reforms, education policy, and the rise of nationalist movements.", label:"Colonial India", canonical_key:"COLONIAL_INDIA", status:"approved"}}, {concept_id:"CON_EAST_INDIA_COMPANY_AND_COLONIAL_CONQUEST_44DBA1", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.709Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.709Z'), definition:"The transformation of the East India Company from a trading enterprise to a territorial power through subsidiary alliances, military conquest, and exploitation of Indian political fragmentation.", label:"East India Company and Colonial Conquest", canonical_key:"EAST_INDIA_COMPANY_AND_COLONIAL_CONQUEST", status:"approved"}}, {concept_id:"CON_COLONIAL_ECONOMIC_EXPLOITATION_AND_DE_INDUSTRIAL_902A5D", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.713Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.713Z'), definition:"The systematic transformation of India from a manufacturing economy to a raw material supplier, destruction of traditional industries, drain of wealth, and impact on Indian economic development.", label:"Colonial Economic Exploitation and De-industrialization", canonical_key:"COLONIAL_ECONOMIC_EXPLOITATION_AND_DE_INDUSTRIAL", status:"approved"}}, {concept_id:"CON_SOCIAL_REFORM_MOVEMENTS_IN_COLONIAL_INDIA_36C5B5", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.717Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.717Z'), definition:"The Bengal Renaissance and social reform led by Ram Mohan Roy, Vidyasagar, and others, addressing sati, widow remarriage, education, and caste reform within colonial modernity.", label:"Social Reform Movements in Colonial India", canonical_key:"SOCIAL_REFORM_MOVEMENTS_IN_COLONIAL_INDIA", status:"approved"}}, {concept_id:"CON_INDIAN_INDEPENDENCE_MOVEMENT_5F7B81", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.722Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.722Z'), definition:"The organized nationalist movement from the founding of the Indian National Congress (1885) through mass movements, revolutionary activities, and negotiations leading to independence in 1947.", label:"Indian Independence Movement", canonical_key:"INDIAN_INDEPENDENCE_MOVEMENT", status:"approved"}}, {concept_id:"CON_WORLD_WAR_I_AND_INDIAN_MILITARY_CONTRIBUTION_9C9C2A", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.725Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.725Z'), definition:"India's massive military contribution to WWI (800,000+ volunteers), political consequences, and the unfulfilled promise of self-governance leading to post-war radicalization.", label:"World War I and Indian Military Contribution", canonical_key:"WORLD_WAR_I_AND_INDIAN_MILITARY_CONTRIBUTION", status:"approved"}}, {concept_id:"CON_POST_INDEPENDENCE_INDIA_9B4383", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.734Z'), level:"strand", concept_type:"domain", created_at:datetime('2026-09-20T10:01:51.734Z'), definition:"Challenges and transformations after 1947 including Partition, democratic institution-building, economic planning, social reform, and linguistic reorganization.", label:"Post-Independence India", canonical_key:"POST_INDEPENDENCE_INDIA", status:"approved"}}, {concept_id:"CON_PARTITION_OF_INDIA_AND_ITS_CONSEQUENCES_B07FB9", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.735Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.735Z'), definition:"The 1947 partition into India and Pakistan, mass displacement of 10-20 million people, communal violence, refugee crises, and long-term political and social consequences.", label:"Partition of India and Its Consequences", canonical_key:"PARTITION_OF_INDIA_AND_ITS_CONSEQUENCES", status:"approved"}}, {concept_id:"CON_BUILDING_DEMOCRATIC_INSTITUTIONS_AAFA7B", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.741Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.741Z'), definition:"Drafting of India's Constitution under Ambedkar, establishment of parliamentary democracy, universal suffrage, independent judiciary, and challenges of governance in a diverse post-colonial society.", label:"Building Democratic Institutions", canonical_key:"BUILDING_DEMOCRATIC_INSTITUTIONS", status:"approved"}}, {concept_id:"CON_ECONOMIC_PLANNING_AND_DEVELOPMENT_7888BF", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.746Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.746Z'), definition:"Nehruvian planning, Five Year Plans, mixed economy, industrialization through public sector enterprises, land reforms, Green Revolution, and debates between socialist and market paths.", label:"Economic Planning and Development", canonical_key:"ECONOMIC_PLANNING_AND_DEVELOPMENT", status:"approved"}}, {concept_id:"CON_LINGUISTIC_REORGANIZATION_AND_FEDERALISM_AAE3F5", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.75Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.75Z'), definition:"The States Reorganization Act of 1956, creation of linguistic states, Hindi-regional language tensions, and the role of linguistic identity in shaping Indian federalism.", label:"Linguistic Reorganization and Federalism", canonical_key:"LINGUISTIC_REORGANIZATION_AND_FEDERALISM", status:"approved"}}, {concept_id:"CON_FOUNDATIONS_OF_INDIAN_HISTORY_1432D4", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.444Z'), level:"course_theme", concept_type:"domain", created_at:datetime('2026-09-20T10:01:51.444Z'), definition:"Comprehensive exploration of key events, figures, and cultural developments that shaped Indian history from ancient times to the modern era, grounded in primary sources and historical interpretations.", label:"Foundations of Indian History", canonical_key:"FOUNDATIONS_OF_INDIAN_HISTORY", status:"approved"}}, {concept_id:"CON_ANCIENT_CIVILIZATIONS_OF_INDIA_E955BB", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.488Z'), level:"strand", concept_type:"domain", created_at:datetime('2026-09-20T10:01:51.488Z'), definition:"Study of early civilizations including the Indus Valley Civilization, Vedic society, and the transition from Neolithic settlements at Mehrgarh to urbanized cultures with complex social, political, and economic structures.", label:"Ancient Civilizations of India", canonical_key:"ANCIENT_CIVILIZATIONS_OF_INDIA", status:"approved"}}, {concept_id:"CON_INDUS_VALLEY_CIVILIZATION_AND_URBAN_PLANNING_BAB06E", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.54Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.54Z'), definition:"The Harappan civilization (c. 3300-1300 BCE) featuring advanced urban planning at Mohenjo-daro and Harappa, standardized weights and measures, hydraulic engineering, granary systems, and long-distance maritime trade with Mesopotamia.", label:"Indus Valley Civilization and Urban Planning", canonical_key:"INDUS_VALLEY_CIVILIZATION_AND_URBAN_PLANNING", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id}) SET n += row.properties;
UNWIND [{concept_id:"CON_VEDIC_SOCIETY_AND_LITERATURE_7F9DFA", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.583Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.583Z'), definition:"The Vedic period (c. 1500-500 BCE) encompassing the composition of the Rigveda, development of the varna system, Vedic ritual practices, and the transition from pastoral to settled agricultural communities.", label:"Vedic Society and Literature", canonical_key:"VEDIC_SOCIETY_AND_LITERATURE", status:"approved"}}, {concept_id:"CON_NEOLITHIC_AND_CHALCOLITHIC_SETTLEMENTS_2FD285", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.591Z'), level:"topic", concept_type:"process", created_at:datetime('2026-09-20T10:01:51.591Z'), definition:"Early agricultural communities from Mehrgarh (7000 BCE) through the Chalcolithic period, tracing the development of farming, animal domestication, pottery, and proto-urban settlement patterns in Baluchistan and the Indus plain.", label:"Neolithic and Chalcolithic Settlements", canonical_key:"NEOLITHIC_AND_CHALCOLITHIC_SETTLEMENTS", status:"approved"}}, {concept_id:"CON_EMPIRES_AND_KINGDOMS_874408", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.597Z'), level:"strand", concept_type:"domain", created_at:datetime('2026-09-20T10:01:51.597Z'), definition:"Rise and fall of major empires in Indian history including the Maurya, Gupta, Kushan, Satavahana, and regional kingdoms, examining their contributions to art, science, governance, and trade.", label:"Empires and Kingdoms", canonical_key:"EMPIRES_AND_KINGDOMS", status:"approved"}}, {concept_id:"CON_MAURYAN_EMPIRE_AND_CENTRALIZED_ADMINISTRATION_A7EF58", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.599Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.599Z'), definition:"The Maurya Empire (322-185 BCE) under Chandragupta and Ashoka, featuring Kautilya's Arthashastra, centralized bureaucracy, espionage networks, provincial governance, and Ashoka's dhamma policy after the Kalinga War.", label:"Mauryan Empire and Centralized Administration", canonical_key:"MAURYAN_EMPIRE_AND_CENTRALIZED_ADMINISTRATION", status:"approved"}}, {concept_id:"CON_GUPTA_EMPIRE_AND_CLASSICAL_GOLDEN_AGE_A091BD", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.666Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.666Z'), definition:"The Gupta Empire (c. 320-550 CE) and the flourishing of Sanskrit literature, Nalanda University, advances in mathematics (zero, decimal system), astronomy (Aryabhata), metallurgy (Iron Pillar), and artistic achievements.", label:"Gupta Empire and Classical Golden Age", canonical_key:"GUPTA_EMPIRE_AND_CLASSICAL_GOLDEN_AGE", status:"approved"}}, {concept_id:"CON_KUSHAN_AND_SATAVAHANA_DYNASTIES_0566FB", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.672Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.672Z'), definition:"The Kushan Empire under Kanishka patronizing Buddhism and facilitating Silk Road trade, and the Satavahana dynasty bridging North and South India through Deccan trade routes, coin minting, and Buddhist monument patronage.", label:"Kushan and Satavahana Dynasties", canonical_key:"KUSHAN_AND_SATAVAHANA_DYNASTIES", status:"approved"}}, {concept_id:"CON_SHUNGA_AND_POST_MAURYAN_KINGDOMS_9224AE", properties:{course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:51.676Z'), level:"topic", concept_type:"entity", created_at:datetime('2026-09-20T10:01:51.676Z'), definition:"The Shunga Empire's role in the transition from Mauryan centralism to regional fragmentation, patronage of Buddhist art at Sanchi, and the emergence of Indo-Greek and other successor states.", label:"Shunga and Post-Mauryan Kingdoms", canonical_key:"SHUNGA_AND_POST_MAURYAN_KINGDOMS", status:"approved"}}, {concept_id:"CON_STATE_FORMATION_AND_INSTITUTIONAL_POWER_C1AE31", properties:{course_id:"31aef6da-9645-417b-ae2f-2d3a32824fda", updated_at:datetime('2026-09-20T13:12:25.3Z'), level:"course_theme", concept_type:"domain", created_at:datetime('2026-09-20T13:12:25.3Z'), definition:"How institutions organize authority, resources, and political constraint.", label:"State formation and institutional power", canonical_key:"STATE_FORMATION_AND_INSTITUTIONAL_POWER", status:"approved"}}, {concept_id:"CON_FISCAL_CAPACITY_AND_INSTITUTIONAL_CONSTRAINT_522B7F", properties:{course_id:"31aef6da-9645-417b-ae2f-2d3a32824fda", updated_at:datetime('2026-09-20T13:12:25.479Z'), level:"topic", concept_type:"relationship", created_at:datetime('2026-09-20T13:12:25.479Z'), definition:"Revenue institutions shape the state capacity available for political action.", label:"Fiscal capacity and institutional constraint", canonical_key:"FISCAL_CAPACITY_AND_INSTITUTIONAL_CONSTRAINT", status:"approved"}}, {concept_id:"CON_BIO_210_CELLULAR_ENERGY_AND_EVIDENCE_CIVILIZATIO_B9EFBA", properties:{course_id:"14be4a54-d754-4d7a-9cae-302c5b812296", updated_at:datetime('2026-09-20T13:12:26.297Z'), level:"course_theme", concept_type:"domain", created_at:datetime('2026-09-20T13:12:26.297Z'), definition:"Students investigate cellular energy conversion using experimental evidence.", label:"BIO-210: Cellular Energy and Evidence: Civilizational and Disciplinary Trajectories", canonical_key:"BIO_210_CELLULAR_ENERGY_AND_EVIDENCE_CIVILIZATIO", status:"approved"}}, {concept_id:"CON_ENERGY_TRANSFER_FOUNDATIONS_FE0A60", properties:{course_id:"14be4a54-d754-4d7a-9cae-302c5b812296", updated_at:datetime('2026-09-20T13:12:26.302Z'), level:"strand", concept_type:"process", created_at:datetime('2026-09-20T13:12:26.302Z'), definition:"Cu