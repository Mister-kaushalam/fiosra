:begin
CREATE FULLTEXT INDEX community_name FOR (n:Community) ON EACH [n.`name`,n.`group_id`];
CREATE FULLTEXT INDEX edge_name_and_fact FOR ()-[rel:RELATES_TO]-() ON EACH [rel.`name`,rel.`fact`,rel.`group_id`];
CREATE FULLTEXT INDEX episode_content FOR (n:Episodic) ON EACH [n.`content`,n.`source`,n.`source_description`,n.`group_id`];
CREATE FULLTEXT INDEX node_name_and_summary FOR (n:Entity) ON EACH [n.`name`,n.`summary`,n.`group_id`];
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:HAS_EPISODE]-() ON (rel.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:HAS_EPISODE]-() ON (rel.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:HAS_MEMBER]-() ON (rel.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:MENTIONS]-() ON (rel.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:MENTIONS]-() ON (rel.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:NEXT_EPISODE]-() ON (rel.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:NEXT_EPISODE]-() ON (rel.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:RELATES_TO]-() ON (rel.created_at);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:RELATES_TO]-() ON (rel.expired_at);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:RELATES_TO]-() ON (rel.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:RELATES_TO]-() ON (rel.invalid_at);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:RELATES_TO]-() ON (rel.name);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:RELATES_TO]-() ON (rel.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR ()-[rel:RELATES_TO]-() ON (rel.valid_at);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Community) ON (n.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Community) ON (n.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Concept) ON (n.course_id);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Concept) ON (n.course_id, n.canonical_key);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Entity) ON (n.created_at);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Entity) ON (n.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Entity) ON (n.name);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Entity) ON (n.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Episodic) ON (n.created_at);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Episodic) ON (n.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Episodic) ON (n.uuid);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Episodic) ON (n.valid_at);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:KnowledgeComponent) ON (n.domain);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Misconception) ON (n.kc_id);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Saga) ON (n.group_id);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Saga) ON (n.name);
CREATE RANGE INDEX IF NOT EXISTS FOR (n:Saga) ON (n.uuid);
CREATE CONSTRAINT assignment_id_unique IF NOT EXISTS FOR (node:Assignment) REQUIRE (node.assignment_id) IS UNIQUE;
CREATE CONSTRAINT concept_id_unique IF NOT EXISTS FOR (node:Concept) REQUIRE (node.concept_id) IS UNIQUE;
CREATE CONSTRAINT course_id_unique IF NOT EXISTS FOR (node:Course) REQUIRE (node.course_id) IS UNIQUE;
CREATE CONSTRAINT kc_id_unique IF NOT EXISTS FOR (node:KnowledgeComponent) REQUIRE (node.kc_id) IS UNIQUE;
CREATE CONSTRAINT misconception_id_unique IF NOT EXISTS FOR (node:Misconception) REQUIRE (node.misconception_id) IS UNIQUE;
CREATE CONSTRAINT module_id_unique IF NOT EXISTS FOR (node:Module) REQUIRE (node.module_id) IS UNIQUE;
CREATE CONSTRAINT probe_id_unique IF NOT EXISTS FOR (node:SocraticProbe) REQUIRE (node.probe_id) IS UNIQUE;
CREATE CONSTRAINT question_id_unique IF NOT EXISTS FOR (node:Question) REQUIRE (node.question_id) IS UNIQUE;
CREATE CONSTRAINT session_id_unique IF NOT EXISTS FOR (node:TutoringSession) REQUIRE (node.session_id) IS UNIQUE;
CREATE CONSTRAINT source_chunk_id_unique IF NOT EXISTS FOR (node:SourceChunk) REQUIRE (node.chunk_id) IS UNIQUE;
CREATE CONSTRAINT source_material_key_unique IF NOT EXISTS FOR (node:SourceMaterial) REQUIRE (node.resource_key) IS UNIQUE;
CREATE CONSTRAINT student_id_unique IF NOT EXISTS FOR (node:Student) REQUIRE (node.student_id) IS UNIQUE;
CREATE CONSTRAINT UNIQUE_IMPORT_NAME IF NOT EXISTS FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
:begin
UNWIND [{session_id:"7c619d95-097d-411b-9152-927a89086924", properties:{}}, {session_id:"2ab5c57b-d230-406d-b20e-ecb43dabf453", properties:{}}, {session_id:"session_bfb94b58", properties:{}}, {session_id:"b0fa6266-9356-4fe1-9511-23a157ef27cd", properties:{}}, {session_id:"588611f0-086c-4545-894d-699b38d850b3", properties:{}}, {session_id:"cb45d6f6-4688-4899-a4d5-845b9e4fd4b6", properties:{}}, {session_id:"c8960042-58e4-4d9f-b41d-3da5612d41df", properties:{}}, {session_id:"session_e0ad8809", properties:{}}, {session_id:"b7b598f6-83d6-4775-a737-784e6cf539b5", properties:{}}, {session_id:"1a8413a7-39e5-4b06-8968-b5c1e3834c54", properties:{}}, {session_id:"d34db00b-88f8-426f-8661-66be99b423ef", properties:{}}, {session_id:"0ae24c52-4b84-44ca-b1d4-3d3000807fea", properties:{}}, {session_id:"d6f2fe0f-dd8e-4c75-a19e-8094a0118179", properties:{}}, {session_id:"session_dcb4fae9", properties:{}}, {session_id:"24eb8223-c779-49e4-b2b3-a175d9711f6b", properties:{}}, {session_id:"50151f47-d81c-4c27-980a-9047cdad3628", properties:{}}] AS row
CREATE (n:TutoringSession{session_id: row.session_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_FIRMOGRAPHICS_DIAGNOSTIC_MISCONCEPTION_281_209E1F", properties:{kc_id:"f9d75454-5973-5ffe-834e-5e18cf3a11b2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"firmographics: diagnostic misconception 281", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.2. a grouping of B2B customers based on shared company attributes; includes five categories: industry, location, size, legal structure, and performance", status:"approved", flawed_rule:"Personal age and household income are the principal firmographic variables."}}, {misconception_id:"MISC_GEOGRAPHIC_SEGMENTATION_DIAGNOSTIC_MISCONCEPTION_7A7B44", properties:{kc_id:"44457c5a-a785-5077-9550-3da6a29d7a0f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"geographic segmentation in chapter 5 What Do Marketers Do? task 1: diagnostic misconception 1673", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, What Do Marketers Do?, task 1. marketing strategy used to target products or services at people who live in or shop at a particular location", status:"approved", flawed_rule:"Customers in the same location necessarily have identical needs."}}, {misconception_id:"MISC_HEAD_TO_HEAD_POSITIONING_DIAGNOSTIC_MISCONCEPTIO_7BE1B8", properties:{kc_id:"ae3dd4d0-2554-5029-926c-a73a1c93a3b5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"head-to-head positioning: diagnostic misconception 283", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.6. directly competing with competitors on similar product attributes in the same market", status:"approved", flawed_rule:"Head-to-head positioning avoids comparison on competitors' main attributes."}}, {misconception_id:"MISC_MARKET_SEGMENTATION_DIAGNOSTIC_MISCONCEPTION_284_DABF52", properties:{kc_id:"e29b92a6-d6f2-5b3d-b934-47c8913af29c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"market segmentation in chapter 5 Closing Company Case task 1: diagnostic misconception 1675", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Closing Company Case, task 1. the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_MICROMARKETING_DIAGNOSTIC_MISCONCEPTION_285_70FB04", properties:{kc_id:"0f16cf98-4365-55f8-8d02-fb655ea7aabd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"micromarketing: diagnostic misconception 285", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.5. marketing strategy used on a targeted group of customers in a niche market", status:"approved", flawed_rule:"Micromarketing is a single undifferentiated campaign for an entire national market."}}, {misconception_id:"MISC_MULTI_SEGMENT_MARKETING_DIAGNOSTIC_MISCONCEPTION_465D96", properties:{kc_id:"dd7dc97c-401c-5f90-906d-cb11f879f531", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"multi-segment marketing: diagnostic misconception 286", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.1. marketing strategy in which the firm targets several different market segments simultaneously", status:"approved", flawed_rule:"Serving several segments never increases coordination or resource demands."}}, {misconception_id:"MISC_NEEDS_BASED_SEGMENTATION_DIAGNOSTIC_MISCONCEPTIO_1B8558", properties:{kc_id:"ca779e7b-25c2-5ab9-bccf-305ec617dc78", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"needs-based segmentation: diagnostic misconception 287", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.2. dividing the market up into smaller groups of people who have approximately the same needs", status:"approved", flawed_rule:"All customers within one industry have the same underlying needs."}}, {misconception_id:"MISC_PERCEPTUAL_MAP_DIAGNOSTIC_MISCONCEPTION_288_FDDC07", properties:{kc_id:"c13fa394-2589-534e-80c5-83ee7c493d03", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"perceptual map in chapter 5 Closing Company Case task 4: diagnostic misconception 1678", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Closing Company Case, task 4. visual depiction of how target customers view and feel about a given brand or product", status:"approved", flawed_rule:"A perceptual map records objective engineering superiority rather than customer perceptions."}}, {misconception_id:"MISC_POSITIONING_STATEMENT_DIAGNOSTIC_MISCONCEPTION_2_4DB2E7", properties:{kc_id:"87999874-6766-538a-b0b3-57e062baa16c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"positioning statement in chapter 5 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1667", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Applied Marketing Knowledge: Discussion Questions, task 3. short description of an organization’s target market(s) and the product(s) provided to them", status:"approved", flawed_rule:"A positioning statement is merely a public advertising slogan."}}, {misconception_id:"MISC_PSYCHOGRAPHIC_SEGMENTATION_DIAGNOSTIC_MISCONCEPT_1766A7", properties:{kc_id:"0e481d7e-c6be-5405-83d3-aac4dcc4c2de", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"psychographic segmentation: diagnostic misconception 291", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.1. dividing consumers into subgroups based on shared psychological characteristics, including beliefs, motivations, and priorities", status:"approved", flawed_rule:"Psychographics classify only observable age, income, and location."}}, {misconception_id:"MISC_STP_MODEL_DIAGNOSTIC_MISCONCEPTION_292_D7B37F", properties:{kc_id:"7417cf0f-60cb-581e-9e14-47b3f8f8d38b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"STP model in chapter 5 Critical Thinking Exercises task 2: diagnostic misconception 1670", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Critical Thinking Exercises, task 2. three-step marketing framework in which an organization segments the market, selects target market(s), and positions its products or services", status:"approved", flawed_rule:"Positioning can be chosen coherently before understanding segments and target customers."}}, {misconception_id:"MISC_TARGET_MARKET_DIAGNOSTIC_MISCONCEPTION_293_A2F75D", properties:{kc_id:"57ab7f12-112f-5aca-8f87-e6d306f83319", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"target market in chapter 5 Closing Company Case task 2: diagnostic misconception 1676", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Closing Company Case, task 2. group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_TECHNOGRAPHIC_SEGMENTATION_DIAGNOSTIC_MISCONCEPT_ED1D44", properties:{kc_id:"f74fcbde-b631-5e21-9ef3-1fac452d7908", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"technographic segmentation: diagnostic misconception 294", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.2. organizing B2B prospects by their technology ownership and usage", status:"approved", flawed_rule:"Technographics classify prospects only by company size."}}, {misconception_id:"MISC_UNDIFFERENTIATED_MARKETING_DIAGNOSTIC_MISCONCEPT_788F6E", properties:{kc_id:"aa9f3442-2665-5fdf-891b-9d8ded0c60ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"undifferentiated marketing in chapter 5 Critical Thinking Exercises task 3: diagnostic misconception 1671", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Critical Thinking Exercises, task 3. also called mass marketing, a strategy that entails creating one message for an entire audience", status:"approved", flawed_rule:"Undifferentiated marketing requires separate offers for every segment."}}, {misconception_id:"MISC_VALUE_BASED_SEGMENTATION_DIAGNOSTIC_MISCONCEPTIO_00ABC7", properties:{kc_id:"52f0d837-2677-5216-8e8e-e18439541cd0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"value-based segmentation: diagnostic misconception 296", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.2. evaluating groups of customers in terms of the revenue they generate and the costs of establishing and maintaining relationships with them", status:"approved", flawed_rule:"Customers generating the most revenue necessarily generate the most relationship value."}}, {misconception_id:"MISC_AIDED_AWARENESS_DIAGNOSTIC_MISCONCEPTION_297_4C9419", properties:{kc_id:"c8ec6836-0750-55b8-a673-402eb7726c5d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"aided awareness: diagnostic misconception 297", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. when a product, brand, or company list is provided to select from to measure awareness", status:"approved", flawed_rule:"Recognition from a supplied brand list demonstrates unaided recall."}}, {misconception_id:"MISC_ANONYMOUS_DATA_DIAGNOSTIC_MISCONCEPTION_298_349292", properties:{kc_id:"84e26273-f6b4-57fa-b53d-82c6dde48b08", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"anonymous data in chapter 6 Closing Company Case task 3: diagnostic misconception 1692", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Closing Company Case, task 3. data in which the respondent is not identified", status:"approved", flawed_rule:"Data remain anonymous even when the researcher can identify each respondent."}}, {misconception_id:"MISC_AWARENESS_DIAGNOSTIC_MISCONCEPTION_299_7E6AA4", properties:{kc_id:"2bcd475b-e7cc-590d-a429-11676da7b3af", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"awareness: diagnostic misconception 299", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a consumer’s familiarity with a product, brand, or company", status:"approved", flawed_rule:"Awareness of a brand proves preference and purchase intent."}}, {misconception_id:"MISC_BIG_DATA_DIAGNOSTIC_MISCONCEPTION_300_803C99", properties:{kc_id:"3d264af5-4195-55f9-8f46-2d8648f2868b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"big data: diagnostic misconception 300", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.1. the countless number of records that continues in an increasing capacity and at a faster rate; often described as volume, velocity, and variety of data generated", status:"approved", flawed_rule:"Large data volume automatically eliminates sampling bias and poor measurement."}}, {misconception_id:"MISC_BREACH_OF_CONFIDENTIALITY_DIAGNOSTIC_MISCONCEPTI_D1D111", properties:{kc_id:"99e06102-f55e-5ddc-98d9-f4d30596f09f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"breach of confidentiality: diagnostic misconception 301", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.4. a situation where the researcher promises to hold private information but discloses it in an unethical manner without permission", status:"approved", flawed_rule:"Removing names after disclosing identifiable responses repairs the original confidentiality breach."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_CAUSAL_RESEARCH_DIAGNOSTIC_MISCONCEPTION_302_35D97E", properties:{kc_id:"e1396447-9f0b-5885-ae49-a9fdadd1413c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"causal research: diagnostic misconception 302", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. studies that define a cause-and-effect relationship between two factors", status:"approved", flawed_rule:"Any observed association establishes a cause-and-effect relationship."}}, {misconception_id:"MISC_CENSUS_DIAGNOSTIC_MISCONCEPTION_303_FA8768", properties:{kc_id:"a8adbe92-5f66-5f10-bdf1-ade258eadc20", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"census: diagnostic misconception 303", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. when all potential target population members are included in the research", flawed_rule:"A census is a small sample chosen to represent the population.", status:"approved"}}, {misconception_id:"MISC_COMPETITIVE_INTELLIGENCE_DIAGNOSTIC_MISCONCEPTIO_9A5A0C", properties:{kc_id:"b49ba881-fdec-5148-aa65-f840bca45843", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"competitive intelligence: diagnostic misconception 304", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.2. a collection of information about competitors from the marketplace", status:"approved", flawed_rule:"Competitive intelligence requires access to a competitor's confidential records."}}, {misconception_id:"MISC_CONFIDENTIAL_DATA_DIAGNOSTIC_MISCONCEPTION_305_C9C416", properties:{kc_id:"e849aa70-eefc-5d29-bb6c-14f2a00d196d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"confidential data: diagnostic misconception 305", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.4. data that is tied back to a respondent, but the respondent’s personal information is not shared", status:"approved", flawed_rule:"Confidential data cannot be linked to respondents even by the researcher."}}, {misconception_id:"MISC_CONVENIENCE_SAMPLE_DIAGNOSTIC_MISCONCEPTION_306_53345E", properties:{kc_id:"96d0e55d-90ac-586f-8a04-5cd54bf6341c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"convenience sample: diagnostic misconception 306", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a nonprobability sample type where potential respondents to the research are selected by convenience rather than through any scientific method", status:"approved", flawed_rule:"An easily reached sample is automatically representative of the target market."}}, {misconception_id:"MISC_CROSS_TABULATION_DIAGNOSTIC_MISCONCEPTION_307_E6982B", properties:{kc_id:"e14888b8-719a-5d6c-a50e-39621476f45b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cross tabulation: diagnostic misconception 307", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. an analysis of two variables and the frequency of each answer in relation to the other variable", status:"approved", flawed_rule:"Separate totals for two variables reveal how their responses are jointly distributed."}}, {misconception_id:"MISC_CUSTOMER_EFFORT_SCORE_DIAGNOSTIC_MISCONCEPTION_3_955E0F", properties:{kc_id:"9ecd3305-6c94-5ea0-9fbc-e2310fea26b3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer effort score: diagnostic misconception 309", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a survey used to measure ease of service experience with an organization", status:"approved", flawed_rule:"Customer effort measures overall satisfaction rather than ease of completing a service interaction."}}, {misconception_id:"MISC_CUSTOMER_SATISFACTION_SCORE_DIAGNOSTIC_MISCONCEP_778CE5", properties:{kc_id:"48bc83bd-f69c-5f1a-be2c-2e538a8a585c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer satisfaction score: diagnostic misconception 310", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. A measure of how satisfied customers are with a product, brand, or service, described as CSAT in section 6.3. Source inconsistency: the chapter glossary mistakenly repeats the customer effort score definition; this node follows the substantive section.", status:"approved", flawed_rule:"Customer satisfaction and customer effort are interchangeable measurements."}}, {misconception_id:"MISC_DATA_ANALYSIS_DIAGNOSTIC_MISCONCEPTION_311_3F64B8", properties:{kc_id:"7def54e7-d7bc-5859-bc60-227239a381b9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"data analysis: diagnostic misconception 311", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. the distillation of information into a more understandable and actionable format", status:"approved", flawed_rule:"Collecting data is sufficient; interpretation cannot change the decision."}}, {misconception_id:"MISC_DATA_COLLECTION_DIAGNOSTIC_MISCONCEPTION_312_9E72A9", properties:{kc_id:"2ea1add6-cd47-571d-8785-7e4e66c7efcd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"data collection: diagnostic misconception 312", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.1. systematic gathering of information that addresses an identified problem", status:"approved", flawed_rule:"More observations are useful even when they do not address the research problem."}}, {misconception_id:"MISC_DATABASE_DIAGNOSTIC_MISCONCEPTION_313_9593B6", properties:{kc_id:"82672235-cfe4-5c05-b8c2-e95b2da3f5b0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"database: diagnostic misconception 313", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.2. a collection of related data", status:"approved", flawed_rule:"A pile of unrelated records automatically functions as an organized database."}}, {misconception_id:"MISC_DESCRIPTIVE_RESEARCH_DIAGNOSTIC_MISCONCEPTION_31_F3B63F", properties:{kc_id:"f192d74d-2a93-5a89-8b83-51d7c15c95ac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"descriptive research: diagnostic misconception 314", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. data collected to describe the situation in the market and help define an opinion, attitude, or behavior", status:"approved", flawed_rule:"Describing who buys a product proves why the purchase occurred."}}, {misconception_id:"MISC_ELECTRONIC_SURVEYS_DIAGNOSTIC_MISCONCEPTION_315_03576C", properties:{kc_id:"32198b52-e873-5f7f-85bb-c89041cda47f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"electronic surveys: diagnostic misconception 315", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. surveys sent through digital means to respondents; respondents also reply to the survey digitally", status:"approved", flawed_rule:"Online distribution removes all coverage and nonresponse biases."}}, {misconception_id:"MISC_ETHNOGRAPHIC_RESEARCH_DIAGNOSTIC_MISCONCEPTION_3_F047F6", properties:{kc_id:"fe1efb40-7a76-55c4-961e-04d1d8761447", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"ethnographic research: diagnostic misconception 316", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. method of collecting data that is conducted by observing people’s natural behavior", status:"approved", flawed_rule:"A brief laboratory questionnaire is equivalent to observing behavior in its natural setting."}}, {misconception_id:"MISC_EXPERIMENTAL_RESEARCH_DIAGNOSTIC_MISCONCEPTION_3_86DC19", properties:{kc_id:"6a344f1e-a4a8-5345-848a-027ca958a2f6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"experimental research: diagnostic misconception 317", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. studies that define a cause-and-effect relationship between two factors", status:"approved", flawed_rule:"A survey measuring two related variables is automatically an experiment."}}, {misconception_id:"MISC_EXPLORATORY_RESEARCH_DIAGNOSTIC_MISCONCEPTION_31_FA0DA3", properties:{kc_id:"496ec1b1-bab6-5609-abdd-9f637dec5e9b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"exploratory research: diagnostic misconception 318", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. research conducted that is more general to learn more about the industry or market", status:"approved", flawed_rule:"Exploratory findings alone provide definitive population estimates."}}, {misconception_id:"MISC_EXTERNAL_DATA_DIAGNOSTIC_MISCONCEPTION_319_DD9D12", properties:{kc_id:"cd2f342e-7172-5ad9-aee5-68a3ad96a738", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"external data: diagnostic misconception 319", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.2. data that originates from outside the organization", status:"approved", flawed_rule:"Data purchased from outside the company must be primary data."}}, {misconception_id:"MISC_FOCUS_GROUP_DIAGNOSTIC_MISCONCEPTION_320_BDD754", properties:{kc_id:"409be254-b3dc-5eac-b93f-67f0d2f3668c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"focus group: diagnostic misconception 320", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a small group, typically 8 to 12 people, who are asked several questions by a moderator and encouraged to build upon each other’s responses", status:"approved", flawed_rule:"Eight enthusiastic focus-group participants establish a population-wide preference percentage."}}, {misconception_id:"MISC_FREQUENCY_DIAGNOSTIC_MISCONCEPTION_321_FB5269", properties:{kc_id:"1a3f7f48-cfe3-5cf4-9c44-10c776fc30b1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"frequency: diagnostic misconception 656", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. how many times someone is exposed to an advertisement in a given time period or how many times an advertisement is shown in a time period", status:"approved", flawed_rule:"Frequency counts unique people reached rather than repeat exposures."}}, {misconception_id:"MISC_IN_PERSON_SURVEYS_DIAGNOSTIC_MISCONCEPTION_322_D2ECC3", properties:{kc_id:"5f510b2f-d378-5952-99cb-97047a702ee1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"in-person surveys: diagnostic misconception 322", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. surveys conducted when the respondent and data collector are face-to-face", status:"approved", flawed_rule:"Face-to-face interviews eliminate interviewer influence and social-desirability effects."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_INFOGRAPHIC_DIAGNOSTIC_MISCONCEPTION_323_A16DBB", properties:{kc_id:"5e56c5cf-51a4-593e-9279-e3f8befed9b9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"infographic: diagnostic misconception 323", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a representation of data in a variety of visual presentations", status:"approved", flawed_rule:"Visual appeal can replace accurate scales and context in research reporting."}}, {misconception_id:"MISC_INTERNAL_DATA_DIAGNOSTIC_MISCONCEPTION_324_155093", properties:{kc_id:"dc6621a7-3207-58eb-afde-75e092ddb9ff", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"internal data in chapter 6 Building Your Personal Brand task 1: diagnostic misconception 1687", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Building Your Personal Brand, task 1. critical marketing intelligence that already exists in the company’s records", status:"approved", flawed_rule:"Existing transaction records answer every new research question without assessment."}}, {misconception_id:"MISC_JUDGMENT_SAMPLE_DIAGNOSTIC_MISCONCEPTION_325_8860D7", properties:{kc_id:"174925b3-616e-587a-b813-f4e5dfcb79fa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"judgment sample: diagnostic misconception 325", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a nonprobability sample type where the potential participants are selected based on a perceived match to the sample frame", status:"approved", flawed_rule:"Researcher judgment gives every population member a known selection probability."}}, {misconception_id:"MISC_MAILED_SURVEYS_DIAGNOSTIC_MISCONCEPTION_326_856272", properties:{kc_id:"4ddd92e7-da4e-5474-a8cf-c82d2b870255", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"mailed surveys: diagnostic misconception 326", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. surveys sent to potential participants through a mail service, such as the US Postal Service", status:"approved", flawed_rule:"Every person receiving a mailed questionnaire will respond."}}, {misconception_id:"MISC_MARKETING_INFORMATION_DIAGNOSTIC_MISCONCEPTION_3_56140F", properties:{kc_id:"0fe432a2-421d-51e5-afbc-3e9d43c269f9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"marketing information in chapter 6 Marketing Plan Exercise task 1: diagnostic misconception 1689", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Marketing Plan Exercise, task 1. also known as business intelligence, competitive intelligence, or marketing intelligence; information about the market that helps to identify opportunities available", status:"approved", flawed_rule:"Market information is useful only for advertising design."}}, {misconception_id:"MISC_MARKETING_INFORMATION_SYSTEM_DIAGNOSTIC_MISCONCE_D29728", properties:{kc_id:"ab0abe63-f731-5515-bd87-7f6b32e749fb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing information system: diagnostic misconception 328", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.1. a system used to collect, analyze, and report interesting findings from internal and external data of the company", status:"approved", flawed_rule:"An information system stores data but need not analyze or report it."}}, {misconception_id:"MISC_MARKETING_RESEARCH_DIAGNOSTIC_MISCONCEPTION_329_04DB7E", properties:{kc_id:"daf291d8-58c9-5363-89e6-9a744e2bded9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"marketing research in chapter 6 Closing Company Case task 2: diagnostic misconception 1691", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Closing Company Case, task 2. the function that links the consumer, customer, and public to the marketer through information", status:"approved", flawed_rule:"Research is conducted only after the marketer has already selected the desired answer."}}, {misconception_id:"MISC_MEAN_DIAGNOSTIC_MISCONCEPTION_330_DD3578", properties:{kc_id:"ec9e463e-7907-5db3-b18a-4fe38cabf56a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"mean: diagnostic misconception 330", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. an arithmetic average of values", flawed_rule:"The arithmetic mean is unaffected by extreme observations.", status:"approved"}}, {misconception_id:"MISC_MECHANICAL_OBSERVATION_DIAGNOSTIC_MISCONCEPTION__4F0D16", properties:{kc_id:"148563d0-a40f-533e-88a2-63804d31895a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"mechanical observation: diagnostic misconception 331", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. the use of electronic monitoring to record the actions of the observed", status:"approved", flawed_rule:"Electronic tracking explains the consumer's motives without interpretation."}}, {misconception_id:"MISC_MEDIAN_DIAGNOSTIC_MISCONCEPTION_332_4B223E", properties:{kc_id:"92555a93-04f0-542a-91aa-11b1fa420015", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"median in chapter 6 Critical Thinking Exercises task 3: diagnostic misconception 1686", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Critical Thinking Exercises, task 3. the middle number when all answers are organized from smallest to largest; if an even number of data, the mean of the two middle answers is the median", status:"approved", flawed_rule:"The median is calculated by summing every value and dividing by the count."}}, {misconception_id:"MISC_MODE_DIAGNOSTIC_MISCONCEPTION_333_C0E36E", properties:{kc_id:"3e059c0e-6fe4-5a86-bbf7-25d047cf9dd1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"mode: diagnostic misconception 333", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. the most common response", flawed_rule:"The mode must equal the arithmetic mean.", status:"approved"}}, {misconception_id:"MISC_NONPROBABILITY_SAMPLE_DIAGNOSTIC_MISCONCEPTION_3_6B45E9", properties:{kc_id:"39496417-2e40-5b01-bd63-148f91427472", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"nonprobability sample: diagnostic misconception 334", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a situation which each member of the population has an unknown chance of being selected to be part of the sample", status:"approved", flawed_rule:"Unknown selection probabilities support the same sampling claims as known probabilities."}}, {misconception_id:"MISC_OBSERVATIONAL_RESEARCH_DIAGNOSTIC_MISCONCEPTION__EEFA0A", properties:{kc_id:"9c48cb8e-966f-5724-9ed4-d438074d35c4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"observational research: diagnostic misconception 335", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. data collected by watching consumers and recording actions", status:"approved", flawed_rule:"Observing a purchase directly reveals the customer's private reasoning."}}, {misconception_id:"MISC_ONE_ON_ONE_INTERVIEW_DIAGNOSTIC_MISCONCEPTION_33_EEF955", properties:{kc_id:"b7724d08-b3f7-52e9-b9ce-bc2f39a4778d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"one-on-one interview: diagnostic misconception 336", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. an interview that happens on an individual level between researcher and respondent", status:"approved", flawed_rule:"Individual interviews provide statistically representative results regardless of sampling."}}, {misconception_id:"MISC_PERSONAL_OBSERVATIONS_DIAGNOSTIC_MISCONCEPTION_3_364721", properties:{kc_id:"d28a33d0-dcc4-5131-a1f3-40c39d469370", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"personal observations: diagnostic misconception 337", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. observations that are collected by human recorders", status:"approved", flawed_rule:"Human observers record behavior without interpretation or possible error."}}, {misconception_id:"MISC_PHONE_SURVEYS_DIAGNOSTIC_MISCONCEPTION_338_621410", properties:{kc_id:"7c094c8a-1e87-5f09-8c66-40e2c29a1c3b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"phone surveys: diagnostic misconception 338", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. surveys conducted through the use of a telephone that can be completed through digital or human methods", status:"approved", flawed_rule:"A telephone sampling frame necessarily includes every target customer."}}, {misconception_id:"MISC_PRIMARY_DATA_DIAGNOSTIC_MISCONCEPTION_339_5421FA", properties:{kc_id:"8eeae841-65dc-5d6d-8a4c-c1684efd8f78", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"primary data: diagnostic misconception 339", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. unique information that is collected by the researcher with the current project in mind", status:"approved", flawed_rule:"Any information a researcher encounters for the first time is primary data."}}, {misconception_id:"MISC_PRIVACY_DIAGNOSTIC_MISCONCEPTION_340_4669FC", properties:{kc_id:"47d17271-95b0-56ed-98d6-a7a92c8b7778", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"privacy: diagnostic misconception 340", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.4. maintaining the data of research participants discretely and holding confidentiality", status:"approved", flawed_rule:"Public availability of personal information removes every privacy concern in research."}}, {misconception_id:"MISC_PROBABILITY_SAMPLE_DIAGNOSTIC_MISCONCEPTION_341_289249", properties:{kc_id:"a5e13f61-f90d-52cf-88f6-94218c5edde7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"probability sample: diagnostic misconception 341", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a sample in which everyone has a known chance of being included in the research", status:"approved", flawed_rule:"All probability sampling methods require equal selection probabilities."}}, {misconception_id:"MISC_PROBLEM_DEFINITION_DIAGNOSTIC_MISCONCEPTION_342_A4864B", properties:{kc_id:"7202cdf7-c0de-5e1c-b04a-9fc0da613a1e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"problem definition: diagnostic misconception 342", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. the realization that there is an issue that needs to be addressed", status:"approved", flawed_rule:"The visible business symptom is always the underlying research problem."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_QUALITATIVE_DATA_DIAGNOSTIC_MISCONCEPTION_343_74FFD0", properties:{kc_id:"93159869-691c-5835-80db-281c9afa498a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"qualitative data in chapter 6 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1682", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Applied Marketing Knowledge: Discussion Questions, task 4. data that cannot be distilled into number of responses, such as responses to an interview", status:"approved", flawed_rule:"Open-ended responses have no analytical value because they are not already numerical."}}, {misconception_id:"MISC_QUALITATIVE_RESEARCH_DIAGNOSTIC_MISCONCEPTION_34_27238F", properties:{kc_id:"68654650-018c-5a28-b17f-41fe3d18fb07", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"qualitative research: diagnostic misconception 344", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. data shared through words, descriptions, and open-ended comments", status:"approved", flawed_rule:"Qualitative research estimates population proportions from small purposive samples."}}, {misconception_id:"MISC_QUANTIFY_THE_RESEARCH_DIAGNOSTIC_MISCONCEPTION_3_F29364", properties:{kc_id:"239c5bd1-f5d7-584c-9e38-8f483dd24e21", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"quantify the research: diagnostic misconception 345", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. to take a variety of data and compile it into a quantity that is easily understood", status:"approved", flawed_rule:"Assigning numbers to comments automatically preserves all meaning and context."}}, {misconception_id:"MISC_QUANTITATIVE_DATA_DIAGNOSTIC_MISCONCEPTION_346_64EB10", properties:{kc_id:"43116627-d6d2-5f55-b894-d92df57cb3be", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"quantitative data: diagnostic misconception 346", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. data that can be reduced to number of responses, such as number of responses to each answer on a multiple-choice question", status:"approved", flawed_rule:"Numerical responses are inherently free from measurement bias."}}, {misconception_id:"MISC_QUESTIONNAIRE_DIAGNOSTIC_MISCONCEPTION_347_270E20", properties:{kc_id:"d061ff3f-c4eb-5ede-b1e6-defaed447187", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"questionnaire: diagnostic misconception 347", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. also known as a survey, a series of several questions that can collect a variety of qualitative and quantitative data; can be distributed through several different methods", status:"approved", flawed_rule:"Leading or ambiguous questions do not affect the answers obtained."}}, {misconception_id:"MISC_SAMPLE_DIAGNOSTIC_MISCONCEPTION_348_413BAE", properties:{kc_id:"35f6ed1a-3732-50e5-a86a-20b8e741a969", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"sample: diagnostic misconception 348", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a portion of the entire population that is included in the research", flawed_rule:"A larger sample necessarily represents the correct target population.", status:"approved"}}, {misconception_id:"MISC_SAMPLE_FRAME_DIAGNOSTIC_MISCONCEPTION_349_EF1135", properties:{kc_id:"189e4c13-46a1-5904-bcd0-5f7feefe585b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"sample frame: diagnostic misconception 349", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a parameter that defines who will be included in the sample and who would not be included", status:"approved", flawed_rule:"The sampling frame and the intended population are always identical."}}, {misconception_id:"MISC_SAMPLE_SIZE_DIAGNOSTIC_MISCONCEPTION_350_C16A1E", properties:{kc_id:"58b21048-6c2e-5c4e-aee6-892d513b0998", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"sample size: diagnostic misconception 350", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. the number of respondents that are to be included in the research", status:"approved", flawed_rule:"Increasing sample size cures systematic exclusion of target groups."}}, {misconception_id:"MISC_SAMPLING_UNIT_DIAGNOSTIC_MISCONCEPTION_351_314CE3", properties:{kc_id:"4117649c-eff3-5803-95f9-bc9dd69f03b5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"sampling unit: diagnostic misconception 351", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. each individual entities that is included in the sample", status:"approved", flawed_rule:"The sampling unit is the total number of respondents."}}, {misconception_id:"MISC_SECONDARY_DATA_DIAGNOSTIC_MISCONCEPTION_352_3BA91D", properties:{kc_id:"abad58e6-0843-5813-ba1a-a94dfad0a47b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"secondary data: diagnostic misconception 352", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. any research that was completed, within the organization or outside of the organization, for another purpose", status:"approved", flawed_rule:"Previously collected data are automatically suitable for the current research problem."}}, {misconception_id:"MISC_SIMPLE_RANDOM_SAMPLE_DIAGNOSTIC_MISCONCEPTION_35_331C7E", properties:{kc_id:"53ce8bb0-94a1-591a-b9bd-dbea9c8533c3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"simple random sample: diagnostic misconception 353", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a type of probability sample where every entity has an equal chance of being selected", status:"approved", flawed_rule:"Selecting whichever respondents are easiest to reach is simple random sampling."}}, {misconception_id:"MISC_STRATIFIED_RANDOM_SAMPLE_DIAGNOSTIC_MISCONCEPTIO_F838C7", properties:{kc_id:"750ada4c-3fa1-5000-82fa-b07e72901dc2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"stratified random sample: diagnostic misconception 354", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a probability sample type where the population is divided into groups and then participants are selected from each stratum randomly", status:"approved", flawed_rule:"Stratification means choosing convenient representatives from each group without random selection."}}, {misconception_id:"MISC_SUGGING_DIAGNOSTIC_MISCONCEPTION_355_D6E7A6", properties:{kc_id:"6d54dca7-e891-50ce-b751-a6e86a949f7e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"sugging: diagnostic misconception 355", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.4. suggesting a purchase disguised as research", status:"approved", flawed_rule:"A sales pitch is legitimate research merely because it begins with survey questions."}}, {misconception_id:"MISC_SURVEY_DIAGNOSTIC_MISCONCEPTION_356_BB15CE", properties:{kc_id:"fb9879fb-6081-5b12-8062-1e53e99d183d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"survey in chapter 6 Critical Thinking Exercises task 2: diagnostic misconception 1685", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Critical Thinking Exercises, task 2. also known as a questionnaire, a series of several questions that can collect a variety of qualitative and quantitative data; can be distributed through several different methods", status:"approved", flawed_rule:"Survey answers perfectly reproduce actual purchasing behavior."}}, {misconception_id:"MISC_SYNDICATED_DATA_DIAGNOSTIC_MISCONCEPTION_357_3C4119", properties:{kc_id:"e6da4b75-8e5b-51c4-807c-0c65baea38d9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"syndicated data: diagnostic misconception 357", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a type of secondary data that is available through a subscription service", status:"approved", flawed_rule:"Subscription-based research was necessarily commissioned exclusively for the current question."}}, {misconception_id:"MISC_TARGET_POPULATION_DIAGNOSTIC_MISCONCEPTION_358_98D6B8", properties:{kc_id:"e38d55f1-a6c3-5389-84c6-27565eaa516c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"target population: diagnostic misconception 358", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. the group of people that are of interest for a study", status:"approved", flawed_rule:"Only customers already present in the available database belong to the target population."}}, {misconception_id:"MISC_UNAIDED_AWARENESS_DIAGNOSTIC_MISCONCEPTION_359_B35A9E", properties:{kc_id:"cb0a6af6-a218-5a97-9584-bea4fb9a9cf3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"unaided awareness: diagnostic misconception 359", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. when no prompts or lists of potential products, brands, or companies are given to test awareness", status:"approved", flawed_rule:"Showing respondents a list of brands still measures unaided awareness."}}, {misconception_id:"MISC_UNOBTRUSIVE_OBSERVATION_DIAGNOSTIC_MISCONCEPTION_B9320D", properties:{kc_id:"e944a839-469f-5923-bdfa-a71c9c1935c5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"unobtrusive observation: diagnostic misconception 360", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. a type of observation research where the observed is not aware they are being monitored", status:"approved", flawed_rule:"Observation without participant awareness removes every ethical obligation."}}, {misconception_id:"MISC_VERBATIMS_DIAGNOSTIC_MISCONCEPTION_361_C02666", properties:{kc_id:"02f075ff-c051-5041-9220-d99e7a2c5342", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"verbatims: diagnostic misconception 361", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6 Key Terms, printed page 219, and section 6.3. exact quotations of responses to a qualitative question", status:"approved", flawed_rule:"A researcher's paraphrase is an exact respondent quotation."}}, {misconception_id:"MISC_ADAPTED_GLOBAL_MARKETING_STRATEGY_DIAGNOSTIC_MIS_0A7077", properties:{kc_id:"174c0254-8922-54d7-80e8-66fb5641d4ce", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"adapted global marketing strategy in chapter 7 Critical Thinking Exercises task 1: diagnostic misconception 1698", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Critical Thinking Exercises, task 1. a strategy in which a company utilizes different marketing strategies in different global markets", status:"approved", flawed_rule:"Adaptation requires abandoning all common brand identity across countries."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_BUSINESS_LANDSCAPE_DIAGNOSTIC_MISCONCEPTION_363_EF7A76", properties:{kc_id:"026e26c0-a3f8-5df1-8743-f5fed4c5b72e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"business landscape in chapter 7 Closing Company Case task 1: diagnostic misconception 1704", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Closing Company Case, task 1. everything internal and external to the business, its industry, and its environment", status:"approved", flawed_rule:"A country's market potential depends only on the number of consumers."}}, {misconception_id:"MISC_CONSUMER_INCOME_DIAGNOSTIC_MISCONCEPTION_364_D2B497", properties:{kc_id:"acc47e88-a0aa-5d5c-87b5-c941f49530a5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"consumer income: diagnostic misconception 364", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. the amount of money a household or individual earns", status:"approved", flawed_rule:"Reported income alone shows what consumers can afford after taxes and necessities."}}, {misconception_id:"MISC_CULTURAL_SENSITIVITY_DIAGNOSTIC_MISCONCEPTION_36_C5D802", properties:{kc_id:"d668022a-4d82-5088-9c71-c8297c1a58ab", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"cultural sensitivity in chapter 7 Building Your Personal Brand task 1: diagnostic misconception 1702", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Building Your Personal Brand, task 1. awareness and appreciation of and the ability to adapt to a cultural, ethnic, racial, or another group other than one’s own", status:"approved", flawed_rule:"Translating words is sufficient to understand another market's cultural meaning."}}, {misconception_id:"MISC_CULTURAL_SYMBOLS_DIAGNOSTIC_MISCONCEPTION_366_FBDFAC", properties:{kc_id:"d821409a-d896-514c-a55e-fd2bfb3d1393", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cultural symbols: diagnostic misconception 366", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. physical representations of a culture’s language, values, and traditions", status:"approved", flawed_rule:"A symbol necessarily has the same associations in every country."}}, {misconception_id:"MISC_CULTURAL_VALUES_DIAGNOSTIC_MISCONCEPTION_367_4B7DC9", properties:{kc_id:"f1f1ae40-9481-5af9-b68f-76208c15a093", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cultural values: diagnostic misconception 367", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. unspoken aesthetics, socialization, and religious aspects woven throughout a culture", status:"approved", flawed_rule:"Deeply held cultural values can be inferred from surface appearance alone."}}, {misconception_id:"MISC_CUSTOMS_DIAGNOSTIC_MISCONCEPTION_368_9553BD", properties:{kc_id:"36d8e1b4-8757-5b62-980e-cc1fdfb3cbc5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customs: diagnostic misconception 368", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. mannerisms or behaviors that are considered characteristics within a social system", status:"approved", flawed_rule:"A familiar home-country gesture is appropriate in every business setting."}}, {misconception_id:"MISC_DISCRETIONARY_INCOME_DIAGNOSTIC_MISCONCEPTION_36_51F23D", properties:{kc_id:"d9db235d-d3c3-556a-ba7b-bddbefc9431c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"discretionary income in chapter 12 Critical Thinking Exercises task 1: diagnostic misconception 1787", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12, Critical Thinking Exercises, task 1. a household’s money that is left over after all taxes and necessities are paid", status:"approved", flawed_rule:"Discretionary income is the full amount remaining immediately after taxes."}}, {misconception_id:"MISC_DISPOSABLE_INCOME_DIAGNOSTIC_MISCONCEPTION_370_22C55A", properties:{kc_id:"2923270c-9731-5138-a944-7e22ea0c13db", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"disposable income: diagnostic misconception 370", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. the money individuals and households are left with after paying taxes", status:"approved", flawed_rule:"Disposable income has already deducted all essential living expenses."}}, {misconception_id:"MISC_DUMPING_DIAGNOSTIC_MISCONCEPTION_371_DD39D7", properties:{kc_id:"05ff710d-1284-5dea-a7be-7a73ed87599b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"dumping: diagnostic misconception 371", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.5. the practice in which a company manufactures a very large of number of goods and exports them to a foreign market to see cheaply", status:"approved", flawed_rule:"Any low-priced export is sufficient evidence of every legal element of dumping."}}, {misconception_id:"MISC_ECONOMIC_INFRASTRUCTURE_DIAGNOSTIC_MISCONCEPTION_E372BA", properties:{kc_id:"79b663d4-ab26-59a8-9280-1d4733e8c265", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"economic infrastructure: diagnostic misconception 372", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. the physical facilities of an economy that benefit product and distribution", status:"approved", flawed_rule:"Strong demand offsets any lack of transportation, communication, or distribution infrastructure."}}, {misconception_id:"MISC_EMBARGOES_DIAGNOSTIC_MISCONCEPTION_373_155CCD", properties:{kc_id:"94347d78-9a7e-5289-9b88-400d8353354c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"embargoes: diagnostic misconception 373", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. trading bans on a product with a specific country; imposed between countries that have different political ideologies", status:"approved", flawed_rule:"An embargo is merely an import tax that can be paid to continue unrestricted trade."}}, {misconception_id:"MISC_ETHNOCENTRISM_DIAGNOSTIC_MISCONCEPTION_374_49EAF4", properties:{kc_id:"26a3709b-91f2-59ee-b7e7-6ab473cab113", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"ethnocentrism: diagnostic misconception 374", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.1. an assumption that the business landscape or culture of an international market is the same as the home country or personal culture", status:"approved", flawed_rule:"A successful home-market approach will work abroad without examining cultural differences."}}, {misconception_id:"MISC_EXCHANGE_RATE_DIAGNOSTIC_MISCONCEPTION_375_4C40E9", properties:{kc_id:"12850bea-ffcc-587a-9277-13a4137cc77d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"exchange rate: diagnostic misconception 375", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. the rate at which one country’s currency can be exchanged for that of another country", status:"approved", flawed_rule:"Currency conversion rates cannot change export competitiveness or realized revenue."}}, {misconception_id:"MISC_EXPORTING_DIAGNOSTIC_MISCONCEPTION_376_E22532", properties:{kc_id:"f881cb5a-2fb4-5f4a-b79a-030091429d46", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"exporting in chapter 7 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1695", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Applied Marketing Knowledge: Discussion Questions, task 2. when a firm makes a product or service in one country and sells it in others", status:"approved", flawed_rule:"Exporting necessarily requires owning a production facility in the destination country."}}, {misconception_id:"MISC_FOREIGN_DIRECT_INVESTMENT_FDI_DIAGNOSTIC_MISCONC_72D532", properties:{kc_id:"27f01503-1aed-566b-935f-a882d277ca78", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"foreign direct investment (FDI): diagnostic misconception 377", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.3. the process of establishing operations within a foreign country", status:"approved", flawed_rule:"Selling a few products abroad is equivalent to establishing foreign operations."}}, {misconception_id:"MISC_FRANCHISING_DIAGNOSTIC_MISCONCEPTION_378_D39538", properties:{kc_id:"62a58209-9ac3-5a3d-9658-84be657e0725", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"franchising: diagnostic misconception 378", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.3. a business strategy in which the owner (the franchisor) allows another person or entity (the franchisee) to operate a business using the franchisor’s products, branding, and knowledge in exchange for a fee", status:"approved", flawed_rule:"A franchisee obtains unrestricted ownership of the franchisor's entire brand."}}, {misconception_id:"MISC_GLOBAL_MARKET_OPPORTUNITIES_DIAGNOSTIC_MISCONCEP_3BDBB0", properties:{kc_id:"635ccf6a-bc22-5147-b35a-b2fbf45ba527", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"global market opportunities in chapter 7 Closing Company Case task 4: diagnostic misconception 1707", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Closing Company Case, task 4. conditions that are favorable for a company to expand into the global marketplace", status:"approved", flawed_rule:"Any large foreign population guarantees profitable entry."}}, {misconception_id:"MISC_INTERNATIONAL_FIRM_DIAGNOSTIC_MISCONCEPTION_380_2F838D", properties:{kc_id:"443baaf5-1075-51f8-a69b-530c7da52301", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"international firm in chapter 7 Closing Company Case task 3: diagnostic misconception 1706", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Closing Company Case, task 3. a company that operates on a global level regardless of intensity of involvement", status:"approved", flawed_rule:"All firms operating internationally allow the same degree of local autonomy."}}, {misconception_id:"MISC_JOINT_VENTURE_DIAGNOSTIC_MISCONCEPTION_381_E263C2", properties:{kc_id:"b1dec21f-9b10-55b9-9f8d-1ecc68cec9d7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"joint venture: diagnostic misconception 381", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.3. a business arrangement whereby two or more companies create a single enterprise or project", status:"approved", flawed_rule:"A joint venture is simply a supplier contract without a shared enterprise."}}, {misconception_id:"MISC_LICENSING_DIAGNOSTIC_MISCONCEPTION_382_3BED5D", properties:{kc_id:"6fa572ba-6b4a-5160-ba4a-cbfffe73050f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"licensing: diagnostic misconception 382", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.3. a contract in which one organization permits another to use its name brand or trademark on its own items", status:"approved", flawed_rule:"Licensing transfers unrestricted ownership of the licensor's intellectual property."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_OUTSOURCING_DIAGNOSTIC_MISCONCEPTION_384_0F8CFA", properties:{kc_id:"3a166e6d-8389-54c4-a153-a9aceabed64d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"outsourcing: diagnostic misconception 384", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.5. Contracting activities to an external provider. In section 7.5 the textbook focuses on moving operations to a foreign country; distinguish this international example from the broader outsourcing concept rather than treating outsourcing and offshoring as synonyms.", status:"approved", flawed_rule:"Outsourcing and moving work overseas are always the same decision."}}, {misconception_id:"MISC_PRODUCT_ADAPTATION_DIAGNOSTIC_MISCONCEPTION_385_6683E3", properties:{kc_id:"4de2ee2d-7654-52d6-8a95-412696fcdb59", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product adaptation in chapter 7 Critical Thinking Exercises task 2: diagnostic misconception 1699", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Critical Thinking Exercises, task 2. when companies modify products to align with the local culture", status:"approved", flawed_rule:"A product can only be adapted by translating its advertising."}}, {misconception_id:"MISC_PRODUCT_INVENTION_DIAGNOSTIC_MISCONCEPTION_386_1F62D3", properties:{kc_id:"1add9f93-b5e2-5045-9a13-41a47faab372", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product invention: diagnostic misconception 386", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.4. when companies create entirely new products for a global market", status:"approved", flawed_rule:"Product invention is selling an unchanged domestic product abroad."}}, {misconception_id:"MISC_PURCHASING_POWER_DIAGNOSTIC_MISCONCEPTION_387_47323C", properties:{kc_id:"ddb97efc-4030-53da-ab73-effcb514650c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"purchasing power: diagnostic misconception 387", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. the goods that can be purchased with one unit of currency", status:"approved", flawed_rule:"Identical nominal incomes purchase identical baskets of goods in every country."}}, {misconception_id:"MISC_QUOTAS_DIAGNOSTIC_MISCONCEPTION_388_4F6AF5", properties:{kc_id:"f4467a04-62cf-5228-91d2-63f36d5179f8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"quotas: diagnostic misconception 388", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. maximum allowable units (usually in currency) to be imported into or exported out of a specific country", flawed_rule:"A quota is a tax rate rather than a limit on permitted trade volume or value.", status:"approved"}}, {misconception_id:"MISC_RISK_DIAGNOSTIC_MISCONCEPTION_389_EDEA48", properties:{kc_id:"82b4ba25-cc5d-5446-a968-17c7b6c9c7cd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"risk: diagnostic misconception 389", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.1. any situation or condition that leads a company to decreased profits or even failure", flawed_rule:"International expansion always reduces risk without adding new exposures.", status:"approved"}}, {misconception_id:"MISC_SOCIOCULTURAL_FACTORS_DIAGNOSTIC_MISCONCEPTION_3_EC77B9", properties:{kc_id:"166877e9-7e11-57bc-b5ff-27210453b2ca", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sociocultural factors in chapter 7 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1696", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Applied Marketing Knowledge: Discussion Questions, task 3. values, behaviors, culture, lifestyle, and language that shape a person’s or group’s way of living", status:"approved", flawed_rule:"Only formal laws affect international marketing; language and values do not."}}, {misconception_id:"MISC_STANDARDIZED_GLOBAL_MARKETING_STRATEGY_DIAGNOSTI_E03732", properties:{kc_id:"1899183b-4605-55bb-8f62-cc32363db96d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"standardized global marketing strategy in chapter 7 Critical Thinking Exercises task 4: diagnostic misconception 1701", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7, Critical Thinking Exercises, task 4. a strategy in which a company uses the same marketing strategy in all markets", status:"approved", flawed_rule:"A single global campaign is always optimal regardless of local differences."}}, {misconception_id:"MISC_STEREOTYPES_DIAGNOSTIC_MISCONCEPTION_392_213A5D", properties:{kc_id:"5103ddd5-b021-52f7-8999-794d84843b94", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"stereotypes: diagnostic misconception 392", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. oversimplified images, perceptions, or ideas of a person or group", status:"approved", flawed_rule:"Group-level cultural patterns accurately describe every individual in that group."}}, {misconception_id:"MISC_STRAIGHT_PRODUCT_EXTENSION_DIAGNOSTIC_MISCONCEPT_45F97F", properties:{kc_id:"dfe255c0-5cc5-56a3-b2a9-b1e6d7c8f8bf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"straight product extension: diagnostic misconception 393", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.4. a strategy that entails maintaining the same product for both the home and foreign markets", status:"approved", flawed_rule:"Straight extension requires redesigning the product for each foreign market."}}, {misconception_id:"MISC_STRATEGIC_ALLIANCE_DIAGNOSTIC_MISCONCEPTION_394_3FAF1C", properties:{kc_id:"6eea3dd4-0e5f-57a4-931f-b020896e4502", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"strategic alliance: diagnostic misconception 394", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.3. when two companies from different countries agree to invest resources in a mutually beneficial way", status:"approved", flawed_rule:"Every strategic alliance requires creating a jointly owned new company."}}, {misconception_id:"MISC_TARIFFS_DIAGNOSTIC_MISCONCEPTION_395_B22752", properties:{kc_id:"e3703853-144f-5fd1-8c5d-d2a9d0406923", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"tariffs: diagnostic misconception 395", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. taxes that governments impose on imports into the country", status:"approved", flawed_rule:"Tariffs prohibit all imports from the affected country."}}, {misconception_id:"MISC_TRADE_BLOCS_DIAGNOSTIC_MISCONCEPTION_396_969389", properties:{kc_id:"1825c091-b5e2-5541-80b4-f535feaaeb5b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"trade blocs: diagnostic misconception 396", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. intergovernmental agreements that remove barriers to trade within regions of the world", status:"approved", flawed_rule:"Membership in a trade bloc eliminates every regulatory and cultural difference."}}, {misconception_id:"MISC_TRANSNATIONAL_FIRM_DIAGNOSTIC_MISCONCEPTION_397_E50760", properties:{kc_id:"69bac3e2-a54a-5fb6-9b1a-ffeaf1876ccd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"transnational firm: diagnostic misconception 397", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.3. a company that allows for a higher degree of localization", status:"approved", flawed_rule:"A transnational firm must impose identical local operations in every country."}}, {misconception_id:"MISC_WHOLE_CHANNEL_DIAGNOSTIC_MISCONCEPTION_398_46B41B", properties:{kc_id:"3395ae4d-1d07-5b43-9315-5f495e7891f4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"whole channel: diagnostic misconception 398", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.4. the design of the international channels that incorporates all members, including the manufacturing, retailer, and wholesaler sites as well as transportation", status:"approved", flawed_rule:"International distribution analysis can stop at the national border."}}, {misconception_id:"MISC_ACCULTURATION_DIAGNOSTIC_MISCONCEPTION_399_E3E90C", properties:{kc_id:"16c7f61a-3b69-5d86-82c0-026b73cc8191", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"acculturation: diagnostic misconception 399", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.4. the process by which a person’s family cultural patterns change because of direct and constant contact with a different culture", status:"approved", flawed_rule:"Contact with another culture necessarily erases a person's original cultural identity."}}, {misconception_id:"MISC_ADAPTATION_DIAGNOSTIC_MISCONCEPTION_400_01969B", properties:{kc_id:"141da85a-090a-53e0-bccb-680c443e08a3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"adaptation: diagnostic misconception 400", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.1. the process of adjusting a company’s work efforts, goods, or services in response to specific needs, tastes, or expectations—whether real or perceived—from different groups of consumers", status:"approved", flawed_rule:"Adaptation is achieved by changing spokesperson appearance while ignoring product and service needs."}}, {misconception_id:"MISC_ASIAN_POPULATION_DIAGNOSTIC_MISCONCEPTION_401_332CEA", properties:{kc_id:"0be3db89-d538-5267-b3ac-45ad2bd246c4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"Asian population: diagnostic misconception 401", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.4. third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_BLACK_POPULATION_DIAGNOSTIC_MISCONCEPTION_402_9B9589", properties:{kc_id:"853a393d-8af8-57e2-88cd-dc880ebd979c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"Black population: diagnostic misconception 402", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.4. second largest multicultural group in the United States; made up of three different subethnicities: single race, Black Hispanic, or Black mixed with another race (White or Native American)", status:"approved", flawed_rule:"Black consumers share a single ancestry, identity, and purchasing pattern."}}, {misconception_id:"MISC_COMPANY_CENTRIC_DIAGNOSTIC_MISCONCEPTION_403_769AE2", properties:{kc_id:"b90716c0-79b0-5989-a5cd-1996053edb0c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"company centric: diagnostic misconception 403", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.2. a company’s approach to focusing decisions and execution from the perspective of the organization rather than the customers", status:"approved", flawed_rule:"A company-centric decision is necessarily based on direct evidence of customer needs."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_CONSUMERS_WITH_DISABILITIES_DIAGNOSTIC_MISCONCEP_1A7F38", properties:{kc_id:"51f342d2-873a-5508-b205-1a14603df105", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"consumers with disabilities: diagnostic misconception 404", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.5. sociodemographic group living with some type of disability related to mobility, learning, intellectual, or other types of functions; a very diverse group because disabilities span cultural, social, and demographic factors", status:"approved", flawed_rule:"One accessibility adjustment serves all types of disability equally well."}}, {misconception_id:"MISC_CULTURAL_DUALITY_DIAGNOSTIC_MISCONCEPTION_405_4FAA92", properties:{kc_id:"8049f377-86ef-5f96-93d3-505bcc697023", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cultural duality: diagnostic misconception 405", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.4. characteristic of a multicultural individual for whom cultures overlap with each other and the person feels a sense of belonging to both at the same time", status:"approved", flawed_rule:"A person can meaningfully belong to only one culture at a time."}}, {misconception_id:"MISC_CULTURAL_IDENTITY_DIAGNOSTIC_MISCONCEPTION_406_2A5B71", properties:{kc_id:"df05515c-e57f-5748-aac0-2c47bea42c0d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cultural identity: diagnostic misconception 406", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.4. how a person identifies with a given culture, ethnicity, or social group, which instills a sense of belonging that influences personal thinking and actions", status:"approved", flawed_rule:"Marketers can assign cultural identity solely from a person's appearance."}}, {misconception_id:"MISC_CUSTOMER_CENTRIC_DIAGNOSTIC_MISCONCEPTION_408_4DB883", properties:{kc_id:"8b9cb2da-2649-5c88-bbc5-ddc4659f0f11", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer centric: diagnostic misconception 408", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.2. a company’s focus on putting targeted customers first regarding any decisions about its goods, services, or experiences to create satisfaction and strengthen loyalty", status:"approved", flawed_rule:"Customer-centric marketing means maximizing internal convenience regardless of user experience."}}, {misconception_id:"MISC_DIVERSITY_MARKETING_DIAGNOSTIC_MISCONCEPTION_409_734E10", properties:{kc_id:"46757a5a-8e38-5b16-af90-c5573b2e1823", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"diversity marketing in chapter 8 Closing Company Case task 3: diagnostic misconception 1720", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8, Closing Company Case, task 3. a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_DIVERSITY_MARKETING_INTELLIGENCE_DMIQ_DIAGNOSTIC_CB00A1", properties:{kc_id:"73448d58-09a7-501d-b170-71619ac5f928", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"diversity marketing intelligence (DMiQ) in chapter 8 Critical Thinking Exercises task 2: diagnostic misconception 1714", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8, Critical Thinking Exercises, task 2. the capability of identifying, accepting, and valuing the diverseness of consumers within a market and using this knowledge to tailor the marketing mix accordingly", status:"approved", flawed_rule:"Population labels alone provide sufficient knowledge to tailor marketing responsibly."}}, {misconception_id:"MISC_GENERATIONAL_POPULATION_DIAGNOSTIC_MISCONCEPTION_740EB5", properties:{kc_id:"39613f35-205a-5f51-9c61-dc9f25617d97", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"generational population: diagnostic misconception 411", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.2. sociodemographic category based on birth year clusters that includes Lost Generation (1883–1900), Greatest Generation (1901–1927), Traditionalist/Silent Generation (1928–1945), baby boomers (1946–1964), Generation X (1965–1980), millennials/Generation Y (1981–1996), Zoomers/ Generation Z (1997–2009), and Generation Alpha (2010–2024)", status:"approved", flawed_rule:"Birth-year cohorts determine every individual's attitudes and buying behavior."}}, {misconception_id:"MISC_HISPANIC_POPULATION_DIAGNOSTIC_MISCONCEPTION_412_BF396F", properties:{kc_id:"6636f717-49ab-571e-9cbb-7775ee71ec55", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"Hispanic population: diagnostic misconception 412", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.4. largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe", status:"approved", flawed_rule:"Hispanic identity implies one race, nationality, or level of Spanish-language preference."}}, {misconception_id:"MISC_LGBTQIA_POPULATION_DIAGNOSTIC_MISCONCEPTION_413_4023C0", properties:{kc_id:"4b0a308b-45ef-52b3-a32c-e2366dd82b40", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"LGBTQIA+ population: diagnostic misconception 413", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.5. community composed of individuals who express a diversity of genders, preferences, and sexual orientations that include lesbian, gay, bisexual, transsexual, queer/questioning, intersex, asexual, and other sexual identities", status:"approved", flawed_rule:"All LGBTQIA+ customers have identical identities, needs, and purchase preferences."}}, {misconception_id:"MISC_MARGINALIZED_CONSUMERS_DIAGNOSTIC_MISCONCEPTION__CD8112", properties:{kc_id:"d8381db9-a946-56d8-a004-d7766e1d48a2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"marginalized consumers in chapter 8 Building Your Personal Brand task 1: diagnostic misconception 1716", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8, Building Your Personal Brand, task 1. populations of consumers that have been pushed to the margins of society and are often excluded in mainstream advertising", status:"approved", flawed_rule:"Being overlooked by mainstream advertising means having no relevant customer needs."}}, {misconception_id:"MISC_MULTICULTURAL_IDENTITY_DIAGNOSTIC_MISCONCEPTION__5D018A", properties:{kc_id:"38c6db16-03d4-55f7-9ebc-ad765114c277", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"multicultural identity in chapter 8 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1709", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8, Applied Marketing Knowledge: Discussion Questions, task 2. having an affinity with multiple racial or ethnic groups that a person has been exposed to and self-categorizing as being part of more than one of them", status:"approved", flawed_rule:"Multiple cultural affiliations are mutually exclusive."}}, {misconception_id:"MISC_MULTICULTURAL_MARKETING_DIAGNOSTIC_MISCONCEPTION_24C6B4", properties:{kc_id:"f579e00b-735a-569a-bc61-9c91a5e5844f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"multicultural marketing in chapter 8 Closing Company Case task 1: diagnostic misconception 1718", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8, Closing Company Case, task 1. a subcategory of diversity marketing aimed at intentionally targeting audiences based on different racial, ethnic, and cultural identities and backgrounds", status:"approved", flawed_rule:"Multicultural marketing merely translates the same advertisement into another language."}}, {misconception_id:"MISC_NATIVE_AMERICAN_ALASKA_NATIVE_POPULATION_DIAGNOS_9F0F56", properties:{kc_id:"38cc3a7f-34ba-57e6-aebf-96a78e6b01db", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"Native American, Alaska Native population: diagnostic misconception 418", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.2. multicultural group of individuals of a single race and mixed races who are native to the United States and its territories including American Indians, Alaska Natives, Native Hawaiians, and American Samoans", status:"approved", flawed_rule:"Distinct Indigenous nations and communities share one interchangeable culture."}}, {misconception_id:"MISC_SOCIODEMOGRAPHIC_MARKETING_DIAGNOSTIC_MISCONCEPT_CFC9EE", properties:{kc_id:"4cff5761-924e-50d8-81e4-61e349e4d203", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sociodemographic marketing in chapter 8 What Do Marketers Do? task 1: diagnostic misconception 1717", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8, What Do Marketers Do?, task 1. a subcategory of diversity marketing aimed at intentionally targeting audiences based on shared social and demographic characteristics such as gender and sexual orientation, age or generation, family structure, religion, education, income level, and disability", status:"approved", flawed_rule:"Sociodemographic marketing considers ethnicity alone."}}, {misconception_id:"MISC_SOCIODEMOGRAPHICS_DIAGNOSTIC_MISCONCEPTION_420_123440", properties:{kc_id:"d1a6a173-fc50-5b3f-91f7-4b578c9577ac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sociodemographics in chapter 8 Closing Company Case task 4: diagnostic misconception 1721", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8, Closing Company Case, task 4. the combination of social and demographic factors that characterize specific consumer groups in the market", status:"approved", flawed_rule:"Social and demographic categories are separate and never intersect."}}, {misconception_id:"MISC_SOCIOECONOMICALLY_DISADVANTAGED_POPULATION_DIAGN_75556C", properties:{kc_id:"24bba33b-a66e-5a80-839f-d8b001d15c76", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"socioeconomically disadvantaged population: diagnostic misconception 421", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.2. disadvantaged community that lacks social resources and infrastructure to reduce poverty; members tend to be in low-income households, experience financial insecurity, and have less access to education", status:"approved", flawed_rule:"Limited income implies uniform tastes and eliminates meaningful consumer agency."}}, {misconception_id:"MISC_STANDARDIZATION_DIAGNOSTIC_MISCONCEPTION_422_41F613", properties:{kc_id:"cf4c21e3-348a-541a-aa69-ea9461288995", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"standardization: diagnostic misconception 422", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.1. the process of purposefully applying identical or consistent guidelines to goods or services to achieve uniformity", status:"approved", flawed_rule:"Standardization guarantees customer fit even when groups have different requirements."}}, {misconception_id:"MISC_TOKENISM_DIAGNOSTIC_MISCONCEPTION_423_CC366C", properties:{kc_id:"d12b7ffd-523b-59ca-abeb-4be80206d0b4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"tokenism: diagnostic misconception 423", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.6. the practice of including an individual from either a minority group or an underrepresented community in marketing efforts simply as a symbol", status:"approved", flawed_rule:"Including one minority spokesperson proves substantive organizational inclusion."}}, {misconception_id:"MISC_ACTUAL_PRODUCT_DIAGNOSTIC_MISCONCEPTION_424_5DCFBB", properties:{kc_id:"7e818c27-a8b1-5b37-b16b-82342b65e0e1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"actual product in chapter 9 Closing Company Case task 1: diagnostic misconception 1740", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Closing Company Case, task 1. product available for purchase", status:"approved", flawed_rule:"The actual product is the underlying benefit alone, without tangible features or design."}}, {misconception_id:"MISC_AUGMENTED_PRODUCT_DIAGNOSTIC_MISCONCEPTION_425_9F0CEE", properties:{kc_id:"4e22a903-0c7f-5818-95bc-288741d57573", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"augmented product: diagnostic misconception 425", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. product having unseen aspects essential to customers", status:"approved", flawed_rule:"After-sales support and warranties cannot be part of the product offering."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_BRAND_DIAGNOSTIC_MISCONCEPTION_426_77E52F", properties:{kc_id:"e7e83723-60b0-50be-93e6-53f057ab3926", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"brand in chapter 9 Building Your Personal Brand task 1: diagnostic misconception 1735", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Building Your Personal Brand, task 1. an intangible asset with tangible value; made up of promotion efforts and customer meaning", status:"approved", flawed_rule:"A brand is only its logo and has no accumulated customer meaning."}}, {misconception_id:"MISC_BRAND_ENGAGEMENT_DIAGNOSTIC_MISCONCEPTION_427_CF31DA", properties:{kc_id:"e7ecbb75-5cf7-55e0-a74e-53c6105f7743", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"brand engagement: diagnostic misconception 427", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. measure of how deeply the customer identifies emotionally with a brand", status:"approved", flawed_rule:"Exposure to a brand automatically demonstrates emotional involvement."}}, {misconception_id:"MISC_BRAND_EQUITY_DIAGNOSTIC_MISCONCEPTION_428_D98F76", properties:{kc_id:"649c0ea7-fa07-5f9a-aca1-500125c49435", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"brand equity: diagnostic misconception 428", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. the additional value that a brand has over a substitute", status:"approved", flawed_rule:"Brand equity is identical to current sales revenue."}}, {misconception_id:"MISC_BRAND_EXTENSIONS_DIAGNOSTIC_MISCONCEPTION_429_5AAD11", properties:{kc_id:"e8da8bec-9f05-51b9-b9d5-90c75b70af24", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"brand extensions: diagnostic misconception 429", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. products that leverage the brand name to new product categories", status:"approved", flawed_rule:"A new flavor within the same product category is necessarily a brand extension into a new category."}}, {misconception_id:"MISC_BRAND_LIFT_DIAGNOSTIC_MISCONCEPTION_430_531453", properties:{kc_id:"eeee4bbc-a9b5-547f-a7f9-b4b963e5c148", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"brand lift: diagnostic misconception 430", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. measure of customer and noncustomer perception of a product over time", status:"approved", flawed_rule:"A one-time count of impressions establishes improvement in brand perceptions."}}, {misconception_id:"MISC_BRAND_NAME_DIAGNOSTIC_MISCONCEPTION_431_160F20", properties:{kc_id:"900ab1d9-3129-5fc7-bd85-4e76e70fe37c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"brand name in chapter 9 Closing Company Case task 4: diagnostic misconception 1743", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Closing Company Case, task 4. the official name of a brand", status:"approved", flawed_rule:"Choosing a brand name alone completes brand development."}}, {misconception_id:"MISC_BRAND_POSITIONING_DIAGNOSTIC_MISCONCEPTION_432_3BCFC6", properties:{kc_id:"9184cd97-0f28-55e4-a6f5-55d14d17c37c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"brand positioning: diagnostic misconception 432", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. the way a brand signals emotions in consumers’ minds", status:"approved", flawed_rule:"Brand positioning is determined exclusively by management intention, regardless of customer perception."}}, {misconception_id:"MISC_BRAND_PREFERENCE_DIAGNOSTIC_MISCONCEPTION_433_EB2F69", properties:{kc_id:"828292d6-bd8c-5dc4-a252-9f8f16434fac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"brand preference: diagnostic misconception 433", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. measure of the degree to which a brand is preferred over others in the category", status:"approved", flawed_rule:"Knowing a brand's name proves the consumer prefers it to alternatives."}}, {misconception_id:"MISC_BRAND_VALUE_DIAGNOSTIC_MISCONCEPTION_434_1B483D", properties:{kc_id:"cab5bc19-e138-5409-947a-72cab12b6514", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"brand value in chapter 9 Critical Thinking Exercises task 3: diagnostic misconception 1734", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Critical Thinking Exercises, task 3. the financial asset associated with a brand", status:"approved", flawed_rule:"The financial value of a brand equals the cost of designing its logo."}}, {misconception_id:"MISC_BRANDING_DIAGNOSTIC_MISCONCEPTION_435_D5C043", properties:{kc_id:"498f33cc-51a3-5f5a-b39a-69c83b335b70", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"branding: diagnostic misconception 435", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. the process of developing a brand", status:"approved", flawed_rule:"Branding ends when the company registers a name."}}, {misconception_id:"MISC_CAPITAL_ITEMS_DIAGNOSTIC_MISCONCEPTION_436_E37B5E", properties:{kc_id:"1a199f95-54ee-56ab-b4d7-2beb6f73e72f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"capital items: diagnostic misconception 436", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. assets valuable to a business that also have tangible value", status:"approved", flawed_rule:"Equipment used for years is a disposable production input."}}, {misconception_id:"MISC_CO_BRAND_DIAGNOSTIC_MISCONCEPTION_437_CC7906", properties:{kc_id:"7b9cd7b4-260b-5a4b-a131-d6fe53f05c2d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"co-brand: diagnostic misconception 437", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. to bring the equity of two brands together for greater value", status:"approved", flawed_rule:"Putting two brand names together guarantees positive value without considering fit."}}, {misconception_id:"MISC_CONVENIENCE_PRODUCTS_DIAGNOSTIC_MISCONCEPTION_43_D13077", properties:{kc_id:"01cc6a2f-1fd2-5284-82b6-8f822c50b0a1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"convenience products: diagnostic misconception 438", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. products that consumers can purchase easily, quickly, and without a lot of thoughtful decision-making", status:"approved", flawed_rule:"A convenience product requires extensive comparison and exceptional search effort."}}, {misconception_id:"MISC_CORE_PRODUCT_DIAGNOSTIC_MISCONCEPTION_439_9DD792", properties:{kc_id:"0b64f3cc-3226-53a6-a2a6-6d6432659f3a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"core product: diagnostic misconception 439", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. product solution that the customer is actually buying: convenience, ego, ease, flexibility, etc.", status:"approved", flawed_rule:"The core product is just the physical object rather than the benefit customers seek."}}, {misconception_id:"MISC_COST_OF_GOODS_SOLD_DIAGNOSTIC_MISCONCEPTION_440_8AC5FD", properties:{kc_id:"4da3b2ad-01d6-534a-ac6a-90757267d524", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cost of goods sold: diagnostic misconception 440", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. expenses directly attributable to the product or service", status:"approved", flawed_rule:"All administrative and marketing expenses belong to cost of goods sold."}}, {misconception_id:"MISC_CRADLE_TO_CRADLE_PACKAGING_DESIGN_DIAGNOSTIC_MIS_AC54CC", properties:{kc_id:"52112a5d-5600-5e86-8372-6e84d65de281", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"cradle-to-cradle packaging design in chapter 9 Applied Marketing Knowledge: Discussion Questions task 8: diagnostic misconception 1729", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Applied Marketing Knowledge: Discussion Questions, task 8. product design that eliminates waste from the life cycle of package", status:"approved", flawed_rule:"Calling packaging recyclable proves its materials actually remain in a closed loop."}}, {misconception_id:"MISC_CUSTOMER_EXPERIENCE_DIAGNOSTIC_MISCONCEPTION_442_B99980", properties:{kc_id:"23b82e2a-0751-5d6b-a619-d96286a48103", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer experience: diagnostic misconception 442", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. the overarching impression that customers have of a brand", status:"approved", flawed_rule:"Customer experience consists only of the moment of payment."}}, {misconception_id:"MISC_DECLINE_STAGE_DIAGNOSTIC_MISCONCEPTION_443_AA9754", properties:{kc_id:"2bb5f0d6-2f2f-5110-ae24-8fff4bf82cac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"decline stage: diagnostic misconception 443", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. part of the product life cycle characterized by a significant decrease in sales and profitability", status:"approved", flawed_rule:"A sales decline always requires immediate discontinuation regardless of remaining profitability."}}, {misconception_id:"MISC_DIVEST_DIAGNOSTIC_MISCONCEPTION_444_1A5D2E", properties:{kc_id:"ffca6ed0-3009-5c50-b278-e62c24594f2e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"divest: diagnostic misconception 444", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. to sell a brand or discontinue a product to protect a portfolio", flawed_rule:"Divesting and reducing discretionary expenditure while continuing sales are the same action.", status:"approved"}}, {misconception_id:"MISC_GROSS_PROFIT_MARGIN_DIAGNOSTIC_MISCONCEPTION_445_8B5DB2", properties:{kc_id:"5e54afb4-a591-550e-9328-7eb5ddf96656", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"gross profit margin: diagnostic misconception 445", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. Revenue minus cost of goods sold, divided by revenue and expressed as a percentage. Gross profit precedes other operating expenses; it is not profit before all costs.", status:"approved", flawed_rule:"Gross margin deducts every operating expense and tax from revenue."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_GROWTH_STAGE_DIAGNOSTIC_MISCONCEPTION_446_2D79B1", properties:{kc_id:"a2c22f52-e7f0-5d29-a049-bf0cdc8691bf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"growth stage in chapter 9 Closing Company Case task 3: diagnostic misconception 1742", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Closing Company Case, task 3. part of the product life cycle characterized by increasing sales; stage when copycat brands may enter the market", status:"approved", flawed_rule:"Sales growth guarantees that no new competitors will enter."}}, {misconception_id:"MISC_HARD_CORE_LOYALS_DIAGNOSTIC_MISCONCEPTION_447_D94D11", properties:{kc_id:"e575d819-0c23-5fd1-8af9-5cd269ea6c38", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"hard-core loyals: diagnostic misconception 447", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. tried-and-true customers who will generally only purchase one brand in a category", status:"approved", flawed_rule:"A customer who routinely alternates among three brands is loyal to only one."}}, {misconception_id:"MISC_HARVEST_DIAGNOSTIC_MISCONCEPTION_448_34F544", properties:{kc_id:"1fca48e8-0b29-5135-ba2e-39d0e322e479", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"harvest: diagnostic misconception 448", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. to reduce all unnecessary expenses to retain any remaining revenue", status:"approved", flawed_rule:"Harvesting means increasing investment to accelerate category growth."}}, {misconception_id:"MISC_INTRODUCTION_STAGE_DIAGNOSTIC_MISCONCEPTION_449_B95202", properties:{kc_id:"75ea2e8d-d5c5-54ad-ae36-0e36252e7ab2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"introduction stage: diagnostic misconception 449", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. part of the product life cycle when consumer awareness is building and sales are starting to grow", status:"approved", flawed_rule:"A newly launched product immediately achieves mature awareness and maximum profitability."}}, {misconception_id:"MISC_LICENSED_BRANDS_DIAGNOSTIC_MISCONCEPTION_450_822A16", properties:{kc_id:"0ac8a4bb-3631-5207-87c4-d0b88609612f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"licensed brands: diagnostic misconception 450", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. brands that provide the likeness of their brand as a fee for use", status:"approved", flawed_rule:"A licensee owns the brand outright after paying a licensing fee."}}, {misconception_id:"MISC_LINE_EXTENSIONS_DIAGNOSTIC_MISCONCEPTION_451_582474", properties:{kc_id:"2b442559-94d2-59d0-bf1d-7af763abe67f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"line extensions: diagnostic misconception 451", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. products that create new opportunities for an existing product and brand", status:"approved", flawed_rule:"A line extension always introduces a wholly unrelated product category."}}, {misconception_id:"MISC_MANUFACTURED_MATERIALS_AND_PARTS_DIAGNOSTIC_MISC_616698", properties:{kc_id:"87c4bc3e-b986-54e0-9763-98672c672955", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"manufactured materials and parts: diagnostic misconception 452", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. products used to create a product", status:"approved", flawed_rule:"Manufactured components are the same as unprocessed raw materials."}}, {misconception_id:"MISC_MARKET_MODIFICATION_DIAGNOSTIC_MISCONCEPTION_453_6C8EE7", properties:{kc_id:"25c7ccc4-c587-5c97-a4ff-09cdf5990818", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"market modification: diagnostic misconception 453", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. an extension of a product to new customers", status:"approved", flawed_rule:"Market modification necessarily changes the product's physical design."}}, {misconception_id:"MISC_MATURITY_STAGE_DIAGNOSTIC_MISCONCEPTION_454_F41FBA", properties:{kc_id:"e40bcb39-b12f-5855-bec4-2184d9463907", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"maturity stage: diagnostic misconception 454", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. part of the product life cycle when sales growth slows and profitability levels off", status:"approved", flawed_rule:"Maturity means demand disappears and all sales cease."}}, {misconception_id:"MISC_MULTIBRANDS_DIAGNOSTIC_MISCONCEPTION_455_BAB0BF", properties:{kc_id:"47b5f693-2009-50e8-ba71-b77f9b7a7813", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"multibrands: diagnostic misconception 455", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. new brand names within a company’s existing product category", status:"approved", flawed_rule:"Multibranding means selling every product under a single brand name."}}, {misconception_id:"MISC_NATIONAL_BRANDS_DIAGNOSTIC_MISCONCEPTION_456_1E2B38", properties:{kc_id:"fe6e9880-3e2c-53d6-a566-ab779e1a9aed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"national brands: diagnostic misconception 456", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. name brands that sell a product or service under its corporate name and identity", status:"approved", flawed_rule:"A national brand is the retailer's own private label."}}, {misconception_id:"MISC_NET_PROFIT_MARGIN_DIAGNOSTIC_MISCONCEPTION_457_6C74FD", properties:{kc_id:"4b2adbfd-bc14-5137-8237-d1934de32245", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"net profit margin: diagnostic misconception 457", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. Net profit after relevant expenses divided by revenue, expressed as a percentage; distinguish this from gross profit margin, which subtracts cost of goods sold before other expenses.", status:"approved", flawed_rule:"Net margin is revenue before any costs are deducted."}}, {misconception_id:"MISC_NEW_BRANDS_DIAGNOSTIC_MISCONCEPTION_458_F15AFB", properties:{kc_id:"95574868-fbab-50b2-82cb-22b74e134b06", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"new brands: diagnostic misconception 458", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. an entirely different brand entity from a parent company", status:"approved", flawed_rule:"A new brand is merely a new package size under the same existing name."}}, {misconception_id:"MISC_PRIVATE_LABEL_BRANDS_DIAGNOSTIC_MISCONCEPTION_45_A99DB8", properties:{kc_id:"16c34e68-d74b-58d6-9212-484d0ee0ee0e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"private-label brands: diagnostic misconception 459", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. store brands that are similar products to a national brand and labeled privately", status:"approved", flawed_rule:"Private labels must always be inferior to manufacturer brands."}}, {misconception_id:"MISC_PRODUCT_ITEM_DIAGNOSTIC_MISCONCEPTION_460_25EFAB", properties:{kc_id:"4a327727-32c5-565b-94cf-c50040c8dcce", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product item: diagnostic misconception 460", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.2. a particular good that a company sells", status:"approved", flawed_rule:"A product item is the firm's complete portfolio."}}, {misconception_id:"MISC_PRODUCT_LIFE_CYCLE_DIAGNOSTIC_MISCONCEPTION_461_5A2AAB", properties:{kc_id:"ba05d445-c2f8-593a-afb7-3b7f1f0c90b9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product life cycle in chapter 9 What Do Marketers Do? task 1: diagnostic misconception 1736", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, What Do Marketers Do?, task 1. the stages a product goes through, tracking its sales and profitability", status:"approved", flawed_rule:"Every product follows identical stage lengths and a predictable calendar."}}, {misconception_id:"MISC_PRODUCT_LINE_DIAGNOSTIC_MISCONCEPTION_462_846753", properties:{kc_id:"c5563509-3aed-547f-9584-a28a378574f5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product line in chapter 9 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1724", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Applied Marketing Knowledge: Discussion Questions, task 3. a set of products that are similar or complementary", status:"approved", flawed_rule:"A product line includes every unrelated category the company sells."}}, {misconception_id:"MISC_PRODUCT_LINE_DEPTH_DIAGNOSTIC_MISCONCEPTION_463_2F269A", properties:{kc_id:"bd4e8900-9431-58ce-84ca-13f9f835a4a9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product line depth: diagnostic misconception 463", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.2. The number of products or variants within a line, distinct from product-mix width, which counts separate lines; interpret using the chapter’s assortment examples.", status:"approved", flawed_rule:"Line depth counts the number of distinct product lines in the portfolio."}}, {misconception_id:"MISC_PRODUCT_LINE_FILLING_DIAGNOSTIC_MISCONCEPTION_46_8BD522", properties:{kc_id:"cecc916a-42c0-5965-8b25-28d2762429f1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product line filling: diagnostic misconception 464", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.2. products added to a product line to keep competitors from entering the market", status:"approved", flawed_rule:"Line filling necessarily moves the range beyond its current price or quality boundaries."}}, {misconception_id:"MISC_PRODUCT_LINE_STRETCHING_DIAGNOSTIC_MISCONCEPTION_DB14FB", properties:{kc_id:"0b97750e-d10c-5616-b994-ac88f281fd62", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product line stretching: diagnostic misconception 465", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.2. Extending a range upward, downward, or in both directions relative to its current price or quality boundaries, as illustrated by Tesla, Godiva, and Dell in section 9.2. The glossary’s brief reference to adding product lines should be read with these directional examples.", status:"approved", flawed_rule:"Stretching means only adding variants within the existing range boundaries."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_PRODUCT_MIX_DIAGNOSTIC_MISCONCEPTION_466_7849B0", properties:{kc_id:"5580ce64-0f56-5ac3-b786-de16684c9b84", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product mix: diagnostic misconception 466", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.2. all the products a company sells", status:"approved", flawed_rule:"The product mix refers only to promotional tactics."}}, {misconception_id:"MISC_PRODUCT_MIX_WIDTH_DIAGNOSTIC_MISCONCEPTION_467_CD075B", properties:{kc_id:"7a01163f-4665-5c04-87e8-4984cd4d715c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product mix width: diagnostic misconception 467", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.2. the number of product lines a brand carries", status:"approved", flawed_rule:"Mix width counts variants within a single product line."}}, {misconception_id:"MISC_PRODUCT_MODIFICATION_DIAGNOSTIC_MISCONCEPTION_46_98D3E6", properties:{kc_id:"0a1facf5-8ec8-5690-818e-a26802883117", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product modification: diagnostic misconception 468", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. alteration of products to fit the market", status:"approved", flawed_rule:"Changing target customers without altering the offering is product modification."}}, {misconception_id:"MISC_PRODUCTS_DIAGNOSTIC_MISCONCEPTION_469_930FD1", properties:{kc_id:"d9a97800-25db-556c-b75b-35593219b016", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"products in chapter 9 Closing Company Case task 2: diagnostic misconception 1741", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Closing Company Case, task 2. tangible items that are part of an exchange between a buyer and a seller", status:"approved", flawed_rule:"All market offerings must be physical objects; services cannot satisfy product needs."}}, {misconception_id:"MISC_PROFIT_MARGINS_DIAGNOSTIC_MISCONCEPTION_470_576ABB", properties:{kc_id:"8bee0707-1912-526e-9d37-f33fcea3a6c9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"profit margins: diagnostic misconception 470", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. a widely used financial measure to determine the profitability of a business; considers costs to manufacture and sell a product or service", status:"approved", flawed_rule:"High sales revenue necessarily means a high profit margin."}}, {misconception_id:"MISC_RAPID_PENETRATION_PRICING_STRATEGY_DIAGNOSTIC_MI_410329", properties:{kc_id:"dcd60022-354e-58fa-89a8-10d17c2b6961", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"rapid penetration pricing strategy: diagnostic misconception 471", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. strategy that sets a lower-price strategy; appropriate when volume sales will increase market share quickly", status:"approved", flawed_rule:"Rapid penetration combines high introductory prices with minimal promotion."}}, {misconception_id:"MISC_RAPID_SKIMMING_STRATEGY_DIAGNOSTIC_MISCONCEPTION_D9C41D", properties:{kc_id:"26e956ff-ddac-5201-85ab-722978e9fac6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"rapid skimming strategy: diagnostic misconception 472", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. strategy that sets a high price along with extensive advertising and sales promotion to establish a product in the marketplace", status:"approved", flawed_rule:"Rapid skimming combines low prices with minimal promotion."}}, {misconception_id:"MISC_RAW_MATERIALS_DIAGNOSTIC_MISCONCEPTION_473_7E1FA6", properties:{kc_id:"58f2757b-61a5-55dd-a93e-fd5b3dd862ca", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"raw materials: diagnostic misconception 473", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. products that a business needs to purchase in order to make a consumer good", status:"approved", flawed_rule:"Raw materials are finished consumer products ready for retail sale."}}, {misconception_id:"MISC_SERVICES_DIAGNOSTIC_MISCONCEPTION_474_42254D", properties:{kc_id:"379dc76c-2027-5da6-8a89-42631a321fc1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"services in chapter 11 Closing Company Case task 3: diagnostic misconception 1781", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, Closing Company Case, task 3. nonphysical, intangible economic activities", status:"approved", flawed_rule:"Services can always be inventoried and inspected like manufactured goods."}}, {misconception_id:"MISC_SHIFTING_LOYALS_DIAGNOSTIC_MISCONCEPTION_475_729FB9", properties:{kc_id:"c88abddc-6d3a-5ed2-bd4d-278b5954052f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"shifting loyals: diagnostic misconception 475", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. customers who are loyal to one product or service for a time, then turn their loyalty to a different product or service at another time", status:"approved", flawed_rule:"Shifting loyals have no period of commitment to any brand."}}, {misconception_id:"MISC_SHOPPING_PRODUCTS_DIAGNOSTIC_MISCONCEPTION_476_0930F5", properties:{kc_id:"d8ffdea5-33e8-5eba-a88c-6c179277aced", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"shopping products: diagnostic misconception 476", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. products that require more thought from the consumer as they seek the best quality or price", status:"approved", flawed_rule:"Shopping products are normally purchased without comparison of quality or price."}}, {misconception_id:"MISC_SLOW_PENETRATION_PRICING_STRATEGY_DIAGNOSTIC_MIS_6FDFBE", properties:{kc_id:"b1c32f81-3472-5bcb-b2b1-381c0af7b407", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"slow penetration pricing strategy: diagnostic misconception 477", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. strategy that sets low prices and little promotion to capture market share slowly in a market not susceptible to promotion", status:"approved", flawed_rule:"Slow penetration requires high promotional spending alongside low prices."}}, {misconception_id:"MISC_SLOW_SKIMMING_STRATEGY_DIAGNOSTIC_MISCONCEPTION__B18623", properties:{kc_id:"e4609533-4302-5a7b-a535-c50445fa7016", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"slow skimming strategy: diagnostic misconception 478", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.4. strategy that sets high prices with low advertising and sales promotion investment", status:"approved", flawed_rule:"Slow skimming combines low introductory prices with heavy promotion."}}, {misconception_id:"MISC_SPECIALTY_PRODUCTS_DIAGNOSTIC_MISCONCEPTION_479_DEFD05", properties:{kc_id:"54c6691d-ceaa-5ac6-bf81-46595eab8b55", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"specialty products in chapter 9 Critical Thinking Exercises task 1: diagnostic misconception 1732", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9, Critical Thinking Exercises, task 1. products that have unique qualities that consumers will make an extra effort to seek out", status:"approved", flawed_rule:"Specialty products are defined by low involvement and easy substitution."}}, {misconception_id:"MISC_SPLIT_LOYALS_DIAGNOSTIC_MISCONCEPTION_480_2D279A", properties:{kc_id:"b9d94a5e-8eb3-5a5c-b4c5-31125570e813", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"split loyals: diagnostic misconception 480", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. customers who have a consideration set of two or three products or services in a category", status:"approved", flawed_rule:"Split loyals buy only one brand over the entire period."}}, {misconception_id:"MISC_SUPPLIES_AND_SERVICES_DIAGNOSTIC_MISCONCEPTION_4_67D7F2", properties:{kc_id:"5a72ef53-1c79-51cc-85b3-ee22e78c5065", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"supplies and services: diagnostic misconception 481", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. goods and services that are typically disposed of and do not contain a tangible value", status:"approved", flawed_rule:"Routine operating supplies are long-lived capital assets."}}, {misconception_id:"MISC_SWITCHERS_DIAGNOSTIC_MISCONCEPTION_482_60B21A", properties:{kc_id:"f1d237b1-f6de-5c24-8d95-ef74fbb7e27a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"switchers: diagnostic misconception 482", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.6. customers who continually change their purchasing behaviors", status:"approved", flawed_rule:"Every brand switch reflects a durable new brand loyalty."}}, {misconception_id:"MISC_TRADEMARKS_SERVICE_MARKS_DIAGNOSTIC_MISCONCEPTIO_DCFF58", properties:{kc_id:"f4481890-7430-5f99-bf8b-0b365eaaac5b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"trademarks (service marks): diagnostic misconception 483", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.5. symbols that show legal ownership of a brand name or brand mark", status:"approved", flawed_rule:"Trademark ownership protects every functional invention in a product."}}, {misconception_id:"MISC_UNSOUGHT_PRODUCTS_DIAGNOSTIC_MISCONCEPTION_484_FED9E2", properties:{kc_id:"56ebd997-47ec-5847-93e7-faa479e2659d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"unsought products: diagnostic misconception 484", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 9 Key Terms, printed page 337, and section 9.1. consumer goods that a buyer doesn’t anticipate purchasing", status:"approved", flawed_rule:"Unsought products are products nobody will ever need or purchase."}}, {misconception_id:"MISC_ADDITIONS_TO_EXISTING_PRODUCT_LINES_DIAGNOSTIC_M_20ECFB", properties:{kc_id:"503e7702-2672-5415-8c6a-f6371bec091b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"additions to existing product lines in chapter 10 Closing Company Case task 1: diagnostic misconception 1759", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Closing Company Case, task 1. product line extensions that involve changes to styles or flavors", status:"approved", flawed_rule:"A new size or flavor necessarily creates a new-to-the-world market."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_BUSINESS_ANALYSIS_DIAGNOSTIC_MISCONCEPTION_486_15E535", properties:{kc_id:"b0fabce4-d249-5cc3-a09b-36176dc5741c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"business analysis: diagnostic misconception 486", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. the fifth step in the new product development process, in which a potential new product is evaluated", status:"approved", flawed_rule:"A promising idea can skip feasibility and profitability analysis before development."}}, {misconception_id:"MISC_COMMERCIALIZATION_DIAGNOSTIC_MISCONCEPTION_487_07D9DF", properties:{kc_id:"3a87a287-377f-581f-b25b-28c4ee3ab0a3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"commercialization in chapter 10 Closing Company Case task 3: diagnostic misconception 1761", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Closing Company Case, task 3. the eighth step in the new product development process, in which the product is launched with full-scale production, distribution, advertising, and sales promotion", status:"approved", flawed_rule:"Showing a prototype to a small test group is full commercialization."}}, {misconception_id:"MISC_COMMUNICABILITY_DIAGNOSTIC_MISCONCEPTION_488_F2AE72", properties:{kc_id:"60800f22-8f77-5d38-95da-5ae3b39bbe5f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"communicability: diagnostic misconception 488", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. the ability to communicate to the audience the benefits of using a particular product or service", status:"approved", flawed_rule:"Technical performance alone ensures customers understand a new product's benefits."}}, {misconception_id:"MISC_CONCEPT_DEVELOPMENT_AND_TESTING_DIAGNOSTIC_MISCO_F82C49", properties:{kc_id:"af97067a-f982-5409-897a-88bf38cc993d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"concept development and testing: diagnostic misconception 489", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. the third step in the new product development process, in which a product concept is developed into a detailed idea", status:"approved", flawed_rule:"A raw product idea is already a tested, detailed customer concept."}}, {misconception_id:"MISC_CONCEPT_TESTING_DIAGNOSTIC_MISCONCEPTION_490_87C0B3", properties:{kc_id:"ef18e9f8-ffad-5963-86bf-16979642652d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"concept testing in chapter 10 Closing Company Case task 4: diagnostic misconception 1762", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Closing Company Case, task 4. market research method in which customers are presented with a description of a product or service", status:"approved", flawed_rule:"Concept testing requires full-scale factory production before customer feedback."}}, {misconception_id:"MISC_CONSUMER_ADOPTION_PROCESS_DIAGNOSTIC_MISCONCEPTI_8435FA", properties:{kc_id:"78b76c03-3c8c-55b5-bbfd-47ef4bbbe4c4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"consumer adoption process: diagnostic misconception 491", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. stages consumers go through in adopting a new product", status:"approved", flawed_rule:"Becoming aware of a new product is the same as adopting it."}}, {misconception_id:"MISC_CONTINUOUS_INNOVATION_DIAGNOSTIC_MISCONCEPTION_4_79E2D6", properties:{kc_id:"12eae43d-13e4-57ca-9bd8-f681b7d43a29", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"continuous innovation in chapter 10 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1744", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Applied Marketing Knowledge: Discussion Questions, task 1. category of “newness” in which the existing product undergoes only marginal changes that do not alter consumer habits", status:"approved", flawed_rule:"A continuous innovation requires consumers to learn entirely new behavior."}}, {misconception_id:"MISC_COPYRIGHTS_DIAGNOSTIC_MISCONCEPTION_493_22E481", properties:{kc_id:"3add400e-fc91-5ea6-b9bc-73a7a9d67538", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"copyrights: diagnostic misconception 493", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.6. original works of authorship that include software, songs, television shows, and motion pictures", status:"approved", flawed_rule:"Copyright automatically protects a brand name and every functional invention."}}, {misconception_id:"MISC_CROWDSOURCING_DIAGNOSTIC_MISCONCEPTION_494_8FC1EE", properties:{kc_id:"ee30142b-5641-56b7-9d4d-cdfd7838bb6a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"crowdsourcing: diagnostic misconception 494", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. using the input of a large group of people for market testing", status:"approved", flawed_rule:"A large crowd's favorite idea guarantees commercially viable demand."}}, {misconception_id:"MISC_DIFFUSION_OF_INNOVATION_DIAGNOSTIC_MISCONCEPTION_D52BA5", properties:{kc_id:"382cee7f-3eb2-5fe8-8ba9-d353f67eaa13", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"diffusion of innovation: diagnostic misconception 495", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. theory about how products gain momentum and spread through a population or society", status:"approved", flawed_rule:"All consumers adopt an innovation simultaneously after launch."}}, {misconception_id:"MISC_DISCONTINUOUS_INNOVATION_DIAGNOSTIC_MISCONCEPTIO_B7E67A", properties:{kc_id:"1cc00a0f-ea62-5bb9-9c4a-16472ec4b5b8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"discontinuous innovation: diagnostic misconception 496", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.1. new-to-the-world products that require a significant change in consumer behavior when adopted", status:"approved", flawed_rule:"Discontinuous innovation makes only a minor change to existing consumption habits."}}, {misconception_id:"MISC_DIVISIBILITY_DIAGNOSTIC_MISCONCEPTION_497_F9A10A", properties:{kc_id:"9e223f40-60b5-5580-b368-e2851cc029e6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"divisibility: diagnostic misconception 497", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. the ability of a consumer to give a product a “test run” before purchasing it", status:"approved", flawed_rule:"A customer must make a complete irreversible purchase to evaluate any innovation."}}, {misconception_id:"MISC_DYNAMICALLY_CONTINUOUS_INNOVATION_DIAGNOSTIC_MIS_183E5F", properties:{kc_id:"87b83be5-e36e-5e19-979d-c84b26b951bd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"dynamically continuous innovation: diagnostic misconception 498", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.1. changes to a product or service that require little change to consumer habits", status:"approved", flawed_rule:"Dynamically continuous innovation has no learning implications whatsoever."}}, {misconception_id:"MISC_EARLY_ADOPTERS_DIAGNOSTIC_MISCONCEPTION_499_1D4D30", properties:{kc_id:"44f3b780-75d6-5941-961e-5c3acfbca81b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"early adopters: diagnostic misconception 499", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. consumers who are willing to try new products typically before others but not as early as innovators", status:"approved", flawed_rule:"Early adopters are the very first category and precede innovators."}}, {misconception_id:"MISC_EARLY_MAJORITY_DIAGNOSTIC_MISCONCEPTION_500_8C97BF", properties:{kc_id:"df15fc9d-58b4-5da0-a0f6-92f7bb0266aa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"early majority in chapter 10 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1746", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Applied Marketing Knowledge: Discussion Questions, task 3. consumers who are initially reluctant to risk trying a new product but accept innovation", status:"approved", flawed_rule:"The early majority adopts before obtaining any evidence of usefulness."}}, {misconception_id:"MISC_EVALUATION_OF_RESULTS_DIAGNOSTIC_MISCONCEPTION_5_1DFA73", properties:{kc_id:"7ddd75df-e373-5f41-8585-b46b6c95a544", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"evaluation of results: diagnostic misconception 501", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. the ninth and final step in the new product development process, in which a company evaluates product launch performance based on predetermined metrics", status:"approved", flawed_rule:"The new product process ends at launch without reviewing results."}}, {misconception_id:"MISC_EXTERNAL_SOURCES_DIAGNOSTIC_MISCONCEPTION_502_A32BA8", properties:{kc_id:"9bb77256-3c0a-55f3-b10a-1d1cbf8e1aa4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"external sources: diagnostic misconception 502", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. in product development, sources of ideas for new products or services from those outside the organization", status:"approved", flawed_rule:"Only employees can contribute useful new-product ideas."}}, {misconception_id:"MISC_IDEA_GENERATION_DIAGNOSTIC_MISCONCEPTION_503_A0022F", properties:{kc_id:"8472270f-f0a2-5580-96e3-70c50a4757cc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"idea generation in chapter 10 Closing Company Case task 2: diagnostic misconception 1760", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Closing Company Case, task 2. the first step in the new product development process, in which many new ideas for a product are developed", status:"approved", flawed_rule:"Idea generation should begin by rejecting every unconventional possibility."}}, {misconception_id:"MISC_IDEA_SCREENING_AND_EVALUATION_DIAGNOSTIC_MISCONC_D86447", properties:{kc_id:"e3307b1b-fb94-5fc6-85b9-98964de41d57", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"idea screening and evaluation: diagnostic misconception 504", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. the second step in the new product development process, in which ideas are filtered to those most likely to turn a profit", status:"approved", flawed_rule:"All generated ideas should proceed to full development without screening."}}, {misconception_id:"MISC_IMPROVEMENTS_AND_REVISIONS_TO_EXISTING_PRODUCTS__9947B3", properties:{kc_id:"9857bd94-d259-54e8-bddb-8a03e9541890", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"improvements and revisions to existing products: diagnostic misconception 505", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.1. improvements to existing products that fine tune or perfect them", status:"approved", flawed_rule:"Any improvement is necessarily a new-to-the-world invention."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_INNOVATORS_DIAGNOSTIC_MISCONCEPTION_506_F0DE1E", properties:{kc_id:"23f9d62b-a877-5549-ae3a-3bee2e1076f8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"innovators: diagnostic misconception 506", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. consumers who are the first to take a risk and buy new products as soon as they are available", status:"approved", flawed_rule:"Innovators wait until most of the market has accepted a product."}}, {misconception_id:"MISC_INTELLECTUAL_PROPERTY_DIAGNOSTIC_MISCONCEPTION_5_EB2C59", properties:{kc_id:"26e2205a-68d6-56a7-971b-eed75c6de909", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"intellectual property: diagnostic misconception 507", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.6. collective term used to describe patents, copyrights, and trademarks", status:"approved", flawed_rule:"Patents, trademarks, and copyright provide interchangeable protection."}}, {misconception_id:"MISC_INTERNAL_SOURCES_DIAGNOSTIC_MISCONCEPTION_508_0AB0B0", properties:{kc_id:"c7cdf399-0654-544c-adbf-d39eac3e4f39", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"internal sources: diagnostic misconception 508", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. in product development, sources of ideas for new products or services from those inside the organization", status:"approved", flawed_rule:"Internal idea sources consist only of the chief executive."}}, {misconception_id:"MISC_LAGGARDS_DIAGNOSTIC_MISCONCEPTION_509_2C46D1", properties:{kc_id:"ee4a52d1-9ed7-5f05-893c-7a4b0cea11a6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"laggards: diagnostic misconception 509", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. consumers who are skeptical of new ideas and are reluctant to try new products", status:"approved", flawed_rule:"Laggards are the first consumers willing to experiment with a product."}}, {misconception_id:"MISC_LATE_MAJORITY_DIAGNOSTIC_MISCONCEPTION_510_E2A4B1", properties:{kc_id:"f8f55ba9-dc9e-5487-9fa3-b9a9961b926d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"late majority: diagnostic misconception 510", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. consumers who are slow to catch on to the popularity of new services, products, ideas, or solutions", status:"approved", flawed_rule:"Late-majority customers adopt before the early majority."}}, {misconception_id:"MISC_MARKET_ATTRACTIVENESS_DIAGNOSTIC_MISCONCEPTION_5_17873D", properties:{kc_id:"640ee4dc-8a57-5406-ab96-d3bb7318adf0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"market attractiveness: diagnostic misconception 511", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.4. the measure of potential value; considers factors like short- and long-term profit, market growth rate, how much competition currently exists in the market, the cost of entry into the market, and how much the product satisfies the needs of customers in the target market", status:"approved", flawed_rule:"A fast-growing market is attractive regardless of competition, entry costs, and customer fit."}}, {misconception_id:"MISC_MARKET_STRATEGY_DEVELOPMENT_DIAGNOSTIC_MISCONCEP_CF0BAC", properties:{kc_id:"a9c7dac0-85b7-5134-bef6-eddd6e6b0775", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"market strategy development: diagnostic misconception 512", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. the fourth step in the new product development process, in which a preliminary marketing strategy is developed", status:"approved", flawed_rule:"A product requires no target market or positioning until after full launch."}}, {misconception_id:"MISC_MARKETING_SYNERGY_DIAGNOSTIC_MISCONCEPTION_513_6FFA6A", properties:{kc_id:"501e06a9-1bfe-5ac9-881a-792ee0118cd6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing synergy: diagnostic misconception 513", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.4. the fit between the needs of the new product development project and the company’s marketing capabilities", status:"approved", flawed_rule:"Strong engineering resources guarantee a fit with marketing capabilities."}}, {misconception_id:"MISC_NEW_TO_THE_FIRM_PRODUCTS_DIAGNOSTIC_MISCONCEPTIO_AA5612", properties:{kc_id:"c57534cb-95e6-5639-afda-8bf9952542f5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"new-to-the-firm products: diagnostic misconception 514", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.1. products that are new to a company but not to the world", status:"approved", flawed_rule:"An offering new to one company must be new to every customer worldwide."}}, {misconception_id:"MISC_NEW_TO_THE_WORLD_PRODUCTS_DIAGNOSTIC_MISCONCEPTI_0218A1", properties:{kc_id:"c706dc10-1990-5baf-b7a9-400c9c8a5005", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"new-to-the-world products: diagnostic misconception 515", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.1. new product inventions that create new markets", status:"approved", flawed_rule:"A competitor imitation qualifies as a new-to-the-world product."}}, {misconception_id:"MISC_PATENTS_DIAGNOSTIC_MISCONCEPTION_516_0E6811", properties:{kc_id:"2f9ef406-055c-5f02-aee1-66d68afb96dd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"patents: diagnostic misconception 516", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.6. the right to exclude others from making, using, or offering for sale an invention", status:"approved", flawed_rule:"A patent is the same as permission to market a product without other obligations."}}, {misconception_id:"MISC_PERSONAL_INFLUENCE_DIAGNOSTIC_MISCONCEPTION_517_29C79F", properties:{kc_id:"ffc6018f-7c16-558d-bf23-525754143921", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"personal influence in chapter 10 Building Your Personal Brand task 1: diagnostic misconception 1751", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Building Your Personal Brand, task 1. communication between individuals in which individuals can affect the purchasing decision of others because of their authority, knowledge, or position", status:"approved", flawed_rule:"Only paid advertising influences innovation adoption."}}, {misconception_id:"MISC_PRODUCT_ADOPTION_DIAGNOSTIC_MISCONCEPTION_518_CCCA19", properties:{kc_id:"5acde29d-8c05-5a25-b009-d738d717ea84", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product adoption in chapter 10 What Do Marketers Do? task 5: diagnostic misconception 1756", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, What Do Marketers Do?, task 5. the fifth stage in the consumer adoption process, also known as user adoption, in which people learn about a product and start using its features", status:"approved", flawed_rule:"Trying a product once proves sustained adoption."}}, {misconception_id:"MISC_PRODUCT_AWARENESS_DIAGNOSTIC_MISCONCEPTION_519_D4DB3D", properties:{kc_id:"481a4140-a4b8-53d3-af03-63b2e35217a8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product awareness: diagnostic misconception 519", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.5. the first stage in the consumer adoption process, in which a company creates awareness that the product is available", status:"approved", flawed_rule:"Product awareness demonstrates that the consumer has evaluated alternatives and purchased."}}, {misconception_id:"MISC_PRODUCT_CONCEPTS_DIAGNOSTIC_MISCONCEPTION_520_C322E6", properties:{kc_id:"6d169578-dad7-5423-987d-9bd7c9eda0b9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product concepts: diagnostic misconception 520", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. perceptions of a new idea or innovation", status:"approved", flawed_rule:"A product concept is already a production-ready physical prototype."}}, {misconception_id:"MISC_PRODUCT_DEVELOPMENT_DIAGNOSTIC_MISCONCEPTION_521_115D0B", properties:{kc_id:"677db363-f88f-5246-8280-234c666a3beb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product development in chapter 10 What Do Marketers Do? task 7: diagnostic misconception 1758", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, What Do Marketers Do?, task 7. the sixth step in the new product development process, in which a potential new product undergoes development; may include the creation of a prototype", status:"approved", flawed_rule:"Developing a prototype is the same as commercially launching the product."}}, {misconception_id:"MISC_PRODUCT_EVALUATION_DIAGNOSTIC_MISCONCEPTION_522_1065E8", properties:{kc_id:"7f8adf65-2055-5288-a9c3-4677f6deefd2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product evaluation: diagnostic misconception 522", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. the third stage in the consumer adoption process, in which consumers examine, compare, and evaluate the product prior to purchase", status:"approved", flawed_rule:"Product evaluation necessarily occurs only after sustained adoption."}}, {misconception_id:"MISC_PRODUCT_IDEA_DIAGNOSTIC_MISCONCEPTION_523_4BD24F", properties:{kc_id:"bba12909-eb54-5783-a466-e24eea51694d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product idea in chapter 10 What Do Marketers Do? task 3: diagnostic misconception 1754", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, What Do Marketers Do?, task 3. concept of a new product that a company could potentially offer to the market", status:"approved", flawed_rule:"An undeveloped idea already establishes technical and market feasibility."}}, {misconception_id:"MISC_PRODUCT_INTEREST_DIAGNOSTIC_MISCONCEPTION_524_480FC6", properties:{kc_id:"b02dac22-aa07-56e0-8ad7-b94a5a6fb6b9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product interest in chapter 10 What Do Marketers Do? task 6: diagnostic misconception 1757", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, What Do Marketers Do?, task 6. stage in the consumer adoption process in which the product has piqued the consumer’s interest", status:"approved", flawed_rule:"Interest means the consumer has committed to purchase."}}, {misconception_id:"MISC_PRODUCT_METRICS_DIAGNOSTIC_MISCONCEPTION_525_6BD5EC", properties:{kc_id:"01ce8f19-6da5-564d-ac84-c0e8a89336d5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product metrics: diagnostic misconception 525", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.3. quantifiable data that a business tracks and analyzes to determine how successful its new products are", status:"approved", flawed_rule:"Launch performance should be judged only by management enthusiasm."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_PRODUCT_TRIAL_DIAGNOSTIC_MISCONCEPTION_526_F748AD", properties:{kc_id:"b16d9ac9-0377-57bc-923d-bb4afe1117e2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product trial in chapter 10 Critical Thinking Exercises task 1: diagnostic misconception 1747", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10, Critical Thinking Exercises, task 1. the fourth stage in the consumer adoption process, in which the consumer tries the product out", status:"approved", flawed_rule:"A favorable trial guarantees long-term repeat use for every customer."}}, {misconception_id:"MISC_PROTOTYPE_DIAGNOSTIC_MISCONCEPTION_527_757D47", properties:{kc_id:"d3c9e116-08cc-530e-bba6-9ab84adfa91b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"prototype: diagnostic misconception 527", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. in new product development, the creation of a physical version of the product", status:"approved", flawed_rule:"A prototype must be identical to the final mass-produced version."}}, {misconception_id:"MISC_REPOSITIONED_PRODUCTS_DIAGNOSTIC_MISCONCEPTION_5_242400", properties:{kc_id:"86ea39be-4b21-5712-adda-35d09c8d91b0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"repositioned products: diagnostic misconception 528", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.1. products that are retargeted for a new use", status:"approved", flawed_rule:"A new use for an existing product always requires a new invention."}}, {misconception_id:"MISC_RETURN_ON_INVESTMENT_ROI_DIAGNOSTIC_MISCONCEPTIO_6F143F", properties:{kc_id:"4a28dc33-ede8-59b2-887d-2338a4e155ac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"return on investment (ROI): diagnostic misconception 529", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.3. a metric formula used to evaluate the profitability of an investment and, in marketing, the measurement of the profitability of a new product launch", status:"approved", flawed_rule:"ROI measures revenue per advertising dollar without considering investment return or cost."}}, {misconception_id:"MISC_REVENUE_STREAMS_DIAGNOSTIC_MISCONCEPTION_530_5C4541", properties:{kc_id:"bd2db7f9-28bc-55de-b794-dfea916fb212", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"revenue streams: diagnostic misconception 530", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.1. all the ways in which a company can generate cash flow from the sale of its products or services", status:"approved", flawed_rule:"A product can generate revenue only through a one-time purchase."}}, {misconception_id:"MISC_TECHNOLOGICAL_SYNERGY_DIAGNOSTIC_MISCONCEPTION_5_436303", properties:{kc_id:"5145915b-5229-583c-8619-c1a2ff233e1c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"technological synergy: diagnostic misconception 531", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.4. the extent to which a new product is built on the firm’s existing technological resources", status:"approved", flawed_rule:"Marketing experience alone proves the technical capability to build a new offering."}}, {misconception_id:"MISC_TEST_MARKETING_DIAGNOSTIC_MISCONCEPTION_532_D915A6", properties:{kc_id:"1b612659-f55b-555b-8a1f-6ee18cd16571", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"test-marketing: diagnostic misconception 532", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.2. the seventh step in the new product development process, in which a product concept is test-marketed to determine its viability before launch to market", status:"approved", flawed_rule:"Positive concept feedback removes the need to test an actual market offering."}}, {misconception_id:"MISC_TRADEMARKS_DIAGNOSTIC_MISCONCEPTION_533_DA08B4", properties:{kc_id:"0db5a43a-cdec-5b86-9618-1e1d30757c50", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"trademarks: diagnostic misconception 533", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 10 Key Terms, printed page 366, and section 10.6. words or symbols legally registered or established by use as representing a company or product", status:"approved", flawed_rule:"A trademark grants exclusive rights to every technical mechanism inside a product."}}, {misconception_id:"MISC_ASSURANCE_DIAGNOSTIC_MISCONCEPTION_534_E19D27", properties:{kc_id:"1e44d76a-b1c7-59ec-801a-8a213ba91cb5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"assurance: diagnostic misconception 534", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in terms of the RATER model, the degree to which an organization inspires trust in its customers", status:"approved", flawed_rule:"Assurance is simply a polished physical facility rather than confidence in competence and trustworthiness."}}, {misconception_id:"MISC_COMMUNICATION_GAP_DIAGNOSTIC_MISCONCEPTION_535_BCD78D", properties:{kc_id:"88bba3d7-fdfc-59c7-841a-0a6e205b6b82", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"communication gap: diagnostic misconception 535", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in the Gap Model of Service Quality, the variance between what is communicated to the customer and their actual experience", status:"approved", flawed_rule:"A service communication gap concerns only incorrect assumptions inside management."}}, {misconception_id:"MISC_CUSTOMER_GAP_DIAGNOSTIC_MISCONCEPTION_536_78E9B9", properties:{kc_id:"1fa9d207-ed19-54d1-a9fa-4187474fd048", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer gap: diagnostic misconception 536", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in the Gap Model of Service Quality, the variance between the customer’s expectations and their perception of the service", status:"approved", flawed_rule:"Meeting internal specifications guarantees that customers' expectations are met."}}, {misconception_id:"MISC_CUSTOMER_SATISFACTION_DIAGNOSTIC_MISCONCEPTION_5_4C35EC", properties:{kc_id:"15fce07e-8c77-54d2-8c6c-feb47265f162", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer satisfaction: diagnostic misconception 538", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.2. a measurement that determines how happy customers are with a company’s products, services, and capabilities", status:"approved", flawed_rule:"A satisfied customer will necessarily remain loyal regardless of alternatives."}}, {misconception_id:"MISC_DELIVERY_GAP_DIAGNOSTIC_MISCONCEPTION_539_043F39", properties:{kc_id:"2339a3e6-9d7c-54c1-9900-17f3527bb378", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"delivery gap: diagnostic misconception 539", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in the Gap Model of Service Quality, the difference between the experience specification and the actual delivery of the service", status:"approved", flawed_rule:"Writing accurate service standards guarantees that frontline delivery meets them."}}, {misconception_id:"MISC_EMPATHY_DIAGNOSTIC_MISCONCEPTION_540_93966F", properties:{kc_id:"db2fb4b5-afdd-5629-8040-353782e88391", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"empathy: diagnostic misconception 540", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in terms of the RATER model, focusing on customers attentively to assure they receive caring and distinguished service", status:"approved", flawed_rule:"Offering the identical script to every customer demonstrates individualized care."}}, {misconception_id:"MISC_EMPLOYEE_RETENTION_DIAGNOSTIC_MISCONCEPTION_541_B4BF1D", properties:{kc_id:"47d6dd34-55cb-576d-a0bf-ae3526116a8a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"employee retention: diagnostic misconception 541", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.2. an organization’s ability to retain its employees and stop employees from leaving", status:"approved", flawed_rule:"Replacing employees frequently cannot affect customer relationships or service continuity."}}, {misconception_id:"MISC_EMPLOYEE_SATISFACTION_DIAGNOSTIC_MISCONCEPTION_5_5F9291", properties:{kc_id:"22f01894-0006-5c28-aa4a-c0bdce653886", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"employee satisfaction in chapter 11 What Do Marketers Do? task 3: diagnostic misconception 1773", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, What Do Marketers Do?, task 3. the level of happiness and contentment employees have about their jobs and the work environment", status:"approved", flawed_rule:"Employee working conditions are unrelated to customer service outcomes."}}, {misconception_id:"MISC_EQUIPMENT_BASED_SERVICES_DIAGNOSTIC_MISCONCEPTIO_1EDA5C", properties:{kc_id:"b6db5944-27c0-5bf0-962d-8ce780bdf56c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"equipment-based services: diagnostic misconception 543", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. when machinery or equipment plays the primary role in the service delivery", status:"approved", flawed_rule:"A service using machinery is a tangible good rather than a service."}}, {misconception_id:"MISC_EXTERNAL_SERVICE_MARKETING_DIAGNOSTIC_MISCONCEPT_F67BF4", properties:{kc_id:"97d728e1-2f72-5a08-90fe-7f5590f6472e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"external service marketing in chapter 11 What Do Marketers Do? task 8: diagnostic misconception 1778", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, What Do Marketers Do?, task 8. the action of promoting or selling services to customers and potential customers", status:"approved", flawed_rule:"Advertising a service automatically ensures employees can deliver its promise."}}, {misconception_id:"MISC_EXTERNAL_VALUE_PROPOSITION_DIAGNOSTIC_MISCONCEPT_321B0D", properties:{kc_id:"f03a9033-8e76-5f48-bc17-90d8bbf7d8ab", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"external value proposition in chapter 11 Critical Thinking Exercises task 2: diagnostic misconception 1768", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, Critical Thinking Exercises, task 2. the value companies promise to deliver to customers post-purchase", status:"approved", flawed_rule:"A customer value promise is fulfilled merely by communicating it."}}, {misconception_id:"MISC_GAP_MODEL_OF_SERVICE_QUALITY_DIAGNOSTIC_MISCONCE_B69683", properties:{kc_id:"50c02a9d-876f-59bc-aec7-f7719f1493be", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"GAP Model of Service Quality: diagnostic misconception 546", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. theoretical marketing model that helps to identify the gaps between the perceived service and the expected service", status:"approved", flawed_rule:"All service failures have the same cause and need the same remedy."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_INFORMATION_PROCESSING_DIAGNOSTIC_MISCONCEPTION__1874EE", properties:{kc_id:"2c52a8a8-3b44-5e56-b1a3-61d5e2d0d995", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"information processing in chapter 11 Building Your Personal Brand task 1: diagnostic misconception 1770", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, Building Your Personal Brand, task 1. intangible actions directed at a customer’s assets, such as insurance or consulting", status:"approved", flawed_rule:"Information-processing services act primarily on customers' physical possessions."}}, {misconception_id:"MISC_INTANGIBLE_DIAGNOSTIC_MISCONCEPTION_548_F9B33A", properties:{kc_id:"0bc57a05-9c1e-5ed1-944e-10b36b66c394", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"intangible: diagnostic misconception 548", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. unable to be seen, tasted, felt, smelled, or heard", status:"approved", flawed_rule:"An intangible service provides no value because it cannot be touched."}}, {misconception_id:"MISC_INTERACTIVE_SERVICE_MARKETING_DIAGNOSTIC_MISCONC_70388A", properties:{kc_id:"e09b8279-5ab8-5f82-be60-287d5a48816e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"interactive service marketing: diagnostic misconception 549", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.2. The communication and direct interaction between the service provider and customer during the service encounter.", status:"approved", flawed_rule:"Interactive service marketing refers only to advertising before the encounter."}}, {misconception_id:"MISC_INTERNAL_SERVICE_MARKETING_DIAGNOSTIC_MISCONCEPT_2A7415", properties:{kc_id:"4fb13079-9c47-53f5-8eab-3f9eb5323e97", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"internal service marketing in chapter 11 What Do Marketers Do? task 7: diagnostic misconception 1777", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, What Do Marketers Do?, task 7. satisfying employees to motivate them to work as a team to satisfy customers", status:"approved", flawed_rule:"Internal service marketing targets potential external customers rather than employees."}}, {misconception_id:"MISC_INTERNAL_SERVICE_QUALITY_DIAGNOSTIC_MISCONCEPTIO_32B1EE", properties:{kc_id:"fd665397-d4c5-58ae-86fb-30c55427f764", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"internal service quality in chapter 11 Closing Company Case task 4: diagnostic misconception 1782", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, Closing Company Case, task 4. the perceived level of satisfaction an employee experiences with services offered by internal service providers", status:"approved", flawed_rule:"Support services inside the organization cannot affect external service delivery."}}, {misconception_id:"MISC_KNOWLEDGE_GAP_DIAGNOSTIC_MISCONCEPTION_552_DD3D10", properties:{kc_id:"c05a4c86-9b4e-58b3-b9ed-847045be61e7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"knowledge gap in chapter 11 What Do Marketers Do? task 6: diagnostic misconception 1776", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, What Do Marketers Do?, task 6. in the GAP Model of Service Quality, the difference between what customers expect and what managers think they expect", status:"approved", flawed_rule:"Managers automatically know customer expectations without listening or research."}}, {misconception_id:"MISC_MENTAL_STIMULUS_PROCESSING_DIAGNOSTIC_MISCONCEPT_2527BD", properties:{kc_id:"5a578e73-b744-5604-b089-c8f4850b9ea5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"mental stimulus processing: diagnostic misconception 553", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. situation in which the services interact with the customer’s mind rather than the body", status:"approved", flawed_rule:"Mental-stimulus services operate on the customer's physical body."}}, {misconception_id:"MISC_PEOPLE_PROCESSING_DIAGNOSTIC_MISCONCEPTION_554_46A4F8", properties:{kc_id:"a173b1b2-106f-55fa-b445-42896e05e583", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"people processing: diagnostic misconception 554", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. services in which the customer is the direct recipient of the service and production and consumption are simultaneous", status:"approved", flawed_rule:"Customers need never participate in services directed at their own bodies."}}, {misconception_id:"MISC_PEOPLE_BASED_SERVICES_DIAGNOSTIC_MISCONCEPTION_5_7F90CD", properties:{kc_id:"38337339-44e9-506f-b15c-0e5f9dc76df1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"people-based services: diagnostic misconception 555", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. tasks in which people, rather than equipment or machinery, play a major role in the delivery of the service", status:"approved", flawed_rule:"All people-based service encounters deliver identical quality automatically."}}, {misconception_id:"MISC_POLICY_GAP_DIAGNOSTIC_MISCONCEPTION_556_E34B54", properties:{kc_id:"6f826014-bac8-508b-a3e7-b055f8e01a0f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"policy gap: diagnostic misconception 556", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in the GAP Model of Service Quality, the difference between managers understanding customer needs and being able to turn that into service delivery practices", status:"approved", flawed_rule:"Understanding customer needs alone ensures suitable service standards exist."}}, {misconception_id:"MISC_POSSESSION_PROCESSING_DIAGNOSTIC_MISCONCEPTION_5_B681FA", properties:{kc_id:"9f59555c-d74e-54e5-8ccc-3bb59d6b6fe9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"possession processing: diagnostic misconception 557", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. services in which the service is directed toward the customer’s physical possessions", status:"approved", flawed_rule:"Repairing a customer's car is the same service category as treating the customer's body."}}, {misconception_id:"MISC_PRODUCTIVITY_DIAGNOSTIC_MISCONCEPTION_558_840DAB", properties:{kc_id:"ff102a34-473c-5f8d-9e4e-eb00fe7ad3ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"productivity: diagnostic misconception 558", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.2. the efficiency and output of employees", status:"approved", flawed_rule:"Increasing transactions per employee necessarily improves service quality and profit."}}, {misconception_id:"MISC_RATER_FRAMEWORK_OF_SERVICE_QUALITY_DIAGNOSTIC_MI_75DCE4", properties:{kc_id:"758ecee9-9da8-5bbd-b603-c80e749dcd74", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"RATER framework of service quality: diagnostic misconception 559", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. theoretical model that focuses on the five dimensions of service excellence: reliability, assurance, tangibles, empathy, and responsiveness", status:"approved", flawed_rule:"Service quality depends only on speed and excludes trust, empathy, and reliability."}}, {misconception_id:"MISC_RELIABILITY_DIAGNOSTIC_MISCONCEPTION_560_03FF3B", properties:{kc_id:"bd0d48fb-46e2-55af-bfe6-711813a0e9ac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"reliability: diagnostic misconception 560", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in terms of the RATER model, the organization’s capability to produce an accurate, dependable, and on-time service", status:"approved", flawed_rule:"Reliability means providing occasional exceptional service rather than consistently fulfilling promises."}}, {misconception_id:"MISC_RESPONSIVENESS_DIAGNOSTIC_MISCONCEPTION_561_274A6E", properties:{kc_id:"1e0e2317-0423-5527-913b-4e2d88708b78", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"responsiveness: diagnostic misconception 561", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in terms of the RATER model, promptness and willingness to provide satisfactory and quick service", status:"approved", flawed_rule:"Responsiveness means the attractiveness of the service facility."}}, {misconception_id:"MISC_SERVICE_ENCOUNTER_DIAGNOSTIC_MISCONCEPTION_562_8FDCB9", properties:{kc_id:"e5705e68-f1f9-58ca-8d73-5df485f0780d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"service encounter in chapter 11 Critical Thinking Exercises task 3: diagnostic misconception 1769", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, Critical Thinking Exercises, task 3. a consumer’s direct contact with a service provider", status:"approved", flawed_rule:"The service encounter is only advertising, with no direct customer-provider contact."}}, {misconception_id:"MISC_SERVICE_INSEPARABILITY_DIAGNOSTIC_MISCONCEPTION__6B096E", properties:{kc_id:"64ffa9f4-d697-53f0-a9da-5c8bfa679302", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"service inseparability: diagnostic misconception 563", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. concept where services must be produced and consumed concurrently", status:"approved", flawed_rule:"Service production and consumption can always be separated like manufactured inventory."}}, {misconception_id:"MISC_SERVICE_MARKETING_TRIANGLE_DIAGNOSTIC_MISCONCEPT_204A50", properties:{kc_id:"af02b0d2-bfee-5961-a2d2-82168929d0c7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"Service Marketing Triangle in chapter 11 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1763", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, Applied Marketing Knowledge: Discussion Questions, task 1. a visual representation of a strategic model that outlines the importance of people in a company’s ability to keep its service promises", status:"approved", flawed_rule:"External promises can be maintained without internal support or delivery during encounters."}}, {misconception_id:"MISC_SERVICE_PERISHABILITY_DIAGNOSTIC_MISCONCEPTION_5_3ADE38", properties:{kc_id:"1ba99a18-859c-50df-8524-0669225238bf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"service perishability: diagnostic misconception 565", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.1. concept that states services cannot be stored in inventory for future use or sale", status:"approved", flawed_rule:"An unsold service appointment can be stored and sold at a later date unchanged."}}, {misconception_id:"MISC_SERVICE_VARIABILITY_DIAGNOSTIC_MISCONCEPTION_566_FD9E30", properties:{kc_id:"fffffb3b-22ae-51fe-89d5-05bc5255a8c2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"service variability in chapter 11 Closing Company Case task 2: diagnostic misconception 1780", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, Closing Company Case, task 2. concept that states the quality of the service depends on who, when, where, and how it is provided", status:"approved", flawed_rule:"A single provider always delivers identical service regardless of time and circumstances."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_SERVICE_PROFIT_CHAIN_MODEL_DIAGNOSTIC_MISCONCEPT_68682E", properties:{kc_id:"1a7c0a24-b738-5874-8257-3339a0ba620b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"service-profit chain model: diagnostic misconception 567", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.2. model that establishes relationships between profitability, employee satisfaction, loyalty, and productivity", status:"approved", flawed_rule:"Customer profit can be improved independently of employee conditions and service value."}}, {misconception_id:"MISC_TANGIBLES_DIAGNOSTIC_MISCONCEPTION_569_AF12B6", properties:{kc_id:"de635425-ae8a-5fc1-802c-2c3bb9e0fe64", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"tangibles: diagnostic misconception 569", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11 Key Terms, printed page 398, and section 11.3. in terms of the RATER model, the physical appearance of both the facility and its employees", status:"approved", flawed_rule:"Intangible services have no physical cues customers can use to judge quality."}}, {misconception_id:"MISC_ARTIFICIAL_TIME_CONSTRAINTS_DIAGNOSTIC_MISCONCEP_2A9197", properties:{kc_id:"e1104e7a-4127-5ca7-88f0-b08e978cf099", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"artificial time constraints: diagnostic misconception 570", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.1. pricing strategy that creates a sense of urgency in buyers’ minds", status:"approved", flawed_rule:"A fabricated deadline is harmless merely because it increases urgency."}}, {misconception_id:"MISC_BREAK_EVEN_PRICING_DIAGNOSTIC_MISCONCEPTION_571_0192E6", properties:{kc_id:"b63be0c6-ab71-592d-8dc7-a0080cc16f5c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"break-even pricing in chapter 12 Critical Thinking Exercises task 2: diagnostic misconception 1788", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12, Critical Thinking Exercises, task 2. pricing strategy in which marketers choose a price that will cover all the costs of manufacturing", status:"approved", flawed_rule:"Covering production costs guarantees a positive profit."}}, {misconception_id:"MISC_BUNDLE_PRICING_DIAGNOSTIC_MISCONCEPTION_572_30896F", properties:{kc_id:"b4f7ece5-9689-5980-ba69-ed990f563e05", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"bundle pricing in chapter 12 Closing Company Case task 4: diagnostic misconception 1796", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12, Closing Company Case, task 4. pricing strategy that promotes purchasing multiple items at once; used to prod customers to purchase (and spend) more than they may have otherwise", status:"approved", flawed_rule:"A bundle always saves every customer money regardless of whether all items are needed."}}, {misconception_id:"MISC_COMPETITION_BASED_OBJECTIVE_DIAGNOSTIC_MISCONCEP_356AC1", properties:{kc_id:"129c3543-ae8d-58e0-8fb2-238c41f8ece2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"competition-based objective: diagnostic misconception 573", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. product pricing based on the prices of a company’s competitors", status:"approved", flawed_rule:"Competitors' prices reveal the seller's own costs and customers' willingness to pay."}}, {misconception_id:"MISC_CONSUMER_CONFIDENCE_DIAGNOSTIC_MISCONCEPTION_574_02E42E", properties:{kc_id:"4f280ee1-95ea-5769-84fa-f80a70c1d2b8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"consumer confidence: diagnostic misconception 574", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. an economic indicator that measures the degree of optimism that consumers have regarding the overall state of the country’s economy and their own financial situations", status:"approved", flawed_rule:"Consumer confidence is identical to current disposable income."}}, {misconception_id:"MISC_COST_BASED_OBJECTIVE_DIAGNOSTIC_MISCONCEPTION_57_F58B6A", properties:{kc_id:"80a63d03-7d24-5984-9c56-a2f3a963c501", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cost-based objective: diagnostic misconception 575", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. product pricing based on the costs of doing business", status:"approved", flawed_rule:"Adding a markup guarantees sufficient customer demand."}}, {misconception_id:"MISC_CROSS_ELASTICITY_OF_DEMAND_DIAGNOSTIC_MISCONCEPT_FDF5A7", properties:{kc_id:"41f8aa6e-08ff-5fdc-b1d9-665522f14713", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cross-elasticity of demand: diagnostic misconception 576", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. The responsiveness of demand for one offering to a change in another offering’s price. Source caution: the glossary describes a price-to-price change; the learnable demand relationship concerns quantity demanded relative to another price, not merely two prices.", status:"approved", flawed_rule:"Cross-elasticity measures a change in one price divided by another price change."}}, {misconception_id:"MISC_CUSTOMER_VALUE_BASED_OBJECTIVE_DIAGNOSTIC_MISCON_DD43DB", properties:{kc_id:"e3930a2c-043e-53e5-ba4b-730148bf05e3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"customer value–based objective in chapter 12 Marketing Plan Exercise task 1: diagnostic misconception 1792", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12, Marketing Plan Exercise, task 1. product pricing based on a company’s understanding of the value-added benefits of a product", status:"approved", flawed_rule:"Customer value-based pricing must start from production cost alone."}}, {misconception_id:"MISC_CUSTOMER_DRIVEN_OBJECTIVE_DIAGNOSTIC_MISCONCEPTI_67A563", properties:{kc_id:"c918099a-049f-5f11-b63f-c852275614cc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer-driven objective: diagnostic misconception 578", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. product pricing based on what a customer is willing to pay for a product or service", status:"approved", flawed_rule:"What a customer is willing to pay is necessarily the firm's production cost."}}, {misconception_id:"MISC_DECEPTIVE_PRICE_ADVERTISING_DIAGNOSTIC_MISCONCEP_88B343", properties:{kc_id:"f846d95c-a832-5ce2-984f-6c38736adf30", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"deceptive price advertising: diagnostic misconception 579", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.6. an unethical pricing practice in which the advertised price of a product is misleading to consumers", status:"approved", flawed_rule:"A low headline price is honest even when unavoidable charges are hidden."}}, {misconception_id:"MISC_DEMAND_DIAGNOSTIC_MISCONCEPTION_580_A11219", properties:{kc_id:"8925463f-2c96-5110-92b7-8173e5f5cc3a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"demand: diagnostic misconception 580", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. a buyer’s ability and willingness to purchase a specific product or service", flawed_rule:"Desire without purchasing ability is sufficient to establish effective demand.", status:"approved"}}, {misconception_id:"MISC_DEMAND_CURVE_DIAGNOSTIC_MISCONCEPTION_581_A2F501", properties:{kc_id:"8e95b1af-c79f-515a-ad6b-7326f0541939", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"demand curve: diagnostic misconception 581", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. a graph that illustrates the relationship between demand and price", status:"approved", flawed_rule:"A demand curve shows production cost as output rises."}}, {misconception_id:"MISC_DEMAND_ELASTICITY_DIAGNOSTIC_MISCONCEPTION_582_B53870", properties:{kc_id:"9e1b2a8d-60f1-569e-a3cf-4209b77d4645", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"demand elasticity: diagnostic misconception 582", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. measure of the change in the quantity demanded in relation to the change in its price", status:"approved", flawed_rule:"Elasticity is the absolute number of units sold rather than proportional responsiveness."}}, {misconception_id:"MISC_ECONOMY_PRICING_DIAGNOSTIC_MISCONCEPTION_584_13CE2B", properties:{kc_id:"6e167aac-68ca-548f-9376-bf424c577505", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"economy pricing: diagnostic misconception 584", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.5. setting a price much lower than competitors to sell high volumes of a product", status:"approved", flawed_rule:"Economy pricing relies on exclusivity and high prestige margins."}}, {misconception_id:"MISC_FIXED_COSTS_DIAGNOSTIC_MISCONCEPTION_585_18DF03", properties:{kc_id:"721f2c55-9cfd-56d8-95c8-f5cf24ebc29b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"fixed costs: diagnostic misconception 585", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. costs of doing business that do not change based on number of units produced", status:"approved", flawed_rule:"Fixed costs per unit stay constant as production volume changes."}}, {misconception_id:"MISC_INCOME_EFFECT_DIAGNOSTIC_MISCONCEPTION_586_335B57", properties:{kc_id:"be7e4b91-634f-50f9-8a92-1449f4f2008f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"income effect: diagnostic misconception 586", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. the perception buyers have of how price changes will affect their income", status:"approved", flawed_rule:"A price change cannot affect the consumer's real purchasing power."}}, {misconception_id:"MISC_INFLATION_DIAGNOSTIC_MISCONCEPTION_587_23B1B5", properties:{kc_id:"aba85de0-f404-5d13-b7ea-50e27996a825", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"inflation: diagnostic misconception 587", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. an economic measure of the rate of rising prices of goods and services in an economy", status:"approved", flawed_rule:"An increase in one product's price alone proves economy-wide inflation."}}, {misconception_id:"MISC_MARKET_SHARE_ORIENTED_OBJECTIVE_DIAGNOSTIC_MISCO_773ADD", properties:{kc_id:"64871246-bf2d-5b78-9079-48901452db22", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"market share–oriented objective: diagnostic misconception 588", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. setting prices at, below, or above competitors in an effort to increase market share", status:"approved", flawed_rule:"A market-share pricing objective necessarily maximizes short-term profit."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_MONOPOLY_GOUGING_DIAGNOSTIC_MISCONCEPTION_589_A9D50E", properties:{kc_id:"9810ba22-4d9b-544c-9a43-35d2373a9ef1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"monopoly gouging: diagnostic misconception 589", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.6. when a seller increases the prices of goods and services that are not considered fair or competitive", status:"approved", flawed_rule:"Lack of competition makes any charged price ethically unproblematic."}}, {misconception_id:"MISC_ODD_EVEN_PRICING_DIAGNOSTIC_MISCONCEPTION_590_11D302", properties:{kc_id:"fb807032-bd76-50d7-97cf-d045c8e704e6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"odd-even pricing in chapter 12 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1786", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12, Applied Marketing Knowledge: Discussion Questions, task 4. psychological pricing strategy that uses prices that end with odd or even numbers to attract customers", status:"approved", flawed_rule:"A price ending in nine changes a product's underlying production cost."}}, {misconception_id:"MISC_PENETRATION_PRICING_DIAGNOSTIC_MISCONCEPTION_591_952F66", properties:{kc_id:"414a1a35-7df2-5d17-add6-8de8eaa972a1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"penetration pricing: diagnostic misconception 591", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.4. new product or service strategy that sets the lowest price possible in order to reach the majority of the market in the introduction stage", status:"approved", flawed_rule:"Penetration pricing begins high to recover investment from a small premium segment."}}, {misconception_id:"MISC_PREDATORY_PRICING_DIAGNOSTIC_MISCONCEPTION_592_E66241", properties:{kc_id:"8bb2be40-c5c8-52d5-9d48-a039ca8d6573", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"predatory pricing: diagnostic misconception 592", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.6. when a company prices goods or services so low that other companies cannot compete", status:"approved", flawed_rule:"Every competitive discount is necessarily predatory pricing."}}, {misconception_id:"MISC_PRESTIGE_PRICING_DIAGNOSTIC_MISCONCEPTION_593_E77B3E", properties:{kc_id:"e2d4896b-2212-53e6-8519-e4ae5b7c0684", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"prestige pricing: diagnostic misconception 593", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. a strategy marketers use to set high prices knowing that demand will increase with higher prices because the higher price increases the perceived value of the product", status:"approved", flawed_rule:"Customers always interpret a higher price as lower value."}}, {misconception_id:"MISC_PRICE_ANCHORING_DIAGNOSTIC_MISCONCEPTION_595_E4F87B", properties:{kc_id:"1463ad9a-8bcd-5b57-a0a5-aeeb4021efad", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"price anchoring: diagnostic misconception 595", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.1. a frame of reference for a buyer to set an expectation of a price", status:"approved", flawed_rule:"A reference price has no influence on how buyers judge an offer."}}, {misconception_id:"MISC_PRICE_APPEARANCE_DIAGNOSTIC_MISCONCEPTION_596_B29417", properties:{kc_id:"b0fbf8c8-15da-58de-84f1-887c3f6b57ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"price appearance: diagnostic misconception 596", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.1. the way in which a customer perceives a price based on how it is visually represented", status:"approved", flawed_rule:"Price typography and presentation cannot influence perceived expense."}}, {misconception_id:"MISC_PRICE_DISCRIMINATION_DIAGNOSTIC_MISCONCEPTION_59_8F307C", properties:{kc_id:"cefcb6c0-71b5-5332-a373-7b21db62c439", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"price discrimination: diagnostic misconception 597", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.6. selling goods and services at different prices to different customers", status:"approved", flawed_rule:"Any difference in customer prices has identical ethical and legal implications."}}, {misconception_id:"MISC_PRICE_FIXING_DIAGNOSTIC_MISCONCEPTION_598_95264E", properties:{kc_id:"00217b5a-2658-5c04-806c-0e627c89895a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"price fixing: diagnostic misconception 598", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.6. two or more companies agreeing to set certain prices in the market", status:"approved", flawed_rule:"Competitors jointly agreeing prices is equivalent to independently following market conditions."}}, {misconception_id:"MISC_PRICE_GOUGING_DIAGNOSTIC_MISCONCEPTION_599_2F6409", properties:{kc_id:"5dffc3ed-404f-5562-85a1-393c897b4241", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"price gouging: diagnostic misconception 599", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.1. when companies take advantage of a situation, typically an emergency or natural disaster, and charge exceptionally high prices for products or services", status:"approved", flawed_rule:"Any price rise and emergency exploitation are indistinguishable."}}, {misconception_id:"MISC_PRICE_SKIMMING_DIAGNOSTIC_MISCONCEPTION_600_BCF03F", properties:{kc_id:"c2998542-f37e-5c3e-b013-0fff3a7d62d7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"price skimming in chapter 12 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1784", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12, Applied Marketing Knowledge: Discussion Questions, task 2. pricing strategy in which a company initially sets a high price for a product or service and lowers it over time as new segments of the market are reached", status:"approved", flawed_rule:"Skimming starts with a low mass-market price and raises it over time."}}, {misconception_id:"MISC_PRODUCT_LINE_PRICING_DIAGNOSTIC_MISCONCEPTION_60_43C32A", properties:{kc_id:"1128e7f2-fbe3-5a6f-a043-a0a96ef21721", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product line pricing: diagnostic misconception 601", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.5. setting a higher price for some product lines and lower price points for others in order to capture various target markets", status:"approved", flawed_rule:"All models in a product range should have identical prices regardless of benefits."}}, {misconception_id:"MISC_PROFIT_DIAGNOSTIC_MISCONCEPTION_602_1260C0", properties:{kc_id:"a3d04248-5237-5ac4-9c40-0fe7bf6d7791", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"profit: diagnostic misconception 602", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.1. the financial gain of a company", flawed_rule:"Revenue is profit before subtracting costs.", status:"approved"}}, {misconception_id:"MISC_SALES_ORIENTED_OBJECTIVE_DIAGNOSTIC_MISCONCEPTIO_480F5D", properties:{kc_id:"3c2e37e3-d906-5aee-bbd7-6e866a36c789", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"sales-oriented objective: diagnostic misconception 603", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. setting prices based on the goal of increasing the volume of sales", status:"approved", flawed_rule:"Maximizing unit sales necessarily maximizes profit."}}, {misconception_id:"MISC_SUBSTITUTES_DIAGNOSTIC_MISCONCEPTION_604_3537C6", properties:{kc_id:"f8cc3403-eea0-518b-a51c-e5c70a15964e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"substitutes: diagnostic misconception 604", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. products and services that are similar to the one being offered", status:"approved", flawed_rule:"Only an identical branded product can substitute for the customer's need."}}, {misconception_id:"MISC_TARGET_RETURN_OBJECTIVE_DIAGNOSTIC_MISCONCEPTION_986645", properties:{kc_id:"1e8d81ac-d4c5-5762-a149-fe2cf73083ef", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"target return objective: diagnostic misconception 605", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. setting prices so they return a specific profit during a given period of time", status:"approved", flawed_rule:"A target return can be evaluated without a time horizon or invested amount."}}, {misconception_id:"MISC_TOTAL_COSTS_DIAGNOSTIC_MISCONCEPTION_606_351ADB", properties:{kc_id:"5b906b07-0326-5279-ac6d-4539a6ed752e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"total costs: diagnostic misconception 606", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.1. total expenses of doing business", status:"approved", flawed_rule:"Total costs include fixed expenses but exclude variable production expenses."}}, {misconception_id:"MISC_TOTAL_REVENUE_DIAGNOSTIC_MISCONCEPTION_607_C8FD62", properties:{kc_id:"27dd1a72-7eac-5a92-9166-fd70ee8f18d3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"total revenue: diagnostic misconception 607", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.1. the money generated from normal business operations", status:"approved", flawed_rule:"Total revenue is the money left after all expenses."}}, {misconception_id:"MISC_UNEMPLOYMENT_RATE_DIAGNOSTIC_MISCONCEPTION_608_3C4534", properties:{kc_id:"f36f7649-3c7c-5e23-a3cb-a7646b043092", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"unemployment rate: diagnostic misconception 608", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. A measure of unemployment within the relevant labor force, used in section 12.3 to assess economic conditions. Distinguish unemployed people in the labor force from everyone outside paid work; the glossary’s shorthand does not provide the full denominator.", status:"approved", flawed_rule:"Everyone outside paid employment belongs to the measured unemployed labor force."}}, {misconception_id:"MISC_VARIABLE_COSTS_DIAGNOSTIC_MISCONCEPTION_609_80BC14", properties:{kc_id:"f3893ba9-51ef-536f-9584-e2e40d01f647", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"variable costs: diagnostic misconception 609", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12 Key Terms, printed page 430, and section 12.3. costs that vary based on the number of units produced", status:"approved", flawed_rule:"Variable costs remain unchanged in total as output rises."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_5A_FRAMEWORK_DIAGNOSTIC_MISCONCEPTION_610_8DFAC8", properties:{kc_id:"ba749f50-2441-572d-995b-6497bdf4a75f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"5A framework in chapter 13 What Do Marketers Do? task 5: diagnostic misconception 1809", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 13, What Do Marketers Do?, task 5. map of the consumer’s various need states as they find out about a product and finally decide to purchase", status:"approved", flawed_rule:"Awareness alone completes the customer journey to advocacy."}}, {misconception_id:"MISC_ADVERTISING_DIAGNOSTIC_MISCONCEPTION_611_10AD5A", properties:{kc_id:"44a3e8c8-a152-5b6f-a958-9bbf26c21f61", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"advertising in chapter 14 Closing Company Case task 2: diagnostic misconception 1832", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 14, Closing Company Case, task 2. paid communication messages that identify a brand or organization and are intended to reach a large number of recipients", status:"approved", flawed_rule:"Every favorable media mention is paid advertising."}}, {misconception_id:"MISC_BUY_ONE_GET_ONE_BOGO_DIAGNOSTIC_MISCONCEPTION_61_69E912", properties:{kc_id:"bb7a288e-ab20-5149-831e-fb5fca59c9e8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"buy one get one (BOGO) in chapter 13 What Do Marketers Do? task 1: diagnostic misconception 1805", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 13, What Do Marketers Do?, task 1. promotion strategy in which consumers are offered the opportunity to buy one product at regular price and get a second item free", status:"approved", flawed_rule:"A BOGO offer necessarily generates profit regardless of product cost and cannibalization."}}, {misconception_id:"MISC_COMMUNICATION_CHANNEL_DIAGNOSTIC_MISCONCEPTION_6_4D7A75", properties:{kc_id:"d8a5ecea-916e-5b67-8180-f3324bd4fa42", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"communication channel in chapter 13 Closing Company Case task 3: diagnostic misconception 1814", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 13, Closing Company Case, task 3. delivery mechanism that takes the message from the company to the consumer", status:"approved", flawed_rule:"A communication channel is the audience's interpretation of the message."}}, {misconception_id:"MISC_CONTINUOUS_PROMOTIONAL_SCHEDULE_DIAGNOSTIC_MISCO_8517F1", properties:{kc_id:"a516a39e-7267-5950-adfa-29088bf587bf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"continuous promotional schedule: diagnostic misconception 614", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. process of conducting promotions year-round on a regular schedule", status:"approved", flawed_rule:"Continuous scheduling means advertising only in occasional bursts."}}, {misconception_id:"MISC_COUPONS_DIAGNOSTIC_MISCONCEPTION_615_84B49D", properties:{kc_id:"0868a787-a61c-59d5-8b31-d7258825f76d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"coupons: diagnostic misconception 615", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.1. sales promotion strategy that works to induce a consumer to buy a product based on a price reduction", status:"approved", flawed_rule:"Coupons and rebates require the same timing and consumer actions."}}, {misconception_id:"MISC_CREATIVE_STRATEGY_DIAGNOSTIC_MISCONCEPTION_616_65E892", properties:{kc_id:"1c560fef-ddd0-5dd7-859e-9fc0ecb75be7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"creative strategy: diagnostic misconception 616", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. method of translating a message into words, images, and sounds", status:"approved", flawed_rule:"Creative strategy determines the target segment rather than how the message is expressed."}}, {misconception_id:"MISC_DECODING_DIAGNOSTIC_MISCONCEPTION_617_64F16B", properties:{kc_id:"5a33f67e-dbf4-511d-b5e6-538f777ee883", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"decoding: diagnostic misconception 617", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.2. method of transforming and interpreting a message", status:"approved", flawed_rule:"The receiver's interpretation necessarily matches the sender's intended meaning."}}, {misconception_id:"MISC_DIRECT_MARKETING_DIAGNOSTIC_MISCONCEPTION_618_D95D75", properties:{kc_id:"e8d1d878-34f0-5785-9afc-4dd7a9ab4a2b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"direct marketing in chapter 16 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1853", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, Applied Marketing Knowledge: Discussion Questions, task 1. using communication tools that directly engage with individual consumers for the ultimate purpose of calling them to take some marketing action", status:"approved", flawed_rule:"Direct marketing cannot use television or print."}}, {misconception_id:"MISC_EMOTIONAL_APPEALS_DIAGNOSTIC_MISCONCEPTION_619_564885", properties:{kc_id:"f33afd58-c5a8-5020-9056-cc01ac9facde", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"emotional appeals: diagnostic misconception 619", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. advertising messages that appeal to human emotions", status:"approved", flawed_rule:"An emotional appeal must contain no relevant product benefit."}}, {misconception_id:"MISC_ENCODING_DIAGNOSTIC_MISCONCEPTION_620_7EF70D", properties:{kc_id:"4f885f9d-42f2-5d2f-9614-04028f29b0af", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"encoding in chapter 13 Closing Company Case task 1: diagnostic misconception 1812", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, Closing Company Case, task 1. process of putting ideas and thoughts into a transmittable form", status:"approved", flawed_rule:"Encoding is the recipient's interpretation rather than the sender's formulation."}}, {misconception_id:"MISC_ENTER_TO_WIN_DIAGNOSTIC_MISCONCEPTION_621_7EF7A9", properties:{kc_id:"882c8ce2-4089-5d96-b794-addaddde0815", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"enter to win in chapter 13 What Do Marketers Do? task 6: diagnostic misconception 1810", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, What Do Marketers Do?, task 6. promotion strategy where consumers must complete entry requirements for a chance to win something of value from a company", status:"approved", flawed_rule:"Entering a promotion guarantees that each participant receives a prize."}}, {misconception_id:"MISC_FEAR_APPEALS_DIAGNOSTIC_MISCONCEPTION_622_71221F", properties:{kc_id:"cffe665c-138e-59f5-82ac-65ab9d3eb382", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"fear appeals: diagnostic misconception 622", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. campaigns that seek to change behavior through fear", status:"approved", flawed_rule:"Increasing fear indefinitely always increases persuasion."}}, {misconception_id:"MISC_FEEDBACK_LOOP_DIAGNOSTIC_MISCONCEPTION_623_89D2C6", properties:{kc_id:"9e373382-d5bc-5bd7-a71e-8942c6076b9d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"feedback loop: diagnostic misconception 623", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.2. notification that the message has been received between the sender and the receiver", status:"approved", flawed_rule:"A sent message proves the recipient understood it without any response evidence."}}, {misconception_id:"MISC_FLIGHTING_PROMOTION_SCHEDULE_DIAGNOSTIC_MISCONCE_9604DA", properties:{kc_id:"20802c1a-0ea7-501b-8b25-f2dbb642a722", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"flighting promotion schedule: diagnostic misconception 624", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.1. process of running a period of heavy promotions and then going for a period of time without any promotional messaging", status:"approved", flawed_rule:"Flighting means maintaining a constant low level between campaign peaks."}}, {misconception_id:"MISC_INTEGRATED_MARKETING_COMMUNICATIONS_DIAGNOSTIC_M_27F95C", properties:{kc_id:"ee094cb8-3074-58fd-9406-e74b9fa1c5db", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"integrated marketing communications in chapter 13 Critical Thinking Exercises task 2: diagnostic misconception 1802", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, Critical Thinking Exercises, task 2. development and execution of multiple promotional methods that include a coordinated message", status:"approved", flawed_rule:"Using several channels is sufficient even when their messages contradict one another."}}, {misconception_id:"MISC_INTERNET_DIGITAL_MARKETING_DIAGNOSTIC_MISCONCEPT_13D20D", properties:{kc_id:"1eec5dd1-e117-5986-98af-fa91adf7aee4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Internet/digital marketing: diagnostic misconception 627", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.1. promotional method that utilizes the Internet and digital technology such as text messaging, phone applications, and social media to reach consumers", status:"approved", flawed_rule:"Digital promotion consists exclusively of banner advertisements."}}, {misconception_id:"MISC_MEDIUM_DIAGNOSTIC_MISCONCEPTION_629_9BDBCA", properties:{kc_id:"b595df41-b482-5ad4-9ccb-43596251e3bb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"medium: diagnostic misconception 629", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. various methods of communicating with a target audience; may include broadcast, print, outdoor, and other forms", flawed_rule:"Choosing a medium automatically determines whether the audience understands the message.", status:"approved"}}, {misconception_id:"MISC_MESSAGE_STRATEGY_DIAGNOSTIC_MISCONCEPTION_630_3B117F", properties:{kc_id:"470014ce-f850-5fbf-acc4-5348c2f7248c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"message strategy in chapter 13 What Do Marketers Do? task 4: diagnostic misconception 1808", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, What Do Marketers Do?, task 4. method of developing a message based on how the message will best tie the brand to the target market", status:"approved", flawed_rule:"A message strategy is only a choice of font, color, and production technique."}}, {misconception_id:"MISC_MORAL_APPEAL_DIAGNOSTIC_MISCONCEPTION_631_DCAE11", properties:{kc_id:"73444ba6-27ed-5071-950f-057ea0fa82ff", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"moral appeal in chapter 13 Closing Company Case task 4: diagnostic misconception 1815", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, Closing Company Case, task 4. information communicated to the consumer to appeal to their sense of right and wrong", status:"approved", flawed_rule:"Moral appeals use price and functional performance alone."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_NOISE_DIAGNOSTIC_MISCONCEPTION_632_A59732", properties:{kc_id:"153f8721-4b29-5cf8-80f2-1af2a1528092", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"noise in chapter 13 Closing Company Case task 2: diagnostic misconception 1813", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, Closing Company Case, task 2. unplanned distractions that interfere with the communication between a sender and a receiver", status:"approved", flawed_rule:"Noise means only audible sound and excludes competing or distorted messages."}}, {misconception_id:"MISC_PAID_SPONSORSHIP_DIAGNOSTIC_MISCONCEPTION_633_FE9A93", properties:{kc_id:"a6d9516f-e8e6-5ee7-9eeb-c2af298bbeeb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"paid sponsorship in chapter 13 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1800", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, Applied Marketing Knowledge: Discussion Questions, task 4. when a person promoting a product is paid by the company to make the endorsement", status:"approved", flawed_rule:"A paid endorsement can be presented as an independent unpaid recommendation without concern."}}, {misconception_id:"MISC_PERSONAL_SELLING_DIAGNOSTIC_MISCONCEPTION_634_C070E7", properties:{kc_id:"9ba82f5d-8c04-53ce-863b-3e6ad27da954", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"personal selling in chapter 15 What Do Marketers Do? task 2: diagnostic misconception 1844", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, What Do Marketers Do?, task 2. communication between a buyer and seller. The primary responsibility is to build a relationship with the buyer.", status:"approved", flawed_rule:"Personal selling is anonymous mass communication rather than an interpersonal exchange."}}, {misconception_id:"MISC_PROMOTION_MIX_DIAGNOSTIC_MISCONCEPTION_635_554052", properties:{kc_id:"52403fc2-2c36-533d-b487-574d96db9e9f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"promotion mix in chapter 13 Marketing Plan Exercise task 1: diagnostic misconception 1811", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13, Marketing Plan Exercise, task 1. tactics marketers use to communicate with the customer", status:"approved", flawed_rule:"The promotion mix and the entire four-P marketing mix are identical."}}, {misconception_id:"MISC_PROMOTIONAL_MIX_ELEMENTS_DIAGNOSTIC_MISCONCEPTIO_BD608F", properties:{kc_id:"b4015feb-fc03-5eb7-9bcc-09f08fee6ee9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"promotional mix elements: diagnostic misconception 636", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.1. tactics to communicate with the customer including advertising, sales promotion, personal selling, public relations, and direct marketing", status:"approved", flawed_rule:"Every promotional tool has the same cost, reach, and personal interaction."}}, {misconception_id:"MISC_PUBLIC_RELATIONS_DIAGNOSTIC_MISCONCEPTION_637_6F24D3", properties:{kc_id:"8526a83d-db0f-510b-a7b4-b67bb5ed8b43", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"public relations in chapter 14 Critical Thinking Exercises task 4: diagnostic misconception 1823", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14, Critical Thinking Exercises, task 4. Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_PUFFERY_DIAGNOSTIC_MISCONCEPTION_638_06215C", properties:{kc_id:"5c1d035c-54c6-5f77-917e-a0806fee82dc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"puffery: diagnostic misconception 638", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.5. providing unrealistic and unsubstantiated claims about a product", status:"approved", flawed_rule:"Any measurable factual claim can be dismissed as harmless exaggeration."}}, {misconception_id:"MISC_PULSING_SCHEDULE_DIAGNOSTIC_MISCONCEPTION_639_C11D99", properties:{kc_id:"d0280934-539c-568f-9507-6ec21d513ad7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"pulsing schedule: diagnostic misconception 639", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. process of running steady promotions followed by a period of heavy promotions", status:"approved", flawed_rule:"Pulsing turns promotion completely off between periods of heavy activity."}}, {misconception_id:"MISC_RATIONAL_APPEALS_DIAGNOSTIC_MISCONCEPTION_640_901286", properties:{kc_id:"a69ec8fa-1cba-5136-9453-021db1e95bf1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"rational appeals: diagnostic misconception 640", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. information communicated to the consumer based on how they will benefit", status:"approved", flawed_rule:"Rational appeals depend only on mood and unrelated emotion."}}, {misconception_id:"MISC_REBATES_DIAGNOSTIC_MISCONCEPTION_641_428B60", properties:{kc_id:"0857462e-8e6c-5894-8b33-0edf3dce2732", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"rebates in chapter 15 What Do Marketers Do? task 1: diagnostic misconception 1843", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, What Do Marketers Do?, task 1. a form of promotion that rewards consumers for sending information to the company", status:"approved", flawed_rule:"Every advertised rebate automatically reduces the price at checkout."}}, {misconception_id:"MISC_RECEIVER_DIAGNOSTIC_MISCONCEPTION_642_97497E", properties:{kc_id:"157007ec-8338-5db5-9ad6-cbced84a9107", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"receiver: diagnostic misconception 642", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.2. intended message recipient", status:"approved", flawed_rule:"The sender controls the receiver's interpretation without feedback."}}, {misconception_id:"MISC_RETURN_ON_CUSTOMER_INVESTMENT_ROCI_DIAGNOSTIC_MI_DD4585", properties:{kc_id:"eb8da405-085b-5bd4-98d8-00db636eb7ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"return on customer investment (ROCI): diagnostic misconception 643", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.4. a marginal analysis that shows the efficiency of marketing communication spending", status:"approved", flawed_rule:"Communication efficiency can be assessed from spending alone without customer returns."}}, {misconception_id:"MISC_SALES_PROMOTION_DIAGNOSTIC_MISCONCEPTION_644_AAD051", properties:{kc_id:"99df8e89-cd72-5464-9f17-d50c7e1d51f0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sales promotion in chapter 15 Critical Thinking Exercises task 2: diagnostic misconception 1840", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, Critical Thinking Exercises, task 2. a short-term way of enticing the consumer to purchase a product or service", status:"approved", flawed_rule:"A temporary incentive necessarily creates durable brand loyalty."}}, {misconception_id:"MISC_SENDER_DIAGNOSTIC_MISCONCEPTION_645_6AB245", properties:{kc_id:"f797dc40-1770-5664-91bc-f9c3dd0fb66e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"sender: diagnostic misconception 645", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 13 Key Terms, printed page 467, and section 13.2. source of a message; can be an organization or person", flawed_rule:"The sender's intention is sufficient proof of successful communication.", status:"approved"}}, {misconception_id:"MISC_AIDED_RECALL_DIAGNOSTIC_MISCONCEPTION_647_FE4E24", properties:{kc_id:"3bec54f5-3b14-53fd-bbf9-e63761a90119", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"aided recall: diagnostic misconception 647", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of advertising posttest that uses cues to assist a sample audience in recalling brands and products in an advertisement", status:"approved", flawed_rule:"Prompted recollection demonstrates that a consumer remembered the brand unaided."}}, {misconception_id:"MISC_ALL_YOU_CAN_AFFORD_APPROACH_DIAGNOSTIC_MISCONCEP_2FF372", properties:{kc_id:"ab83efc4-4c2f-5648-9195-154c6a105fba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"all-you-can-afford approach in chapter 14 What Do Marketers Do? task 6: diagnostic misconception 1830", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14, What Do Marketers Do?, task 6. advertising budget approach that ensures everything else in the organization is budgeted for and then sets aside the remaining funds for advertising", status:"approved", flawed_rule:"An affordable advertising budget necessarily matches the resources needed to reach campaign objectives."}}, {misconception_id:"MISC_ATTITUDE_TESTS_DIAGNOSTIC_MISCONCEPTION_649_772979", properties:{kc_id:"7a326020-0f87-508e-b02c-96f27d780afc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"attitude tests: diagnostic misconception 649", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of advertising posttest that investigates the attitudes of a sample target audience toward a product or service", status:"approved", flawed_rule:"Positive attitudes alone prove that advertising caused additional purchases."}}, {misconception_id:"MISC_BRAND_AWARENESS_DIAGNOSTIC_MISCONCEPTION_650_238EA6", properties:{kc_id:"0a429e62-5ab1-5366-824a-87e8ee423082", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"brand awareness in chapter 14 Closing Company Case task 3: diagnostic misconception 1833", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14, Closing Company Case, task 3. metric used to determine if audiences can recall information about a brand", status:"approved", flawed_rule:"Brand awareness and confirmed sales conversion are the same outcome."}}, {misconception_id:"MISC_BRAND_RECOGNITION_DIAGNOSTIC_MISCONCEPTION_651_66EC15", properties:{kc_id:"88941862-a4f9-594d-a5bd-5e33950dbea1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"brand recognition: diagnostic misconception 651", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.3. the ability of a campaign audience to recognize and identify a specific brand", status:"approved", flawed_rule:"Recognizing a logo proves unaided recall of its campaign message."}}, {misconception_id:"MISC_COMPARATIVE_ADVERTISING_DIAGNOSTIC_MISCONCEPTION_89F3C5", properties:{kc_id:"942e93b4-9baa-5ad3-8034-07baca24b72f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"comparative advertising: diagnostic misconception 652", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. type of advertising that showcases the benefits and values of one product as compared to its competitors", status:"approved", flawed_rule:"Comparative advertising can make any rival claim without evidence."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_COMPETITIVE_PARITY_APPROACH_DIAGNOSTIC_MISCONCEP_873CE6", properties:{kc_id:"26fcccdd-d60d-550f-91d6-0d6ffa816f9f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"competitive-parity approach: diagnostic misconception 653", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. advertising budget strategy that relies on setting budgets based on the expected budgets of competitors", status:"approved", flawed_rule:"Matching a competitor's spending guarantees equally effective advertising."}}, {misconception_id:"MISC_CONVERSION_RATE_DIAGNOSTIC_MISCONCEPTION_654_EDCDED", properties:{kc_id:"6c338792-9e49-597b-a8e3-e8f62d683d87", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"conversion rate: diagnostic misconception 654", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.3. the percentage of an audience that has completed a desired action", status:"approved", flawed_rule:"Conversion rate is the raw number of impressions delivered."}}, {misconception_id:"MISC_ENGAGEMENT_DIAGNOSTIC_MISCONCEPTION_655_2B8F43", properties:{kc_id:"f734aea5-1f39-5d5d-8ede-cf7b508e7280", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"engagement: diagnostic misconception 655", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. any interaction with advertising content", status:"approved", flawed_rule:"Every interaction with an advertisement is a completed purchase."}}, {misconception_id:"MISC_IMPACT_DIAGNOSTIC_MISCONCEPTION_657_4295E3", properties:{kc_id:"80b89035-7e0e-53a8-bcff-32a08b447ebd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"impact: diagnostic misconception 657", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.4. how quickly members of the audience receive an advertising message", flawed_rule:"Exposure or fast message delivery alone proves persuasion and sales effectiveness.", status:"approved"}}, {misconception_id:"MISC_IMPRESSIONS_DIAGNOSTIC_MISCONCEPTION_658_6F17C8", properties:{kc_id:"8b7926ca-a392-5656-bfcd-8fbae9fe8b8b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"impressions: diagnostic misconception 658", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.3. quantifying how many times an advertisement appears in a medium", status:"approved", flawed_rule:"One thousand impressions necessarily represent one thousand distinct people."}}, {misconception_id:"MISC_INFORMATIVE_ADVERTISING_DIAGNOSTIC_MISCONCEPTION_F84BDC", properties:{kc_id:"b41af69c-e1d7-5a43-a301-6b463721c02e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"informative advertising: diagnostic misconception 659", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of advertising intended to raise awareness of a product through educational communication to increase demand of the product", status:"approved", flawed_rule:"Informative advertising is intended only to remind established customers."}}, {misconception_id:"MISC_INQUIRY_TEST_DIAGNOSTIC_MISCONCEPTION_660_D39BE6", properties:{kc_id:"7fe5625b-de57-57d7-bd50-837f19c23461", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"inquiry test: diagnostic misconception 660", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of advertising posttest that runs two or more similar ads on a limited scale and determines which of the ads are most recalled by and effective for respondents", status:"approved", flawed_rule:"Inquiry tests establish full-market sales without measuring limited responses."}}, {misconception_id:"MISC_INSTITUTIONAL_ADVERTISEMENTS_DIAGNOSTIC_MISCONCE_3E61CC", properties:{kc_id:"098a1d8d-08a5-5452-b17b-43e642ef8659", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"institutional advertisements: diagnostic misconception 661", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.1. advertisements intended to create a positive image or support for an entire organization", status:"approved", flawed_rule:"Institutional advertising promotes only one product feature."}}, {misconception_id:"MISC_JURY_TESTS_DIAGNOSTIC_MISCONCEPTION_662_92D0B0", properties:{kc_id:"dd74f55c-a773-5ca7-b756-67e6c6d337df", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"jury tests: diagnostic misconception 662", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a form of pretesting in which the respondents discuss the advertisements that are most likely to induce a purchase", status:"approved", flawed_rule:"A small panel's preferred advertisement guarantees market-wide purchase behavior."}}, {misconception_id:"MISC_LOBBYING_DIAGNOSTIC_MISCONCEPTION_664_73C37E", properties:{kc_id:"4c270b1b-6c3c-5ca6-b413-c8560216f980", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"lobbying: diagnostic misconception 664", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.4. networking and other efforts that have the intention of influencing public policy and law", status:"approved", flawed_rule:"Lobbying and an ordinary consumer sales promotion are the same activity."}}, {misconception_id:"MISC_OBJECTIVE_AND_TASK_APPROACH_DIAGNOSTIC_MISCONCEP_6904BA", properties:{kc_id:"99d6dee3-f2bd-5129-a9dd-ed54e2123621", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"objective-and-task approach in chapter 14 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1817", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14, Applied Marketing Knowledge: Discussion Questions, task 2. advertising budget strategy that is based on the objectives set previously for the advertising plan", status:"approved", flawed_rule:"The budget should be fixed before defining objectives and necessary tasks."}}, {misconception_id:"MISC_PERCENTAGE_OF_SALES_APPROACH_DIAGNOSTIC_MISCONCE_B0F6FF", properties:{kc_id:"98c9fa7c-5927-5be3-870b-e2bf65398cef", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"percentage-of-sales approach: diagnostic misconception 666", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. advertising budget strategy that utilizes prior years’ sales or predicted year’s sales and sets a percentage of those sales aside for advertising", status:"approved", flawed_rule:"Basing advertising on sales cannot constrain promotion when sales decline."}}, {misconception_id:"MISC_PERSUASIVE_ADVERTISING_DIAGNOSTIC_MISCONCEPTION__812720", properties:{kc_id:"f1a76bdc-fc1a-51b3-8f2e-8300c79f3300", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"persuasive advertising: diagnostic misconception 667", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of advertising that aims to highlight the benefits of a product or service being advertised", status:"approved", flawed_rule:"Persuasive advertising merely supplies neutral awareness without seeking preference."}}, {misconception_id:"MISC_PORTFOLIO_TESTS_DIAGNOSTIC_MISCONCEPTION_668_838D46", properties:{kc_id:"90e171bd-8e35-533a-907f-acc56f668b20", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"portfolio tests: diagnostic misconception 668", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of advertising pretest that consists of respondents browsing through various versions of an advertisement and then being asked to recall certain details from each", status:"approved", flawed_rule:"Recall in a portfolio test proves real-market purchase behavior."}}, {misconception_id:"MISC_PRESS_RELATIONS_DIAGNOSTIC_MISCONCEPTION_669_B29ECC", properties:{kc_id:"4b980652-295e-598c-87e3-0de0bc4e614a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"press relations: diagnostic misconception 669", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.4. efforts to establish and maintain positive relationships with those in the media by sending press releases and other stories that help to maintain a positive image of the brand", status:"approved", flawed_rule:"Sending a press release gives the company control over the published story."}}, {misconception_id:"MISC_PRETESTING_ADVERTISING_DIAGNOSTIC_MISCONCEPTION__802086", properties:{kc_id:"44d5847b-71c3-54b4-b866-c89e54c58aee", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"pretesting advertising: diagnostic misconception 670", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. research that predicts the performance of an advertisement before it airs", status:"approved", flawed_rule:"Pretesting guarantees final campaign performance in the real market."}}, {misconception_id:"MISC_PRODUCT_ADVERTISEMENTS_DIAGNOSTIC_MISCONCEPTION__549634", properties:{kc_id:"d56da37d-582b-5883-91a6-aaef93669495", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product advertisements in chapter 14 Closing Company Case task 4: diagnostic misconception 1834", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14, Closing Company Case, task 4. advertisements that promote a specific product within the organization’s product mix", status:"approved", flawed_rule:"Product advertisements primarily promote an entire organization's public standing."}}, {misconception_id:"MISC_PUBLIC_AFFAIRS_DIAGNOSTIC_MISCONCEPTION_672_B6BB54", properties:{kc_id:"dc110e76-3908-566f-9925-d25db9e54d5b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"public affairs: diagnostic misconception 672", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.4. efforts to influence public policy and engage with public officials and trade associations", status:"approved", flawed_rule:"Public affairs is confined to product discount announcements."}}, {misconception_id:"MISC_PUBLICITY_DIAGNOSTIC_MISCONCEPTION_674_773A9B", properties:{kc_id:"8fa52922-3826-55d0-8371-24aebf09fadc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"publicity in chapter 14 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1819", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14, Applied Marketing Knowledge: Discussion Questions, task 4. notice or attention given by the media", status:"approved", flawed_rule:"Publicity is always favorable and fully controlled by the company."}}, {misconception_id:"MISC_PULL_STRATEGY_DIAGNOSTIC_MISCONCEPTION_675_3DC9B1", properties:{kc_id:"ed03a1d6-de19-5d78-ab29-0f09a1b8a025", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"pull strategy: diagnostic misconception 675", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. advertising strategy intended to bring audiences to the product", status:"approved", flawed_rule:"A pull strategy concentrates exclusively on persuading channel intermediaries to stock the product."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_PUSH_STRATEGY_DIAGNOSTIC_MISCONCEPTION_676_1649D7", properties:{kc_id:"260e5a3a-ba93-5185-995f-22c13c886bb5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"push strategy: diagnostic misconception 676", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. advertising strategy aimed at pushing the brand in front of an audience", status:"approved", flawed_rule:"A push strategy relies only on final consumers requesting the brand from retailers."}}, {misconception_id:"MISC_REACH_DIAGNOSTIC_MISCONCEPTION_677_0C3B1F", properties:{kc_id:"bfc46748-bc6b-506c-8646-f664db30af44", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"reach in chapter 14 Closing Company Case task 1: diagnostic misconception 1831", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14, Closing Company Case, task 1. the estimated number of potential customers you can reach with an advertising campaign", status:"approved", flawed_rule:"Reach and repeated impressions count the same thing."}}, {misconception_id:"MISC_REMINDER_ADVERTISING_DIAGNOSTIC_MISCONCEPTION_67_6EBD2B", properties:{kc_id:"79b7de14-9542-5374-bad0-a97bd5af94a6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"reminder advertising: diagnostic misconception 678", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. advertising aimed at bringing a product back into the forefront of the consumer’s mind", status:"approved", flawed_rule:"Reminder advertising primarily explains an entirely unfamiliar new category."}}, {misconception_id:"MISC_RETURN_ON_AD_SPEND_ROAS_DIAGNOSTIC_MISCONCEPTION_054826", properties:{kc_id:"8ee8fc06-6f14-5bfa-a50b-bc0a95dab139", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"return on ad spend (ROAS): diagnostic misconception 679", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.3. metric that measures the amount of revenue earned for every dollar spent on advertising", status:"approved", flawed_rule:"ROAS measures net profit after every business cost."}}, {misconception_id:"MISC_RETURN_ON_INVESTMENT_ROI_APPROACH_DIAGNOSTIC_MIS_AB7EA5", properties:{kc_id:"ea887c4c-ae98-587b-9cef-7eb7fda4d1ac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"return-on-investment (ROI) approach: diagnostic misconception 680", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. advertising budget strategy that focuses on every dollar spent on advertising; a return of that dollar—plus some—is expected", status:"approved", flawed_rule:"Advertising return can be assessed without considering incremental outcomes or cost."}}, {misconception_id:"MISC_SALES_TEST_DIAGNOSTIC_MISCONCEPTION_681_818389", properties:{kc_id:"c70e30cc-ca42-59d9-809a-cd0cf68091b5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"sales test: diagnostic misconception 681", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of posttest in advertising that determines how many sales will be made based on a test market", status:"approved", flawed_rule:"Sales in one test market necessarily predict all markets without qualification."}}, {misconception_id:"MISC_THEATER_TESTS_DIAGNOSTIC_MISCONCEPTION_682_82B6C8", properties:{kc_id:"927c6642-ed94-5917-ac05-f6bcb4bc081e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"theater tests: diagnostic misconception 682", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a form of advertising pretest in which the audience is shown advertisements—usually television ads—in the context that they would be shown to the entire market", status:"approved", flawed_rule:"Viewing an advertisement in a controlled theater perfectly duplicates everyday exposure."}}, {misconception_id:"MISC_UNAIDED_RECALL_DIAGNOSTIC_MISCONCEPTION_683_6B6666", properties:{kc_id:"5614b2d7-7feb-5fb6-a83e-c43fa3edce90", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"unaided recall: diagnostic misconception 683", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 14 Key Terms, printed page 498, and section 14.2. a type of advertising posttest that does not use any cues or prompts to test the recollection of the advertisement message", status:"approved", flawed_rule:"Supplying brand names before questioning leaves recall unaided."}}, {misconception_id:"MISC_ADAPTIVE_SELLING_DIAGNOSTIC_MISCONCEPTION_684_798910", properties:{kc_id:"fe999bb3-c829-52eb-ba74-70bb9f588bb1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"adaptive selling: diagnostic misconception 684", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.3. an approach to personal selling in which selling behaviors are altered during the sales interaction or across customer interactions, based on information about the nature of the selling situation", status:"approved", flawed_rule:"Adaptive selling uses exactly the same presentation for every customer."}}, {misconception_id:"MISC_AIDA_MODEL_DIAGNOSTIC_MISCONCEPTION_685_D032D6", properties:{kc_id:"984387f9-4456-5ef9-aaf3-c846a491a4e3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"AIDA model: diagnostic misconception 685", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.3. the model consumers go through when becoming interested in a product. First the product must grab their attention, then they gain interest, they have a desire for the product, and they act to acquire the product", status:"approved", flawed_rule:"Generating attention means the consumer has already acted to buy."}}, {misconception_id:"MISC_AMBIGUOUS_TERMS_AND_CONDITIONS_DIAGNOSTIC_MISCON_DA555E", properties:{kc_id:"ca72cf0a-22f6-555c-9bd8-76fd547bcf02", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"ambiguous terms and conditions: diagnostic misconception 686", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.7. when a contract is unclear and misleading", status:"approved", flawed_rule:"Contract wording is ethical as long as a consumer technically signed it."}}, {misconception_id:"MISC_APPROACH_DIAGNOSTIC_MISCONCEPTION_687_E2988B", properties:{kc_id:"33318848-f047-5766-bbd6-4e0bc0144da7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"approach in chapter 15 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1836", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, Applied Marketing Knowledge: Discussion Questions, task 2. the stage of the sales process where the salesperson makes the initial approach to introduce the product to the customer", status:"approved", flawed_rule:"The first contact with a prospect is the same as researching the prospect beforehand."}}, {misconception_id:"MISC_COMMISSION_DIAGNOSTIC_MISCONCEPTION_688_340085", properties:{kc_id:"0230e390-c0a0-5ad7-92af-9d02f273e2db", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"commission: diagnostic misconception 688", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.4. the compensation paid to salespeople based on a fixed formula related to the salesperson’s activity or performance", status:"approved", flawed_rule:"Commission is a fixed salary unrelated to selling activity or results."}}, {misconception_id:"MISC_CONSULTATIVE_SELLING_DIAGNOSTIC_MISCONCEPTION_68_BA5338", properties:{kc_id:"d284922a-1e96-5148-baab-795238730809", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"consultative selling: diagnostic misconception 689", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.3. focuses on the expertise of a salesperson with problem solving", status:"approved", flawed_rule:"Consultative selling begins with pressuring the buyer before diagnosing the problem."}}, {misconception_id:"MISC_CONTEST_DIAGNOSTIC_MISCONCEPTION_690_0682DF", properties:{kc_id:"1a42441b-6075-5708-b1fe-38903d081ff4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"contest: diagnostic misconception 690", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. a marketing or consumer sales promotion technique that involves collection, matching, or use of skill to complete a project or activity with the goal of a prize or reward for the player", status:"approved", flawed_rule:"A contest awards prizes entirely by chance without participant skill or activity."}}, {misconception_id:"MISC_COOPERATIVE_ADVERTISING_DIAGNOSTIC_MISCONCEPTION_ADA3FB", properties:{kc_id:"6b1ef92a-ef44-506c-b123-4b35a7fb1d71", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"cooperative advertising: diagnostic misconception 691", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. an approach to paying for local advertising or retail advertising whereby the details are handled by a local retail store but is partly or fully paid for by a national manufacturer whose product is featured in the ad", status:"approved", flawed_rule:"A retailer must always bear the entire cost of local manufacturer-brand advertising."}}, {misconception_id:"MISC_COUPON_DIAGNOSTIC_MISCONCEPTION_692_8F6B40", properties:{kc_id:"b70ed5c5-f4f4-51ce-9a9e-ad4ed3b0b39a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"coupon: diagnostic misconception 692", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. a printed certificate entitling the bearer to a stated price reduction or special value on a specific product", flawed_rule:"A coupon requires a post-purchase reimbursement claim like a rebate.", status:"approved"}}, {misconception_id:"MISC_CREDIT_TERMS_DIAGNOSTIC_MISCONCEPTION_693_9A38AB", properties:{kc_id:"54c5894d-3335-5901-8521-24db52936c6e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"credit terms: diagnostic misconception 693", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. credit terms of the agreement between the buyer and seller with length of time and payments to be made", status:"approved", flawed_rule:"Only the sticker price matters; payment timing and financing conditions do not."}}, {misconception_id:"MISC_CUSTOMER_RELATIONSHIP_MANAGEMENT_DIAGNOSTIC_MISC_B6C619", properties:{kc_id:"151bf51b-2cc6-50d3-b718-0f2e811e8551", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"customer relationship management: diagnostic misconception 694", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.4. the process sales personnel undertake to work with the customer to build the relationship and move into the role of a trusted advisor", status:"approved", flawed_rule:"CRM ends when the salesperson closes the first sale."}}, {misconception_id:"MISC_FORMULA_SELLING_DIAGNOSTIC_MISCONCEPTION_695_823F1A", properties:{kc_id:"343292d6-0a95-5716-916f-06636e8b310b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"formula selling: diagnostic misconception 695", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.3. an approach in which the sales presentation is designed to move the customer through the stages in the decision-making process, such as get the customer’s attention, develop interest, build desire, and secure action", status:"approved", flawed_rule:"Formula selling requires inventing an entirely new decision sequence for every customer."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_HIDDEN_FEES_DIAGNOSTIC_MISCONCEPTION_696_74E913", properties:{kc_id:"f2c75ed4-6592-5ae3-a51b-b0133327e7cd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"hidden fees: diagnostic misconception 696", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.7. also called undisclosed fees and are fees that are not made known to the buyer", status:"approved", flawed_rule:"Charges disclosed only after commitment do not affect the fairness of the advertised offer."}}, {misconception_id:"MISC_INSIDE_ORDER_TAKER_DIAGNOSTIC_MISCONCEPTION_697_7C1B24", properties:{kc_id:"f59aca93-0946-546d-aaa7-fd37c549d2c9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"inside order taker: diagnostic misconception 697", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.2. a salesclerk or order clerk that is employed for a company that address questions and complete the final sale", status:"approved", flawed_rule:"An inside order taker mainly travels to customers to deliver inventory."}}, {misconception_id:"MISC_KICKBACKS_DIAGNOSTIC_MISCONCEPTION_698_4668BE", properties:{kc_id:"21d30b53-35e8-5d56-b68c-599101aff70c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"kickbacks: diagnostic misconception 698", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.7. illegal payment for preferential or improper service", status:"approved", flawed_rule:"A concealed payment for preferential treatment is merely ordinary commission."}}, {misconception_id:"MISC_LEAD_RESPONSE_TIME_DIAGNOSTIC_MISCONCEPTION_699_15764A", properties:{kc_id:"a2af8ff1-c4aa-5be3-848a-afd3683c3642", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"lead response time: diagnostic misconception 699", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.4. The elapsed time taken by a sales team to respond to a new lead or customer request, as explained in section 15.4. Source inconsistency: the glossary supplies an unrelated analytics definition; this node follows the substantive section.", status:"approved", flawed_rule:"Lead response time measures demographic analysis rather than elapsed time to respond."}}, {misconception_id:"MISC_LOYALTY_PROGRAMS_DIAGNOSTIC_MISCONCEPTION_700_81278F", properties:{kc_id:"4aace521-f47a-5e8d-a257-5e9ebf896bb5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"loyalty programs: diagnostic misconception 700", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. a form of promotion focused on repeat purchases and frequently attached to a sales receipt, punch card, or stamp card", status:"approved", flawed_rule:"Reward-program enrollment proves genuine brand attachment."}}, {misconception_id:"MISC_MISSIONARY_SALESPEOPLE_DIAGNOSTIC_MISCONCEPTION__192405", properties:{kc_id:"f5c83d63-b80a-542c-9cc8-7f5612c680f4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"missionary salespeople: diagnostic misconception 701", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.2. individuals who have the power to influence the customer to purchase a product or service", status:"approved", flawed_rule:"Missionary salespeople must directly accept the customer's order to influence demand."}}, {misconception_id:"MISC_NEED_SATISFACTION_FORMAT_DIAGNOSTIC_MISCONCEPTIO_47C08F", properties:{kc_id:"f0c85765-943f-54bb-8fc1-a68bb05a6d67", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"need/satisfaction format in chapter 15 What Do Marketers Do? task 5: diagnostic misconception 1847", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, What Do Marketers Do?, task 5. a type of customized sales presentation in which the salesperson first identifies the prospective customer’s needs and then tries to offer a solution that satisfies those needs", status:"approved", flawed_rule:"A needs-based presentation starts with an identical product pitch before asking questions."}}, {misconception_id:"MISC_OPPORTUNITY_WIN_RATE_DIAGNOSTIC_MISCONCEPTION_70_D246BE", properties:{kc_id:"4f3afad2-4b70-5442-b714-0fafb4de6681", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"opportunity win rate in chapter 15 What Do Marketers Do? task 6: diagnostic misconception 1848", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, What Do Marketers Do?, task 6. the number of sales closed divided by the total number of opportunities created; calculates another opportunity to track sales", status:"approved", flawed_rule:"Win rate divides sales by advertising impressions rather than qualified opportunities."}}, {misconception_id:"MISC_ORDER_GETTERS_DIAGNOSTIC_MISCONCEPTION_704_D5CE83", properties:{kc_id:"40713e9c-3e13-5e4f-93b1-6752c4c79c47", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"order getters: diagnostic misconception 704", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.2. highly trained salespeople who know their products, services involved, and competition across the street", status:"approved", flawed_rule:"Order getters only process orders from customers who already decided to buy."}}, {misconception_id:"MISC_ORDER_TAKERS_DIAGNOSTIC_MISCONCEPTION_705_3821F2", properties:{kc_id:"3a4c0afd-5916-598f-9758-33776abc8018", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"order takers in chapter 15 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1835", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, Applied Marketing Knowledge: Discussion Questions, task 1. sales personnel that are responsible for taking orders from customers by identifying the customer and finding the right product fit", status:"approved", flawed_rule:"Order takers are primarily responsible for generating entirely new demand."}}, {misconception_id:"MISC_OUTSIDE_ORDER_TAKERS_DIAGNOSTIC_MISCONCEPTION_70_FCCA8A", properties:{kc_id:"2c79559c-cc5c-55dd-bc0a-9ce47df9c7d9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"outside order takers in chapter 15 Critical Thinking Exercises task 1: diagnostic misconception 1839", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, Critical Thinking Exercises, task 1. salespeople out in the trenches, visiting customers and delivering inventory to retailers and wholesalers", status:"approved", flawed_rule:"Outside order takers remain at the seller's premises for every interaction."}}, {misconception_id:"MISC_POINT_OF_PURCHASE_DISPLAYS_DIAGNOSTIC_MISCONCEPT_09ADB1", properties:{kc_id:"068e9b23-79f0-5681-80d8-e77ae9b46c55", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"point-of-purchase displays: diagnostic misconception 708", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. displays that allow manufacturers to showcase their products in a way that stands out from all the other products in the store", status:"approved", flawed_rule:"In-store presentation cannot influence a decision already partly planned."}}, {misconception_id:"MISC_PRE_APPROACH_STAGE_DIAGNOSTIC_MISCONCEPTION_709_759987", properties:{kc_id:"452d84a3-95b4-5819-b858-133422d051ae", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"pre-approach stage: diagnostic misconception 709", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.3. the stage of the sales process where the salesperson will work to understand the needs of the customer and begin working with them to become a customer", status:"approved", flawed_rule:"Researching a prospect is unnecessary before making the initial approach."}}, {misconception_id:"MISC_PREMIUMS_DIAGNOSTIC_MISCONCEPTION_710_7D12D7", properties:{kc_id:"931f856c-d942-5d4b-8083-d3428f5e3eb2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"premiums: diagnostic misconception 710", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. a promotional tool that is often defined in three forms: merchandise offered at a lower price or free; an item of value, other than the product; souvenir merchandise", status:"approved", flawed_rule:"A premium is always a reduction in the purchased product's price."}}, {misconception_id:"MISC_PRESENTATION_DIAGNOSTIC_MISCONCEPTION_711_F4804B", properties:{kc_id:"6b5e938d-905d-5cc8-95f0-e5755426699e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"presentation in chapter 15 Closing Company Case task 2: diagnostic misconception 1850", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, Closing Company Case, task 2. the stage of the sales process where the salesperson showcases the features about a product that will be of most benefit to the prospect based on the needs uncovered during the pre-approach and approach stages", status:"approved", flawed_rule:"An effective presentation lists every feature without connecting them to the prospect's needs."}}, {misconception_id:"MISC_PROSPECT_DIAGNOSTIC_MISCONCEPTION_712_604F30", properties:{kc_id:"6dbd7e89-32f4-5312-9162-f4aebf21e34e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"prospect: diagnostic misconception 712", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.3. a potential qualified customer who has the willingness, financial capacity, authority, and eligibility to buy the salesperson’s offering", status:"approved", flawed_rule:"Any unverified name in a database is already a qualified prospect."}}, {misconception_id:"MISC_QUALIFICATION_DIAGNOSTIC_MISCONCEPTION_713_11900E", properties:{kc_id:"890f6491-fc1f-5b4e-a949-01c3851f60f0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"qualification: diagnostic misconception 713", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.3. the process the salesperson undertakes to make sure the sales lead is a good fit for the product they are selling", status:"approved", flawed_rule:"A prospect's interest alone proves budget, authority, and suitability."}}, {misconception_id:"MISC_QUANTITATIVE_ASSESSMENTS_DIAGNOSTIC_MISCONCEPTIO_5A68F5", properties:{kc_id:"0efc73d9-5524-5005-8d92-e344107c765d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"quantitative assessments: diagnostic misconception 714", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.4. numbers driven and based on inputs and outputs of the sales cycle", status:"approved", flawed_rule:"Activity counts alone prove high-quality and ethical selling."}}, {misconception_id:"MISC_RELATIONSHIP_SELLING_DIAGNOSTIC_MISCONCEPTION_71_42BAE8", properties:{kc_id:"1438c790-0ec5-5526-9c2d-f0d741c8e0a0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"relationship selling: diagnostic misconception 716", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.1. a method of personal selling used to better understand the needs and wants of the buyer", status:"approved", flawed_rule:"Relationship selling ends once the first transaction is closed."}}, {misconception_id:"MISC_SALES_FORCE_AUTOMATION_DIAGNOSTIC_MISCONCEPTION__34B169", properties:{kc_id:"0a17e8d3-2ad5-553b-9b64-e981b4691871", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sales force automation in chapter 15 Closing Company Case task 3: diagnostic misconception 1851", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, Closing Company Case, task 3. a software tool that helps organizations acquire customers", status:"approved", flawed_rule:"Automating sales tasks eliminates the need for judgment and relationship building."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_SALES_LEADS_DIAGNOSTIC_MISCONCEPTION_718_04839C", properties:{kc_id:"a0ef9388-6128-5d2c-9b91-9eb9687b8da9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sales leads in chapter 15 Closing Company Case task 4: diagnostic misconception 1852", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, Closing Company Case, task 4. a database of potential customers that sales professionals work to create and develop through lead generation", status:"approved", flawed_rule:"Every sales lead has verified purchasing authority and funding."}}, {misconception_id:"MISC_SAMPLES_DIAGNOSTIC_MISCONCEPTION_720_F932BA", properties:{kc_id:"67cddb08-bd9e-5ddd-bda0-e4ca69f0bffd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"samples: diagnostic misconception 720", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. providing consumers with a free sample of a product is a form of promotion", status:"approved", flawed_rule:"Accepting a free sample proves willingness to pay full price."}}, {misconception_id:"MISC_SELLING_PROCESS_DIAGNOSTIC_MISCONCEPTION_721_C4E4B5", properties:{kc_id:"c021d825-17ed-5f21-81fb-880d6a086966", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"selling process in chapter 15 What Do Marketers Do? task 4: diagnostic misconception 1846", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15, What Do Marketers Do?, task 4. includes all of the steps the salesperson will implement as they work with the buyer to become a customer", status:"approved", flawed_rule:"The selling process ends at presentation without handling objections or follow-up."}}, {misconception_id:"MISC_SUPPORT_PERSONNEL_DIAGNOSTIC_MISCONCEPTION_722_C50936", properties:{kc_id:"04aa3d30-4d9f-500d-89c6-878eafdfeffe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"support personnel: diagnostic misconception 722", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.2. fulfill the responsibilities that assist the sales team in supporting the customer and completing the sale", status:"approved", flawed_rule:"Only the main salesperson contributes to completing and maintaining an account."}}, {misconception_id:"MISC_SWEEPSTAKES_DIAGNOSTIC_MISCONCEPTION_723_EDE00C", properties:{kc_id:"cc12133e-ded7-5668-9cd1-2ca1898cec08", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"sweepstakes: diagnostic misconception 723", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.6. a marketing or consumer sales promotion that involves the offering of prizes to participants, where winners are selected by chance and no consideration is required", status:"approved", flawed_rule:"A sweepstakes winner is chosen through judged skill rather than chance."}}, {misconception_id:"MISC_TEAM_SELLING_DIAGNOSTIC_MISCONCEPTION_724_55AFE3", properties:{kc_id:"ac3bb977-1c14-5b13-bbb5-33fa94dfc6f7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"team selling: diagnostic misconception 724", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.2. the practice of involving a group of people familiar with the viewpoints and concerns of a customer’s key decision makers to sell and service a major account", status:"approved", flawed_rule:"Team selling requires only multiple salespeople with identical expertise."}}, {misconception_id:"MISC_TECHNICAL_SPECIALIST_DIAGNOSTIC_MISCONCEPTION_72_53983D", properties:{kc_id:"88cdbf4f-68a8-5ac4-9f0a-5e20fbf11fdd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"technical specialist: diagnostic misconception 725", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 15 Key Terms, printed page 533, and section 15.2. a salesperson who has extensive product knowledge and uses this knowledge as the focal aspect of the sales presentation", status:"approved", flawed_rule:"Technical expertise removes the need to relate features to the buyer's problem."}}, {misconception_id:"MISC_AFFILIATES_DIAGNOSTIC_MISCONCEPTION_726_A49386", properties:{kc_id:"989e4888-80ed-585b-bb21-7e807b4cbf91", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"affiliates: diagnostic misconception 726", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. people or companies that earn a commission for driving traffic to another person’s or company’s website where they make a purchase", status:"approved", flawed_rule:"Affiliate recommendations are necessarily independent of financial incentives."}}, {misconception_id:"MISC_BLOG_DIAGNOSTIC_MISCONCEPTION_727_4E8ED1", properties:{kc_id:"f3f33a3e-63b4-5f02-9eb2-934789c056df", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"blog: diagnostic misconception 727", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. an online journal of interests, beliefs, and other topics published by a person, a group of people, or an organization", flawed_rule:"A blog creates value only by repeating direct sales pitches.", status:"approved"}}, {misconception_id:"MISC_BOUNCE_RATE_DIAGNOSTIC_MISCONCEPTION_728_F473EB", properties:{kc_id:"0fe332fa-9f7c-5f59-9caf-c00023b3d417", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"bounce rate: diagnostic misconception 728", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. a metric that online marketers use to measure what percentage of visitors who visit the site, view one page, and then leave", status:"approved", flawed_rule:"A single-page visit always proves the visitor failed to obtain value."}}, {misconception_id:"MISC_CALL_CENTER_DIAGNOSTIC_MISCONCEPTION_729_D0D88C", properties:{kc_id:"6fd65bb0-02ad-5b79-91c5-d73c29513ff7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"call center: diagnostic misconception 729", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. a centralized space where agents or representatives answer inbound calls and place outbound calls", status:"approved", flawed_rule:"Call centers handle only outbound sales and never inbound service."}}, {misconception_id:"MISC_CATALOG_MARKETING_DIAGNOSTIC_MISCONCEPTION_730_3A5BD7", properties:{kc_id:"a1b571c8-ef14-52c7-a382-ef3754e175d6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"catalog marketing: diagnostic misconception 730", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. also known as direct mail order and is one of the oldest forms of promotion, which typically includes a variety of products often vividly displayed in a high-gloss magazine-like format", status:"approved", flawed_rule:"Catalog marketing cannot coexist with online ordering."}}, {misconception_id:"MISC_CLICK_THROUGH_RATE_CTR_DIAGNOSTIC_MISCONCEPTION__2E6076", properties:{kc_id:"71f8f395-3848-5e3d-9355-ba2a4a54290f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"click-through rate (CTR): diagnostic misconception 731", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. the percentage of people who click on an online ad", status:"approved", flawed_rule:"CTR divides sales revenue by advertising cost."}}, {misconception_id:"MISC_CLIENT_REVIEWS_DIAGNOSTIC_MISCONCEPTION_732_877C77", properties:{kc_id:"58c5f936-d2d0-5589-aebf-b64c6d564399", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"client reviews: diagnostic misconception 732", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.4. involve feedback that a customer or client posts directly to a platform that can accessed by consumers during the buying process", status:"approved", flawed_rule:"A published customer review is necessarily representative and independently verified."}}, {misconception_id:"MISC_CONTENT_MARKETING_DIAGNOSTIC_MISCONCEPTION_733_8A82D3", properties:{kc_id:"c50a0fef-ff98-5d3e-92e4-b0967a648b60", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"content marketing in chapter 16 Critical Thinking Exercises task 3: diagnostic misconception 1859", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, Critical Thinking Exercises, task 3. creating and distributing online content that is valuable and relevant to a company’s target customers", status:"approved", flawed_rule:"Content marketing is simply an uninterrupted sequence of product advertisements."}}, {misconception_id:"MISC_CONVERSIONS_DIAGNOSTIC_MISCONCEPTION_734_C1EBF0", properties:{kc_id:"eb4f3eac-a702-54f7-a81d-8e64825645ea", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"conversions: diagnostic misconception 734", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. happen when a company turns a visitor into a customer", status:"approved", flawed_rule:"Every website visit is automatically a conversion."}}, {misconception_id:"MISC_COST_PER_ACQUISITION_CPA_DIAGNOSTIC_MISCONCEPTIO_CCBB5B", properties:{kc_id:"14ec6a88-03a2-5a7f-9e49-3f12e10d5ea7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"cost per acquisition (CPA): diagnostic misconception 735", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. also known as cost per action or cost per conversion, relates to the aggregate or cumulative cost of acquiring a customer and can be measured by channel or campaign", status:"approved", flawed_rule:"CPA is the cost per click regardless of whether anyone takes the target action."}}, {misconception_id:"MISC_COST_PER_CLICK_CPC_DIAGNOSTIC_MISCONCEPTION_736_0397FC", properties:{kc_id:"a806da2d-a3ba-5e3f-ad27-21521f450872", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"cost per click (CPC): diagnostic misconception 736", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. the cost companies pay search engines for each click that a search advertisement receives, which is based on the keywords a company bids on", status:"approved", flawed_rule:"CPC measures the cost of a confirmed customer purchase."}}, {misconception_id:"MISC_DIRECT_MAIL_MARKETING_DIAGNOSTIC_MISCONCEPTION_7_A20CA6", properties:{kc_id:"a1702ed9-3168-5047-91af-c47d707d4fdd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"direct-mail marketing: diagnostic misconception 738", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. a type of direct marketing that involves marketers sending mail directly to people’s homes or places of business; for example, catalogs and postcards", status:"approved", flawed_rule:"Direct mail and email are the same delivery medium."}}, {misconception_id:"MISC_DIRECT_RESPONSE_TELEVISION_MARKETING_DIAGNOSTIC__EDA680", properties:{kc_id:"8410b151-c2b4-59ae-b779-f73d77caa4d6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"direct-response television marketing: diagnostic misconception 739", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. a type of direct marketing that is designed to compel viewers to take some immediate action such, as calling a phone number or visiting a website presented during a television commercial", status:"approved", flawed_rule:"Direct-response television seeks only long-term awareness and no immediate action."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_EMAIL_MARKETING_DIAGNOSTIC_MISCONCEPTION_740_209210", properties:{kc_id:"c85933a7-2c44-53ed-a3e4-8d03940bbea2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"email marketing: diagnostic misconception 740", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. a type of direct marketing that is highly personal and designed to build relationships with consumers", status:"approved", flawed_rule:"Sending the same unsolicited message to everyone builds strong relationships."}}, {misconception_id:"MISC_IMPRESSION_DIAGNOSTIC_MISCONCEPTION_741_C41626", properties:{kc_id:"91159f38-e5a1-5283-a24c-762aba0faa92", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"impression: diagnostic misconception 741", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. when users see an online ad", status:"approved", flawed_rule:"An impression proves the user clicked and understood the advertisement."}}, {misconception_id:"MISC_INTEGRATED_SOCIAL_MEDIA_MARKETING_DIAGNOSTIC_MIS_C7D9CE", properties:{kc_id:"b596724e-7f48-5be6-a656-d4efd8402810", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"integrated social media marketing: diagnostic misconception 742", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.2. involves creating a clear, consistent, and synergistic message across all social media platforms", status:"approved", flawed_rule:"Posting unrelated messages across more platforms automatically creates integration."}}, {misconception_id:"MISC_MARKETING_EMAILS_DIAGNOSTIC_MISCONCEPTION_743_25A201", properties:{kc_id:"02e660a0-c2e5-5b88-a216-f84f157cd94f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"marketing emails in chapter 16 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1855", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, Applied Marketing Knowledge: Discussion Questions, task 3. emails that are promotional in nature and typically involve a marketing offer", status:"approved", flawed_rule:"Every operational email is necessarily a promotional marketing offer."}}, {misconception_id:"MISC_MOBILE_MARKETING_DIAGNOSTIC_MISCONCEPTION_744_2B500B", properties:{kc_id:"57457686-d720-5d45-b5de-4687c3a475f4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"mobile marketing in chapter 16 Closing Company Case task 4: diagnostic misconception 1865", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, Closing Company Case, task 4. using multiple digital marketing channels that are designed to reach consumers on their smartphones and tablets", status:"approved", flawed_rule:"A desktop campaign can always be copied unchanged onto a small screen."}}, {misconception_id:"MISC_MOBILE_FRIENDLY_EMAILS_DIAGNOSTIC_MISCONCEPTION__EEEA9C", properties:{kc_id:"372ef1db-9746-523e-b167-ab18fcc4bebe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"mobile-friendly emails: diagnostic misconception 745", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.2. emails whose images, text, and links display in a way that is easy to read when accessed via a mobile device", status:"approved", flawed_rule:"Shrinking desktop text is sufficient even if links and layout become unusable."}}, {misconception_id:"MISC_NEW_VISITORS_DIAGNOSTIC_MISCONCEPTION_746_4CB1DF", properties:{kc_id:"7f51aa85-a2fa-585b-9d76-30484404d4ee", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"new visitors: diagnostic misconception 746", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. people who are first visiting your website, also known as new users", status:"approved", flawed_rule:"A newly recognized browser identifier necessarily represents a person who has never encountered the brand."}}, {misconception_id:"MISC_ONLINE_DIRECT_MARKETING_DIAGNOSTIC_MISCONCEPTION_7737C8", properties:{kc_id:"95946239-4fb1-51e5-b678-efa6e61c0925", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"online direct marketing: diagnostic misconception 747", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. uses a rich collection of online tools, such as websites and email, to target individual consumers with an offer designed to compel consumers to take some action, such as visit a website or make an online purchase", status:"approved", flawed_rule:"Online direct marketing excludes individual targeting and measurable responses."}}, {misconception_id:"MISC_ONLINE_VIDEO_MARKETING_DIAGNOSTIC_MISCONCEPTION__80808C", properties:{kc_id:"119d549a-05fa-53b7-8843-c39840607f74", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"online video marketing: diagnostic misconception 748", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. involves creating videos that tell a story about a product, company, or brand that is designed to drive consumer engagement through activities such as liking, sharing, and retweeting", status:"approved", flawed_rule:"A high view count alone establishes profitable customer engagement."}}, {misconception_id:"MISC_ORGANIC_SEARCH_DIAGNOSTIC_MISCONCEPTION_749_8BEDBB", properties:{kc_id:"288ae470-3673-5d52-998e-34bc01692312", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"organic search: diagnostic misconception 749", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. the list of websites on a search engine results page that have not been paid for by marketers", status:"approved", flawed_rule:"Organic search placements are advertisements bought per click."}}, {misconception_id:"MISC_PAGE_VIEWS_DIAGNOSTIC_MISCONCEPTION_750_B28060", properties:{kc_id:"6eb9b6c8-1a2f-59a2-a150-81cc3f4ac62e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"page views: diagnostic misconception 750", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. a metric related to how many total pages have been viewed on your website", status:"approved", flawed_rule:"Page views measure unique individuals rather than page loads."}}, {misconception_id:"MISC_PAID_SEARCH_DIAGNOSTIC_MISCONCEPTION_751_092D7F", properties:{kc_id:"67e2ecb1-6a61-5e54-a265-b233b058d135", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"paid search: diagnostic misconception 751", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. a type of digital advertising where marketers pay search engines like Google and Bing to place their ads in sponsored spots at the top or bottom of a search results page", status:"approved", flawed_rule:"Paying for a search advertisement guarantees the highest organic ranking."}}, {misconception_id:"MISC_PAID_SOCIAL_DIAGNOSTIC_MISCONCEPTION_752_4DA0CC", properties:{kc_id:"f4dd7e80-b4b7-5895-8764-7324b73cf2ec", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"paid social: diagnostic misconception 752", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.2. a type of digital marketing advertising where a company pays a social media company to display a digital advertisement to targeted customers on its platform", status:"approved", flawed_rule:"Paid social and unpaid follower posts have identical distribution mechanisms."}}, {misconception_id:"MISC_PODCASTS_DIAGNOSTIC_MISCONCEPTION_753_29A6B0", properties:{kc_id:"f1ce1948-fb9a-578f-8555-1963f6440835", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"podcasts: diagnostic misconception 753", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.2. often free, on-demand, downloadable audio recordings that cover a variety of topics and are typically made available on a weekly or monthly basis", status:"approved", flawed_rule:"Podcasts must be listened to live and cannot support on-demand audiences."}}, {misconception_id:"MISC_RESPONSIVE_WEB_DESIGN_DIAGNOSTIC_MISCONCEPTION_7_083985", properties:{kc_id:"c534dabc-6abe-531f-906e-fe35138f566c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"responsive web design: diagnostic misconception 754", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.2. designing a website that is configured to adapt to any device, making it easy for visitors to read and interact with its features", status:"approved", flawed_rule:"A responsive website shows a fixed desktop layout on every device."}}, {misconception_id:"MISC_RETURNING_VISITORS_DIAGNOSTIC_MISCONCEPTION_755_3E4B7B", properties:{kc_id:"6b7b0ddb-1b64-5be9-a729-bff4183da4fc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"returning visitors: diagnostic misconception 755", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. visitors or users who have been to your website before", status:"approved", flawed_rule:"Every returning visitor is already a paying customer."}}, {misconception_id:"MISC_SALES_FUNNEL_DIAGNOSTIC_MISCONCEPTION_756_F2742D", properties:{kc_id:"27058dcd-b221-5773-8e49-d40d1196afb0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"sales funnel: diagnostic misconception 756", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. a visual representation of the customer journey from product awareness to product purchase", status:"approved", flawed_rule:"Every person who becomes aware of a product inevitably buys it."}}, {misconception_id:"MISC_SEARCH_TRENDS_DIAGNOSTIC_MISCONCEPTION_757_5B17E2", properties:{kc_id:"ad3da9a0-1c02-523d-802f-c07773bd200e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"search trends: diagnostic misconception 757", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. data points that indicate how frequently a term is searched", status:"approved", flawed_rule:"More searches for a term necessarily mean more purchases of one brand."}}, {misconception_id:"MISC_SEMINARS_DIAGNOSTIC_MISCONCEPTION_758_1FDC5D", properties:{kc_id:"68b6b7d7-0c1c-5971-8968-0e4dab5a9b0e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"seminars: diagnostic misconception 758", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. a tool that allows companies to share their expertise and knowledge related to a topic, issue, or industry; can be done in person or virtually", status:"approved", flawed_rule:"Sharing expertise cannot function as a marketing relationship-building tool."}}, {misconception_id:"MISC_SERP_SEARCH_ENGINE_RESULTS_PAGE_DIAGNOSTIC_MISCO_131199", properties:{kc_id:"2f8733a0-b3eb-51c7-ad97-e6052c272980", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"SERP (Search Engine Results Page): diagnostic misconception 759", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. the list of search results that displays on a search engine’s page after someone enters key search terms into a search query box", status:"approved", flawed_rule:"Every result on a search results page is organic and unpaid."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_SESSION_DIAGNOSTIC_MISCONCEPTION_760_34C56B", properties:{kc_id:"1f8b3922-4ff7-52bb-97df-e31e94a8eec2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"session: diagnostic misconception 760", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. a collection of interactions that occur on a company’s website", status:"approved", flawed_rule:"A session is the same as one page view or one unique person."}}, {misconception_id:"MISC_SOCIAL_ENGAGEMENT_DIAGNOSTIC_MISCONCEPTION_761_DAFD0A", properties:{kc_id:"9ce71ba1-c4fc-55d1-aef1-be92f9996977", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"social engagement: diagnostic misconception 761", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. relates to the number of actions that social media users take in direct relation to your company, brand, or product", status:"approved", flawed_rule:"Likes and comments necessarily represent positive sentiment and profitable demand."}}, {misconception_id:"MISC_SOCIAL_MEDIA_MARKETING_DIAGNOSTIC_MISCONCEPTION__8ECC5E", properties:{kc_id:"0c0e2950-68ae-5bc7-b1ae-3ed2d1ef04bd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"social media marketing in chapter 16 Closing Company Case task 2: diagnostic misconception 1863", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, Closing Company Case, task 2. using social media platforms, such as Facebook, Instagram, LinkedIn, and Twitter, to deliver content that drives engagement with your brand", status:"approved", flawed_rule:"A follower count alone establishes campaign effectiveness."}}, {misconception_id:"MISC_TELEMARKETING_DIAGNOSTIC_MISCONCEPTION_763_99BF7B", properties:{kc_id:"a93fc56e-a186-541f-9532-1053fcaced59", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"telemarketing in chapter 16 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1856", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, Applied Marketing Knowledge: Discussion Questions, task 4. a type of direct marketing that involves a company representative placing or answering customer phone calls with the intention of guiding the consumer toward making a purchase", status:"approved", flawed_rule:"Every telephone contact is outbound and sales-oriented, including unrelated customer service."}}, {misconception_id:"MISC_TRADE_SHOWS_DIAGNOSTIC_MISCONCEPTION_764_D8222C", properties:{kc_id:"8be2df77-92b4-523f-aa1c-88a1d937467d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"trade shows: diagnostic misconception 764", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.1. exhibition events that provide companies the opportunity to present themselves and their products and services to industry peers", status:"approved", flawed_rule:"Trade shows offer no value beyond immediate on-site transactions."}}, {misconception_id:"MISC_TRAFFIC_BY_SOURCE_DIAGNOSTIC_MISCONCEPTION_765_037302", properties:{kc_id:"ac27c17a-2639-5491-8cd5-82ce2310ec41", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"traffic by source: diagnostic misconception 765", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16 Key Terms, printed page 569, and section 16.3. means paying attention to the site from which the website traffic came", status:"approved", flawed_rule:"All website traffic has the same acquisition origin and intent."}}, {misconception_id:"MISC_WEBSITE_MARKETING_DIAGNOSTIC_MISCONCEPTION_766_43FB13", properties:{kc_id:"96a90349-a026-57d3-83f1-ba3fade5d7df", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"website marketing in chapter 16 What Do Marketers Do? task 1: diagnostic misconception 1861", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, What Do Marketers Do?, task 1. The promotion of a website that results in driving traffic or visitors to the site to learn more about the product or company or to make a purchase", status:"approved", flawed_rule:"Building a website automatically brings relevant visitors to it."}}, {misconception_id:"MISC_WEBSITE_TRAFFIC_DIAGNOSTIC_MISCONCEPTION_767_AA2DBE", properties:{kc_id:"2b19721b-241b-52e5-824d-3ce29c25aabe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"website traffic in chapter 16 Closing Company Case task 1: diagnostic misconception 1862", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 16, Closing Company Case, task 1. the total number of visitors to a company’s website", status:"approved", flawed_rule:"More visits necessarily produce a better conversion rate."}}, {misconception_id:"MISC_ACCUMULATING_DIAGNOSTIC_MISCONCEPTION_768_5E2674", properties:{kc_id:"61cef579-aa09-56f9-a560-716ab5b9bffd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"accumulating in chapter 17 What Do Marketers Do? task 5: diagnostic misconception 1878", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, What Do Marketers Do?, task 5. relates to intermediaries buying in bulk from different manufacturers", status:"approved", flawed_rule:"Accumulating means breaking a large shipment into smaller lots."}}, {misconception_id:"MISC_ADJUSTING_FOR_DISCREPANCY_OF_ASSORTMENT_DIAGNOST_7AF5E9", properties:{kc_id:"e6869dbe-e36c-5ad5-a2ea-21039e75ea08", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"adjusting for discrepancy of assortment: diagnostic misconception 769", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. occurs when an intermediary buys from manufacturers, then regroups products into different assortments based on what consumers are demanding from retailers", status:"approved", flawed_rule:"Consumers want the same product assortment that each specialized manufacturer produces."}}, {misconception_id:"MISC_ADMINISTERED_VMS_DIAGNOSTIC_MISCONCEPTION_770_2D7769", properties:{kc_id:"9ad19e56-0132-5b20-b5eb-96814572fed8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"administered VMS: diagnostic misconception 770", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. one type of vertical marketing system where there is no ownership of channel members but instead one member who is large enough to coordinate and manage the distribution activities of other channels members", status:"approved", flawed_rule:"A coordinated vertical system always requires common ownership or a formal contract."}}, {misconception_id:"MISC_AGENT_DIAGNOSTIC_MISCONCEPTION_771_C1D346", properties:{kc_id:"5d4dbc0d-a217-5d6a-a5a5-ca0bd31d54b8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"agent in chapter 17 What Do Marketers Do? task 4: diagnostic misconception 1877", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, What Do Marketers Do?, task 4. a type of intermediary who acts as an extension to the manufacturer", status:"approved", flawed_rule:"An agent necessarily takes title to the goods represented."}}, {misconception_id:"MISC_BULK_AND_WEIGHT_DIAGNOSTIC_MISCONCEPTION_772_5719F1", properties:{kc_id:"d5d4b142-5591-599f-8745-256905cce69a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"bulk and weight: diagnostic misconception 772", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. the density and heaviness of one unit of product", status:"approved", flawed_rule:"Heavy and bulky products have the same distribution constraints as lightweight items."}}, {misconception_id:"MISC_BULK_BREAKING_DIAGNOSTIC_MISCONCEPTION_773_43E57E", properties:{kc_id:"c11a7be9-4e7c-5518-a826-f052faf31d22", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"bulk-breaking: diagnostic misconception 773", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. occurs when an intermediary takes a large bundling of a manufacturer’s product and breaks it down into single units to be distributed to retailers based on the retailer’s order", status:"approved", flawed_rule:"Bulk-breaking is purchasing large lots without dividing them for downstream buyers."}}, {misconception_id:"MISC_BUSINESS_TO_CONSUMER_B2C_DIAGNOSTIC_MISCONCEPTIO_EDC9BD", properties:{kc_id:"1cd8f841-3dad-5081-83f1-55bcda8f1989", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"business-to-consumer (B2C): diagnostic misconception 775", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. a market comprised of companies that manufacture and sell products or services directly to a final consumer or end user", status:"approved", flawed_rule:"B2C describes sales intended for further industrial production."}}, {misconception_id:"MISC_CHANNEL_CONFLICT_DIAGNOSTIC_MISCONCEPTION_776_D39359", properties:{kc_id:"ef071bc9-7e11-5a13-9771-8813653db03a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"channel conflict in chapter 17 Closing Company Case task 2: diagnostic misconception 1882", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Closing Company Case, task 2. disagreements between companies in the marketing channel due to a competitive versus a collaborative mindset", status:"approved", flawed_rule:"All disagreements occur only between manufacturers and retailers at different levels."}}, {misconception_id:"MISC_CHANNEL_LENGTH_DIAGNOSTIC_MISCONCEPTION_777_989938", properties:{kc_id:"d5f5648a-3a46-5a41-bcab-9a45aa7a455e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"channel length in chapter 17 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1866", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Applied Marketing Knowledge: Discussion Questions, task 1. relates to the number of intermediaries in the marketing channel", status:"approved", flawed_rule:"Channel length measures geographic distance rather than intermediary levels."}}, {misconception_id:"MISC_CHANNEL_MEMBER_INTERMEDIARY_DIAGNOSTIC_MISCONCEP_A1E25C", properties:{kc_id:"d7d06f5b-0a16-5713-a964-7b066c766426", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"channel member (intermediary): diagnostic misconception 778", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. a company that works in a network with other companies to help gets products from manufacturers to final consumers", status:"approved", flawed_rule:"Intermediaries merely add cost and perform no useful customer functions."}}, {misconception_id:"MISC_CONTRACTUAL_VMS_DIAGNOSTIC_MISCONCEPTION_779_E2E6AD", properties:{kc_id:"3d0662d6-6f8c-5e70-962d-97d040be40db", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"contractual VMS: diagnostic misconception 779", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. independent companies that have joined together by contract for a mutually beneficial purpose", status:"approved", flawed_rule:"A contractual system requires one member to own all the others."}}, {misconception_id:"MISC_CORPORATE_VMS_DIAGNOSTIC_MISCONCEPTION_780_88AA67", properties:{kc_id:"02fc1adc-dfae-5973-b4f4-e71920bd3f5c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"corporate VMS: diagnostic misconception 780", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. when one member of the distribution channel owns the other members", status:"approved", flawed_rule:"Independent firms coordinating by influence form a corporate ownership system."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_CUSTOMER_PERCEIVED_VALUE_DIAGNOSTIC_MISCONCEPTIO_1829F8", properties:{kc_id:"9433c9e5-782e-5bd5-8e74-099dff278f1a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"customer-perceived value: diagnostic misconception 781", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. the overall perception that a consumer has about a company, brand, or product and is measured by what the consumer is willing to pay in return for the features and benefits in the market offering", status:"approved", flawed_rule:"Customer-perceived value equals the company's own estimate of production quality."}}, {misconception_id:"MISC_DIRECT_CHANNEL_DIAGNOSTIC_MISCONCEPTION_782_F02ED3", properties:{kc_id:"e420833a-87f8-5e2d-ae21-f812de05a434", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"direct channel in chapter 17 Closing Company Case task 1: diagnostic misconception 1881", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Closing Company Case, task 1. when companies sell and distribute their products directly to consumers", status:"approved", flawed_rule:"A channel remains direct when independent wholesalers handle the sale."}}, {misconception_id:"MISC_DIRECT_MARKETING_CHANNEL_DIAGNOSTIC_MISCONCEPTIO_4D6FFF", properties:{kc_id:"5eef05de-1b56-55e2-bbbc-6ec7b9cd497b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"direct marketing channel: diagnostic misconception 783", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. when a manufacturer does not use intermediaries but rather involves the manufacturer distributing its market offering directly to consumers", status:"approved", flawed_rule:"Using an online retailer always makes the manufacturer's channel direct."}}, {misconception_id:"MISC_DISINTERMEDIATION_DIAGNOSTIC_MISCONCEPTION_784_7C22BB", properties:{kc_id:"785c6e6b-c67f-5a02-8655-9101e1cb9b14", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"disintermediation: diagnostic misconception 784", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. the process of removing an intermediary from a marketing channel", status:"approved", flawed_rule:"Removing a middleman eliminates the functions that middleman performed."}}, {misconception_id:"MISC_DISTRIBUTION_DIAGNOSTIC_MISCONCEPTION_785_413D5E", properties:{kc_id:"c80c985e-0ab3-5f21-8b68-8e01b64e7261", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"distribution in chapter 17 Marketing Plan Exercise task 1: diagnostic misconception 1880", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Marketing Plan Exercise, task 1. the process of making products and services available and accessible to consumers to purchase", status:"approved", flawed_rule:"Distribution means only physical transportation and excludes customer availability."}}, {misconception_id:"MISC_DISTRIBUTOR_DIAGNOSTIC_MISCONCEPTION_786_622241", properties:{kc_id:"27d57e3b-37b6-584d-998c-6397ca4dfaed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"distributor: diagnostic misconception 786", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. a type of intermediary that takes ownership of the product and tends to align itself closely with a manufacturer", status:"approved", flawed_rule:"A distributor is necessarily an agent that never takes ownership."}}, {misconception_id:"MISC_EXCLUSIVE_DISTRIBUTION_DIAGNOSTIC_MISCONCEPTION__F0493C", properties:{kc_id:"a0790f46-e059-5940-a663-3354ae6c1de3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"exclusive distribution: diagnostic misconception 787", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. a strategy that involves allowing a limited number of intermediaries to distribute a company’s market offering", status:"approved", flawed_rule:"Exclusive distribution means stocking the product through every available outlet."}}, {misconception_id:"MISC_FACILITATING_FUNCTIONS_DIAGNOSTIC_MISCONCEPTION__5DA91C", properties:{kc_id:"6c12c295-cca6-513f-a94e-887956c5b9ca", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"facilitating functions: diagnostic misconception 788", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. activities such as financing and information sharing in the marketing channel", status:"approved", flawed_rule:"Channel financing and information sharing have no distribution value."}}, {misconception_id:"MISC_FINAL_CONSUMER_DIAGNOSTIC_MISCONCEPTION_789_BB0878", properties:{kc_id:"f3467134-765a-59af-8a31-9d83cc0289b0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"final consumer: diagnostic misconception 789", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. the end user of a good or service", status:"approved", flawed_rule:"The final consumer must be an intermediary buying for resale."}}, {misconception_id:"MISC_HORIZONTAL_CONFLICT_DIAGNOSTIC_MISCONCEPTION_790_1C876B", properties:{kc_id:"6c8b1548-f109-50fd-a337-cd27556e885f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"horizontal conflict: diagnostic misconception 790", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. when there is disagreement among firms at the same level in the marketing channel", status:"approved", flawed_rule:"A disagreement between a manufacturer and its retailer is horizontal conflict."}}, {misconception_id:"MISC_HORIZONTAL_MARKETING_SYSTEM_DIAGNOSTIC_MISCONCEP_D5640D", properties:{kc_id:"25f44f8a-38ba-59c9-8d13-d4918dbf034b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"horizontal marketing system in chapter 17 Critical Thinking Exercises task 3: diagnostic misconception 1872", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Critical Thinking Exercises, task 3. a group of unrelated companies that offer products and services in a shared space", status:"approved", flawed_rule:"A horizontal system requires ownership of every successive supply-chain stage."}}, {misconception_id:"MISC_INDIRECT_CHANNEL_DIAGNOSTIC_MISCONCEPTION_792_0F79EF", properties:{kc_id:"01bd204d-cf18-5937-872b-47860a16c6e6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"indirect channel: diagnostic misconception 792", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. involves the utilization of one or more intermediaries to distribute a market offering to consumers", status:"approved", flawed_rule:"An indirect channel cannot operate online."}}, {misconception_id:"MISC_INTENSIVE_DISTRIBUTION_DIAGNOSTIC_MISCONCEPTION__623E5E", properties:{kc_id:"28a36719-cf14-5529-9747-856bdf218e83", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"intensive distribution: diagnostic misconception 793", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. a distribution strategy that entails distributing a company’s market offering through all possible intermediaries", status:"approved", flawed_rule:"Intensive distribution limits sales to a single authorized intermediary."}}, {misconception_id:"MISC_INVENTORY_MANAGEMENT_DIAGNOSTIC_MISCONCEPTION_79_D00ED0", properties:{kc_id:"abfeacbf-a088-57c9-be2c-7adda1330dec", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"inventory management in chapter 17 What Do Marketers Do? task 1: diagnostic misconception 1874", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, What Do Marketers Do?, task 1. a function that involves identifying the type of inventory and how much a company has on hand at any given time", status:"approved", flawed_rule:"Holding the maximum possible inventory always minimizes overall cost."}}, {misconception_id:"MISC_INVENTORY_TURNOVER_RATE_DIAGNOSTIC_MISCONCEPTION_2730E9", properties:{kc_id:"f6ff68c5-86db-5dfd-be07-17c7987b2dc4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"inventory turnover rate: diagnostic misconception 795", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. a metric that measures how quickly inventory is turned over, or sold", status:"approved", flawed_rule:"Inventory turnover is simply the number of units currently in storage."}}, {misconception_id:"MISC_LOGISTICAL_FUNCTIONS_DIAGNOSTIC_MISCONCEPTION_79_77563F", properties:{kc_id:"eedeaebe-baac-5808-8677-d3f88cf7e65b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"logistical functions: diagnostic misconception 796", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. the handling, packing, inventorying, transporting, warehousing, and ensuring the security of products as they make their way to the customer", status:"approved", flawed_rule:"Channel logistics is limited to promotional messaging."}}, {misconception_id:"MISC_LOGISTICS_DIAGNOSTIC_MISCONCEPTION_797_9689BB", properties:{kc_id:"379c93ea-311b-597f-93b6-b6e076251718", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"logistics: diagnostic misconception 797", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.6. the coordination of all supply chain activities, such as warehousing, inventory management, and transportation", status:"approved", flawed_rule:"Logistics and every strategic supply-chain decision are identical in scope."}}, {misconception_id:"MISC_MARKETING_CHANNEL_DIAGNOSTIC_MISCONCEPTION_798_09746E", properties:{kc_id:"12953b56-1f17-5726-b41f-0184e2cd2c5f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"marketing channel: diagnostic misconception 798", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_MULTICHANNEL_DISTRIBUTION_SYSTEM_DIAGNOSTIC_MISC_0D2A4E", properties:{kc_id:"ab45dfc0-25ab-57ea-a6c0-5c282e8efe00", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"multichannel distribution system: diagnostic misconception 799", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. where a single company sets up multiple distribution channels to reach customers", status:"approved", flawed_rule:"Operating multiple channels automatically creates a seamless integrated customer experience."}}, {misconception_id:"MISC_OMNICHANNEL_MARKETING_SYSTEM_DIAGNOSTIC_MISCONCE_298684", properties:{kc_id:"3a3d3353-2df2-592d-a783-2425194bbe76", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"omnichannel marketing system: diagnostic misconception 800", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. multichannel approach whereby companies give consumers a variety of ways to purchase, receive, and return products", status:"approved", flawed_rule:"Separate stores and websites constitute omnichannel service even when purchases and returns cannot connect."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_ORDER_ACCURACY_RATE_DIAGNOSTIC_MISCONCEPTION_801_25249A", properties:{kc_id:"837de390-1242-5562-9575-6194134d3853", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"order accuracy rate: diagnostic misconception 801", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. a metric that measures the percentage of orders that are processed, fulfilled, and shipped to consumers without any errors", status:"approved", flawed_rule:"Shipping quickly proves that the correct order was fulfilled."}}, {misconception_id:"MISC_PERCENTAGE_OF_ON_TIME_SHIPMENTS_DIAGNOSTIC_MISCO_9B4EF5", properties:{kc_id:"6ba8d8bc-debb-5034-8cbf-c751448d47c2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"percentage of on-time shipments: diagnostic misconception 802", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. a metric used to evaluate how well a channel member meets its promise of delivering goods on time", status:"approved", flawed_rule:"On-time shipment and perfect order accuracy are interchangeable measures."}}, {misconception_id:"MISC_PERISHABILITY_DIAGNOSTIC_MISCONCEPTION_803_B13564", properties:{kc_id:"2134dd09-0502-5d6f-955c-23119de1c006", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"perishability: diagnostic misconception 803", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. relates to the likelihood that a product will spoil, decay, or expire if not used in a timely manner", status:"approved", flawed_rule:"Every product can be stored indefinitely without quality loss."}}, {misconception_id:"MISC_POST_SALE_SERVICE_DIAGNOSTIC_MISCONCEPTION_804_2C8449", properties:{kc_id:"d61b285c-0dca-553c-94ba-69a23a4e64f3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"post-sale service: diagnostic misconception 804", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. all activities provided by a company that reinforce the value of the product or service for the buyer", status:"approved", flawed_rule:"Customer support has no value once ownership transfers."}}, {misconception_id:"MISC_PRE_SALE_SERVICE_DIAGNOSTIC_MISCONCEPTION_805_F8625E", properties:{kc_id:"45503b09-bab2-5368-b7b8-8217f908e9d7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"pre-sale service: diagnostic misconception 805", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. all activities provided by a company that help a buyer make a purchase decision", status:"approved", flawed_rule:"Service begins only after a purchase is complete."}}, {misconception_id:"MISC_PRODUCER_DIAGNOSTIC_MISCONCEPTION_806_A88DED", properties:{kc_id:"e02d1b11-acc1-5ec3-a977-69d0061fe2a1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"producer: diagnostic misconception 806", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. a company that supplies the raw materials that manufacturers need to create consumer products", status:"approved", flawed_rule:"A producer must also retail directly to every end user."}}, {misconception_id:"MISC_PRODUCER_TO_RETAILER_TO_CONSUMER_CHANNEL_DIAGNOS_E102ED", properties:{kc_id:"18acaecc-b250-5182-b3cb-bb1d686f1f94", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"producer to retailer to consumer channel: diagnostic misconception 807", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. when manufacturers or producers sell to retailers without the use of wholesalers or distributors", status:"approved", flawed_rule:"This route necessarily includes an independent wholesaler."}}, {misconception_id:"MISC_PURCHASING_DIAGNOSTIC_MISCONCEPTION_809_32CE38", properties:{kc_id:"a8179597-192b-5f84-9246-bdc80f434bd7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"purchasing: diagnostic misconception 809", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.5. the process of buying materials needed to manufacture products", status:"approved", flawed_rule:"Purchasing inputs and selling finished goods are the same supply-chain function."}}, {misconception_id:"MISC_RETAILER_DIAGNOSTIC_MISCONCEPTION_810_AD0BA7", properties:{kc_id:"7ef9edde-9529-538f-b45d-a06648987ae3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"retailer: diagnostic misconception 810", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. a type of intermediary where retailers take ownership of the product and their sole focus is on reaching the end user or customer directly", status:"approved", flawed_rule:"A retailer's defining customer is another reseller rather than the final consumer."}}, {misconception_id:"MISC_SELECTIVE_DISTRIBUTION_DIAGNOSTIC_MISCONCEPTION__E7FA31", properties:{kc_id:"a73c6ca7-7e1b-5095-87dd-3d6dfb3236c9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"selective distribution: diagnostic misconception 811", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. a strategy that includes choosing more than one, but fewer than all possible intermediaries to distribute a company’s market offering", status:"approved", flawed_rule:"Selective distribution means using every possible outlet."}}, {misconception_id:"MISC_STANDARDIZED_DIAGNOSTIC_MISCONCEPTION_812_A37BE2", properties:{kc_id:"289e5860-4750-5bac-81b6-d3d10d724403", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"standardized: diagnostic misconception 812", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.3. products that have no difference in how they are manufactured", status:"approved", flawed_rule:"Standardized products require a unique custom configuration for each buyer."}}, {misconception_id:"MISC_SUPPLY_CHAIN_DIAGNOSTIC_MISCONCEPTION_813_949614", properties:{kc_id:"086730c2-c654-50e1-bfc8-52c9f6d96afe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"supply chain in chapter 17 Closing Company Case task 4: diagnostic misconception 1884", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Closing Company Case, task 4. a network between a company and its suppliers to produce and distribute a specific product to the final buyer", status:"approved", flawed_rule:"A supply chain starts at the retailer and excludes raw-material suppliers."}}, {misconception_id:"MISC_SUPPLY_CHAIN_MANAGEMENT_DIAGNOSTIC_MISCONCEPTION_1B5A5A", properties:{kc_id:"566bec21-9123-5468-a6f7-230e66c9ae1f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"supply chain management: diagnostic misconception 814", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.5. all members and activities from the procurement and transformation of raw materials into finished goods through their distribution to targeted consumers", status:"approved", flawed_rule:"Supply-chain management concerns shipping alone."}}, {misconception_id:"MISC_SUSTAINABILITY_DIAGNOSTIC_MISCONCEPTION_815_865A76", properties:{kc_id:"8f359a03-dcc7-52f8-b553-7bba5f06e5f7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sustainability in chapter 17 Building Your Personal Brand task 1: diagnostic misconception 1873", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Building Your Personal Brand, task 1. a company’s effort to reduce its impact on the environment as products move from source procurement through production through distribution to final consumers", status:"approved", flawed_rule:"A faster shipment is automatically environmentally preferable."}}, {misconception_id:"MISC_SUSTAINABLE_SOURCING_DIAGNOSTIC_MISCONCEPTION_81_CE0C75", properties:{kc_id:"4ea8e1c6-98cb-55bb-9cf8-eb7f12e47c16", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"sustainable sourcing: diagnostic misconception 816", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.7. the process of considering suppliers’ social, ethical, and environmental performance", status:"approved", flawed_rule:"Lowest purchase price alone establishes a sustainable supplier choice."}}, {misconception_id:"MISC_TARGET_MARKET_COVERAGE_DIAGNOSTIC_MISCONCEPTION__BC07FE", properties:{kc_id:"e93752c3-3194-5ac5-b94e-90a73e786e94", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"target market coverage in chapter 17 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1868", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Applied Marketing Knowledge: Discussion Questions, task 3. resources and capabilities needed to reach consumers in a company’s target market", status:"approved", flawed_rule:"More outlets necessarily mean better access to the intended target customers."}}, {misconception_id:"MISC_THIRD_PARTY_LOGISTICS_3PL_PROVIDER_DIAGNOSTIC_MI_688C50", properties:{kc_id:"c5e3b914-caf1-5a02-9372-19f64f01f392", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"third-party logistics (3PL) provider: diagnostic misconception 818", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.6. a company that is contracted by a channel member to handle one or more of the functional areas of logistics; often warehouses, distribution centers, or fulfillment centers that have expertise in managing certain logistical activities", status:"approved", flawed_rule:"Using a 3PL transfers every strategic and ethical responsibility away from the contracting firm."}}, {misconception_id:"MISC_TIME_TO_SHIP_DIAGNOSTIC_MISCONCEPTION_819_B0173D", properties:{kc_id:"e16af073-a9df-5dca-acbb-ad0f4303f230", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"time to ship in chapter 17 Closing Company Case task 3: diagnostic misconception 1883", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Closing Company Case, task 3. also known as order cycle time, the length of time from when a customer places an order to when it reaches them", status:"approved", flawed_rule:"Dispatch time and total order-to-delivery cycle time are always interchangeable."}}, {misconception_id:"MISC_TOTAL_NUMBER_OF_ORDERS_DIAGNOSTIC_MISCONCEPTION__077992", properties:{kc_id:"a51a6791-8fd5-50ac-b913-7f30fe909307", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"total number of orders: diagnostic misconception 820", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. the sum of all orders that a company received in a given time period", status:"approved", flawed_rule:"Order count alone reveals revenue, fulfillment accuracy, and profitability."}}, {misconception_id:"MISC_TOTAL_UNITS_IN_STORAGE_DIAGNOSTIC_MISCONCEPTION__A692FA", properties:{kc_id:"431e7ad6-7f1f-5551-abce-624464b9584e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"total units in storage: diagnostic misconception 821", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. a metric used to evaluate warehouse efficiency that changes as items are sold and leave the warehouse and new inventory moves in", status:"approved", flawed_rule:"A larger stock count necessarily means better warehouse efficiency."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_TRANSACTIONAL_FUNCTIONS_DIAGNOSTIC_MISCONCEPTION_B838D0", properties:{kc_id:"7fb08194-80f1-5c2f-b333-c2a832ff14fe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"transactional functions: diagnostic misconception 822", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.1. buying, selling, and risk-bearing that goes along with the movement of products along the marketing channel", status:"approved", flawed_rule:"Buying, selling, and bearing channel risk are merely physical transport tasks."}}, {misconception_id:"MISC_UNIT_VALUE_DIAGNOSTIC_MISCONCEPTION_823_60D30B", properties:{kc_id:"0f4c130a-e99f-50d7-91fc-a0cc827167b1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"unit value in chapter 17 What Do Marketers Do? task 6: diagnostic misconception 1879", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, What Do Marketers Do?, task 6. the price that a company charges for one unit or item", status:"approved", flawed_rule:"The price per unit is irrelevant to channel cost and service requirements."}}, {misconception_id:"MISC_VERTICAL_CONFLICT_DIAGNOSTIC_MISCONCEPTION_824_543768", properties:{kc_id:"cefdff90-d964-5e80-af13-d2a77029ffe9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"vertical conflict: diagnostic misconception 824", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.4. a conflict that exists between different levels of a vertical channel", status:"approved", flawed_rule:"A dispute between competing retailers at the same level is vertical conflict."}}, {misconception_id:"MISC_VERTICAL_MARKETING_SYSTEM_DIAGNOSTIC_MISCONCEPTI_F9FD17", properties:{kc_id:"cab01be0-0cd9-5fa7-b4fa-5e2ec74d2cee", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"vertical marketing system in chapter 17 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1867", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17, Applied Marketing Knowledge: Discussion Questions, task 2. companies in the marketing channel that work together in a coordinated, collaborative, and customer-centric way", status:"approved", flawed_rule:"Every channel member must optimize independently without coordination."}}, {misconception_id:"MISC_WAREHOUSING_DIAGNOSTIC_MISCONCEPTION_826_CAB237", properties:{kc_id:"ff52fcc7-27da-5649-8bf0-ee395b4243f1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"warehousing: diagnostic misconception 826", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.6. the stocking, maintaining, and controlling of products while they await the next step in their journey to the final consumer", status:"approved", flawed_rule:"Warehousing is only leaving products idle and creates no availability benefit."}}, {misconception_id:"MISC_WHOLESALER_DIAGNOSTIC_MISCONCEPTION_827_F26DC4", properties:{kc_id:"429f4075-538d-5201-bcd0-94b10c82ec14", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"wholesaler: diagnostic misconception 827", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 17 Key Terms, printed page 605, and section 17.2. similar to distributors in that they take ownership of products; buys products in large quantities for the purpose of distributing an assortment of products to retailers", status:"approved", flawed_rule:"A wholesaler's main function is small-quantity final-consumer retail sales."}}, {misconception_id:"MISC_AUTOMATIC_VENDING_DIAGNOSTIC_MISCONCEPTION_828_5CF5FA", properties:{kc_id:"91c6f8cf-1f3a-550c-a28b-1138044c7846", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"automatic vending: diagnostic misconception 828", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. the use of an electronic device that dispenses a product", status:"approved", flawed_rule:"Automated retail cannot provide customer convenience because no salesperson is present."}}, {misconception_id:"MISC_CASH_AND_CARRY_WHOLESALERS_DIAGNOSTIC_MISCONCEPT_95892D", properties:{kc_id:"df49b413-464d-5efe-a528-c8667728d99f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"cash-and-carry wholesalers: diagnostic misconception 829", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. wholesalers that offer a limited line of fast-moving goods that they sell to retailers for cash", status:"approved", flawed_rule:"Cash-and-carry wholesalers necessarily provide credit and full delivery services."}}, {misconception_id:"MISC_CATEGORY_KILLERS_DIAGNOSTIC_MISCONCEPTION_830_8FA731", properties:{kc_id:"28d676f9-8b61-5c1a-9538-b6e609912364", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"category killers: diagnostic misconception 830", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. large superstores, most often chains stores, that are bigger, cheaper, and more convenient than competitors", status:"approved", flawed_rule:"Category killers carry all categories equally rather than dominating a specialty."}}, {misconception_id:"MISC_CATEGORY_MANAGEMENT_DIAGNOSTIC_MISCONCEPTION_831_9FAFBE", properties:{kc_id:"452437ed-5f4f-5f24-a2cf-d638afba377a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"category management: diagnostic misconception 831", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. grouping similar products into categories based on customer usage", status:"approved", flawed_rule:"Category management organizes merchandise only around suppliers, regardless of customer use."}}, {misconception_id:"MISC_CENTRAL_BUSINESS_DISTRICT_CBD_DIAGNOSTIC_MISCONC_C407FE", properties:{kc_id:"ac72050f-34c0-59e4-98be-8ca6362c073e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"central business district (CBD) in chapter 18 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1888", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Applied Marketing Knowledge: Discussion Questions, task 4. the commercial and business center of a given city or town", status:"approved", flawed_rule:"A city's commercial center has the same costs and customer access as every suburban site."}}, {misconception_id:"MISC_CONVENIENCE_STORE_DIAGNOSTIC_MISCONCEPTION_833_5B896D", properties:{kc_id:"18d5fd1d-6917-5fcc-a7a0-fdccf29facef", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"convenience store in chapter 18 Closing Company Case task 4: diagnostic misconception 1899", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Closing Company Case, task 4. a small retail business that stocks a limited range of everyday items such as groceries, snacks, soft drinks, tobacco, toiletries, and lottery tickets", status:"approved", flawed_rule:"A convenience store competes primarily through the widest full-service assortment."}}, {misconception_id:"MISC_DEPARTMENT_STORES_DIAGNOSTIC_MISCONCEPTION_834_D36411", properties:{kc_id:"775d7a7e-1bf0-59df-b954-b8a4f8f84f23", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"department stores in chapter 18 Closing Company Case task 3: diagnostic misconception 1898", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Closing Company Case, task 3. larger retailers that have separated areas—or departments—for similar product lines", status:"approved", flawed_rule:"A department store specializes in only one narrow product line."}}, {misconception_id:"MISC_DIGITAL_WALLETS_DIAGNOSTIC_MISCONCEPTION_835_32F174", properties:{kc_id:"01080609-f0e6-549f-a811-8b3350b5f910", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"digital wallets: diagnostic misconception 835", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.4. software-based systems that allow for secure transactions", status:"approved", flawed_rule:"A digital wallet is identical to a physical cash drawer and has no transaction-security implications."}}, {misconception_id:"MISC_DIRECT_MAIL_DIAGNOSTIC_MISCONCEPTION_836_3FDAE1", properties:{kc_id:"07c8d6af-164f-5e19-a519-5b88e23a8911", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"direct mail: diagnostic misconception 836", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. solicited or unsolicited advertising of products and services to prospective customers through the mail", status:"approved", flawed_rule:"Direct mail requires customers to visit a retail store to receive the message."}}, {misconception_id:"MISC_DIRECT_SELLING_DIAGNOSTIC_MISCONCEPTION_837_FA1335", properties:{kc_id:"9aa55ed1-de4a-5e4b-a702-83f2f066d2df", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"direct selling in chapter 18 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1885", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Applied Marketing Knowledge: Discussion Questions, task 1. a marketing strategy that involves selling products and services directly to the consumer in a non-retail setting", status:"approved", flawed_rule:"Direct selling always takes place inside a permanent retail shop."}}, {misconception_id:"MISC_DISCOUNT_STORE_DIAGNOSTIC_MISCONCEPTION_838_4595D1", properties:{kc_id:"e28c05dd-0cf8-5cc7-aab5-bfdaa223ab89", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"discount store: diagnostic misconception 838", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. retailer that sells a broad range of products at lower prices than competitors", status:"approved", flawed_rule:"Every low-price retailer uses the same product sourcing and assortment model."}}, {misconception_id:"MISC_DROP_SHIPPERS_DIAGNOSTIC_MISCONCEPTION_839_E6C3CE", properties:{kc_id:"5630bd82-0b2e-5788-a8a2-1235a4a2e2a8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"drop shippers: diagnostic misconception 839", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. a wholesaler business model where retailers use suppliers to ship products directly to the end consumer", status:"approved", flawed_rule:"Drop shippers must physically warehouse every item before the customer receives it."}}, {misconception_id:"MISC_FACTORY_OUTLETS_DIAGNOSTIC_MISCONCEPTION_840_48F6EF", properties:{kc_id:"9cd9e7b5-c800-5c69-9e76-259e567e9b6f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"factory outlets: diagnostic misconception 840", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. retailers that offer overstocked merchandise at discounted prices", status:"approved", flawed_rule:"Factory outlets and full-price flagship stores use identical inventory and pricing models."}}, {misconception_id:"MISC_FALSE_OR_MISLEADING_ADVERTISING_DIAGNOSTIC_MISCO_A6C04D", properties:{kc_id:"610526bf-7345-5bd4-8854-af8b626e9c50", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"false or misleading advertising: diagnostic misconception 841", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.7. an unethical marketing practice by which consumers are given false or misleading information about a product or service", status:"approved", flawed_rule:"An advertisement cannot mislead if one isolated statement is literally true."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_FREESTANDING_RETAIL_LOCATIONS_DIAGNOSTIC_MISCONC_D46093", properties:{kc_id:"982b2c74-c4df-5efd-aa83-4f72d30b0479", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"freestanding retail locations in chapter 18 Closing Company Case task 2: diagnostic misconception 1897", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Closing Company Case, task 2. store retailers that are not attached to any other retailer or establishment", status:"approved", flawed_rule:"A freestanding site automatically benefits from the same shared traffic as a shopping mall."}}, {misconception_id:"MISC_FULL_SERVICE_WHOLESALERS_DIAGNOSTIC_MISCONCEPTIO_E92789", properties:{kc_id:"9260a982-846a-5f79-8da0-359eb21d6377", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"full-service wholesalers: diagnostic misconception 843", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. wholesalers that offer retailers the most complete range of services, such as buying, selling, storage, transportation, sorting, and financing", status:"approved", flawed_rule:"Full-service wholesalers only transfer title and provide no storage or financing."}}, {misconception_id:"MISC_GENERAL_MERCHANDISE_FULL_LINE_WHOLESALERS_DIAGNO_90CEE1", properties:{kc_id:"409d613e-b7bd-5590-883b-4831468f3128", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"general-merchandise (full-line) wholesalers: diagnostic misconception 844", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. wholesalers that offer an extensive list of merchandise for sale", status:"approved", flawed_rule:"General-merchandise wholesalers carry one very narrow specialized line."}}, {misconception_id:"MISC_GROSS_MARGIN_DIAGNOSTIC_MISCONCEPTION_845_77D293", properties:{kc_id:"badef868-8bb4-5608-8a04-38deaaa18cd6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"gross margin: diagnostic misconception 845", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. net sales minus the cost of goods sold", status:"approved", flawed_rule:"Gross margin equals net profit after every operating cost."}}, {misconception_id:"MISC_INTERMEDIARIES_DIAGNOSTIC_MISCONCEPTION_846_20F06F", properties:{kc_id:"50fc5373-2136-5aad-b5a2-30428f8558e9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"intermediaries: diagnostic misconception 846", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.1. companies that act as liaisons between the buyer and seller", status:"approved", flawed_rule:"Eliminating intermediaries always eliminates rather than reallocates their work."}}, {misconception_id:"MISC_KEYSTONE_PRICING_DIAGNOSTIC_MISCONCEPTION_847_439476", properties:{kc_id:"f2e7fd64-2ab9-5629-94f3-7dd1507ec890", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"keystone pricing in chapter 18 Marketing Plan Exercise task 1: diagnostic misconception 1895", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Marketing Plan Exercise, task 1. a pricing strategy that doubles the price from the wholesaler or manufacturer", status:"approved", flawed_rule:"Doubling cost creates a 100 percent margin on the selling price."}}, {misconception_id:"MISC_LIMITED_SERVICE_WHOLESALERS_DIAGNOSTIC_MISCONCEP_AFBFD9", properties:{kc_id:"2a076171-7a0f-569d-9668-53329da90206", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"limited-service wholesalers: diagnostic misconception 848", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. wholesalers that offer a limited range of services to retailers to increase value", status:"approved", flawed_rule:"Limited-service wholesalers offer every possible supporting service."}}, {misconception_id:"MISC_MAINTAINED_MARKUP_DIAGNOSTIC_MISCONCEPTION_849_5109B3", properties:{kc_id:"2b6cef5f-bdb6-51a0-95e6-bfb850a37588", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"maintained markup: diagnostic misconception 849", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. the actual markup on the merchandise that is sold to the consumer", status:"approved", flawed_rule:"The initial planned markup always equals the markup actually realized after price changes."}}, {misconception_id:"MISC_MANUFACTURER_S_AGENTS_DIAGNOSTIC_MISCONCEPTION_8_7C2618", properties:{kc_id:"20155a3a-b0b3-5e14-80d8-d370acbed896", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"manufacturer’s agents: diagnostic misconception 850", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. independent contractors who act as salespeople for multiple manufacturers to sell similar (but not competing) products to retailers", status:"approved", flawed_rule:"A manufacturer's agent must take ownership of all the goods represented."}}, {misconception_id:"MISC_MARKDOWN_DIAGNOSTIC_MISCONCEPTION_851_42FAEC", properties:{kc_id:"fd8f845a-501c-5f83-82e3-744aba0b9651", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"markdown: diagnostic misconception 851", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. a price decrease for a product that is at the end of its life cycle or season", status:"approved", flawed_rule:"A markdown raises the original selling price."}}, {misconception_id:"MISC_MARKUP_DIAGNOSTIC_MISCONCEPTION_852_EE1A21", properties:{kc_id:"86156539-cfc6-523b-88f7-e1656042c6bd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"markup in chapter 18 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1887", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Applied Marketing Knowledge: Discussion Questions, task 3. the amount added to the cost retailers purchase goods for", status:"approved", flawed_rule:"Markup percentage and gross-margin percentage always use the same denominator."}}, {misconception_id:"MISC_MERCHANDISE_DIAGNOSTIC_MISCONCEPTION_853_F60AEB", properties:{kc_id:"8044f13e-7cff-5f73-ab8b-08f97d9657ca", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"merchandise: diagnostic misconception 853", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. the goods that are being offered for sale by a retailer", status:"approved", flawed_rule:"Merchandise refers only to the store's advertising materials."}}, {misconception_id:"MISC_MERCHANT_WHOLESALERS_DIAGNOSTIC_MISCONCEPTION_85_61CD93", properties:{kc_id:"58b87da8-fd05-55f3-8bad-6ed851a85f61", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"merchant wholesalers in chapter 18 Critical Thinking Exercises task 2: diagnostic misconception 1891", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Critical Thinking Exercises, task 2. wholesalers that engage in buying, storing, and physically handling products in large quantities and selling those products in smaller quantities to retailers", status:"approved", flawed_rule:"Merchant wholesalers do not own or physically handle inventory."}}, {misconception_id:"MISC_NON_STORE_RETAILERS_DIAGNOSTIC_MISCONCEPTION_855_867372", properties:{kc_id:"075f032b-588b-548d-ae2d-ad7409af5622", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"non-store retailers in chapter 18 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1886", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Applied Marketing Knowledge: Discussion Questions, task 2. retailers that operate outside of traditional brick-and-mortar locations", status:"approved", flawed_rule:"Retailing requires a permanent physical shop."}}, {misconception_id:"MISC_OFF_PRICE_RETAILERS_DIAGNOSTIC_MISCONCEPTION_856_C51756", properties:{kc_id:"57cde906-e62a-55e2-ac29-9d9910bd347f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"off-price retailers: diagnostic misconception 856", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. retailers that provide high-quality goods at lower prices", status:"approved", flawed_rule:"Off-price retailers necessarily sell only defective goods."}}, {misconception_id:"MISC_OMNICHANNEL_MARKETING_DIAGNOSTIC_MISCONCEPTION_8_64BD0C", properties:{kc_id:"4c6f91ab-ec1f-5682-937f-f5b462a415f7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"omnichannel marketing: diagnostic misconception 857", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. Coordination of multiple channels into a connected customer experience. The brief chapter 18 glossary wording emphasizes multiple channels; the connected purchasing, receiving, and returning perspective in section 17.2 clarifies how this differs from merely multichannel operation.", status:"approved", flawed_rule:"Merely adding disconnected channels guarantees an integrated customer experience."}}, {misconception_id:"MISC_OMNICHANNEL_STRATEGY_DIAGNOSTIC_MISCONCEPTION_85_E30F63", properties:{kc_id:"5452be89-53f7-54a8-830a-22612b7bc3ad", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"omnichannel strategy: diagnostic misconception 858", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. A coordinated approach to customer interactions across channels, including buying, receiving, and returning. Read chapter 18’s brief multi-channel wording alongside section 17.2’s integrated customer experience.", status:"approved", flawed_rule:"Customers can never cross between buying, receiving, and returning channels in an omnichannel strategy."}}, {misconception_id:"MISC_ONLINE_RETAILING_DIAGNOSTIC_MISCONCEPTION_859_DFF5C7", properties:{kc_id:"78713a94-c782-54a3-8e49-26c3d504668f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"online retailing: diagnostic misconception 859", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. a business model that allows consumers to search and purchase products remotely over the Internet", status:"approved", flawed_rule:"Online retailing removes all fulfillment and customer service requirements."}}, {misconception_id:"MISC_ORIGINAL_MARKUP_DIAGNOSTIC_MISCONCEPTION_860_3FD91F", properties:{kc_id:"26a1f9c0-0d49-5efa-8af0-88addea6ee1c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"original markup: diagnostic misconception 860", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. the markup a business has decided upon at the onset of the offering, which includes planned sales and overhead", status:"approved", flawed_rule:"The original markup already incorporates the actual effect of later markdowns."}}, {misconception_id:"MISC_PRODUCT_TRACEABILITY_DIAGNOSTIC_MISCONCEPTION_86_7A5E87", properties:{kc_id:"1a13eaf9-d698-56ee-a527-77c92fd0c319", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"product traceability: diagnostic misconception 861", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.6. the ability to track all processes for a product from the procurement of raw materials to production, consumption, and disposal", status:"approved", flawed_rule:"Traceability begins only when the finished item reaches the retailer."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_RACK_JOBBERS_DIAGNOSTIC_MISCONCEPTION_862_15AB56", properties:{kc_id:"2d072e7d-a715-5dae-a062-d7ef22246784", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"rack jobbers: diagnostic misconception 862", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. wholesalers (or manufacturers) that agree with retailers to display and sell a product in a retail store", status:"approved", flawed_rule:"Rack jobbers have no role in displaying or maintaining the goods they supply."}}, {misconception_id:"MISC_REGIONAL_SHOPPING_CENTERS_DIAGNOSTIC_MISCONCEPTI_FD3097", properties:{kc_id:"7db88ca3-108f-582a-9a9e-a435eecc8ffd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"regional shopping centers: diagnostic misconception 863", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. commonly referred to as “malls”; collection of stores that offer general merchandise or fashion-oriented offerings", status:"approved", flawed_rule:"A regional shopping center is a single freestanding store."}}, {misconception_id:"MISC_RETAILING_DIAGNOSTIC_MISCONCEPTION_864_8E1A19", properties:{kc_id:"dc4655dc-0d1b-53cf-91e6-69f7f869f2a3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"retailing: diagnostic misconception 864", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.1. the process of selling goods and services to consumers", status:"approved", flawed_rule:"Retailing is defined by physical premises rather than sale to final consumers."}}, {misconception_id:"MISC_SOCIAL_COMMERCE_DIAGNOSTIC_MISCONCEPTION_865_986E3D", properties:{kc_id:"35461780-a1b2-5f1a-8c01-a437ab835bb1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"social commerce: diagnostic misconception 865", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.4. a blend of e-commerce and social media", status:"approved", flawed_rule:"Social commerce means discussing a brand online without any link to purchasing."}}, {misconception_id:"MISC_SPECIALTY_STORES_DIAGNOSTIC_MISCONCEPTION_866_A56CF5", properties:{kc_id:"c8e13c6a-a592-5916-aedd-48c727f90a1d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"specialty stores: diagnostic misconception 866", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. retailers that focus on selling a single type of product or a single product line", status:"approved", flawed_rule:"Specialty stores compete through the broadest range of unrelated categories."}}, {misconception_id:"MISC_SPECIALTY_WHOLESALERS_DIAGNOSTIC_MISCONCEPTION_8_3CDF0F", properties:{kc_id:"00e11ba0-4921-577a-a5a6-b601fcc17818", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"specialty wholesalers in chapter 18 What Do Marketers Do? task 1: diagnostic misconception 1894", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, What Do Marketers Do?, task 1. wholesalers that focus on a limited line of products but carry the line in some depth", status:"approved", flawed_rule:"Specialty wholesalers carry many unrelated product lines with little depth."}}, {misconception_id:"MISC_STORE_RETAILER_DIAGNOSTIC_MISCONCEPTION_868_A2E6B9", properties:{kc_id:"e38f143e-d65f-5efa-89a9-5a1fdb6dc281", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"store retailer in chapter 18 Critical Thinking Exercises task 3: diagnostic misconception 1892", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18, Critical Thinking Exercises, task 3. a traditional brick-and-mortar establishment where products are displayed for customers to purchase", status:"approved", flawed_rule:"Store retailers cannot combine physical selling with digital channels."}}, {misconception_id:"MISC_STRIP_MALLS_DIAGNOSTIC_MISCONCEPTION_869_9165C6", properties:{kc_id:"badb245b-4073-57dc-a8ba-9e5b88d7f048", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"strip malls: diagnostic misconception 869", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.3. classified by an attached row of retail stores offering both products and services", status:"approved", flawed_rule:"A strip mall is a single enclosed regional department store."}}, {misconception_id:"MISC_SUPERMARKET_DIAGNOSTIC_MISCONCEPTION_870_565831", properties:{kc_id:"cf9b7799-b5b5-5511-a19f-c2c634c9a0e3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"supermarket: diagnostic misconception 870", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. retailer that mostly focuses on a product mix of grocery items but also carries household and personal items and offers limited services", status:"approved", flawed_rule:"A supermarket's primary assortment is unrelated to groceries and household needs."}}, {misconception_id:"MISC_SUPERSTORES_DIAGNOSTIC_MISCONCEPTION_871_B0BE3A", properties:{kc_id:"089ad54d-8265-5491-a077-a8be89df52b7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"superstores: diagnostic misconception 871", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. very large retailers that have characteristics of both supermarkets and department stores", status:"approved", flawed_rule:"Superstores are merely small convenience shops with limited inventories."}}, {misconception_id:"MISC_TELEVISION_HOME_SHOPPING_DIAGNOSTIC_MISCONCEPTIO_3460F3", properties:{kc_id:"72f3ac0c-6d9a-51a4-a918-79eb0f6d5c35", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"television home shopping: diagnostic misconception 873", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. a business practice in which products or services are sold via television", status:"approved", flawed_rule:"Television home shopping requires the consumer to visit the seller's physical shop."}}, {misconception_id:"MISC_TRUCK_JOBBERS_DIAGNOSTIC_MISCONCEPTION_874_0D3BFF", properties:{kc_id:"4cef6d65-ba12-5311-b85f-36e09ea2a177", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"truck jobbers: diagnostic misconception 874", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. wholesalers that make calls to retailers carrying goods on a truck", status:"approved", flawed_rule:"Truck jobbers only arrange sales and never transport their stock."}}, {misconception_id:"MISC_WAREHOUSE_CLUBS_DIAGNOSTIC_MISCONCEPTION_875_8984A5", properties:{kc_id:"7606cb39-cbf6-5015-97cb-b4fb73216503", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"warehouse clubs: diagnostic misconception 875", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.2. retailers that sell goods in bulk at discounted prices", status:"approved", flawed_rule:"Warehouse clubs are designed mainly for small single-item purchases at premium prices."}}, {misconception_id:"MISC_WHOLESALING_DIAGNOSTIC_MISCONCEPTION_876_6D43EA", properties:{kc_id:"c13881da-c8ae-5ff8-ab4b-42d25cdc0562", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"wholesaling: diagnostic misconception 876", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 18 Key Terms, printed page 643, and section 18.5. the business of buying goods in bulk at a discount from a manufacturer or other distribution channel member and selling them retailers for a higher price", status:"approved", flawed_rule:"Wholesaling is primarily the sale of small quantities to final consumers."}}, {misconception_id:"MISC_CONSUMER_ORIENTED_MARKETING_DIAGNOSTIC_MISCONCEP_D7F58F", properties:{kc_id:"d59a43bc-7192-54de-968b-364e562c4e3f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"consumer-oriented marketing: diagnostic misconception 877", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19 Key Terms, printed page 665, and section 19.4. marketing strategies focused on customer needs and solving their problems", status:"approved", flawed_rule:"Consumer-oriented marketing begins with the firm's existing inventory regardless of needs."}}, {misconception_id:"MISC_CUSTOMER_VALUE_MARKETING_DIAGNOSTIC_MISCONCEPTIO_429076", properties:{kc_id:"aaec1f97-41e8-56a2-a1aa-53a6f08dee6f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"customer-value marketing in chapter 19 Building Your Personal Brand task 1: diagnostic misconception 1908", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19, Building Your Personal Brand, task 1. marketing strategies in which a company works to provide the customer with maximum value compared to competitors", status:"approved", flawed_rule:"Customer value means maximizing the seller's price without considering benefits and sacrifice."}}, {misconception_id:"MISC_ECONOMIC_PILLAR_GOVERNANCE_PILLAR_DIAGNOSTIC_MIS_40ED73", properties:{kc_id:"77305033-ced4-5ac3-823b-91cfac3bd2b6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"economic pillar (governance pillar): diagnostic misconception 880", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19 Key Terms, printed page 665, and section 19.1. the sustainability pillar that concerns profitability and business ethics", status:"approved", flawed_rule:"Sustainability requires ignoring business viability and ethical governance."}}, {misconception_id:"MISC_ENVIRONMENTAL_PILLAR_DIAGNOSTIC_MISCONCEPTION_88_D84C2A", properties:{kc_id:"18d88f74-f1c6-5cd0-bd1e-969c3aa008d9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"environmental pillar in chapter 19 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1902", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19, Applied Marketing Knowledge: Discussion Questions, task 3. the sustainability pillar that focuses on reducing a company’s impact on the environment", status:"approved", flawed_rule:"A green advertisement alone establishes reduced environmental impact."}}, {misconception_id:"MISC_ENVIRONMENTAL_SOCIAL_AND_GOVERNANCE_STRATEGY_DIA_92EB5F", properties:{kc_id:"9acaef2a-1c42-5673-8351-da26b3a56a03", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"environmental, social, and governance strategy in chapter 19 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1903", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19, Applied Marketing Knowledge: Discussion Questions, task 4. a strategy that holds companies accountable for a sustainability strategy", status:"approved", flawed_rule:"An ESG strategy can be evaluated without evidence or accountability measures."}}, {misconception_id:"MISC_ESG_PILLARS_DIAGNOSTIC_MISCONCEPTION_883_9AFACD", properties:{kc_id:"9fe51e61-ab4e-56fe-b7fd-52fca827ef4a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"ESG pillars in chapter 19 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1901", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19, Applied Marketing Knowledge: Discussion Questions, task 2. the three pillars of environmental, social, and governance that guide corporate sustainability work", status:"approved", flawed_rule:"Environmental performance alone represents all three ESG dimensions."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_INNOVATIVE_MARKETING_DIAGNOSTIC_MISCONCEPTION_88_FB1D27", properties:{kc_id:"1e6ee99d-feb7-5c57-978d-3d14eca4d757", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"innovative marketing: diagnostic misconception 884", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19 Key Terms, printed page 665, and section 19.4. Developing or improving offerings and marketing approaches to create customer value, discussed among the sustainable marketing principles in section 19.4. Avoid reading the glossary’s emphasis on media as an exhaustive definition of innovation.", status:"approved", flawed_rule:"Marketing innovation is only using a fashionable medium, regardless of customer value."}}, {misconception_id:"MISC_MISSION_DRIVEN_MARKETING_DIAGNOSTIC_MISCONCEPTIO_5DB5BF", properties:{kc_id:"ef1398a7-2ae4-5255-81d7-d9ea040539e6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"mission-driven marketing in chapter 19 Critical Thinking Exercises task 3: diagnostic misconception 1907", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19, Critical Thinking Exercises, task 3. marketing strategies that align purpose and brand by using the corporate core mission and purpose as their focus", status:"approved", flawed_rule:"A campaign can be mission-driven even when its claims contradict the organization's purpose and actions."}}, {misconception_id:"MISC_PURPOSE_DRIVEN_STRATEGY_DIAGNOSTIC_MISCONCEPTION_39CCE3", properties:{kc_id:"7a5b66da-e62a-5bca-a60c-6111af9c2449", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"purpose-driven strategy: diagnostic misconception 886", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19 Key Terms, printed page 665, and section 19.5. strategy in which companies work to make a difference in their communities through their decisions and support of environmental programs", status:"approved", flawed_rule:"A purpose statement alone demonstrates positive community outcomes."}}, {misconception_id:"MISC_SOCIAL_PILLAR_DIAGNOSTIC_MISCONCEPTION_887_C5E2F4", properties:{kc_id:"1593b234-b279-5e72-ae68-ba8d5fad95e9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"social pillar: diagnostic misconception 887", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19 Key Terms, printed page 665, and section 19.1. the sustainability pillar that focuses on creating an inclusive environment for the community", status:"approved", flawed_rule:"Sustainability excludes employee conditions, inclusion, and community well-being."}}, {misconception_id:"MISC_SOCIETAL_MARKETING_DIAGNOSTIC_MISCONCEPTION_888_938A11", properties:{kc_id:"ae1f2099-2eb7-5931-96e9-1a5dfc34461f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"societal marketing: diagnostic misconception 888", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19 Key Terms, printed page 665, and section 19.4. a marketing strategy focused on fulfilling social responsibility obligations while also satisfying customer needs", status:"approved", flawed_rule:"Satisfying immediate customer wants necessarily satisfies wider social responsibility."}}, {misconception_id:"MISC_SUSTAINABLE_MARKETING_DIAGNOSTIC_MISCONCEPTION_8_7A299A", properties:{kc_id:"acf6cbc6-7eec-56fe-a237-c7201b7bd744", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"sustainable marketing in chapter 19 Critical Thinking Exercises task 1: diagnostic misconception 1905", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use chapter 19, Critical Thinking Exercises, task 1. a marketing strategy that infuses purpose into socially conscious products and services", status:"approved", flawed_rule:"Sustainable marketing is just green promotion detached from product and operational decisions."}}, {misconception_id:"MISC_TRACE_THE_FIVE_STEP_MARKETING_PROCESS_DIAGNOSTIC_11C59B", properties:{kc_id:"df9ecca1-22ba-590c-81c7-dff7dd9e94d3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Trace the five-step marketing process: diagnostic misconception 890", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 1.1 (Marketing and the Marketing Process). Connect understanding markets and customers, designing a customer-driven strategy, delivering an integrated program, building relationships, and capturing value in return.", status:"approved", flawed_rule:"Capturing value can sustainably precede creating and delivering customer value."}}, {misconception_id:"MISC_DISTINGUISH_NEEDS_WANTS_AND_DEMAND_DIAGNOSTIC_MI_872534", properties:{kc_id:"375bbc62-943a-58b2-8919-cc5e8b89fbac", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Distinguish needs, wants, and demand: diagnostic misconception 891", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 1.1 (Marketing and the Marketing Process). Explain how underlying needs, culturally shaped wants, and willingness and ability to buy differ in identifying a viable offering.", status:"approved", flawed_rule:"Every stated want constitutes effective market demand."}}, {misconception_id:"MISC_APPLY_THE_FIVE_INTERNAL_MS_DIAGNOSTIC_MISCONCEPT_624F36", properties:{kc_id:"e1f03f25-950b-52b0-912d-bbc765ab6247", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apply the five internal Ms: diagnostic misconception 892", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 1.3 (Factors Comprising and Affecting the Marketing Environment). Assess minds, minutes, machinery, materials, and money as internal resources constraining marketing execution.", status:"approved", flawed_rule:"An appealing campaign can be executed without checking staff, time, equipment, inputs, or funds."}}, {misconception_id:"MISC_SEPARATE_MICROENVIRONMENT_AND_MACROENVIRONMENT_D_813980", properties:{kc_id:"c4cbc101-8cbe-5a75-92e3-54887794c1ff", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Separate microenvironment and macroenvironment: diagnostic misconception 893", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 1.3 (Factors Comprising and Affecting the Marketing Environment). Classify suppliers, intermediaries, customers, competitors, and publics separately from broad political, economic, social, technological, legal, and environmental forces.", status:"approved", flawed_rule:"A supplier-specific delivery failure and a nationwide economic recession belong to the same environmental level."}}, {misconception_id:"MISC_COMPARE_OPERATIONAL_ANALYTICAL_AND_COLLABORATIVE_85BA8C", properties:{kc_id:"5db0bf10-886c-53f7-b26d-fab5b8b1b218", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare operational, analytical, and collaborative CRM: diagnostic misconception 894", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 1.6 (Customer Relationship Management (CRM)). Distinguish operational automation, analysis of customer information, and coordination across teams or contact channels.", status:"approved", flawed_rule:"Automating a sales workflow also completes customer analysis and cross-team information sharing."}}, {misconception_id:"MISC_CONSTRUCT_SMART_OBJECTIVES_DIAGNOSTIC_MISCONCEPT_0111BB", properties:{kc_id:"4d91c92d-3192-5cbf-8bde-054e27c22f8a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Construct SMART objectives: diagnostic misconception 895", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.1 (Developing a Strategic Plan). Write objectives that are specific, measurable, attainable, realistic, and time-bound, using the textbook's stated SMART formulation.", status:"approved", flawed_rule:"Increase awareness is a complete SMART objective without an audience, measure, or deadline."}}, {misconception_id:"MISC_ALIGN_MISSION_VISION_AND_COMPANY_VALUES_DIAGNOST_4A25B8", properties:{kc_id:"2c345f0c-e422-55cb-9ae5-bbf4614c22a3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Align mission, vision, and company values: diagnostic misconception 896", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.1 (Developing a Strategic Plan). Connect current purpose, intended future position, and decision principles to strategic choices and monitoring.", status:"approved", flawed_rule:"An aspirational vision can replace both current purpose and behavioral commitments."}}, {misconception_id:"MISC_CLASSIFY_BCG_STARS_DIAGNOSTIC_MISCONCEPTION_897_66B085", properties:{kc_id:"d5f22f6e-b6a8-5059-b155-dfb981222411", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Classify BCG stars: diagnostic misconception 897", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.2 (The Role of Marketing in the Strategic Planning Process). Identify business units with high relative market share in high-growth markets and assess their investment needs.", status:"approved", flawed_rule:"A star necessarily produces surplus cash and requires no further investment."}}, {misconception_id:"MISC_CLASSIFY_BCG_CASH_COWS_DIAGNOSTIC_MISCONCEPTION__E507E4", properties:{kc_id:"911b57f2-d659-508e-90d3-b671c944794e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Classify BCG cash cows: diagnostic misconception 898", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.2 (The Role of Marketing in the Strategic Planning Process). Identify strong-share units in low-growth markets and explain their role in generating funds for a portfolio.", status:"approved", flawed_rule:"A cash cow must operate in the fastest-growing market."}}, {misconception_id:"MISC_CLASSIFY_BCG_QUESTION_MARKS_DIAGNOSTIC_MISCONCEP_CE7D9E", properties:{kc_id:"0663fa11-3e2c-5c06-a7cb-a8fc743ef742", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Classify BCG question marks: diagnostic misconception 899", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.2 (The Role of Marketing in the Strategic Planning Process). Assess low-share units in high-growth markets and evaluate whether investment can improve competitive position.", status:"approved", flawed_rule:"Every question mark deserves unlimited investment simply because its market grows."}}, {misconception_id:"MISC_CLASSIFY_BCG_DOGS_DIAGNOSTIC_MISCONCEPTION_900_0A408A", properties:{kc_id:"532478d0-b557-5a15-a08c-dadec5fa2006", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Classify BCG dogs: diagnostic misconception 900", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.2 (The Role of Marketing in the Strategic Planning Process). Assess low-share units in low-growth markets while considering strategic context before a divestment decision.", status:"approved", flawed_rule:"The dog label alone proves that immediate divestment is always optimal."}}, {misconception_id:"MISC_APPLY_THE_PRODUCT_MARKET_GROWTH_MATRIX_DIAGNOSTI_2FF231", properties:{kc_id:"2c23fdd1-51b4-54de-9e72-0bf2c3f16ec2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apply the product-market growth matrix: diagnostic misconception 901", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.2 (The Role of Marketing in the Strategic Planning Process). Distinguish penetration, market development, product development, and diversification by existing versus new products and markets.", status:"approved", flawed_rule:"Every growth initiative is diversification regardless of which product-market dimension changes."}}, {misconception_id:"MISC_BUILD_A_COMPLETE_MARKETING_PLAN_DIAGNOSTIC_MISCO_30CD7A", properties:{kc_id:"3fccd791-2441-537a-9775-7fb9745c62bd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Build a complete marketing plan: diagnostic misconception 902", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.3 (Purpose and Structure of the Marketing Plan). Integrate executive summary, current situation, objectives and issues, segmentation and positioning, strategies, action programs, budget, and controls.", status:"approved", flawed_rule:"A creative promotional idea is a complete plan without assigned actions, resources, or controls."}}, {misconception_id:"MISC_TRANSLATE_STRATEGY_INTO_ACTION_PROGRAMS_DIAGNOST_B1FE31", properties:{kc_id:"851c0d97-7102-515e-a1a2-dc82fbdf927a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Translate strategy into action programs: diagnostic misconception 903", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.3 (Purpose and Structure of the Marketing Plan). Specify what will be done, when, by whom, and at what cost to make marketing strategy executable.", status:"approved", flawed_rule:"Naming a strategic objective automatically assigns responsibility and implementation timing."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_DESIGN_MARKETING_CONTROLS_DIAGNOSTIC_MISCONCEPTI_8258E0", properties:{kc_id:"e558e410-d171-5bea-ba2d-ccde3682fb7c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Design marketing controls: diagnostic misconception 904", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.3 (Purpose and Structure of the Marketing Plan). Choose monitoring measures and corrective actions linked to plan objectives and budgets.", status:"approved", flawed_rule:"Controls are useful only after the entire plan has finished."}}, {misconception_id:"MISC_CALCULATE_AVERAGE_REVENUE_PER_CUSTOMER_DIAGNOSTI_681A9D", properties:{kc_id:"aa269a0e-aa0f-5916-8b03-3a1fa43e322a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Calculate average revenue per customer: diagnostic misconception 905", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.4 (Marketing Plan Progress Using Metrics). Divide period revenue by the appropriate customer count, maintain a consistent period, and compare segments without treating revenue as profit.", status:"approved", flawed_rule:"Average revenue per customer is total profit divided by the number of website visits."}}, {misconception_id:"MISC_INTERPRET_INCREMENTAL_SALES_REVENUE_DIAGNOSTIC_M_9BAC7A", properties:{kc_id:"47a29c80-a8c7-5c11-ad23-491a0a76bedd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Interpret incremental sales revenue: diagnostic misconception 906", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.4 (Marketing Plan Progress Using Metrics). Separate additional sales associated with an initiative from total sales and consider the comparison baseline.", status:"approved", flawed_rule:"All sales during a campaign were caused by that campaign."}}, {misconception_id:"MISC_CALCULATE_MARKET_SHARE_AND_RELATIVE_MARKET_SHARE_14FD6B", properties:{kc_id:"a0331fe5-ee58-5787-8709-b8a7a5076239", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Calculate market share and relative market share: diagnostic misconception 907", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.4 (Marketing Plan Progress Using Metrics). Distinguish the firm's share of category sales from its share relative to a leading competitor, specifying units or revenue and market boundaries.", status:"approved", flawed_rule:"Relative market share and category market share always have the same denominator."}}, {misconception_id:"MISC_MEASURE_CUSTOMER_RETENTION_RATES_DIAGNOSTIC_MISC_D6A214", properties:{kc_id:"15fcfa76-e7b2-5dc8-a686-5b5cfb088d03", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Measure customer retention rates: diagnostic misconception 908", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.4 (Marketing Plan Progress Using Metrics). Use a defined customer cohort and period to assess repeat relationships rather than counting newly acquired customers as retained customers.", status:"approved", flawed_rule:"New customer acquisition automatically raises the retention rate of the original cohort."}}, {misconception_id:"MISC_EVALUATE_CUSTOMER_RESOLUTION_RATE_AND_TIME_DIAGN_A7C498", properties:{kc_id:"ac40ae9e-7e7e-570f-85a1-7dc22a4f06a7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate customer resolution rate and time: diagnostic misconception 909", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.4 (Marketing Plan Progress Using Metrics). Distinguish how many support cases are resolved from how long resolution takes, and consider service quality alongside speed.", status:"approved", flawed_rule:"Closing tickets quickly proves customers' underlying problems have been solved."}}, {misconception_id:"MISC_COMPARE_ACQUISITION_COST_WITH_CUSTOMER_LIFETIME__87E161", properties:{kc_id:"7e0796da-a0c4-5d00-8934-ebeb71dc67ab", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare acquisition cost with customer lifetime value: diagnostic misconception 910", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 2.4 (Marketing Plan Progress Using Metrics). Use the textbook's worked segment comparison to connect customer profit per period, retention duration, and acquisition investment, while distinguishing modeled estimates from realized cash flows.", status:"approved", flawed_rule:"The segment with the most new customers always has the highest economic value."}}, {misconception_id:"MISC_USE_INVOLVEMENT_AND_PERCEIVED_BRAND_DIFFERENCES__A549D0", properties:{kc_id:"1ba6a8ae-0a48-5bfc-98b5-932836f5c3c3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Use involvement and perceived brand differences: diagnostic misconception 911", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.1 (Understanding Consumer Markets and Buying Behavior). Classify complex, dissonance-reducing, habitual, and variety-seeking buying using both involvement and perceived brand differentiation.", status:"approved", flawed_rule:"Price alone determines which of the four buying-behavior categories applies."}}, {misconception_id:"MISC_ANALYZE_MASLOW_S_FIVE_NEED_CATEGORIES_DIAGNOSTIC_18FD29", properties:{kc_id:"91bafb5c-a55d-5096-8def-3dc2db027033", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze Maslow's five need categories: diagnostic misconception 912", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.2 (Factors That Influence Consumer Buying Behavior). Distinguish physiological, safety, social, esteem, and self-actualization motives in a purchase without assuming identical motivation for all consumers.", status:"approved", flawed_rule:"An expensive product can satisfy only esteem needs and no other motives."}}, {misconception_id:"MISC_DIAGNOSE_NEED_RECOGNITION_DIAGNOSTIC_MISCONCEPTI_19C90C", properties:{kc_id:"8d9cf145-ef8a-543f-9bc9-165da9337a97", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Diagnose need recognition: diagnostic misconception 913", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.3 (The Consumer Purchasing Decision Process). Identify the gap between a consumer's actual and desired state and distinguish internal from external triggers.", status:"approved", flawed_rule:"A need exists only after an advertisement creates it."}}, {misconception_id:"MISC_ANALYZE_CONSUMER_INFORMATION_SEARCH_DIAGNOSTIC_M_7CA025", properties:{kc_id:"9b417b62-88f3-5534-be4b-8b2747012740", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze consumer information search: diagnostic misconception 914", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.3 (The Consumer Purchasing Decision Process). Compare memory-based internal search with information from personal, commercial, public, and experiential external sources.", status:"approved", flawed_rule:"Consumers obtain all decision information directly from the seller."}}, {misconception_id:"MISC_EVALUATE_ALTERNATIVES_AND_DETERMINANT_CRITERIA_D_60F9DE", properties:{kc_id:"d2e02e08-f412-5631-9ee5-38e2e2f53b97", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate alternatives and determinant criteria: diagnostic misconception 915", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.3 (The Consumer Purchasing Decision Process). Use relevant attributes and consumer priorities to compare a consideration set of offerings.", status:"approved", flawed_rule:"Consumers attach identical weights to every available product attribute."}}, {misconception_id:"MISC_EXPLAIN_THE_PURCHASE_DECISION_DIAGNOSTIC_MISCONC_39B612", properties:{kc_id:"0efc737e-e640-59a3-a030-75e1b6dac2cc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Explain the purchase decision: diagnostic misconception 916", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.3 (The Consumer Purchasing Decision Process). Distinguish purchase intention from actual choice, allowing for intervening social and situational influences.", status:"approved", flawed_rule:"Expressed intention guarantees the same eventual purchase."}}, {misconception_id:"MISC_ANALYZE_POST_PURCHASE_EVALUATION_DIAGNOSTIC_MISC_25B15D", properties:{kc_id:"a7b393e1-da7e-5d6b-88ef-7d3792e049d2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze post-purchase evaluation: diagnostic misconception 917", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.3 (The Consumer Purchasing Decision Process). Relate expectations, experienced performance, satisfaction, dissonance, and future behavior.", status:"approved", flawed_rule:"Consumer decision-making stops once payment has been made."}}, {misconception_id:"MISC_EVALUATE_ETHICAL_CONSUMERISM_DIAGNOSTIC_MISCONCE_99804E", properties:{kc_id:"64e9c5d5-6fce-578a-842f-cf7ab4451d38", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate ethical consumerism: diagnostic misconception 918", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 3.4 (Ethical Issues in Consumer Buying Behavior). Explain how consumers may consider environmental, social, and organizational conduct alongside price and functionality.", status:"approved", flawed_rule:"An ethical purchase is determined only by the lowest price."}}, {misconception_id:"MISC_COMPARE_B2B_AND_B2C_MARKET_STRUCTURES_DIAGNOSTIC_49F8F7", properties:{kc_id:"c2ca922e-3bc5-54b0-9722-5977f321937d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare B2B and B2C market structures: diagnostic misconception 919", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 4.1 (The Business-to-Business (B2B) Market). Analyze buyer numbers and size, geographic concentration, derived and fluctuating demand, buying professionalism, relationships, and decision complexity.", status:"approved", flawed_rule:"B2B marketing is simply consumer marketing with a larger order quantity."}}, {misconception_id:"MISC_SEQUENCE_THE_EIGHT_STAGE_B2B_BUYING_PROCESS_DIAG_F47C82", properties:{kc_id:"19b406fb-94c9-5086-bfbd-e370f9b8f0c2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Sequence the eight-stage B2B buying process: diagnostic misconception 920", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 4.4 (Stages in the B2B Buying Process). Trace problem recognition, general need description, product specification, supplier search, proposal solicitation, supplier selection, order-routine specification, and performance review; note variation by buy class.", status:"approved", flawed_rule:"A routine reorder must repeat every first-purchase stage with identical intensity."}}, {misconception_id:"MISC_ANALYZE_CONDITIONAL_INFLUENCES_ON_PROCUREMENT_DI_E03513", properties:{kc_id:"1a79b48c-d08d-5306-bc82-2a30baad0614", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze conditional influences on procurement: diagnostic misconception 921", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 4.3 (Major Influences on B2B Buyer Behavior). Assess time constraints, financial conditions, and product availability alongside organizational and interpersonal factors.", status:"approved", flawed_rule:"A technically preferred supplier will always be selected regardless of timing and availability."}}, {misconception_id:"MISC_COMBINE_SEGMENTATION_BASES_DIAGNOSTIC_MISCONCEPT_297C6A", properties:{kc_id:"c2dc0db1-7d7d-5d12-9626-2f361c183256", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Combine segmentation bases: diagnostic misconception 922", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 5.1 (Market Segmentation and Consumer Markets). Combine geographic, demographic, behavioral, and psychographic information to form actionable segments.", status:"approved", flawed_rule:"A single demographic variable always adequately captures customer needs."}}, {misconception_id:"MISC_USE_ACTIVITIES_INTERESTS_AND_OPINIONS_DIAGNOSTIC_CBA1D5", properties:{kc_id:"0717294d-8a6a-5952-be46-e2c759c57c0c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Use activities, interests, and opinions: diagnostic misconception 923", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 5.1 (Market Segmentation and Consumer Markets). Apply AIO information to psychographic segmentation and distinguish it from purely demographic classification.", status:"approved", flawed_rule:"Knowing a customer's age fully specifies activities, interests, and opinions."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_COMPARE_INTERNATIONAL_SEGMENTATION_BASES_DIAGNOS_B22D9C", properties:{kc_id:"99bee53e-717e-585d-b5f6-4a2a620b2044", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare international segmentation bases: diagnostic misconception 924", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 5.3 (Segmentation of International Markets). Segment across geographic, economic, political-legal, and cultural conditions rather than assuming national borders uniquely define needs.", status:"approved", flawed_rule:"All customers within one country belong to one meaningful segment."}}, {misconception_id:"MISC_TEST_ALL_FIVE_ADAMS_CRITERIA_DIAGNOSTIC_MISCONCE_03C564", properties:{kc_id:"ed6c50a8-ded4-5bad-8eb2-856bd669e523", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Test all five ADAMS criteria: diagnostic misconception 925", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 5.4 (Essential Factors in Effective Market Segmentation). Assess accessibility, differentiability, actionability, measurability, and substantiality before selecting a segment.", status:"approved", flawed_rule:"A measurable segment is useful even if it cannot be reached or served profitably."}}, {misconception_id:"MISC_EVALUATE_TARGETING_OF_VULNERABLE_GROUPS_DIAGNOST_9CFF37", properties:{kc_id:"a755be23-e0ad-51b2-adb3-e45751401a7f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate targeting of vulnerable groups: diagnostic misconception 926", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 5.7 (Ethical Concerns and Target Marketing). Examine ethnic profiling and targeting of children, older adults, and low-income consumers, distinguishing relevant service from manipulation.", status:"approved", flawed_rule:"A profitable response from a vulnerable audience is sufficient proof that targeting is ethical."}}, {misconception_id:"MISC_DESIGN_THE_SEVEN_STAGE_RESEARCH_PLAN_DIAGNOSTIC__6C1D5E", properties:{kc_id:"224ed7c1-c69c-5581-8d9a-368697bf12cc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Design the seven-stage research plan: diagnostic misconception 927", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 6.3 (Steps in a Successful Marketing Research Plan). Move from problem definition through research design, collection method, sampling, collection, analysis and interpretation, to reporting actionable findings.", status:"approved", flawed_rule:"Data collection should begin before specifying the business question and sampling approach."}}, {misconception_id:"MISC_COMPARE_EXPLORATORY_DESCRIPTIVE_AND_CAUSAL_RESEA_AA49D0", properties:{kc_id:"42d3302b-3978-5c35-84e4-e819e41fa52e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare exploratory, descriptive, and causal research: diagnostic misconception 928", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 6.3 (Steps in a Successful Marketing Research Plan). Match research design to discovery, measurement, or causal inference and distinguish association from causation.", status:"approved", flawed_rule:"Descriptive survey correlations prove the effect of a marketing intervention."}}, {misconception_id:"MISC_CONSTRUCT_AN_UNBIASED_QUESTIONNAIRE_DIAGNOSTIC_M_CEB6DF", properties:{kc_id:"226d111d-60b6-58b4-9b5e-eae74940b9fc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Construct an unbiased questionnaire: diagnostic misconception 929", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 6.3 (Steps in a Successful Marketing Research Plan). Use clear wording and appropriate response options; evaluate how leading, ambiguous, or double-barreled questions distort answers.", status:"approved", flawed_rule:"A question about product quality and price can be answered with one rating without ambiguity."}}, {misconception_id:"MISC_AUDIT_SAMPLE_COVERAGE_AND_NONRESPONSE_DIAGNOSTIC_EFEFA6", properties:{kc_id:"2bef14c7-f069-557b-aa64-dd1f30fcca14", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Audit sample coverage and nonresponse: diagnostic misconception 930", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 6.3 (Steps in a Successful Marketing Research Plan). Distinguish target population, sampling frame, sample design, and achieved respondents when judging representativeness.", status:"approved", flawed_rule:"A large achieved response count eliminates coverage and nonresponse bias."}}, {misconception_id:"MISC_REPORT_RESEARCH_FOR_A_BUSINESS_DECISION_DIAGNOST_37C4CB", properties:{kc_id:"b36af02e-306e-57c7-81ca-9b0fa94a8d7b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Report research for a business decision: diagnostic misconception 931", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 6.3 (Steps in a Successful Marketing Research Plan). Translate quantitative results and qualitative observations into evidence-supported recommendations with clear limitations.", status:"approved", flawed_rule:"A visually impressive report is sufficient even if recommendations do not follow from the data."}}, {misconception_id:"MISC_EVALUATE_BENEFITS_AND_RISKS_OF_INTERNATIONAL_TRA_8686F0", properties:{kc_id:"a924f1de-9f74-552d-8f8b-23f9d6d8cbf1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate benefits and risks of international trade: diagnostic misconception 932", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 7.1 (The Global Market and Advantages of International Trade). Compare revenue, growth, competition, risk diversification, and surplus disposal against regulatory, cultural, and operating challenges.", status:"approved", flawed_rule:"Entering more countries automatically lowers total business risk."}}, {misconception_id:"MISC_CONDUCT_AN_INTERNAL_GLOBAL_READINESS_ASSESSMENT__2A63BD", properties:{kc_id:"5d8a69c3-127c-5811-9066-6b720e54c156", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Conduct an internal global-readiness assessment: diagnostic misconception 933", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 7.2 (Assessment of Global Markets for Opportunities). Assess organizational capabilities and resources before comparing external foreign-market opportunities.", status:"approved", flawed_rule:"Strong foreign demand compensates for any lack of internal capability."}}, {misconception_id:"MISC_COMPARE_THE_CPI_WTO_AND_TRADE_BLOCS_DIAGNOSTIC_M_528009", properties:{kc_id:"ab8daaad-3009-562a-8c6b-a9c1055d9660", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare the CPI, WTO, and trade blocs: diagnostic misconception 934", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 7.2 (Assessment of Global Markets for Opportunities). Distinguish corruption-risk information, international trade institutions, and regional trade agreements when assessing international market access.", status:"approved", flawed_rule:"A trade agreement guarantees low corruption and identical local rules."}}, {misconception_id:"MISC_COMPARE_INTERNATIONAL_ENTRY_COMMITMENTS_DIAGNOST_4AFF0A", properties:{kc_id:"c81ed0d5-29e7-5fcd-8393-5bc38cfdfc12", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare international entry commitments: diagnostic misconception 935", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 7.3 (Entering the Global Arena). Evaluate exporting, licensing, franchising, alliances, joint ventures, and direct investment in terms of control, resources, and exposure.", status:"approved", flawed_rule:"The entry mode with the most control is always the least risky and least costly."}}, {misconception_id:"MISC_ADAPT_THE_INTERNATIONAL_MARKETING_MIX_DIAGNOSTIC_C8D868", properties:{kc_id:"12d02a88-857b-566a-8f5c-9fd8b76e6f4b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Adapt the international marketing mix: diagnostic misconception 936", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 7.4 (Marketing in a Global Environment). Coordinate product, price, place, and promotion with local markets, exchange rates, whole-channel conditions, and cultural meanings.", status:"approved", flawed_rule:"Only advertising language needs adjustment when a firm enters another country."}}, {misconception_id:"MISC_ASSESS_GLOBAL_LABOR_AND_SOURCING_ETHICS_DIAGNOST_F33DCC", properties:{kc_id:"d7bf1645-d7ff-5765-864d-38577066690b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Assess global labor and sourcing ethics: diagnostic misconception 937", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 7.5 (Ethical Issues in the Global Marketplace). Evaluate working conditions, child labor, equal opportunity, outsourcing, bribery, and corruption using the textbook's international examples.", status:"approved", flawed_rule:"Outsourcing removes the marketer's responsibility for labor conditions in its supply chain."}}, {misconception_id:"MISC_DISTINGUISH_TANGIBLE_AND_INTANGIBLE_CULTURE_DIAG_541652", properties:{kc_id:"2d216c6b-1059-5b8c-8a2b-2fdf103049d6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Distinguish tangible and intangible culture: diagnostic misconception 938", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.3 (Multicultural Marketing). Compare visible artifacts and symbols with underlying values, beliefs, meanings, and behavioral norms.", status:"approved", flawed_rule:"Observing clothing and food reveals all the values influencing a customer's decisions."}}, {misconception_id:"MISC_ANALYZE_INDIVIDUALISM_AND_COLLECTIVISM_DIAGNOSTI_AA6B54", properties:{kc_id:"52c88ec3-17c9-5671-8ffe-2ac0830e9d04", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze individualism and collectivism: diagnostic misconception 939", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.3 (Multicultural Marketing). Use Hofstede's dimension to discuss relative emphasis on individual and group relationships without assigning fixed traits to every member.", status:"approved", flawed_rule:"A national-level collectivism score predicts every individual's purchase motives."}}, {misconception_id:"MISC_ANALYZE_POWER_DISTANCE_DIAGNOSTIC_MISCONCEPTION__46E065", properties:{kc_id:"eeab1793-45ba-5b1d-9eb6-c8eb86d3972d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze power distance: diagnostic misconception 940", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.3 (Multicultural Marketing). Use the dimension to examine expectations about unequal power and authority while recognizing within-group variation.", status:"approved", flawed_rule:"High power distance proves every consumer passively obeys authority."}}, {misconception_id:"MISC_ANALYZE_UNCERTAINTY_AVOIDANCE_DIAGNOSTIC_MISCONC_4150D9", properties:{kc_id:"85840bee-132e-58e2-88d4-7362612f107b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze uncertainty avoidance: diagnostic misconception 941", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.3 (Multicultural Marketing). Examine cultural responses to ambiguity and uncertainty without equating a group tendency with an immutable individual trait.", status:"approved", flawed_rule:"Uncertainty avoidance is identical to rejecting every new product."}}, {misconception_id:"MISC_INTERPRET_MASCULINITY_AND_FEMININITY_IN_HOFSTEDE_7537DA", properties:{kc_id:"9edb7abe-c718-51a9-b0a6-2c4abb999359", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Interpret masculinity and femininity in Hofstede's framework: diagnostic misconception 942", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.3 (Multicultural Marketing). Explain the framework's terminology for achievement-competition versus care-quality-of-life orientations without treating it as biological sex or individual gender identity.", status:"approved", flawed_rule:"The dimension classifies individual men and women rather than cultural value emphases."}}, {misconception_id:"MISC_COMPARE_LONG_TERM_AND_SHORT_TERM_ORIENTATION_DIA_74D4C6", properties:{kc_id:"9ef7c90b-fb16-598a-8a14-2ee814a5849a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare long-term and short-term orientation: diagnostic misconception 943", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.3 (Multicultural Marketing). Analyze how time horizons and traditions may affect value propositions and planning without assuming uniform behavior.", status:"approved", flawed_rule:"A long-term-oriented culture never responds to immediate benefits."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_COMPARE_INDULGENCE_AND_RESTRAINT_DIAGNOSTIC_MISC_3EA5F1", properties:{kc_id:"7e370d8c-d0f9-59db-a692-2e401c99eff7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare indulgence and restraint: diagnostic misconception 944", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.3 (Multicultural Marketing). Interpret cultural regulation of gratification without treating national scores as complete predictions of individual demand.", status:"approved", flawed_rule:"Every consumer in a restraint-oriented culture rejects enjoyable products."}}, {misconception_id:"MISC_USE_THE_ACCULTURATION_SPECTRUM_DIAGNOSTIC_MISCON_5A09A4", properties:{kc_id:"bf037a85-50ab-5ec8-b0c2-4558f1bc5fbd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Use the acculturation spectrum: diagnostic misconception 945", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.4 (Marketing to Hispanic, Black, and Asian Consumers). Recognize variations in cultural connection, language, and identity across and within Hispanic, Black, and Asian communities.", status:"approved", flawed_rule:"Time in a new country necessarily produces identical cultural assimilation for everyone."}}, {misconception_id:"MISC_COMPARE_GENERATIONAL_COHORTS_RESPONSIBLY_DIAGNOS_B9DE8D", properties:{kc_id:"b438b477-1d21-5105-9052-198da5a7d1d2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare generational cohorts responsibly: diagnostic misconception 946", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.5 (Marketing to Sociodemographic Groups). Discuss the textbook's named cohorts from the Lost Generation through Generation Alpha while separating cohort conventions, life stage, and individual variation.", status:"approved", flawed_rule:"A generational label alone establishes an individual's media use or values."}}, {misconception_id:"MISC_ASSESS_DEMOGRAPHIC_TRENDS_AS_DATED_EVIDENCE_DIAG_A87BD2", properties:{kc_id:"de0d698a-d436-524d-ab16-75456fff3f48", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Assess demographic trends as dated evidence: diagnostic misconception 947", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.5 (Marketing to Sociodemographic Groups). Interpret population stagnation, older consumers' spending, and changing sociodemographics within the publication's time and geography.", status:"approved", flawed_rule:"A demographic projection in a 2023 textbook is an unchanging current fact."}}, {misconception_id:"MISC_DISTINGUISH_INCLUSION_FROM_TOKEN_REPRESENTATION__8FA150", properties:{kc_id:"3dfbf058-06d9-562a-b502-071a4d3b7c3a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Distinguish inclusion from token representation: diagnostic misconception 948", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 8.6 (Ethical Issues in Diversity Marketing). Assess research, representation, organizational practices, and the fit between customer values and marketing action.", status:"approved", flawed_rule:"A diverse image alone proves inclusive customer treatment."}}, {misconception_id:"MISC_RECONCILE_THE_SOURCE_S_PRODUCT_LEVEL_INCONSISTEN_FA737F", properties:{kc_id:"d9acb117-41a0-5ab9-9169-097b5b8c6eed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Reconcile the source's product-level inconsistency: diagnostic misconception 949", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 9.1 (Products, Services, and Experiences). Explain core, actual, and augmented product levels from section 9.1's body and diagram. Flag that its learning outcome says four levels while the substantive exposition presents three.", status:"approved", flawed_rule:"The wording of a learning-outcome bullet proves a fourth level exists even when the section only explains three."}}, {misconception_id:"MISC_COMPARE_UPWARD_DOWNWARD_AND_TWO_WAY_STRETCHING_D_B33C23", properties:{kc_id:"3078eab1-8c02-5b6b-ad3f-3b619ba2f86f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare upward, downward, and two-way stretching: diagnostic misconception 950", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 9.2 (Product Items, Product Lines, and Product Mixes). Use Tesla, Godiva, and Dell examples to assess range boundaries, target segments, brand perceptions, and cannibalization risks.", status:"approved", flawed_rule:"Stretching into a cheaper tier cannot affect perceptions or sales of an existing premium tier."}}, {misconception_id:"MISC_SELECT_LIFE_CYCLE_STRATEGIES_UNDER_UNCERTAINTY_D_D709B5", properties:{kc_id:"b4608cee-0cac-5a83-b151-96c8be1b2cdd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Select life-cycle strategies under uncertainty: diagnostic misconception 951", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 9.4 (Marketing Strategies at Each Stage of the Product Life Cycle). Relate introduction, growth, maturity, and decline to pricing, promotion, market or product modification, harvesting, and divestment.", status:"approved", flawed_rule:"The life-cycle label alone dictates the optimal tactic without considering market evidence."}}, {misconception_id:"MISC_EVALUATE_PACKAGING_AND_LABELING_FUNCTIONS_DIAGNO_BCB7CE", properties:{kc_id:"0f73336b-b1ae-51c9-b4b4-5b78f07fe7e7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate packaging and labeling functions: diagnostic misconception 952", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 9.7 (Creating Value through Packaging and Labeling). Assess protection, identification, information, differentiation, convenience, and promotional value alongside product safety.", status:"approved", flawed_rule:"Packaging exists only to make the product visually attractive."}}, {misconception_id:"MISC_COMPARE_PACKAGING_SUSTAINABILITY_STRATEGIES_DIAG_0F3837", properties:{kc_id:"f7fb766b-0ca7-5181-aafe-12f92a3fb0ed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare packaging sustainability strategies: diagnostic misconception 953", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 9.8 (Environmental Concerns Regarding Packaging). Evaluate material reduction, reuse, recycling, and cradle-to-cradle design in relation to waste and the product life cycle.", status:"approved", flawed_rule:"A recyclable label proves the package is actually collected and recycled."}}, {misconception_id:"MISC_EVALUATE_PACKAGING_HONESTY_AND_SAFETY_DIAGNOSTIC_9C2B13", properties:{kc_id:"3d29dacb-8d30-5b66-bb8e-f5b07e5fcc71", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate packaging honesty and safety: diagnostic misconception 954", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 9.9 (Ethical Issues in Packaging). Assess misleading package sizes, labels, environmental claims, and product protection from the consumer's perspective.", status:"approved", flawed_rule:"An attractive package is ethical even if the quantity or product claims mislead consumers."}}, {misconception_id:"MISC_COMPARE_SALES_WAVE_CONTROLLED_AND_SIMULATED_TEST_6F9433", properties:{kc_id:"bbda6ea4-52cc-5675-8a4c-0fb719d5e66a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare sales-wave, controlled, and simulated test markets: diagnostic misconception 955", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.2 (Stages of the New Product Development Process). Distinguish repeated trial-and-purchase observation, controlled retail tests, and simulated buying environments when testing new products.", status:"approved", flawed_rule:"A simulated test reproduces every operational and competitive condition of a full launch."}}, {misconception_id:"MISC_INTERPRET_TIME_TO_VALUE_DIAGNOSTIC_MISCONCEPTION_47CBFD", properties:{kc_id:"42fb3c14-e8c0-525f-a5b2-3e194df38e25", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Interpret time to value: diagnostic misconception 956", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.3 (The Use of Metrics in Evaluating New Products). Measure how long new users take to recognize the offering's benefit, contrasting immediate digital delivery with delayed value realization.", status:"approved", flawed_rule:"Time to value is identical to how long the company took to build the product."}}, {misconception_id:"MISC_CALCULATE_AND_QUALIFY_ADOPTION_RATE_DIAGNOSTIC_M_603C07", properties:{kc_id:"f2f7976f-0d19-5ce5-9193-0c00de392d77", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Calculate and qualify adoption rate: diagnostic misconception 957", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.3 (The Use of Metrics in Evaluating New Products). Use the textbook's new-user-to-total-user formulation with an explicit period and population and distinguish it from retention and market penetration.", status:"approved", flawed_rule:"One adoption-rate percentage establishes repeat usage and satisfaction."}}, {misconception_id:"MISC_AUDIT_THE_TEXTBOOK_S_SIMPLIFIED_MARKETING_ROI_DI_6BCE91", properties:{kc_id:"c00916a8-49cc-5ad7-bae0-921daa795f72", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Audit the textbook's simplified marketing ROI: diagnostic misconception 958", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.3 (The Use of Metrics in Evaluating New Products). Reproduce the source's sales-minus-marketing-cost calculation while identifying its omission of product costs, other expenses, and a causal counterfactual; avoid labeling it net business profit.", status:"approved", flawed_rule:"Revenue less campaign spend equals fully costed incremental profit."}}, {misconception_id:"MISC_DIAGNOSE_NEW_PRODUCT_FAILURE_DIAGNOSTIC_MISCONCE_51B75F", properties:{kc_id:"417db177-f19d-5668-b446-b797f90873be", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Diagnose new-product failure: diagnostic misconception 959", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.4 (Factors Contributing to the Success or Failure of New Products). Consider lack of customer value, weak research, timing, competition, positioning, organizational fit, and execution rather than a single universal cause.", status:"approved", flawed_rule:"Technical quality alone guarantees product success."}}, {misconception_id:"MISC_ANALYZE_RELATIVE_ADVANTAGE_DIAGNOSTIC_MISCONCEPT_D67ED0", properties:{kc_id:"969d7a01-8089-5075-9acf-a4496e588f80", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze relative advantage: diagnostic misconception 960", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.5 (Stages in the Consumer Adoption Process for New Products). Explain how perceived improvement over alternatives affects adoption rather than equating novelty with value.", status:"approved", flawed_rule:"Customers adopt every novel product even when it offers no meaningful advantage."}}, {misconception_id:"MISC_ANALYZE_INNOVATION_COMPATIBILITY_DIAGNOSTIC_MISC_5D7381", properties:{kc_id:"9fcd2e49-2d96-5951-9b3a-cdf467d2db37", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze innovation compatibility: diagnostic misconception 961", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.5 (Stages in the Consumer Adoption Process for New Products). Assess the fit of a new offering with existing values, needs, habits, and practices.", status:"approved", flawed_rule:"An innovation's technical superiority eliminates the need to fit customer routines."}}, {misconception_id:"MISC_ANALYZE_INNOVATION_COMPLEXITY_DIAGNOSTIC_MISCONC_4ABD6D", properties:{kc_id:"5f6025b8-5341-5155-89e4-fed35158b698", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Analyze innovation complexity: diagnostic misconception 962", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.5 (Stages in the Consumer Adoption Process for New Products). Assess how difficulty of understanding or using an offering can slow adoption and shape support needs.", status:"approved", flawed_rule:"Adding more features always makes adoption easier."}}, {misconception_id:"MISC_EXERCISE_DUE_CARE_IN_PRODUCT_DEVELOPMENT_DIAGNOS_82C008", properties:{kc_id:"883dd021-ce53-57ba-b811-7249df1d23c2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Exercise due care in product development: diagnostic misconception 963", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 10.6 (Ethical Considerations in New Product Development). Evaluate foreseeable product risks, testing, safety, and responsibilities alongside intellectual-property obligations.", status:"approved", flawed_rule:"Respecting patents alone establishes that a product was developed with adequate care."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_CLASSIFY_THE_FOUR_SERVICE_PROCESSING_CATEGORIES__5E005C", properties:{kc_id:"052290fc-8838-5971-aa10-a3c8981cef51", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Classify the four service-processing categories: diagnostic misconception 964", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 11.1 (Classification of Services). Distinguish people processing, possession processing, mental stimulus processing, and information processing using tangible versus intangible actions and recipient.", status:"approved", flawed_rule:"Every intangible service acts directly on a customer's mind rather than possessions or information assets."}}, {misconception_id:"MISC_DIAGNOSE_THE_FIVE_SERVICE_QUALITY_GAPS_DIAGNOSTI_FA3DA0", properties:{kc_id:"cd194049-ac52-59fe-88d4-67694eebc830", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Diagnose the five service-quality gaps: diagnostic misconception 965", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 11.3 (The Gap Model of Service Quality). Separate knowledge, policy, delivery, communication, and customer gaps and select interventions at the responsible point.", status:"approved", flawed_rule:"Every service complaint can be fixed by writing a more persuasive advertisement."}}, {misconception_id:"MISC_EVALUATE_SERVICE_FAIRNESS_AND_PROMISES_DIAGNOSTI_39DE3E", properties:{kc_id:"89791b0f-01a9-5f52-94b9-91001220d957", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate service fairness and promises: diagnostic misconception 966", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 11.4 (Ethical Considerations in Providing Services). Relate honest communication, fair treatment, confidentiality, and actual service delivery to customer satisfaction and trust.", status:"approved", flawed_rule:"An intangible service is exempt from truthful performance promises."}}, {misconception_id:"MISC_APPLY_THE_PROFIT_EQUATION_DIAGNOSTIC_MISCONCEPTI_5B2A39", properties:{kc_id:"020a9160-c0dd-5452-b078-f036dd58f0e8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apply the profit equation: diagnostic misconception 967", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 12.1 (Pricing and Its Role in the Marketing Mix). Calculate total revenue as price times quantity and profit as total revenue minus total costs, distinguishing revenue effects from margin effects.", status:"approved", flawed_rule:"A price increase always raises total profit regardless of quantity response and cost."}}, {misconception_id:"MISC_INTEGRATE_THE_FIVE_CRITICAL_CS_OF_PRICING_DIAGNO_025037", properties:{kc_id:"3a9093c0-a77f-5a82-a77f-1ebc08dc5a73", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Integrate the five critical Cs of pricing: diagnostic misconception 968", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 12.2 (The Five Critical Cs of Pricing). Evaluate costs, customers, channels of distribution, competition, and compatibility in a coherent pricing decision.", status:"approved", flawed_rule:"A cost-plus calculation alone addresses every critical pricing consideration."}}, {misconception_id:"MISC_CALCULATE_BREAK_EVEN_VOLUME_DIAGNOSTIC_MISCONCEP_E81021", properties:{kc_id:"a44a0962-c290-5744-9399-6da04af21438", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Calculate break-even volume: diagnostic misconception 969", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 12.3 (The Five-Step Procedure for Establishing Pricing Policy). Relate fixed costs to unit contribution, price minus unit variable cost, and distinguish break-even from a target profit.", status:"approved", flawed_rule:"Dividing fixed cost by price gives break-even volume even when each unit has variable costs."}}, {misconception_id:"MISC_INTERPRET_OWN_PRICE_DEMAND_ELASTICITY_DIAGNOSTIC_C42732", properties:{kc_id:"36272571-fa68-52db-8f64-b5961ab04711", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Interpret own-price demand elasticity: diagnostic misconception 970", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 12.3 (The Five-Step Procedure for Establishing Pricing Policy). Compare percentage change in quantity demanded with percentage change in price and assess implications for revenue within the specified context.", status:"approved", flawed_rule:"A one-unit reduction in sales measures elasticity regardless of the original quantity or price change."}}, {misconception_id:"MISC_EVALUATE_SUBSTITUTE_AVAILABILITY_INCOME_AND_TIME_9C3A9A", properties:{kc_id:"4abd3b3b-7d6e-55dd-83bd-adcce09aa452", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate substitute availability, income, and time: diagnostic misconception 971", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 12.3 (The Five-Step Procedure for Establishing Pricing Policy). Explain how available alternatives, budget pressure, and time to adjust affect price responsiveness.", status:"approved", flawed_rule:"A product has one permanently fixed elasticity across all markets and time horizons."}}, {misconception_id:"MISC_EVALUATE_CAPTIVE_PRODUCT_PRICING_DIAGNOSTIC_MISC_464E89", properties:{kc_id:"3a81b8c3-0cf2-5309-a58a-833c517e4062", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate captive-product pricing: diagnostic misconception 972", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 12.5 (Pricing Strategies and Tactics for Existing Products). Analyze a core product and the complementary supplies needed to use it, considering total customer cost and dependence.", status:"approved", flawed_rule:"A cheap core product necessarily implies a low total cost of use."}}, {misconception_id:"MISC_AUDIT_CROSS_CHANNEL_MESSAGE_CONSISTENCY_DIAGNOST_536114", properties:{kc_id:"f6d74f98-e9db-5078-8e62-6db7c8844591", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Audit cross-channel message consistency: diagnostic misconception 973", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 13.3 (Integrated Marketing Communications). Assess whether promotional methods reinforce a coherent positioning while allowing channel-appropriate expression.", status:"approved", flawed_rule:"Integration requires word-for-word identical creative content on every medium."}}, {misconception_id:"MISC_APPLY_THE_FIVE_A_CUSTOMER_PATH_DIAGNOSTIC_MISCON_E8F941", properties:{kc_id:"54ec9d06-0b3d-58d4-933c-60735d249e55", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apply the five-A customer path: diagnostic misconception 974", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 13.4 (Steps in the IMC Planning Process). Trace aware, appeal, ask, act, and advocate and align communication objectives with the relevant customer state.", status:"approved", flawed_rule:"Once a customer is aware, inquiry, action, and advocacy follow automatically."}}, {misconception_id:"MISC_DESIGN_AN_IMC_PLAN_DIAGNOSTIC_MISCONCEPTION_975_9D2153", properties:{kc_id:"cd8b388a-48a8-59f7-8f9c-145495b350fa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Design an IMC plan: diagnostic misconception 975", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 13.4 (Steps in the IMC Planning Process). Select audience, objectives, message, budget, strategies and tactics, promotional tools, schedule, and evaluation as coordinated decisions.", status:"approved", flawed_rule:"Buying media first is sufficient without defining audience or intended customer response."}}, {misconception_id:"MISC_COMPARE_CONTINUOUS_FLIGHTING_AND_PULSING_SCHEDUL_E42344", properties:{kc_id:"48a2213d-96d4-5412-be03-cc3a4cc647d5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare continuous, flighting, and pulsing schedules: diagnostic misconception 976", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 13.4 (Steps in the IMC Planning Process). Distinguish steady exposure, on-off bursts, and a continuing baseline with peaks, considering seasonality and budget.", status:"approved", flawed_rule:"Flighting and pulsing both require a zero-advertising baseline between peaks."}}, {misconception_id:"MISC_EVALUATE_COMMUNICATION_OVERSIGHT_AND_DISCLOSURE__BA2861", properties:{kc_id:"30680c29-d634-5f42-a420-3fe9d648f782", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate communication oversight and disclosure: diagnostic misconception 977", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 13.5 (Ethical Issues in Marketing Communication). Distinguish the textbook's roles for FTC, FCC, FDA, and CAN-SPAM-related requirements; treat legal descriptions as publication-era educational material.", status:"approved", flawed_rule:"Compliance in one communication channel automatically satisfies every regulator and all ethical obligations."}}, {misconception_id:"MISC_COMPARE_ADVERTISING_BUDGET_METHODS_DIAGNOSTIC_MI_13EEDC", properties:{kc_id:"4edb4a93-4946-5d66-a681-4009461cbc46", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare advertising budget methods: diagnostic misconception 978", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 14.2 (Major Decisions in Developing an Advertising Plan). Assess affordable, percentage-of-sales, competitive parity, objective-and-task, and return-based budgeting against campaign goals and constraints.", status:"approved", flawed_rule:"Competitors' spending automatically reveals the appropriate budget for this firm's objectives."}}, {misconception_id:"MISC_COMPARE_PRETESTS_AND_POSTTESTS_DIAGNOSTIC_MISCON_3D837E", properties:{kc_id:"e62bdda5-17dc-56db-aacf-854821b02c4c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare pretests and posttests: diagnostic misconception 979", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 14.2 (Major Decisions in Developing an Advertising Plan). Match portfolio, jury, theater, recall, attitude, inquiry, and sales tests to timing and the outcome each can actually measure.", status:"approved", flawed_rule:"Remembering an advertisement proves that it caused incremental profitable sales."}}, {misconception_id:"MISC_ASSESS_PUBLIC_RELATIONS_TRADE_OFFS_DIAGNOSTIC_MI_B4B66A", properties:{kc_id:"982e7976-6543-5d05-b809-1f5884c16356", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Assess public relations trade-offs: diagnostic misconception 980", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 14.5 (The Advantages and Disadvantages of Public Relations). Compare credibility, image, leads, and cost advantages with limited message control, uncertain coverage, and measurement difficulty.", status:"approved", flawed_rule:"Earned coverage is guaranteed, positive, and fully editable by the organization."}}, {misconception_id:"MISC_EVALUATE_TRUTH_CHILDREN_HARMFUL_PRODUCTS_AND_PR__5ED3BE", properties:{kc_id:"31ac5d77-dc3d-5c0c-b120-49c3d1bfe2ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate truth, children, harmful products, and PR transparency: diagnostic misconception 981", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 14.6 (Ethical Concerns in Advertising and Public Relations). Assess substantiation, vulnerable audiences, harmful-product promotion, selective truth telling, and verification in advertising and PR.", status:"approved", flawed_rule:"A technically true selection of facts cannot mislead the audience."}}, {misconception_id:"MISC_HANDLE_OBJECTIONS_CONSTRUCTIVELY_DIAGNOSTIC_MISC_FA6C0E", properties:{kc_id:"eb8f3136-edcd-57ed-95c8-a45b8d0023ff", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Handle objections constructively: diagnostic misconception 982", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.3 (Steps in the Personal Selling Process). Diagnose the prospect's concern, provide relevant evidence, and distinguish a genuine mismatch from an unanswered question.", status:"approved", flawed_rule:"Every objection is a cue to pressure the prospect rather than investigate their concern."}}, {misconception_id:"MISC_CLOSE_AND_FOLLOW_UP_RESPONSIBLY_DIAGNOSTIC_MISCO_3818EC", properties:{kc_id:"3a7b97d9-e785-566c-9f2f-e1adf45c7bdf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Close and follow up responsibly: diagnostic misconception 983", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.3 (Steps in the Personal Selling Process). Seek an appropriate purchase commitment and support delivery, satisfaction, and continuing relationships after the sale.", status:"approved", flawed_rule:"Closing the contract completes all responsibilities to the buyer."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_COMPARE_PRESENTATION_FORMATS_DIAGNOSTIC_MISCONCE_82AE72", properties:{kc_id:"acf0b31e-9b59-56d3-a28c-a98a04cc1afc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare presentation formats: diagnostic misconception 984", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.3 (Steps in the Personal Selling Process). Distinguish stimulus-response, formula, and need-satisfaction presentations and adapt the approach to the buying situation.", status:"approved", flawed_rule:"One memorized stimulus-response script fits every customer's needs."}}, {misconception_id:"MISC_DESIGN_SALES_FORCE_STRUCTURE_DIAGNOSTIC_MISCONCE_46FCB6", properties:{kc_id:"a08c15db-ff04-547c-8c9c-77a6e38c0ac9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Design sales-force structure: diagnostic misconception 985", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.4 (Management of the Sales Force). Compare territorial, product, and customer-market structures and account coverage needs.", status:"approved", flawed_rule:"A territory-based structure is always optimal even for highly specialized products and buyer groups."}}, {misconception_id:"MISC_ESTIMATE_SALES_FORCE_SIZE_AND_CAPABILITY_DIAGNOS_001964", properties:{kc_id:"0f6ae546-86ff-56b7-a9f3-f49da898b023", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Estimate sales-force size and capability: diagnostic misconception 986", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.4 (Management of the Sales Force). Relate account coverage, workload, recruiting, selection, and training to sales objectives.", status:"approved", flawed_rule:"Hiring more salespeople automatically solves poor account coverage without workload analysis."}}, {misconception_id:"MISC_COMPARE_SALES_COMPENSATION_DESIGNS_DIAGNOSTIC_MI_1DC23A", properties:{kc_id:"f51b3a52-37c5-545d-bf78-e21417da0ccd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare sales compensation designs: diagnostic misconception 987", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.4 (Management of the Sales Force). Evaluate commission-only, salary-only, salary-plus-commission, and bonus combinations in terms of motivation, service, and incentives.", status:"approved", flawed_rule:"Paying only for immediate sales cannot distort service or ethical behavior."}}, {misconception_id:"MISC_COMPARE_CONSUMER_AND_TRADE_PROMOTIONS_DIAGNOSTIC_F791E5", properties:{kc_id:"11d7571c-2e32-5b41-a054-11355b038e9a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare consumer and trade promotions: diagnostic misconception 988", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.6 (Main Types of Sales Promotion). Distinguish end-consumer incentives from channel allowances, cooperative advertising, cash bonuses, dealer conferences, and push incentives.", status:"approved", flawed_rule:"A trade allowance is necessarily a price reduction received directly by the final consumer."}}, {misconception_id:"MISC_EVALUATE_SALES_CONDUCT_AND_REPORTING_DIAGNOSTIC__53A914", properties:{kc_id:"c57d0abe-d757-5453-b5f7-9863dd571f34", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate sales conduct and reporting: diagnostic misconception 989", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 15.7 (Ethical Issues in Personal Selling and Sales Promotion). Analyze misleading terms, hidden fees, kickbacks, expense misuse, and inflated sales records as threats to customer and organizational trust.", status:"approved", flawed_rule:"Meeting a sales target justifies inflating records or concealing charges."}}, {misconception_id:"MISC_INTEGRATE_DIRECT_AND_DIGITAL_RESPONSE_CHANNELS_D_FA61B4", properties:{kc_id:"400bb09e-3513-5da8-be2c-53595820b9bc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Integrate direct and digital response channels: diagnostic misconception 990", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 16.1 (Traditional Direct Marketing). Compare mail, catalogs, telephone, television, websites, email, content, video, and events by targeting, response, and relationship objectives.", status:"approved", flawed_rule:"Digital channels make every traditional direct-response method obsolete."}}, {misconception_id:"MISC_SELECT_SOCIAL_PLATFORMS_FOR_AN_AUDIENCE_DIAGNOST_0042DA", properties:{kc_id:"c9f692f7-9f66-5608-b6d9-106660889804", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Select social platforms for an audience: diagnostic misconception 991", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 16.2 (Social Media and Mobile Marketing). Assess Facebook, Instagram, LinkedIn, Pinterest, Twitter, and podcast examples using the textbook's publication-era audience and format descriptions.", status:"approved", flawed_rule:"The largest platform is always the best fit for every target audience and campaign objective."}}, {misconception_id:"MISC_DESIGN_USABLE_MOBILE_MARKETING_DIAGNOSTIC_MISCON_072BA8", properties:{kc_id:"2243d48e-eb8c-5e95-bfd2-d78556385377", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Design usable mobile marketing: diagnostic misconception 992", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 16.2 (Social Media and Mobile Marketing). Coordinate responsive pages, readable emails, appropriate applications, and short memorable URLs around mobile user behavior.", status:"approved", flawed_rule:"An application automatically adds value even when users can accomplish the task more easily without it."}}, {misconception_id:"MISC_DISTINGUISH_VISITORS_SESSIONS_PAGE_VIEWS_AND_DUR_6A9CDC", properties:{kc_id:"75979f4b-b2b4-5504-9827-8be9a1550c3f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Distinguish visitors, sessions, page views, and duration: diagnostic misconception 993", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 16.3 (Metrics Used to Evaluate the Success of Online Marketing). Analyze different units of web activity and avoid equating exposure or time on site with successful customer outcomes.", status:"approved", flawed_rule:"Longer average sessions always mean better usability and conversion."}}, {misconception_id:"MISC_CALCULATE_CTR_CPC_AND_CPA_DIAGNOSTIC_MISCONCEPTI_B7B911", properties:{kc_id:"babfdde9-822f-5e70-9b55-9949fc6869c5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Calculate CTR, CPC, and CPA: diagnostic misconception 994", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 16.3 (Metrics Used to Evaluate the Success of Online Marketing). Use clicks divided by impressions, spend divided by clicks, and spend divided by acquisitions or defined actions, with consistent periods and attribution.", status:"approved", flawed_rule:"The campaign with the lowest CPC necessarily has the lowest customer acquisition cost."}}, {misconception_id:"MISC_EVALUATE_TRACKING_CONSENT_AND_ONLINE_REVIEWS_DIA_16B972", properties:{kc_id:"26a9a72f-2d2a-5fc5-b13b-258657a78e81", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate tracking, consent, and online reviews: diagnostic misconception 995", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 16.4 (Ethical Issues in Digital Marketing and Social Media). Assess transparency about consumer data, tracking practices, and the reliability and disclosure of reviews.", status:"approved", flawed_rule:"Data collection is ethical merely because tracking is technically possible."}}, {misconception_id:"MISC_CHOOSE_CHANNELS_FOR_PRODUCT_AND_BUYER_REQUIREMEN_8597D4", properties:{kc_id:"73e7d727-339d-53fa-b3e5-9ada898b8039", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Choose channels for product and buyer requirements: diagnostic misconception 996", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 17.3 (Factors Influencing Channel Choice). Consider coverage, information, convenience, assortment, pre- and post-sale service, perishability, bulk, technical complexity, unit value, life-cycle stage, and profitability.", status:"approved", flawed_rule:"The channel with the most outlets is always optimal for every product."}}, {misconception_id:"MISC_SELECT_AND_MOTIVATE_CHANNEL_PARTNERS_DIAGNOSTIC__701DBE", properties:{kc_id:"a1dedca7-75d8-5ce2-a012-0b31fd9b9791", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Select and motivate channel partners: diagnostic misconception 997", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 17.4 (Managing the Distribution Channel). Use performance, capability, incentives, collaboration, and conflict resolution to align channel members.", status:"approved", flawed_rule:"Signing an intermediary removes the need for ongoing evaluation and incentives."}}, {misconception_id:"MISC_COORDINATE_SUPPLY_CHAIN_FUNCTIONS_DIAGNOSTIC_MIS_357F30", properties:{kc_id:"6d60d254-9214-587b-9891-18e63f18d52c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Coordinate supply-chain functions: diagnostic misconception 998", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 17.5 (The Supply Chain and Its Functions). Connect purchasing, operations, logistics, resource management, and information workflow with customer demand.", status:"approved", flawed_rule:"Optimizing each department separately always minimizes whole-chain cost and delay."}}, {misconception_id:"MISC_COMPARE_TRANSPORTATION_AND_LOGISTICS_TRADE_OFFS__312900", properties:{kc_id:"5bac480e-bd1a-53a6-9287-3bc2523e151a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare transportation and logistics trade-offs: diagnostic misconception 999", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 17.6 (Logistics and Its Functions). Assess speed, accessibility, cost, warehousing, inventory, information integration, and third-party logistics rather than transportation alone.", status:"approved", flawed_rule:"The fastest shipping mode is always the best logistics decision."}}, {misconception_id:"MISC_EVALUATE_SHIPPING_SPEED_VERSUS_CARBON_FOOTPRINT__FBC129", properties:{kc_id:"a05d6cab-c523-525f-a86a-27ceccddee84", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate shipping speed versus carbon footprint: diagnostic misconception 1000", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 17.7 (Ethical Issues in Supply Chain Management). Analyze the environmental consequences of expedited delivery alongside customer service expectations and sustainable sourcing.", status:"approved", flawed_rule:"Faster delivery has no environmental implications if the product itself is sustainable."}}, {misconception_id:"MISC_CALCULATE_AND_DISTINGUISH_MARKUP_AND_MARGIN_DIAG_1BA551", properties:{kc_id:"61e79652-74e5-5e9e-bdf1-1f693b9dc907", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Calculate and distinguish markup and margin: diagnostic misconception 1001", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 18.3 (Retailing Strategy Decisions). Separate cost-based markup from selling-price-based margin; a cost of 50 and selling price of 100 imply 100 percent markup and 50 percent gross margin.", status:"approved", flawed_rule:"A 100 percent markup means a 100 percent gross margin."}}, {misconception_id:"MISC_CHOOSE_RETAIL_LOCATION_AND_ASSORTMENT_DIAGNOSTIC_C6344C", properties:{kc_id:"3666959e-0481-58e7-b4a9-3c84917a2246", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Choose retail location and assortment: diagnostic misconception 1002", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 18.3 (Retailing Strategy Decisions). Compare central business districts, regional malls, strip malls, and freestanding sites against target customers, merchandise, access, and cost.", status:"approved", flawed_rule:"The cheapest site automatically maximizes retail profitability."}}, {misconception_id:"MISC_EVALUATE_EMERGING_RETAIL_FORMATS_AND_DELIVERY_DI_936533", properties:{kc_id:"2e90018e-29ad-57db-856a-1c9d0c34e83d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate emerging retail formats and delivery: diagnostic misconception 1003", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 18.4 (Recent Trends in Retailing). Assess online brands entering physical locations, same-day delivery, social commerce, and digital wallets as responses to customer behavior.", status:"approved", flawed_rule:"Every retailer must adopt every new format to remain competitive."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_EVALUATE_WHOLESALE_TECHNOLOGY_AND_TRACEABILITY_D_2DEDC5", properties:{kc_id:"721c53b0-2724-56b3-bf51-6642d6048be4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate wholesale technology and traceability: diagnostic misconception 1004", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 18.6 (Recent Trends in Wholesaling). Assess global competition, regulation, information systems, and product traceability through the supply chain.", status:"approved", flawed_rule:"Recording only the final sale provides end-to-end traceability."}}, {misconception_id:"MISC_EVALUATE_RETAIL_AND_WHOLESALE_CONSUMER_PROTECTIO_0388ED", properties:{kc_id:"8c5b5922-f1c7-5da7-b08b-741d505421d3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate retail and wholesale consumer protection: diagnostic misconception 1005", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 18.7 (Ethical Issues in Retailing and Wholesaling). Assess truthful claims, fair billing, supplier and customer treatment, and transparent terms.", status:"approved", flawed_rule:"Consumer protection concerns only manufacturers and never intermediaries."}}, {misconception_id:"MISC_DISTINGUISH_SUSTAINABILITY_PILLARS_AND_ESG_TERMI_800DC6", properties:{kc_id:"2f425db7-7947-5258-ad62-679688598374", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Distinguish sustainability pillars and ESG terminology: diagnostic misconception 1006", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 19.1 (Sustainable Marketing). Explain environmental, social, and economic dimensions and the textbook's related ESG framing without assuming economic performance and governance are identical measures.", status:"approved", flawed_rule:"Profitability is a complete measure of governance quality."}}, {misconception_id:"MISC_COMPARE_SHAREHOLDER_AND_STAKEHOLDER_APPROACHES_D_126865", properties:{kc_id:"6d70ba2a-cca5-59a5-85ab-edcfa1dc912d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Compare shareholder and stakeholder approaches: diagnostic misconception 1007", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 19.2 (Traditional Marketing versus Sustainable Marketing). Analyze how customer, employee, supplier, investor, community, and environmental interests affect sustainable marketing objectives.", status:"approved", flawed_rule:"Immediate shareholder return is the only outcome relevant to a sustainability strategy."}}, {misconception_id:"MISC_EVALUATE_SUSTAINABILITY_S_BUSINESS_BENEFITS_DIAG_82CD6F", properties:{kc_id:"e562eee2-4b39-5225-9423-6b5d9e27f034", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Evaluate sustainability's business benefits: diagnostic misconception 1008", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 19.3 (The Benefits of Sustainable Marketing). Examine brand recognition, cost reduction, effectiveness, compliance, waste minimization, and return while requiring evidence for each claimed benefit.", status:"approved", flawed_rule:"Labeling a program sustainable guarantees higher profit and lower cost."}}, {misconception_id:"MISC_APPLY_FIVE_SUSTAINABLE_MARKETING_PRINCIPLES_DIAG_3C8B98", properties:{kc_id:"8d32021e-f290-5569-bf93-aa471b765b41", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apply five sustainable marketing principles: diagnostic misconception 1009", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 19.4 (Sustainable Marketing Principles). Integrate consumer orientation, customer value, innovation, mission, and societal responsibility across actual business decisions.", status:"approved", flawed_rule:"One charitable promotion satisfies all five principles regardless of operational practices."}}, {misconception_id:"MISC_TEST_BRAND_PURPOSE_CREDIBILITY_DIAGNOSTIC_MISCON_BBFEA0", properties:{kc_id:"cf9f6813-7040-524f-9013-e44a9f703ce6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Test brand-purpose credibility: diagnostic misconception 1010", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use section 19.5 (Purpose-Driven Marketing). Compare stated purpose with decisions, actions, stakeholder effects, and measurable outcomes to assess authenticity.", status:"approved", flawed_rule:"A purpose statement or social campaign alone proves sustained positive impact."}}, {misconception_id:"MISC_7_ELEVEN_DIAGNOSTIC_MISCONCEPTION_1011_6BCF03", properties:{kc_id:"bb9a3b35-518e-5da6-96fd-1abde46334e5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"7-Eleven: diagnostic misconception 1011", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 98, in the textbook's discussion of 7-Eleven. Read what the source actually reports about 7-Eleven, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving 7-Eleven is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_A_E_NETWORKS_DIAGNOSTIC_MISCONCEPTION_1012_1EC72F", properties:{kc_id:"4b43a206-bd81-5288-a3fd-b7d358c554bb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"A&E Networks: diagnostic misconception 1012", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 544, in the textbook's discussion of A&E Networks. Read what the source actually reports about A&E Networks, then apply the definition of email marketing: a type of direct marketing that is highly personal and designed to build relationships with consumers", status:"approved", flawed_rule:"The example involving A&E Networks is interpreted using this faulty rule about email marketing: Sending the same unsolicited message to everyone builds strong relationships."}}, {misconception_id:"MISC_ABERCROMBIE_FITCH_DIAGNOSTIC_MISCONCEPTION_1013_522F24", properties:{kc_id:"1c3712e9-af18-5075-880e-eec08e4021ed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Abercrombie & Fitch: diagnostic misconception 1013", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 109, in the textbook's discussion of Abercrombie & Fitch. Separate the specific account of Abercrombie & Fitch on printed page 109 from a universal claim. The source passage is: Watch this video on Abercrombie & Fitch’s brand transformation for further insight on how A&F has positioned its retail brand Hollister as a global iconic teen brand and modernized the A&F brand to focus on young millennial consumers.", status:"approved", flawed_rule:"The mention of Abercrombie & Fitch in factors that influence consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_ACCENTURE_DIAGNOSTIC_MISCONCEPTION_1014_40372B", properties:{kc_id:"b05b18ab-f367-53df-b2b5-93d1a6d60e55", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Accenture: diagnostic misconception 1014", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 96, in the textbook's discussion of Accenture. Read what the source actually reports about Accenture, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving Accenture is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_ACE_HARDWARE_DIAGNOSTIC_MISCONCEPTION_1015_3B2CEC", properties:{kc_id:"4a13a040-72fa-5912-8c02-f8d5479f8246", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Ace Hardware: diagnostic misconception 1015", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 582, in the textbook's discussion of Ace Hardware. Read what the source actually reports about Ace Hardware, then apply the definition of producer to retailer to consumer channel: when manufacturers or producers sell to retailers without the use of wholesalers or distributors", status:"approved", flawed_rule:"The example involving Ace Hardware is interpreted using this faulty rule about producer to retailer to consumer channel: This route necessarily includes an independent wholesaler."}}, {misconception_id:"MISC_AD_COUNCIL_DIAGNOSTIC_MISCONCEPTION_1016_F5E06C", properties:{kc_id:"b2e1dca9-c19f-51fe-a31b-3f986a112a99", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Ad Council: diagnostic misconception 1016", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 104, in the textbook's discussion of Ad Council. Read what the source actually reports about Ad Council, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving Ad Council is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_ADIDAS_DIAGNOSTIC_MISCONCEPTION_1017_A1BC53", properties:{kc_id:"fb8c0bbd-d169-5217-bdb5-0d4ed25a90fd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Adidas: diagnostic misconception 1017", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 98, in the textbook's discussion of Adidas. Read what the source actually reports about Adidas, then apply the definition of complex buying behavior: the consumer buying behavior that occurs when the consumer is highly involved with the purchase and perceives significant differences between brands", status:"approved", flawed_rule:"The example involving Adidas is interpreted using this faulty rule about complex buying behavior: All expensive purchases involve little deliberation and no perceived brand differences."}}, {misconception_id:"MISC_ADOBE_DIAGNOSTIC_MISCONCEPTION_1018_14EB21", properties:{kc_id:"f4aea888-67f5-5b55-9b08-5159a3a63b01", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Adobe: diagnostic misconception 1018", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 99, in the textbook's discussion of Adobe. Read what the source actually reports about Adobe, then apply the definition of buyer’s black box: a model used in the study of the buying behavior of consumers", status:"approved", flawed_rule:"The example involving Adobe is interpreted using this faulty rule about buyer’s black box: Identical marketing stimuli produce identical decisions in all consumers."}}, {misconception_id:"MISC_ADVANCEMENT_PROJECT_DIAGNOSTIC_MISCONCEPTION_101_CB1183", properties:{kc_id:"e53aebda-abc9-5905-b34a-265566f6dd66", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Advancement Project: diagnostic misconception 1019", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of Advancement Project. Read what the source actually reports about Advancement Project, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving Advancement Project is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_ADWEEK_DIAGNOSTIC_MISCONCEPTION_1020_A6A8B2", properties:{kc_id:"a8105cd8-8854-5c8a-b591-3ad44b3b0380", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"AdWeek: diagnostic misconception 1020", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 496, in the textbook's discussion of AdWeek. Read what the source actually reports about AdWeek, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving AdWeek is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_AETNA_DIAGNOSTIC_MISCONCEPTION_1021_B103DB", properties:{kc_id:"33bb2384-796a-5ba7-a555-516c601ad98b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Aetna: diagnostic misconception 1021", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 582, in the textbook's discussion of Aetna. Read what the source actually reports about Aetna, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving Aetna is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_AIRBUS_DIAGNOSTIC_MISCONCEPTION_1022_2F739A", properties:{kc_id:"e6956a1d-3488-5df2-8ae7-4bad406fc595", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Airbus: diagnostic misconception 1022", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 129, in the textbook's discussion of Airbus. Read what the source actually reports about Airbus, then apply the definition of buying center: groups of people within organizations who make purchasing decisions", status:"approved", flawed_rule:"The example involving Airbus is interpreted using this faulty rule about buying center: A buying center is a physical procurement office with a single decision maker."}}, {misconception_id:"MISC_ALBA_DIAGNOSTIC_MISCONCEPTION_1023_E169B2", properties:{kc_id:"7ccabdbb-f3d1-5c2f-897c-18cc6a2fa58c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Alba: diagnostic misconception 1023", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 284, in the textbook's discussion of Alba. Read what the source actually reports about Alba, then apply the definition of consumers with disabilities: sociodemographic group living with some type of disability related to mobility, learning, intellectual, or other types of functions; a very diverse group because disabilities span cultural, social, and demographic factors", status:"approved", flawed_rule:"The example involving Alba is interpreted using this faulty rule about consumers with disabilities: One accessibility adjustment serves all types of disability equally well."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_ALFRED_SARGENT_SONS_DIAGNOSTIC_MISCONCEPTION_102_F9D9C1", properties:{kc_id:"1a17db8b-1264-5aee-89f4-df912d2c2afc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Alfred Sargent & Sons: diagnostic misconception 1024", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 241, in the textbook's discussion of Alfred Sargent & Sons. Read what the source actually reports about Alfred Sargent & Sons, then apply the definition of international firm: a company that operates on a global level regardless of intensity of involvement", status:"approved", flawed_rule:"The example involving Alfred Sargent & Sons is interpreted using this faulty rule about international firm: All firms operating internationally allow the same degree of local autonomy."}}, {misconception_id:"MISC_ALIBABA_DIAGNOSTIC_MISCONCEPTION_1025_467615", properties:{kc_id:"26595d63-dc3c-5ad6-9a56-61cd67bc652b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Alibaba: diagnostic misconception 1025", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 132, in the textbook's discussion of Alibaba. Read what the source actually reports about Alibaba, then apply the definition of buyers: the people in the buying center who handle the paperwork of the actual purchase", status:"approved", flawed_rule:"The example involving Alibaba is interpreted using this faulty rule about buyers: The buying-center member completing paperwork always makes the final choice alone."}}, {misconception_id:"MISC_ALICE_OLIVIA_DIAGNOSTIC_MISCONCEPTION_1026_86BDCD", properties:{kc_id:"64938c01-f910-5f84-a1e1-9310cbeb7c48", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Alice + Olivia: diagnostic misconception 1026", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Alice + Olivia. Separate the specific account of Alice + Olivia on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Alice + Olivia in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_ALLBIRDS_DIAGNOSTIC_MISCONCEPTION_1027_DD8209", properties:{kc_id:"a271b830-d46e-5fec-9937-88141e0cc9dc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Allbirds: diagnostic misconception 1027", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 604, in the textbook's discussion of Allbirds. Read what the source actually reports about Allbirds, then apply the definition of time to ship: also known as order cycle time, the length of time from when a customer places an order to when it reaches them", status:"approved", flawed_rule:"The example involving Allbirds is interpreted using this faulty rule about time to ship: Dispatch time and total order-to-delivery cycle time are always interchangeable."}}, {misconception_id:"MISC_ALLEGIANT_AIR_DIAGNOSTIC_MISCONCEPTION_1028_10E151", properties:{kc_id:"4883174f-14d5-5820-8dcd-0d6c89a4bf0c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Allegiant Air: diagnostic misconception 1028", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 426, in the textbook's discussion of Allegiant Air. Read what the source actually reports about Allegiant Air, then apply the definition of economy pricing: setting a price much lower than competitors to sell high volumes of a product", status:"approved", flawed_rule:"The example involving Allegiant Air is interpreted using this faulty rule about economy pricing: Economy pricing relies on exclusivity and high prestige margins."}}, {misconception_id:"MISC_ALLHEART_DIAGNOSTIC_MISCONCEPTION_1029_A1DB9E", properties:{kc_id:"8af63885-889d-5bdd-a2f2-8242124bb300", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"AllHeart: diagnostic misconception 1029", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 159, in the textbook's discussion of AllHeart. Read what the source actually reports about AllHeart, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving AllHeart is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_ALLSTATE_DIAGNOSTIC_MISCONCEPTION_1030_7EC158", properties:{kc_id:"60b758a5-54f8-50fb-9436-e308f8ce8041", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Allstate: diagnostic misconception 1030", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 104, in the textbook's discussion of Allstate. Separate the specific account of Allstate on printed page 104 from a universal claim. The source passage is: The second level is safety and security, the need to be safe from physical and psychological harm. Once again, consider just a few successful marketing campaigns that have focused on safety—“You’re in Good Hands with Allstate” and Lysol’s “Practice Healthy Habits” campaign with its tagline “What It Takes to Protect.”", status:"approved", flawed_rule:"The mention of Allstate in factors that influence consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_ALPHABET_DIAGNOSTIC_MISCONCEPTION_1031_489AF2", properties:{kc_id:"734f30d0-04bb-5dbd-86d9-1a8a9ddbc25f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Alphabet: diagnostic misconception 1031", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 55, in the textbook's discussion of Alphabet. Read what the source actually reports about Alphabet, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving Alphabet is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_AMAZON_DIAGNOSTIC_MISCONCEPTION_1032_B32CA6", properties:{kc_id:"548adada-2f82-5a7b-9171-1133e533c1e3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Amazon: diagnostic misconception 1032", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 34, in the textbook's discussion of Amazon. Read what the source actually reports about Amazon, then apply the definition of customer loyalty: an ongoing positive relationship between a customer and a business", status:"approved", flawed_rule:"The example involving Amazon is interpreted using this faulty rule about customer loyalty: A repeat purchase always proves emotional commitment to the brand."}}, {misconception_id:"MISC_AMAZON_GO_DIAGNOSTIC_MISCONCEPTION_1033_9DB15F", properties:{kc_id:"d9206f7b-ea94-5c39-89f9-abdd9dba8e34", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Amazon Go: diagnostic misconception 1033", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 619, in the textbook's discussion of Amazon Go. Read what the source actually reports about Amazon Go, then apply the definition of store retailer: a traditional brick-and-mortar establishment where products are displayed for customers to purchase", status:"approved", flawed_rule:"The example involving Amazon Go is interpreted using this faulty rule about store retailer: Store retailers cannot combine physical selling with digital channels."}}, {misconception_id:"MISC_AMAZON_PRIME_DIAGNOSTIC_MISCONCEPTION_1034_FDB273", properties:{kc_id:"5727d596-26c1-5ce1-807c-b89b534a31aa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Amazon Prime: diagnostic misconception 1034", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 405, in the textbook's discussion of Amazon Prime. Read what the source actually reports about Amazon Prime, then apply the definition of predatory pricing: when a company prices goods or services so low that other companies cannot compete", status:"approved", flawed_rule:"The example involving Amazon Prime is interpreted using this faulty rule about predatory pricing: Every competitive discount is necessarily predatory pricing."}}, {misconception_id:"MISC_AMC_DIAGNOSTIC_MISCONCEPTION_1035_FEEF8C", properties:{kc_id:"a386def7-8648-57b0-be02-cef467742f25", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"AMC: diagnostic misconception 1035", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 576, in the textbook's discussion of AMC. Read what the source actually reports about AMC, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving AMC is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_AMERICAN_AIRLINES_DIAGNOSTIC_MISCONCEPTION_1036_995DBE", properties:{kc_id:"06dfe7bf-7e51-56ac-9f34-be86fe9c4a4e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"American Airlines: diagnostic misconception 1036", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 583, in the textbook's discussion of American Airlines. Read what the source actually reports about American Airlines, then apply the definition of business-to-consumer (B2C): a market comprised of companies that manufacture and sell products or services directly to a final consumer or end user", status:"approved", flawed_rule:"The example involving American Airlines is interpreted using this faulty rule about business-to-consumer (B2C): B2C describes sales intended for further industrial production."}}, {misconception_id:"MISC_AMERICAN_ASSOCIATION_FOR_RETIRED_PERSONS_AARP_DI_755F36", properties:{kc_id:"e7f54cac-bb99-5e51-a7e2-29fdeb1ff83f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"American Association for Retired Persons (AARP): diagnostic misconception 1037", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 293, in the textbook's discussion of American Association for Retired Persons (AARP). Read what the source actually reports about American Association for Retired Persons (AARP), then apply the definition of Native American, Alaska Native population: multicultural group of individuals of a single race and mixed races who are native to the United States and its territories including American Indians, Alaska Natives, Native Hawaiians, and American Samoans", status:"approved", flawed_rule:"The example involving American Association for Retired Persons (AARP) is interpreted using this faulty rule about Native American, Alaska Native population: Distinct Indigenous nations and communities share one interchangeable culture."}}, {misconception_id:"MISC_AMERICAN_CIVIL_LIBERTIES_UNION_ACLU_DIAGNOSTIC_M_F0D1D2", properties:{kc_id:"b7d3314c-be53-5136-b40c-84c36f3a0984", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"American Civil Liberties Union (ACLU): diagnostic misconception 1038", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of American Civil Liberties Union (ACLU). Read what the source actually reports about American Civil Liberties Union (ACLU), then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving American Civil Liberties Union (ACLU) is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_AMERICAN_GIRL_DIAGNOSTIC_MISCONCEPTION_1039_FDB138", properties:{kc_id:"06a9d9aa-9d0e-53e6-9b89-f0c96f0ab782", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"American Girl: diagnostic misconception 1039", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 331, in the textbook's discussion of American Girl. Read what the source actually reports about American Girl, then apply the definition of actual product: product available for purchase", status:"approved", flawed_rule:"The example involving American Girl is interpreted using this faulty rule about actual product: The actual product is the underlying benefit alone, without tangible features or design."}}, {misconception_id:"MISC_AMERICAN_HOSPITAL_ASSOCIATION_DIAGNOSTIC_MISCONC_91E5C3", properties:{kc_id:"0089e712-9497-5270-8bb1-607827b670b6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"American Hospital Association: diagnostic misconception 1040", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of American Hospital Association. Read what the source actually reports about American Hospital Association, then apply the definition of impact: how quickly members of the audience receive an advertising message", status:"approved", flawed_rule:"The example involving American Hospital Association is interpreted using this faulty rule about impact: Exposure or fast message delivery alone proves persuasion and sales effectiveness."}}, {misconception_id:"MISC_AMERICAN_MARKETING_ASSOCIATION_AMA_DIAGNOSTIC_MI_38488F", properties:{kc_id:"7a677bb8-bc83-5bc5-bbc8-bb1933f5f955", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"American Marketing Association (AMA): diagnostic misconception 1041", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 41, in the textbook's discussion of American Marketing Association (AMA). Read what the source actually reports about American Marketing Association (AMA), then apply the definition of marketing mix: the set of actions or tactics that a company uses to promote its brand or product in the market", status:"approved", flawed_rule:"The example involving American Marketing Association (AMA) is interpreted using this faulty rule about marketing mix: Promotion alone constitutes the marketing mix."}}, {misconception_id:"MISC_AMERICAN_SOCIETY_FOR_THE_PREVENTION_OF_CRUELTY_T_D95B42", properties:{kc_id:"318022c1-7bf3-5e26-8c0a-60df637fab0f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"American Society for the Prevention of Cruelty to Animals (ASPCA): diagnostic misconception 1042", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of American Society for the Prevention of Cruelty to Animals (ASPCA). Read what the source actually reports about American Society for the Prevention of Cruelty to Animals (ASPCA), then apply the definition of advertising: a paid form of nonpersonal communication about a product, service, or idea", status:"approved", flawed_rule:"The example involving American Society for the Prevention of Cruelty to Animals (ASPCA) is interpreted using this faulty rule about advertising: Every favorable media mention is paid advertising."}}, {misconception_id:"MISC_ANDROID_DIAGNOSTIC_MISCONCEPTION_1043_0B09D5", properties:{kc_id:"6e5e8e63-9b61-56d4-b65f-59f61bd0ea25", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Android: diagnostic misconception 1043", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 61, in the textbook's discussion of Android. Read what the source actually reports about Android, then apply the definition of product development strategy: complete process of delivering a new product or improving an existing one for customers", status:"approved", flawed_rule:"The example involving Android is interpreted using this faulty rule about product development strategy: Selling an unchanged product to a new market is product development."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_ANHEUSER_BUSCH_DIAGNOSTIC_MISCONCEPTION_1044_675961", properties:{kc_id:"1628a758-8367-5391-a40f-d62dabcacce9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Anheuser-Busch: diagnostic misconception 1044", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 476, in the textbook's discussion of Anheuser-Busch. Read what the source actually reports about Anheuser-Busch, then apply the definition of institutional advertisements: advertisements intended to create a positive image or support for an entire organization", status:"approved", flawed_rule:"The example involving Anheuser-Busch is interpreted using this faulty rule about institutional advertisements: Institutional advertising promotes only one product feature."}}, {misconception_id:"MISC_ANYA_HINDMARCH_DIAGNOSTIC_MISCONCEPTION_1045_81A925", properties:{kc_id:"8d67d000-544d-5f4a-b98f-8dd2beb9ed8f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Anya Hindmarch: diagnostic misconception 1045", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 658, in the textbook's discussion of Anya Hindmarch. Separate the specific account of Anya Hindmarch on printed page 658 from a universal claim. The source passage is: Anya Hindmarch and Antidote Anya Hindmarch’s “I Am Not a Plastic Bag” campaign was a collaboration with Antidote, a creative agency, that gained loads of press coverage. That publicity contributed to the U.K. decision to charge for plastic bags. Read more about the campaign from the Anya Hindmarch website (https://openstax.org/r/ imnotaplasticbag) and Antidote’s website (https://openstax.org/r/antidote). When you’re finished, take a moment to be inspired by Anya Hindmarch and her recent sustainability fashion product, a collection of biodegradable leather bags (https://openstax.org/r/hindmarchlaunches).", status:"approved", flawed_rule:"The mention of Anya Hindmarch in the benefits of sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_APPLE_DIAGNOSTIC_MISCONCEPTION_1046_BA81C4", properties:{kc_id:"c9b4cdd3-02c2-53e2-9f7e-247a08a032a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apple: diagnostic misconception 1046", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 50, in the textbook's discussion of Apple. Read what the source actually reports about Apple, then apply the definition of market development strategy: a growth strategy that identifies and develops new market segments for current products", status:"approved", flawed_rule:"The example involving Apple is interpreted using this faulty rule about market development strategy: Selling new products to existing customers is market development."}}, {misconception_id:"MISC_APPLE_IPHONE_DIAGNOSTIC_MISCONCEPTION_1047_FA69F0", properties:{kc_id:"00c21892-0cbb-5e6e-b75d-d983ef21983a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apple iPhone: diagnostic misconception 1047", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 108, in the textbook's discussion of Apple iPhone. Read what the source actually reports about Apple iPhone, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving Apple iPhone is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_APPLE_STORE_DIAGNOSTIC_MISCONCEPTION_1048_5B870F", properties:{kc_id:"cfe3c7b7-fc28-5a8d-9b64-8a3d27049216", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Apple Store: diagnostic misconception 1048", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 309, in the textbook's discussion of Apple Store. Read what the source actually reports about Apple Store, then apply the definition of customer experience: the overarching impression that customers have of a brand", status:"approved", flawed_rule:"The example involving Apple Store is interpreted using this faulty rule about customer experience: Customer experience consists only of the moment of payment."}}, {misconception_id:"MISC_APPLIED_EDUCATIONAL_SYSTEMS_AES_DIAGNOSTIC_MISCO_FDDB11", properties:{kc_id:"7471fb70-3df4-5a42-9ca1-845c7c1422c5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Applied Educational Systems (AES): diagnostic misconception 1049", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 31, in the textbook's discussion of Applied Educational Systems (AES). Read what the source actually reports about Applied Educational Systems (AES), then apply the definition of time utility: adding value to the consumer by having the product or service available when the consumer needs it", status:"approved", flawed_rule:"The example involving Applied Educational Systems (AES) is interpreted using this faulty rule about time utility: A product available after the customer's deadline provides the same time utility."}}, {misconception_id:"MISC_ARBY_S_DIAGNOSTIC_MISCONCEPTION_1050_BBDB9A", properties:{kc_id:"b66a3463-de16-5c59-be1e-b054cb9cc45a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Arby’s: diagnostic misconception 1050", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 139, in the textbook's discussion of Arby’s. Read what the source actually reports about Arby’s, then apply the definition of product specifications: a document carrying essential information to keep teams on track when designing and developing a product", status:"approved", flawed_rule:"The example involving Arby’s is interpreted using this faulty rule about product specifications: A product specification merely states the total purchasing budget."}}, {misconception_id:"MISC_ASO_DIAGNOSTIC_MISCONCEPTION_1051_84FB3C", properties:{kc_id:"399845af-b3d1-51bb-9378-7ff63cad1c46", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"ASO: diagnostic misconception 1051", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 609, in the textbook's discussion of ASO. Read what the source actually reports about ASO, then apply the definition of multichannel distribution system: where a single company sets up multiple distribution channels to reach customers", status:"approved", flawed_rule:"The example involving ASO is interpreted using this faulty rule about multichannel distribution system: Operating multiple channels automatically creates a seamless integrated customer experience."}}, {misconception_id:"MISC_ASTRAZENECA_DIAGNOSTIC_MISCONCEPTION_1052_300EA1", properties:{kc_id:"454a396b-06d6-56df-97df-790e5f01d5ab", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"AstraZeneca: diagnostic misconception 1052", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 577, in the textbook's discussion of AstraZeneca. Read what the source actually reports about AstraZeneca, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving AstraZeneca is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_AT_T_DIAGNOSTIC_MISCONCEPTION_1053_414A93", properties:{kc_id:"80ce3176-3915-52d9-8102-5f4926cea95f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"AT&T: diagnostic misconception 1053", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 297, in the textbook's discussion of AT&T. Read what the source actually reports about AT&T, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving AT&T is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_ATHLETA_DIAGNOSTIC_MISCONCEPTION_1054_C39B44", properties:{kc_id:"fe1ff2eb-48ca-56d6-83e0-af1358bc3bdc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Athleta: diagnostic misconception 1054", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 661, in the textbook's discussion of Athleta. Read what the source actually reports about Athleta, then apply the definition of societal marketing: a marketing strategy focused on fulfilling social responsibility obligations while also satisfying customer needs", status:"approved", flawed_rule:"The example involving Athleta is interpreted using this faulty rule about societal marketing: Satisfying immediate customer wants necessarily satisfies wider social responsibility."}}, {misconception_id:"MISC_AUDI_DIAGNOSTIC_MISCONCEPTION_1055_556BEA", properties:{kc_id:"b11382f5-4773-506a-b72c-c32adee8a4a2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Audi: diagnostic misconception 1055", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 428, in the textbook's discussion of Audi. Read what the source actually reports about Audi, then apply the definition of price fixing: two or more companies agreeing to set certain prices in the market", status:"approved", flawed_rule:"The example involving Audi is interpreted using this faulty rule about price fixing: Competitors jointly agreeing prices is equivalent to independently following market conditions."}}, {misconception_id:"MISC_AUDIBLE_DIAGNOSTIC_MISCONCEPTION_1056_1B3220", properties:{kc_id:"6a96f995-1189-535d-8ae9-faf291f9d79f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Audible: diagnostic misconception 1056", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 555, in the textbook's discussion of Audible. Read what the source actually reports about Audible, then apply the definition of new visitors: people who are first visiting your website, also known as new users", status:"approved", flawed_rule:"The example involving Audible is interpreted using this faulty rule about new visitors: A newly recognized browser identifier necessarily represents a person who has never encountered the brand."}}, {misconception_id:"MISC_AUTOZONE_DIAGNOSTIC_MISCONCEPTION_1057_62027D", properties:{kc_id:"4cf1dcf3-44f3-5058-b0a6-db453750e4af", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"AutoZone: diagnostic misconception 1057", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 619, in the textbook's discussion of AutoZone. Read what the source actually reports about AutoZone, then apply the definition of specialty stores: retailers that focus on selling a single type of product or a single product line", status:"approved", flawed_rule:"The example involving AutoZone is interpreted using this faulty rule about specialty stores: Specialty stores compete through the broadest range of unrelated categories."}}, {misconception_id:"MISC_AVIATION_GIN_DIAGNOSTIC_MISCONCEPTION_1058_44BD40", properties:{kc_id:"519e27f0-69c7-5a7f-ada7-69f102d19eb9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Aviation Gin: diagnostic misconception 1058", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 501, in the textbook's discussion of Aviation Gin. Read what the source actually reports about Aviation Gin, then apply the definition of brand awareness: metric used to determine if audiences can recall information about a brand", status:"approved", flawed_rule:"The example involving Aviation Gin is interpreted using this faulty rule about brand awareness: Brand awareness and confirmed sales conversion are the same outcome."}}, {misconception_id:"MISC_AVIS_DIAGNOSTIC_MISCONCEPTION_1059_534F81", properties:{kc_id:"9506863b-ba8d-5e68-be65-c54eedad8e56", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Avis: diagnostic misconception 1059", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 182, in the textbook's discussion of Avis. Read what the source actually reports about Avis, then apply the definition of head-to-head positioning: directly competing with competitors on similar product attributes in the same market", status:"approved", flawed_rule:"The example involving Avis is interpreted using this faulty rule about head-to-head positioning: Head-to-head positioning avoids comparison on competitors' main attributes."}}, {misconception_id:"MISC_AXE_DIAGNOSTIC_MISCONCEPTION_1060_BB4014", properties:{kc_id:"a373ca06-1417-5731-a87a-937476cdd302", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Axe: diagnostic misconception 1060", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 425, in the textbook's discussion of Axe. Read what the source actually reports about Axe, then apply the definition of product line pricing: setting a higher price for some product lines and lower price points for others in order to capture various target markets", status:"approved", flawed_rule:"The example involving Axe is interpreted using this faulty rule about product line pricing: All models in a product range should have identical prices regardless of benefits."}}, {misconception_id:"MISC_B2B_BUSINESS_INTERNATIONAL_MARKET_RESEARCH_DIAGN_B8445B", properties:{kc_id:"27b226c5-c321-5138-a9d8-51238120164a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"B2B Business International Market Research: diagnostic misconception 1061", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 168, in the textbook's discussion of B2B Business International Market Research. Read what the source actually reports about B2B Business International Market Research, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving B2B Business International Market Research is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_BABY_BOOMERS_DIAGNOSTIC_MISCONCEPTION_1062_B2BEF1", properties:{kc_id:"6fea5581-913c-5351-95c2-bfb651318033", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Baby boomers: diagnostic misconception 1062", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 101, in the textbook's discussion of Baby boomers. Read what the source actually reports about Baby boomers, then apply the definition of complex buying behavior: the consumer buying behavior that occurs when the consumer is highly involved with the purchase and perceives significant differences between brands", status:"approved", flawed_rule:"The example involving Baby boomers is interpreted using this faulty rule about complex buying behavior: All expensive purchases involve little deliberation and no perceived brand differences."}}, {misconception_id:"MISC_BAD_BUNNY_DIAGNOSTIC_MISCONCEPTION_1063_AF82C2", properties:{kc_id:"4e0fabbd-4164-5c09-b0bb-b333e7e3e8fa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bad Bunny: diagnostic misconception 1063", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 267, in the textbook's discussion of Bad Bunny. Read what the source actually reports about Bad Bunny, then apply the definition of Hispanic population: largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe", status:"approved", flawed_rule:"The example involving Bad Bunny is interpreted using this faulty rule about Hispanic population: Hispanic identity implies one race, nationality, or level of Spanish-language preference."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_BAIN_COMPANY_DIAGNOSTIC_MISCONCEPTION_1064_0BA021", properties:{kc_id:"f3e37014-b793-51f8-8f64-4bd9f51bcbe1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bain & Company: diagnostic misconception 1064", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 96, in the textbook's discussion of Bain & Company. Read what the source actually reports about Bain & Company, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving Bain & Company is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_BALANCE_CAREERS_DIAGNOSTIC_MISCONCEPTION_1065_BE2214", properties:{kc_id:"4573eda3-3e64-5b9c-b2c4-da7af29273f7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Balance Careers: diagnostic misconception 1065", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 115, in the textbook's discussion of Balance Careers. Read what the source actually reports about Balance Careers, then apply the definition of personality: the combination of characteristics or qualities that form an individual’s distinctive character", status:"approved", flawed_rule:"The example involving Balance Careers is interpreted using this faulty rule about personality: People in the same demographic category have identical personalities."}}, {misconception_id:"MISC_BALVIN_DIAGNOSTIC_MISCONCEPTION_1066_A90A96", properties:{kc_id:"eb6ca895-4ecf-55be-ad0c-e86420fadda1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Balvin: diagnostic misconception 1066", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 267, in the textbook's discussion of Balvin. Read what the source actually reports about Balvin, then apply the definition of Hispanic population: largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe", status:"approved", flawed_rule:"The example involving Balvin is interpreted using this faulty rule about Hispanic population: Hispanic identity implies one race, nationality, or level of Spanish-language preference."}}, {misconception_id:"MISC_BANANA_REPUBLIC_DIAGNOSTIC_MISCONCEPTION_1067_019C56", properties:{kc_id:"96ec3f9d-dc6a-5e82-a43f-aa4aff7fe25d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Banana Republic: diagnostic misconception 1067", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 327, in the textbook's discussion of Banana Republic. Read what the source actually reports about Banana Republic, then apply the definition of split loyals: customers who have a consideration set of two or three products or services in a category", status:"approved", flawed_rule:"The example involving Banana Republic is interpreted using this faulty rule about split loyals: Split loyals buy only one brand over the entire period."}}, {misconception_id:"MISC_BARNES_NOBLE_DIAGNOSTIC_MISCONCEPTION_1068_282CB6", properties:{kc_id:"2fdbb12c-27ee-5ec8-aa75-fff794555480", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Barnes & Noble: diagnostic misconception 1068", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 500, in the textbook's discussion of Barnes & Noble. Read what the source actually reports about Barnes & Noble, then apply the definition of all-you-can-afford approach: advertising budget approach that ensures everything else in the organization is budgeted for and then sets aside the remaining funds for advertising", status:"approved", flawed_rule:"The example involving Barnes & Noble is interpreted using this faulty rule about all-you-can-afford approach: An affordable advertising budget necessarily matches the resources needed to reach campaign objectives."}}, {misconception_id:"MISC_BARRIOS_DIAGNOSTIC_MISCONCEPTION_1069_450F54", properties:{kc_id:"7769d379-6383-53a6-b3bb-4f6a11385c40", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Barrios: diagnostic misconception 1069", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 99, in the textbook's discussion of Barrios. Read what the source actually reports about Barrios, then apply the definition of gender: the socially constructed roles, behaviors, and norms of individuals, which vary between societies and over time", status:"approved", flawed_rule:"The example involving Barrios is interpreted using this faulty rule about gender: Gender predicts identical preferences for every person in a category."}}, {misconception_id:"MISC_BATDORF_BRONSON_COFFEE_ROASTERS_DIAGNOSTIC_MISCO_4E1D5F", properties:{kc_id:"351bc2bd-87cf-50be-8988-9c984e2a98e5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Batdorf & Bronson Coffee Roasters: diagnostic misconception 1070", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 43, in the textbook's discussion of Batdorf & Bronson Coffee Roasters. Separate the specific account of Batdorf & Bronson Coffee Roasters on printed page 43 from a universal claim. The source passage is: With a love for coffee and the thoughts of goats dancing in their heads, husband and wife Larry and Cherie Challain opened their first coffee bar—Dancing Goats in Olympia, Washington, in 1988. But as any coffee entrepreneur knows, a coffee bar is only as good as the coffee it serves. In a quest to serve the freshest coffee in the world, the duo acquired Batdorf & Bronson Coffee Roasters.", status:"approved", flawed_rule:"The mention of Batdorf & Bronson Coffee Roasters in marketing and the marketing process establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BAYER_DIAGNOSTIC_MISCONCEPTION_1071_A6258D", properties:{kc_id:"7ec24843-4fd3-530c-a739-72aa8924ba7c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bayer: diagnostic misconception 1071", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 346, in the textbook's discussion of Bayer. Read what the source actually reports about Bayer, then apply the definition of repositioned products: products that are retargeted for a new use", status:"approved", flawed_rule:"The example involving Bayer is interpreted using this faulty rule about repositioned products: A new use for an existing product always requires a new invention."}}, {misconception_id:"MISC_BBC_DIAGNOSTIC_MISCONCEPTION_1072_5D07F5", properties:{kc_id:"3ecf5005-629f-5d29-a26e-55734a2c6526", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"BBC: diagnostic misconception 1072", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 68, in the textbook's discussion of BBC. Separate the specific account of BBC on printed page 68 from a universal claim. The source passage is: live off their art and billions of fans the opportunity to enjoy and be inspired by it”53 • BBC: “To act in the public interest, serving all audiences through the provision of impartial, high-quality and distinctive output and services which inform, educate and entertain”54", status:"approved", flawed_rule:"The mention of BBC in purpose and structure of the marketing plan establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BEN_JERRY_S_DIAGNOSTIC_MISCONCEPTION_1073_BEB434", properties:{kc_id:"7e70312b-1a6a-53a7-b0b1-6e3d2eed3c82", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Ben & Jerry’s: diagnostic misconception 1073", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 281, in the textbook's discussion of Ben & Jerry’s. Read what the source actually reports about Ben & Jerry’s, then apply the definition of Black population: second largest multicultural group in the United States; made up of three different subethnicities: single race, Black Hispanic, or Black mixed with another race (White or Native American)", status:"approved", flawed_rule:"The example involving Ben & Jerry’s is interpreted using this faulty rule about Black population: Black consumers share a single ancestry, identity, and purchasing pattern."}}, {misconception_id:"MISC_BENDET_DIAGNOSTIC_MISCONCEPTION_1074_393244", properties:{kc_id:"2317f9be-132a-5401-8467-68d09dd2d2b5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bendet: diagnostic misconception 1074", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Bendet. Separate the specific account of Bendet on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Bendet in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BEST_BUY_DIAGNOSTIC_MISCONCEPTION_1075_30A6D3", properties:{kc_id:"b191bd08-d52d-52f3-b62d-bb2e8cd573f4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Best Buy: diagnostic misconception 1075", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 177, in the textbook's discussion of Best Buy. Read what the source actually reports about Best Buy, then apply the definition of buyer persona: semi-fictional representation of an organization’s ideal customers based on data and research", status:"approved", flawed_rule:"The example involving Best Buy is interpreted using this faulty rule about buyer persona: A buyer persona can be invented from executive stereotypes without customer evidence."}}, {misconception_id:"MISC_BETTER_CHICKEN_COMMITMENT_BCC_DIAGNOSTIC_MISCONC_6AF82B", properties:{kc_id:"b548f34a-1a1d-5d94-bd35-b1a6d18ebd64", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Better Chicken Commitment (BCC): diagnostic misconception 1076", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 492, in the textbook's discussion of Better Chicken Commitment (BCC). Read what the source actually reports about Better Chicken Commitment (BCC), then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Better Chicken Commitment (BCC) is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_BEYONC_DIAGNOSTIC_MISCONCEPTION_1077_FEC968", properties:{kc_id:"f26efdaa-646b-5903-a659-92ec86268b11", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Beyoncé: diagnostic misconception 1077", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 447, in the textbook's discussion of Beyoncé. Read what the source actually reports about Beyoncé, then apply the definition of message strategy: method of developing a message based on how the message will best tie the brand to the target market", status:"approved", flawed_rule:"The example involving Beyoncé is interpreted using this faulty rule about message strategy: A message strategy is only a choice of font, color, and production technique."}}, {misconception_id:"MISC_BILL_RAGAN_ROOFING_DIAGNOSTIC_MISCONCEPTION_1078_1A5371", properties:{kc_id:"3f427ca8-2533-526c-acfe-8bbc90383ff9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bill Ragan Roofing: diagnostic misconception 1078", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 31, in the textbook's discussion of Bill Ragan Roofing. Read what the source actually reports about Bill Ragan Roofing, then apply the definition of time utility: adding value to the consumer by having the product or service available when the consumer needs it", status:"approved", flawed_rule:"The example involving Bill Ragan Roofing is interpreted using this faulty rule about time utility: A product available after the customer's deadline provides the same time utility."}}, {misconception_id:"MISC_BING_DIAGNOSTIC_MISCONCEPTION_1079_6C760E", properties:{kc_id:"606f50e2-67df-58b6-a392-f74f2a84f01a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bing: diagnostic misconception 1079", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 561, in the textbook's discussion of Bing. Read what the source actually reports about Bing, then apply the definition of paid search: a type of digital advertising where marketers pay search engines like Google and Bing to place their ads in sponsored spots at the top or bottom of a search results page", status:"approved", flawed_rule:"The example involving Bing is interpreted using this faulty rule about paid search: Paying for a search advertisement guarantees the highest organic ranking."}}, {misconception_id:"MISC_BIRCHBOX_DIAGNOSTIC_MISCONCEPTION_1080_3850D3", properties:{kc_id:"eb4bf92c-9ae2-506e-b452-ad23988fcbf8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Birchbox: diagnostic misconception 1080", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 99, in the textbook's discussion of Birchbox. Read what the source actually reports about Birchbox, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving Birchbox is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_BITEABLE_DIAGNOSTIC_MISCONCEPTION_1081_C39AB8", properties:{kc_id:"1e145da6-6a4d-54c2-901a-bbb72dd6f386", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Biteable: diagnostic misconception 1081", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 547, in the textbook's discussion of Biteable. Read what the source actually reports about Biteable, then apply the definition of online video marketing: involves creating videos that tell a story about a product, company, or brand that is designed to drive consumer engagement through activities such as liking, sharing, and retweeting", status:"approved", flawed_rule:"The example involving Biteable is interpreted using this faulty rule about online video marketing: A high view count alone establishes profitable customer engagement."}}, {misconception_id:"MISC_BITLY_DIAGNOSTIC_MISCONCEPTION_1082_0C026B", properties:{kc_id:"619452b9-4ba5-51d7-ba1b-85ac8d44a1c4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bitly: diagnostic misconception 1082", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 557, in the textbook's discussion of Bitly. Read what the source actually reports about Bitly, then apply the definition of paid search: a type of digital advertising where marketers pay search engines like Google and Bing to place their ads in sponsored spots at the top or bottom of a search results page", status:"approved", flawed_rule:"The example involving Bitly is interpreted using this faulty rule about paid search: Paying for a search advertisement guarantees the highest organic ranking."}}, {misconception_id:"MISC_BJ_S_DIAGNOSTIC_MISCONCEPTION_1083_C29AB0", properties:{kc_id:"8d635977-1d5c-5e4f-9b5b-5d3be2bd23c2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"BJ’s: diagnostic misconception 1083", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of BJ’s. Read what the source actually reports about BJ’s, then apply the definition of warehouse clubs: retailers that sell goods in bulk at discounted prices", status:"approved", flawed_rule:"The example involving BJ’s is interpreted using this faulty rule about warehouse clubs: Warehouse clubs are designed mainly for small single-item purchases at premium prices."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_BLACK_LIVES_MATTER_DIAGNOSTIC_MISCONCEPTION_1084_282086", properties:{kc_id:"747c71c4-53f6-5cc7-b9a5-0e3f51f7bde7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Black Lives Matter: diagnostic misconception 1084", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 266, in the textbook's discussion of Black Lives Matter. Read what the source actually reports about Black Lives Matter, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving Black Lives Matter is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_BLAKELY_DIAGNOSTIC_MISCONCEPTION_1085_2FFF91", properties:{kc_id:"d281ac63-4968-5ceb-b3b3-9f2ad30a8fbb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Blakely: diagnostic misconception 1085", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 444, in the textbook's discussion of Blakely. Read what the source actually reports about Blakely, then apply the definition of Internet/digital marketing: promotional method that utilizes the Internet and digital technology such as text messaging, phone applications, and social media to reach consumers", status:"approved", flawed_rule:"The example involving Blakely is interpreted using this faulty rule about Internet/digital marketing: Digital promotion consists exclusively of banner advertisements."}}, {misconception_id:"MISC_BLUE_BEYOND_CONSULTING_DIAGNOSTIC_MISCONCEPTION__1370EB", properties:{kc_id:"4c090da7-7e17-5044-a82b-2877add98f43", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Blue Beyond Consulting: diagnostic misconception 1086", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 666, in the textbook's discussion of Blue Beyond Consulting. Separate the specific account of Blue Beyond Consulting on printed page 666 from a universal claim. The source passage is: Building Your Personal Brand A workplace study by Blue Beyond Consulting shows that 8 in 10 employees say that it’s important that their employer’s values align with their values. Furthermore, more than 75 percent of respondents indicated that they expect their employer and business to be a force for good.31", status:"approved", flawed_rule:"The mention of Blue Beyond Consulting in sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BLUE_CROSS_DIAGNOSTIC_MISCONCEPTION_1087_F3B2EC", properties:{kc_id:"fe23d90d-feab-55d8-bf2f-159888edc9d8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Blue Cross: diagnostic misconception 1087", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 582, in the textbook's discussion of Blue Cross. Read what the source actually reports about Blue Cross, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving Blue Cross is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_BMW_DIAGNOSTIC_MISCONCEPTION_1088_483AEE", properties:{kc_id:"7ecdad2f-5dfe-573a-8717-25c144b4db7b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"BMW: diagnostic misconception 1088", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 50, in the textbook's discussion of BMW. Read what the source actually reports about BMW, then apply the definition of market development strategy: a growth strategy that identifies and develops new market segments for current products", status:"approved", flawed_rule:"The example involving BMW is interpreted using this faulty rule about market development strategy: Selling new products to existing customers is market development."}}, {misconception_id:"MISC_BOAR_S_HEAD_DIAGNOSTIC_MISCONCEPTION_1089_B75189", properties:{kc_id:"7dd2d6f6-2c08-5d3f-84c6-ba946972164d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Boar’s Head: diagnostic misconception 1089", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 528, in the textbook's discussion of Boar’s Head. Read what the source actually reports about Boar’s Head, then apply the definition of cooperative advertising: an approach to paying for local advertising or retail advertising whereby the details are handled by a local retail store but is partly or fully paid for by a national manufacturer whose product is featured in the ad", status:"approved", flawed_rule:"The example involving Boar’s Head is interpreted using this faulty rule about cooperative advertising: A retailer must always bear the entire cost of local manufacturer-brand advertising."}}, {misconception_id:"MISC_BOEING_DIAGNOSTIC_MISCONCEPTION_1090_08B290", properties:{kc_id:"6b058697-3487-5d20-8e13-177b6de1415a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Boeing: diagnostic misconception 1090", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 583, in the textbook's discussion of Boeing. Read what the source actually reports about Boeing, then apply the definition of business-to-consumer (B2C): a market comprised of companies that manufacture and sell products or services directly to a final consumer or end user", status:"approved", flawed_rule:"The example involving Boeing is interpreted using this faulty rule about business-to-consumer (B2C): B2C describes sales intended for further industrial production."}}, {misconception_id:"MISC_BOMBAS_DIAGNOSTIC_MISCONCEPTION_1091_10563D", properties:{kc_id:"aa95a426-75ff-55a9-8017-8cb4eb8973fb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bombas: diagnostic misconception 1091", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 344, in the textbook's discussion of Bombas. Read what the source actually reports about Bombas, then apply the definition of new-to-the-world products: new product inventions that create new markets", status:"approved", flawed_rule:"The example involving Bombas is interpreted using this faulty rule about new-to-the-world products: A competitor imitation qualifies as a new-to-the-world product."}}, {misconception_id:"MISC_BOSTON_CONSULTING_GROUP_DIAGNOSTIC_MISCONCEPTION_DA9171", properties:{kc_id:"822f5f40-424c-5436-88e1-1b34ec8f4b23", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Boston Consulting Group: diagnostic misconception 1092", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 57, in the textbook's discussion of Boston Consulting Group. Read what the source actually reports about Boston Consulting Group, then apply the definition of BCG matrix: Boston Consulting Group’s framework for analyzing an organization’s strategic business units", status:"approved", flawed_rule:"The example involving Boston Consulting Group is interpreted using this faulty rule about BCG matrix: A business with high market share must be a star regardless of market growth."}}, {misconception_id:"MISC_BOTTOMLESS_CLOSET_DIAGNOSTIC_MISCONCEPTION_1093_A717FE", properties:{kc_id:"a4c02559-7a89-569d-9aa1-f78e2a0bba88", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bottomless Closet: diagnostic misconception 1093", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 653, in the textbook's discussion of Bottomless Closet. Separate the specific account of Bottomless Closet on printed page 653 from a universal claim. The source passage is: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", status:"approved", flawed_rule:"The mention of Bottomless Closet in sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BRACH_S_DIAGNOSTIC_MISCONCEPTION_1094_A3927D", properties:{kc_id:"9d51c54b-015d-5497-928f-85c03442c027", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Brach’s: diagnostic misconception 1094", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of Brach’s. Separate the specific account of Brach’s on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of Brach’s in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BREAST_CANCER_FOUNDATION_DIAGNOSTIC_MISCONCEPTIO_E6D465", properties:{kc_id:"57d0364e-b708-5d7d-b33e-468477017628", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Breast Cancer Foundation: diagnostic misconception 1095", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of Breast Cancer Foundation. Read what the source actually reports about Breast Cancer Foundation, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Breast Cancer Foundation is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_BUICK_DIAGNOSTIC_MISCONCEPTION_1096_93A068", properties:{kc_id:"729af0f2-a071-5ca6-b140-4cf4a6c641d6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Buick: diagnostic misconception 1096", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 428, in the textbook's discussion of Buick. Read what the source actually reports about Buick, then apply the definition of price fixing: two or more companies agreeing to set certain prices in the market", status:"approved", flawed_rule:"The example involving Buick is interpreted using this faulty rule about price fixing: Competitors jointly agreeing prices is equivalent to independently following market conditions."}}, {misconception_id:"MISC_BUMBLE_DIAGNOSTIC_MISCONCEPTION_1097_5C02D5", properties:{kc_id:"5bebaf04-908c-5789-aad6-39b395ab9b45", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bumble: diagnostic misconception 1097", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 99, in the textbook's discussion of Bumble. Read what the source actually reports about Bumble, then apply the definition of buyer’s black box: a model used in the study of the buying behavior of consumers", status:"approved", flawed_rule:"The example involving Bumble is interpreted using this faulty rule about buyer’s black box: Identical marketing stimuli produce identical decisions in all consumers."}}, {misconception_id:"MISC_BUMBLE_BEE_DIAGNOSTIC_MISCONCEPTION_1098_7C4141", properties:{kc_id:"87ead1d6-95f1-575b-873a-12eea8971f6d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Bumble Bee: diagnostic misconception 1098", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 146, in the textbook's discussion of Bumble Bee. Separate the specific account of Bumble Bee on printed page 146 from a universal claim. The source passage is: Price fixing is illegal because it’s considered anticompetitive and hurts both consumers and businesses. Let’s illustrate with a real-life example with a company you’re likely familiar with—StarKist. In 2019, a San Francisco federal judge ordered the company to pay a fine in the amount of $100 million in connection with a canned tuna price-fixing conspiracy that involved StarKist, Bumble Bee Foods, and Chicken of the Sea, who regularly exchanged information about their sales and plans for pricing. The lawsuit alleged that, under the scheme, consumers were forced to pay more for canned tuna than they would have otherwise.21", status:"approved", flawed_rule:"The mention of Bumble Bee in ethical issues in b2b marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BURCH_DIAGNOSTIC_MISCONCEPTION_1099_65491A", properties:{kc_id:"15d87a26-8d5d-5c38-aa80-cb8ffd3786de", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Burch: diagnostic misconception 1099", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Burch. Separate the specific account of Burch on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Burch in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_BURGER_KING_DIAGNOSTIC_MISCONCEPTION_1100_3062D0", properties:{kc_id:"37e6967c-d786-5e88-a43d-36097cb9e6e3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Burger King: diagnostic misconception 1100", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 131, in the textbook's discussion of Burger King. Read what the source actually reports about Burger King, then apply the definition of producers: those individuals or businesses who buy raw goods to use in the creation of goods or services", status:"approved", flawed_rule:"The example involving Burger King is interpreted using this faulty rule about producers: Producers buy primarily for resale without transformation."}}, {misconception_id:"MISC_BURNETT_DIAGNOSTIC_MISCONCEPTION_1101_ED66E4", properties:{kc_id:"eb0f90e3-721d-5cab-ae3d-eeccc8e86ebd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Burnett: diagnostic misconception 1101", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 473, in the textbook's discussion of Burnett. Read what the source actually reports about Burnett, then apply the definition of pull strategy: advertising strategy intended to bring audiences to the product", status:"approved", flawed_rule:"The example involving Burnett is interpreted using this faulty rule about pull strategy: A pull strategy concentrates exclusively on persuading channel intermediaries to stock the product."}}, {misconception_id:"MISC_BUTTERBALL_DIAGNOSTIC_MISCONCEPTION_1102_676CEE", properties:{kc_id:"3f8ef720-d073-5777-8ef7-a8109be124a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Butterball: diagnostic misconception 1102", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 311, in the textbook's discussion of Butterball. Read what the source actually reports about Butterball, then apply the definition of augmented product: product having unseen aspects essential to customers", status:"approved", flawed_rule:"The example involving Butterball is interpreted using this faulty rule about augmented product: After-sales support and warranties cannot be part of the product offering."}}, {misconception_id:"MISC_BUZZFEED_DIAGNOSTIC_MISCONCEPTION_1103_C28FEE", properties:{kc_id:"92763935-748f-5e66-bcba-c47c25e43a1c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Buzzfeed: diagnostic misconception 1103", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 546, in the textbook's discussion of Buzzfeed. Read what the source actually reports about Buzzfeed, then apply the definition of website marketing: The promotion of a website that results in driving traffic or visitors to the site to learn more about the product or company or to make a purchase", status:"approved", flawed_rule:"The example involving Buzzfeed is interpreted using this faulty rule about website marketing: Building a website automatically brings relevant visitors to it."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_C_H_ROBINSON_DIAGNOSTIC_MISCONCEPTION_1104_7E0BC3", properties:{kc_id:"94cc9487-c969-55d8-a06a-53a0e88d4529", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"C.H. Robinson: diagnostic misconception 1104", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 645, in the textbook's discussion of C.H. Robinson. Read what the source actually reports about C.H. Robinson, then apply the definition of product traceability: the ability to track all processes for a product from the procurement of raw materials to production, consumption, and disposal", status:"approved", flawed_rule:"The example involving C.H. Robinson is interpreted using this faulty rule about product traceability: Traceability begins only when the finished item reaches the retailer."}}, {misconception_id:"MISC_CAMPAIGN_FOR_A_COMMERCIAL_FREE_CHILDHOOD_CCFC_DI_5878F5", properties:{kc_id:"3417d6e0-0268-54f4-bcfa-c8de17456c0d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Campaign for a Commercial-Free Childhood (CCFC): diagnostic misconception 1105", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 187, in the textbook's discussion of Campaign for a Commercial-Free Childhood (CCFC). Read what the source actually reports about Campaign for a Commercial-Free Childhood (CCFC), then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Campaign for a Commercial-Free Childhood (CCFC) is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_CAMPFIRE_TREATS_DIAGNOSTIC_MISCONCEPTION_1106_DA955E", properties:{kc_id:"37e6f94c-272c-5e31-8c99-659a82f805a0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Campfire Treats: diagnostic misconception 1106", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 492, in the textbook's discussion of Campfire Treats. Read what the source actually reports about Campfire Treats, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Campfire Treats is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_CAN_SPAM_ACT_DIAGNOSTIC_MISCONCEPTION_1107_CC8330", properties:{kc_id:"2c18db49-ff93-5194-aaf5-2d817806b80c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"CAN-SPAM Act: diagnostic misconception 1107", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of CAN-SPAM Act. Read what the source actually reports about CAN-SPAM Act, then apply the definition of buy one get one (BOGO): promotion strategy in which consumers are offered the opportunity to buy one product at regular price and get a second item free", status:"approved", flawed_rule:"The example involving CAN-SPAM Act is interpreted using this faulty rule about buy one get one (BOGO): A BOGO offer necessarily generates profit regardless of product cost and cannibalization."}}, {misconception_id:"MISC_CAREERBUILDER_DIAGNOSTIC_MISCONCEPTION_1108_7FFCAF", properties:{kc_id:"c37951ee-90f4-5d4c-bc72-9b6e7b25286e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"CareerBuilder: diagnostic misconception 1108", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 518, in the textbook's discussion of CareerBuilder. Separate the specific account of CareerBuilder on printed page 518 from a universal claim. The source passage is: Most recruiting starts with a job description detailing the requirements and the necessary skills that are needed to do the job. Finding the right candidates often starts through listing available job openings on many of the digital job boards, such as Indeed, CareerBuilder, and LinkedIn. Executive recruiting firms can also be instrumental in finding and matching the right job candidates.", status:"approved", flawed_rule:"The mention of CareerBuilder in management of the sales force establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_CARVANA_DIAGNOSTIC_MISCONCEPTION_1109_58161B", properties:{kc_id:"3cf24efa-de1e-5d13-a3b9-1661407246f4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Carvana: diagnostic misconception 1109", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 362, in the textbook's discussion of Carvana. Read what the source actually reports about Carvana, then apply the definition of diffusion of innovation: theory about how products gain momentum and spread through a population or society", status:"approved", flawed_rule:"The example involving Carvana is interpreted using this faulty rule about diffusion of innovation: All consumers adopt an innovation simultaneously after launch."}}, {misconception_id:"MISC_CASPER_DIAGNOSTIC_MISCONCEPTION_1110_73A3B5", properties:{kc_id:"388be238-f9d0-5fb2-b05b-961d2439b935", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Casper: diagnostic misconception 1110", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 541, in the textbook's discussion of Casper. Read what the source actually reports about Casper, then apply the definition of direct-mail marketing: a type of direct marketing that involves marketers sending mail directly to people’s homes or places of business; for example, catalogs and postcards", status:"approved", flawed_rule:"The example involving Casper is interpreted using this faulty rule about direct-mail marketing: Direct mail and email are the same delivery medium."}}, {misconception_id:"MISC_CENTERS_FOR_DISEASE_CONTROL_AND_PREVENTION_CDC_D_616EC4", properties:{kc_id:"e85eab44-83e2-5648-97d8-903feaf0dfb2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Centers for Disease Control and Prevention (CDC): diagnostic misconception 1111", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 187, in the textbook's discussion of Centers for Disease Control and Prevention (CDC). Separate the specific account of Centers for Disease Control and Prevention (CDC) on printed page 187 from a universal claim. The source passage is: Another ethical issue is childhood obesity. According to the Centers for Disease Control and Prevention (CDC),", status:"approved", flawed_rule:"The mention of Centers for Disease Control and Prevention (CDC) in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_CHANEL_DIAGNOSTIC_MISCONCEPTION_1112_3F8D21", properties:{kc_id:"c8c40348-6cc5-5a0e-a58a-2604073ce475", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Chanel: diagnostic misconception 1112", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 407, in the textbook's discussion of Chanel. Read what the source actually reports about Chanel, then apply the definition of price skimming: pricing strategy in which a company initially sets a high price for a product or service and lowers it over time as new segments of the market are reached", status:"approved", flawed_rule:"The example involving Chanel is interpreted using this faulty rule about price skimming: Skimming starts with a low mass-market price and raises it over time."}}, {misconception_id:"MISC_CHARITY_WATER_DIAGNOSTIC_MISCONCEPTION_1113_2282B4", properties:{kc_id:"e8ddf110-fa63-57f4-ba1a-76b3f43bd850", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Charity: Water: diagnostic misconception 1113", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 661, in the textbook's discussion of Charity: Water. Read what the source actually reports about Charity: Water, then apply the definition of mission-driven marketing: marketing strategies that align purpose and brand by using the corporate core mission and purpose as their focus", status:"approved", flawed_rule:"The example involving Charity: Water is interpreted using this faulty rule about mission-driven marketing: A campaign can be mission-driven even when its claims contradict the organization's purpose and actions."}}, {misconception_id:"MISC_CHEERIOS_DIAGNOSTIC_MISCONCEPTION_1114_3E673D", properties:{kc_id:"b1b02fd0-8d62-5879-a773-af22eaf9b69a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Cheerios: diagnostic misconception 1114", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 319, in the textbook's discussion of Cheerios. Read what the source actually reports about Cheerios, then apply the definition of market modification: an extension of a product to new customers", status:"approved", flawed_rule:"The example involving Cheerios is interpreted using this faulty rule about market modification: Market modification necessarily changes the product's physical design."}}, {misconception_id:"MISC_CHEVROLET_DIAGNOSTIC_MISCONCEPTION_1115_822CDE", properties:{kc_id:"f068a3bb-b8ec-5368-8216-ea854f470ab3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"Chevrolet: diagnostic misconception 1115", created_at:datetime('2026-09-20T10:16:38.173Z'), remediation_hint:"Use printed page 428, in the textbook's discussion of Chevrolet. Read what the source actually reports about Chevrolet, then apply the definition of price fixing: two or more companies agreeing to set certain prices in the market", status:"approved", flawed_rule:"The example involving Chevrolet is interpreted using this faulty rule about price fixing: Competitors jointly agreeing prices is equivalent to independently following market conditions."}}, {misconception_id:"MISC_CHEVY_DIAGNOSTIC_MISCONCEPTION_1116_314D06", properties:{kc_id:"727e9e7f-059c-50f6-b322-4a0d8dd37468", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Chevy: diagnostic misconception 1116", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 100, in the textbook's discussion of Chevy. Read what the source actually reports about Chevy, then apply the definition of complex buying behavior: the consumer buying behavior that occurs when the consumer is highly involved with the purchase and perceives significant differences between brands", status:"approved", flawed_rule:"The example involving Chevy is interpreted using this faulty rule about complex buying behavior: All expensive purchases involve little deliberation and no perceived brand differences."}}, {misconception_id:"MISC_CHICK_FIL_A_DIAGNOSTIC_MISCONCEPTION_1117_7F3119", properties:{kc_id:"15439554-e17b-5f00-9b53-0e3604060a12", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Chick-fil-A: diagnostic misconception 1117", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 139, in the textbook's discussion of Chick-fil-A. Read what the source actually reports about Chick-fil-A, then apply the definition of product specifications: a document carrying essential information to keep teams on track when designing and developing a product", status:"approved", flawed_rule:"The example involving Chick-fil-A is interpreted using this faulty rule about product specifications: A product specification merely states the total purchasing budget."}}, {misconception_id:"MISC_CHICKEN_OF_THE_SEA_DIAGNOSTIC_MISCONCEPTION_1118_F999B1", properties:{kc_id:"59cc756f-a308-59c4-829c-f94817b05d4d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Chicken of the Sea: diagnostic misconception 1118", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 146, in the textbook's discussion of Chicken of the Sea. Separate the specific account of Chicken of the Sea on printed page 146 from a universal claim. The source passage is: Price fixing is illegal because it’s considered anticompetitive and hurts both consumers and businesses. Let’s illustrate with a real-life example with a company you’re likely familiar with—StarKist. In 2019, a San Francisco federal judge ordered the company to pay a fine in the amount of $100 million in connection with a canned tuna price-fixing conspiracy that involved StarKist, Bumble Bee Foods, and Chicken of the Sea, who regularly exchanged information about their sales and plans for pricing. The lawsuit alleged that, under the scheme, consumers were forced to pay more for canned tuna than they would have otherwise.21", status:"approved", flawed_rule:"The mention of Chicken of the Sea in ethical issues in b2b marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_CHIPOTLE_DIAGNOSTIC_MISCONCEPTION_1119_31A6A5", properties:{kc_id:"a672e187-ebee-5d6f-b3f6-3d20eacd4199", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Chipotle: diagnostic misconception 1119", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 116, in the textbook's discussion of Chipotle. Read what the source actually reports about Chipotle, then apply the definition of family: a group of persons united by ties of marriage, blood, or adoption, or those who live in the same household", status:"approved", flawed_rule:"The example involving Chipotle is interpreted using this faulty rule about family: Only an individual buyer matters; household members do not influence the decision."}}, {misconception_id:"MISC_CHIPS_AHOY_DIAGNOSTIC_MISCONCEPTION_1120_8A49FC", properties:{kc_id:"d00fbb07-46ae-522d-8acf-2177be80561c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Chips Ahoy: diagnostic misconception 1120", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 326, in the textbook's discussion of Chips Ahoy. Read what the source actually reports about Chips Ahoy, then apply the definition of new brands: an entirely different brand entity from a parent company", status:"approved", flawed_rule:"The example involving Chips Ahoy is interpreted using this faulty rule about new brands: A new brand is merely a new package size under the same existing name."}}, {misconception_id:"MISC_CHOBANI_DIAGNOSTIC_MISCONCEPTION_1121_D96655", properties:{kc_id:"1556b865-c508-5783-9992-bb43c43f0178", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Chobani: diagnostic misconception 1121", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 319, in the textbook's discussion of Chobani. Read what the source actually reports about Chobani, then apply the definition of product modification: alteration of products to fit the market", status:"approved", flawed_rule:"The example involving Chobani is interpreted using this faulty rule about product modification: Changing target customers without altering the offering is product modification."}}, {misconception_id:"MISC_CHURCH_S_DIAGNOSTIC_MISCONCEPTION_1122_59F74C", properties:{kc_id:"c0be893e-9b3e-5862-82b7-6fa71bb92698", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Church’s: diagnostic misconception 1122", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 241, in the textbook's discussion of Church’s. Read what the source actually reports about Church’s, then apply the definition of international firm: a company that operates on a global level regardless of intensity of involvement", status:"approved", flawed_rule:"The example involving Church’s is interpreted using this faulty rule about international firm: All firms operating internationally allow the same degree of local autonomy."}}, {misconception_id:"MISC_CIRQUE_DU_SOLEIL_DIAGNOSTIC_MISCONCEPTION_1123_1769FB", properties:{kc_id:"368189d4-c267-5b63-a368-df58d459d22f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Cirque du Soleil: diagnostic misconception 1123", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 63, in the textbook's discussion of Cirque du Soleil. Read what the source actually reports about Cirque du Soleil, then apply the definition of market penetration strategy: a strategy used when a company focuses on growing its market share in its existing markets", status:"approved", flawed_rule:"The example involving Cirque du Soleil is interpreted using this faulty rule about market penetration strategy: Entering a new market is market penetration."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_CIVIL_RIGHTS_ACT_DIAGNOSTIC_MISCONCEPTION_1124_9F508D", properties:{kc_id:"7f0dab11-526b-5d26-9676-adce9b8f2f36", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Civil Rights Act: diagnostic misconception 1124", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 259, in the textbook's discussion of Civil Rights Act. Read what the source actually reports about Civil Rights Act, then apply the definition of marginalized consumers: populations of consumers that have been pushed to the margins of society and are often excluded in mainstream advertising", status:"approved", flawed_rule:"The example involving Civil Rights Act is interpreted using this faulty rule about marginalized consumers: Being overlooked by mainstream advertising means having no relevant customer needs."}}, {misconception_id:"MISC_CJ_AFFILIATE_DIAGNOSTIC_MISCONCEPTION_1125_DBD074", properties:{kc_id:"0c4d17e6-a33e-579d-98ee-988a1e04001d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"CJ Affiliate: diagnostic misconception 1125", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 561, in the textbook's discussion of CJ Affiliate. Read what the source actually reports about CJ Affiliate, then apply the definition of website traffic: the total number of visitors to a company’s website", status:"approved", flawed_rule:"The example involving CJ Affiliate is interpreted using this faulty rule about website traffic: More visits necessarily produce a better conversion rate."}}, {misconception_id:"MISC_CLARITAS_DIAGNOSTIC_MISCONCEPTION_1126_87D1A0", properties:{kc_id:"67c59125-ca23-56fb-aa54-8c44bc128714", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Claritas: diagnostic misconception 1126", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 268, in the textbook's discussion of Claritas. Read what the source actually reports about Claritas, then apply the definition of Black population: second largest multicultural group in the United States; made up of three different subethnicities: single race, Black Hispanic, or Black mixed with another race (White or Native American)", status:"approved", flawed_rule:"The example involving Claritas is interpreted using this faulty rule about Black population: Black consumers share a single ancestry, identity, and purchasing pattern."}}, {misconception_id:"MISC_CLASSIC_CLEANERS_DIAGNOSTIC_MISCONCEPTION_1127_81BF5B", properties:{kc_id:"ed56f339-d7a9-558e-ac48-baed7aba7259", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Classic Cleaners: diagnostic misconception 1127", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 78, in the textbook's discussion of Classic Cleaners. Read what the source actually reports about Classic Cleaners, then apply the definition of marketing dashboard: summarizes important marketing metrics and key performance indicators into easy- to-understand measurements", status:"approved", flawed_rule:"The example involving Classic Cleaners is interpreted using this faulty rule about marketing dashboard: A dashboard improves decisions merely by displaying as many metrics as possible."}}, {misconception_id:"MISC_CNN_DIAGNOSTIC_MISCONCEPTION_1128_B61F66", properties:{kc_id:"4332c407-07a7-5c1f-935b-05d6d8e58f57", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"CNN: diagnostic misconception 1128", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 489, in the textbook's discussion of CNN. Read what the source actually reports about CNN, then apply the definition of publicity: notice or attention given by the media", status:"approved", flawed_rule:"The example involving CNN is interpreted using this faulty rule about publicity: Publicity is always favorable and fully controlled by the company."}}, {misconception_id:"MISC_COACH_DIAGNOSTIC_MISCONCEPTION_1129_3CFC62", properties:{kc_id:"30295692-b22c-5614-8f37-a9303ba95ff5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Coach: diagnostic misconception 1129", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 621, in the textbook's discussion of Coach. Read what the source actually reports about Coach, then apply the definition of off-price retailers: retailers that provide high-quality goods at lower prices", status:"approved", flawed_rule:"The example involving Coach is interpreted using this faulty rule about off-price retailers: Off-price retailers necessarily sell only defective goods."}}, {misconception_id:"MISC_COCA_COLA_DIAGNOSTIC_MISCONCEPTION_1130_0BD2C8", properties:{kc_id:"7481217f-4af0-5810-8298-091d244cd684", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Coca-Cola: diagnostic misconception 1130", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 98, in the textbook's discussion of Coca-Cola. Read what the source actually reports about Coca-Cola, then apply the definition of cultural factors: a set of values or ideologies of a particular community or group of individuals that include culture, subcultures, social class, and gender", status:"approved", flawed_rule:"The example involving Coca-Cola is interpreted using this faulty rule about cultural factors: Culture affects food choices but not broader consumer decisions."}}, {misconception_id:"MISC_CONSCIOUS_COFFEES_DIAGNOSTIC_MISCONCEPTION_1131_5F4811", properties:{kc_id:"ccf895b0-16c2-5d9d-bb8b-839570a5d7dc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Conscious Coffees: diagnostic misconception 1131", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 117, in the textbook's discussion of Conscious Coffees. Separate the specific account of Conscious Coffees on printed page 117 from a universal claim. The source passage is: Ethics and Corporations Hundreds of companies are known for being ethical, including Patagonia (more information later in this chapter), TOMS, and Conscious Coffees, among others. Read about five examples of truly ethical companies (https://openstax.org/r/trulyethicalcompanies) and how they are working to make an impact in their markets.", status:"approved", flawed_rule:"The mention of Conscious Coffees in ethical issues in consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_CONSTELLATION_BRANDS_DIAGNOSTIC_MISCONCEPTION_11_434767", properties:{kc_id:"21088c51-437c-5227-ae33-228140fc0ccc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Constellation Brands: diagnostic misconception 1132", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 267, in the textbook's discussion of Constellation Brands. Read what the source actually reports about Constellation Brands, then apply the definition of Hispanic population: largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe", status:"approved", flawed_rule:"The example involving Constellation Brands is interpreted using this faulty rule about Hispanic population: Hispanic identity implies one race, nationality, or level of Spanish-language preference."}}, {misconception_id:"MISC_CONVERSE_DIAGNOSTIC_MISCONCEPTION_1133_28961A", properties:{kc_id:"390b0af8-9c82-5e7c-9e48-efeb79f30625", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Converse: diagnostic misconception 1133", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 98, in the textbook's discussion of Converse. Read what the source actually reports about Converse, then apply the definition of complex buying behavior: the consumer buying behavior that occurs when the consumer is highly involved with the purchase and perceives significant differences between brands", status:"approved", flawed_rule:"The example involving Converse is interpreted using this faulty rule about complex buying behavior: All expensive purchases involve little deliberation and no perceived brand differences."}}, {misconception_id:"MISC_CORRUPTION_PERCEPTIONS_INDEX_CPI_DIAGNOSTIC_MISC_3CE765", properties:{kc_id:"39873997-e804-59e0-bf54-6073b55166c7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Corruption Perceptions Index (CPI): diagnostic misconception 1134", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 235, in the textbook's discussion of Corruption Perceptions Index (CPI). Read what the source actually reports about Corruption Perceptions Index (CPI), then apply the definition of international firm: a company that operates on a global level regardless of intensity of involvement", status:"approved", flawed_rule:"The example involving Corruption Perceptions Index (CPI) is interpreted using this faulty rule about international firm: All firms operating internationally allow the same degree of local autonomy."}}, {misconception_id:"MISC_COSTCO_DIAGNOSTIC_MISCONCEPTION_1135_0F6BED", properties:{kc_id:"ffee351a-0cde-5b0d-ac32-8cc9302a8067", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Costco: diagnostic misconception 1135", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 179, in the textbook's discussion of Costco. Read what the source actually reports about Costco, then apply the definition of undifferentiated marketing: also called mass marketing, a strategy that entails creating one message for an entire audience", status:"approved", flawed_rule:"The example involving Costco is interpreted using this faulty rule about undifferentiated marketing: Undifferentiated marketing requires separate offers for every segment."}}, {misconception_id:"MISC_COUNCIL_OF_BETTER_BUSINESS_BUREAUS_DIAGNOSTIC_MI_E864F0", properties:{kc_id:"45b720ec-ddd9-595c-856b-f144a013c82b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Council of Better Business Bureaus: diagnostic misconception 1136", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of Council of Better Business Bureaus. Separate the specific account of Council of Better Business Bureaus on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of Council of Better Business Bureaus in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_CREMINELLI_FINE_MEATS_DIAGNOSTIC_MISCONCEPTION_1_C5BD2F", properties:{kc_id:"2d7ada30-36f8-5714-b13e-e29b68673a02", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Creminelli Fine Meats: diagnostic misconception 1137", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 526, in the textbook's discussion of Creminelli Fine Meats. Read what the source actually reports about Creminelli Fine Meats, then apply the definition of sales promotion: a short-term way of enticing the consumer to purchase a product or service", status:"approved", flawed_rule:"The example involving Creminelli Fine Meats is interpreted using this faulty rule about sales promotion: A temporary incentive necessarily creates durable brand loyalty."}}, {misconception_id:"MISC_CUMBERLAND_FARMS_DIAGNOSTIC_MISCONCEPTION_1138_896F63", properties:{kc_id:"cbbeb970-c30d-5b9f-97a4-a2c0df91a2a2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Cumberland Farms: diagnostic misconception 1138", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 442, in the textbook's discussion of Cumberland Farms. Read what the source actually reports about Cumberland Farms, then apply the definition of message strategy: method of developing a message based on how the message will best tie the brand to the target market", status:"approved", flawed_rule:"The example involving Cumberland Farms is interpreted using this faulty rule about message strategy: A message strategy is only a choice of font, color, and production technique."}}, {misconception_id:"MISC_CUPSHE_DIAGNOSTIC_MISCONCEPTION_1139_27311C", properties:{kc_id:"97459fd2-e5c4-5178-9803-7c6ba62f5ad5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Cupshe: diagnostic misconception 1139", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 555, in the textbook's discussion of Cupshe. Read what the source actually reports about Cupshe, then apply the definition of social media marketing: using social media platforms, such as Facebook, Instagram, LinkedIn, and Twitter, to deliver content that drives engagement with your brand", status:"approved", flawed_rule:"The example involving Cupshe is interpreted using this faulty rule about social media marketing: A follower count alone establishes campaign effectiveness."}}, {misconception_id:"MISC_CURVES_DIAGNOSTIC_MISCONCEPTION_1140_E9DD76", properties:{kc_id:"90379314-3ede-569a-9955-cd8f1acc3454", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Curves: diagnostic misconception 1140", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 183, in the textbook's discussion of Curves. Read what the source actually reports about Curves, then apply the definition of head-to-head positioning: directly competing with competitors on similar product attributes in the same market", status:"approved", flawed_rule:"The example involving Curves is interpreted using this faulty rule about head-to-head positioning: Head-to-head positioning avoids comparison on competitors' main attributes."}}, {misconception_id:"MISC_CUTCO_DIAGNOSTIC_MISCONCEPTION_1141_CF39F9", properties:{kc_id:"1f3f25c3-245b-5396-bd80-829e775965a6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Cutco: diagnostic misconception 1141", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 536, in the textbook's discussion of Cutco. Read what the source actually reports about Cutco, then apply the definition of lead response time: The elapsed time taken by a sales team to respond to a new lead or customer request, as explained in section 15.4. Source inconsistency: the glossary supplies an unrelated analytics definition; this node follows the substantive section.", status:"approved", flawed_rule:"The example involving Cutco is interpreted using this faulty rule about lead response time: Lead response time measures demographic analysis rather than elapsed time to respond."}}, {misconception_id:"MISC_CVS_DIAGNOSTIC_MISCONCEPTION_1142_BF7B1A", properties:{kc_id:"d4d14aa5-839e-5f80-ae7e-07d9b0cf0bc0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"CVS: diagnostic misconception 1142", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 489, in the textbook's discussion of CVS. Read what the source actually reports about CVS, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving CVS is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_D_ROSE_DIAGNOSTIC_MISCONCEPTION_1143_F7DB0B", properties:{kc_id:"927b6159-26ba-573f-b15c-cbc71d78172e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"D Rose: diagnostic misconception 1143", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 417, in the textbook's discussion of D Rose. Read what the source actually reports about D Rose, then apply the definition of prestige pricing: a strategy marketers use to set high prices knowing that demand will increase with higher prices because the higher price increases the perceived value of the product", status:"approved", flawed_rule:"The example involving D Rose is interpreted using this faulty rule about prestige pricing: Customers always interpret a higher price as lower value."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_DATA_MARKETING_ASSOCIATION_DMA_DIAGNOSTIC_MISCON_FDFD5B", properties:{kc_id:"0c227987-95bc-57c3-82f7-81daffd6190d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Data & Marketing Association (DMA): diagnostic misconception 1144", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 444, in the textbook's discussion of Data & Marketing Association (DMA). Read what the source actually reports about Data & Marketing Association (DMA), then apply the definition of direct marketing: method of promotion that directly connects with the customer and generally requires a response or transaction", status:"approved", flawed_rule:"The example involving Data & Marketing Association (DMA) is interpreted using this faulty rule about direct marketing: Direct marketing cannot use television or print."}}, {misconception_id:"MISC_DAVE_S_KILLER_BREAD_DKB_DIAGNOSTIC_MISCONCEPTION_55B146", properties:{kc_id:"6af091b6-a63f-5ca3-806b-a1b6749e0f13", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dave’s Killer Bread (DKB): diagnostic misconception 1145", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 597, in the textbook's discussion of Dave’s Killer Bread (DKB). Separate the specific account of Dave’s Killer Bread (DKB) on printed page 597 from a universal claim. The source passage is: For example, Dave’s Killer Bread (DKB) has positioned itself as the maker of “the best bread you’ve ever tasted, power-packed with organic whole grain nutrition.” The promise to consumers starts with selecting suppliers who are certified organic and who can consistently deliver high-quality ingredients. DKB’s promise to consumers starts as far back as the grains selected by DKB’s suppliers.", status:"approved", flawed_rule:"The mention of Dave’s Killer Bread (DKB) in the supply chain and its functions establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_DEL_WEBB_DIAGNOSTIC_MISCONCEPTION_1146_11B2E5", properties:{kc_id:"e90d7260-94c9-5cc4-a8e2-7ebbc5064445", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Del Webb: diagnostic misconception 1146", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 26, in the textbook's discussion of Del Webb. Read what the source actually reports about Del Webb, then apply the definition of sales concept: orientation that analyzes buying and selling effects to place the focus primarily on generating sales transactions", status:"approved", flawed_rule:"The example involving Del Webb is interpreted using this faulty rule about sales concept: An aggressive selling orientation automatically produces long-term customer satisfaction."}}, {misconception_id:"MISC_DELL_DIAGNOSTIC_MISCONCEPTION_1147_13B9EB", properties:{kc_id:"a68665b1-7e1e-567c-ac91-6946223775ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dell: diagnostic misconception 1147", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 237, in the textbook's discussion of Dell. Read what the source actually reports about Dell, then apply the definition of tariffs: taxes that governments impose on imports into the country", status:"approved", flawed_rule:"The example involving Dell is interpreted using this faulty rule about tariffs: Tariffs prohibit all imports from the affected country."}}, {misconception_id:"MISC_DELTA_AIR_LINES_DIAGNOSTIC_MISCONCEPTION_1148_6B2E5B", properties:{kc_id:"f6838709-715f-54af-bf07-3adf0bf27b35", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Delta Air Lines: diagnostic misconception 1148", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 236, in the textbook's discussion of Delta Air Lines. Read what the source actually reports about Delta Air Lines, then apply the definition of global market opportunities: conditions that are favorable for a company to expand into the global marketplace", status:"approved", flawed_rule:"The example involving Delta Air Lines is interpreted using this faulty rule about global market opportunities: Any large foreign population guarantees profitable entry."}}, {misconception_id:"MISC_DEPARTMENT_OF_JUSTICE_DIAGNOSTIC_MISCONCEPTION_1_EA91C7", properties:{kc_id:"ebc2a48a-edff-52f6-87f4-f2de13b4bc2a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Department of Justice: diagnostic misconception 1149", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 146, in the textbook's discussion of Department of Justice. Read what the source actually reports about Department of Justice, then apply the definition of Foreign Corrupt Practices Act (FCPA): a US statute that prohibits firms and individuals from paying bribes to foreign officials", status:"approved", flawed_rule:"The example involving Department of Justice is interpreted using this faulty rule about Foreign Corrupt Practices Act (FCPA): Bribery of foreign officials becomes acceptable whenever it is locally customary."}}, {misconception_id:"MISC_DESIGNER_SHOE_WAREHOUSE_DSW_DIAGNOSTIC_MISCONCEP_86F44F", properties:{kc_id:"fb2ed663-66bc-57c7-84f5-9a3ea2301a06", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Designer Shoe Warehouse (DSW): diagnostic misconception 1150", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 33, in the textbook's discussion of Designer Shoe Warehouse (DSW). Read what the source actually reports about Designer Shoe Warehouse (DSW), then apply the definition of customer loyalty: an ongoing positive relationship between a customer and a business", status:"approved", flawed_rule:"The example involving Designer Shoe Warehouse (DSW) is interpreted using this faulty rule about customer loyalty: A repeat purchase always proves emotional commitment to the brand."}}, {misconception_id:"MISC_DICK_S_SPORTING_GOODS_DIAGNOSTIC_MISCONCEPTION_1_4686A5", properties:{kc_id:"e47d4c54-2c6d-5b72-9863-41d842ad8fbb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dick’s Sporting Goods: diagnostic misconception 1151", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 546, in the textbook's discussion of Dick’s Sporting Goods. Read what the source actually reports about Dick’s Sporting Goods, then apply the definition of marketing emails: emails that are promotional in nature and typically involve a marketing offer", status:"approved", flawed_rule:"The example involving Dick’s Sporting Goods is interpreted using this faulty rule about marketing emails: Every operational email is necessarily a promotional marketing offer."}}, {misconception_id:"MISC_DIGITAL_MARKETING_INSTITUTE_DIAGNOSTIC_MISCONCEP_8333AD", properties:{kc_id:"b08d6e1f-3769-5010-a39d-312f9b9ed015", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Digital Marketing Institute: diagnostic misconception 1152", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 41, in the textbook's discussion of Digital Marketing Institute. Read what the source actually reports about Digital Marketing Institute, then apply the definition of marketing mix: the set of actions or tactics that a company uses to promote its brand or product in the market", status:"approved", flawed_rule:"The example involving Digital Marketing Institute is interpreted using this faulty rule about marketing mix: Promotion alone constitutes the marketing mix."}}, {misconception_id:"MISC_DISNEY_DIAGNOSTIC_MISCONCEPTION_1153_4B73B7", properties:{kc_id:"a06ab911-fc9f-5339-b90a-ae1e05c355ed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Disney: diagnostic misconception 1153", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 187, in the textbook's discussion of Disney. Read what the source actually reports about Disney, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Disney is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_DISNEY_CHANNEL_DIAGNOSTIC_MISCONCEPTION_1154_A4E98B", properties:{kc_id:"8d5fd557-c50a-5548-8fc9-ddda06b45303", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Disney Channel: diagnostic misconception 1154", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 155, in the textbook's discussion of Disney Channel. Read what the source actually reports about Disney Channel, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Disney Channel is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_DISNEYLAND_HONG_KONG_DIAGNOSTIC_MISCONCEPTION_11_59D6E0", properties:{kc_id:"6fc249d5-5c0a-582e-8bbe-aab0f498f36a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Disneyland Hong Kong: diagnostic misconception 1155", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 238, in the textbook's discussion of Disneyland Hong Kong. Read what the source actually reports about Disneyland Hong Kong, then apply the definition of cultural sensitivity: awareness and appreciation of and the ability to adapt to a cultural, ethnic, racial, or another group other than one’s own", status:"approved", flawed_rule:"The example involving Disneyland Hong Kong is interpreted using this faulty rule about cultural sensitivity: Translating words is sufficient to understand another market's cultural meaning."}}, {misconception_id:"MISC_DOLLAR_GENERAL_DIAGNOSTIC_MISCONCEPTION_1156_345B12", properties:{kc_id:"9eef6f18-fd7d-5c5b-80b8-fab02af8e13b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dollar General: diagnostic misconception 1156", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 621, in the textbook's discussion of Dollar General. Read what the source actually reports about Dollar General, then apply the definition of discount store: retailer that sells a broad range of products at lower prices than competitors", status:"approved", flawed_rule:"The example involving Dollar General is interpreted using this faulty rule about discount store: Every low-price retailer uses the same product sourcing and assortment model."}}, {misconception_id:"MISC_DOLLAR_SHAVE_CLUB_DIAGNOSTIC_MISCONCEPTION_1157_673160", properties:{kc_id:"1e08ff62-fe60-545e-9ab2-14a89771b757", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dollar Shave Club: diagnostic misconception 1157", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 356, in the textbook's discussion of Dollar Shave Club. Read what the source actually reports about Dollar Shave Club, then apply the definition of new-to-the-firm products: products that are new to a company but not to the world", status:"approved", flawed_rule:"The example involving Dollar Shave Club is interpreted using this faulty rule about new-to-the-firm products: An offering new to one company must be new to every customer worldwide."}}, {misconception_id:"MISC_DOLLAR_STORES_DIAGNOSTIC_MISCONCEPTION_1158_151AF6", properties:{kc_id:"d69e0664-cb7b-546c-bdd4-a5be98073f7f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dollar Stores: diagnostic misconception 1158", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 628, in the textbook's discussion of Dollar Stores. Read what the source actually reports about Dollar Stores, then apply the definition of department stores: larger retailers that have separated areas—or departments—for similar product lines", status:"approved", flawed_rule:"The example involving Dollar Stores is interpreted using this faulty rule about department stores: A department store specializes in only one narrow product line."}}, {misconception_id:"MISC_DOLLAR_TREE_DIAGNOSTIC_MISCONCEPTION_1159_7B12F7", properties:{kc_id:"4f7dda08-76c4-5502-a0cc-4b38301c1ed4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dollar Tree: diagnostic misconception 1159", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 621, in the textbook's discussion of Dollar Tree. Read what the source actually reports about Dollar Tree, then apply the definition of discount store: retailer that sells a broad range of products at lower prices than competitors", status:"approved", flawed_rule:"The example involving Dollar Tree is interpreted using this faulty rule about discount store: Every low-price retailer uses the same product sourcing and assortment model."}}, {misconception_id:"MISC_DOMINO_S_PIZZA_DIAGNOSTIC_MISCONCEPTION_1160_26C66E", properties:{kc_id:"e38de5e2-944e-5d2a-b192-088a4b6edcdd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Domino’s Pizza: diagnostic misconception 1160", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 313, in the textbook's discussion of Domino’s Pizza. Read what the source actually reports about Domino’s Pizza, then apply the definition of product item: a particular good that a company sells", status:"approved", flawed_rule:"The example involving Domino’s Pizza is interpreted using this faulty rule about product item: A product item is the firm's complete portfolio."}}, {misconception_id:"MISC_DORITOS_DIAGNOSTIC_MISCONCEPTION_1161_C2F56D", properties:{kc_id:"90cdf419-9cde-574a-9854-a04dd70cbd56", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Doritos: diagnostic misconception 1161", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Doritos. Read what the source actually reports about Doritos, then apply the definition of brand value: the financial asset associated with a brand", status:"approved", flawed_rule:"The example involving Doritos is interpreted using this faulty rule about brand value: The financial value of a brand equals the cost of designing its logo."}}, {misconception_id:"MISC_DOTDASH_MEREDITH_DIAGNOSTIC_MISCONCEPTION_1162_751C0F", properties:{kc_id:"eeba5086-7214-51f9-b975-afae76b62056", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dotdash Meredith: diagnostic misconception 1162", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 547, in the textbook's discussion of Dotdash Meredith. Read what the source actually reports about Dotdash Meredith, then apply the definition of content marketing: creating and distributing online content that is valuable and relevant to a company’s target customers", status:"approved", flawed_rule:"The example involving Dotdash Meredith is interpreted using this faulty rule about content marketing: Content marketing is simply an uninterrupted sequence of product advertisements."}}, {misconception_id:"MISC_DOVE_DIAGNOSTIC_MISCONCEPTION_1163_1B89BE", properties:{kc_id:"3b18c433-1717-5d2c-b9fe-43a7bf05d9d2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dove: diagnostic misconception 1163", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 105, in the textbook's discussion of Dove. Separate the specific account of Dove on printed page 105 from a universal claim. The source passage is: When Bombarding Backfires Bombarding consumers with marketing messages can cause more harm than good. According to this article from Marketing Dive (https://openstax.org/r/studyadoverload), bombarding people with ads would negatively impact a brand. This article from the Advertising Association (https://openstax.org/r/newcredos) shares data that indicates bombardment and intrusiveness negatively impact perceptions of advertising.", status:"approved", flawed_rule:"The mention of Dove in factors that influence consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_DRAKE_S_CAKES_DIAGNOSTIC_MISCONCEPTION_1164_B034CD", properties:{kc_id:"175cc8d3-2642-582d-b607-bbc3d75f6081", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Drake’s Cakes: diagnostic misconception 1164", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 470, in the textbook's discussion of Drake’s Cakes. Separate the specific account of Drake’s Cakes on printed page 470 from a universal claim. The source passage is: Among the company’s brands are Little Debbie, Sunbelt Bakery, Drake’s Cakes, and Fieldstone Bakery. The largest brand is Little Debbie, with a wide range of favorites from Apple Fruit Pies to Zebra Cakes. Little Debbie offers seasonal items in rotation, such as Christmas Tree Cakes. Distribution extends to all 50 states, Mexico, and Canada.", status:"approved", flawed_rule:"The mention of Drake’s Cakes in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_DUCKDUCKGO_DIAGNOSTIC_MISCONCEPTION_1165_A0683B", properties:{kc_id:"9ec638fc-9800-57bd-8742-f78fdc93c81b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"DuckDuckGo: diagnostic misconception 1165", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 31, in the textbook's discussion of DuckDuckGo. Read what the source actually reports about DuckDuckGo, then apply the definition of time utility: adding value to the consumer by having the product or service available when the consumer needs it", status:"approved", flawed_rule:"The example involving DuckDuckGo is interpreted using this faulty rule about time utility: A product available after the customer's deadline provides the same time utility."}}, {misconception_id:"MISC_DUNKIN_DIAGNOSTIC_MISCONCEPTION_1166_E37322", properties:{kc_id:"a965f928-3eaf-5c89-b378-d0d48249965d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Dunkin’: diagnostic misconception 1166", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 327, in the textbook's discussion of Dunkin’. Read what the source actually reports about Dunkin’, then apply the definition of hard-core loyals: tried-and-true customers who will generally only purchase one brand in a category", status:"approved", flawed_rule:"The example involving Dunkin’ is interpreted using this faulty rule about hard-core loyals: A customer who routinely alternates among three brands is loyal to only one."}}, {misconception_id:"MISC_EASY_JET_DIAGNOSTIC_MISCONCEPTION_1167_82B8B7", properties:{kc_id:"305c320c-a120-5835-beb0-fbc2e0fb256f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Easy Jet: diagnostic misconception 1167", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of Easy Jet. Read what the source actually reports about Easy Jet, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Easy Jet is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_EBAY_DIAGNOSTIC_MISCONCEPTION_1168_0D7FDB", properties:{kc_id:"32f23194-cec4-5684-9c77-8d3dcfd5f654", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"eBay: diagnostic misconception 1168", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 50, in the textbook's discussion of eBay. Read what the source actually reports about eBay, then apply the definition of customer lifetime value (CLV): an estimate of how much a single customer is worth to a company over their customer life span", status:"approved", flawed_rule:"The example involving eBay is interpreted using this faulty rule about customer lifetime value (CLV): Customer lifetime value is identical to the customer's first purchase revenue."}}, {misconception_id:"MISC_EGGO_DIAGNOSTIC_MISCONCEPTION_1169_9AFA7F", properties:{kc_id:"c128316e-8bb2-5a0d-bfad-4d8e205972ce", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Eggo: diagnostic misconception 1169", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 322, in the textbook's discussion of Eggo. Read what the source actually reports about Eggo, then apply the definition of brand positioning: the way a brand signals emotions in consumers’ minds", status:"approved", flawed_rule:"The example involving Eggo is interpreted using this faulty rule about brand positioning: Brand positioning is determined exclusively by management intention, regardless of customer perception."}}, {misconception_id:"MISC_ELEMENT_FLEET_MANAGEMENT_DIAGNOSTIC_MISCONCEPTIO_A9E7B8", properties:{kc_id:"79d29cc6-720d-5f1a-a4c0-ed8cf6c3ac33", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Element Fleet Management: diagnostic misconception 1170", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 584, in the textbook's discussion of Element Fleet Management. Read what the source actually reports about Element Fleet Management, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving Element Fleet Management is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_EMERSON_ELECTRIC_DIAGNOSTIC_MISCONCEPTION_1171_971FCB", properties:{kc_id:"3c970405-c717-5461-bfa9-860cd6d2796c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Emerson Electric: diagnostic misconception 1171", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 56, in the textbook's discussion of Emerson Electric. Read what the source actually reports about Emerson Electric, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving Emerson Electric is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_EQUAL_EMPLOYMENT_OPPORTUNITY_COMMISSION_EEOC_DIA_E80A3A", properties:{kc_id:"65bc60e8-1a27-546b-b6a3-82b6d792c619", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Equal Employment Opportunity Commission (EEOC): diagnostic misconception 1172", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 259, in the textbook's discussion of Equal Employment Opportunity Commission (EEOC). Read what the source actually reports about Equal Employment Opportunity Commission (EEOC), then apply the definition of marginalized consumers: populations of consumers that have been pushed to the margins of society and are often excluded in mainstream advertising", status:"approved", flawed_rule:"The example involving Equal Employment Opportunity Commission (EEOC) is interpreted using this faulty rule about marginalized consumers: Being overlooked by mainstream advertising means having no relevant customer needs."}}, {misconception_id:"MISC_EQUAL_JUSTICE_INITIATIVE_EJI_DIAGNOSTIC_MISCONCE_9E8386", properties:{kc_id:"6a2ff558-a79e-55de-ae37-70c5d14e38d1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Equal Justice Initiative (EJI): diagnostic misconception 1173", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of Equal Justice Initiative (EJI). Read what the source actually reports about Equal Justice Initiative (EJI), then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving Equal Justice Initiative (EJI) is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_ESPN_DIAGNOSTIC_MISCONCEPTION_1174_CD3530", properties:{kc_id:"88fdd8a3-f903-5faa-9270-18eea0a03b5b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"ESPN: diagnostic misconception 1174", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 12, in the textbook's discussion of ESPN. Read what the source actually reports about ESPN, then apply the definition of marketing strategy: a plan of action designed to promote or sell a product or service", status:"approved", flawed_rule:"The example involving ESPN is interpreted using this faulty rule about marketing strategy: A list of advertisements is a complete marketing strategy."}}, {misconception_id:"MISC_ETHOS_DIAGNOSTIC_MISCONCEPTION_1175_5E4308", properties:{kc_id:"f95c51bd-a34e-5413-946b-55c9016378da", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ethos: diagnostic misconception 1175", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 326, in the textbook's discussion of Ethos. Read what the source actually reports about Ethos, then apply the definition of new brands: an entirely different brand entity from a parent company", status:"approved", flawed_rule:"The example involving Ethos is interpreted using this faulty rule about new brands: A new brand is merely a new package size under the same existing name."}}, {misconception_id:"MISC_ETSY_DIAGNOSTIC_MISCONCEPTION_1176_7A42BB", properties:{kc_id:"95da69da-0eca-55f8-b8fc-60bbab704a43", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Etsy: diagnostic misconception 1176", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 228, in the textbook's discussion of Etsy. Read what the source actually reports about Etsy, then apply the definition of consumer income: the amount of money a household or individual earns", status:"approved", flawed_rule:"The example involving Etsy is interpreted using this faulty rule about consumer income: Reported income alone shows what consumers can afford after taxes and necessities."}}, {misconception_id:"MISC_EYEBUYDIRECT_DIAGNOSTIC_MISCONCEPTION_1177_88F59A", properties:{kc_id:"c66e59f2-5a62-56c8-a451-ee0d71b838eb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Eyebuydirect: diagnostic misconception 1177", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 381, in the textbook's discussion of Eyebuydirect. Read what the source actually reports about Eyebuydirect, then apply the definition of service encounter: a consumer’s direct contact with a service provider", status:"approved", flawed_rule:"The example involving Eyebuydirect is interpreted using this faulty rule about service encounter: The service encounter is only advertising, with no direct customer-provider contact."}}, {misconception_id:"MISC_FACEBOOK_DIAGNOSTIC_MISCONCEPTION_1178_2C42AC", properties:{kc_id:"c16112a1-57d8-538f-9ef8-27e02ba7e75e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Facebook: diagnostic misconception 1178", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 62, in the textbook's discussion of Facebook. Read what the source actually reports about Facebook, then apply the definition of market development strategy: a growth strategy that identifies and develops new market segments for current products", status:"approved", flawed_rule:"The example involving Facebook is interpreted using this faulty rule about market development strategy: Selling new products to existing customers is market development."}}, {misconception_id:"MISC_FAMILY_DOLLAR_DIAGNOSTIC_MISCONCEPTION_1179_3DC3B1", properties:{kc_id:"60afd5c4-3800-5447-859d-afe9ee07fda7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Family Dollar: diagnostic misconception 1179", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of Family Dollar. Read what the source actually reports about Family Dollar, then apply the definition of discount store: retailer that sells a broad range of products at lower prices than competitors", status:"approved", flawed_rule:"The example involving Family Dollar is interpreted using this faulty rule about discount store: Every low-price retailer uses the same product sourcing and assortment model."}}, {misconception_id:"MISC_FANATICS_DIAGNOSTIC_MISCONCEPTION_1180_FEC715", properties:{kc_id:"79e35080-a3ab-57dc-8c2b-855710a5222a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fanatics: diagnostic misconception 1180", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 563, in the textbook's discussion of Fanatics. Read what the source actually reports about Fanatics, then apply the definition of paid search: a type of digital advertising where marketers pay search engines like Google and Bing to place their ads in sponsored spots at the top or bottom of a search results page", status:"approved", flawed_rule:"The example involving Fanatics is interpreted using this faulty rule about paid search: Paying for a search advertisement guarantees the highest organic ranking."}}, {misconception_id:"MISC_FARMER_DIRECT_ORGANIC_DIAGNOSTIC_MISCONCEPTION_1_467108", properties:{kc_id:"37916c38-320c-5c3e-8e0c-920929e3e433", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Farmer Direct Organic: diagnostic misconception 1181", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of Farmer Direct Organic. Read what the source actually reports about Farmer Direct Organic, then apply the definition of direct marketing: method of promotion that directly connects with the customer and generally requires a response or transaction", status:"approved", flawed_rule:"The example involving Farmer Direct Organic is interpreted using this faulty rule about direct marketing: Direct marketing cannot use television or print."}}, {misconception_id:"MISC_FEDERAL_COMMUNICATIONS_COMMISSION_FCC_DIAGNOSTIC_99A85F", properties:{kc_id:"f0ef3797-73d3-508f-9153-9d7fdd74b303", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Federal Communications Commission (FCC): diagnostic misconception 1182", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 464, in the textbook's discussion of Federal Communications Commission (FCC). Read what the source actually reports about Federal Communications Commission (FCC), then apply the definition of communication channel: delivery mechanism that takes the message from the company to the consumer", status:"approved", flawed_rule:"The example involving Federal Communications Commission (FCC) is interpreted using this faulty rule about communication channel: A communication channel is the audience's interpretation of the message."}}, {misconception_id:"MISC_FEDERAL_FOOD_DRUG_AND_COSMETIC_ACT_FFDCA_DIAGNOS_9699D0", properties:{kc_id:"1659d90e-fe12-5288-90f6-243ba8aa8fed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Federal Food, Drug, and Cosmetic Act (FFDCA): diagnostic misconception 1183", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 495, in the textbook's discussion of Federal Food, Drug, and Cosmetic Act (FFDCA). Read what the source actually reports about Federal Food, Drug, and Cosmetic Act (FFDCA), then apply the definition of reminder advertising: advertising aimed at bringing a product back into the forefront of the consumer’s mind", status:"approved", flawed_rule:"The example involving Federal Food, Drug, and Cosmetic Act (FFDCA) is interpreted using this faulty rule about reminder advertising: Reminder advertising primarily explains an entirely unfamiliar new category."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_FEDERAL_TRADE_COMMISSION_FTC_DIAGNOSTIC_MISCONCE_FD55E7", properties:{kc_id:"6c9b38d6-89c1-5338-8d82-3e3bce924839", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Federal Trade Commission (FTC): diagnostic misconception 1184", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 146, in the textbook's discussion of Federal Trade Commission (FTC). Separate the specific account of Federal Trade Commission (FTC) on printed page 146 from a universal claim. The source passage is: Price fixing—an agreement among competitors (either written, verbal, or inferred from the parties’ conduct) that affects prices or competitive terms—is prohibited by the Federal Trade Commission (FTC).20 Keep in mind that, despite the term, price fixing isn’t confined to an agreement to set the same price. Companies can also be involved in price fixing if they offer or withhold the same discounts or shipping terms or set a production amount or quota.", status:"approved", flawed_rule:"The mention of Federal Trade Commission (FTC) in ethical issues in b2b marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_FEEDING_AMERICA_DIAGNOSTIC_MISCONCEPTION_1185_0AB68E", properties:{kc_id:"d5755e23-e765-5630-96ec-255afd4d8350", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Feeding America: diagnostic misconception 1185", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of Feeding America. Read what the source actually reports about Feeding America, then apply the definition of advertising: a paid form of nonpersonal communication about a product, service, or idea", status:"approved", flawed_rule:"The example involving Feeding America is interpreted using this faulty rule about advertising: Every favorable media mention is paid advertising."}}, {misconception_id:"MISC_FENTY_DIAGNOSTIC_MISCONCEPTION_1186_7E2499", properties:{kc_id:"defa8ef0-adee-50e4-b304-3e67c94cb733", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fenty: diagnostic misconception 1186", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 99, in the textbook's discussion of Fenty. Read what the source actually reports about Fenty, then apply the definition of buyer’s black box: a model used in the study of the buying behavior of consumers", status:"approved", flawed_rule:"The example involving Fenty is interpreted using this faulty rule about buyer’s black box: Identical marketing stimuli produce identical decisions in all consumers."}}, {misconception_id:"MISC_FENTY_BEAUTY_DIAGNOSTIC_MISCONCEPTION_1187_6220BF", properties:{kc_id:"4091b58a-4cc3-5bb6-97a3-495d86f9e9d8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fenty Beauty: diagnostic misconception 1187", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 266, in the textbook's discussion of Fenty Beauty. Read what the source actually reports about Fenty Beauty, then apply the definition of company centric: a company’s approach to focusing decisions and execution from the perspective of the organization rather than the customers", status:"approved", flawed_rule:"The example involving Fenty Beauty is interpreted using this faulty rule about company centric: A company-centric decision is necessarily based on direct evidence of customer needs."}}, {misconception_id:"MISC_FIAT_DIAGNOSTIC_MISCONCEPTION_1188_FAEE18", properties:{kc_id:"f4c63618-cce2-5f1e-8d41-89e7cd26948a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fiat: diagnostic misconception 1188", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 473, in the textbook's discussion of Fiat. Read what the source actually reports about Fiat, then apply the definition of pull strategy: advertising strategy intended to bring audiences to the product", status:"approved", flawed_rule:"The example involving Fiat is interpreted using this faulty rule about pull strategy: A pull strategy concentrates exclusively on persuading channel intermediaries to stock the product."}}, {misconception_id:"MISC_FIELDSTONE_BAKERY_DIAGNOSTIC_MISCONCEPTION_1189_AF7B01", properties:{kc_id:"12913e26-269f-5613-9a55-2cf5773cccc8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fieldstone Bakery: diagnostic misconception 1189", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 470, in the textbook's discussion of Fieldstone Bakery. Separate the specific account of Fieldstone Bakery on printed page 470 from a universal claim. The source passage is: Among the company’s brands are Little Debbie, Sunbelt Bakery, Drake’s Cakes, and Fieldstone Bakery. The largest brand is Little Debbie, with a wide range of favorites from Apple Fruit Pies to Zebra Cakes. Little Debbie offers seasonal items in rotation, such as Christmas Tree Cakes. Distribution extends to all 50 states, Mexico, and Canada.", status:"approved", flawed_rule:"The mention of Fieldstone Bakery in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_FINGERHUT_DIAGNOSTIC_MISCONCEPTION_1190_366A02", properties:{kc_id:"506540d2-8711-5c94-be45-ef5f3c6c291b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fingerhut: diagnostic misconception 1190", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of Fingerhut. Read what the source actually reports about Fingerhut, then apply the definition of direct mail: solicited or unsolicited advertising of products and services to prospective customers through the mail", status:"approved", flawed_rule:"The example involving Fingerhut is interpreted using this faulty rule about direct mail: Direct mail requires customers to visit a retail store to receive the message."}}, {misconception_id:"MISC_FINN_PARTNERS_DIAGNOSTIC_MISCONCEPTION_1191_5305EC", properties:{kc_id:"79dd2bdb-6a1d-54c8-a98f-5b8e64f5fb76", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"FINN Partners: diagnostic misconception 1191", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 139, in the textbook's discussion of FINN Partners. Read what the source actually reports about FINN Partners, then apply the definition of buying center: groups of people within organizations who make purchasing decisions", status:"approved", flawed_rule:"The example involving FINN Partners is interpreted using this faulty rule about buying center: A buying center is a physical procurement office with a single decision maker."}}, {misconception_id:"MISC_FOOD_AND_DRUG_ADMINISTRATION_FDA_DIAGNOSTIC_MISC_9B7CC1", properties:{kc_id:"a2321934-1e17-5af1-ab76-08fdf2abc5e0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Food and Drug Administration (FDA): diagnostic misconception 1192", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 464, in the textbook's discussion of Food and Drug Administration (FDA). Read what the source actually reports about Food and Drug Administration (FDA), then apply the definition of communication channel: delivery mechanism that takes the message from the company to the consumer", status:"approved", flawed_rule:"The example involving Food and Drug Administration (FDA) is interpreted using this faulty rule about communication channel: A communication channel is the audience's interpretation of the message."}}, {misconception_id:"MISC_FOOT_LOCKER_DIAGNOSTIC_MISCONCEPTION_1193_B5D04C", properties:{kc_id:"cdbcb853-e5c2-5418-b739-acc63bf5a5d0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Foot Locker: diagnostic misconception 1193", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 586, in the textbook's discussion of Foot Locker. Read what the source actually reports about Foot Locker, then apply the definition of multichannel distribution system: where a single company sets up multiple distribution channels to reach customers", status:"approved", flawed_rule:"The example involving Foot Locker is interpreted using this faulty rule about multichannel distribution system: Operating multiple channels automatically creates a seamless integrated customer experience."}}, {misconception_id:"MISC_FORD_DIAGNOSTIC_MISCONCEPTION_1194_B44E13", properties:{kc_id:"a81226ea-7da8-5904-8bc8-74feb703684c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ford: diagnostic misconception 1194", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 81, in the textbook's discussion of Ford. Read what the source actually reports about Ford, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving Ford is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_FORD_MOTOR_COMPANY_DIAGNOSTIC_MISCONCEPTION_1195_A03BD3", properties:{kc_id:"db96e6d6-7e3b-5838-96de-7c3377f61204", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ford Motor Company: diagnostic misconception 1195", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 261, in the textbook's discussion of Ford Motor Company. Read what the source actually reports about Ford Motor Company, then apply the definition of company centric: a company’s approach to focusing decisions and execution from the perspective of the organization rather than the customers", status:"approved", flawed_rule:"The example involving Ford Motor Company is interpreted using this faulty rule about company centric: A company-centric decision is necessarily based on direct evidence of customer needs."}}, {misconception_id:"MISC_FORTUNE_DIAGNOSTIC_MISCONCEPTION_1196_3F6079", properties:{kc_id:"ebf9820a-cf5d-5357-9150-af8761c502a8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fortune: diagnostic misconception 1196", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 654, in the textbook's discussion of Fortune. Read what the source actually reports about Fortune, then apply the definition of economic pillar (governance pillar): the sustainability pillar that concerns profitability and business ethics", status:"approved", flawed_rule:"The example involving Fortune is interpreted using this faulty rule about economic pillar (governance pillar): Sustainability requires ignoring business viability and ethical governance."}}, {misconception_id:"MISC_FRITO_LAY_DIAGNOSTIC_MISCONCEPTION_1197_E44E5C", properties:{kc_id:"2b5c8679-904f-5f8b-b6fd-c223a6a011ec", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Frito-Lay: diagnostic misconception 1197", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 47, in the textbook's discussion of Frito-Lay. Read what the source actually reports about Frito-Lay, then apply the definition of strategic business unit: a relatively autonomous division of a large company that operates as an independent enterprise with responsibility for a particular range of products or activities", status:"approved", flawed_rule:"The example involving Frito-Lay is interpreted using this faulty rule about strategic business unit: Every internal department is an independent strategic business unit."}}, {misconception_id:"MISC_FUJITSU_DIAGNOSTIC_MISCONCEPTION_1198_2D53CD", properties:{kc_id:"68061d54-6da6-58c1-afca-deff47d74910", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Fujitsu: diagnostic misconception 1198", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 50, in the textbook's discussion of Fujitsu. Separate the specific account of Fujitsu on printed page 50 from a universal claim. The source passage is: • Volkswagen: “To make this world a mobile, sustainable place with access to all the citizens”7 • Fujitsu: “Understanding you better—serving you best”8", status:"approved", flawed_rule:"The mention of Fujitsu in developing a strategic plan establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_GALLUP_ORGANIZATION_DIAGNOSTIC_MISCONCEPTION_119_C4CABB", properties:{kc_id:"2b83d2e6-280d-5fc1-9635-88583cac6fe2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gallup Organization: diagnostic misconception 1199", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 218, in the textbook's discussion of Gallup Organization. Read what the source actually reports about Gallup Organization, then apply the definition of exploratory research: research conducted that is more general to learn more about the industry or market", status:"approved", flawed_rule:"The example involving Gallup Organization is interpreted using this faulty rule about exploratory research: Exploratory findings alone provide definitive population estimates."}}, {misconception_id:"MISC_GAMESTOP_DIAGNOSTIC_MISCONCEPTION_1200_063CB7", properties:{kc_id:"1c7d2764-e56a-5f30-85ea-9836354b833e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"GameStop: diagnostic misconception 1200", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 479, in the textbook's discussion of GameStop. Read what the source actually reports about GameStop, then apply the definition of pull strategy: advertising strategy intended to bring audiences to the product", status:"approved", flawed_rule:"The example involving GameStop is interpreted using this faulty rule about pull strategy: A pull strategy concentrates exclusively on persuading channel intermediaries to stock the product."}}, {misconception_id:"MISC_GAP_DIAGNOSTIC_MISCONCEPTION_1201_AF82D8", properties:{kc_id:"d1eb9819-57af-5c2b-a244-f7589090c24b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gap: diagnostic misconception 1201", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 327, in the textbook's discussion of Gap. Read what the source actually reports about Gap, then apply the definition of split loyals: customers who have a consideration set of two or three products or services in a category", status:"approved", flawed_rule:"The example involving Gap is interpreted using this faulty rule about split loyals: Split loyals buy only one brand over the entire period."}}, {misconception_id:"MISC_GARTNER_DIAGNOSTIC_MISCONCEPTION_1202_88A8CF", properties:{kc_id:"4c7d6cda-5e05-51da-9be9-a36660fdde2f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gartner: diagnostic misconception 1202", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 445, in the textbook's discussion of Gartner. Read what the source actually reports about Gartner, then apply the definition of sales promotion: promotion that creates an incentive to purchase; provides for a fairly immediate increase in sales in the short term", status:"approved", flawed_rule:"The example involving Gartner is interpreted using this faulty rule about sales promotion: A temporary incentive necessarily creates durable brand loyalty."}}, {misconception_id:"MISC_GATORADE_DIAGNOSTIC_MISCONCEPTION_1203_003AB9", properties:{kc_id:"5f536fae-7ca8-5e50-baba-810c071b2947", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gatorade: diagnostic misconception 1203", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 11, in the textbook's discussion of Gatorade. Read what the source actually reports about Gatorade, then apply the definition of product concept: the orientation that consumers will favor those products that offer the most quality, performance, or innovative features", status:"approved", flawed_rule:"The example involving Gatorade is interpreted using this faulty rule about product concept: The product concept is the same as researching and prioritizing customer needs."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_GATORADE_SPORTS_SCIENCE_INSTITUTE_DIAGNOSTIC_MIS_A24CD6", properties:{kc_id:"a10dcdd7-f246-540f-a273-72da57f53572", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gatorade Sports Science Institute: diagnostic misconception 1204", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 11, in the textbook's discussion of Gatorade Sports Science Institute. Read what the source actually reports about Gatorade Sports Science Institute, then apply the definition of product concept: the orientation that consumers will favor those products that offer the most quality, performance, or innovative features", status:"approved", flawed_rule:"The example involving Gatorade Sports Science Institute is interpreted using this faulty rule about product concept: The product concept is the same as researching and prioritizing customer needs."}}, {misconception_id:"MISC_GAZELLE_BIKES_DIAGNOSTIC_MISCONCEPTION_1205_171FE0", properties:{kc_id:"033c6e31-3bbd-58d6-86c3-016ff5457aa9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gazelle Bikes: diagnostic misconception 1205", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 413, in the textbook's discussion of Gazelle Bikes. Read what the source actually reports about Gazelle Bikes, then apply the definition of product line pricing: setting a higher price for some product lines and lower price points for others in order to capture various target markets", status:"approved", flawed_rule:"The example involving Gazelle Bikes is interpreted using this faulty rule about product line pricing: All models in a product range should have identical prices regardless of benefits."}}, {misconception_id:"MISC_GEICO_DIAGNOSTIC_MISCONCEPTION_1206_002FB1", properties:{kc_id:"2f80d1d3-4d68-5f36-923c-5c09dc18aa6b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Geico: diagnostic misconception 1206", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 577, in the textbook's discussion of Geico. Read what the source actually reports about Geico, then apply the definition of facilitating functions: activities such as financing and information sharing in the marketing channel", status:"approved", flawed_rule:"The example involving Geico is interpreted using this faulty rule about facilitating functions: Channel financing and information sharing have no distribution value."}}, {misconception_id:"MISC_GENENTECH_DIAGNOSTIC_MISCONCEPTION_1207_F806F8", properties:{kc_id:"51ee7fbc-857b-5ab3-bd67-711fc58d7fd3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Genentech: diagnostic misconception 1207", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 50, in the textbook's discussion of Genentech. Read what the source actually reports about Genentech, then apply the definition of customer lifetime value (CLV): an estimate of how much a single customer is worth to a company over their customer life span", status:"approved", flawed_rule:"The example involving Genentech is interpreted using this faulty rule about customer lifetime value (CLV): Customer lifetime value is identical to the customer's first purchase revenue."}}, {misconception_id:"MISC_GENERAL_ELECTRIC_DIAGNOSTIC_MISCONCEPTION_1208_FCB989", properties:{kc_id:"0d6ae7fc-5879-5734-96fb-c8434cc55a5d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"General Electric: diagnostic misconception 1208", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 55, in the textbook's discussion of General Electric. Read what the source actually reports about General Electric, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving General Electric is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_GENERATION_ALPHA_DIAGNOSTIC_MISCONCEPTION_1209_E40DBD", properties:{kc_id:"d28b42fe-2fc7-5388-955d-f09e2624a46d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Generation Alpha: diagnostic misconception 1209", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 289, in the textbook's discussion of Generation Alpha. Read what the source actually reports about Generation Alpha, then apply the definition of generational population: sociodemographic category based on birth year clusters that includes Lost Generation (1883–1900), Greatest Generation (1901–1927), Traditionalist/Silent Generation (1928–1945), baby boomers (1946–1964), Generation X (1965–1980), millennials/Generation Y (1981–1996), Zoomers/ Generation Z (1997–2009), and Generation Alpha (2010–2024)", status:"approved", flawed_rule:"The example involving Generation Alpha is interpreted using this faulty rule about generational population: Birth-year cohorts determine every individual's attitudes and buying behavior."}}, {misconception_id:"MISC_GENERATION_X_DIAGNOSTIC_MISCONCEPTION_1210_E13DFB", properties:{kc_id:"c722e2ba-d470-5ae0-be95-30649d1ebded", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Generation X: diagnostic misconception 1210", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 102, in the textbook's discussion of Generation X. Read what the source actually reports about Generation X, then apply the definition of consumer market: a market where consumers purchase products and/or services for consumption", status:"approved", flawed_rule:"The example involving Generation X is interpreted using this faulty rule about consumer market: Purchases for industrial production belong to the consumer market."}}, {misconception_id:"MISC_GENERATION_Y_DIAGNOSTIC_MISCONCEPTION_1211_3B568A", properties:{kc_id:"9e3cd342-9264-5825-9c45-8670012fba69", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Generation Y: diagnostic misconception 1211", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 102, in the textbook's discussion of Generation Y. Read what the source actually reports about Generation Y, then apply the definition of consumer market: a market where consumers purchase products and/or services for consumption", status:"approved", flawed_rule:"The example involving Generation Y is interpreted using this faulty rule about consumer market: Purchases for industrial production belong to the consumer market."}}, {misconception_id:"MISC_GENERATION_Z_DIAGNOSTIC_MISCONCEPTION_1212_73360D", properties:{kc_id:"8974cef4-0da0-5378-81b6-1c38bf526e9e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Generation Z: diagnostic misconception 1212", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 102, in the textbook's discussion of Generation Z. Read what the source actually reports about Generation Z, then apply the definition of consumer market: a market where consumers purchase products and/or services for consumption", status:"approved", flawed_rule:"The example involving Generation Z is interpreted using this faulty rule about consumer market: Purchases for industrial production belong to the consumer market."}}, {misconception_id:"MISC_GEXPRO_DIAGNOSTIC_MISCONCEPTION_1213_BE3125", properties:{kc_id:"d7cc9fd6-997a-5e9c-8b88-d528c20ae451", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gexpro: diagnostic misconception 1213", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 25, in the textbook's discussion of Gexpro. Read what the source actually reports about Gexpro, then apply the definition of suppliers: sometimes also called vendors, these are partners from whom we receive the parts and products necessary for our business", status:"approved", flawed_rule:"The example involving Gexpro is interpreted using this faulty rule about suppliers: Suppliers influence production but cannot affect the firm's marketing promises."}}, {misconception_id:"MISC_GHIRARDELLI_DIAGNOSTIC_MISCONCEPTION_1214_106717", properties:{kc_id:"9f9abd16-3246-5fc7-9de5-189b2b8d90aa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ghirardelli: diagnostic misconception 1214", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of Ghirardelli. Separate the specific account of Ghirardelli on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of Ghirardelli in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_GIANT_DIAGNOSTIC_MISCONCEPTION_1215_E9236D", properties:{kc_id:"1e5f78d9-edeb-51b5-a3af-ace064cea6d8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Giant: diagnostic misconception 1215", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 413, in the textbook's discussion of Giant. Read what the source actually reports about Giant, then apply the definition of product line pricing: setting a higher price for some product lines and lower price points for others in order to capture various target markets", status:"approved", flawed_rule:"The example involving Giant is interpreted using this faulty rule about product line pricing: All models in a product range should have identical prices regardless of benefits."}}, {misconception_id:"MISC_GILLETTE_DIAGNOSTIC_MISCONCEPTION_1216_C20816", properties:{kc_id:"f9c95e5a-53db-579f-b33a-a9d92d591e92", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gillette: diagnostic misconception 1216", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 351, in the textbook's discussion of Gillette. Read what the source actually reports about Gillette, then apply the definition of prototype: in new product development, the creation of a physical version of the product", status:"approved", flawed_rule:"The example involving Gillette is interpreted using this faulty rule about prototype: A prototype must be identical to the final mass-produced version."}}, {misconception_id:"MISC_GIRL_SCOUTS_OF_THE_USA_DIAGNOSTIC_MISCONCEPTION__D2527C", properties:{kc_id:"64511396-b5bd-5147-9727-3ce55e3f9d0a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Girl Scouts of the USA: diagnostic misconception 1217", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 544, in the textbook's discussion of Girl Scouts of the USA. Read what the source actually reports about Girl Scouts of the USA, then apply the definition of email marketing: a type of direct marketing that is highly personal and designed to build relationships with consumers", status:"approved", flawed_rule:"The example involving Girl Scouts of the USA is interpreted using this faulty rule about email marketing: Sending the same unsolicited message to everyone builds strong relationships."}}, {misconception_id:"MISC_GLASSDOOR_DIAGNOSTIC_MISCONCEPTION_1218_768A67", properties:{kc_id:"d57ae29d-d2c9-5e8d-bc8a-4377c31469c6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Glassdoor: diagnostic misconception 1218", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 549, in the textbook's discussion of Glassdoor. Read what the source actually reports about Glassdoor, then apply the definition of online video marketing: involves creating videos that tell a story about a product, company, or brand that is designed to drive consumer engagement through activities such as liking, sharing, and retweeting", status:"approved", flawed_rule:"The example involving Glassdoor is interpreted using this faulty rule about online video marketing: A high view count alone establishes profitable customer engagement."}}, {misconception_id:"MISC_GLOBAL_CONTAINERS_AND_CUSTOM_PACKAGING_DIAGNOSTI_B793CD", properties:{kc_id:"4b8bcfe6-58ef-58dd-b74e-04c45ce21560", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Global Containers and Custom Packaging: diagnostic misconception 1219", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 609, in the textbook's discussion of Global Containers and Custom Packaging. Read what the source actually reports about Global Containers and Custom Packaging, then apply the definition of inventory management: a function that involves identifying the type of inventory and how much a company has on hand at any given time", status:"approved", flawed_rule:"The example involving Global Containers and Custom Packaging is interpreted using this faulty rule about inventory management: Holding the maximum possible inventory always minimizes overall cost."}}, {misconception_id:"MISC_GLOBAL_FLEET_DIAGNOSTIC_MISCONCEPTION_1220_DEBAD4", properties:{kc_id:"c9399991-64bb-5c8c-8ae4-7bdb871a42cd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Global Fleet: diagnostic misconception 1220", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 584, in the textbook's discussion of Global Fleet. Read what the source actually reports about Global Fleet, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving Global Fleet is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_GM_DIAGNOSTIC_MISCONCEPTION_1221_23DBB7", properties:{kc_id:"95f4f386-5e6a-5c6e-afc9-b32cdaefaa1a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"GM: diagnostic misconception 1221", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 179, in the textbook's discussion of GM. Read what the source actually reports about GM, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving GM is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_GODIVA_DIAGNOSTIC_MISCONCEPTION_1222_BC3F6D", properties:{kc_id:"6a504bb9-02df-59cd-b5ce-40d5cbb47e7d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Godiva: diagnostic misconception 1222", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 315, in the textbook's discussion of Godiva. Read what the source actually reports about Godiva, then apply the definition of brand equity: the additional value that a brand has over a substitute", status:"approved", flawed_rule:"The example involving Godiva is interpreted using this faulty rule about brand equity: Brand equity is identical to current sales revenue."}}, {misconception_id:"MISC_GOOGLE_DIAGNOSTIC_MISCONCEPTION_1223_78A7C3", properties:{kc_id:"19cb32e4-f65d-57de-91db-16c747806196", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Google: diagnostic misconception 1223", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 297, in the textbook's discussion of Google. Read what the source actually reports about Google, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving Google is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_GOOGLE_PLAY_STORE_DIAGNOSTIC_MISCONCEPTION_1224_727FBF", properties:{kc_id:"b58becec-6f9e-5ee0-a9d2-3262efc6a1a3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Google Play Store: diagnostic misconception 1224", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 634, in the textbook's discussion of Google Play Store. Read what the source actually reports about Google Play Store, then apply the definition of digital wallets: software-based systems that allow for secure transactions", status:"approved", flawed_rule:"The example involving Google Play Store is interpreted using this faulty rule about digital wallets: A digital wallet is identical to a physical cash drawer and has no transaction-security implications."}}, {misconception_id:"MISC_GOOGLE_TRENDS_DIAGNOSTIC_MISCONCEPTION_1225_80DE15", properties:{kc_id:"e851347c-2cc6-5e10-8d09-961d245b32f2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Google Trends: diagnostic misconception 1225", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 561, in the textbook's discussion of Google Trends. Read what the source actually reports about Google Trends, then apply the definition of search trends: data points that indicate how frequently a term is searched", status:"approved", flawed_rule:"The example involving Google Trends is interpreted using this faulty rule about search trends: More searches for a term necessarily mean more purchases of one brand."}}, {misconception_id:"MISC_GOPRO_DIAGNOSTIC_MISCONCEPTION_1226_742DBC", properties:{kc_id:"0f03da1a-f722-5590-8778-ee0fd15b3bdc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"GoPro: diagnostic misconception 1226", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 307, in the textbook's discussion of GoPro. Read what the source actually reports about GoPro, then apply the definition of product mix: all the products a company sells", status:"approved", flawed_rule:"The example involving GoPro is interpreted using this faulty rule about product mix: The product mix refers only to promotional tactics."}}, {misconception_id:"MISC_GOTOMEETING_DIAGNOSTIC_MISCONCEPTION_1227_2ADA5E", properties:{kc_id:"032eb53d-20d2-55fd-942e-5209be0a389c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"GoToMeeting: diagnostic misconception 1227", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 416, in the textbook's discussion of GoToMeeting. Read what the source actually reports about GoToMeeting, then apply the definition of customer value–based objective: product pricing based on a company’s understanding of the value-added benefits of a product", status:"approved", flawed_rule:"The example involving GoToMeeting is interpreted using this faulty rule about customer value–based objective: Customer value-based pricing must start from production cost alone."}}, {misconception_id:"MISC_GQ_DIAGNOSTIC_MISCONCEPTION_1228_FF45CB", properties:{kc_id:"3e77c827-d019-58dc-8e56-4da4a3122eeb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"GQ: diagnostic misconception 1228", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 158, in the textbook's discussion of GQ. Read what the source actually reports about GQ, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving GQ is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_GRASSROOT_GOOD_DIAGNOSTIC_MISCONCEPTION_1229_AB45F6", properties:{kc_id:"2fdbbdc5-e55d-5d68-8ee6-440019a2e0a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Grassroot Good: diagnostic misconception 1229", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Grassroot Good. Read what the source actually reports about Grassroot Good, then apply the definition of buy one get one (BOGO): promotion strategy in which consumers are offered the opportunity to buy one product at regular price and get a second item free", status:"approved", flawed_rule:"The example involving Grassroot Good is interpreted using this faulty rule about buy one get one (BOGO): A BOGO offer necessarily generates profit regardless of product cost and cannibalization."}}, {misconception_id:"MISC_GS1_GLOBAL_TRACEABILITY_STANDARD_DIAGNOSTIC_MISC_298697", properties:{kc_id:"13c80340-2faa-5582-b477-f7bab96806d6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"GS1 Global Traceability Standard: diagnostic misconception 1230", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 640, in the textbook's discussion of GS1 Global Traceability Standard. Read what the source actually reports about GS1 Global Traceability Standard, then apply the definition of product traceability: the ability to track all processes for a product from the procurement of raw materials to production, consumption, and disposal", status:"approved", flawed_rule:"The example involving GS1 Global Traceability Standard is interpreted using this faulty rule about product traceability: Traceability begins only when the finished item reaches the retailer."}}, {misconception_id:"MISC_GUCCI_DIAGNOSTIC_MISCONCEPTION_1231_07F618", properties:{kc_id:"98d7723b-6346-5400-a48a-aa87338dc0e5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Gucci: diagnostic misconception 1231", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 230, in the textbook's discussion of Gucci. Separate the specific account of Gucci on printed page 230 from a universal claim. The source passage is: Two examples of companies not readily prepared come from Nivea and Gucci. In 2017, Nivea launched a social media campaigned stating “White Is Purity.” The phrase was perceived by the public as being racially insensitive. To make matters worse, the slogan was then used by white supremacists in their propaganda.17 While the company apologized and removed the campaign, these marketers should never have let the campaign leave the idea room. In 2019, luxury fashion designer Gucci introduced a balaclava knit jumper that had material that went up and around the mouth. The advertisement for this clothing featured a White woman modeling the sweater with bright red lipstick. Many critics…", status:"approved", flawed_rule:"The mention of Gucci in the global market and advantages of international trade establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_GWI_DIAGNOSTIC_MISCONCEPTION_1232_5AA25D", properties:{kc_id:"a359c806-cdb4-5897-a75f-1228f7f56c0e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"GWI: diagnostic misconception 1232", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 114, in the textbook's discussion of GWI. Read what the source actually reports about GWI, then apply the definition of consumer decision process: the process through which consumers become aware of and identify their needs, collect information on how to best solve those needs, evaluate alternative options, make a purchasing decision, and evaluate their purchase", status:"approved", flawed_rule:"The example involving GWI is interpreted using this faulty rule about consumer decision process: All purchases require equal effort in every decision stage."}}, {misconception_id:"MISC_HALLMARK_DIAGNOSTIC_MISCONCEPTION_1233_AE72F7", properties:{kc_id:"25961016-b4ee-516e-83a4-9520bb0a2257", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hallmark: diagnostic misconception 1233", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 577, in the textbook's discussion of Hallmark. Read what the source actually reports about Hallmark, then apply the definition of channel member (intermediary): a company that works in a network with other companies to help gets products from manufacturers to final consumers", status:"approved", flawed_rule:"The example involving Hallmark is interpreted using this faulty rule about channel member (intermediary): Intermediaries merely add cost and perform no useful customer functions."}}, {misconception_id:"MISC_HANES_OUTLET_DIAGNOSTIC_MISCONCEPTION_1234_F0E2F0", properties:{kc_id:"d692d0de-ac87-53a6-85e1-9713c468b09e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hanes Outlet: diagnostic misconception 1234", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of Hanes Outlet. Read what the source actually reports about Hanes Outlet, then apply the definition of factory outlets: retailers that offer overstocked merchandise at discounted prices", status:"approved", flawed_rule:"The example involving Hanes Outlet is interpreted using this faulty rule about factory outlets: Factory outlets and full-price flagship stores use identical inventory and pricing models."}}, {misconception_id:"MISC_HARAPPA_EDUCATION_DIAGNOSTIC_MISCONCEPTION_1235_B7FD1D", properties:{kc_id:"dfdd78b2-8a78-5ac1-a55f-c8650884cd3b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Harappa Education: diagnostic misconception 1235", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 555, in the textbook's discussion of Harappa Education. Read what the source actually reports about Harappa Education, then apply the definition of content marketing: creating and distributing online content that is valuable and relevant to a company’s target customers", status:"approved", flawed_rule:"The example involving Harappa Education is interpreted using this faulty rule about content marketing: Content marketing is simply an uninterrupted sequence of product advertisements."}}, {misconception_id:"MISC_HARLEY_DAVIDSON_DIAGNOSTIC_MISCONCEPTION_1236_6571B9", properties:{kc_id:"4614f54d-c52f-5dec-b31c-cc8c0652418d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Harley-Davidson: diagnostic misconception 1236", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 62, in the textbook's discussion of Harley-Davidson. Read what the source actually reports about Harley-Davidson, then apply the definition of market development strategy: a growth strategy that identifies and develops new market segments for current products", status:"approved", flawed_rule:"The example involving Harley-Davidson is interpreted using this faulty rule about market development strategy: Selling new products to existing customers is market development."}}, {misconception_id:"MISC_HARLOW_DIAGNOSTIC_MISCONCEPTION_1237_1B66CA", properties:{kc_id:"14dd4fe4-ff0a-585f-834b-4f32edeec58d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Harlow: diagnostic misconception 1237", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Harlow. Separate the specific account of Harlow on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Harlow in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_HARPER_COLLINS_DIAGNOSTIC_MISCONCEPTION_1238_6C328B", properties:{kc_id:"84dd7da7-e04e-5448-9902-b5b4927245f6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Harper Collins: diagnostic misconception 1238", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 62, in the textbook's discussion of Harper Collins. Read what the source actually reports about Harper Collins, then apply the definition of concentric diversification: the addition of similar products or services to an existing business", status:"approved", flawed_rule:"The example involving Harper Collins is interpreted using this faulty rule about concentric diversification: Adding unrelated products is concentric diversification."}}, {misconception_id:"MISC_HARVARD_BUSINESS_REVIEW_DIAGNOSTIC_MISCONCEPTION_9E3DB5", properties:{kc_id:"1ef73c8e-7eab-5351-9280-e031852a56fc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Harvard Business Review: diagnostic misconception 1239", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 541, in the textbook's discussion of Harvard Business Review. Read what the source actually reports about Harvard Business Review, then apply the definition of catalog marketing: also known as direct mail order and is one of the oldest forms of promotion, which typically includes a variety of products often vividly displayed in a high-gloss magazine-like format", status:"approved", flawed_rule:"The example involving Harvard Business Review is interpreted using this faulty rule about catalog marketing: Catalog marketing cannot coexist with online ordering."}}, {misconception_id:"MISC_HBO_DIAGNOSTIC_MISCONCEPTION_1240_356279", properties:{kc_id:"3232c6a0-79c3-5fef-ac4b-e73bbe0c0f2d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"HBO: diagnostic misconception 1240", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 501, in the textbook's discussion of HBO. Read what the source actually reports about HBO, then apply the definition of all-you-can-afford approach: advertising budget approach that ensures everything else in the organization is budgeted for and then sets aside the remaining funds for advertising", status:"approved", flawed_rule:"The example involving HBO is interpreted using this faulty rule about all-you-can-afford approach: An affordable advertising budget necessarily matches the resources needed to reach campaign objectives."}}, {misconception_id:"MISC_HBOMAX_DIAGNOSTIC_MISCONCEPTION_1241_D215D8", properties:{kc_id:"c9b715ea-0a82-5186-a2a6-680685434906", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"HBOMax: diagnostic misconception 1241", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 576, in the textbook's discussion of HBOMax. Read what the source actually reports about HBOMax, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving HBOMax is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_HEAT_DIAGNOSTIC_MISCONCEPTION_1242_6FF595", properties:{kc_id:"3e19f823-44af-56d9-bd5d-e3b76f480388", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Heat: diagnostic misconception 1242", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 265, in the textbook's discussion of Heat. Read what the source actually reports about Heat, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving Heat is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_HEINZ_DIAGNOSTIC_MISCONCEPTION_1243_5E90E0", properties:{kc_id:"a6f1db29-afcb-58f1-abed-1f738e7bc2ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Heinz: diagnostic misconception 1243", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Heinz. Read what the source actually reports about Heinz, then apply the definition of national brands: name brands that sell a product or service under its corporate name and identity", status:"approved", flawed_rule:"The example involving Heinz is interpreted using this faulty rule about national brands: A national brand is the retailer's own private label."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_HELLMAN_S_DIAGNOSTIC_MISCONCEPTION_1244_33DCA2", properties:{kc_id:"35853df7-8658-5b08-8b5e-727f438fabfe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hellman’s: diagnostic misconception 1244", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 425, in the textbook's discussion of Hellman’s. Read what the source actually reports about Hellman’s, then apply the definition of product line pricing: setting a higher price for some product lines and lower price points for others in order to capture various target markets", status:"approved", flawed_rule:"The example involving Hellman’s is interpreted using this faulty rule about product line pricing: All models in a product range should have identical prices regardless of benefits."}}, {misconception_id:"MISC_HELLOFRESH_DIAGNOSTIC_MISCONCEPTION_1245_177840", properties:{kc_id:"71722f7a-86e7-5666-8ff0-2a72499ee28b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"HelloFresh: diagnostic misconception 1245", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 31, in the textbook's discussion of HelloFresh. Read what the source actually reports about HelloFresh, then apply the definition of time utility: adding value to the consumer by having the product or service available when the consumer needs it", status:"approved", flawed_rule:"The example involving HelloFresh is interpreted using this faulty rule about time utility: A product available after the customer's deadline provides the same time utility."}}, {misconception_id:"MISC_HERTZ_DIAGNOSTIC_MISCONCEPTION_1246_9A76E8", properties:{kc_id:"d7499332-559d-56c1-9cc2-d0e9caa805b8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hertz: diagnostic misconception 1246", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 182, in the textbook's discussion of Hertz. Read what the source actually reports about Hertz, then apply the definition of head-to-head positioning: directly competing with competitors on similar product attributes in the same market", status:"approved", flawed_rule:"The example involving Hertz is interpreted using this faulty rule about head-to-head positioning: Head-to-head positioning avoids comparison on competitors' main attributes."}}, {misconception_id:"MISC_HEWLETT_PACKARD_DIAGNOSTIC_MISCONCEPTION_1247_251BD7", properties:{kc_id:"19145130-a0d4-509f-8391-743d67211249", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hewlett Packard: diagnostic misconception 1247", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 609, in the textbook's discussion of Hewlett Packard. Read what the source actually reports about Hewlett Packard, then apply the definition of multichannel distribution system: where a single company sets up multiple distribution channels to reach customers", status:"approved", flawed_rule:"The example involving Hewlett Packard is interpreted using this faulty rule about multichannel distribution system: Operating multiple channels automatically creates a seamless integrated customer experience."}}, {misconception_id:"MISC_HEWLETT_PACKARD_ENTERPRISE_HPE_DIAGNOSTIC_MISCON_4B1FF2", properties:{kc_id:"740b5dff-5948-5a89-9ed2-dc55882d5f2a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hewlett Packard Enterprise (HPE): diagnostic misconception 1248", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 26, in the textbook's discussion of Hewlett Packard Enterprise (HPE). Read what the source actually reports about Hewlett Packard Enterprise (HPE), then apply the definition of sales concept: orientation that analyzes buying and selling effects to place the focus primarily on generating sales transactions", status:"approved", flawed_rule:"The example involving Hewlett Packard Enterprise (HPE) is interpreted using this faulty rule about sales concept: An aggressive selling orientation automatically produces long-term customer satisfaction."}}, {misconception_id:"MISC_HILFIGER_DIAGNOSTIC_MISCONCEPTION_1249_BB168C", properties:{kc_id:"2eb01930-cc35-58d1-b419-caa0a4a2800b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hilfiger: diagnostic misconception 1249", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Hilfiger. Separate the specific account of Hilfiger on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Hilfiger in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_HILTON_GRAND_VACATIONS_HGV_DIAGNOSTIC_MISCONCEPT_591FB1", properties:{kc_id:"16e06ea3-6090-52c0-81ae-eadb98bf4417", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hilton Grand Vacations (HGV): diagnostic misconception 1250", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 505, in the textbook's discussion of Hilton Grand Vacations (HGV). Read what the source actually reports about Hilton Grand Vacations (HGV), then apply the definition of lead response time: The elapsed time taken by a sales team to respond to a new lead or customer request, as explained in section 15.4. Source inconsistency: the glossary supplies an unrelated analytics definition; this node follows the substantive section.", status:"approved", flawed_rule:"The example involving Hilton Grand Vacations (HGV) is interpreted using this faulty rule about lead response time: Lead response time measures demographic analysis rather than elapsed time to respond."}}, {misconception_id:"MISC_HILTON_HOTELS_AND_RESORTS_DIAGNOSTIC_MISCONCEPTI_3FD1D0", properties:{kc_id:"71b80797-1d5d-52ee-8c53-2a597fcd501c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hilton Hotels and Resorts: diagnostic misconception 1251", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 505, in the textbook's discussion of Hilton Hotels and Resorts. Separate the specific account of Hilton Hotels and Resorts on printed page 505 from a universal claim. The source passage is: In the Spotlight Since 1919, when Conrad Hilton bought his first hotel, Hilton Hotels and Resorts has been providing a good night’s sleep to travelers around the world. With over 6,800 hotels within its portfolio (including several sub- brands), Hilton has a hotel to meet the needs of just about any traveler. Hampton Inn is a beloved brand for road-weary business travelers as well as families. The Conrad is one of the luxury brands for Hilton. And DoubleTree is another favorite brand for business travelers, known for the gooey, warm chocolate chip cookies presented at check-in. To reward travelers, Hilton offers several tiers of Hilton rewards: Silver, Gold, and Diamond. Reward…", status:"approved", flawed_rule:"The mention of Hilton Hotels and Resorts in personal selling and its role in the promotion mix establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_HOFSTEDE_DIAGNOSTIC_MISCONCEPTION_1252_5D09E6", properties:{kc_id:"1f966a59-a249-5f8d-b479-2cbe555592a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hofstede: diagnostic misconception 1252", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 276, in the textbook's discussion of Hofstede. Read what the source actually reports about Hofstede, then apply the definition of cultural identity: how a person identifies with a given culture, ethnicity, or social group, which instills a sense of belonging that influences personal thinking and actions", status:"approved", flawed_rule:"The example involving Hofstede is interpreted using this faulty rule about cultural identity: Marketers can assign cultural identity solely from a person's appearance."}}, {misconception_id:"MISC_HOLIDAY_INN_DIAGNOSTIC_MISCONCEPTION_1253_A3348A", properties:{kc_id:"8c198927-9f66-59f2-b8d4-20d7a18dba4a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Holiday Inn: diagnostic misconception 1253", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 594, in the textbook's discussion of Holiday Inn. Read what the source actually reports about Holiday Inn, then apply the definition of horizontal conflict: when there is disagreement among firms at the same level in the marketing channel", status:"approved", flawed_rule:"The example involving Holiday Inn is interpreted using this faulty rule about horizontal conflict: A disagreement between a manufacturer and its retailer is horizontal conflict."}}, {misconception_id:"MISC_HOLLISTER_DIAGNOSTIC_MISCONCEPTION_1254_441860", properties:{kc_id:"9e7029db-e3fb-5b27-90fa-1cebf269ca14", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hollister: diagnostic misconception 1254", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 109, in the textbook's discussion of Hollister. Separate the specific account of Hollister on printed page 109 from a universal claim. The source passage is: Watch this video on Abercrombie & Fitch’s brand transformation for further insight on how A&F has positioned its retail brand Hollister as a global iconic teen brand and modernized the A&F brand to focus on young millennial consumers.", status:"approved", flawed_rule:"The mention of Hollister in factors that influence consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_HOLMES_DIAGNOSTIC_MISCONCEPTION_1255_0221CD", properties:{kc_id:"d5aabd83-3c73-533e-9787-5b32582afb0e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Holmes: diagnostic misconception 1255", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Holmes. Separate the specific account of Holmes on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Holmes in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_HOME_DEPOT_DIAGNOSTIC_MISCONCEPTION_1256_2CDDAF", properties:{kc_id:"550e5d31-cbc4-53f6-bab1-13e9bdb8ad2d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Home Depot: diagnostic misconception 1256", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 551, in the textbook's discussion of Home Depot. Read what the source actually reports about Home Depot, then apply the definition of social media marketing: using social media platforms, such as Facebook, Instagram, LinkedIn, and Twitter, to deliver content that drives engagement with your brand", status:"approved", flawed_rule:"The example involving Home Depot is interpreted using this faulty rule about social media marketing: A follower count alone establishes campaign effectiveness."}}, {misconception_id:"MISC_HOME_RUN_INN_PIZZA_DIAGNOSTIC_MISCONCEPTION_1257_87D0E7", properties:{kc_id:"2226931a-e4bf-5840-a9ef-03adbcef67b2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Home Run Inn Pizza: diagnostic misconception 1257", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 318, in the textbook's discussion of Home Run Inn Pizza. Read what the source actually reports about Home Run Inn Pizza, then apply the definition of growth stage: part of the product life cycle characterized by increasing sales; stage when copycat brands may enter the market", status:"approved", flawed_rule:"The example involving Home Run Inn Pizza is interpreted using this faulty rule about growth stage: Sales growth guarantees that no new competitors will enter."}}, {misconception_id:"MISC_HOME_SHOPPING_NETWORK_HSN_DIAGNOSTIC_MISCONCEPTI_58FF9A", properties:{kc_id:"6cd19e45-6734-5bb9-aefd-2db028be5045", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Home Shopping Network (HSN): diagnostic misconception 1258", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 624, in the textbook's discussion of Home Shopping Network (HSN). Read what the source actually reports about Home Shopping Network (HSN), then apply the definition of television home shopping: a business practice in which products or services are sold via television", status:"approved", flawed_rule:"The example involving Home Shopping Network (HSN) is interpreted using this faulty rule about television home shopping: Television home shopping requires the consumer to visit the seller's physical shop."}}, {misconception_id:"MISC_HONDA_DIAGNOSTIC_MISCONCEPTION_1259_112F21", properties:{kc_id:"ded193c4-1200-5159-9634-8f3375c00eca", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Honda: diagnostic misconception 1259", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 179, in the textbook's discussion of Honda. Read what the source actually reports about Honda, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Honda is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_HONEYWELL_DIAGNOSTIC_MISCONCEPTION_1260_9A7A47", properties:{kc_id:"13bca9cc-69fd-561b-8306-e0d5b80a2657", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Honeywell: diagnostic misconception 1260", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 609, in the textbook's discussion of Honeywell. Read what the source actually reports about Honeywell, then apply the definition of multichannel distribution system: where a single company sets up multiple distribution channels to reach customers", status:"approved", flawed_rule:"The example involving Honeywell is interpreted using this faulty rule about multichannel distribution system: Operating multiple channels automatically creates a seamless integrated customer experience."}}, {misconception_id:"MISC_HOTELS_COM_DIAGNOSTIC_MISCONCEPTION_1261_0EF07C", properties:{kc_id:"e654f5a3-2833-5d52-aad9-fecd1e334c12", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Hotels.com: diagnostic misconception 1261", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 428, in the textbook's discussion of Hotels.com. Read what the source actually reports about Hotels.com, then apply the definition of price gouging: when companies take advantage of a situation, typically an emergency or natural disaster, and charge exceptionally high prices for products or services", status:"approved", flawed_rule:"The example involving Hotels.com is interpreted using this faulty rule about price gouging: Any price rise and emergency exploitation are indistinguishable."}}, {misconception_id:"MISC_HUMAN_RIGHTS_CAMPAIGN_FOUNDATION_DIAGNOSTIC_MISC_A20C04", properties:{kc_id:"f5fab412-7cd9-53e2-bde1-0006527f3a9f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Human Rights Campaign Foundation: diagnostic misconception 1262", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of Human Rights Campaign Foundation. Read what the source actually reports about Human Rights Campaign Foundation, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving Human Rights Campaign Foundation is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_IBM_DIAGNOSTIC_MISCONCEPTION_1263_E6A60C", properties:{kc_id:"baaaa7b8-e0d7-5af0-8f60-6484933d587e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"IBM: diagnostic misconception 1263", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 172, in the textbook's discussion of IBM. Read what the source actually reports about IBM, then apply the definition of concentrated marketing: marketing segmentation strategy in which the firm concentrates its efforts and resources on serving one segment of the market", status:"approved", flawed_rule:"The example involving IBM is interpreted using this faulty rule about concentrated marketing: Concentrated marketing means targeting everyone with the same message."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_ICE_BUCKET_CHALLENGE_DIAGNOSTIC_MISCONCEPTION_12_4A99E6", properties:{kc_id:"ef876b3c-27e4-5a40-940d-5e1d9a06c0d8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ice Bucket Challenge: diagnostic misconception 1264", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 493, in the textbook's discussion of Ice Bucket Challenge. Read what the source actually reports about Ice Bucket Challenge, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Ice Bucket Challenge is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_ICONI_DIAGNOSTIC_MISCONCEPTION_1265_8D1904", properties:{kc_id:"81528a74-c904-50a4-bd70-76ab1b59e626", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"ICONI: diagnostic misconception 1265", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 454, in the textbook's discussion of ICONI. Read what the source actually reports about ICONI, then apply the definition of moral appeal: information communicated to the consumer to appeal to their sense of right and wrong", status:"approved", flawed_rule:"The example involving ICONI is interpreted using this faulty rule about moral appeal: Moral appeals use price and functional performance alone."}}, {misconception_id:"MISC_IKEA_DIAGNOSTIC_MISCONCEPTION_1266_20ED0C", properties:{kc_id:"1b69d391-a935-5629-899e-64346bbd2e80", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"IKEA: diagnostic misconception 1266", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 50, in the textbook's discussion of IKEA. Read what the source actually reports about IKEA, then apply the definition of functional strategy: actions and goals assigned to business units that support the overall business strategy", status:"approved", flawed_rule:"The example involving IKEA is interpreted using this faulty rule about functional strategy: A function's strategy can be chosen independently of business-level goals."}}, {misconception_id:"MISC_IMAN_COSMETICS_DIAGNOSTIC_MISCONCEPTION_1267_126E7A", properties:{kc_id:"6989c3e9-ff34-583d-b41c-77b42abe66b5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"IMAN Cosmetics: diagnostic misconception 1267", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 159, in the textbook's discussion of IMAN Cosmetics. Read what the source actually reports about IMAN Cosmetics, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving IMAN Cosmetics is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_INDEED_DIAGNOSTIC_MISCONCEPTION_1268_9FDE7F", properties:{kc_id:"64c315dd-ca55-5752-be77-e1420ed048d3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Indeed: diagnostic misconception 1268", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 518, in the textbook's discussion of Indeed. Separate the specific account of Indeed on printed page 518 from a universal claim. The source passage is: Most recruiting starts with a job description detailing the requirements and the necessary skills that are needed to do the job. Finding the right candidates often starts through listing available job openings on many of the digital job boards, such as Indeed, CareerBuilder, and LinkedIn. Executive recruiting firms can also be instrumental in finding and matching the right job candidates.", status:"approved", flawed_rule:"The mention of Indeed in management of the sales force establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_INDIANA_PREMIUM_OUTLETS_DIAGNOSTIC_MISCONCEPTION_9981E2", properties:{kc_id:"3eeedb73-6ac0-59f6-93d9-ae192040b9cd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Indiana Premium Outlets: diagnostic misconception 1269", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of Indiana Premium Outlets. Read what the source actually reports about Indiana Premium Outlets, then apply the definition of factory outlets: retailers that offer overstocked merchandise at discounted prices", status:"approved", flawed_rule:"The example involving Indiana Premium Outlets is interpreted using this faulty rule about factory outlets: Factory outlets and full-price flagship stores use identical inventory and pricing models."}}, {misconception_id:"MISC_INSTACART_DIAGNOSTIC_MISCONCEPTION_1270_53D462", properties:{kc_id:"12c62b48-9704-59ae-9841-6d43ba24f433", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Instacart: diagnostic misconception 1270", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 285, in the textbook's discussion of Instacart. Read what the source actually reports about Instacart, then apply the definition of cultural identity: how a person identifies with a given culture, ethnicity, or social group, which instills a sense of belonging that influences personal thinking and actions", status:"approved", flawed_rule:"The example involving Instacart is interpreted using this faulty rule about cultural identity: Marketers can assign cultural identity solely from a person's appearance."}}, {misconception_id:"MISC_INSTAGRAM_DIAGNOSTIC_MISCONCEPTION_1271_58648A", properties:{kc_id:"f28eb5eb-310f-58be-9ae9-1f5949401a47", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Instagram: diagnostic misconception 1271", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 101, in the textbook's discussion of Instagram. Read what the source actually reports about Instagram, then apply the definition of reference groups: groups that consumers compare themselves to or associate with", status:"approved", flawed_rule:"The example involving Instagram is interpreted using this faulty rule about reference groups: Only groups a consumer formally belongs to can influence purchases."}}, {misconception_id:"MISC_INTERNATIONAL_TRADE_ADMINISTRATION_DIAGNOSTIC_MI_74A685", properties:{kc_id:"362c664e-e32e-52f5-85a2-16868eab9ba2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"International Trade Administration: diagnostic misconception 1272", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 252, in the textbook's discussion of International Trade Administration. Read what the source actually reports about International Trade Administration, then apply the definition of global market opportunities: conditions that are favorable for a company to expand into the global marketplace", status:"approved", flawed_rule:"The example involving International Trade Administration is interpreted using this faulty rule about global market opportunities: Any large foreign population guarantees profitable entry."}}, {misconception_id:"MISC_INTUIT_DIAGNOSTIC_MISCONCEPTION_1273_A29FCE", properties:{kc_id:"2db739ab-e706-5908-88b5-4fd0837b7e9b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Intuit: diagnostic misconception 1273", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 652, in the textbook's discussion of Intuit. Separate the specific account of Intuit on printed page 652 from a universal claim. The source passage is: Williams-Sonoma is just one example of a company with a vision and a commitment to sustainability. Other companies known for their sustainability commitments and practices include Microsoft, VMware, Intuit, Apple, and Mastercard.9", status:"approved", flawed_rule:"The mention of Intuit in sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_IPHONE_DIAGNOSTIC_MISCONCEPTION_1274_6B56BC", properties:{kc_id:"8604e4cf-8425-5e72-8ee2-35fdc67c2320", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"iPhone: diagnostic misconception 1274", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 478, in the textbook's discussion of iPhone. Read what the source actually reports about iPhone, then apply the definition of informative advertising: a type of advertising intended to raise awareness of a product through educational communication to increase demand of the product", status:"approved", flawed_rule:"The example involving iPhone is interpreted using this faulty rule about informative advertising: Informative advertising is intended only to remind established customers."}}, {misconception_id:"MISC_ISALUS_DIAGNOSTIC_MISCONCEPTION_1275_A0EBD7", properties:{kc_id:"e08666f0-41fd-5290-9fe5-4fa99ad48587", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"iSalus: diagnostic misconception 1275", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 509, in the textbook's discussion of iSalus. Read what the source actually reports about iSalus, then apply the definition of sales force automation: a software tool that helps organizations acquire customers", status:"approved", flawed_rule:"The example involving iSalus is interpreted using this faulty rule about sales force automation: Automating sales tasks eliminates the need for judgment and relationship building."}}, {misconception_id:"MISC_J_CREW_DIAGNOSTIC_MISCONCEPTION_1276_C82290", properties:{kc_id:"d8256a4a-92d5-559d-9fcd-ec090912272a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"J.Crew: diagnostic misconception 1276", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 327, in the textbook's discussion of J.Crew. Read what the source actually reports about J.Crew, then apply the definition of split loyals: customers who have a consideration set of two or three products or services in a category", status:"approved", flawed_rule:"The example involving J.Crew is interpreted using this faulty rule about split loyals: Split loyals buy only one brand over the entire period."}}, {misconception_id:"MISC_J_M_SMUCKER_COMPANY_DIAGNOSTIC_MISCONCEPTION_127_FEDB15", properties:{kc_id:"78ff7cc9-f54b-5d3f-9ea8-44665194e022", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"J.M. Smucker Company: diagnostic misconception 1277", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 275, in the textbook's discussion of J.M. Smucker Company. Read what the source actually reports about J.M. Smucker Company, then apply the definition of multicultural identity: having an affinity with multiple racial or ethnic groups that a person has been exposed to and self-categorizing as being part of more than one of them", status:"approved", flawed_rule:"The example involving J.M. Smucker Company is interpreted using this faulty rule about multicultural identity: Multiple cultural affiliations are mutually exclusive."}}, {misconception_id:"MISC_J_P_MORGAN_DIAGNOSTIC_MISCONCEPTION_1278_15CB5F", properties:{kc_id:"2af3814a-4969-5907-8feb-f7a16d68dcaf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"J.P. Morgan: diagnostic misconception 1278", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 81, in the textbook's discussion of J.P. Morgan. Read what the source actually reports about J.P. Morgan, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving J.P. Morgan is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_JANSPORT_DIAGNOSTIC_MISCONCEPTION_1279_7CDF0A", properties:{kc_id:"94219e8c-2e06-58cb-849d-1975baae5c11", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"JanSport: diagnostic misconception 1279", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 20, in the textbook's discussion of JanSport. Read what the source actually reports about JanSport, then apply the definition of real needs: the value the customer is going to derive from the stated good or service", status:"approved", flawed_rule:"The example involving JanSport is interpreted using this faulty rule about real needs: A customer's stated product specification always reveals the underlying benefit sought."}}, {misconception_id:"MISC_JCPENNEY_DIAGNOSTIC_MISCONCEPTION_1280_8C9370", properties:{kc_id:"5f6bf363-5438-5bb4-ae72-a4bcaa8dfa65", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"JCPenney: diagnostic misconception 1280", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 617, in the textbook's discussion of JCPenney. Read what the source actually reports about JCPenney, then apply the definition of department stores: larger retailers that have separated areas—or departments—for similar product lines", status:"approved", flawed_rule:"The example involving JCPenney is interpreted using this faulty rule about department stores: A department store specializes in only one narrow product line."}}, {misconception_id:"MISC_JELLY_BELLY_DIAGNOSTIC_MISCONCEPTION_1281_E4AF50", properties:{kc_id:"da6bd50d-bebb-5aec-a2bb-8398cc2a5f98", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Jelly Belly: diagnostic misconception 1281", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of Jelly Belly. Separate the specific account of Jelly Belly on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of Jelly Belly in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_JENNER_DIAGNOSTIC_MISCONCEPTION_1282_2C2327", properties:{kc_id:"922c3dab-9250-59c3-b95e-7882f0a1b55c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Jenner: diagnostic misconception 1282", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 101, in the textbook's discussion of Jenner. Read what the source actually reports about Jenner, then apply the definition of reference groups: groups that consumers compare themselves to or associate with", status:"approved", flawed_rule:"The example involving Jenner is interpreted using this faulty rule about reference groups: Only groups a consumer formally belongs to can influence purchases."}}, {misconception_id:"MISC_JIRAU_DIAGNOSTIC_MISCONCEPTION_1283_62CABE", properties:{kc_id:"3e2b6f88-1a65-5e4f-b029-dd4b3fda2cf4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Jirau: diagnostic misconception 1283", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 292, in the textbook's discussion of Jirau. Read what the source actually reports about Jirau, then apply the definition of consumers with disabilities: sociodemographic group living with some type of disability related to mobility, learning, intellectual, or other types of functions; a very diverse group because disabilities span cultural, social, and demographic factors", status:"approved", flawed_rule:"The example involving Jirau is interpreted using this faulty rule about consumers with disabilities: One accessibility adjustment serves all types of disability equally well."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_JOBS_DIAGNOSTIC_MISCONCEPTION_1284_389C6D", properties:{kc_id:"39166207-b639-5caf-b6fe-ebcbdb6cb7b6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Jobs: diagnostic misconception 1284", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 409, in the textbook's discussion of Jobs. Read what the source actually reports about Jobs, then apply the definition of price anchoring: a frame of reference for a buyer to set an expectation of a price", status:"approved", flawed_rule:"The example involving Jobs is interpreted using this faulty rule about price anchoring: A reference price has no influence on how buyers judge an offer."}}, {misconception_id:"MISC_JOHN_LOBB_DIAGNOSTIC_MISCONCEPTION_1285_6CF8E5", properties:{kc_id:"1d5e5d46-1e15-59a9-8375-7fb88b51398a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"John Lobb: diagnostic misconception 1285", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 241, in the textbook's discussion of John Lobb. Read what the source actually reports about John Lobb, then apply the definition of international firm: a company that operates on a global level regardless of intensity of involvement", status:"approved", flawed_rule:"The example involving John Lobb is interpreted using this faulty rule about international firm: All firms operating internationally allow the same degree of local autonomy."}}, {misconception_id:"MISC_JOHNSON_DIAGNOSTIC_MISCONCEPTION_1286_1BFE63", properties:{kc_id:"89958df8-7529-5ecf-b37e-59c038656b24", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Johnson: diagnostic misconception 1286", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 454, in the textbook's discussion of Johnson. Read what the source actually reports about Johnson, then apply the definition of moral appeal: information communicated to the consumer to appeal to their sense of right and wrong", status:"approved", flawed_rule:"The example involving Johnson is interpreted using this faulty rule about moral appeal: Moral appeals use price and functional performance alone."}}, {misconception_id:"MISC_JOHNSON_JOHNSON_DIAGNOSTIC_MISCONCEPTION_1287_602327", properties:{kc_id:"d73b6776-1033-5159-b039-30a6c69592c4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Johnson & Johnson: diagnostic misconception 1287", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 444, in the textbook's discussion of Johnson & Johnson. Read what the source actually reports about Johnson & Johnson, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Johnson & Johnson is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_JUUL_DIAGNOSTIC_MISCONCEPTION_1288_1D4B33", properties:{kc_id:"945a1b0e-eb96-5ffb-9c18-8b25db0e83b6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Juul: diagnostic misconception 1288", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 82, in the textbook's discussion of Juul. Read what the source actually reports about Juul, then apply the definition of marketing dashboard: summarizes important marketing metrics and key performance indicators into easy- to-understand measurements", status:"approved", flawed_rule:"The example involving Juul is interpreted using this faulty rule about marketing dashboard: A dashboard improves decisions merely by displaying as many metrics as possible."}}, {misconception_id:"MISC_KABBAGE_FUNDING_DIAGNOSTIC_MISCONCEPTION_1289_FD69E7", properties:{kc_id:"0587c27c-b5b5-53b0-9bc8-f19c117c0f65", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kabbage Funding: diagnostic misconception 1289", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 133, in the textbook's discussion of Kabbage Funding. Read what the source actually reports about Kabbage Funding, then apply the definition of bill of materials: a comprehensive inventory of the raw materials, assemblies, subassemblies, parts, and components", status:"approved", flawed_rule:"The example involving Kabbage Funding is interpreted using this faulty rule about bill of materials: A bill of materials is simply the supplier's payment invoice."}}, {misconception_id:"MISC_KAO_DIAGNOSTIC_MISCONCEPTION_1290_6ABA72", properties:{kc_id:"2146a4c6-831d-595e-bea9-ed8b7ca894f1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kao: diagnostic misconception 1290", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 248, in the textbook's discussion of Kao. Separate the specific account of Kao on printed page 248 from a universal claim. The source passage is: Founded in 1887 in Tokyo, Japan, Kao is a “16-time Ethisphere World’s Most Ethical Companies honoree and [it has] been honored every year since Ethisphere started recognizing companies.”89 The company’s", status:"approved", flawed_rule:"The mention of Kao in ethical issues in the global marketplace establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_KATE_SPADE_DIAGNOSTIC_MISCONCEPTION_1291_68EA49", properties:{kc_id:"4b25c4b8-c0e3-5807-94bf-959a067dbd1b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kate Spade: diagnostic misconception 1291", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Kate Spade. Read what the source actually reports about Kate Spade, then apply the definition of licensed brands: brands that provide the likeness of their brand as a fee for use", status:"approved", flawed_rule:"The example involving Kate Spade is interpreted using this faulty rule about licensed brands: A licensee owns the brand outright after paying a licensing fee."}}, {misconception_id:"MISC_KELLER_DIAGNOSTIC_MISCONCEPTION_1292_D74A15", properties:{kc_id:"96cc4fb1-ab0d-5a72-b0dc-94f22489cf43", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Keller: diagnostic misconception 1292", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 322, in the textbook's discussion of Keller. Read what the source actually reports about Keller, then apply the definition of brand equity: the additional value that a brand has over a substitute", status:"approved", flawed_rule:"The example involving Keller is interpreted using this faulty rule about brand equity: Brand equity is identical to current sales revenue."}}, {misconception_id:"MISC_KELLOGG_S_DIAGNOSTIC_MISCONCEPTION_1293_CD4B2F", properties:{kc_id:"85ed79a8-1432-5852-82ca-95534552d0a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kellogg’s: diagnostic misconception 1293", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 242, in the textbook's discussion of Kellogg’s. Read what the source actually reports about Kellogg’s, then apply the definition of joint venture: a business arrangement whereby two or more companies create a single enterprise or project", status:"approved", flawed_rule:"The example involving Kellogg’s is interpreted using this faulty rule about joint venture: A joint venture is simply a supplier contract without a shared enterprise."}}, {misconception_id:"MISC_KENTUCKY_FRIED_CHICKEN_KFC_DIAGNOSTIC_MISCONCEPT_E57448", properties:{kc_id:"17cf81ea-8d55-5111-bdf4-452e305b9de7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kentucky Fried Chicken (KFC): diagnostic misconception 1294", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 358, in the textbook's discussion of Kentucky Fried Chicken (KFC). Read what the source actually reports about Kentucky Fried Chicken (KFC), then apply the definition of consumer adoption process: stages consumers go through in adopting a new product", status:"approved", flawed_rule:"The example involving Kentucky Fried Chicken (KFC) is interpreted using this faulty rule about consumer adoption process: Becoming aware of a new product is the same as adopting it."}}, {misconception_id:"MISC_KFORCE_DIAGNOSTIC_MISCONCEPTION_1295_7F2947", properties:{kc_id:"afe94cd7-51ca-5f44-bfef-4ca3f188b1e9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kforce: diagnostic misconception 1295", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 147, in the textbook's discussion of Kforce. Read what the source actually reports about Kforce, then apply the definition of business objectives and goals: achievable outcomes that provide a framework for achieving success", status:"approved", flawed_rule:"The example involving Kforce is interpreted using this faulty rule about business objectives and goals: Organizational purchasing is unrelated to the buying firm's performance goals."}}, {misconception_id:"MISC_KINDLE_DIAGNOSTIC_MISCONCEPTION_1296_D009D1", properties:{kc_id:"103ef6e8-7e76-52b8-9cb9-17246a919d0c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kindle: diagnostic misconception 1296", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 355, in the textbook's discussion of Kindle. Read what the source actually reports about Kindle, then apply the definition of marketing synergy: the fit between the needs of the new product development project and the company’s marketing capabilities", status:"approved", flawed_rule:"The example involving Kindle is interpreted using this faulty rule about marketing synergy: Strong engineering resources guarantee a fit with marketing capabilities."}}, {misconception_id:"MISC_KIRBY_DIAGNOSTIC_MISCONCEPTION_1297_2EBC2A", properties:{kc_id:"b734fc89-7fc6-5f30-92b1-caaaa4f333b5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kirby: diagnostic misconception 1297", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 625, in the textbook's discussion of Kirby. Read what the source actually reports about Kirby, then apply the definition of direct selling: a marketing strategy that involves selling products and services directly to the consumer in a non-retail setting", status:"approved", flawed_rule:"The example involving Kirby is interpreted using this faulty rule about direct selling: Direct selling always takes place inside a permanent retail shop."}}, {misconception_id:"MISC_KLOSS_DIAGNOSTIC_MISCONCEPTION_1298_78FB44", properties:{kc_id:"ba575055-2842-588f-8bc8-8e4121a29293", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kloss: diagnostic misconception 1298", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Kloss. Separate the specific account of Kloss on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Kloss in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_KOHL_S_DIAGNOSTIC_MISCONCEPTION_1299_5F07EB", properties:{kc_id:"c2f9b03e-e941-5b8a-a96e-4446e73a5c83", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kohl’s: diagnostic misconception 1299", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 586, in the textbook's discussion of Kohl’s. Read what the source actually reports about Kohl’s, then apply the definition of multichannel distribution system: where a single company sets up multiple distribution channels to reach customers", status:"approved", flawed_rule:"The example involving Kohl’s is interpreted using this faulty rule about multichannel distribution system: Operating multiple channels automatically creates a seamless integrated customer experience."}}, {misconception_id:"MISC_KOHLBERG_COMPANY_DIAGNOSTIC_MISCONCEPTION_1300_7C883C", properties:{kc_id:"a36df0e4-7f17-5286-a287-52fcbe361192", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kohlberg & Company: diagnostic misconception 1300", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 588, in the textbook's discussion of Kohlberg & Company. Read what the source actually reports about Kohlberg & Company, then apply the definition of target market coverage: resources and capabilities needed to reach consumers in a company’s target market", status:"approved", flawed_rule:"The example involving Kohlberg & Company is interpreted using this faulty rule about target market coverage: More outlets necessarily mean better access to the intended target customers."}}, {misconception_id:"MISC_KOTLER_DIAGNOSTIC_MISCONCEPTION_1301_8B0021", properties:{kc_id:"c3f79f09-ea04-5cf2-bcad-98c044d0c6fa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kotler: diagnostic misconception 1301", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 652, in the textbook's discussion of Kotler. Read what the source actually reports about Kotler, then apply the definition of sustainable marketing: a marketing strategy that infuses purpose into socially conscious products and services", status:"approved", flawed_rule:"The example involving Kotler is interpreted using this faulty rule about sustainable marketing: Sustainable marketing is just green promotion detached from product and operational decisions."}}, {misconception_id:"MISC_KOZMO_COM_DIAGNOSTIC_MISCONCEPTION_1302_8D6706", properties:{kc_id:"d896a3bd-2703-566f-b2e3-3747e51ba553", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kozmo.com: diagnostic misconception 1302", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 634, in the textbook's discussion of Kozmo.com. Read what the source actually reports about Kozmo.com, then apply the definition of online retailing: a business model that allows consumers to search and purchase products remotely over the Internet", status:"approved", flawed_rule:"The example involving Kozmo.com is interpreted using this faulty rule about online retailing: Online retailing removes all fulfillment and customer service requirements."}}, {misconception_id:"MISC_KPMG_DIAGNOSTIC_MISCONCEPTION_1303_F1DF70", properties:{kc_id:"8818ad05-fd9a-575f-9fbe-800fc9260962", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"KPMG: diagnostic misconception 1303", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 566, in the textbook's discussion of KPMG. Read what the source actually reports about KPMG, then apply the definition of social media marketing: using social media platforms, such as Facebook, Instagram, LinkedIn, and Twitter, to deliver content that drives engagement with your brand", status:"approved", flawed_rule:"The example involving KPMG is interpreted using this faulty rule about social media marketing: A follower count alone establishes campaign effectiveness."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_KRAFT_DIAGNOSTIC_MISCONCEPTION_1304_CB56F4", properties:{kc_id:"5e7714c2-ece6-5881-a463-68199fb14a08", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kraft: diagnostic misconception 1304", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 316, in the textbook's discussion of Kraft. Read what the source actually reports about Kraft, then apply the definition of maturity stage: part of the product life cycle when sales growth slows and profitability levels off", status:"approved", flawed_rule:"The example involving Kraft is interpreted using this faulty rule about maturity stage: Maturity means demand disappears and all sales cease."}}, {misconception_id:"MISC_KROGER_DIAGNOSTIC_MISCONCEPTION_1305_ACBC11", properties:{kc_id:"d40b23da-f55a-5e9f-acd2-6672c9dad920", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Kroger: diagnostic misconception 1305", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of Kroger. Read what the source actually reports about Kroger, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Kroger is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_L_L_BEAN_DIAGNOSTIC_MISCONCEPTION_1306_07933F", properties:{kc_id:"961ff10f-e5d3-5a62-9f17-1d7d1af09a96", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"L.L.Bean: diagnostic misconception 1306", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of L.L.Bean. Read what the source actually reports about L.L.Bean, then apply the definition of factory outlets: retailers that offer overstocked merchandise at discounted prices", status:"approved", flawed_rule:"The example involving L.L.Bean is interpreted using this faulty rule about factory outlets: Factory outlets and full-price flagship stores use identical inventory and pricing models."}}, {misconception_id:"MISC_L_L_BEAN_OUTLET_DIAGNOSTIC_MISCONCEPTION_1307_C0CA8D", properties:{kc_id:"88e9b387-b590-5705-bc91-d19136399e8e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"L.L.Bean Outlet: diagnostic misconception 1307", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of L.L.Bean Outlet. Read what the source actually reports about L.L.Bean Outlet, then apply the definition of factory outlets: retailers that offer overstocked merchandise at discounted prices", status:"approved", flawed_rule:"The example involving L.L.Bean Outlet is interpreted using this faulty rule about factory outlets: Factory outlets and full-price flagship stores use identical inventory and pricing models."}}, {misconception_id:"MISC_L_OR_AL_DIAGNOSTIC_MISCONCEPTION_1308_FB2BC5", properties:{kc_id:"d8ef15e4-e2fd-5681-bea5-2fe340728bbe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"L’Oréal: diagnostic misconception 1308", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 593, in the textbook's discussion of L’Oréal. Read what the source actually reports about L’Oréal, then apply the definition of channel conflict: disagreements between companies in the marketing channel due to a competitive versus a collaborative mindset", status:"approved", flawed_rule:"The example involving L’Oréal is interpreted using this faulty rule about channel conflict: All disagreements occur only between manufacturers and retailers at different levels."}}, {misconception_id:"MISC_LACROIX_DIAGNOSTIC_MISCONCEPTION_1309_BF2ADD", properties:{kc_id:"f541524c-c49f-5605-ab0f-4c03f94a133c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"LaCroix: diagnostic misconception 1309", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 330, in the textbook's discussion of LaCroix. Read what the source actually reports about LaCroix, then apply the definition of brand engagement: measure of how deeply the customer identifies emotionally with a brand", status:"approved", flawed_rule:"The example involving LaCroix is interpreted using this faulty rule about brand engagement: Exposure to a brand automatically demonstrates emotional involvement."}}, {misconception_id:"MISC_LANDS_END_DIAGNOSTIC_MISCONCEPTION_1310_AAA0DA", properties:{kc_id:"15ca5f3a-4fb9-5b48-b6e9-9d63a7bca953", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lands’ End: diagnostic misconception 1310", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 541, in the textbook's discussion of Lands’ End. Read what the source actually reports about Lands’ End, then apply the definition of direct marketing: using communication tools that directly engage with individual consumers for the ultimate purpose of calling them to take some marketing action", status:"approved", flawed_rule:"The example involving Lands’ End is interpreted using this faulty rule about direct marketing: Direct marketing cannot use television or print."}}, {misconception_id:"MISC_LAPAAS_DIGITAL_DIAGNOSTIC_MISCONCEPTION_1311_78E575", properties:{kc_id:"2e8e1a15-f43c-5aa0-878a-dcebc0f02459", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lapaas Digital: diagnostic misconception 1311", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 35, in the textbook's discussion of Lapaas Digital. Read what the source actually reports about Lapaas Digital, then apply the definition of ethical marketing: process that emphasizes trustworthy, transparent, social, and culturally sensitive marketing policies", status:"approved", flawed_rule:"The example involving Lapaas Digital is interpreted using this faulty rule about ethical marketing: Marketing is ethical whenever it increases sales without breaking a written rule."}}, {misconception_id:"MISC_LAW_OF_EFFECT_DIAGNOSTIC_MISCONCEPTION_1312_413D78", properties:{kc_id:"9bc30966-2dc2-5745-b41c-66470ab119a9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Law of Effect: diagnostic misconception 1312", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 108, in the textbook's discussion of Law of Effect. Read what the source actually reports about Law of Effect, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving Law of Effect is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_LAY_S_DIAGNOSTIC_MISCONCEPTION_1313_55BD84", properties:{kc_id:"286ce7f5-54f5-56ab-8efd-277def91cab0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lay’s: diagnostic misconception 1313", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 442, in the textbook's discussion of Lay’s. Read what the source actually reports about Lay’s, then apply the definition of buy one get one (BOGO): promotion strategy in which consumers are offered the opportunity to buy one product at regular price and get a second item free", status:"approved", flawed_rule:"The example involving Lay’s is interpreted using this faulty rule about buy one get one (BOGO): A BOGO offer necessarily generates profit regardless of product cost and cannibalization."}}, {misconception_id:"MISC_LEAR_DIAGNOSTIC_MISCONCEPTION_1314_8E197B", properties:{kc_id:"f3ccefd0-d591-582e-8b58-cdc90f36f3b4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lear: diagnostic misconception 1314", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 584, in the textbook's discussion of Lear. Read what the source actually reports about Lear, then apply the definition of business-to-consumer (B2C): a market comprised of companies that manufacture and sell products or services directly to a final consumer or end user", status:"approved", flawed_rule:"The example involving Lear is interpreted using this faulty rule about business-to-consumer (B2C): B2C describes sales intended for further industrial production."}}, {misconception_id:"MISC_LEGO_DIAGNOSTIC_MISCONCEPTION_1315_73C37C", properties:{kc_id:"58212f2f-af53-567d-badf-239d1d5d3e74", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"LEGO: diagnostic misconception 1315", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 176, in the textbook's discussion of LEGO. Read what the source actually reports about LEGO, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving LEGO is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_LEMONHEAD_DIAGNOSTIC_MISCONCEPTION_1316_1F267A", properties:{kc_id:"61aa94a8-3e89-5e1e-9963-b5f582160e49", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lemonhead: diagnostic misconception 1316", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of Lemonhead. Separate the specific account of Lemonhead on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of Lemonhead in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_LENDINGTREE_DIAGNOSTIC_MISCONCEPTION_1317_8C44C3", properties:{kc_id:"f7cea612-228f-5084-b08c-02653a044894", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"LendingTree: diagnostic misconception 1317", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 544, in the textbook's discussion of LendingTree. Read what the source actually reports about LendingTree, then apply the definition of website traffic: the total number of visitors to a company’s website", status:"approved", flawed_rule:"The example involving LendingTree is interpreted using this faulty rule about website traffic: More visits necessarily produce a better conversion rate."}}, {misconception_id:"MISC_LEO_BURNETT_DIAGNOSTIC_MISCONCEPTION_1318_35A1E9", properties:{kc_id:"0d73b245-5a34-5f59-9157-bd7bd75569bd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Leo Burnett: diagnostic misconception 1318", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 473, in the textbook's discussion of Leo Burnett. Read what the source actually reports about Leo Burnett, then apply the definition of pull strategy: advertising strategy intended to bring audiences to the product", status:"approved", flawed_rule:"The example involving Leo Burnett is interpreted using this faulty rule about pull strategy: A pull strategy concentrates exclusively on persuading channel intermediaries to stock the product."}}, {misconception_id:"MISC_LEVI_S_DIAGNOSTIC_MISCONCEPTION_1319_B52217", properties:{kc_id:"3bbd7f60-d6c9-5e8a-b0d7-067926af1e2e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Levi’s: diagnostic misconception 1319", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 247, in the textbook's discussion of Levi’s. Separate the specific account of Levi’s on printed page 247 from a universal claim. The source passage is: Unlike most developed countries, those countries still developing often have much lower standards for working conditions. This has been a topic of hot debate for many years in the United States and around the world as companies have moved some or all of their operations to countries with lower standards. In Xinjiang, China, more than half a million people from ethnic minority groups are forced to pick cotton for the fashion industry.82 Well-known companies such as Nike, Apple, and Levi’s have come under the same scrutiny in more recent years. While cheaper production costs will provide the company with more profits, more often than not, lower standards, working conditions, and…", status:"approved", flawed_rule:"The mention of Levi’s in ethical issues in the global marketplace establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_LEXUS_DIAGNOSTIC_MISCONCEPTION_1320_7596C8", properties:{kc_id:"5c380605-10f2-54a9-9cbd-401936090c7d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lexus: diagnostic misconception 1320", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 412, in the textbook's discussion of Lexus. Read what the source actually reports about Lexus, then apply the definition of product line pricing: setting a higher price for some product lines and lower price points for others in order to capture various target markets", status:"approved", flawed_rule:"The example involving Lexus is interpreted using this faulty rule about product line pricing: All models in a product range should have identical prices regardless of benefits."}}, {misconception_id:"MISC_LINEOUT_DIAGNOSTIC_MISCONCEPTION_1321_581498", properties:{kc_id:"32534024-21f9-5ecb-ba88-0ca165123ffc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lineout: diagnostic misconception 1321", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 301, in the textbook's discussion of Lineout. Separate the specific account of Lineout on printed page 301 from a universal claim. The source passage is: On the opposite spectrum, young women had much different needs for facial fillers. Younger women primarily wanted lips that looked like the Kardashians and “line”-free foreheads, similar to what they were seeing from favorite celebrities and Instagram influencers. Media choices for women in their late teens and early twenties were primarily focused on TikTok and Instagram along with some select YouTube channels and reality shows. Lineout was able to connect with this audience by targeting messaging specific to the bigger, beautiful lip craze.", status:"approved", flawed_rule:"The mention of Lineout in diversity and inclusion marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_LINKEDIN_DIAGNOSTIC_MISCONCEPTION_1322_75BC89", properties:{kc_id:"c66e8d4b-0333-5fb0-ba77-ed3cd7fec902", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"LinkedIn: diagnostic misconception 1322", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 56, in the textbook's discussion of LinkedIn. Read what the source actually reports about LinkedIn, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving LinkedIn is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_LITTLE_DEBBIE_DIAGNOSTIC_MISCONCEPTION_1323_42C513", properties:{kc_id:"6cf23423-5754-5b7c-bc3a-d88f5ffbb8f1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Little Debbie: diagnostic misconception 1323", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 470, in the textbook's discussion of Little Debbie. Read what the source actually reports about Little Debbie, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Little Debbie is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_LIVING_ESSENTIALS_LLC_DIAGNOSTIC_MISCONCEPTION_1_D6E2AD", properties:{kc_id:"96726d82-47e9-586b-be32-ea9d08ae8978", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Living Essentials, LLC: diagnostic misconception 1324", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 36, in the textbook's discussion of Living Essentials, LLC. Read what the source actually reports about Living Essentials, LLC, then apply the definition of stated needs: those product or service needs that are clearly specified by the customer", status:"approved", flawed_rule:"The example involving Living Essentials, LLC is interpreted using this faulty rule about stated needs: A customer's explicit request captures all expected and latent needs."}}, {misconception_id:"MISC_LOPEZ_DIAGNOSTIC_MISCONCEPTION_1325_337164", properties:{kc_id:"0b60c68e-5842-5729-a418-6c5005e21a7c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lopez: diagnostic misconception 1325", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 267, in the textbook's discussion of Lopez. Read what the source actually reports about Lopez, then apply the definition of Hispanic population: largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe", status:"approved", flawed_rule:"The example involving Lopez is interpreted using this faulty rule about Hispanic population: Hispanic identity implies one race, nationality, or level of Spanish-language preference."}}, {misconception_id:"MISC_LOWE_S_DIAGNOSTIC_MISCONCEPTION_1326_743380", properties:{kc_id:"397c8963-29f5-5ebf-94c6-7d218e0cd596", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lowe’s: diagnostic misconception 1326", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 588, in the textbook's discussion of Lowe’s. Read what the source actually reports about Lowe’s, then apply the definition of selective distribution: a strategy that includes choosing more than one, but fewer than all possible intermediaries to distribute a company’s market offering", status:"approved", flawed_rule:"The example involving Lowe’s is interpreted using this faulty rule about selective distribution: Selective distribution means using every possible outlet."}}, {misconception_id:"MISC_LULULEMON_DIAGNOSTIC_MISCONCEPTION_1327_D802D7", properties:{kc_id:"e6d85818-9406-56c2-837c-42d9a72832da", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lululemon: diagnostic misconception 1327", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 162, in the textbook's discussion of Lululemon. Read what the source actually reports about Lululemon, then apply the definition of value-based segmentation: evaluating groups of customers in terms of the revenue they generate and the costs of establishing and maintaining relationships with them", status:"approved", flawed_rule:"The example involving Lululemon is interpreted using this faulty rule about value-based segmentation: Customers generating the most revenue necessarily generate the most relationship value."}}, {misconception_id:"MISC_LUSH_DIAGNOSTIC_MISCONCEPTION_1328_86E44F", properties:{kc_id:"77582005-5500-5255-92a2-f3a4a69a581a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"LUSH: diagnostic misconception 1328", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 179, in the textbook's discussion of LUSH. Read what the source actually reports about LUSH, then apply the definition of concentrated marketing: marketing segmentation strategy in which the firm concentrates its efforts and resources on serving one segment of the market", status:"approved", flawed_rule:"The example involving LUSH is interpreted using this faulty rule about concentrated marketing: Concentrated marketing means targeting everyone with the same message."}}, {misconception_id:"MISC_LUXOTTICA_DIAGNOSTIC_MISCONCEPTION_1329_66D021", properties:{kc_id:"25bf8c43-9c90-5750-b4ba-5c4fa57e7908", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Luxottica: diagnostic misconception 1329", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Luxottica. Read what the source actually reports about Luxottica, then apply the definition of licensed brands: brands that provide the likeness of their brand as a fee for use", status:"approved", flawed_rule:"The example involving Luxottica is interpreted using this faulty rule about licensed brands: A licensee owns the brand outright after paying a licensing fee."}}, {misconception_id:"MISC_LYSOL_DIAGNOSTIC_MISCONCEPTION_1330_8B8381", properties:{kc_id:"06ef1df4-28b0-52cd-910a-fa84eb4b8645", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Lysol: diagnostic misconception 1330", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 104, in the textbook's discussion of Lysol. Separate the specific account of Lysol on printed page 104 from a universal claim. The source passage is: The second level is safety and security, the need to be safe from physical and psychological harm. Once again, consider just a few successful marketing campaigns that have focused on safety—“You’re in Good Hands with Allstate” and Lysol’s “Practice Healthy Habits” campaign with its tagline “What It Takes to Protect.”", status:"approved", flawed_rule:"The mention of Lysol in factors that influence consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_MACY_S_DIAGNOSTIC_MISCONCEPTION_1331_D51D55", properties:{kc_id:"63b7af99-6ddb-5421-bafb-bd1a994b0370", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Macy’s: diagnostic misconception 1331", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 445, in the textbook's discussion of Macy’s. Read what the source actually reports about Macy’s, then apply the definition of Internet/digital marketing: promotional method that utilizes the Internet and digital technology such as text messaging, phone applications, and social media to reach consumers", status:"approved", flawed_rule:"The example involving Macy’s is interpreted using this faulty rule about Internet/digital marketing: Digital promotion consists exclusively of banner advertisements."}}, {misconception_id:"MISC_MAILCHIMP_DIAGNOSTIC_MISCONCEPTION_1332_E00CD6", properties:{kc_id:"2aa3bd41-7143-540d-a194-fb60a021ff71", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mailchimp: diagnostic misconception 1332", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 166, in the textbook's discussion of Mailchimp. Read what the source actually reports about Mailchimp, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Mailchimp is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_MAKE_A_WISH_FOUNDATION_DIAGNOSTIC_MISCONCEPTION__323F09", properties:{kc_id:"6994d7e7-1b0a-568b-ac82-bcdae44c14fa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Make-A-Wish Foundation: diagnostic misconception 1333", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of Make-A-Wish Foundation. Read what the source actually reports about Make-A-Wish Foundation, then apply the definition of advertising: a paid form of nonpersonal communication about a product, service, or idea", status:"approved", flawed_rule:"The example involving Make-A-Wish Foundation is interpreted using this faulty rule about advertising: Every favorable media mention is paid advertising."}}, {misconception_id:"MISC_MALL_OF_AMERICA_DIAGNOSTIC_MISCONCEPTION_1334_B3E0E1", properties:{kc_id:"c2c5388f-67a8-5dff-b016-e4e9f013e6bd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mall of America: diagnostic misconception 1334", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 629, in the textbook's discussion of Mall of America. Read what the source actually reports about Mall of America, then apply the definition of regional shopping centers: commonly referred to as “malls”; collection of stores that offer general merchandise or fashion-oriented offerings", status:"approved", flawed_rule:"The example involving Mall of America is interpreted using this faulty rule about regional shopping centers: A regional shopping center is a single freestanding store."}}, {misconception_id:"MISC_MARKS_SPENCER_DIAGNOSTIC_MISCONCEPTION_1335_E45F06", properties:{kc_id:"34af0c1a-ea24-5b85-bcc6-52fb5e195f1b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Marks & Spencer: diagnostic misconception 1335", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 171, in the textbook's discussion of Marks & Spencer. Separate the specific account of Marks & Spencer on printed page 171 from a universal claim. The source passage is: In 2022, in response to Russia’s invasion of Ukraine, major sanctions have been put in place against Russia by the United States, the European Union, and the United Kingdom. For example, the United Kingdom imposed a 35 percent tax on some Russian imports, and several international companies like McDonald’s, Coca-Cola, Starbucks and Marks & Spencer have either suspended operations in Russia or have withdrawn altogether. It doesn’t take much to imagine the financial impact on Russia as a result of these sanctions.36", status:"approved", flawed_rule:"The mention of Marks & Spencer in segmentation of international markets establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_MARRIOTT_DIAGNOSTIC_MISCONCEPTION_1336_A9CEC9", properties:{kc_id:"f6a60be1-f62c-5ffc-a863-b4cad4f7881a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Marriott: diagnostic misconception 1336", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 612, in the textbook's discussion of Marriott. Read what the source actually reports about Marriott, then apply the definition of social commerce: a blend of e-commerce and social media", status:"approved", flawed_rule:"The example involving Marriott is interpreted using this faulty rule about social commerce: Social commerce means discussing a brand online without any link to purchasing."}}, {misconception_id:"MISC_MARRIOTT_INTERNATIONAL_DIAGNOSTIC_MISCONCEPTION__5EFEB6", properties:{kc_id:"201a14b5-aeb8-5794-b2cd-8046da4fb666", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Marriott International: diagnostic misconception 1337", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 181, in the textbook's discussion of Marriott International. Read what the source actually reports about Marriott International, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving Marriott International is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_MASLOW_DIAGNOSTIC_MISCONCEPTION_1338_11FB02", properties:{kc_id:"f3598dc5-60d3-5b0e-b5cc-178ff8e9ece8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Maslow: diagnostic misconception 1338", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 104, in the textbook's discussion of Maslow. Read what the source actually reports about Maslow, then apply the definition of Maslow’s hierarchy of needs: a theory of motivation by Abraham Maslow which states that five categories of human needs dictate an individual’s behavior", status:"approved", flawed_rule:"The example involving Maslow is interpreted using this faulty rule about Maslow’s hierarchy of needs: A single need category explains all customers' motives in all circumstances."}}, {misconception_id:"MISC_MASTERCARD_DIAGNOSTIC_MISCONCEPTION_1339_D59B96", properties:{kc_id:"632aa0dc-dea9-5639-9c65-483c8c8c217e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mastercard: diagnostic misconception 1339", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 161, in the textbook's discussion of Mastercard. Read what the source actually reports about Mastercard, then apply the definition of differentiated marketing: marketing strategy that involves creating marketing campaigns that appeal to two or more different target audiences, demographics, or marketing segments", status:"approved", flawed_rule:"The example involving Mastercard is interpreted using this faulty rule about differentiated marketing: Differentiated marketing uses one unchanged offer for every segment."}}, {misconception_id:"MISC_MATTEL_INC_DIAGNOSTIC_MISCONCEPTION_1340_26DBA3", properties:{kc_id:"5181e75f-55e0-5109-b84c-1c9991b8b9dc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mattel Inc.: diagnostic misconception 1340", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 155, in the textbook's discussion of Mattel Inc.. Separate the specific account of Mattel Inc. on printed page 155 from a universal claim. The source passage is: Mattel Inc. is the producer of popular children’s toys like Hot Wheels, Barbie, and Max Steel. Its action figure Max Steel was introduced in 1999 to only modest success in the United States, but it was enormously popular in South America, even outselling the company’s top lines—Hot Wheels and Barbie. Nearly a decade later, marketers decided to revive the brand in the United States, hoping for a second chance at success.1", status:"approved", flawed_rule:"The mention of Mattel Inc. in market segmentation and consumer markets establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_MAXWELL_HOUSE_DIAGNOSTIC_MISCONCEPTION_1341_227F93", properties:{kc_id:"437f2056-7fe0-5e21-977e-b6dbe57e69ee", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Maxwell House: diagnostic misconception 1341", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 351, in the textbook's discussion of Maxwell House. Read what the source actually reports about Maxwell House, then apply the definition of product idea: concept of a new product that a company could potentially offer to the market", status:"approved", flawed_rule:"The example involving Maxwell House is interpreted using this faulty rule about product idea: An undeveloped idea already establishes technical and market feasibility."}}, {misconception_id:"MISC_MEALS_ON_WHEELS_AMERICA_DIAGNOSTIC_MISCONCEPTION_75EB82", properties:{kc_id:"6f5a5042-4e5e-57c0-bb9c-62d4c53eef0f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Meals on Wheels America: diagnostic misconception 1342", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of Meals on Wheels America. Read what the source actually reports about Meals on Wheels America, then apply the definition of advertising: a paid form of nonpersonal communication about a product, service, or idea", status:"approved", flawed_rule:"The example involving Meals on Wheels America is interpreted using this faulty rule about advertising: Every favorable media mention is paid advertising."}}, {misconception_id:"MISC_MEDALLIA_DIAGNOSTIC_MISCONCEPTION_1343_636CD1", properties:{kc_id:"227fe185-81bd-53ab-9769-9b90b0f9d68e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Medallia: diagnostic misconception 1343", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 127, in the textbook's discussion of Medallia. Read what the source actually reports about Medallia, then apply the definition of product specifications: a document carrying essential information to keep teams on track when designing and developing a product", status:"approved", flawed_rule:"The example involving Medallia is interpreted using this faulty rule about product specifications: A product specification merely states the total purchasing budget."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_MEN_S_HEALTH_DIAGNOSTIC_MISCONCEPTION_1344_9723C4", properties:{kc_id:"e091f1fc-daaa-54ad-a134-776151a822ec", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Men’s Health: diagnostic misconception 1344", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 158, in the textbook's discussion of Men’s Health. Read what the source actually reports about Men’s Health, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Men’s Health is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_MERCEDES_BENZ_DIAGNOSTIC_MISCONCEPTION_1345_B09816", properties:{kc_id:"e3c78e46-bb91-5972-9c25-b41bb2a0e16e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mercedes-Benz: diagnostic misconception 1345", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 158, in the textbook's discussion of Mercedes-Benz. Read what the source actually reports about Mercedes-Benz, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Mercedes-Benz is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_MESSI_DIAGNOSTIC_MISCONCEPTION_1346_40CDC5", properties:{kc_id:"a73b2f26-70c2-5b38-987d-341b8c26f784", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Messi: diagnostic misconception 1346", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 101, in the textbook's discussion of Messi. Read what the source actually reports about Messi, then apply the definition of reference groups: groups that consumers compare themselves to or associate with", status:"approved", flawed_rule:"The example involving Messi is interpreted using this faulty rule about reference groups: Only groups a consumer formally belongs to can influence purchases."}}, {misconception_id:"MISC_META_DIAGNOSTIC_MISCONCEPTION_1347_64945E", properties:{kc_id:"392c0be6-b267-59cb-b218-809d2f0dbe93", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Meta: diagnostic misconception 1347", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 55, in the textbook's discussion of Meta. Read what the source actually reports about Meta, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving Meta is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_META_PLATFORMS_DIAGNOSTIC_MISCONCEPTION_1348_F7DA98", properties:{kc_id:"02703dab-1199-5434-8ef1-d258110d2ee6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Meta Platforms: diagnostic misconception 1348", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 247, in the textbook's discussion of Meta Platforms. Read what the source actually reports about Meta Platforms, then apply the definition of business landscape: everything internal and external to the business, its industry, and its environment", status:"approved", flawed_rule:"The example involving Meta Platforms is interpreted using this faulty rule about business landscape: A country's market potential depends only on the number of consumers."}}, {misconception_id:"MISC_METIME_DROP_IN_CHILD_CARE_DIAGNOSTIC_MISCONCEPTI_92A0E4", properties:{kc_id:"a369659b-be5f-5278-94e7-0dfe49f02b20", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"MeTime Drop-In Child Care: diagnostic misconception 1349", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 375, in the textbook's discussion of MeTime Drop-In Child Care. Read what the source actually reports about MeTime Drop-In Child Care, then apply the definition of GAP Model of Service Quality: theoretical marketing model that helps to identify the gaps between the perceived service and the expected service", status:"approved", flawed_rule:"The example involving MeTime Drop-In Child Care is interpreted using this faulty rule about GAP Model of Service Quality: All service failures have the same cause and need the same remedy."}}, {misconception_id:"MISC_MICROSOFT_DIAGNOSTIC_MISCONCEPTION_1350_543453", properties:{kc_id:"ccab6c45-bf64-517a-aa2f-81a78975d977", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Microsoft: diagnostic misconception 1350", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 55, in the textbook's discussion of Microsoft. Read what the source actually reports about Microsoft, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving Microsoft is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_MIKE_AND_IKE_DIAGNOSTIC_MISCONCEPTION_1351_4F8DDB", properties:{kc_id:"8a82807e-8fd6-57e8-ac96-c3666a89c478", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mike and Ike: diagnostic misconception 1351", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of Mike and Ike. Separate the specific account of Mike and Ike on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of Mike and Ike in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_MILLENNIALS_DIAGNOSTIC_MISCONCEPTION_1352_B7D651", properties:{kc_id:"56fdce3e-c70a-5ee6-8119-bd813b4dda92", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Millennials: diagnostic misconception 1352", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 102, in the textbook's discussion of Millennials. Read what the source actually reports about Millennials, then apply the definition of consumer market: a market where consumers purchase products and/or services for consumption", status:"approved", flawed_rule:"The example involving Millennials is interpreted using this faulty rule about consumer market: Purchases for industrial production belong to the consumer market."}}, {misconception_id:"MISC_MINTEL_DIAGNOSTIC_MISCONCEPTION_1353_4E1C38", properties:{kc_id:"10880fcd-98a7-58a9-a895-3b056716d881", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mintel: diagnostic misconception 1353", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 35, in the textbook's discussion of Mintel. Read what the source actually reports about Mintel, then apply the definition of product concept: the orientation that consumers will favor those products that offer the most quality, performance, or innovative features", status:"approved", flawed_rule:"The example involving Mintel is interpreted using this faulty rule about product concept: The product concept is the same as researching and prioritizing customer needs."}}, {misconception_id:"MISC_MIRROR_DIAGNOSTIC_MISCONCEPTION_1354_65C8E0", properties:{kc_id:"13116d6c-a9c4-511b-ab07-b8e71b6c6538", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Mirror: diagnostic misconception 1354", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 162, in the textbook's discussion of Mirror. Read what the source actually reports about Mirror, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving Mirror is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_MODELO_ESPECIAL_DIAGNOSTIC_MISCONCEPTION_1355_353D79", properties:{kc_id:"f47fbe71-7fc8-5a88-a8a0-aeb941ef0ef9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Modelo Especial: diagnostic misconception 1355", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 267, in the textbook's discussion of Modelo Especial. Read what the source actually reports about Modelo Especial, then apply the definition of Hispanic population: largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe", status:"approved", flawed_rule:"The example involving Modelo Especial is interpreted using this faulty rule about Hispanic population: Hispanic identity implies one race, nationality, or level of Spanish-language preference."}}, {misconception_id:"MISC_MORTON_S_SALT_DIAGNOSTIC_MISCONCEPTION_1356_CF4114", properties:{kc_id:"74d66b1f-fd42-590d-ade8-0545816142fe", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Morton’s Salt: diagnostic misconception 1356", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Morton’s Salt. Read what the source actually reports about Morton’s Salt, then apply the definition of national brands: name brands that sell a product or service under its corporate name and identity", status:"approved", flawed_rule:"The example involving Morton’s Salt is interpreted using this faulty rule about national brands: A national brand is the retailer's own private label."}}, {misconception_id:"MISC_MYPILLOW_DIAGNOSTIC_MISCONCEPTION_1357_D0D38D", properties:{kc_id:"c792c082-b067-56d6-80e2-cc2ce3810a5c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"MyPillow: diagnostic misconception 1357", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 461, in the textbook's discussion of MyPillow. Read what the source actually reports about MyPillow, then apply the definition of buy one get one (BOGO): promotion strategy in which consumers are offered the opportunity to buy one product at regular price and get a second item free", status:"approved", flawed_rule:"The example involving MyPillow is interpreted using this faulty rule about buy one get one (BOGO): A BOGO offer necessarily generates profit regardless of product cost and cannibalization."}}, {misconception_id:"MISC_NABISCO_DIAGNOSTIC_MISCONCEPTION_1358_1F559F", properties:{kc_id:"8e70356c-25c5-5d75-b003-2299394d314e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nabisco: diagnostic misconception 1358", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 326, in the textbook's discussion of Nabisco. Read what the source actually reports about Nabisco, then apply the definition of new brands: an entirely different brand entity from a parent company", status:"approved", flawed_rule:"The example involving Nabisco is interpreted using this faulty rule about new brands: A new brand is merely a new package size under the same existing name."}}, {misconception_id:"MISC_NAKED_WINES_DIAGNOSTIC_MISCONCEPTION_1359_5E776A", properties:{kc_id:"72f3159f-e8c3-5104-853f-a928773de0f0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Naked Wines: diagnostic misconception 1359", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 433, in the textbook's discussion of Naked Wines. Read what the source actually reports about Naked Wines, then apply the definition of market share–oriented objective: setting prices at, below, or above competitors in an effort to increase market share", status:"approved", flawed_rule:"The example involving Naked Wines is interpreted using this faulty rule about market share–oriented objective: A market-share pricing objective necessarily maximizes short-term profit."}}, {misconception_id:"MISC_NASCO_GULF_DIAGNOSTIC_MISCONCEPTION_1360_44B2DF", properties:{kc_id:"bfbf5b9d-db15-5972-a823-15e37adc0630", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nasco Gulf: diagnostic misconception 1360", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 396, in the textbook's discussion of Nasco Gulf. Read what the source actually reports about Nasco Gulf, then apply the definition of customer gap: in the Gap Model of Service Quality, the variance between the customer’s expectations and their perception of the service", status:"approved", flawed_rule:"The example involving Nasco Gulf is interpreted using this faulty rule about customer gap: Meeting internal specifications guarantees that customers' expectations are met."}}, {misconception_id:"MISC_NATIONAL_ASSOCIATION_FOR_THE_ADVANCEMENT_OF_COLO_F00443", properties:{kc_id:"c6129496-1d00-556a-bb37-f05262caa352", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"National Association for the Advancement of Colored People (NAACP): diagnostic misconception 1361", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of National Association for the Advancement of Colored People (NAACP). Read what the source actually reports about National Association for the Advancement of Colored People (NAACP), then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving National Association for the Advancement of Colored People (NAACP) is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_NATIONAL_ASSOCIATION_OF_REALTORS_DIAGNOSTIC_MISC_CA2EE1", properties:{kc_id:"7eaef56a-391a-562c-b33e-23036033c0e9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"National Association of Realtors: diagnostic misconception 1362", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of National Association of Realtors. Read what the source actually reports about National Association of Realtors, then apply the definition of impact: how quickly members of the audience receive an advertising message", status:"approved", flawed_rule:"The example involving National Association of Realtors is interpreted using this faulty rule about impact: Exposure or fast message delivery alone proves persuasion and sales effectiveness."}}, {misconception_id:"MISC_NATIONAL_GEOGRAPHIC_DIAGNOSTIC_MISCONCEPTION_136_186B9A", properties:{kc_id:"f098e737-327d-5371-8231-59a3ff001973", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"National Geographic: diagnostic misconception 1363", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 559, in the textbook's discussion of National Geographic. Read what the source actually reports about National Geographic, then apply the definition of social engagement: relates to the number of actions that social media users take in direct relation to your company, brand, or product", status:"approved", flawed_rule:"The example involving National Geographic is interpreted using this faulty rule about social engagement: Likes and comments necessarily represent positive sentiment and profitable demand."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_NATIONAL_IMMIGRATION_LAW_CENTER_DIAGNOSTIC_MISCO_26B75E", properties:{kc_id:"83bfd483-0fb9-5675-a72c-cdd33276e45e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"National Immigration Law Center: diagnostic misconception 1364", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of National Immigration Law Center. Read what the source actually reports about National Immigration Law Center, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving National Immigration Law Center is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_NATIONAL_ORGANIZATION_ON_DISABILITY_DIAGNOSTIC_M_410A67", properties:{kc_id:"bd3dd352-4ba9-5c02-8615-d73ac1d12335", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"National Organization on Disability: diagnostic misconception 1365", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of National Organization on Disability. Read what the source actually reports about National Organization on Disability, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving National Organization on Disability is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_NATIONAL_PARK_FOUNDATION_DIAGNOSTIC_MISCONCEPTIO_19D4A9", properties:{kc_id:"49e694d2-dfb2-535d-996d-90ef8d3f9642", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"National Park Foundation: diagnostic misconception 1366", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of National Park Foundation. Read what the source actually reports about National Park Foundation, then apply the definition of advertising: a paid form of nonpersonal communication about a product, service, or idea", status:"approved", flawed_rule:"The example involving National Park Foundation is interpreted using this faulty rule about advertising: Every favorable media mention is paid advertising."}}, {misconception_id:"MISC_NATIONAL_URBAN_LEAGUE_DIAGNOSTIC_MISCONCEPTION_1_7B05F4", properties:{kc_id:"177607fa-f4e5-5490-a282-392886cf2f10", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"National Urban League: diagnostic misconception 1367", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of National Urban League. Read what the source actually reports about National Urban League, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving National Urban League is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_NATURAL_GROCERS_DIAGNOSTIC_MISCONCEPTION_1368_2443BF", properties:{kc_id:"4cb43010-40a4-5041-8d3d-346543d748a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Natural Grocers: diagnostic misconception 1368", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 642, in the textbook's discussion of Natural Grocers. Separate the specific account of Natural Grocers on printed page 642 from a universal claim. The source passage is: There are other supermarkets known for ethical practices. These include Natural Grocers, Sprouts, Costco, and Whole Foods.47", status:"approved", flawed_rule:"The mention of Natural Grocers in ethical issues in retailing and wholesaling establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_NATURE_VALLEY_DIAGNOSTIC_MISCONCEPTION_1369_F5DA2C", properties:{kc_id:"29d3bdae-29d5-5a96-b4fb-d1315f881d64", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nature Valley: diagnostic misconception 1369", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 345, in the textbook's discussion of Nature Valley. Read what the source actually reports about Nature Valley, then apply the definition of new-to-the-firm products: products that are new to a company but not to the world", status:"approved", flawed_rule:"The example involving Nature Valley is interpreted using this faulty rule about new-to-the-firm products: An offering new to one company must be new to every customer worldwide."}}, {misconception_id:"MISC_NBA_DIAGNOSTIC_MISCONCEPTION_1370_8A7C02", properties:{kc_id:"c9188bac-e59d-542d-be96-8a858e32966c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"NBA: diagnostic misconception 1370", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 12, in the textbook's discussion of NBA. Read what the source actually reports about NBA, then apply the definition of marketing strategy: a plan of action designed to promote or sell a product or service", status:"approved", flawed_rule:"The example involving NBA is interpreted using this faulty rule about marketing strategy: A list of advertisements is a complete marketing strategy."}}, {misconception_id:"MISC_NEST_DIAGNOSTIC_MISCONCEPTION_1371_DAC621", properties:{kc_id:"f2c4da35-41c0-52c5-a23c-29c1db6c1b46", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nest: diagnostic misconception 1371", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 307, in the textbook's discussion of Nest. Read what the source actually reports about Nest, then apply the definition of product mix: all the products a company sells", status:"approved", flawed_rule:"The example involving Nest is interpreted using this faulty rule about product mix: The product mix refers only to promotional tactics."}}, {misconception_id:"MISC_NESTL_DIAGNOSTIC_MISCONCEPTION_1372_19A9B9", properties:{kc_id:"4abd1ac6-c3b8-5fce-b5e9-9798e1faa645", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nestlé: diagnostic misconception 1372", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 239, in the textbook's discussion of Nestlé. Read what the source actually reports about Nestlé, then apply the definition of product adaptation: when companies modify products to align with the local culture", status:"approved", flawed_rule:"The example involving Nestlé is interpreted using this faulty rule about product adaptation: A product can only be adapted by translating its advertising."}}, {misconception_id:"MISC_NETFLIX_DIAGNOSTIC_MISCONCEPTION_1373_7D24F2", properties:{kc_id:"af5a4c3c-9998-55c9-b360-f1c70c0c3375", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Netflix: diagnostic misconception 1373", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 20, in the textbook's discussion of Netflix. Read what the source actually reports about Netflix, then apply the definition of real needs: the value the customer is going to derive from the stated good or service", status:"approved", flawed_rule:"The example involving Netflix is interpreted using this faulty rule about real needs: A customer's stated product specification always reveals the underlying benefit sought."}}, {misconception_id:"MISC_NEW_BALANCE_DIAGNOSTIC_MISCONCEPTION_1374_016261", properties:{kc_id:"422ad941-4dbb-589d-aef4-813990758ce3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"New Balance: diagnostic misconception 1374", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 554, in the textbook's discussion of New Balance. Read what the source actually reports about New Balance, then apply the definition of content marketing: creating and distributing online content that is valuable and relevant to a company’s target customers", status:"approved", flawed_rule:"The example involving New Balance is interpreted using this faulty rule about content marketing: Content marketing is simply an uninterrupted sequence of product advertisements."}}, {misconception_id:"MISC_NEW_BELGIUM_BREWERY_DIAGNOSTIC_MISCONCEPTION_137_5A1B92", properties:{kc_id:"009ead92-42cc-5882-b497-0ad324102c2c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"New Belgium Brewery: diagnostic misconception 1375", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 656, in the textbook's discussion of New Belgium Brewery. Read what the source actually reports about New Belgium Brewery, then apply the definition of environmental pillar: the sustainability pillar that focuses on reducing a company’s impact on the environment", status:"approved", flawed_rule:"The example involving New Belgium Brewery is interpreted using this faulty rule about environmental pillar: A green advertisement alone establishes reduced environmental impact."}}, {misconception_id:"MISC_NEW_YORK_TIMES_DIAGNOSTIC_MISCONCEPTION_1376_B6637A", properties:{kc_id:"bf308806-b50b-54a8-8f07-ec9f80d9e959", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"New York Times: diagnostic misconception 1376", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 87, in the textbook's discussion of New York Times. Separate the specific account of New York Times on printed page 87 from a universal claim. The source passage is: The Blue Zones became a New York Times best seller. Media attention followed, and soon there was increased interest in the lifestyles within the Blue Zones. People began to recognize the Blue Zones as the happiest places to live. Communities were looking for ways to emulate the lifestyles and successes of these regions and in turn boost their longevity.", status:"approved", flawed_rule:"The mention of New York Times in developing a strategic plan establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_NEWVANTAGE_PARTNERS_DIAGNOSTIC_MISCONCEPTION_137_DD93F0", properties:{kc_id:"0f8c1793-c9b8-5242-a630-661cb3980c71", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"NewVantage Partners: diagnostic misconception 1377", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 199, in the textbook's discussion of NewVantage Partners. Read what the source actually reports about NewVantage Partners, then apply the definition of big data: the countless number of records that continues in an increasing capacity and at a faster rate; often described as volume, velocity, and variety of data generated", status:"approved", flawed_rule:"The example involving NewVantage Partners is interpreted using this faulty rule about big data: Large data volume automatically eliminates sampling bias and poor measurement."}}, {misconception_id:"MISC_NFL_DIAGNOSTIC_MISCONCEPTION_1378_97ECC3", properties:{kc_id:"6ef87826-a0d6-5b94-8cd1-d93cb03f6b10", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"NFL: diagnostic misconception 1378", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 229, in the textbook's discussion of NFL. Read what the source actually reports about NFL, then apply the definition of trade blocs: intergovernmental agreements that remove barriers to trade within regions of the world", status:"approved", flawed_rule:"The example involving NFL is interpreted using this faulty rule about trade blocs: Membership in a trade bloc eliminates every regulatory and cultural difference."}}, {misconception_id:"MISC_NFLSHOP_COM_DIAGNOSTIC_MISCONCEPTION_1379_9F4FB8", properties:{kc_id:"61b7cf57-4f7d-5d5e-9e5f-9204c9ae375b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"NFLshop.com: diagnostic misconception 1379", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 563, in the textbook's discussion of NFLshop.com. Read what the source actually reports about NFLshop.com, then apply the definition of SERP (Search Engine Results Page): the list of search results that displays on a search engine’s page after someone enters key search terms into a search query box", status:"approved", flawed_rule:"The example involving NFLshop.com is interpreted using this faulty rule about SERP (Search Engine Results Page): Every result on a search results page is organic and unpaid."}}, {misconception_id:"MISC_NICKELODEON_DIAGNOSTIC_MISCONCEPTION_1380_49ACE4", properties:{kc_id:"679ed5a9-6e2c-5804-a882-acc8f03e876d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nickelodeon: diagnostic misconception 1380", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 495, in the textbook's discussion of Nickelodeon. Read what the source actually reports about Nickelodeon, then apply the definition of product advertisements: advertisements that promote a specific product within the organization’s product mix", status:"approved", flawed_rule:"The example involving Nickelodeon is interpreted using this faulty rule about product advertisements: Product advertisements primarily promote an entire organization's public standing."}}, {misconception_id:"MISC_NIELSEN_COMPANY_DIAGNOSTIC_MISCONCEPTION_1381_6D1CAA", properties:{kc_id:"2fe25854-cf57-559f-93f3-f0d04c1a1d7d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nielsen Company: diagnostic misconception 1381", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 486, in the textbook's discussion of Nielsen Company. Read what the source actually reports about Nielsen Company, then apply the definition of all-you-can-afford approach: advertising budget approach that ensures everything else in the organization is budgeted for and then sets aside the remaining funds for advertising", status:"approved", flawed_rule:"The example involving Nielsen Company is interpreted using this faulty rule about all-you-can-afford approach: An affordable advertising budget necessarily matches the resources needed to reach campaign objectives."}}, {misconception_id:"MISC_NIKE_DIAGNOSTIC_MISCONCEPTION_1382_D51433", properties:{kc_id:"46284759-c35e-563d-8171-f72fd8519023", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nike: diagnostic misconception 1382", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 98, in the textbook's discussion of Nike. Read what the source actually reports about Nike, then apply the definition of complex buying behavior: the consumer buying behavior that occurs when the consumer is highly involved with the purchase and perceives significant differences between brands", status:"approved", flawed_rule:"The example involving Nike is interpreted using this faulty rule about complex buying behavior: All expensive purchases involve little deliberation and no perceived brand differences."}}, {misconception_id:"MISC_NIVEA_DIAGNOSTIC_MISCONCEPTION_1383_52F1E7", properties:{kc_id:"4937204b-80f1-556f-abaa-067be1101ed7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nivea: diagnostic misconception 1383", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 230, in the textbook's discussion of Nivea. Separate the specific account of Nivea on printed page 230 from a universal claim. The source passage is: Two examples of companies not readily prepared come from Nivea and Gucci. In 2017, Nivea launched a social media campaigned stating “White Is Purity.” The phrase was perceived by the public as being racially insensitive. To make matters worse, the slogan was then used by white supremacists in their propaganda.17 While the company apologized and removed the campaign, these marketers should never have let the campaign leave the idea room. In 2019, luxury fashion designer Gucci introduced a balaclava knit jumper that had material that went up and around the mouth. The advertisement for this clothing featured a White woman modeling the sweater with bright red lipstick. Many critics…", status:"approved", flawed_rule:"The mention of Nivea in the global market and advantages of international trade establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_NORDSTROM_DIAGNOSTIC_MISCONCEPTION_1384_A5E2F9", properties:{kc_id:"7eb4fe67-df6c-5d17-a14a-554b7ecaf9d0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nordstrom: diagnostic misconception 1384", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 223, in the textbook's discussion of Nordstrom. Read what the source actually reports about Nordstrom, then apply the definition of marketing research: the function that links the consumer, customer, and public to the marketer through information", status:"approved", flawed_rule:"The example involving Nordstrom is interpreted using this faulty rule about marketing research: Research is conducted only after the marketer has already selected the desired answer."}}, {misconception_id:"MISC_NOTHING_BUNDT_CAKES_DIAGNOSTIC_MISCONCEPTION_138_8A1987", properties:{kc_id:"afbbdf38-994f-58b4-a491-a8a5084c2d39", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Nothing Bundt Cakes: diagnostic misconception 1385", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 558, in the textbook's discussion of Nothing Bundt Cakes. Read what the source actually reports about Nothing Bundt Cakes, then apply the definition of mobile marketing: using multiple digital marketing channels that are designed to reach consumers on their smartphones and tablets", status:"approved", flawed_rule:"The example involving Nothing Bundt Cakes is interpreted using this faulty rule about mobile marketing: A desktop campaign can always be copied unchanged onto a small screen."}}, {misconception_id:"MISC_OCEAN_PARK_DIAGNOSTIC_MISCONCEPTION_1386_E412FC", properties:{kc_id:"6ac926dc-52ee-5e67-a390-fbd7743ad224", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ocean Park: diagnostic misconception 1386", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 238, in the textbook's discussion of Ocean Park. Read what the source actually reports about Ocean Park, then apply the definition of cultural sensitivity: awareness and appreciation of and the ability to adapt to a cultural, ethnic, racial, or another group other than one’s own", status:"approved", flawed_rule:"The example involving Ocean Park is interpreted using this faulty rule about cultural sensitivity: Translating words is sufficient to understand another market's cultural meaning."}}, {misconception_id:"MISC_OFFICE_DEPOT_DIAGNOSTIC_MISCONCEPTION_1387_A39A42", properties:{kc_id:"ccf9f384-ce69-516b-9f08-2292cf2ce112", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Office Depot: diagnostic misconception 1387", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 128, in the textbook's discussion of Office Depot. Separate the specific account of Office Depot on printed page 128 from a universal claim. The source passage is: Many businesses have both B2B and B2C components. For example, consider Office Depot. You may have stopped into an Office Depot store before the semester to stock up on pens, a ream of paper for your printer, or notebooks. That’s a B2C transaction. However, a large law firm or an accounting firm might order hundreds of reams of copy paper, folders, and print cartridges from Office Depot. That’s a B2B transaction.", status:"approved", flawed_rule:"The mention of Office Depot in the business-to-business (b2b) market establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_OLD_NAVY_DIAGNOSTIC_MISCONCEPTION_1388_AD7A0C", properties:{kc_id:"2a58e712-b2ef-5fd8-a006-c571c1ec8a63", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Old Navy: diagnostic misconception 1388", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 318, in the textbook's discussion of Old Navy. Read what the source actually reports about Old Navy, then apply the definition of rapid penetration pricing strategy: strategy that sets a lower-price strategy; appropriate when volume sales will increase market share quickly", status:"approved", flawed_rule:"The example involving Old Navy is interpreted using this faulty rule about rapid penetration pricing strategy: Rapid penetration combines high introductory prices with minimal promotion."}}, {misconception_id:"MISC_ORACLE_DIAGNOSTIC_MISCONCEPTION_1389_B61D9C", properties:{kc_id:"46b04d51-6b0e-5a99-8f75-8fe24b39c999", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Oracle: diagnostic misconception 1389", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 26, in the textbook's discussion of Oracle. Read what the source actually reports about Oracle, then apply the definition of sales concept: orientation that analyzes buying and selling effects to place the focus primarily on generating sales transactions", status:"approved", flawed_rule:"The example involving Oracle is interpreted using this faulty rule about sales concept: An aggressive selling orientation automatically produces long-term customer satisfaction."}}, {misconception_id:"MISC_OREO_DIAGNOSTIC_MISCONCEPTION_1390_7CF5A5", properties:{kc_id:"313c00c8-47c2-5ca6-995d-e76d817e810d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Oreo: diagnostic misconception 1390", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 325, in the textbook's discussion of Oreo. Read what the source actually reports about Oreo, then apply the definition of line extensions: products that create new opportunities for an existing product and brand", status:"approved", flawed_rule:"The example involving Oreo is interpreted using this faulty rule about line extensions: A line extension always introduces a wholly unrelated product category."}}, {misconception_id:"MISC_OSAGE_OUTLETS_DIAGNOSTIC_MISCONCEPTION_1391_A6B2F0", properties:{kc_id:"86fcdd94-3a66-56fb-a20b-9d2c5ce1e74b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Osage Outlets: diagnostic misconception 1391", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of Osage Outlets. Read what the source actually reports about Osage Outlets, then apply the definition of factory outlets: retailers that offer overstocked merchandise at discounted prices", status:"approved", flawed_rule:"The example involving Osage Outlets is interpreted using this faulty rule about factory outlets: Factory outlets and full-price flagship stores use identical inventory and pricing models."}}, {misconception_id:"MISC_OSI_DIAGNOSTIC_MISCONCEPTION_1392_D645B8", properties:{kc_id:"3f45635d-e035-50e2-bf3f-6e956be48de5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"OSI: diagnostic misconception 1392", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 132, in the textbook's discussion of OSI. Read what the source actually reports about OSI, then apply the definition of product specifications: a document carrying essential information to keep teams on track when designing and developing a product", status:"approved", flawed_rule:"The example involving OSI is interpreted using this faulty rule about product specifications: A product specification merely states the total purchasing budget."}}, {misconception_id:"MISC_OUTSTANDING_FOODS_DIAGNOSTIC_MISCONCEPTION_1393_6CB1E0", properties:{kc_id:"42d5dbd4-9354-5f38-910f-cc9d212fcc92", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Outstanding Foods: diagnostic misconception 1393", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 575, in the textbook's discussion of Outstanding Foods. Read what the source actually reports about Outstanding Foods, then apply the definition of target market coverage: resources and capabilities needed to reach consumers in a company’s target market", status:"approved", flawed_rule:"The example involving Outstanding Foods is interpreted using this faulty rule about target market coverage: More outlets necessarily mean better access to the intended target customers."}}, {misconception_id:"MISC_OXO_DIAGNOSTIC_MISCONCEPTION_1394_1189BE", properties:{kc_id:"ea3af1a9-73dc-539c-9638-85b4b63a9caa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"OXO: diagnostic misconception 1394", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 318, in the textbook's discussion of OXO. Read what the source actually reports about OXO, then apply the definition of growth stage: part of the product life cycle characterized by increasing sales; stage when copycat brands may enter the market", status:"approved", flawed_rule:"The example involving OXO is interpreted using this faulty rule about growth stage: Sales growth guarantees that no new competitors will enter."}}, {misconception_id:"MISC_PANAMA_CITY_BEACH_DIAGNOSTIC_MISCONCEPTION_1395_A938F0", properties:{kc_id:"bbf33ffb-b2c1-57c9-baa8-18385a3ebeda", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Panama City Beach: diagnostic misconception 1395", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 413, in the textbook's discussion of Panama City Beach. Read what the source actually reports about Panama City Beach, then apply the definition of break-even pricing: pricing strategy in which marketers choose a price that will cover all the costs of manufacturing", status:"approved", flawed_rule:"The example involving Panama City Beach is interpreted using this faulty rule about break-even pricing: Covering production costs guarantees a positive profit."}}, {misconception_id:"MISC_PANERA_BREAD_DIAGNOSTIC_MISCONCEPTION_1396_57690D", properties:{kc_id:"4a2ea057-8ace-547a-b318-3a484f94c70b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Panera Bread: diagnostic misconception 1396", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 60, in the textbook's discussion of Panera Bread. Read what the source actually reports about Panera Bread, then apply the definition of SWOT analysis: identification of internal strengths and weaknesses and external opportunities and threats impacting a business", status:"approved", flawed_rule:"The example involving Panera Bread is interpreted using this faulty rule about SWOT analysis: Opportunities and threats are internal attributes controlled by the firm."}}, {misconception_id:"MISC_PARTNERSHIP_FOR_A_HEALTHIER_AMERICA_PHA_DIAGNOST_043159", properties:{kc_id:"bc1345af-3164-5ea6-91c2-1e1189357428", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Partnership for a Healthier America (PHA): diagnostic misconception 1397", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 189, in the textbook's discussion of Partnership for a Healthier America (PHA). Separate the specific account of Partnership for a Healthier America (PHA) on printed page 189 from a universal claim. The source passage is: But Subway didn’t stop there. The company also teamed up with the Partnership for a Healthier America (PHA), a nonprofit organization that works with the private sector to help advance the goals of Mrs. Obama’s Let’s Move! initiative.", status:"approved", flawed_rule:"The mention of Partnership for a Healthier America (PHA) in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_PATAGONIA_DIAGNOSTIC_MISCONCEPTION_1398_70F754", properties:{kc_id:"5ff3fdf0-8813-5ef2-b506-15006d1ea632", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Patagonia: diagnostic misconception 1398", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 117, in the textbook's discussion of Patagonia. Separate the specific account of Patagonia on printed page 117 from a universal claim. The source passage is: Ethics and Corporations Hundreds of companies are known for being ethical, including Patagonia (more information later in this chapter), TOMS, and Conscious Coffees, among others. Read about five examples of truly ethical companies (https://openstax.org/r/trulyethicalcompanies) and how they are working to make an impact in their markets.", status:"approved", flawed_rule:"The mention of Patagonia in ethical issues in consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_PAYCHEX_DIAGNOSTIC_MISCONCEPTION_1399_8B9BBE", properties:{kc_id:"75747009-6cce-5f8b-9ad8-72f03bfcb33f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Paychex: diagnostic misconception 1399", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 519, in the textbook's discussion of Paychex. Read what the source actually reports about Paychex, then apply the definition of quantitative assessments: numbers driven and based on inputs and outputs of the sales cycle", status:"approved", flawed_rule:"The example involving Paychex is interpreted using this faulty rule about quantitative assessments: Activity counts alone prove high-quality and ethical selling."}}, {misconception_id:"MISC_PEEPS_DIAGNOSTIC_MISCONCEPTION_1400_62C994", properties:{kc_id:"425f022a-c50d-57e1-aca3-b596cf9259ea", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"PEEPS: diagnostic misconception 1400", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of PEEPS. Separate the specific account of PEEPS on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of PEEPS in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_PELOTON_DIAGNOSTIC_MISCONCEPTION_1401_44DB30", properties:{kc_id:"052c4af5-0292-5889-94b1-fa71c25b186f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Peloton: diagnostic misconception 1401", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 307, in the textbook's discussion of Peloton. Read what the source actually reports about Peloton, then apply the definition of product mix: all the products a company sells", status:"approved", flawed_rule:"The example involving Peloton is interpreted using this faulty rule about product mix: The product mix refers only to promotional tactics."}}, {misconception_id:"MISC_PENGUIN_RANDOM_HOUSE_DIAGNOSTIC_MISCONCEPTION_14_D4FEC5", properties:{kc_id:"45aa5df3-741d-506d-a5c3-23e9433c1ac9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Penguin/Random House: diagnostic misconception 1402", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 62, in the textbook's discussion of Penguin/Random House. Read what the source actually reports about Penguin/Random House, then apply the definition of concentric diversification: the addition of similar products or services to an existing business", status:"approved", flawed_rule:"The example involving Penguin/Random House is interpreted using this faulty rule about concentric diversification: Adding unrelated products is concentric diversification."}}, {misconception_id:"MISC_PEPPERIDGE_FARM_DIAGNOSTIC_MISCONCEPTION_1403_0707FB", properties:{kc_id:"aeca74ec-730a-5b66-ab99-4a6209ee559c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pepperidge Farm: diagnostic misconception 1403", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 526, in the textbook's discussion of Pepperidge Farm. Read what the source actually reports about Pepperidge Farm, then apply the definition of sales promotion: a short-term way of enticing the consumer to purchase a product or service", status:"approved", flawed_rule:"The example involving Pepperidge Farm is interpreted using this faulty rule about sales promotion: A temporary incentive necessarily creates durable brand loyalty."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_PEPSICO_DIAGNOSTIC_MISCONCEPTION_1404_9C5D40", properties:{kc_id:"44b31665-027c-57a9-8120-b1fdba19367c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"PepsiCo: diagnostic misconception 1404", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 11, in the textbook's discussion of PepsiCo. Read what the source actually reports about PepsiCo, then apply the definition of marketing mix: the set of actions or tactics that a company uses to promote its brand or product in the market", status:"approved", flawed_rule:"The example involving PepsiCo is interpreted using this faulty rule about marketing mix: Promotion alone constitutes the marketing mix."}}, {misconception_id:"MISC_PERSONALIZED_MEDIA_COMMUNICATIONS_LLC_DIAGNOSTIC_5BE1BC", properties:{kc_id:"9948bca3-381a-5053-a2e2-01ea0b0bfeb3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Personalized Media Communications LLC: diagnostic misconception 1405", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 364, in the textbook's discussion of Personalized Media Communications LLC. Read what the source actually reports about Personalized Media Communications LLC, then apply the definition of repositioned products: products that are retargeted for a new use", status:"approved", flawed_rule:"The example involving Personalized Media Communications LLC is interpreted using this faulty rule about repositioned products: A new use for an existing product always requires a new invention."}}, {misconception_id:"MISC_PETCO_DIAGNOSTIC_MISCONCEPTION_1406_D8E3F2", properties:{kc_id:"831ac25c-36bc-59b7-978e-d8c553e4ea57", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Petco: diagnostic misconception 1406", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 589, in the textbook's discussion of Petco. Read what the source actually reports about Petco, then apply the definition of target market coverage: resources and capabilities needed to reach consumers in a company’s target market", status:"approved", flawed_rule:"The example involving Petco is interpreted using this faulty rule about target market coverage: More outlets necessarily mean better access to the intended target customers."}}, {misconception_id:"MISC_PETSMART_DIAGNOSTIC_MISCONCEPTION_1407_8B490A", properties:{kc_id:"f31be9cb-e6fe-511b-872d-8e08087c11a3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"PetSmart: diagnostic misconception 1407", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 589, in the textbook's discussion of PetSmart. Read what the source actually reports about PetSmart, then apply the definition of target market coverage: resources and capabilities needed to reach consumers in a company’s target market", status:"approved", flawed_rule:"The example involving PetSmart is interpreted using this faulty rule about target market coverage: More outlets necessarily mean better access to the intended target customers."}}, {misconception_id:"MISC_PETVIVO_DIAGNOSTIC_MISCONCEPTION_1408_6B8D62", properties:{kc_id:"65271ed7-2dbe-5a70-b97c-412e87e844c1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"PetVivo: diagnostic misconception 1408", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 593, in the textbook's discussion of PetVivo. Read what the source actually reports about PetVivo, then apply the definition of channel member (intermediary): a company that works in a network with other companies to help gets products from manufacturers to final consumers", status:"approved", flawed_rule:"The example involving PetVivo is interpreted using this faulty rule about channel member (intermediary): Intermediaries merely add cost and perform no useful customer functions."}}, {misconception_id:"MISC_PEW_RESEARCH_CENTER_DIAGNOSTIC_MISCONCEPTION_140_8BC861", properties:{kc_id:"e32e8c1f-9e21-52be-8cb2-9d699a5f4603", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pew Research Center: diagnostic misconception 1409", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 281, in the textbook's discussion of Pew Research Center. Read what the source actually reports about Pew Research Center, then apply the definition of Black population: second largest multicultural group in the United States; made up of three different subethnicities: single race, Black Hispanic, or Black mixed with another race (White or Native American)", status:"approved", flawed_rule:"The example involving Pew Research Center is interpreted using this faulty rule about Black population: Black consumers share a single ancestry, identity, and purchasing pattern."}}, {misconception_id:"MISC_PFIZER_DIAGNOSTIC_MISCONCEPTION_1410_6B7890", properties:{kc_id:"b5b613af-7991-5995-91d4-846491036caa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pfizer: diagnostic misconception 1410", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 517, in the textbook's discussion of Pfizer. Read what the source actually reports about Pfizer, then apply the definition of sales force automation: a software tool that helps organizations acquire customers", status:"approved", flawed_rule:"The example involving Pfizer is interpreted using this faulty rule about sales force automation: Automating sales tasks eliminates the need for judgment and relationship building."}}, {misconception_id:"MISC_PHARMACEUTICAL_RESEARCH_AND_MANUFACTURERS_OF_AME_942D8A", properties:{kc_id:"24102392-a1d6-547d-841a-41fef4405e23", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pharmaceutical Research and Manufacturers of America: diagnostic misconception 1411", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of Pharmaceutical Research and Manufacturers of America. Read what the source actually reports about Pharmaceutical Research and Manufacturers of America, then apply the definition of impact: how quickly members of the audience receive an advertising message", status:"approved", flawed_rule:"The example involving Pharmaceutical Research and Manufacturers of America is interpreted using this faulty rule about impact: Exposure or fast message delivery alone proves persuasion and sales effectiveness."}}, {misconception_id:"MISC_PINTEREST_DIAGNOSTIC_MISCONCEPTION_1412_D197AC", properties:{kc_id:"66ddeb84-5b5e-55c2-a4e1-54e1a0cd64a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pinterest: diagnostic misconception 1412", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 67, in the textbook's discussion of Pinterest. Separate the specific account of Pinterest on printed page 67 from a universal claim. The source passage is: • Pinterest: “Help people discover the things they love, and inspire them to go do those things in their daily lives”52 • Spotify: “To unlock the potential of human creativity by giving a million creative artists the opportunity to", status:"approved", flawed_rule:"The mention of Pinterest in purpose and structure of the marketing plan establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_PITBULL_DIAGNOSTIC_MISCONCEPTION_1413_E4B861", properties:{kc_id:"be685265-8eb5-57b4-9407-13be5b535df6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pitbull: diagnostic misconception 1413", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 267, in the textbook's discussion of Pitbull. Read what the source actually reports about Pitbull, then apply the definition of Hispanic population: largest multicultural group in the United States; made up of diverse subethnicities and races originating from 20 different Spanish-speaking countries in North America, Central America, the Caribbean, South America, and Europe", status:"approved", flawed_rule:"The example involving Pitbull is interpreted using this faulty rule about Hispanic population: Hispanic identity implies one race, nationality, or level of Spanish-language preference."}}, {misconception_id:"MISC_POP_TARTS_DIAGNOSTIC_MISCONCEPTION_1414_602867", properties:{kc_id:"f9095d53-d89a-5566-b86c-2b01a789fad8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pop-Tarts: diagnostic misconception 1414", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 322, in the textbook's discussion of Pop-Tarts. Read what the source actually reports about Pop-Tarts, then apply the definition of brand name: the official name of a brand", status:"approved", flawed_rule:"The example involving Pop-Tarts is interpreted using this faulty rule about brand name: Choosing a brand name alone completes brand development."}}, {misconception_id:"MISC_PRECYCLE_DIAGNOSTIC_MISCONCEPTION_1415_954A0D", properties:{kc_id:"c076f37f-3859-5449-bb21-7ea6d65692cc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Precycle: diagnostic misconception 1415", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 611, in the textbook's discussion of Precycle. Read what the source actually reports about Precycle, then apply the definition of online retailing: a business model that allows consumers to search and purchase products remotely over the Internet", status:"approved", flawed_rule:"The example involving Precycle is interpreted using this faulty rule about online retailing: Online retailing removes all fulfillment and customer service requirements."}}, {misconception_id:"MISC_PRITCHARD_DIAGNOSTIC_MISCONCEPTION_1416_5911D5", properties:{kc_id:"a243d2d7-0209-535e-b18b-0ce15ef5b0cd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Pritchard: diagnostic misconception 1416", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 260, in the textbook's discussion of Pritchard. Read what the source actually reports about Pritchard, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving Pritchard is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_PROACTIV_DIAGNOSTIC_MISCONCEPTION_1417_BE2FC6", properties:{kc_id:"e139ff7a-cbaa-5b96-a4b3-697092dd65de", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Proactiv: diagnostic misconception 1417", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 543, in the textbook's discussion of Proactiv. Read what the source actually reports about Proactiv, then apply the definition of sales funnel: a visual representation of the customer journey from product awareness to product purchase", status:"approved", flawed_rule:"The example involving Proactiv is interpreted using this faulty rule about sales funnel: Every person who becomes aware of a product inevitably buys it."}}, {misconception_id:"MISC_PROCTER_GAMBLE_DIAGNOSTIC_MISCONCEPTION_1418_08646A", properties:{kc_id:"f16bf25e-8c65-55d3-ad35-bc174a122657", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Procter & Gamble: diagnostic misconception 1418", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 49, in the textbook's discussion of Procter & Gamble. Read what the source actually reports about Procter & Gamble, then apply the definition of strategic business unit: a relatively autonomous division of a large company that operates as an independent enterprise with responsibility for a particular range of products or activities", status:"approved", flawed_rule:"The example involving Procter & Gamble is interpreted using this faulty rule about strategic business unit: Every internal department is an independent strategic business unit."}}, {misconception_id:"MISC_PROSPANICA_DIAGNOSTIC_MISCONCEPTION_1419_9A02E0", properties:{kc_id:"1cffafda-6bd3-5fb1-a818-9097674946bc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Prospanica: diagnostic misconception 1419", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of Prospanica. Read what the source actually reports about Prospanica, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving Prospanica is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_PUBLISHERS_CLEARING_HOUSE_DIAGNOSTIC_MISCONCEPTI_1FC261", properties:{kc_id:"732b575d-11c3-577e-b2da-c1cf38525b0e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Publishers Clearing House: diagnostic misconception 1420", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 526, in the textbook's discussion of Publishers Clearing House. Read what the source actually reports about Publishers Clearing House, then apply the definition of sales promotion: a short-term way of enticing the consumer to purchase a product or service", status:"approved", flawed_rule:"The example involving Publishers Clearing House is interpreted using this faulty rule about sales promotion: A temporary incentive necessarily creates durable brand loyalty."}}, {misconception_id:"MISC_PUBLIX_DIAGNOSTIC_MISCONCEPTION_1421_8FB696", properties:{kc_id:"dda623c2-abde-539b-918f-d919f9bf91ce", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Publix: diagnostic misconception 1421", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 528, in the textbook's discussion of Publix. Read what the source actually reports about Publix, then apply the definition of cooperative advertising: an approach to paying for local advertising or retail advertising whereby the details are handled by a local retail store but is partly or fully paid for by a national manufacturer whose product is featured in the ad", status:"approved", flawed_rule:"The example involving Publix is interpreted using this faulty rule about cooperative advertising: A retailer must always bear the entire cost of local manufacturer-brand advertising."}}, {misconception_id:"MISC_PURINA_DIAGNOSTIC_MISCONCEPTION_1422_7A1B0B", properties:{kc_id:"240a214f-8372-51fa-953a-a2f926f04ba8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Purina: diagnostic misconception 1422", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 602, in the textbook's discussion of Purina. Read what the source actually reports about Purina, then apply the definition of supply chain: a network between a company and its suppliers to produce and distribute a specific product to the final buyer", status:"approved", flawed_rule:"The example involving Purina is interpreted using this faulty rule about supply chain: A supply chain starts at the retailer and excludes raw-material suppliers."}}, {misconception_id:"MISC_QVC_DIAGNOSTIC_MISCONCEPTION_1423_C7C758", properties:{kc_id:"1461baf9-381b-5bdb-be0d-e4701784a1b4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"QVC: diagnostic misconception 1423", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 624, in the textbook's discussion of QVC. Read what the source actually reports about QVC, then apply the definition of television home shopping: a business practice in which products or services are sold via television", status:"approved", flawed_rule:"The example involving QVC is interpreted using this faulty rule about television home shopping: Television home shopping requires the consumer to visit the seller's physical shop."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_RAMBLEWOOD_DIAGNOSTIC_MISCONCEPTION_1424_927288", properties:{kc_id:"d0100200-3599-5320-b24f-a8ae3c1990d7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ramblewood: diagnostic misconception 1424", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 341, in the textbook's discussion of Ramblewood. Read what the source actually reports about Ramblewood, then apply the definition of customer experience: the overarching impression that customers have of a brand", status:"approved", flawed_rule:"The example involving Ramblewood is interpreted using this faulty rule about customer experience: Customer experience consists only of the moment of payment."}}, {misconception_id:"MISC_RED_BULL_DIAGNOSTIC_MISCONCEPTION_1425_1875E5", properties:{kc_id:"748ccf28-d085-5480-b822-c1355b32aaa5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Red Bull: diagnostic misconception 1425", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 86, in the textbook's discussion of Red Bull. Read what the source actually reports about Red Bull, then apply the definition of product positioning: strategic exercise that defines where a product or service fits in the marketplace", status:"approved", flawed_rule:"The example involving Red Bull is interpreted using this faulty rule about product positioning: Positioning is the product's physical location on a store shelf."}}, {misconception_id:"MISC_REEBOK_DIAGNOSTIC_MISCONCEPTION_1426_13765B", properties:{kc_id:"89c6a968-413d-5336-834a-5ea55e60cbb9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Reebok: diagnostic misconception 1426", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 98, in the textbook's discussion of Reebok. Read what the source actually reports about Reebok, then apply the definition of complex buying behavior: the consumer buying behavior that occurs when the consumer is highly involved with the purchase and perceives significant differences between brands", status:"approved", flawed_rule:"The example involving Reebok is interpreted using this faulty rule about complex buying behavior: All expensive purchases involve little deliberation and no perceived brand differences."}}, {misconception_id:"MISC_REFINITIV_DIAGNOSTIC_MISCONCEPTION_1427_EF6A92", properties:{kc_id:"5ac84116-8762-5aaa-b979-5fbf63577e95", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Refinitiv: diagnostic misconception 1427", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 654, in the textbook's discussion of Refinitiv. Read what the source actually reports about Refinitiv, then apply the definition of economic pillar (governance pillar): the sustainability pillar that concerns profitability and business ethics", status:"approved", flawed_rule:"The example involving Refinitiv is interpreted using this faulty rule about economic pillar (governance pillar): Sustainability requires ignoring business viability and ethical governance."}}, {misconception_id:"MISC_REGAL_DIAGNOSTIC_MISCONCEPTION_1428_1D392F", properties:{kc_id:"80f30947-3a8d-5224-953f-2f87635a29c0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Regal: diagnostic misconception 1428", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 576, in the textbook's discussion of Regal. Read what the source actually reports about Regal, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving Regal is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_RETAILMENOT_DIAGNOSTIC_MISCONCEPTION_1429_30D270", properties:{kc_id:"40fa9d70-d3f6-509c-a88f-7de89a02451e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"RetailMeNot: diagnostic misconception 1429", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 450, in the textbook's discussion of RetailMeNot. Read what the source actually reports about RetailMeNot, then apply the definition of message strategy: method of developing a message based on how the message will best tie the brand to the target market", status:"approved", flawed_rule:"The example involving RetailMeNot is interpreted using this faulty rule about message strategy: A message strategy is only a choice of font, color, and production technique."}}, {misconception_id:"MISC_RETAILWIRE_DIAGNOSTIC_MISCONCEPTION_1430_6EE663", properties:{kc_id:"a6785be6-a0d2-5f47-b06d-b80a068d7e92", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"RetailWire: diagnostic misconception 1430", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 541, in the textbook's discussion of RetailWire. Read what the source actually reports about RetailWire, then apply the definition of email marketing: a type of direct marketing that is highly personal and designed to build relationships with consumers", status:"approved", flawed_rule:"The example involving RetailWire is interpreted using this faulty rule about email marketing: Sending the same unsolicited message to everyone builds strong relationships."}}, {misconception_id:"MISC_RIES_DIAGNOSTIC_MISCONCEPTION_1431_61F1B5", properties:{kc_id:"d86e68c8-1e03-55cb-bd3a-17b70f946185", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ries: diagnostic misconception 1431", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 181, in the textbook's discussion of Ries. Read what the source actually reports about Ries, then apply the definition of STP model: three-step marketing framework in which an organization segments the market, selects target market(s), and positions its products or services", status:"approved", flawed_rule:"The example involving Ries is interpreted using this faulty rule about STP model: Positioning can be chosen coherently before understanding segments and target customers."}}, {misconception_id:"MISC_RINGCENTRAL_DIAGNOSTIC_MISCONCEPTION_1432_D94C3E", properties:{kc_id:"166cd4ad-21f5-5a13-b759-73cf08e09b03", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"RingCentral: diagnostic misconception 1432", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 127, in the textbook's discussion of RingCentral. Read what the source actually reports about RingCentral, then apply the definition of product specifications: a document carrying essential information to keep teams on track when designing and developing a product", status:"approved", flawed_rule:"The example involving RingCentral is interpreted using this faulty rule about product specifications: A product specification merely states the total purchasing budget."}}, {misconception_id:"MISC_RITE_AID_DIAGNOSTIC_MISCONCEPTION_1433_442107", properties:{kc_id:"fa8035aa-b1ca-597f-9757-4ab04c8d523c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Rite Aid: diagnostic misconception 1433", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 577, in the textbook's discussion of Rite Aid. Read what the source actually reports about Rite Aid, then apply the definition of channel member (intermediary): a company that works in a network with other companies to help gets products from manufacturers to final consumers", status:"approved", flawed_rule:"The example involving Rite Aid is interpreted using this faulty rule about channel member (intermediary): Intermediaries merely add cost and perform no useful customer functions."}}, {misconception_id:"MISC_RITZ_CARLTON_DIAGNOSTIC_MISCONCEPTION_1434_42F481", properties:{kc_id:"b35564da-a322-5291-b02f-fc8a88692fe9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ritz-Carlton: diagnostic misconception 1434", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 182, in the textbook's discussion of Ritz-Carlton. Read what the source actually reports about Ritz-Carlton, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving Ritz-Carlton is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_ROLEX_DIAGNOSTIC_MISCONCEPTION_1435_F8683F", properties:{kc_id:"c4b65625-d6b2-52cc-82fe-6955f11f8777", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Rolex: diagnostic misconception 1435", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 588, in the textbook's discussion of Rolex. Read what the source actually reports about Rolex, then apply the definition of exclusive distribution: a strategy that involves allowing a limited number of intermediaries to distribute a company’s market offering", status:"approved", flawed_rule:"The example involving Rolex is interpreted using this faulty rule about exclusive distribution: Exclusive distribution means stocking the product through every available outlet."}}, {misconception_id:"MISC_RONALD_MCDONALD_HOUSE_CHARITIES_DIAGNOSTIC_MISCO_D2FCDA", properties:{kc_id:"83f10895-9134-5564-b704-42ffbd6206e5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ronald McDonald House Charities: diagnostic misconception 1436", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 133, in the textbook's discussion of Ronald McDonald House Charities. Read what the source actually reports about Ronald McDonald House Charities, then apply the definition of government markets: purchases made by the governing bodies of nations, states, or communities", status:"approved", flawed_rule:"The example involving Ronald McDonald House Charities is interpreted using this faulty rule about government markets: Government purchasing follows exactly the same priorities as private consumer purchasing."}}, {misconception_id:"MISC_ROSS_DIAGNOSTIC_MISCONCEPTION_1437_C3764A", properties:{kc_id:"c4578e9d-5d35-5580-8d46-545f3e2bb726", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ross: diagnostic misconception 1437", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 618, in the textbook's discussion of Ross. Read what the source actually reports about Ross, then apply the definition of off-price retailers: retailers that provide high-quality goods at lower prices", status:"approved", flawed_rule:"The example involving Ross is interpreted using this faulty rule about off-price retailers: Off-price retailers necessarily sell only defective goods."}}, {misconception_id:"MISC_ROYAL_CARIBBEAN_GROUP_DIAGNOSTIC_MISCONCEPTION_1_C7D5F4", properties:{kc_id:"ea68188b-b6f0-566b-9641-2a938c27b44e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Royal Caribbean Group: diagnostic misconception 1438", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 396, in the textbook's discussion of Royal Caribbean Group. Separate the specific account of Royal Caribbean Group on printed page 396 from a universal claim. The source passage is: Royal Caribbean Group is another company that takes its ethical behavior seriously. It has a Code of Business Conduct and Ethics decree that connects its core values (fairness, integrity, honesty, and trustworthiness) to all of its actions. Chairman and CEO Richard Fain reaffirms its commitment to integrity and an ethical culture and states, “Simply complying with the law is not enough; we need to be ABC (Above and Beyond Compliance).”46 Beyond just words, however, the company has established an ethics hotline managed by The Network, a leading third-party hotline provider. Through the use of this ethics hotline, employees can anonymously report their concerns about ethics…", status:"approved", flawed_rule:"The mention of Royal Caribbean Group in ethical considerations in providing services establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_RUN_DMC_DIAGNOSTIC_MISCONCEPTION_1439_D86C78", properties:{kc_id:"3e8cc964-5c59-5222-bdb8-a1e8d442e43f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Run DMC: diagnostic misconception 1439", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 99, in the textbook's discussion of Run DMC. Read what the source actually reports about Run DMC, then apply the definition of consumer buying behavior: the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"The example involving Run DMC is interpreted using this faulty rule about consumer buying behavior: Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_SAF_GARD_DIAGNOSTIC_MISCONCEPTION_1440_165308", properties:{kc_id:"46b9307a-e159-591f-b540-6aae381efe4c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Saf-Gard: diagnostic misconception 1440", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 159, in the textbook's discussion of Saf-Gard. Read what the source actually reports about Saf-Gard, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Saf-Gard is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_SALDANA_DIAGNOSTIC_MISCONCEPTION_1441_53C299", properties:{kc_id:"e3460653-d1eb-5a98-a19f-37e7eb8fb913", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Saldana: diagnostic misconception 1441", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Saldana. Separate the specific account of Saldana on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Saldana in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SALESFORCE_DIAGNOSTIC_MISCONCEPTION_1442_11100C", properties:{kc_id:"bbcc9a34-30c6-5814-b55a-84a9fd597505", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Salesforce: diagnostic misconception 1442", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 33, in the textbook's discussion of Salesforce. Read what the source actually reports about Salesforce, then apply the definition of customer equity: total combined customer lifetime values of all the company’s customers", status:"approved", flawed_rule:"The example involving Salesforce is interpreted using this faulty rule about customer equity: Customer equity is the revenue from this month's transactions."}}, {misconception_id:"MISC_SAM_S_CLUB_DIAGNOSTIC_MISCONCEPTION_1443_80EE8E", properties:{kc_id:"6779b0e1-79da-5cc2-82a0-6844942767ff", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sam’s Club: diagnostic misconception 1443", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 179, in the textbook's discussion of Sam’s Club. Read what the source actually reports about Sam’s Club, then apply the definition of undifferentiated marketing: also called mass marketing, a strategy that entails creating one message for an entire audience", status:"approved", flawed_rule:"The example involving Sam’s Club is interpreted using this faulty rule about undifferentiated marketing: Undifferentiated marketing requires separate offers for every segment."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_SAMSUNG_DIAGNOSTIC_MISCONCEPTION_1444_EE2807", properties:{kc_id:"6d79f325-bc32-5d74-94b1-a4882963692a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Samsung: diagnostic misconception 1444", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 416, in the textbook's discussion of Samsung. Read what the source actually reports about Samsung, then apply the definition of competition-based objective: product pricing based on the prices of a company’s competitors", status:"approved", flawed_rule:"The example involving Samsung is interpreted using this faulty rule about competition-based objective: Competitors' prices reveal the seller's own costs and customers' willingness to pay."}}, {misconception_id:"MISC_SAN_FRANCISCO_BATKID_DIAGNOSTIC_MISCONCEPTION_14_2AD861", properties:{kc_id:"6e50aafb-3453-5c22-a98a-03b7857c0691", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"San Francisco Batkid: diagnostic misconception 1445", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 491, in the textbook's discussion of San Francisco Batkid. Separate the specific account of San Francisco Batkid on printed page 491 from a universal claim. The source passage is: The San Francisco Batkid took social media by storm when the campaign was rolled out by Make-A-Wish Foundation. A boy fighting leukemia wished to be Batman, and the campaign went viral with the hashtag #SFBatman. People everywhere took time to volunteer and take part in the boy’s dream.", status:"approved", flawed_rule:"The mention of San Francisco Batkid in public relations and its role in the promotion mix establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SARGENTO_DIAGNOSTIC_MISCONCEPTION_1446_A8D35B", properties:{kc_id:"f7261318-5b56-5f69-9b12-7bb9592b5f73", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sargento: diagnostic misconception 1446", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 521, in the textbook's discussion of Sargento. Read what the source actually reports about Sargento, then apply the definition of sales promotion: a short-term way of enticing the consumer to purchase a product or service", status:"approved", flawed_rule:"The example involving Sargento is interpreted using this faulty rule about sales promotion: A temporary incentive necessarily creates durable brand loyalty."}}, {misconception_id:"MISC_SAVE_A_LOT_DIAGNOSTIC_MISCONCEPTION_1447_84C6D1", properties:{kc_id:"ec1b685f-8304-50b8-b8c2-bef968397725", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Save A Lot: diagnostic misconception 1447", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 617, in the textbook's discussion of Save A Lot. Read what the source actually reports about Save A Lot, then apply the definition of product traceability: the ability to track all processes for a product from the procurement of raw materials to production, consumption, and disposal", status:"approved", flawed_rule:"The example involving Save A Lot is interpreted using this faulty rule about product traceability: Traceability begins only when the finished item reaches the retailer."}}, {misconception_id:"MISC_SCALE_FINANCE_DIAGNOSTIC_MISCONCEPTION_1448_331176", properties:{kc_id:"ee94dfaf-035f-5af2-aae7-2d1265b043f4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Scale Finance: diagnostic misconception 1448", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 412, in the textbook's discussion of Scale Finance. Read what the source actually reports about Scale Finance, then apply the definition of bundle pricing: pricing strategy that promotes purchasing multiple items at once; used to prod customers to purchase (and spend) more than they may have otherwise", status:"approved", flawed_rule:"The example involving Scale Finance is interpreted using this faulty rule about bundle pricing: A bundle always saves every customer money regardless of whether all items are needed."}}, {misconception_id:"MISC_SCHULTZ_DIAGNOSTIC_MISCONCEPTION_1449_9509B7", properties:{kc_id:"63956f2e-5e24-522e-af9b-5583774181eb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Schultz: diagnostic misconception 1449", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 462, in the textbook's discussion of Schultz. Read what the source actually reports about Schultz, then apply the definition of return on customer investment (ROCI): a marginal analysis that shows the efficiency of marketing communication spending", status:"approved", flawed_rule:"The example involving Schultz is interpreted using this faulty rule about return on customer investment (ROCI): Communication efficiency can be assessed from spending alone without customer returns."}}, {misconception_id:"MISC_SCRUB_DADDY_DIAGNOSTIC_MISCONCEPTION_1450_C424E7", properties:{kc_id:"592711db-7b41-52a6-8e50-3ea5294bbb44", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Scrub Daddy: diagnostic misconception 1450", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 344, in the textbook's discussion of Scrub Daddy. Read what the source actually reports about Scrub Daddy, then apply the definition of new-to-the-world products: new product inventions that create new markets", status:"approved", flawed_rule:"The example involving Scrub Daddy is interpreted using this faulty rule about new-to-the-world products: A competitor imitation qualifies as a new-to-the-world product."}}, {misconception_id:"MISC_SEARS_ROEBUCK_AND_CO_DIAGNOSTIC_MISCONCEPTION_14_FE046F", properties:{kc_id:"855e5273-f7f1-57b7-b6c4-6ed78c242337", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sears Roebuck and Co.: diagnostic misconception 1451", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 623, in the textbook's discussion of Sears Roebuck and Co.. Read what the source actually reports about Sears Roebuck and Co., then apply the definition of direct mail: solicited or unsolicited advertising of products and services to prospective customers through the mail", status:"approved", flawed_rule:"The example involving Sears Roebuck and Co. is interpreted using this faulty rule about direct mail: Direct mail requires customers to visit a retail store to receive the message."}}, {misconception_id:"MISC_SEAWORLD_DIAGNOSTIC_MISCONCEPTION_1452_6C4B5E", properties:{kc_id:"d4b1fe19-2b0b-5002-99b3-12d6bf9345c3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"SeaWorld: diagnostic misconception 1452", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 489, in the textbook's discussion of SeaWorld. Read what the source actually reports about SeaWorld, then apply the definition of publicity: notice or attention given by the media", status:"approved", flawed_rule:"The example involving SeaWorld is interpreted using this faulty rule about publicity: Publicity is always favorable and fully controlled by the company."}}, {misconception_id:"MISC_SECURITIES_AND_EXCHANGE_COMMISSION_SEC_DIAGNOSTI_959DFA", properties:{kc_id:"b3a91aec-19d7-5623-b906-c413d475cccd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Securities and Exchange Commission (SEC): diagnostic misconception 1453", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 146, in the textbook's discussion of Securities and Exchange Commission (SEC). Read what the source actually reports about Securities and Exchange Commission (SEC), then apply the definition of Foreign Corrupt Practices Act (FCPA): a US statute that prohibits firms and individuals from paying bribes to foreign officials", status:"approved", flawed_rule:"The example involving Securities and Exchange Commission (SEC) is interpreted using this faulty rule about Foreign Corrupt Practices Act (FCPA): Bribery of foreign officials becomes acceptable whenever it is locally customary."}}, {misconception_id:"MISC_SEEDS_OF_PEACE_DIAGNOSTIC_MISCONCEPTION_1454_E1670C", properties:{kc_id:"74393ca7-80ff-5f3d-8305-89a0d1bf843e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Seeds of Peace: diagnostic misconception 1454", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 653, in the textbook's discussion of Seeds of Peace. Separate the specific account of Seeds of Peace on printed page 653 from a universal claim. The source passage is: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", status:"approved", flawed_rule:"The mention of Seeds of Peace in sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SEMICK_DIAGNOSTIC_MISCONCEPTION_1455_3721E7", properties:{kc_id:"1475146b-8918-5eae-9181-f578921f3771", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Semick: diagnostic misconception 1455", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 416, in the textbook's discussion of Semick. Read what the source actually reports about Semick, then apply the definition of customer value–based objective: product pricing based on a company’s understanding of the value-added benefits of a product", status:"approved", flawed_rule:"The example involving Semick is interpreted using this faulty rule about customer value–based objective: Customer value-based pricing must start from production cost alone."}}, {misconception_id:"MISC_SEMRUSH_DIAGNOSTIC_MISCONCEPTION_1456_D08CED", properties:{kc_id:"fb4cc4d5-8b0f-5a51-8ef5-6add9cd13f85", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Semrush: diagnostic misconception 1456", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 561, in the textbook's discussion of Semrush. Read what the source actually reports about Semrush, then apply the definition of search trends: data points that indicate how frequently a term is searched", status:"approved", flawed_rule:"The example involving Semrush is interpreted using this faulty rule about search trends: More searches for a term necessarily mean more purchases of one brand."}}, {misconception_id:"MISC_SEVENTEEN_DIAGNOSTIC_MISCONCEPTION_1457_C8A890", properties:{kc_id:"6615a5ae-95d7-5ce6-bddf-095fd0796fdf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Seventeen: diagnostic misconception 1457", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 495, in the textbook's discussion of Seventeen. Read what the source actually reports about Seventeen, then apply the definition of product advertisements: advertisements that promote a specific product within the organization’s product mix", status:"approved", flawed_rule:"The example involving Seventeen is interpreted using this faulty rule about product advertisements: Product advertisements primarily promote an entire organization's public standing."}}, {misconception_id:"MISC_SHARK_TANK_DIAGNOSTIC_MISCONCEPTION_1458_62EBEC", properties:{kc_id:"395473a7-c14c-5076-b6be-c3dd134ee18d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Shark Tank: diagnostic misconception 1458", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 344, in the textbook's discussion of Shark Tank. Read what the source actually reports about Shark Tank, then apply the definition of repositioned products: products that are retargeted for a new use", status:"approved", flawed_rule:"The example involving Shark Tank is interpreted using this faulty rule about repositioned products: A new use for an existing product always requires a new invention."}}, {misconception_id:"MISC_SHAW_INDUSTRIES_DIAGNOSTIC_MISCONCEPTION_1459_6C455D", properties:{kc_id:"556d389f-14c1-55f8-a294-561bf8659373", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Shaw Industries: diagnostic misconception 1459", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 351, in the textbook's discussion of Shaw Industries. Read what the source actually reports about Shaw Industries, then apply the definition of prototype: in new product development, the creation of a physical version of the product", status:"approved", flawed_rule:"The example involving Shaw Industries is interpreted using this faulty rule about prototype: A prototype must be identical to the final mass-produced version."}}, {misconception_id:"MISC_SHEDD_AQUARIUM_DIAGNOSTIC_MISCONCEPTION_1460_15E2DF", properties:{kc_id:"5b28ec86-d6ee-5051-b6d1-da6a8e64cdcb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Shedd Aquarium: diagnostic misconception 1460", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 661, in the textbook's discussion of Shedd Aquarium. Read what the source actually reports about Shedd Aquarium, then apply the definition of innovative marketing: Developing or improving offerings and marketing approaches to create customer value, discussed among the sustainable marketing principles in section 19.4. Avoid reading the glossary’s emphasis on media as an exhaustive definition of innovation.", status:"approved", flawed_rule:"The example involving Shedd Aquarium is interpreted using this faulty rule about innovative marketing: Marketing innovation is only using a fashionable medium, regardless of customer value."}}, {misconception_id:"MISC_SHERMAN_ANTITRUST_ACT_DIAGNOSTIC_MISCONCEPTION_1_9FF836", properties:{kc_id:"34258ac2-f5ac-530a-8d36-b976fc0c8f11", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sherman Antitrust Act: diagnostic misconception 1461", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 295, in the textbook's discussion of Sherman Antitrust Act. Read what the source actually reports about Sherman Antitrust Act, then apply the definition of multicultural marketing: a subcategory of diversity marketing aimed at intentionally targeting audiences based on different racial, ethnic, and cultural identities and backgrounds", status:"approved", flawed_rule:"The example involving Sherman Antitrust Act is interpreted using this faulty rule about multicultural marketing: Multicultural marketing merely translates the same advertisement into another language."}}, {misconception_id:"MISC_SHIFT_DIAGNOSTIC_MISCONCEPTION_1462_724976", properties:{kc_id:"9ae9a1e2-41fd-5105-823f-b8cee21fdb1d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Shift: diagnostic misconception 1462", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 362, in the textbook's discussion of Shift. Read what the source actually reports about Shift, then apply the definition of diffusion of innovation: theory about how products gain momentum and spread through a population or society", status:"approved", flawed_rule:"The example involving Shift is interpreted using this faulty rule about diffusion of innovation: All consumers adopt an innovation simultaneously after launch."}}, {misconception_id:"MISC_SHOPIFY_DIAGNOSTIC_MISCONCEPTION_1463_322605", properties:{kc_id:"4544ef76-c1ff-5fe6-8019-1ca30535fb5f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Shopify: diagnostic misconception 1463", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 545, in the textbook's discussion of Shopify. Read what the source actually reports about Shopify, then apply the definition of client reviews: involve feedback that a customer or client posts directly to a platform that can accessed by consumers during the buying process", status:"approved", flawed_rule:"The example involving Shopify is interpreted using this faulty rule about client reviews: A published customer review is necessarily representative and independently verified."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_SILENT_GENERATION_DIAGNOSTIC_MISCONCEPTION_1464_4077BB", properties:{kc_id:"a0f4d839-d1f1-5e2a-9578-52d1ea4ea3bc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Silent Generation: diagnostic misconception 1464", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 269, in the textbook's discussion of Silent Generation. Read what the source actually reports about Silent Generation, then apply the definition of LGBTQIA+ population: community composed of individuals who express a diversity of genders, preferences, and sexual orientations that include lesbian, gay, bisexual, transsexual, queer/questioning, intersex, asexual, and other sexual identities", status:"approved", flawed_rule:"The example involving Silent Generation is interpreted using this faulty rule about LGBTQIA+ population: All LGBTQIA+ customers have identical identities, needs, and purchase preferences."}}, {misconception_id:"MISC_SIMON_SCHUSTER_DIAGNOSTIC_MISCONCEPTION_1465_81C407", properties:{kc_id:"c1a63f99-eee0-53ea-a76a-8f82e70855d0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Simon & Schuster: diagnostic misconception 1465", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 62, in the textbook's discussion of Simon & Schuster. Read what the source actually reports about Simon & Schuster, then apply the definition of concentric diversification: the addition of similar products or services to an existing business", status:"approved", flawed_rule:"The example involving Simon & Schuster is interpreted using this faulty rule about concentric diversification: Adding unrelated products is concentric diversification."}}, {misconception_id:"MISC_SMA_MARKETING_DIAGNOSTIC_MISCONCEPTION_1466_301C01", properties:{kc_id:"903a9551-a033-5dd2-8704-a50f8444eeb1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"SMA Marketing: diagnostic misconception 1466", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 53, in the textbook's discussion of SMA Marketing. Read what the source actually reports about SMA Marketing, then apply the definition of marketing dashboard: summarizes important marketing metrics and key performance indicators into easy- to-understand measurements", status:"approved", flawed_rule:"The example involving SMA Marketing is interpreted using this faulty rule about marketing dashboard: A dashboard improves decisions merely by displaying as many metrics as possible."}}, {misconception_id:"MISC_SMALLS_DIAGNOSTIC_MISCONCEPTION_1467_B65D3B", properties:{kc_id:"d89779d2-116b-5c71-83f1-d72471f72799", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Smalls: diagnostic misconception 1467", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Smalls. Separate the specific account of Smalls on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Smalls in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SMARTWATER_DIAGNOSTIC_MISCONCEPTION_1468_E0ECA9", properties:{kc_id:"6edd6898-2ef5-52b1-9bb5-005a518524c7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Smartwater: diagnostic misconception 1468", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Smartwater. Read what the source actually reports about Smartwater, then apply the definition of national brands: name brands that sell a product or service under its corporate name and identity", status:"approved", flawed_rule:"The example involving Smartwater is interpreted using this faulty rule about national brands: A national brand is the retailer's own private label."}}, {misconception_id:"MISC_SNAPCHAT_DIAGNOSTIC_MISCONCEPTION_1469_21E196", properties:{kc_id:"b399040d-c4db-5cc9-a5f9-8aef9bf223bb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Snapchat: diagnostic misconception 1469", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 551, in the textbook's discussion of Snapchat. Read what the source actually reports about Snapchat, then apply the definition of social media marketing: using social media platforms, such as Facebook, Instagram, LinkedIn, and Twitter, to deliver content that drives engagement with your brand", status:"approved", flawed_rule:"The example involving Snapchat is interpreted using this faulty rule about social media marketing: A follower count alone establishes campaign effectiveness."}}, {misconception_id:"MISC_SNICKERS_DIAGNOSTIC_MISCONCEPTION_1470_E0983B", properties:{kc_id:"91bfc985-7f62-51f1-87fe-654a23e4c7c1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Snickers: diagnostic misconception 1470", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 104, in the textbook's discussion of Snickers. Read what the source actually reports about Snickers, then apply the definition of Maslow’s hierarchy of needs: a theory of motivation by Abraham Maslow which states that five categories of human needs dictate an individual’s behavior", status:"approved", flawed_rule:"The example involving Snickers is interpreted using this faulty rule about Maslow’s hierarchy of needs: A single need category explains all customers' motives in all circumstances."}}, {misconception_id:"MISC_SONIC_DRIVE_IN_DIAGNOSTIC_MISCONCEPTION_1471_096AE1", properties:{kc_id:"848ec4e3-0b11-5740-8d94-bc46c9194728", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sonic Drive-In: diagnostic misconception 1471", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 522, in the textbook's discussion of Sonic Drive-In. Read what the source actually reports about Sonic Drive-In, then apply the definition of sales promotion: a short-term way of enticing the consumer to purchase a product or service", status:"approved", flawed_rule:"The example involving Sonic Drive-In is interpreted using this faulty rule about sales promotion: A temporary incentive necessarily creates durable brand loyalty."}}, {misconception_id:"MISC_SONOS_DIAGNOSTIC_MISCONCEPTION_1472_80C281", properties:{kc_id:"bada2873-3ae3-5272-87e2-e2458a898803", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sonos: diagnostic misconception 1472", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 364, in the textbook's discussion of Sonos. Read what the source actually reports about Sonos, then apply the definition of repositioned products: products that are retargeted for a new use", status:"approved", flawed_rule:"The example involving Sonos is interpreted using this faulty rule about repositioned products: A new use for an existing product always requires a new invention."}}, {misconception_id:"MISC_SONY_DIAGNOSTIC_MISCONCEPTION_1473_5E34D2", properties:{kc_id:"81198b15-3bc0-55b9-b665-552849f5d525", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sony: diagnostic misconception 1473", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 346, in the textbook's discussion of Sony. Read what the source actually reports about Sony, then apply the definition of discontinuous innovation: new-to-the-world products that require a significant change in consumer behavior when adopted", status:"approved", flawed_rule:"The example involving Sony is interpreted using this faulty rule about discontinuous innovation: Discontinuous innovation makes only a minor change to existing consumption habits."}}, {misconception_id:"MISC_SOUTHWEST_AIRLINES_DIAGNOSTIC_MISCONCEPTION_1474_B98DB1", properties:{kc_id:"847fb810-f0b4-5715-98df-1ec085faab54", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Southwest Airlines: diagnostic misconception 1474", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 36, in the textbook's discussion of Southwest Airlines. Read what the source actually reports about Southwest Airlines, then apply the definition of marketing concept: marketing philosophy that firms should analyze the needs of their customers and then make decisions to satisfy those needs better than the competition", status:"approved", flawed_rule:"The example involving Southwest Airlines is interpreted using this faulty rule about marketing concept: Superior technical features guarantee customer satisfaction without studying needs."}}, {misconception_id:"MISC_SPANX_DIAGNOSTIC_MISCONCEPTION_1475_EBBE66", properties:{kc_id:"bef93d31-2c1b-50a9-bf88-781189e354ed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"SPANX: diagnostic misconception 1475", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 444, in the textbook's discussion of SPANX. Read what the source actually reports about SPANX, then apply the definition of Internet/digital marketing: promotional method that utilizes the Internet and digital technology such as text messaging, phone applications, and social media to reach consumers", status:"approved", flawed_rule:"The example involving SPANX is interpreted using this faulty rule about Internet/digital marketing: Digital promotion consists exclusively of banner advertisements."}}, {misconception_id:"MISC_SPEEDWAY_DIAGNOSTIC_MISCONCEPTION_1476_A56493", properties:{kc_id:"6cc384c0-311e-5aff-bac2-9fe2a18b9943", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Speedway: diagnostic misconception 1476", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 617, in the textbook's discussion of Speedway. Read what the source actually reports about Speedway, then apply the definition of convenience store: a small retail business that stocks a limited range of everyday items such as groceries, snacks, soft drinks, tobacco, toiletries, and lottery tickets", status:"approved", flawed_rule:"The example involving Speedway is interpreted using this faulty rule about convenience store: A convenience store competes primarily through the widest full-service assortment."}}, {misconception_id:"MISC_SPOTIFY_DIAGNOSTIC_MISCONCEPTION_1477_1EC21C", properties:{kc_id:"2c1b85fe-032a-52c9-9427-5601c5b964c7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Spotify: diagnostic misconception 1477", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 67, in the textbook's discussion of Spotify. Separate the specific account of Spotify on printed page 67 from a universal claim. The source passage is: • Pinterest: “Help people discover the things they love, and inspire them to go do those things in their daily lives”52 • Spotify: “To unlock the potential of human creativity by giving a million creative artists the opportunity to", status:"approved", flawed_rule:"The mention of Spotify in purpose and structure of the marketing plan establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SPROUTS_DIAGNOSTIC_MISCONCEPTION_1478_A3FD81", properties:{kc_id:"227b2f2f-3e57-5056-ad11-74ac517c0496", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sprouts: diagnostic misconception 1478", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 642, in the textbook's discussion of Sprouts. Separate the specific account of Sprouts on printed page 642 from a universal claim. The source passage is: There are other supermarkets known for ethical practices. These include Natural Grocers, Sprouts, Costco, and Whole Foods.47", status:"approved", flawed_rule:"The mention of Sprouts in ethical issues in retailing and wholesaling establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SQUATTY_POTTY_DIAGNOSTIC_MISCONCEPTION_1479_D90B9F", properties:{kc_id:"73853a60-3f13-5ef9-9700-90e8750e8831", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Squatty Potty: diagnostic misconception 1479", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 344, in the textbook's discussion of Squatty Potty. Read what the source actually reports about Squatty Potty, then apply the definition of new-to-the-world products: new product inventions that create new markets", status:"approved", flawed_rule:"The example involving Squatty Potty is interpreted using this faulty rule about new-to-the-world products: A competitor imitation qualifies as a new-to-the-world product."}}, {misconception_id:"MISC_STAPLES_DIAGNOSTIC_MISCONCEPTION_1480_8C8439", properties:{kc_id:"4733f82e-bb42-55d9-862c-7ae77ebb7849", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Staples: diagnostic misconception 1480", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 617, in the textbook's discussion of Staples. Read what the source actually reports about Staples, then apply the definition of category killers: large superstores, most often chains stores, that are bigger, cheaper, and more convenient than competitors", status:"approved", flawed_rule:"The example involving Staples is interpreted using this faulty rule about category killers: Category killers carry all categories equally rather than dominating a specialty."}}, {misconception_id:"MISC_STARBUCKS_DIAGNOSTIC_MISCONCEPTION_1481_52AA3A", properties:{kc_id:"1c7bd9cc-fa2e-5b24-a4f2-ff64dc8065d4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Starbucks: diagnostic misconception 1481", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 26, in the textbook's discussion of Starbucks. Read what the source actually reports about Starbucks, then apply the definition of sales concept: orientation that analyzes buying and selling effects to place the focus primarily on generating sales transactions", status:"approved", flawed_rule:"The example involving Starbucks is interpreted using this faulty rule about sales concept: An aggressive selling orientation automatically produces long-term customer satisfaction."}}, {misconception_id:"MISC_STARKIST_DIAGNOSTIC_MISCONCEPTION_1482_D65F55", properties:{kc_id:"d6484a77-72c3-59c8-830e-ba03a86237bf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"StarKist: diagnostic misconception 1482", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 146, in the textbook's discussion of StarKist. Separate the specific account of StarKist on printed page 146 from a universal claim. The source passage is: Price fixing is illegal because it’s considered anticompetitive and hurts both consumers and businesses. Let’s illustrate with a real-life example with a company you’re likely familiar with—StarKist. In 2019, a San Francisco federal judge ordered the company to pay a fine in the amount of $100 million in connection with a canned tuna price-fixing conspiracy that involved StarKist, Bumble Bee Foods, and Chicken of the Sea, who regularly exchanged information about their sales and plans for pricing. The lawsuit alleged that, under the scheme, consumers were forced to pay more for canned tuna than they would have otherwise.21", status:"approved", flawed_rule:"The mention of StarKist in ethical issues in b2b marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_STATE_BAGS_DIAGNOSTIC_MISCONCEPTION_1483_BB777A", properties:{kc_id:"b504b017-2aec-5ec4-98ce-734ac992cf4e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"State Bags: diagnostic misconception 1483", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 653, in the textbook's discussion of State Bags. Separate the specific account of State Bags on printed page 653 from a universal claim. The source passage is: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", status:"approved", flawed_rule:"The mention of State Bags in sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_STATISTA_DIAGNOSTIC_MISCONCEPTION_1484_1B7BC6", properties:{kc_id:"d01d14f9-67e7-53d9-947d-9f00a8159b80", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Statista: diagnostic misconception 1484", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 117, in the textbook's discussion of Statista. Read what the source actually reports about Statista, then apply the definition of consumer market: a market where consumers purchase products and/or services for consumption", status:"approved", flawed_rule:"The example involving Statista is interpreted using this faulty rule about consumer market: Purchases for industrial production belong to the consumer market."}}, {misconception_id:"MISC_STEVE_MADDEN_DIAGNOSTIC_MISCONCEPTION_1485_9ABF6B", properties:{kc_id:"bdd73edb-1239-5471-8ba7-cd3fb66efd23", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Steve Madden: diagnostic misconception 1485", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 445, in the textbook's discussion of Steve Madden. Read what the source actually reports about Steve Madden, then apply the definition of Internet/digital marketing: promotional method that utilizes the Internet and digital technology such as text messaging, phone applications, and social media to reach consumers", status:"approved", flawed_rule:"The example involving Steve Madden is interpreted using this faulty rule about Internet/digital marketing: Digital promotion consists exclusively of banner advertisements."}}, {misconception_id:"MISC_STITCH_FIX_DIAGNOSTIC_MISCONCEPTION_1486_DAB9E7", properties:{kc_id:"9a5c3f17-527a-55a7-974a-b9fa91c8946a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Stitch Fix: diagnostic misconception 1486", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 180, in the textbook's discussion of Stitch Fix. Read what the source actually reports about Stitch Fix, then apply the definition of product positioning: the process of deciding and communicating how an organization wants its market to think and feel about a product or service", status:"approved", flawed_rule:"The example involving Stitch Fix is interpreted using this faulty rule about product positioning: Positioning is the product's physical location on a store shelf."}}, {misconception_id:"MISC_STONYFIELD_ORGANIC_DIAGNOSTIC_MISCONCEPTION_1487_A597F2", properties:{kc_id:"06b7b53c-b9e9-53e5-831f-00d8ff60490d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Stonyfield Organic: diagnostic misconception 1487", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 653, in the textbook's discussion of Stonyfield Organic. Read what the source actually reports about Stonyfield Organic, then apply the definition of environmental pillar: the sustainability pillar that focuses on reducing a company’s impact on the environment", status:"approved", flawed_rule:"The example involving Stonyfield Organic is interpreted using this faulty rule about environmental pillar: A green advertisement alone establishes reduced environmental impact."}}, {misconception_id:"MISC_SUBARU_DIAGNOSTIC_MISCONCEPTION_1488_5C932E", properties:{kc_id:"a35cc0c0-a577-5d62-bed2-8a51e1785be0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Subaru: diagnostic misconception 1488", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 465, in the textbook's discussion of Subaru. Read what the source actually reports about Subaru, then apply the definition of advertising: a paid form of nonpersonal communication about a product, service, or idea", status:"approved", flawed_rule:"The example involving Subaru is interpreted using this faulty rule about advertising: Every favorable media mention is paid advertising."}}, {misconception_id:"MISC_SUBARU_OF_INDIANA_AUTOMOTIVE_DIAGNOSTIC_MISCONCE_FD1F43", properties:{kc_id:"01548929-315b-55a1-819c-801622f07fc3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Subaru of Indiana Automotive: diagnostic misconception 1489", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 653, in the textbook's discussion of Subaru of Indiana Automotive. Read what the source actually reports about Subaru of Indiana Automotive, then apply the definition of environmental pillar: the sustainability pillar that focuses on reducing a company’s impact on the environment", status:"approved", flawed_rule:"The example involving Subaru of Indiana Automotive is interpreted using this faulty rule about environmental pillar: A green advertisement alone establishes reduced environmental impact."}}, {misconception_id:"MISC_SUBWAY_DIAGNOSTIC_MISCONCEPTION_1490_12525E", properties:{kc_id:"34c26541-606b-513a-871b-77c880dc8119", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Subway: diagnostic misconception 1490", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 189, in the textbook's discussion of Subway. Separate the specific account of Subway on printed page 189 from a universal claim. The source passage is: Back in 2014, Subway aligned itself with then–First Lady Michelle Obama’s Let’s Move! initiative. The company vowed to spend $41 million over a three-year period to promote a healthy-eating program aimed specifically toward children. The ad campaign bore the slogan “Playtime: Powered by Veggies.”", status:"approved", flawed_rule:"The mention of Subway in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SUNBELT_BAKERY_DIAGNOSTIC_MISCONCEPTION_1491_BAB9A4", properties:{kc_id:"3c2802f6-484e-5f43-b8f7-9fcd86b6b53f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sunbelt Bakery: diagnostic misconception 1491", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 470, in the textbook's discussion of Sunbelt Bakery. Separate the specific account of Sunbelt Bakery on printed page 470 from a universal claim. The source passage is: Among the company’s brands are Little Debbie, Sunbelt Bakery, Drake’s Cakes, and Fieldstone Bakery. The largest brand is Little Debbie, with a wide range of favorites from Apple Fruit Pies to Zebra Cakes. Little Debbie offers seasonal items in rotation, such as Christmas Tree Cakes. Distribution extends to all 50 states, Mexico, and Canada.", status:"approved", flawed_rule:"The mention of Sunbelt Bakery in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_SUPER_BOWL_DIAGNOSTIC_MISCONCEPTION_1492_F506E8", properties:{kc_id:"b0632fa7-d2e7-59bf-8c24-b906449eb009", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Super Bowl: diagnostic misconception 1492", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 297, in the textbook's discussion of Super Bowl. Read what the source actually reports about Super Bowl, then apply the definition of multicultural marketing: a subcategory of diversity marketing aimed at intentionally targeting audiences based on different racial, ethnic, and cultural identities and backgrounds", status:"approved", flawed_rule:"The example involving Super Bowl is interpreted using this faulty rule about multicultural marketing: Multicultural marketing merely translates the same advertisement into another language."}}, {misconception_id:"MISC_SUSAN_G_KOMEN_DIAGNOSTIC_MISCONCEPTION_1493_7ED649", properties:{kc_id:"fd5500ea-15a0-5604-8658-b0572b8542da", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Susan G. Komen: diagnostic misconception 1493", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of Susan G. Komen. Read what the source actually reports about Susan G. Komen, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Susan G. Komen is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_SWAROVSKI_DIAGNOSTIC_MISCONCEPTION_1494_7A8F5A", properties:{kc_id:"f1c6f4b1-deb8-59f1-82ce-ce667039f5ad", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Swarovski: diagnostic misconception 1494", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 343, in the textbook's discussion of Swarovski. Read what the source actually reports about Swarovski, then apply the definition of concept testing: market research method in which customers are presented with a description of a product or service", status:"approved", flawed_rule:"The example involving Swarovski is interpreted using this faulty rule about concept testing: Concept testing requires full-scale factory production before customer feedback."}}, {misconception_id:"MISC_SYSCO_DIAGNOSTIC_MISCONCEPTION_1495_4697FF", properties:{kc_id:"f4aefcad-ae3c-5ad0-ba4d-269647523576", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Sysco: diagnostic misconception 1495", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 637, in the textbook's discussion of Sysco. Read what the source actually reports about Sysco, then apply the definition of limited-service wholesalers: wholesalers that offer a limited range of services to retailers to increase value", status:"approved", flawed_rule:"The example involving Sysco is interpreted using this faulty rule about limited-service wholesalers: Limited-service wholesalers offer every possible supporting service."}}, {misconception_id:"MISC_T_J_MAXX_DIAGNOSTIC_MISCONCEPTION_1496_81AA0A", properties:{kc_id:"0148d0ca-c7d5-5016-8c47-03d036aed0d2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"T.J.Maxx: diagnostic misconception 1496", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 621, in the textbook's discussion of T.J.Maxx. Read what the source actually reports about T.J.Maxx, then apply the definition of off-price retailers: retailers that provide high-quality goods at lower prices", status:"approved", flawed_rule:"The example involving T.J.Maxx is interpreted using this faulty rule about off-price retailers: Off-price retailers necessarily sell only defective goods."}}, {misconception_id:"MISC_TACO_BELL_DIAGNOSTIC_MISCONCEPTION_1497_53E805", properties:{kc_id:"a628f468-c2eb-5575-a82c-588ab9c89085", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Taco Bell: diagnostic misconception 1497", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 322, in the textbook's discussion of Taco Bell. Read what the source actually reports about Taco Bell, then apply the definition of brand positioning: the way a brand signals emotions in consumers’ minds", status:"approved", flawed_rule:"The example involving Taco Bell is interpreted using this faulty rule about brand positioning: Brand positioning is determined exclusively by management intention, regardless of customer perception."}}, {misconception_id:"MISC_TALEX_DIAGNOSTIC_MISCONCEPTION_1498_F973E5", properties:{kc_id:"854f7129-fefd-555d-9ecd-0c9fc38b9787", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"TalEx: diagnostic misconception 1498", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 506, in the textbook's discussion of TalEx. Read what the source actually reports about TalEx, then apply the definition of relationship selling: a method of personal selling used to better understand the needs and wants of the buyer", status:"approved", flawed_rule:"The example involving TalEx is interpreted using this faulty rule about relationship selling: Relationship selling ends once the first transaction is closed."}}, {misconception_id:"MISC_TARGET_DIAGNOSTIC_MISCONCEPTION_1499_2E2973", properties:{kc_id:"0dcc9664-13f3-5f7d-b89f-773fb951ca7c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Target: diagnostic misconception 1499", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 25, in the textbook's discussion of Target. Read what the source actually reports about Target, then apply the definition of suppliers: sometimes also called vendors, these are partners from whom we receive the parts and products necessary for our business", status:"approved", flawed_rule:"The example involving Target is interpreted using this faulty rule about suppliers: Suppliers influence production but cannot affect the firm's marketing promises."}}, {misconception_id:"MISC_TARTE_COSMETICS_DIAGNOSTIC_MISCONCEPTION_1500_5AD436", properties:{kc_id:"a965ea43-0028-578a-9e6a-c80c110dd835", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tarte Cosmetics: diagnostic misconception 1500", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 265, in the textbook's discussion of Tarte Cosmetics. Read what the source actually reports about Tarte Cosmetics, then apply the definition of marketing mix: the four key elements—product, price, place, and promotion—that shape the development and execution of marketing objectives to reach a target market", status:"approved", flawed_rule:"The example involving Tarte Cosmetics is interpreted using this faulty rule about marketing mix: Promotion alone constitutes the marketing mix."}}, {misconception_id:"MISC_TBH_CREATIVE_DIAGNOSTIC_MISCONCEPTION_1501_37B622", properties:{kc_id:"155b78be-fbba-5ac0-b968-2a2df9ed1b1e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"TBH Creative: diagnostic misconception 1501", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 78, in the textbook's discussion of TBH Creative. Read what the source actually reports about TBH Creative, then apply the definition of marketing dashboard: summarizes important marketing metrics and key performance indicators into easy- to-understand measurements", status:"approved", flawed_rule:"The example involving TBH Creative is interpreted using this faulty rule about marketing dashboard: A dashboard improves decisions merely by displaying as many metrics as possible."}}, {misconception_id:"MISC_TEDDY_GRAHAMS_DIAGNOSTIC_MISCONCEPTION_1502_E086D4", properties:{kc_id:"978d34f4-7a04-58be-8cc9-661dd539eacf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Teddy Grahams: diagnostic misconception 1502", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 326, in the textbook's discussion of Teddy Grahams. Read what the source actually reports about Teddy Grahams, then apply the definition of new brands: an entirely different brand entity from a parent company", status:"approved", flawed_rule:"The example involving Teddy Grahams is interpreted using this faulty rule about new brands: A new brand is merely a new package size under the same existing name."}}, {misconception_id:"MISC_TELEPHONE_CONSUMER_PROTECTION_ACT_DIAGNOSTIC_MIS_6F9FE2", properties:{kc_id:"d1accb96-c3f1-5910-911e-8f985961dc47", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Telephone Consumer Protection Act: diagnostic misconception 1503", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 210, in the textbook's discussion of Telephone Consumer Protection Act. Read what the source actually reports about Telephone Consumer Protection Act, then apply the definition of phone surveys: surveys conducted through the use of a telephone that can be completed through digital or human methods", status:"approved", flawed_rule:"The example involving Telephone Consumer Protection Act is interpreted using this faulty rule about phone surveys: A telephone sampling frame necessarily includes every target customer."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_TENTREE_DIAGNOSTIC_MISCONCEPTION_1504_CECDE5", properties:{kc_id:"be46f861-c949-58ef-a902-019f351dd86a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tentree: diagnostic misconception 1504", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 531, in the textbook's discussion of Tentree. Read what the source actually reports about Tentree, then apply the definition of point-of-purchase displays: displays that allow manufacturers to showcase their products in a way that stands out from all the other products in the store", status:"approved", flawed_rule:"The example involving Tentree is interpreted using this faulty rule about point-of-purchase displays: In-store presentation cannot influence a decision already partly planned."}}, {misconception_id:"MISC_TESLA_DIAGNOSTIC_MISCONCEPTION_1505_BBA6F7", properties:{kc_id:"7168f979-4bfc-58cd-a18e-d0a62494c86a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tesla: diagnostic misconception 1505", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 25, in the textbook's discussion of Tesla. Separate the specific account of Tesla on printed page 25 from a universal claim. The source passage is: • Political Factors. These factors include environmental and trade restrictions, political stability, and business policy. For example, Tesla announced in late 2021 that it is moving its headquarters out of", status:"approved", flawed_rule:"The mention of Tesla in factors comprising and affecting the marketing environment establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_THE_HONEST_COMPANY_DIAGNOSTIC_MISCONCEPTION_1506_351195", properties:{kc_id:"0de8b5be-3bdc-52e1-bd93-f4fdbbed7fd4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"The Honest Company: diagnostic misconception 1506", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 284, in the textbook's discussion of The Honest Company. Read what the source actually reports about The Honest Company, then apply the definition of consumers with disabilities: sociodemographic group living with some type of disability related to mobility, learning, intellectual, or other types of functions; a very diverse group because disabilities span cultural, social, and demographic factors", status:"approved", flawed_rule:"The example involving The Honest Company is interpreted using this faulty rule about consumers with disabilities: One accessibility adjustment serves all types of disability equally well."}}, {misconception_id:"MISC_THE_INSIGHTS_ASSOCIATION_IA_DIAGNOSTIC_MISCONCEP_85731D", properties:{kc_id:"b0709c45-2793-59d9-965a-ecfceeddfd40", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"The Insights Association (IA): diagnostic misconception 1507", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 217, in the textbook's discussion of The Insights Association (IA). Read what the source actually reports about The Insights Association (IA), then apply the definition of marketing research: the function that links the consumer, customer, and public to the marketer through information", status:"approved", flawed_rule:"The example involving The Insights Association (IA) is interpreted using this faulty rule about marketing research: Research is conducted only after the marketer has already selected the desired answer."}}, {misconception_id:"MISC_THE_NETWORK_DIAGNOSTIC_MISCONCEPTION_1508_DBD2EA", properties:{kc_id:"95e2f96a-2099-5a67-9576-c55935eb0368", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"The Network: diagnostic misconception 1508", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 396, in the textbook's discussion of The Network. Separate the specific account of The Network on printed page 396 from a universal claim. The source passage is: Royal Caribbean Group is another company that takes its ethical behavior seriously. It has a Code of Business Conduct and Ethics decree that connects its core values (fairness, integrity, honesty, and trustworthiness) to all of its actions. Chairman and CEO Richard Fain reaffirms its commitment to integrity and an ethical culture and states, “Simply complying with the law is not enough; we need to be ABC (Above and Beyond Compliance).”46 Beyond just words, however, the company has established an ethics hotline managed by The Network, a leading third-party hotline provider. Through the use of this ethics hotline, employees can anonymously report their concerns about ethics…", status:"approved", flawed_rule:"The mention of The Network in ethical considerations in providing services establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_THE_PHD_PROJECT_DIAGNOSTIC_MISCONCEPTION_1509_BD7BEB", properties:{kc_id:"79a335dd-619a-5415-ace9-d86d106146ca", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"The PhD Project: diagnostic misconception 1509", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of The PhD Project. Read what the source actually reports about The PhD Project, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving The PhD Project is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_THE_TREVOR_PROJECT_DIAGNOSTIC_MISCONCEPTION_1510_65A41F", properties:{kc_id:"e58f3a0f-78a0-5036-a1e6-97d3f4fcb50c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"The Trevor Project: diagnostic misconception 1510", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 300, in the textbook's discussion of The Trevor Project. Read what the source actually reports about The Trevor Project, then apply the definition of Asian population: third largest multicultural group in the United States; made up of 22 different subethnicities from the Asian continent, Hawaii, and islands of the Pacific; can belong to a single race or mixed races", status:"approved", flawed_rule:"The example involving The Trevor Project is interpreted using this faulty rule about Asian population: Asian consumers form one culturally homogeneous market with identical languages and preferences."}}, {misconception_id:"MISC_THERMOMIX_DIAGNOSTIC_MISCONCEPTION_1511_54BAD9", properties:{kc_id:"57de243a-b4ae-5bf6-9df8-08a20d6911a7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Thermomix: diagnostic misconception 1511", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 394, in the textbook's discussion of Thermomix. Read what the source actually reports about Thermomix, then apply the definition of GAP Model of Service Quality: theoretical marketing model that helps to identify the gaps between the perceived service and the expected service", status:"approved", flawed_rule:"The example involving Thermomix is interpreted using this faulty rule about GAP Model of Service Quality: All service failures have the same cause and need the same remedy."}}, {misconception_id:"MISC_THIRDLOVE_DIAGNOSTIC_MISCONCEPTION_1512_C8A1FD", properties:{kc_id:"97a65232-8158-589e-b71f-e50092b0adc6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"ThirdLove: diagnostic misconception 1512", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 297, in the textbook's discussion of ThirdLove. Read what the source actually reports about ThirdLove, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving ThirdLove is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_TIDE_DIAGNOSTIC_MISCONCEPTION_1513_11BE98", properties:{kc_id:"7c1a225a-976d-519f-ba16-290ce751d409", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tide: diagnostic misconception 1513", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 331, in the textbook's discussion of Tide. Read what the source actually reports about Tide, then apply the definition of actual product: product available for purchase", status:"approved", flawed_rule:"The example involving Tide is interpreted using this faulty rule about actual product: The actual product is the underlying benefit alone, without tangible features or design."}}, {misconception_id:"MISC_TIFFANY_CO_DIAGNOSTIC_MISCONCEPTION_1514_59F5B8", properties:{kc_id:"df61d873-e426-58cf-9667-7e3fb5fa54b4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tiffany & Co.: diagnostic misconception 1514", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Tiffany & Co.. Read what the source actually reports about Tiffany & Co., then apply the definition of licensed brands: brands that provide the likeness of their brand as a fee for use", status:"approved", flawed_rule:"The example involving Tiffany & Co. is interpreted using this faulty rule about licensed brands: A licensee owns the brand outright after paying a licensing fee."}}, {misconception_id:"MISC_TIKTOK_DIAGNOSTIC_MISCONCEPTION_1515_894EAF", properties:{kc_id:"cabfcfd3-4a17-5395-b3c3-8cf0d62bd400", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"TikTok: diagnostic misconception 1515", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 319, in the textbook's discussion of TikTok. Read what the source actually reports about TikTok, then apply the definition of licensed brands: brands that provide the likeness of their brand as a fee for use", status:"approved", flawed_rule:"The example involving TikTok is interpreted using this faulty rule about licensed brands: A licensee owns the brand outright after paying a licensing fee."}}, {misconception_id:"MISC_TIME_S_UP_DIAGNOSTIC_MISCONCEPTION_1516_CC3486", properties:{kc_id:"3906ec9c-bf00-5578-88fc-7a88e0bf7bc7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Time’s Up: diagnostic misconception 1516", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 653, in the textbook's discussion of Time’s Up. Separate the specific account of Time’s Up on printed page 653 from a universal claim. The source passage is: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", status:"approved", flawed_rule:"The mention of Time’s Up in sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_TIMMY_GLOBAL_HEALTH_DIAGNOSTIC_MISCONCEPTION_151_5BC8C3", properties:{kc_id:"304f8110-3ed8-511b-967f-65ea8ecf311d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Timmy Global Health: diagnostic misconception 1517", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 252, in the textbook's discussion of Timmy Global Health. Read what the source actually reports about Timmy Global Health, then apply the definition of global market opportunities: conditions that are favorable for a company to expand into the global marketplace", status:"approved", flawed_rule:"The example involving Timmy Global Health is interpreted using this faulty rule about global market opportunities: Any large foreign population guarantees profitable entry."}}, {misconception_id:"MISC_TINDER_DIAGNOSTIC_MISCONCEPTION_1518_04C870", properties:{kc_id:"29698128-8da7-5738-960b-bc054004110e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tinder: diagnostic misconception 1518", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of Tinder. Read what the source actually reports about Tinder, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Tinder is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_TINYURL_DIAGNOSTIC_MISCONCEPTION_1519_B0CAF9", properties:{kc_id:"56f3ecdf-2a61-591a-ac50-c37a00645bb7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"TinyURL: diagnostic misconception 1519", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 557, in the textbook's discussion of TinyURL. Read what the source actually reports about TinyURL, then apply the definition of paid search: a type of digital advertising where marketers pay search engines like Google and Bing to place their ads in sponsored spots at the top or bottom of a search results page", status:"approved", flawed_rule:"The example involving TinyURL is interpreted using this faulty rule about paid search: Paying for a search advertisement guarantees the highest organic ranking."}}, {misconception_id:"MISC_TOMMY_HILFIGER_DIAGNOSTIC_MISCONCEPTION_1520_13BD45", properties:{kc_id:"b1f951e3-c528-5b2d-ac45-3a81961ce1cd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tommy Hilfiger: diagnostic misconception 1520", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Tommy Hilfiger. Read what the source actually reports about Tommy Hilfiger, then apply the definition of licensed brands: brands that provide the likeness of their brand as a fee for use", status:"approved", flawed_rule:"The example involving Tommy Hilfiger is interpreted using this faulty rule about licensed brands: A licensee owns the brand outright after paying a licensing fee."}}, {misconception_id:"MISC_TOMS_DIAGNOSTIC_MISCONCEPTION_1521_9AA87E", properties:{kc_id:"d5698e82-75f6-5d05-a0a8-7c234d6074db", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"TOMS: diagnostic misconception 1521", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 24, in the textbook's discussion of TOMS. Read what the source actually reports about TOMS, then apply the definition of customer value: the ratio of the perceived benefits relative to the costs incurred by the customer in acquiring the product or service", status:"approved", flawed_rule:"The example involving TOMS is interpreted using this faulty rule about customer value: The cheapest offering always provides the greatest customer value."}}, {misconception_id:"MISC_TOP_DESIGN_FIRMS_DIAGNOSTIC_MISCONCEPTION_1522_2FFF13", properties:{kc_id:"ded97b2e-1b8c-5645-bf8b-c7bdfd20093a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Top Design Firms: diagnostic misconception 1522", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 264, in the textbook's discussion of Top Design Firms. Read what the source actually reports about Top Design Firms, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving Top Design Firms is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_TOYOTA_DIAGNOSTIC_MISCONCEPTION_1523_650AEB", properties:{kc_id:"bc1ad236-805f-5b15-82ea-dd2679d533c0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Toyota: diagnostic misconception 1523", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 28, in the textbook's discussion of Toyota. Separate the specific account of Toyota on printed page 28 from a universal claim. The source passage is: The Reckoning When American cars developed a reputation for not being reliable or dependable, this opened an opportunity for Toyota and other Japanese exporters in the late 1960s and 1970s. Learn more about this issue from David Halberstam’s 1986 book The Reckoning. Read the New York Times 1986 review of this book (https://openstax.org/r/booksofthetimes).", status:"approved", flawed_rule:"The mention of Toyota in evolution of the marketing concept establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_TRADER_JOE_S_DIAGNOSTIC_MISCONCEPTION_1524_B159C1", properties:{kc_id:"58230356-5314-5af5-a9a0-68da38a065d4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Trader Joe’s: diagnostic misconception 1524", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 324, in the textbook's discussion of Trader Joe’s. Read what the source actually reports about Trader Joe’s, then apply the definition of customer experience: the overarching impression that customers have of a brand", status:"approved", flawed_rule:"The example involving Trader Joe’s is interpreted using this faulty rule about customer experience: Customer experience consists only of the moment of payment."}}, {misconception_id:"MISC_TRANSPARENCY_INTERNATIONAL_DIAGNOSTIC_MISCONCEPT_CD9596", properties:{kc_id:"97e0dfe4-a2ff-5369-8659-5b5863a17957", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Transparency International: diagnostic misconception 1525", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 144, in the textbook's discussion of Transparency International. Separate the specific account of Transparency International on printed page 144 from a universal claim. The source passage is: Transparency International, a watchdog group, annually ranks the likelihood of companies from the world’s", status:"approved", flawed_rule:"The mention of Transparency International in ethical issues in b2b marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_TRAVELERS_POINT_DIAGNOSTIC_MISCONCEPTION_1526_798445", properties:{kc_id:"8aba60d5-a575-5f42-a9e6-89a9d3c07d89", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Travelers Point: diagnostic misconception 1526", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 193, in the textbook's discussion of Travelers Point. Read what the source actually reports about Travelers Point, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving Travelers Point is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_TROPICANA_DIAGNOSTIC_MISCONCEPTION_1527_C24CC2", properties:{kc_id:"a1bab495-1df6-511a-8bf7-1efef699eb93", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tropicana: diagnostic misconception 1527", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 591, in the textbook's discussion of Tropicana. Read what the source actually reports about Tropicana, then apply the definition of marketing channel: system of people, organizations, and activities that work together to make goods and services available to consumers for use", status:"approved", flawed_rule:"The example involving Tropicana is interpreted using this faulty rule about marketing channel: A marketing channel is only the transport vehicle used for delivery."}}, {misconception_id:"MISC_TROUT_DIAGNOSTIC_MISCONCEPTION_1528_BA2D44", properties:{kc_id:"0f0d944b-0e43-5dcf-9b3b-1f223c66d8de", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Trout: diagnostic misconception 1528", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 181, in the textbook's discussion of Trout. Read what the source actually reports about Trout, then apply the definition of STP model: three-step marketing framework in which an organization segments the market, selects target market(s), and positions its products or services", status:"approved", flawed_rule:"The example involving Trout is interpreted using this faulty rule about STP model: Positioning can be chosen coherently before understanding segments and target customers."}}, {misconception_id:"MISC_TRULY_ORGANIC_DIAGNOSTIC_MISCONCEPTION_1529_A57181", properties:{kc_id:"40be358f-778c-59d2-be84-b14b9d035589", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Truly Organic: diagnostic misconception 1529", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 641, in the textbook's discussion of Truly Organic. Read what the source actually reports about Truly Organic, then apply the definition of false or misleading advertising: an unethical marketing practice by which consumers are given false or misleading information about a product or service", status:"approved", flawed_rule:"The example involving Truly Organic is interpreted using this faulty rule about false or misleading advertising: An advertisement cannot mislead if one isolated statement is literally true."}}, {misconception_id:"MISC_TRUTH_IN_ADVERTISING_DIAGNOSTIC_MISCONCEPTION_15_55A558", properties:{kc_id:"fa0cfb28-b4e8-51c0-961d-12a3ddab0a6f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Truth in Advertising: diagnostic misconception 1530", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 495, in the textbook's discussion of Truth in Advertising. Read what the source actually reports about Truth in Advertising, then apply the definition of product advertisements: advertisements that promote a specific product within the organization’s product mix", status:"approved", flawed_rule:"The example involving Truth in Advertising is interpreted using this faulty rule about product advertisements: Product advertisements primarily promote an entire organization's public standing."}}, {misconception_id:"MISC_TWITTER_DIAGNOSTIC_MISCONCEPTION_1531_206FCF", properties:{kc_id:"0200f79d-3662-5455-9b70-00e5639b6036", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Twitter: diagnostic misconception 1531", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 470, in the textbook's discussion of Twitter. Read what the source actually reports about Twitter, then apply the definition of personal selling: one-to-one communication between the seller and the buyer; used to inform and persuade the buyer", status:"approved", flawed_rule:"The example involving Twitter is interpreted using this faulty rule about personal selling: Personal selling is anonymous mass communication rather than an interpersonal exchange."}}, {misconception_id:"MISC_TYLENOL_DIAGNOSTIC_MISCONCEPTION_1532_6BF277", properties:{kc_id:"0f6d85e1-9a06-559d-bd35-ae215eb1e447", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Tylenol: diagnostic misconception 1532", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 444, in the textbook's discussion of Tylenol. Read what the source actually reports about Tylenol, then apply the definition of public relations: Activities that build and maintain relationships and public understanding of an organization. Compare the broader account in section 14.4 with chapter 13’s shorthand about nonpaid communication; earned media does not mean PR work has no cost.", status:"approved", flawed_rule:"The example involving Tylenol is interpreted using this faulty rule about public relations: Public relations consists only of buying advertising space."}}, {misconception_id:"MISC_UBER_DIAGNOSTIC_MISCONCEPTION_1533_84F4ED", properties:{kc_id:"59e5bcda-27f7-5228-b80d-d266844c2a37", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Uber: diagnostic misconception 1533", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 242, in the textbook's discussion of Uber. Read what the source actually reports about Uber, then apply the definition of strategic alliance: when two companies from different countries agree to invest resources in a mutually beneficial way", status:"approved", flawed_rule:"The example involving Uber is interpreted using this faulty rule about strategic alliance: Every strategic alliance requires creating a jointly owned new company."}}, {misconception_id:"MISC_UBER_EATS_DIAGNOSTIC_MISCONCEPTION_1534_9EFE62", properties:{kc_id:"17304028-72b6-5d8b-8782-224918641132", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Uber Eats: diagnostic misconception 1534", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 15, in the textbook's discussion of Uber Eats. Read what the source actually reports about Uber Eats, then apply the definition of place utility: making goods and/or services physically available or accessible to potential customers", status:"approved", flawed_rule:"The example involving Uber Eats is interpreted using this faulty rule about place utility: Availability at the right time and availability at the right location are identical utilities."}}, {misconception_id:"MISC_ULTIMATE_SCOOP_DIAGNOSTIC_MISCONCEPTION_1535_C1795E", properties:{kc_id:"502bee16-bf34-5f88-b6e9-8435c9b25822", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Ultimate Scoop: diagnostic misconception 1535", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 442, in the textbook's discussion of Ultimate Scoop. Read what the source actually reports about Ultimate Scoop, then apply the definition of message strategy: method of developing a message based on how the message will best tie the brand to the target market", status:"approved", flawed_rule:"The example involving Ultimate Scoop is interpreted using this faulty rule about message strategy: A message strategy is only a choice of font, color, and production technique."}}, {misconception_id:"MISC_UNILEVER_DIAGNOSTIC_MISCONCEPTION_1536_B90E75", properties:{kc_id:"0e1fd7b2-e6e2-5084-a2cc-da29d6621b9e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Unilever: diagnostic misconception 1536", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 297, in the textbook's discussion of Unilever. Read what the source actually reports about Unilever, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving Unilever is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_UNION_PACIFIC_RAILROAD_DIAGNOSTIC_MISCONCEPTION__B0585D", properties:{kc_id:"1c6b5783-2ca4-5b4e-b94b-c24c68e1efe9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Union Pacific Railroad: diagnostic misconception 1537", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 81, in the textbook's discussion of Union Pacific Railroad. Read what the source actually reports about Union Pacific Railroad, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving Union Pacific Railroad is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_UNITED_NATIONS_UN_DIAGNOSTIC_MISCONCEPTION_1538_512E0B", properties:{kc_id:"53cefbd9-afb9-5d0a-8fa5-4243da8559c9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"United Nations (UN): diagnostic misconception 1538", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 247, in the textbook's discussion of United Nations (UN). Separate the specific account of United Nations (UN) on printed page 247 from a universal claim. The source passage is: The use of child labor is seen by most Americans as unethical. The United Nations (UN) has implemented many treaties that establish human rights for children within member nations.87 However, each country has its own standards for child labor and the minimum age at which a child can work.", status:"approved", flawed_rule:"The mention of United Nations (UN) in ethical issues in the global marketplace establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_UNITED_STATES_PATENT_AND_TRADEMARK_OFFICE_DIAGNO_094958", properties:{kc_id:"24135df5-7e7b-5340-9667-80596be003da", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"United States Patent and Trademark Office: diagnostic misconception 1539", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 322, in the textbook's discussion of United States Patent and Trademark Office. Read what the source actually reports about United States Patent and Trademark Office, then apply the definition of trademarks (service marks): symbols that show legal ownership of a brand name or brand mark", status:"approved", flawed_rule:"The example involving United States Patent and Trademark Office is interpreted using this faulty rule about trademarks (service marks): Trademark ownership protects every functional invention in a product."}}, {misconception_id:"MISC_UNIVERSITY_OF_FLORIDA_DIAGNOSTIC_MISCONCEPTION_1_E38826", properties:{kc_id:"5f673503-3627-5bb1-9f12-94a89e0d2847", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"University of Florida: diagnostic misconception 1540", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 11, in the textbook's discussion of University of Florida. Read what the source actually reports about University of Florida, then apply the definition of product concept: the orientation that consumers will favor those products that offer the most quality, performance, or innovative features", status:"approved", flawed_rule:"The example involving University of Florida is interpreted using this faulty rule about product concept: The product concept is the same as researching and prioritizing customer needs."}}, {misconception_id:"MISC_UPSIDE_DIAGNOSTIC_MISCONCEPTION_1541_76D56D", properties:{kc_id:"29f748f6-3663-5c13-adf1-d2a0025ee9c2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Upside: diagnostic misconception 1541", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 407, in the textbook's discussion of Upside. Read what the source actually reports about Upside, then apply the definition of profit: the financial gain of a company", status:"approved", flawed_rule:"The example involving Upside is interpreted using this faulty rule about profit: Revenue is profit before subtracting costs."}}, {misconception_id:"MISC_US_BUREAU_OF_LABOR_STATISTICS_DIAGNOSTIC_MISCONC_3F2DA6", properties:{kc_id:"37d6936d-8329-541c-b5aa-508c91608e2e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Bureau of Labor Statistics: diagnostic misconception 1542", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 54, in the textbook's discussion of US Bureau of Labor Statistics. Read what the source actually reports about US Bureau of Labor Statistics, then apply the definition of marketing dashboard: summarizes important marketing metrics and key performance indicators into easy- to-understand measurements", status:"approved", flawed_rule:"The example involving US Bureau of Labor Statistics is interpreted using this faulty rule about marketing dashboard: A dashboard improves decisions merely by displaying as many metrics as possible."}}, {misconception_id:"MISC_US_CENSUS_BUREAU_DIAGNOSTIC_MISCONCEPTION_1543_CE1195", properties:{kc_id:"938cacd5-e1cd-57e8-8f1d-b6c1fe7658df", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Census Bureau: diagnostic misconception 1543", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 293, in the textbook's discussion of US Census Bureau. Read what the source actually reports about US Census Bureau, then apply the definition of Black population: second largest multicultural group in the United States; made up of three different subethnicities: single race, Black Hispanic, or Black mixed with another race (White or Native American)", status:"approved", flawed_rule:"The example involving US Census Bureau is interpreted using this faulty rule about Black population: Black consumers share a single ancestry, identity, and purchasing pattern."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_US_CHAMBER_OF_COMMERCE_DIAGNOSTIC_MISCONCEPTION__00350A", properties:{kc_id:"a61975d7-face-581e-80a2-bea5d52d7e32", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Chamber of Commerce: diagnostic misconception 1544", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 490, in the textbook's discussion of US Chamber of Commerce. Read what the source actually reports about US Chamber of Commerce, then apply the definition of impact: how quickly members of the audience receive an advertising message", status:"approved", flawed_rule:"The example involving US Chamber of Commerce is interpreted using this faulty rule about impact: Exposure or fast message delivery alone proves persuasion and sales effectiveness."}}, {misconception_id:"MISC_US_DEPARTMENT_OF_AGRICULTURE_USDA_DIAGNOSTIC_MIS_B1B188", properties:{kc_id:"4a575a9f-0f1f-5b1b-9272-8c1448f4648a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Department of Agriculture (USDA): diagnostic misconception 1545", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 639, in the textbook's discussion of US Department of Agriculture (USDA). Read what the source actually reports about US Department of Agriculture (USDA), then apply the definition of product traceability: the ability to track all processes for a product from the procurement of raw materials to production, consumption, and disposal", status:"approved", flawed_rule:"The example involving US Department of Agriculture (USDA) is interpreted using this faulty rule about product traceability: Traceability begins only when the finished item reaches the retailer."}}, {misconception_id:"MISC_US_DEPARTMENT_OF_JUSTICE_DIAGNOSTIC_MISCONCEPTIO_156220", properties:{kc_id:"7023acac-9d44-5021-8d25-bcdcf9658121", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Department of Justice: diagnostic misconception 1546", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 295, in the textbook's discussion of US Department of Justice. Read what the source actually reports about US Department of Justice, then apply the definition of multicultural marketing: a subcategory of diversity marketing aimed at intentionally targeting audiences based on different racial, ethnic, and cultural identities and backgrounds", status:"approved", flawed_rule:"The example involving US Department of Justice is interpreted using this faulty rule about multicultural marketing: Multicultural marketing merely translates the same advertisement into another language."}}, {misconception_id:"MISC_US_ENVIRONMENTAL_PROTECTION_AGENCY_EPA_DIAGNOSTI_73CA97", properties:{kc_id:"5164abf1-2c88-5a93-bbdc-850d4e5f8bee", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Environmental Protection Agency (EPA): diagnostic misconception 1547", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 658, in the textbook's discussion of US Environmental Protection Agency (EPA). Read what the source actually reports about US Environmental Protection Agency (EPA), then apply the definition of environmental, social, and governance strategy: a strategy that holds companies accountable for a sustainability strategy", status:"approved", flawed_rule:"The example involving US Environmental Protection Agency (EPA) is interpreted using this faulty rule about environmental, social, and governance strategy: An ESG strategy can be evaluated without evidence or accountability measures."}}, {misconception_id:"MISC_US_POSTAL_SERVICE_DIAGNOSTIC_MISCONCEPTION_1548_91B096", properties:{kc_id:"333b6b3f-f21f-54c5-846d-8e01845e80be", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Postal Service: diagnostic misconception 1548", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 209, in the textbook's discussion of US Postal Service. Read what the source actually reports about US Postal Service, then apply the definition of mailed surveys: surveys sent to potential participants through a mail service, such as the US Postal Service", status:"approved", flawed_rule:"The example involving US Postal Service is interpreted using this faulty rule about mailed surveys: Every person receiving a mailed questionnaire will respond."}}, {misconception_id:"MISC_US_STEEL_DIAGNOSTIC_MISCONCEPTION_1549_CCDEC7", properties:{kc_id:"87e42bd4-ba9b-5838-8995-fe931a7f237c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"US Steel: diagnostic misconception 1549", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 81, in the textbook's discussion of US Steel. Read what the source actually reports about US Steel, then apply the definition of business portfolio: the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The example involving US Steel is interpreted using this faulty rule about business portfolio: The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_VANITY_FAIR_DIAGNOSTIC_MISCONCEPTION_1550_311F25", properties:{kc_id:"e7aa8918-2f87-5370-9744-4b7f4d439fca", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Vanity Fair: diagnostic misconception 1550", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 158, in the textbook's discussion of Vanity Fair. Read what the source actually reports about Vanity Fair, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Vanity Fair is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_VECTOR_MARKETING_DIAGNOSTIC_MISCONCEPTION_1551_957734", properties:{kc_id:"00830c1f-dff4-5369-a5c8-77e5b56b20d6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Vector Marketing: diagnostic misconception 1551", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 537, in the textbook's discussion of Vector Marketing. Read what the source actually reports about Vector Marketing, then apply the definition of sales force automation: a software tool that helps organizations acquire customers", status:"approved", flawed_rule:"The example involving Vector Marketing is interpreted using this faulty rule about sales force automation: Automating sales tasks eliminates the need for judgment and relationship building."}}, {misconception_id:"MISC_VETCOVE_DIAGNOSTIC_MISCONCEPTION_1552_814FBA", properties:{kc_id:"732139ce-947d-5822-b30d-80f01b3e02c6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Vetcove: diagnostic misconception 1552", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 593, in the textbook's discussion of Vetcove. Read what the source actually reports about Vetcove, then apply the definition of channel member (intermediary): a company that works in a network with other companies to help gets products from manufacturers to final consumers", status:"approved", flawed_rule:"The example involving Vetcove is interpreted using this faulty rule about channel member (intermediary): Intermediaries merely add cost and perform no useful customer functions."}}, {misconception_id:"MISC_VICTORIA_S_SECRET_DIAGNOSTIC_MISCONCEPTION_1553_A41DF6", properties:{kc_id:"d603b9a8-8347-508f-90f9-1f53d3dd754e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Victoria’s Secret: diagnostic misconception 1553", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 292, in the textbook's discussion of Victoria’s Secret. Read what the source actually reports about Victoria’s Secret, then apply the definition of consumers with disabilities: sociodemographic group living with some type of disability related to mobility, learning, intellectual, or other types of functions; a very diverse group because disabilities span cultural, social, and demographic factors", status:"approved", flawed_rule:"The example involving Victoria’s Secret is interpreted using this faulty rule about consumers with disabilities: One accessibility adjustment serves all types of disability equally well."}}, {misconception_id:"MISC_VIZIO_DIAGNOSTIC_MISCONCEPTION_1554_6571DB", properties:{kc_id:"1efebdfa-91e2-57db-8cad-644b44593ff0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Vizio: diagnostic misconception 1554", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 36, in the textbook's discussion of Vizio. Read what the source actually reports about Vizio, then apply the definition of marketing concept: marketing philosophy that firms should analyze the needs of their customers and then make decisions to satisfy those needs better than the competition", status:"approved", flawed_rule:"The example involving Vizio is interpreted using this faulty rule about marketing concept: Superior technical features guarantee customer satisfaction without studying needs."}}, {misconception_id:"MISC_VMWARE_DIAGNOSTIC_MISCONCEPTION_1555_359C4F", properties:{kc_id:"8fb63ea0-c5dd-5645-9049-158bbede1a7b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"VMware: diagnostic misconception 1555", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 652, in the textbook's discussion of VMware. Separate the specific account of VMware on printed page 652 from a universal claim. The source passage is: Williams-Sonoma is just one example of a company with a vision and a commitment to sustainability. Other companies known for their sustainability commitments and practices include Microsoft, VMware, Intuit, Apple, and Mastercard.9", status:"approved", flawed_rule:"The mention of VMware in sustainable marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_VOGUE_DIAGNOSTIC_MISCONCEPTION_1556_0B55B3", properties:{kc_id:"d6597db0-90cb-524c-b6ab-9334e40b7756", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Vogue: diagnostic misconception 1556", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 158, in the textbook's discussion of Vogue. Read what the source actually reports about Vogue, then apply the definition of market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics", status:"approved", flawed_rule:"The example involving Vogue is interpreted using this faulty rule about market segmentation: Segmentation is choosing the final target before identifying meaningful groups."}}, {misconception_id:"MISC_VOLKSWAGEN_DIAGNOSTIC_MISCONCEPTION_1557_5B3223", properties:{kc_id:"48bac6d6-8430-5116-9573-af666347044a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Volkswagen: diagnostic misconception 1557", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 15, in the textbook's discussion of Volkswagen. Separate the specific account of Volkswagen on printed page 15 from a universal claim. The source passage is: Another way to approach this is to create separate brands and compete in both arenas. Consider Volkswagen. You might immediately think of the VW Beetle or the Jetta, but the company’s brand portfolio extends beyond", status:"approved", flawed_rule:"The mention of Volkswagen in marketing and the marketing process establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_WALGREENS_DIAGNOSTIC_MISCONCEPTION_1558_69699E", properties:{kc_id:"532b06e3-5f90-58f8-80d0-5bf62d1e67da", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Walgreens: diagnostic misconception 1558", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 323, in the textbook's discussion of Walgreens. Read what the source actually reports about Walgreens, then apply the definition of private-label brands: store brands that are similar products to a national brand and labeled privately", status:"approved", flawed_rule:"The example involving Walgreens is interpreted using this faulty rule about private-label brands: Private labels must always be inferior to manufacturer brands."}}, {misconception_id:"MISC_WALMART_DIAGNOSTIC_MISCONCEPTION_1559_073AAE", properties:{kc_id:"889ea8d4-3f35-5dcb-82bb-c31f647104f9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Walmart: diagnostic misconception 1559", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 25, in the textbook's discussion of Walmart. Read what the source actually reports about Walmart, then apply the definition of suppliers: sometimes also called vendors, these are partners from whom we receive the parts and products necessary for our business", status:"approved", flawed_rule:"The example involving Walmart is interpreted using this faulty rule about suppliers: Suppliers influence production but cannot affect the firm's marketing promises."}}, {misconception_id:"MISC_WALT_DISNEY_COMPANY_DIAGNOSTIC_MISCONCEPTION_156_06B4C6", properties:{kc_id:"a2f22dda-84bf-58c7-a3a9-1d6309cb7f9c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Walt Disney Company: diagnostic misconception 1560", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 238, in the textbook's discussion of Walt Disney Company. Read what the source actually reports about Walt Disney Company, then apply the definition of cultural sensitivity: awareness and appreciation of and the ability to adapt to a cultural, ethnic, racial, or another group other than one’s own", status:"approved", flawed_rule:"The example involving Walt Disney Company is interpreted using this faulty rule about cultural sensitivity: Translating words is sufficient to understand another market's cultural meaning."}}, {misconception_id:"MISC_WARBY_PARKER_DIAGNOSTIC_MISCONCEPTION_1561_B67B7F", properties:{kc_id:"7fa4792a-5de5-532c-870d-fb498db922e4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Warby Parker: diagnostic misconception 1561", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 429, in the textbook's discussion of Warby Parker. Read what the source actually reports about Warby Parker, then apply the definition of predatory pricing: when a company prices goods or services so low that other companies cannot compete", status:"approved", flawed_rule:"The example involving Warby Parker is interpreted using this faulty rule about predatory pricing: Every competitive discount is necessarily predatory pricing."}}, {misconception_id:"MISC_WAYFAIR_DIAGNOSTIC_MISCONCEPTION_1562_F283C6", properties:{kc_id:"88ec89ea-b2f2-59c9-9462-5ebfbdba66c9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wayfair: diagnostic misconception 1562", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 544, in the textbook's discussion of Wayfair. Read what the source actually reports about Wayfair, then apply the definition of email marketing: a type of direct marketing that is highly personal and designed to build relationships with consumers", status:"approved", flawed_rule:"The example involving Wayfair is interpreted using this faulty rule about email marketing: Sending the same unsolicited message to everyone builds strong relationships."}}, {misconception_id:"MISC_WEINREB_GROUP_DIAGNOSTIC_MISCONCEPTION_1563_A5E060", properties:{kc_id:"bf0a4e13-2e08-53c9-a054-f5d936255db6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Weinreb Group: diagnostic misconception 1563", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 651, in the textbook's discussion of Weinreb Group. Read what the source actually reports about Weinreb Group, then apply the definition of social pillar: the sustainability pillar that focuses on creating an inclusive environment for the community", status:"approved", flawed_rule:"The example involving Weinreb Group is interpreted using this faulty rule about social pillar: Sustainability excludes employee conditions, inclusion, and community well-being."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_WELCH_S_FRUIT_SNACKS_DIAGNOSTIC_MISCONCEPTION_15_A20411", properties:{kc_id:"284504f6-da0a-5013-b97d-366867241c20", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Welch’s Fruit Snacks: diagnostic misconception 1564", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 188, in the textbook's discussion of Welch’s Fruit Snacks. Separate the specific account of Welch’s Fruit Snacks on printed page 188 from a universal claim. The source passage is: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", status:"approved", flawed_rule:"The mention of Welch’s Fruit Snacks in ethical concerns and target marketing establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_WELLS_FARGO_DIAGNOSTIC_MISCONCEPTION_1565_1B2FA6", properties:{kc_id:"49c174db-0212-5c9e-9723-1965bf7e8a98", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wells Fargo: diagnostic misconception 1565", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 285, in the textbook's discussion of Wells Fargo. Read what the source actually reports about Wells Fargo, then apply the definition of cultural identity: how a person identifies with a given culture, ethnicity, or social group, which instills a sense of belonging that influences personal thinking and actions", status:"approved", flawed_rule:"The example involving Wells Fargo is interpreted using this faulty rule about cultural identity: Marketers can assign cultural identity solely from a person's appearance."}}, {misconception_id:"MISC_WENDY_S_DIAGNOSTIC_MISCONCEPTION_1566_C11D8E", properties:{kc_id:"9eca8bde-46dc-592f-a073-d9dc14d905d8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wendy’s: diagnostic misconception 1566", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 139, in the textbook's discussion of Wendy’s. Read what the source actually reports about Wendy’s, then apply the definition of product specifications: a document carrying essential information to keep teams on track when designing and developing a product", status:"approved", flawed_rule:"The example involving Wendy’s is interpreted using this faulty rule about product specifications: A product specification merely states the total purchasing budget."}}, {misconception_id:"MISC_WHATSAPP_DIAGNOSTIC_MISCONCEPTION_1567_1C9A61", properties:{kc_id:"e364d3ea-2740-5a7d-9579-af4d1fc7f7ba", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"WhatsApp: diagnostic misconception 1567", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 247, in the textbook's discussion of WhatsApp. Read what the source actually reports about WhatsApp, then apply the definition of business landscape: everything internal and external to the business, its industry, and its environment", status:"approved", flawed_rule:"The example involving WhatsApp is interpreted using this faulty rule about business landscape: A country's market potential depends only on the number of consumers."}}, {misconception_id:"MISC_WHIRLPOOL_DIAGNOSTIC_MISCONCEPTION_1568_4EC6EB", properties:{kc_id:"873d0b4b-0e58-5c81-b0c8-fbcd4a822fc4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Whirlpool: diagnostic misconception 1568", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 134, in the textbook's discussion of Whirlpool. Read what the source actually reports about Whirlpool, then apply the definition of new-task buy: a complex B2B buying situation in which the organization buys a product or service for the first time", status:"approved", flawed_rule:"The example involving Whirlpool is interpreted using this faulty rule about new-task buy: A first-time organizational purchase can always use the routine of a straight rebuy."}}, {misconception_id:"MISC_WHOLE_FOODS_DIAGNOSTIC_MISCONCEPTION_1569_40425E", properties:{kc_id:"f20bc22b-a565-5d75-999f-f95a8dae618c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Whole Foods: diagnostic misconception 1569", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 496, in the textbook's discussion of Whole Foods. Read what the source actually reports about Whole Foods, then apply the definition of product advertisements: advertisements that promote a specific product within the organization’s product mix", status:"approved", flawed_rule:"The example involving Whole Foods is interpreted using this faulty rule about product advertisements: Product advertisements primarily promote an entire organization's public standing."}}, {misconception_id:"MISC_WILDE_DIAGNOSTIC_MISCONCEPTION_1570_B6A232", properties:{kc_id:"a7e66708-a168-55e6-9be1-89d8a3e2dbeb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wilde: diagnostic misconception 1570", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Wilde. Separate the specific account of Wilde on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Wilde in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_WILLIAMS_SONOMA_DIAGNOSTIC_MISCONCEPTION_1571_A13818", properties:{kc_id:"6091006f-bd8f-5d8c-ac09-d2af92bd0caf", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Williams-Sonoma: diagnostic misconception 1571", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 651, in the textbook's discussion of Williams-Sonoma. Read what the source actually reports about Williams-Sonoma, then apply the definition of environmental pillar: the sustainability pillar that focuses on reducing a company’s impact on the environment", status:"approved", flawed_rule:"The example involving Williams-Sonoma is interpreted using this faulty rule about environmental pillar: A green advertisement alone establishes reduced environmental impact."}}, {misconception_id:"MISC_WILMAR_INTERNATIONAL_LIMITED_DIAGNOSTIC_MISCONCE_FBF091", properties:{kc_id:"b8055b41-e507-5bad-a308-a289c31232d5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wilmar International Limited: diagnostic misconception 1572", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 242, in the textbook's discussion of Wilmar International Limited. Read what the source actually reports about Wilmar International Limited, then apply the definition of joint venture: a business arrangement whereby two or more companies create a single enterprise or project", status:"approved", flawed_rule:"The example involving Wilmar International Limited is interpreted using this faulty rule about joint venture: A joint venture is simply a supplier contract without a shared enterprise."}}, {misconception_id:"MISC_WINFREY_DIAGNOSTIC_MISCONCEPTION_1573_425D17", properties:{kc_id:"fececd4e-3d21-568c-9ed4-6d2a667c10a4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Winfrey: diagnostic misconception 1573", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 260, in the textbook's discussion of Winfrey. Read what the source actually reports about Winfrey, then apply the definition of diversity marketing: a strategic approach that involves identifying different subsegments of the population—based on shared cultural and sociodemographic characteristics—and creating intentional marketing efforts to connect with these consumer groups", status:"approved", flawed_rule:"The example involving Winfrey is interpreted using this faulty rule about diversity marketing: Changing the ethnic appearance of an advertisement fully addresses inclusion."}}, {misconception_id:"MISC_WINTER_OLYMPICS_DIAGNOSTIC_MISCONCEPTION_1574_C1EB46", properties:{kc_id:"2447d2e6-aa04-5bf9-8228-830217f65a03", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Winter Olympics: diagnostic misconception 1574", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 297, in the textbook's discussion of Winter Olympics. Read what the source actually reports about Winter Olympics, then apply the definition of multicultural marketing: a subcategory of diversity marketing aimed at intentionally targeting audiences based on different racial, ethnic, and cultural identities and backgrounds", status:"approved", flawed_rule:"The example involving Winter Olympics is interpreted using this faulty rule about multicultural marketing: Multicultural marketing merely translates the same advertisement into another language."}}, {misconception_id:"MISC_WINTOUR_DIAGNOSTIC_MISCONCEPTION_1575_72E9E9", properties:{kc_id:"242cdded-03eb-524a-ae9d-1662174e0ff8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wintour: diagnostic misconception 1575", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 443, in the textbook's discussion of Wintour. Separate the specific account of Wintour on printed page 443 from a universal claim. The source passage is: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", status:"approved", flawed_rule:"The mention of Wintour in the promotion mix and its elements establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_WIRED_COFFEE_BAR_DIAGNOSTIC_MISCONCEPTION_1576_3094AB", properties:{kc_id:"e81fcdb4-3eec-521c-8950-a19c43a45bc5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wired Coffee Bar: diagnostic misconception 1576", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 124, in the textbook's discussion of Wired Coffee Bar. Separate the specific account of Wired Coffee Bar on printed page 124 from a universal claim. The source passage is: Just as Wired Coffee Bar was hitting its stride, new coffee shops started to enter the once-dormant community. Each new coffee location offered a drive-through, something Wired Coffee Bar never wants to be—fast-food coffee. As Lisa looked at ways to create more business, provide good coffee, and differentiate from the masses, she wondered if her concept could survive the hustle and the need for quicker service and a less laid- back atmosphere.", status:"approved", flawed_rule:"The mention of Wired Coffee Bar in factors that influence consumer buying behavior establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_WISCONSIN_DEPARTMENT_OF_AGRICULTURE_DIAGNOSTIC_M_817203", properties:{kc_id:"1acdcf1f-5ba1-5cb9-83e0-dd5bdfa0af76", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wisconsin Department of Agriculture: diagnostic misconception 1577", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 428, in the textbook's discussion of Wisconsin Department of Agriculture. Read what the source actually reports about Wisconsin Department of Agriculture, then apply the definition of predatory pricing: when a company prices goods or services so low that other companies cannot compete", status:"approved", flawed_rule:"The example involving Wisconsin Department of Agriculture is interpreted using this faulty rule about predatory pricing: Every competitive discount is necessarily predatory pricing."}}, {misconception_id:"MISC_WORLD_FOOD_CHAMPIONSHIPS_DIAGNOSTIC_MISCONCEPTIO_4ADA6B", properties:{kc_id:"963f585b-f652-51e8-b0af-e075b0a644af", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"World Food Championships: diagnostic misconception 1578", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 460, in the textbook's discussion of World Food Championships. Separate the specific account of World Food Championships on printed page 460 from a universal claim. The source passage is: For example, when World Food Championships wanted to reach home cooks, professional chefs, and aspiring chefs to participate in its Food Sport events, it enticed them with the opportunity for a big payout in winnings. And it created a connection with them through smaller local qualifying events. When the winners of smaller events received a Golden Ticket to compete, they were instantly excited. Then they realized the competition would allow them to meet with even bigger food celebrities and increase their chances of television fame (see Figure 13.15).", status:"approved", flawed_rule:"The mention of World Food Championships in steps in the imc planning process establishes the same outcomes for every customer and organization, regardless of the case's setting or evidence."}}, {misconception_id:"MISC_WORLD_TRADE_ORGANIZATION_WTO_DIAGNOSTIC_MISCONCE_84BCAF", properties:{kc_id:"a43a31e2-449b-51c5-a866-3e2a633db6ee", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"World Trade Organization (WTO): diagnostic misconception 1579", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 235, in the textbook's discussion of World Trade Organization (WTO). Read what the source actually reports about World Trade Organization (WTO), then apply the definition of exchange rate: the rate at which one country’s currency can be exchanged for that of another country", status:"approved", flawed_rule:"The example involving World Trade Organization (WTO) is interpreted using this faulty rule about exchange rate: Currency conversion rates cannot change export competitiveness or realized revenue."}}, {misconception_id:"MISC_WOUNDED_WARRIOR_PROJECT_DIAGNOSTIC_MISCONCEPTION_A7A703", properties:{kc_id:"b7a85b6e-a7ce-5b0d-a027-bf53a4a68627", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wounded Warrior Project: diagnostic misconception 1580", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 131, in the textbook's discussion of Wounded Warrior Project. Read what the source actually reports about Wounded Warrior Project, then apply the definition of government markets: purchases made by the governing bodies of nations, states, or communities", status:"approved", flawed_rule:"The example involving Wounded Warrior Project is interpreted using this faulty rule about government markets: Government purchasing follows exactly the same priorities as private consumer purchasing."}}, {misconception_id:"MISC_WYZOWL_DIAGNOSTIC_MISCONCEPTION_1581_5DE673", properties:{kc_id:"bdf839e9-2726-5dd5-b791-8804b5abbbc0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Wyzowl: diagnostic misconception 1581", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 547, in the textbook's discussion of Wyzowl. Read what the source actually reports about Wyzowl, then apply the definition of online video marketing: involves creating videos that tell a story about a product, company, or brand that is designed to drive consumer engagement through activities such as liking, sharing, and retweeting", status:"approved", flawed_rule:"The example involving Wyzowl is interpreted using this faulty rule about online video marketing: A high view count alone establishes profitable customer engagement."}}, {misconception_id:"MISC_YANKELOVICH_INC_DIAGNOSTIC_MISCONCEPTION_1582_20C0C5", properties:{kc_id:"24aa973d-b826-5ade-86f3-7b88b7aee25b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Yankelovich Inc.: diagnostic misconception 1582", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 438, in the textbook's discussion of Yankelovich Inc.. Read what the source actually reports about Yankelovich Inc., then apply the definition of direct marketing: method of promotion that directly connects with the customer and generally requires a response or transaction", status:"approved", flawed_rule:"The example involving Yankelovich Inc. is interpreted using this faulty rule about direct marketing: Direct marketing cannot use television or print."}}, {misconception_id:"MISC_YOUTUBE_DIAGNOSTIC_MISCONCEPTION_1583_2D864D", properties:{kc_id:"1c71d34a-bf73-59d7-8ebc-c20b456d1d2e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"YouTube: diagnostic misconception 1583", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 96, in the textbook's discussion of YouTube. Read what the source actually reports about YouTube, then apply the definition of environmental factors: factors such as music, lighting, ambient noise, and smell that can either discourage or encourage a consumer’s purchase decision", status:"approved", flawed_rule:"The example involving YouTube is interpreted using this faulty rule about environmental factors: Lighting, music, and smell cannot influence purchase behavior."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_ZALES_DIAGNOSTIC_MISCONCEPTION_1584_FE07B6", properties:{kc_id:"43a95be8-22b3-57a3-9a8b-b133d7340470", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Zales: diagnostic misconception 1584", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 621, in the textbook's discussion of Zales. Read what the source actually reports about Zales, then apply the definition of off-price retailers: retailers that provide high-quality goods at lower prices", status:"approved", flawed_rule:"The example involving Zales is interpreted using this faulty rule about off-price retailers: Off-price retailers necessarily sell only defective goods."}}, {misconception_id:"MISC_ZAPPOS_DIAGNOSTIC_MISCONCEPTION_1585_2B09CF", properties:{kc_id:"ba202f75-7fdc-5d74-9293-8494124d5703", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Zappos: diagnostic misconception 1585", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 23, in the textbook's discussion of Zappos. Read what the source actually reports about Zappos, then apply the definition of organizational culture: beliefs and behaviors that determine how a company’s employees and management interact and handle customer relationships", status:"approved", flawed_rule:"The example involving Zappos is interpreted using this faulty rule about organizational culture: Employee norms have no effect on customer experience."}}, {misconception_id:"MISC_ZENNI_DIAGNOSTIC_MISCONCEPTION_1586_56945D", properties:{kc_id:"97d3a566-a43c-5309-88c6-6ef85817e16e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Zenni: diagnostic misconception 1586", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 381, in the textbook's discussion of Zenni. Read what the source actually reports about Zenni, then apply the definition of service encounter: a consumer’s direct contact with a service provider", status:"approved", flawed_rule:"The example involving Zenni is interpreted using this faulty rule about service encounter: The service encounter is only advertising, with no direct customer-provider contact."}}, {misconception_id:"MISC_ZONDERVAN_DIAGNOSTIC_MISCONCEPTION_1587_1AB095", properties:{kc_id:"71ff2da2-dea4-51f1-a862-d06502a733e8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Zondervan: diagnostic misconception 1587", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 159, in the textbook's discussion of Zondervan. Read what the source actually reports about Zondervan, then apply the definition of target market: group of people with some shared characteristics that a company has identified as potential customers for its products", status:"approved", flawed_rule:"The example involving Zondervan is interpreted using this faulty rule about target market: Anyone who could conceivably buy the product is the chosen target market."}}, {misconception_id:"MISC_ZOOM_DIAGNOSTIC_MISCONCEPTION_1588_DD81CF", properties:{kc_id:"93b145be-5513-56b2-bf46-d4b250abd2f3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"Zoom: diagnostic misconception 1588", created_at:datetime('2026-09-20T10:16:38.34Z'), remediation_hint:"Use printed page 261, in the textbook's discussion of Zoom. Read what the source actually reports about Zoom, then apply the definition of company centric: a company’s approach to focusing decisions and execution from the perspective of the organization rather than the customers", status:"approved", flawed_rule:"The example involving Zoom is interpreted using this faulty rule about company centric: A company-centric decision is necessarily based on direct evidence of customer needs."}}, {misconception