UNWIND [{concept_id:"496ec1b1-bab6-5609-abdd-9f637dec5e9b", kc_id:"496ec1b1-bab6-5609-abdd-9f637dec5e9b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply exploratory research: research conducted that is more general to learn more about the industry or market Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Apply exploratory research", canonical_key:"apply_exploratory_research", status:"approved"}}, {concept_id:"cd2f342e-7172-5ad9-aee5-68a3ad96a738", kc_id:"cd2f342e-7172-5ad9-aee5-68a3ad96a738", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain external data: data that originates from outside the organization Source: chapter 6 Key Terms, printed page 219; related section 6.2.", label:"Explain external data", canonical_key:"explain_external_data", status:"approved"}}, {concept_id:"409be254-b3dc-5eac-b93f-67f0d2f3668c", kc_id:"409be254-b3dc-5eac-b93f-67f0d2f3668c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain focus group: a small group, typically 8 to 12 people, who are asked several questions by a moderator and encouraged to build upon each other’s responses Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Explain focus group", canonical_key:"explain_focus_group", status:"approved"}}, {concept_id:"1a3f7f48-cfe3-5cf4-9c44-10c776fc30b1", kc_id:"1a3f7f48-cfe3-5cf4-9c44-10c776fc30b1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain frequency: a report of the number of each answer received Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Explain frequency", canonical_key:"explain_frequency", status:"approved"}}, {concept_id:"5f510b2f-d378-5952-99cb-97047a702ee1", kc_id:"5f510b2f-d378-5952-99cb-97047a702ee1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply in-person surveys: surveys conducted when the respondent and data collector are face-to-face Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Apply in-person surveys", canonical_key:"apply_in_person_surveys", status:"approved"}}, {concept_id:"5e56c5cf-51a4-593e-9279-e3f8befed9b9", kc_id:"5e56c5cf-51a4-593e-9279-e3f8befed9b9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain infographic: a representation of data in a variety of visual presentations Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Explain infographic", canonical_key:"explain_infographic", status:"approved"}}, {concept_id:"dc6621a7-3207-58eb-afde-75e092ddb9ff", kc_id:"dc6621a7-3207-58eb-afde-75e092ddb9ff", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain internal data: critical marketing intelligence that already exists in the company’s records Source: chapter 6 Key Terms, printed page 219; related section 6.2.", label:"Explain internal data", canonical_key:"explain_internal_data", status:"approved"}}, {concept_id:"174925b3-616e-587a-b813-f4e5dfcb79fa", kc_id:"174925b3-616e-587a-b813-f4e5dfcb79fa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply judgment sample: a nonprobability sample type where the potential participants are selected based on a perceived match to the sample frame Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Apply judgment sample", canonical_key:"apply_judgment_sample", status:"approved"}}, {concept_id:"4ddd92e7-da4e-5474-a8cf-c82d2b870255", kc_id:"4ddd92e7-da4e-5474-a8cf-c82d2b870255", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply mailed surveys: surveys sent to potential participants through a mail service, such as the US Postal Service Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Apply mailed surveys", canonical_key:"apply_mailed_surveys", status:"approved"}}, {concept_id:"0fe432a2-421d-51e5-afbc-3e9d43c269f9", kc_id:"0fe432a2-421d-51e5-afbc-3e9d43c269f9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing information: also known as business intelligence, competitive intelligence, or marketing intelligence; information about the market that helps to identify opportunities available Source: chapter 6 Key Terms, printed page 219; related section 6.2.", label:"Explain marketing information", canonical_key:"explain_marketing_information", status:"approved"}}, {concept_id:"ab0abe63-f731-5515-bd87-7f6b32e749fb", kc_id:"ab0abe63-f731-5515-bd87-7f6b32e749fb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain marketing information system: a system used to collect, analyze, and report interesting findings from internal and external data of the company Source: chapter 6 Key Terms, printed page 219; related section 6.1.", label:"Explain marketing information system", canonical_key:"explain_marketing_information_system", status:"approved"}}, {concept_id:"daf291d8-58c9-5363-89e6-9a744e2bded9", kc_id:"daf291d8-58c9-5363-89e6-9a744e2bded9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply marketing research: the function that links the consumer, customer, and public to the marketer through information Source: chapter 6 Key Terms, printed page 219; related section 6.1.", label:"Apply marketing research", canonical_key:"apply_marketing_research", status:"approved"}}, {concept_id:"ec9e463e-7907-5db3-b18a-4fe38cabf56a", kc_id:"ec9e463e-7907-5db3-b18a-4fe38cabf56a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain mean: an arithmetic average of values Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Explain mean", canonical_key:"explain_mean", status:"approved"}}, {concept_id:"148563d0-a40f-533e-88a2-63804d31895a", kc_id:"148563d0-a40f-533e-88a2-63804d31895a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain mechanical observation: the use of electronic monitoring to record the actions of the observed Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Explain mechanical observation", canonical_key:"explain_mechanical_observation", status:"approved"}}, {concept_id:"92555a93-04