UNWIND [{concept_id:"affa3251-6294-5768-b26b-0d8ed9a9a3b9", kc_id:"affa3251-6294-5768-b26b-0d8ed9a9a3b9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 6.4, printed page 216, chapter 6 (Marketing Research and Market Intelligence). Learning outcomes: Describe ethical issues relating to marketing research. Discuss ways to avoid unethical research practices.", label:"Ethical Issues in Marketing Research", canonical_key:"ethical_issues_in_marketing_research", status:"approved"}}, {concept_id:"2323a0b2-b9b4-55fd-a863-4968c6dc796c", kc_id:"2323a0b2-b9b4-55fd-a863-4968c6dc796c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 7.1, printed page 228, chapter 7 (Marketing in a Global Environment). Learning outcomes: Define global market opportunities. Explain why international trade is advantageous to business. Discuss the challenges of international trade.", label:"The Global Market and Advantages of International Trade", canonical_key:"the_global_market_and_advantages_of_internationa", status:"approved"}}, {concept_id:"62ad4d08-7329-52a0-b21f-09356580c5c6", kc_id:"62ad4d08-7329-52a0-b21f-09356580c5c6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 7.2, printed page 232, chapter 7 (Marketing in a Global Environment). Learning outcomes: Identify the different ways marketers can assess opportunity in global markets. Discuss effective methods of analyzing global opportunities.", label:"Assessment of Global Markets for Opportunities", canonical_key:"assessment_of_global_markets_for_opportunities", status:"approved"}}, {concept_id:"79c03b94-b4f8-55b9-8538-4d46498b9a82", kc_id:"79c03b94-b4f8-55b9-8538-4d46498b9a82", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 7.3, printed page 241, chapter 7 (Marketing in a Global Environment). Learning outcomes: List the strategies used in global competition. Discuss the different forms of global competition.", label:"Entering the Global Arena", canonical_key:"entering_the_global_arena", status:"approved"}}, {concept_id:"3af2d3dc-413d-5aa9-8968-0cec6aed9b82", kc_id:"3af2d3dc-413d-5aa9-8968-0cec6aed9b82", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 7.4, printed page 243, chapter 7 (Marketing in a Global Environment). Learning outcomes: Describe how marketing strategies are adapted for a global marketplace. Summarize how global strategies affect the 4Ps of marketing.", label:"Marketing in a Global Environment", canonical_key:"marketing_in_a_global_environment", status:"approved"}}, {concept_id:"4f4452a4-f0db-582a-a1c8-d97b30713395", kc_id:"4f4452a4-f0db-582a-a1c8-d97b30713395", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 7.5, printed page 247, chapter 7 (Marketing in a Global Environment). Learning outcomes: Identify ethical issues facing global organizations. Provide an example of a company that displays ethics in the global marketplace.", label:"Ethical Issues in the Global Marketplace", canonical_key:"ethical_issues_in_the_global_marketplace", status:"approved"}}, {concept_id:"985f0f3c-e86e-5de3-aa99-3d7b719a46f9", kc_id:"985f0f3c-e86e-5de3-aa99-3d7b719a46f9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 8.1, printed page 260, chapter 8 (Marketing in a Diverse Marketplace). Learning outcomes: Define marketing standardization. Define marketing adaptation. Explain when to use diversity marketing as an adaptation strategy.", label:"Strategic Marketing: Standardization versus Adaptation", canonical_key:"strategic_marketing_standardization_versus_adapt", status:"approved"}}, {concept_id:"13209327-30fb-57f6-ab2d-1ad0ced57d1e", kc_id:"13209327-30fb-57f6-ab2d-1ad0ced57d1e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 8.2, printed page 263, chapter 8 (Marketing in a Diverse Marketplace). Learning outcomes: Define diversity marketing, multicultural marketing, and sociodemographic marketing. Explain why diversity marketing is needed in today’s marketplace. Explain the importance of diversity in market research. List the factors that impact diversity marketing.", label:"Diversity and Inclusion Marketing", canonical_key:"diversity_and_inclusion_marketing", status:"approved"}}, {concept_id:"a2fa3ecb-f0d4-54ed-a6ef-d360473dcbc5", kc_id:"a2fa3ecb-f0d4-54ed-a6ef-d360473dcbc5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 8.3, printed page 271, chapter 8 (Marketing in a Diverse Marketplace). Learning outcomes: Define culture. Explain the difference between tangible and intangible cultural objectives. List the main elements through which culture is expressed. Describe Hofstede’s cultural dimensions.", label:"Multicultural Marketing", canonical_key:"multicultural_marketing", status:"approved"}}, {concept_id:"1fc25028-e45c-5bc0-aef3-0288d4297c99", kc_id:"1fc25028-e45c-5bc0-aef3-0288d4297c99", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 8.4, printed page 278, chapter 8 (Marketing in a Diverse Marketplace). Learning outcomes: Describe the Hispanic, Black, and Asian identities. Define acculturation. Explain how identity-related characteristics and factors connect Hispanic, Black, and Asian consumers. Describe how to market to Hispanic, Black, and Asian consumers.", label:"Marketing to Hispanic, Black, and Asian Consumers", canonical_key:"marketing_to_hispanic_black_and_asian_consumers", status:"approved"}}, {concept_id:"aebf2ee9-285d-563b-a5a7-541e456df703", kc_id:"aebf2ee9-285d-563b-a5a7-541e456df703", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 8.5, printed page 287, chapter 8 (Marketing in a Diverse Marketplace). Learning outcomes: Define sociodemographic marketing. Explain how to market to the LGBTQIA+ community. Explain how to market based on generational differences. Explain how to market to consumers with disabilities. Describe how sociodemographic trends will impact future marketing.", label:"Marketing to Sociodemographic Groups", canonical_key:"marketing_to_sociodemographic_groups", status:"approved"}}, {concept_id:"606f59ad-2455-5800-a9e0-c4a32e060639", kc_id:"606f59ad-2455-5800-a9e0-c4a32e060639", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 8.6, printed page 294, chapter 8 (Marketing in a Diverse Marketplace). Learning outcomes: Identify the ethical issues related to diversity marketing. Discuss how to address different consumer values to reduce issues in marketing.", label:"Ethical Issues in Diversity Marketing", canonical_key:"ethical_issues_in_diversity_marketing", status:"approved"}}, {concept_id:"6a2a6bc8-1418-512d-a874-619463ef5d3f", kc_id:"6a2a6bc8-1418-512d-a874-619463ef5d3f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 9.1, printed page 308, chapter 9 (Products: Consumer Offerings). Learning outcomes: Differentiate between products, services, and experiences. Describe how consumer and business/industrial products are classified. Identify the four levels of a product.", label:"Products, Services, and Experiences", canonical_key:"products_services_and_experiences", status:"approved"}}, {concept_id:"f70d4e3c-f504-5e4c-9528-49872d0ca4ec", kc_id:"f70d4e3c-f504-5e4c-9528-49872d0ca4ec", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 9.2, printed page 313, chapter 9 (Products: Consumer Offerings). Learning outcomes: Define product items, product lines, and product mixes. Describe product line length and depth. Discuss product line filling and product line stretching.", label:"Product Items, Product Lines, and Product Mixes", canonical_key:"product_items_product_lines_and_product_mixes", status:"approved"}}, {concept_id:"395c5bbf-35a6-5b87-998a-bf6ab6edbf73", kc_id:"395c5bbf-35a6-5b87-998a-bf6ab6edbf73", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 9.3, printed page 316, chapter 9 (Products: Consumer Offerings). Learning outcomes: Define the product life cycle. List and describe the stages of the product life cycle.", label:"The Product Life Cycle", canonical_key:"the_product_life_cycle", status:"approved"}}, {concept_id:"4f0ac637-c1e4-5bd6-afc7-8c01697d1066", kc_id:"4f0ac637-c1e4-5bd6-afc7-8c01697d1066", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"method", definition:"Section 9.4, printed page 318, chapter 9 (Products: Consumer Offerings). Learning outcomes: Discuss marketing strategies in the introduction stage of the product life cycle. Classify marketing strategies used in the growth stage of the product life cycle. Characterize marketing strategies used in the maturity stage of the product life cycle. Identify marketing strategies used in the decline stage of the product life cycle.", label:"Marketing Strategies at Each Stage of the Product Life Cycle", canonical_key:"marketing_strategies_at_each_stage_of_the_produc", status:"approved"}}, {concept_id:"b9663649-3073-5788-9a9a-dd1733b2af19", kc_id:"b9663649-3073-5788-9a9a-dd1733b2af19", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 9.5, printed page 320, chapter 9 (Products: Consumer Offerings). Learning outcomes: Define branding and discuss its benefits. Discuss ways in which an organization can build strong brands.", label:"Branding and Brand Development", canonical_key:"branding_and_brand_development", status:"approved"}}, {concept_id:"6b9683b9-bc19-5997-ace5-aa896c297c93", kc_id:"6b9683b9-bc19-5997-ace5-aa896c297c93", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"method", definition:"Section 9.6, printed page 325, chapter 9 (Products: Consumer Offerings). Learning outcomes: Identify branding strategies. Describe degrees of brand loyalty. Discuss metrics that can be used to measure brand strength and value.", label:"Forms of Brand Development, Brand Loyalty, and Brand Metrics", canonical_key:"forms_of_brand_development_brand_loyalty_and_bra", status:"approved"}}, {concept_id:"1de48e95-1987-5d9f-9ee4-bbc1bed9683e", kc_id:"1de48e95-1987-5d9f-9ee4-bbc1bed9683e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 9.7, printed page 329, chapter 9 (Products: Consumer Offerings). Learning outcomes: Describe how an organization creates value through packaging and labeling. Explain how packaging is used as a marketing tool.", label:"Creating Value through Packaging and Labeling", canonical_key:"creating_value_through_packaging_and_labeling", status:"approved"}}, {concept_id:"64ea888e-0dc1-517b-a464-c748ee87427c", kc_id:"64ea888e-0dc1-517b-a464-c748ee87427c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"topic", concept_type:"domain", definition:"Section 9.8, printed page 332, chapter 9 (Products: Consumer Offerings). Learning outcomes: Describe environmental concerns with respect to product packaging. Discuss strategies that are being used to address environmental concerns.", label:"Environmental Concerns Regarding Packaging", canonical_key:"environmental_concerns_regarding_packaging", status:"approved"}}] AS row
