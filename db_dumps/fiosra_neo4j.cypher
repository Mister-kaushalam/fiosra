UNWIND [{concept_id:"95574868-fbab-50b2-82cb-22b74e134b06", kc_id:"95574868-fbab-50b2-82cb-22b74e134b06", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain new brands: an entirely different brand entity from a parent company Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain new brands", canonical_key:"explain_new_brands", status:"approved"}}, {concept_id:"16c34e68-d74b-58d6-9212-484d0ee0ee0e", kc_id:"16c34e68-d74b-58d6-9212-484d0ee0ee0e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain private-label brands: store brands that are similar products to a national brand and labeled privately Source: chapter 9 Key Terms, printed page 337; related section 9.5.", label:"Explain private-label brands", canonical_key:"explain_private_label_brands", status:"approved"}}, {concept_id:"4a327727-32c5-565b-94cf-c50040c8dcce", kc_id:"4a327727-32c5-565b-94cf-c50040c8dcce", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain product item: a particular good that a company sells Source: chapter 9 Key Terms, printed page 337; related section 9.2.", label:"Explain product item", canonical_key:"explain_product_item", status:"approved"}}, {concept_id:"ba05d445-c2f8-593a-afb7-3b7f1f0c90b9", kc_id:"ba05d445-c2f8-593a-afb7-3b7f1f0c90b9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product life cycle: the stages a product goes through, tracking its sales and profitability Source: chapter 9 Key Terms, printed page 337; related section 9.3.", label:"Explain product life cycle", canonical_key:"explain_product_life_cycle", status:"approved"}}, {concept_id:"c5563509-3aed-547f-9584-a28a378574f5", kc_id:"c5563509-3aed-547f-9584-a28a378574f5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain product line: a set of products that are similar or complementary Source: chapter 9 Key Terms, printed page 337; related section 9.2.", label:"Explain product line", canonical_key:"explain_product_line", status:"approved"}}, {concept_id:"bd4e8900-9431-58ce-84ca-13f9f835a4a9", kc_id:"bd4e8900-9431-58ce-84ca-13f9f835a4a9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain product line depth: The number of products or variants within a line, distinct from product-mix width, which counts separate lines; interpret using the chapter’s assortment examples. Source: chapter 9 Key Terms, printed page 337; related section 9.2.", label:"Explain product line depth", canonical_key:"explain_product_line_depth", status:"approved"}}, {concept_id:"cecc916a-42c0-5965-8b25-28d2762429f1", kc_id:"cecc916a-42c0-5965-8b25-28d2762429f1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain product line filling: products added to a product line to keep competitors from entering the market Source: chapter 9 Key Terms, printed page 337; related section 9.2.", label:"Explain product line filling", canonical_key:"explain_product_line_filling", status:"approved"}}, {concept_id:"0b97750e-d10c-5616-b994-ac88f281fd62", kc_id:"0b97750e-d10c-5616-b994-ac88f281fd62", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain product line stretching: Extending a range upward, downward, or in both directions relative to its current price or quality boundaries, as illustrated by Tesla, Godiva, and Dell in section 9.2. The glossary’s brief reference to adding product lines should be read with these directional examples. Source: chapter 9 Key Terms, printed page 337; related section 9.2.", label:"Explain product line stretching", canonical_key:"explain_product_line_stretching", status:"approved"}}, {concept_id:"5580ce64-0f56-5ac3-b786-de16684c9b84", kc_id:"5580ce64-0f56-5ac3-b786-de16684c9b84", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain product mix: all the products a company sells Source: chapter 9 Key Terms, printed page 337; related section 9.2.", label:"Explain product mix", canonical_key:"explain_product_mix", status:"approved"}}, {concept_id:"7a01163f-4665-5c04-87e8-4984cd4d715c", kc_id:"7a01163f-4665-5c04-87e8-4984cd4d715c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain product mix width: the number of product lines a brand carries Source: chapter 9 Key Terms, printed page 337; related section 9.2.", label:"Explain product mix width", canonical_key:"explain_product_mix_width", status:"approved"}}, {concept_id:"0a1facf5-8ec8-5690-818e-a26802883117", kc_id:"0a1facf5-8ec8-5690-818e-a26802883117", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product modification: alteration of products to fit the market Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Explain product modification", canonical_key:"explain_product_modification", status:"approved"}}, {concept_id:"d9a97800-25db-556c-b75b-35593219b016", kc_id:"d9a97800-25db-556c-b75b-35593219b016", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain products: tangible items that are part of an exchange between a buyer and a seller Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain products", canonical_key:"explain_products", status:"approved"}}, {concept_id:"8bee0707-1912-526e-9d37-f33fcea3a6c9", kc_id:"8bee0707-1912-526e-9d37-f33fcea3a6c9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply profit margins: a widely used financial measure to determine the profitability of a business; considers costs to manufacture and sell a product or service Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Apply profit margins", canonical_key:"apply_profit_margins", status:"approved"}}, {concept_id:"dcd60022-354e-58fa-89a8-10d17c2b6961", kc_id:"dcd60022-354e-58fa-89a8-10d17c2b6961", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply rapid penetration pricing strategy: strategy that sets a lower-price strategy; appropriate when volume sales will increase market share quickly Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Apply rapid penetration pricing strategy", canonical_key:"apply_rapid_penetration_pricing_strategy", status:"approved"}}, {concept_id:"26e956ff-ddac-5201-85ab-722978e9fac6", kc_id:"26e956ff-ddac-5201-85ab-722978e9fac6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply rapid skimming strategy: strategy that sets a high price along with extensive advertising and sales promotion to establish a product in the marketplace Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Apply rapid skimming strategy", canonical_key:"apply_rapid_skimming_strategy", status:"approved"}}, {concept_id:"58f2757b-61a5-55dd-a93e-fd5b3dd862ca", kc_id:"58f2757b-61a5-55dd-a93e-fd5b3dd862ca", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain raw materials: products that a business needs to purchase in order to make a consumer good Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain raw materials", canonical_key:"explain_raw_materials", status:"approved"}}, {concept_id:"379dc76c-2027-5da6-8a89-42631a321fc1", kc_id:"379dc76c-2027-5da6-8a89-42631a321fc1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain services: intangible solutions that are an exchange between buyer and seller Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain services", canonical_key:"explain_services", status:"approved"}}, {concept_id:"c88abddc-6d3a-5ed2-bd4d-278b5954052f", kc_id:"c88abddc-6d3a-5ed2-bd4d-278b5954052f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain shifting loyals: customers who are loyal to one product or service for a time, then turn their loyalty to a different product or service at another time Source: chapter 9 Key Terms, printed page 337; related section 9.6.", label:"Explain shifting loyals", canonical_key:"explain_shifting_loyals", status:"approved"}}, {concept_id:"d8ffdea5-33e8-5eba-a88c-6c179277aced", kc_id:"d8ffdea5-33e8-5eba-a88c-6c179277aced", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain shopping products: products that require more thought from the consumer as they seek the best quality or price Source: chapter 9 Key Terms, printed page 337; related section 9.1.", label:"Explain shopping products", canonical_key:"explain_shopping_products", status:"approved"}}, {concept_id:"b1c32f81-3472-5bcb-b2b1-381c0af7b407", kc_id:"b1c32f81-3472-5bcb-b2b1-381c0af7b407", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply slow penetration pricing strategy: strategy that sets low prices and little promotion to capture market share slowly in a market not susceptible to promotion Source: chapter 9 Key Terms, printed page 337; related section 9.4.", label:"Apply slow penetration pricing strategy", canonical_key:"apply_slow_penetration_pricing_strategy", status:"approved"}}] AS row
