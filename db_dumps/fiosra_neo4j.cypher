a0cf2644-ec18-5c8e-b095-3276362aca51"}, end: {concept_id:"151bf51b-2cc6-50d3-b718-0f2e811e8551"}, properties:{rationale:"Relationship selling develops the foundational understanding of customer information and retention."}}, {start: {concept_id:"5de03bab-c8a0-557d-ad82-b19b2dc64e89"}, end: {concept_id:"7202cdf7-c0de-5e1c-b04a-9fc0da613a1e"}, properties:{rationale:"A research problem must be framed against the business decision and objective it is intended to inform."}}] AS row
