UNWIND [{concept_id:"62a58209-9ac3-5a3d-9658-84be657e0725", kc_id:"62a58209-9ac3-5a3d-9658-84be657e0725", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain franchising: a business strategy in which the owner (the franchisor) allows another person or entity (the franchisee) to operate a business using the franchisor’s products, branding, and knowledge in exchange for a fee Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain franchising", canonical_key:"explain_franchising", status:"approved"}}, {concept_id:"635ccf6a-bc22-5147-b35a-b2fbf45ba527", kc_id:"635ccf6a-bc22-5147-b35a-b2fbf45ba527", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain global market opportunities: conditions that are favorable for a company to expand into the global marketplace Source: chapter 7 Key Terms, printed page 250; related section 7.1.", label:"Explain global market opportunities", canonical_key:"explain_global_market_opportunities", status:"approved"}}, {concept_id:"443baaf5-1075-51f8-a69b-530c7da52301", kc_id:"443baaf5-1075-51f8-a69b-530c7da52301", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain international firm: a company that operates on a global level regardless of intensity of involvement Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain international firm", canonical_key:"explain_international_firm", status:"approved"}}, {concept_id:"b1dec21f-9b10-55b9-9f8d-1ecc68cec9d7", kc_id:"b1dec21f-9b10-55b9-9f8d-1ecc68cec9d7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain joint venture: a business arrangement whereby two or more companies create a single enterprise or project Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain joint venture", canonical_key:"explain_joint_venture", status:"approved"}}, {concept_id:"6fa572ba-6b4a-5160-ba4a-cbfffe73050f", kc_id:"6fa572ba-6b4a-5160-ba4a-cbfffe73050f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain licensing: a contract in which one organization permits another to use its name brand or trademark on its own items Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain licensing", canonical_key:"explain_licensing", status:"approved"}}, {concept_id:"a4e13ebe-30db-5fc2-837f-2e39d2c15aaa", kc_id:"a4e13ebe-30db-5fc2-837f-2e39d2c15aaa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain lifestyle: the way a person or group lives Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain lifestyle", canonical_key:"explain_lifestyle", status:"approved"}}, {concept_id:"3a166e6d-8389-54c4-a153-a9aceabed64d", kc_id:"3a166e6d-8389-54c4-a153-a9aceabed64d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain outsourcing: Contracting activities to an external provider. In section 7.5 the textbook focuses on moving operations to a foreign country; distinguish this international example from the broader outsourcing concept rather than treating outsourcing and offshoring as synonyms. Source: chapter 7 Key Terms, printed page 250; related section 7.5.", label:"Explain outsourcing", canonical_key:"explain_outsourcing", status:"approved"}}, {concept_id:"4de2ee2d-7654-52d6-8a95-412696fcdb59", kc_id:"4de2ee2d-7654-52d6-8a95-412696fcdb59", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product adaptation: when companies modify products to align with the local culture Source: chapter 7 Key Terms, printed page 250; related section 7.4.", label:"Explain product adaptation", canonical_key:"explain_product_adaptation", status:"approved"}}, {concept_id:"1add9f93-b5e2-5045-9a13-41a47faab372", kc_id:"1add9f93-b5e2-5045-9a13-41a47faab372", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain product invention: when companies create entirely new products for a global market Source: chapter 7 Key Terms, printed page 250; related section 7.4.", label:"Explain product invention", canonical_key:"explain_product_invention", status:"approved"}}, {concept_id:"ddb97efc-4030-53da-ab73-effcb514650c", kc_id:"ddb97efc-4030-53da-ab73-effcb514650c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze purchasing power: the goods that can be purchased with one unit of currency Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Analyze purchasing power", canonical_key:"analyze_purchasing_power", status:"approved"}}, {concept_id:"f4467a04-62cf-5228-91d2-63f36d5179f8", kc_id:"f4467a04-62cf-5228-91d2-63f36d5179f8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain quotas: maximum allowable units (usually in currency) to be imported into or exported out of a specific country Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain quotas", canonical_key:"explain_quotas", status:"approved"}}, {concept_id:"82b4ba25-cc5d-5446-a968-17c7b6c9c7cd", kc_id:"82b4ba25-cc5d-5446-a968-17c7b6c9c7cd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain risk: any situation or condition that leads a company to decreased profits or even failure Source: chapter 7 Key Terms, printed page 250; related section 7.1.", label:"Explain risk", canonical_key:"explain_risk", status:"approved"}}, {concept_id:"166877e9-7e11-57bc-b5ff-27210453b2ca", kc_id:"166877e9-7e11-57bc-b5ff-27210453b2ca", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain sociocultural factors: values, behaviors, culture, lifestyle, and language that shape a person’s or group’s way of living Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain sociocultural factors", canonical_key:"explain_sociocultural_factors", status:"approved"}}, {concept_id:"1899183b-4605-55bb-8f62-cc32363db96d", kc_id:"1899183b-4605-55bb-8f62-cc32363db96d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply standardized global marketing strategy: a strategy in which a company uses the same marketing strategy in all markets Source: chapter 7 Key Terms, printed page 250; related section 7.4.", label:"Apply standardized global marketing strategy", canonical_key:"apply_standardized_global_marketing_strategy", status:"approved"}}, {concept_id:"5103ddd5-b021-52f7-8999-794d84843b94", kc_id:"5103ddd5-b021-52f7-8999-794d84843b94", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Evaluate stereotypes: oversimplified images, perceptions, or ideas of a person or group Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Evaluate stereotypes", canonical_key:"evaluate_stereotypes", status:"approved"}}, {concept_id:"dfe255c0-5cc5-56a3-b2a9-b1e6d7c8f8bf", kc_id:"dfe255c0-5cc5-56a3-b2a9-b1e6d7c8f8bf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain straight product extension: a strategy that entails maintaining the same product for both the home and foreign markets Source: chapter 7 Key Terms, printed page 250; related section 7.4.", label:"Explain straight product extension", canonical_key:"explain_straight_product_extension", status:"approved"}}, {concept_id:"6eea3dd4-0e5f-57a4-931f-b020896e4502", kc_id:"6eea3dd4-0e5f-57a4-931f-b020896e4502", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain strategic alliance: when two companies from different countries agree to invest resources in a mutually beneficial way Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain strategic alliance", canonical_key:"explain_strategic_alliance", status:"approved"}}, {concept_id:"e3703853-144f-5fd1-8c5d-d2a9d0406923", kc_id:"e3703853-144f-5fd1-8c5d-d2a9d0406923", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain tariffs: taxes that governments impose on imports into the country Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain tariffs", canonical_key:"explain_tariffs", status:"approved"}}, {concept_id:"1825c091-b5e2-5541-80b4-f535feaaeb5b", kc_id:"1825c091-b5e2-5541-80b4-f535feaaeb5b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain trade blocs: intergovernmental agreements that remove barriers to trade within regions of the world Source: chapter 7 Key Terms, printed page 250; related section 7.2.", label:"Explain trade blocs", canonical_key:"explain_trade_blocs", status:"approved"}}, {concept_id:"69bac3e2-a54a-5fb6-9b1a-ffeaf1876ccd", kc_id:"69bac3e2-a54a-5fb6-9b1a-ffeaf1876ccd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain transnational firm: a company that allows for a higher degree of localization Source: chapter 7 Key Terms, printed page 250; related section 7.3.", label:"Explain transnational firm", canonical_key:"explain_transnational_firm", status:"approved"}}] AS row
