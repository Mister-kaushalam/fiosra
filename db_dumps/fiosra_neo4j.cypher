UNWIND [{concept_id:"68b6b7d7-0c1c-5971-8968-0e4dab5a9b0e", kc_id:"68b6b7d7-0c1c-5971-8968-0e4dab5a9b0e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain seminars: a tool that allows companies to share their expertise and knowledge related to a topic, issue, or industry; can be done in person or virtually Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain seminars", canonical_key:"explain_seminars", status:"approved"}}, {concept_id:"2f8733a0-b3eb-51c7-ad97-e6052c272980", kc_id:"2f8733a0-b3eb-51c7-ad97-e6052c272980", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain SERP (Search Engine Results Page): the list of search results that displays on a search engine’s page after someone enters key search terms into a search query box Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain SERP (Search Engine Results Page)", canonical_key:"explain_serp_search_engine_results_page", status:"approved"}}, {concept_id:"1f8b3922-4ff7-52bb-97df-e31e94a8eec2", kc_id:"1f8b3922-4ff7-52bb-97df-e31e94a8eec2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain session: a collection of interactions that occur on a company’s website Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain session", canonical_key:"explain_session", status:"approved"}}, {concept_id:"9ce71ba1-c4fc-55d1-aef1-be92f9996977", kc_id:"9ce71ba1-c4fc-55d1-aef1-be92f9996977", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain social engagement: relates to the number of actions that social media users take in direct relation to your company, brand, or product Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain social engagement", canonical_key:"explain_social_engagement", status:"approved"}}, {concept_id:"0c0e2950-68ae-5bc7-b1ae-3ed2d1ef04bd", kc_id:"0c0e2950-68ae-5bc7-b1ae-3ed2d1ef04bd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain social media marketing: using social media platforms, such as Facebook, Instagram, LinkedIn, and Twitter, to deliver content that drives engagement with your brand Source: chapter 16 Key Terms, printed page 569; related section 16.2.", label:"Explain social media marketing", canonical_key:"explain_social_media_marketing", status:"approved"}}, {concept_id:"a93fc56e-a186-541f-9532-1053fcaced59", kc_id:"a93fc56e-a186-541f-9532-1053fcaced59", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain telemarketing: a type of direct marketing that involves a company representative placing or answering customer phone calls with the intention of guiding the consumer toward making a purchase Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain telemarketing", canonical_key:"explain_telemarketing", status:"approved"}}, {concept_id:"8be2df77-92b4-523f-aa1c-88a1d937467d", kc_id:"8be2df77-92b4-523f-aa1c-88a1d937467d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain trade shows: exhibition events that provide companies the opportunity to present themselves and their products and services to industry peers Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain trade shows", canonical_key:"explain_trade_shows", status:"approved"}}, {concept_id:"ac27c17a-2639-5491-8cd5-82ce2310ec41", kc_id:"ac27c17a-2639-5491-8cd5-82ce2310ec41", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain traffic by source: means paying attention to the site from which the website traffic came Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain traffic by source", canonical_key:"explain_traffic_by_source", status:"approved"}}, {concept_id:"96a90349-a026-57d3-83f1-ba3fade5d7df", kc_id:"96a90349-a026-57d3-83f1-ba3fade5d7df", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"process", definition:"Explain website marketing: The promotion of a website that results in driving traffic or visitors to the site to learn more about the product or company or to make a purchase Source: chapter 16 Key Terms, printed page 569; related section 16.1.", label:"Explain website marketing", canonical_key:"explain_website_marketing", status:"approved"}}, {concept_id:"2b19721b-241b-52e5-824d-3ce29c25aabe", kc_id:"2b19721b-241b-52e5-824d-3ce29c25aabe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain website traffic: the total number of visitors to a company’s website Source: chapter 16 Key Terms, printed page 569; related section 16.3.", label:"Explain website traffic", canonical_key:"explain_website_traffic", status:"approved"}}, {concept_id:"61cef579-aa09-56f9-a560-716ab5b9bffd", kc_id:"61cef579-aa09-56f9-a560-716ab5b9bffd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain accumulating: relates to intermediaries buying in bulk from different manufacturers Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain accumulating", canonical_key:"explain_accumulating", status:"approved"}}, {concept_id:"e6869dbe-e36c-5ad5-a2ea-21039e75ea08", kc_id:"e6869dbe-e36c-5ad5-a2ea-21039e75ea08", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain adjusting for discrepancy of assortment: occurs when an intermediary buys from manufacturers, then regroups products into different assortments based on what consumers are demanding from retailers Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain adjusting for discrepancy of assortment", canonical_key:"explain_adjusting_for_discrepancy_of_assortment", status:"approved"}}, {concept_id:"9ad19e56-0132-5b20-b5eb-96814572fed8", kc_id:"9ad19e56-0132-5b20-b5eb-96814572fed8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain administered VMS: one type of vertical marketing system where there is no ownership of channel members but instead one member who is large enough to coordinate and manage the distribution activities of other channels members Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain administered VMS", canonical_key:"explain_administered_vms", status:"approved"}}, {concept_id:"5d4dbc0d-a217-5d6a-a5a5-ca0bd31d54b8", kc_id:"5d4dbc0d-a217-5d6a-a5a5-ca0bd31d54b8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"entity", definition:"Explain agent: a type of intermediary who acts as an extension to the manufacturer Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain agent", canonical_key:"explain_agent", status:"approved"}}, {concept_id:"d5d4b142-5591-599f-8745-256905cce69a", kc_id:"d5d4b142-5591-599f-8745-256905cce69a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain bulk and weight: the density and heaviness of one unit of product Source: chapter 17 Key Terms, printed page 605; related section 17.3.", label:"Explain bulk and weight", canonical_key:"explain_bulk_and_weight", status:"approved"}}, {concept_id:"c11a7be9-4e7c-5518-a826-f052faf31d22", kc_id:"c11a7be9-4e7c-5518-a826-f052faf31d22", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain bulk-breaking: occurs when an intermediary takes a large bundling of a manufacturer’s product and breaks it down into single units to be distributed to retailers based on the retailer’s order Source: chapter 17 Key Terms, printed page 605; related section 17.1.", label:"Explain bulk-breaking", canonical_key:"explain_bulk_breaking", status:"approved"}}, {concept_id:"27280fe9-0eaa-5400-bec0-d4f64fa923dd", kc_id:"27280fe9-0eaa-5400-bec0-d4f64fa923dd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain business-to-business (B2B): a market comprised of companies who buy from and/or sell to other companies Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain business-to-business (B2B)", canonical_key:"explain_business_to_business_b2b", status:"approved"}}, {concept_id:"1cd8f841-3dad-5081-83f1-55bcda8f1989", kc_id:"1cd8f841-3dad-5081-83f1-55bcda8f1989", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain business-to-consumer (B2C): a market comprised of companies that manufacture and sell products or services directly to a final consumer or end user Source: chapter 17 Key Terms, printed page 605; related section 17.2.", label:"Explain business-to-consumer (B2C)", canonical_key:"explain_business_to_consumer_b2c", status:"approved"}}, {concept_id:"ef071bc9-7e11-5a13-9771-8813653db03a", kc_id:"ef071bc9-7e11-5a13-9771-8813653db03a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze channel conflict: disagreements between companies in the marketing channel due to a competitive versus a collaborative mindset Source: chapter 17 Key Terms, printed page 605; related section 17.4.", label:"Analyze channel conflict", canonical_key:"analyze_channel_conflict", status:"approved"}}, {concept_id:"d5f5648a-3a46-5a41-bcab-9a45aa7a455e", kc_id:"d5f5648a-3a46-5a41-bcab-9a45aa7a455e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain channel length: relates to the number of intermediaries in the marketing channel Source: chapter 17 Key Terms, printed page 605; related section 17.