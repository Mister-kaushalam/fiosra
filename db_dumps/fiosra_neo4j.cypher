C_e9ef201b4adf3ad36197_6eb79a5bf143de6b7966", properties:{kc_id:"KC_e9ef201b4adf3ad36197_833a2f41661bab66ebe7", course_id:"course_2ea0720a", module_id:"module_e79567ba", updated_at:datetime('2026-09-20T13:18:28.917Z'), name:"Trap 4 0", remediation_hint:"Ask which source evidence supports the inference.", status:"pending_review", flawed_rule:"Incorrect inference 4 0"}}, {misconception_id:"MISC_e9ef201b4adf3ad36197_c1f96ad0ba6debfa1c60", properties:{kc_id:"KC_e9ef201b4adf3ad36197_833a2f41661bab66ebe7", course_id:"course_2ea0720a", module_id:"module_e79567ba", updated_at:datetime('2026-09-20T13:18:28.917Z'), name:"Trap 4 1", remediation_hint:"Ask which source evidence supports the inference.", status:"pending_review", flawed_rule:"Incorrect inference 4 1"}}, {misconception_id:"MISC_e9ef201b4adf3ad36197_2d65babe36a86a74c63b", properties:{kc_id:"KC_e9ef201b4adf3ad36197_3ef1e6ba81d83a2a24e7", course_id:"course_2ea0720a", module_id:"module_e79567ba", updated_at:datetime('2026-09-20T13:18:28.917Z'), name:"Trap 5 0", remediation_hint:"Ask which source evidence supports the inference.", status:"pending_review", flawed_rule:"Incorrect inference 5 0"}}, {misconception_id:"MISC_e9ef201b4adf3ad36197_a8a2e23386e131dded90", properties:{kc_id:"KC_e9ef201b4adf3ad36197_3ef1e6ba81d83a2a24e7", course_id:"course_2ea0720a", module_id:"module_e79567ba", updated_at:datetime('2026-09-20T13:18:28.917Z'), name:"Trap 5 1", remediation_hint:"Ask which source evidence supports the inference.", status:"pending_review", flawed_rule:"Incorrect inference 5 1"}}, {misconception_id:"MISC_41bf527d", properties:{name:"Trade vs Sovereignty Trap", flawed_rule:"EIC was purely a commercial company"}}, {misconception_id:"MISC_HARAPPAN_ISOLATION_MYTH_3F2E73", properties:{kc_id:"CON_ANALYZING_HARAPPAN_ARCHAEOLOGICAL_EVIDENCE_EE9736", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.063Z'), name:"Harappan Isolation Myth", created_at:datetime('2026-09-20T10:01:52.063Z'), remediation_hint:"Mesopotamian cuneiform records reference Meluhha (identified as the Harappan region), and Harappan seals found at Ur demonstrate extensive maritime trade networks.", status:"approved", flawed_rule:"Assuming the Indus Valley civilization developed in complete isolation without external trade contacts or cultural exchange."}}, {misconception_id:"MISC_ARYAN_INVASION_DESTRUCTION_THEORY_A49AD1", properties:{kc_id:"CON_DECLINE_OF_THE_INDUS_VALLEY_CIVILIZATION_2AD31B", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.109Z'), name:"Aryan Invasion Destruction Theory", created_at:datetime('2026-09-20T10:01:52.109Z'), remediation_hint:"Archaeological evidence shows gradual de-urbanization over centuries with population migration eastward, not sudden violent destruction. The Aryan Invasion model has been revised to a more nuanced migration framework.", flawed_rule:"Believing that invading Aryans violently destroyed the Indus Valley Civilization, replacing it entirely.", status:"approved"}}, {misconception_id:"MISC_VEDIC_TEXTS_AS_LITERAL_HISTORICAL_ACCOUNTS_49AF6B", properties:{kc_id:"CON_INTERPRETING_VEDIC_TEXTS_AS_HISTORICAL_SOURCES_6AF2D2", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.113Z'), name:"Vedic Texts as Literal Historical Accounts", created_at:datetime('2026-09-20T10:01:52.113Z'), remediation_hint:"The Rigveda contains hymns composed for ritual purposes across centuries; historians cross-reference linguistic analysis, archaeological findings, and comparative Indo-European studies to extract historical information.", status:"approved", flawed_rule:"Treating Vedic hymns and narratives as straightforward factual records rather than ritual and literary compositions requiring critical interpretation."}}, {misconception_id:"MISC_FERTILE_CRESCENT_SOLE_ORIGIN_FALLACY_7FE046", properties:{kc_id:"CON_TRACING_AGRICULTURAL_ORIGINS_AT_MEHRGARH_ED8E0F", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.116Z'), name:"Fertile Crescent Sole Origin Fallacy", created_at:datetime('2026-09-20T10:01:52.116Z'), remediation_hint:"Mehrgarh evidence shows independent domestication of local crops like barley and cattle from at least 7000 BCE, predating or contemporaneous with many Near Eastern developments.", flawed_rule:"Assuming all agricultural development diffused exclusively from the Fertile Crescent, denying independent South Asian agricultural innovation.", status:"approved"}}, {misconception_id:"MISC_ASHOKA_AS_PACIFIST_RULER_MYTH_187E25", properties:{kc_id:"CON_EVALUATING_ASHOKAN_EDICTS_AS_ADMINISTRATIVE_EVID_E85AD6", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.119Z'), name:"Ashoka as Pacifist Ruler Myth", created_at:datetime('2026-09-20T10:01:52.119Z'), remediation_hint:"Ashoka's edicts show he maintained a large standing army and administrative apparatus; dhamma was a governance tool alongside conventional statecraft, not a replacement for it.", flawed_rule:"Interpreting Ashoka's dhamma edicts as evidence that he completely abandoned military force and governed through pure moral persuasion after Kalinga.", status:"approved"}}, {misconception_id:"MISC_ARTHASHASTRA_AS_MAURYAN_CONSTITUTION_FALLACY_5768C1", properties:{kc_id:"CON_COMPARING_MAURYAN_AND_ARTHASHASTRA_ADMINISTRATIV_56CAF1", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.123Z'), name:"Arthashastra as Mauryan Constitution Fallacy", created_at:datetime('2026-09-20T10:01:52.123Z'), remediation_hint:"The Arthashastra is a normative text composed and revised over centuries; its prescriptions represent idealized statecraft that may differ significantly from actual Mauryan practice as revealed by archaeology and epigraphy.", status:"approved", flawed_rule:"Treating the Arthashastra as a direct description of how the Mauryan Empire actually functioned, rather than a prescriptive political treatise."}}, {misconception_id:"MISC_UNIFORM_GOLDEN_AGE_ACROSS_INDIA_1E323B", properties:{kc_id:"CON_ASSESSING_THE_GOLDEN_AGE_NARRATIVE_BECF5C", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.126Z'), name:"Uniform Golden Age Across India", created_at:datetime('2026-09-20T10:01:52.126Z'), remediation_hint:"The Gupta Empire's direct control was limited to northern India; the Vakataka, Pallava, and Kadamba kingdoms in the Deccan and South had independent cultural trajectories. Social stratification meant elite achievements did not reflect ordinary lives.", flawed_rule:"Assuming the Gupta Golden Age was experienced uniformly across all of India and all social strata.", status:"approved"}}, {misconception_id:"MISC_INDIA_AS_PASSIVE_TRADE_RECIPIENT_3F1680", properties:{kc_id:"CON_ANALYZING_TRANS_REGIONAL_TRADE_NETWORKS_B9A598", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.147Z'), name:"India as Passive Trade Recipient", created_at:datetime('2026-09-20T10:01:52.147Z'), remediation_hint:"Indian textiles, spices, and steel were actively exported; Indian merchants established trading colonies in Southeast Asia; the Satavahana coin system facilitated extensive internal commerce.", flawed_rule:"Viewing India as merely a destination for external traders rather than an active participant shaping trade networks and exporting goods.", status:"approved"}}, {misconception_id:"MISC_FRAGMENTATION_EQUALS_DECLINE_FALLACY_A847DA", properties:{kc_id:"CON_EVALUATING_IMPERIAL_FRAGMENTATION_AS_PROCESS_FD1177", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.153Z'), name:"Fragmentation Equals Decline Fallacy", created_at:datetime('2026-09-20T10:01:52.153Z'), remediation_hint:"The post-Mauryan period saw flourishing Buddhist art at Sanchi (UNESCO World Heritage), innovative Indo-Greek coinage, and the rise of the Satavahanas as cultural bridge between North and South India.", flawed_rule:"Equating the breakup of large empires with cultural and political decline, ignoring the dynamism of successor states.", status:"approved"}}, {misconception_id:"MISC_SULTANATE_AS_PURELY_EXTRACTIVE_FOREIGN_RULE_AD7489", properties:{kc_id:"CON_ASSESSING_DELHI_SULTANATE_ECONOMIC_POLICIES_EC9E8E", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.157Z'), name:"Sultanate as Purely Extractive Foreign Rule", created_at:datetime('2026-09-20T10:01:52.157Z'), remediation_hint:"The Sultanate adapted Indian administrative practices, employed Hindu administrators, and Alauddin Khalji's market reforms were sophisticated economic interventions that stabilized prices during military campaigns.", status:"approved", flawed_rule:"Characterizing the Delhi Sultanate exclusively as a foreign extractive regime without acknowledging its integration into Indian political traditions."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_MUGHAL_MONOLITHIC_RELIGIOUS_IDENTITY_0A8C75", properties:{kc_id:"CON_ANALYZING_MUGHAL_ADMINISTRATIVE_INNOVATIONS_FA6F42", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.16Z'), name:"Mughal Monolithic Religious Identity", created_at:datetime('2026-09-20T10:01:52.16Z'), remediation_hint:"Akbar's sulh-i-kul policy, patronage of Hindu courtiers like Todar Mal and Man Singh, and the Din-i-Ilahi experiment demonstrate deliberate religious pluralism as state policy.", flawed_rule:"Assuming the Mughal Empire imposed a single, unified Islamic ideology across all subjects and territories.", status:"approved"}}, {misconception_id:"MISC_SYNCRETISM_AS_ONE_WAY_CULTURAL_IMPOSITION_70633D", properties:{kc_id:"CON_EVALUATING_SYNCRETISM_IN_INDO_ISLAMIC_ART_3850B6", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.164Z'), name:"Syncretism as One-Way Cultural Imposition", created_at:datetime('2026-09-20T10:01:52.164Z'), remediation_hint:"The Taj Mahal incorporates both Persian garden design and Hindu architectural elements (chattris, lotus motifs); Mughal miniature painting synthesized Persian, Central Asian, and Rajput styles.", status:"approved", flawed_rule:"Viewing Indo-Islamic cultural synthesis as merely Islamic culture being imposed on a passive Hindu substrate, rather than a reciprocal creative process."}}, {misconception_id:"MISC_BHAKTI_SUFI_AS_COMPLETE_SOCIAL_REVOLUTION_0E5FD5", properties:{kc_id:"CON_ANALYZING_SOCIAL_REFORM_IN_BHAKTI_SUFI_TRADITION_3FC521", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.17Z'), name:"Bhakti-Sufi as Complete Social Revolution", created_at:datetime('2026-09-20T10:01:52.17Z'), remediation_hint:"While Kabir critiqued caste, many Bhakti traditions developed internal hierarchies. Sufi khanqahs often depended on state patronage and operated within, rather than against, political power structures.", status:"approved", flawed_rule:"Assuming Bhakti and Sufi movements fundamentally dismantled caste and religious hierarchies rather than operating within existing social structures."}}, {misconception_id:"MISC_MARATHAS_AS_MERE_PLUNDERERS_499ED3", properties:{kc_id:"CON_ANALYZING_MARATHA_STATE_BUILDING_05EC0C", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.172Z'), name:"Marathas as Mere Plunderers", created_at:datetime('2026-09-20T10:01:52.172Z'), remediation_hint:"Shivaji established the Ashtapradhan council, revenue system, and navy. The Peshwa administration developed a complex diplomatic network and governed vast territories through a confederacy model.", flawed_rule:"Reducing Maratha power to raiding and plundering without recognizing their sophisticated administrative and governance innovations.", status:"approved"}}, {misconception_id:"MISC_VOLUNTARY_ALLIANCE_MUTUAL_BENEFIT_MYTH_E9F279", properties:{kc_id:"CON_ANALYZING_THE_SUBSIDIARY_ALLIANCE_SYSTEM_8978DC", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.175Z'), name:"Voluntary Alliance Mutual Benefit Myth", created_at:datetime('2026-09-20T10:01:52.175Z'), remediation_hint:"By the early 19th century, subsidiary-allied territories accounted for two-thirds of India. These alliances stripped rulers of military capability while imposing heavy financial burdens.", status:"approved", flawed_rule:"Viewing subsidiary alliances as voluntary partnerships of mutual benefit rather than coercive instruments of imperial control."}}, {misconception_id:"MISC_COLONIAL_RAILWAYS_AS_PURE_MODERNIZATION_BDF8A5", properties:{kc_id:"CON_EVALUATING_THE_DRAIN_OF_WEALTH_THEORY_8B8694", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.178Z'), name:"Colonial Railways as Pure Modernization", created_at:datetime('2026-09-20T10:01:52.178Z'), remediation_hint:"Indian railways were built primarily to transport raw materials to ports and move troops. Routes prioritized port connectivity over internal Indian economic development.", status:"approved", flawed_rule:"Viewing British railway construction in India as a benevolent modernization effort rather than infrastructure serving colonial extraction."}}, {misconception_id:"MISC_RENAISSANCE_AS_PAN_INDIAN_TRANSFORMATION_2B08BE", properties:{kc_id:"CON_ANALYZING_THE_BENGAL_RENAISSANCE_A42D4D", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.181Z'), name:"Renaissance as Pan-Indian Transformation", created_at:datetime('2026-09-20T10:01:52.181Z'), remediation_hint:"It remained largely an elitist movement restricted to Hindu bhadralok in Bengal, with limited reach beyond urban centers, as historian David Kopf acknowledged.", status:"approved", flawed_rule:"Assuming the Bengal Renaissance represented a nationwide social transformation affecting all classes and regions."}}, {misconception_id:"MISC_INDEPENDENCE_AS_SOLELY_GANDHIAN_ACHIEVEMENT_631E65", properties:{kc_id:"CON_EVALUATING_INDEPENDENCE_MOVEMENT_STRATEGIES_F4FA9F", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.186Z'), name:"Independence as Solely Gandhian Achievement", created_at:datetime('2026-09-20T10:01:52.186Z'), remediation_hint:"The movement included Bhagat Singh, Bose and the INA, the Royal Indian Navy mutiny of 1946, and Britain's post-WWII financial exhaustion.", status:"approved", flawed_rule:"Attributing independence entirely to Gandhi's nonviolent movement while ignoring armed resistance, INA, naval mutiny, and WWII's impact."}}, {misconception_id:"MISC_WWI_AS_IRRELEVANT_TO_INDIAN_NATIONALISM_35BF72", properties:{kc_id:"CON_CONNECTING_WWI_SERVICE_TO_POLITICAL_RADICALIZATI_0E17B5", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.188Z'), name:"WWI as Irrelevant to Indian Nationalism", created_at:datetime('2026-09-20T10:01:52.188Z'), remediation_hint:"Over 800,000 Indians volunteered expecting political concessions. The Rowlatt Act extended wartime emergency powers, directly provoking the Jallianwala Bagh protest and Gandhi's first non-cooperation campaign.", status:"approved", flawed_rule:"Treating Indian WWI participation as disconnected from the independence movement."}}, {misconception_id:"MISC_PARTITION_AS_CLEAN_SURGICAL_DIVISION_0D7994", properties:{kc_id:"CON_ASSESSING_THE_IMPACT_OF_PARTITION_602C9F", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.192Z'), name:"Partition as Clean Surgical Division", created_at:datetime('2026-09-20T10:01:52.192Z'), remediation_hint:"Partition displaced 10-20 million people and caused 200,000 to 2 million deaths. The Radcliffe Line was drawn in weeks by someone with no prior knowledge of Indian geography.", flawed_rule:"Viewing Partition as a neat administrative division rather than a catastrophic humanitarian crisis.", status:"approved"}}, {misconception_id:"MISC_CONSTITUTION_AS_WESTERN_IMPORT_61732E", properties:{kc_id:"CON_EVALUATING_INDIA_S_CONSTITUTIONAL_DESIGN_1D50B6", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.196Z'), name:"Constitution as Western Import", created_at:datetime('2026-09-20T10:01:52.196Z'), remediation_hint:"The Constitution uniquely incorporated the reservation system for marginalized castes, directive principles, and provisions for linguistic diversity that addressed specifically Indian challenges.", flawed_rule:"Viewing India's Constitution as merely a copy of Western models without recognizing deliberate adaptations to Indian social realities.", status:"approved"}}, {misconception_id:"MISC_LICENSE_RAJ_AS_PURE_FAILURE_4FB2D0", properties:{kc_id:"CON_COMPARING_DEVELOPMENT_MODELS_IN_INDIA_5E2CAB", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.2Z'), name:"License Raj as Pure Failure", created_at:datetime('2026-09-20T10:01:52.2Z'), remediation_hint:"The planned economy built heavy industry, established IITs, ISRO, BARC, and achieved food self-sufficiency through the Green Revolution, even as it created inefficiencies.", flawed_rule:"Characterizing India's pre-1991 planned economy exclusively as a failure without acknowledging its institutional and industrial contributions.", status:"approved"}}, {misconception_id:"MISC_LINGUISTIC_STATES_AS_DIVISIVE_CONCESSION_DD85BF", properties:{kc_id:"CON_ANALYZING_LINGUISTIC_FEDERALISM_3571AA", course_id:"2bf5b7c4-01ee-4ee5-9c8b-f2066289192a", updated_at:datetime('2026-09-20T10:01:52.203Z'), name:"Linguistic States as Divisive Concession", created_at:datetime('2026-09-20T10:01:52.203Z'), remediation_hint:"Linguistic states strengthened unity by providing democratic channels for regional identity, preventing secessionist pressure that rigid centralism could have caused.", status:"approved", flawed_rule:"Viewing linguistic reorganization as a dangerous concession to regionalism that weakened national unity."}}, {misconception_id:"MISC_5MS_OF_MARKETING_DIAGNOSTIC_MISCONCEPTION_116_529F59", properties:{kc_id:"c4400769-5e31-510e-b4a5-3ffecc604805", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"5Ms of marketing in chapter 1 Closing Company Case task 4: diagnostic misconception 1617", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Closing Company Case, task 4. internal elements of a marketing plan that need to be resolved if the plan is successful", status:"approved", flawed_rule:"The 5Ms are just another name for product, price, place, promotion, and people."}}, {misconception_id:"MISC_BUYER_DIAGNOSTIC_MISCONCEPTION_117_9AEF9E", properties:{kc_id:"eabc4860-5aa6-5535-8027-4340f3fc4ea2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"buyer in chapter 1 Building Your Personal Brand task 4: diagnostic misconception 1603", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Building Your Personal Brand, task 4. a person or institution that purchases goods or services", status:"approved", flawed_rule:"The person paying for an offering must also be its final user."}}, {misconception_id:"MISC_CONSUMER_DIAGNOSTIC_MISCONCEPTION_118_D9B5CA", properties:{kc_id:"987088a3-fe30-5bd9-bda4-de99754407b1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"consumer: diagnostic misconception 118", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.5. the final user of a purchased product or service", status:"approved", flawed_rule:"Only the person who pays can be the consumer."}}, {misconception_id:"MISC_CUSTOMER_DIAGNOSTIC_MISCONCEPTION_119_EA1A24", properties:{kc_id:"2fb9b01f-accc-5c7c-ba59-2e33b7650b86", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"customer in chapter 1 Closing Company Case task 1: diagnostic misconception 1614", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Closing Company Case, task 1. a person who purchases a product or service", status:"approved", flawed_rule:"Every customer personally consumes the product purchased."}}, {misconception_id:"MISC_CUSTOMER_EQUITY_DIAGNOSTIC_MISCONCEPTION_120_EC6B27", properties:{kc_id:"a97031c8-381d-5489-9ba6-cad78494c1f7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer equity: diagnostic misconception 120", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.6. total combined customer lifetime values of all the company’s customers", status:"approved", flawed_rule:"Customer equity is the revenue from this month's transactions."}}, {misconception_id:"MISC_CUSTOMER_LOYALTY_DIAGNOSTIC_MISCONCEPTION_121_BDCCB9", properties:{kc_id:"d865392d-28b5-57f9-9afb-58324c8701b1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"customer loyalty in chapter 11 What Do Marketers Do? task 5: diagnostic misconception 1775", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 11, What Do Marketers Do?, task 5. an ongoing positive relationship between a customer and a business that drives repeat purchases", status:"approved", flawed_rule:"A repeat purchase always proves emotional commitment to the brand."}}, {misconception_id:"MISC_CUSTOMER_RELATIONSHIP_MANAGEMENT_CRM_DIAGNOSTIC__E18A86", properties:{kc_id:"a0cf2644-ec18-5c8e-b095-3276362aca51", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"customer relationship management (CRM) in chapter 1 Closing Company Case task 2: diagnostic misconception 1615", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Closing Company Case, task 2. all strategies, techniques, tools, and technologies used by companies to develop, acquire, and retain customers", status:"approved", flawed_rule:"Installing a customer database alone creates durable customer relationships."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_CUSTOMER_RETENTION_DIAGNOSTIC_MISCONCEPTION_123_0B3FB4", properties:{kc_id:"642febe8-8fe5-575c-bd2e-1494791359c6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer retention: diagnostic misconception 123", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.6. the ability of a company to turn customers into repeat buyers and prevent them from switching to a competitor", status:"approved", flawed_rule:"Winning new customers is the same as retaining existing customers."}}, {misconception_id:"MISC_CUSTOMER_VALUE_DIAGNOSTIC_MISCONCEPTION_124_1A7F5A", properties:{kc_id:"658f08d8-e75f-51b5-a003-32a7f60438f2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"customer value in chapter 1 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1590", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Applied Marketing Knowledge: Discussion Questions, task 1. the ratio of the perceived benefits relative to the costs incurred by the customer in acquiring the product or service", status:"approved", flawed_rule:"The cheapest offering always provides the greatest customer value."}}, {misconception_id:"MISC_CUSTOMER_DRIVEN_MARKETING_STRATEGY_DIAGNOSTIC_MI_EC2B5E", properties:{kc_id:"c30163a6-357c-5c63-b770-242308b92e52", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"customer-driven marketing strategy: diagnostic misconception 125", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. a marketing strategy that shifts the focus from the product or service to its users", status:"approved", flawed_rule:"Customer-driven strategy starts with the product the firm wants to sell, regardless of user needs."}}, {misconception_id:"MISC_DELIGHT_NEEDS_DIAGNOSTIC_MISCONCEPTION_126_7EFE34", properties:{kc_id:"bb1eceea-8fe6-500e-a1ee-962246abc2fb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"delight needs: diagnostic misconception 126", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.5. an added value that a customer might receive from a seller without prior expectation or request for the same", status:"approved", flawed_rule:"Customers must explicitly request every feature that can delight them."}}, {misconception_id:"MISC_DESIRED_OBJECT_DIAGNOSTIC_MISCONCEPTION_127_7799E7", properties:{kc_id:"117a30ec-03c1-5d3e-91ab-d755935bd37a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"desired object: diagnostic misconception 127", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.5. a physical good, service, or experience that consumers expect will satisfy their wants and/or needs", status:"approved", flawed_rule:"Only a physical object can satisfy a need through exchange."}}, {misconception_id:"MISC_ETHICAL_MARKETING_DIAGNOSTIC_MISCONCEPTION_128_6FDAAD", properties:{kc_id:"2868dd5a-6cf2-5772-89a3-10f4ef73a487", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"ethical marketing: diagnostic misconception 128", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.7. process that emphasizes trustworthy, transparent, social, and culturally sensitive marketing policies", status:"approved", flawed_rule:"Marketing is ethical whenever it increases sales without breaking a written rule."}}, {misconception_id:"MISC_EXCHANGE_PROCESS_DIAGNOSTIC_MISCONCEPTION_129_DAB46F", properties:{kc_id:"b61f67d2-121d-51d9-a6ed-c0871b6c9562", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"exchange process: diagnostic misconception 129", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.5. the process of satisfying a need or want by giving something of value in exchange", status:"approved", flawed_rule:"An exchange requires money and a physical product in every case."}}, {misconception_id:"MISC_EXTERNAL_INTERESTED_PARTIES_DIAGNOSTIC_MISCONCEP_F50366", properties:{kc_id:"e1c20505-c18e-5aa9-91ad-911caa20109e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"external interested parties: diagnostic misconception 130", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. a person or organization that does not have a direct relationship with a company but is affected by the operations of the business", status:"approved", flawed_rule:"People outside the payroll cannot be affected by a company's marketing decisions."}}, {misconception_id:"MISC_FORM_UTILITY_DIAGNOSTIC_MISCONCEPTION_131_58D4A4", properties:{kc_id:"c27451e2-b875-5831-a229-8a36da4696fb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"form utility: diagnostic misconception 131", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. the value given to a product by virtue of the fact that the materials and components that comprise it have been combined to make the finished product", status:"approved", flawed_rule:"Moving an unchanged product nearer to customers creates form utility."}}, {misconception_id:"MISC_INTERESTED_PARTIES_DIAGNOSTIC_MISCONCEPTION_132_621F9F", properties:{kc_id:"c8a49b26-5145-5115-a489-e98fcb477e36", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"interested parties: diagnostic misconception 132", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. a group that has an interest in a company or organization and can either affect or be affected by it; often referred to as “stakeholders”", status:"approved", flawed_rule:"Shareholders are the only stakeholders whose interests marketing affects."}}, {misconception_id:"MISC_INTERNAL_INTERESTED_PARTIES_DIAGNOSTIC_MISCONCEP_CCF32A", properties:{kc_id:"8827966c-f8c2-5ed8-adce-92c33c165d54", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"internal interested parties: diagnostic misconception 133", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. those persons whose interest in a company comes through a direct relationship such as employment, ownership, or investment", status:"approved", flawed_rule:"Only senior executives have a direct stake inside an organization."}}, {misconception_id:"MISC_INTERNAL_MARKETING_DIAGNOSTIC_MISCONCEPTION_134_BDB8F7", properties:{kc_id:"2ce97a92-3746-5b02-86eb-620a5f37847f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"internal marketing: diagnostic misconception 134", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. the promotion of a company’s objectives, products, and services to internal parties, such as employees, owners, managers, and shareholders", status:"approved", flawed_rule:"Internal marketing means advertising secretly to external customers."}}, {misconception_id:"MISC_INTERNET_ADVERTISING_DIAGNOSTIC_MISCONCEPTION_13_FE34F1", properties:{kc_id:"46469fe0-f77c-59fe-bce5-2181e844dba5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"internet advertising: diagnostic misconception 135", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.2. a set of tools for delivering promotional messages to people worldwide, using the internet as a global marketing platform", status:"approved", flawed_rule:"Every online mention of a brand is an advertisement purchased by that brand."}}, {misconception_id:"MISC_MACROENVIRONMENT_DIAGNOSTIC_MISCONCEPTION_136_722C4E", properties:{kc_id:"4dc72be3-9b53-50c9-8733-df4545c10b1b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"macroenvironment in chapter 1 Applied Marketing Knowledge: Discussion Questions task 5: diagnostic misconception 1594", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Applied Marketing Knowledge: Discussion Questions, task 5. the set of external factors and forces, not controlled by the company, that influence its operations", status:"approved", flawed_rule:"A firm can directly control economy-wide political and demographic forces."}}, {misconception_id:"MISC_MARKETING_DIAGNOSTIC_MISCONCEPTION_137_3EAC4E", properties:{kc_id:"a133dce9-5c76-57a7-95f7-de94c7834e21", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing: diagnostic misconception 137", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. the activities a company undertakes to promote the buying or selling of a product or service", status:"approved", flawed_rule:"Marketing consists only of advertising and selling finished products."}}, {misconception_id:"MISC_MARKETING_CONCEPT_DIAGNOSTIC_MISCONCEPTION_138_2E1973", properties:{kc_id:"c219507a-9f2a-5b63-80dd-b72fe708cab4", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"marketing concept in chapter 1 Building Your Personal Brand task 5: diagnostic misconception 1604", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Building Your Personal Brand, task 5. marketing philosophy that firms should analyze the needs of their customers and then make decisions to satisfy those needs better than the competition", status:"approved", flawed_rule:"Superior technical features guarantee customer satisfaction without studying needs."}}, {misconception_id:"MISC_MARKETING_ENVIRONMENT_DIAGNOSTIC_MISCONCEPTION_1_4E46B0", properties:{kc_id:"8bfc0c6b-e28e-5ce1-a5f1-1d2c2ebfd5b2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing environment: diagnostic misconception 139", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.3. all of the internal and external factors that drive and influence an organization’s marketing activities", status:"approved", flawed_rule:"Only competitors belong to a firm's marketing environment."}}, {misconception_id:"MISC_MARKETING_MIX_DIAGNOSTIC_MISCONCEPTION_140_1FB27F", properties:{kc_id:"41c8f5e6-df58-50a3-b822-0d11051d2685", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing mix: diagnostic misconception 415", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.1. the four key elements—product, price, place, and promotion—that shape the development and execution of marketing objectives to reach a target market", status:"approved", flawed_rule:"Promotion alone constitutes the marketing mix."}}, {misconception_id:"MISC_MARKETING_PROCESS_DIAGNOSTIC_MISCONCEPTION_141_F5A122", properties:{kc_id:"dbbc7b44-c133-5838-a0b7-8a5762ddf061", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"marketing process in chapter 1 Critical Thinking Exercises task 1: diagnostic misconception 1595", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Critical Thinking Exercises, task 1. the series of steps that assist businesses in planning, analyzing, implementing, and adjusting their marketing strategy", status:"approved", flawed_rule:"Marketing begins after production and ends with the first sale."}}, {misconception_id:"MISC_MARKETING_STRATEGY_DIAGNOSTIC_MISCONCEPTION_142_F8F463", properties:{kc_id:"e79ed921-3d80-5123-a146-3690a80a07ce", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing strategy: diagnostic misconception 142", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. a plan of action designed to promote or sell a product or service", status:"approved", flawed_rule:"A list of advertisements is a complete marketing strategy."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_MICROENVIRONMENT_DIAGNOSTIC_MISCONCEPTION_143_1DAE44", properties:{kc_id:"60e5b0a6-1376-5e4b-a939-1b022f5c3572", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"microenvironment: diagnostic misconception 143", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.3. those factors or elements in a firm’s immediate environment that affect its performance and decision-making", status:"approved", flawed_rule:"Suppliers and intermediaries are distant macroeconomic forces unrelated to daily performance."}}, {misconception_id:"MISC_ORGANIZATIONAL_CULTURE_DIAGNOSTIC_MISCONCEPTION__FCF799", properties:{kc_id:"e47ec223-5c22-56eb-986e-ff9d8c819989", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"organizational culture: diagnostic misconception 144", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.3. beliefs and behaviors that determine how a company’s employees and management interact and handle customer relationships", status:"approved", flawed_rule:"Employee norms have no effect on customer experience."}}, {misconception_id:"MISC_PESTLE_ANALYSIS_DIAGNOSTIC_MISCONCEPTION_145_389798", properties:{kc_id:"ee998526-97c9-5ec3-9a7f-8f263b12eafd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"PESTLE analysis: diagnostic misconception 145", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.3. a strategic framework used to assess the political, economic, social, technological, legal, and environmental factors affecting an organization", status:"approved", flawed_rule:"PESTLE classifies a firm's internal strengths and weaknesses."}}, {misconception_id:"MISC_PLACE_DIAGNOSTIC_MISCONCEPTION_146_2FFEBA", properties:{kc_id:"cf215412-07f9-593b-990f-42d233afdedb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"place: diagnostic misconception 146", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.2. the geographical location in which the company sells its products and/or provides its services", flawed_rule:"Place refers only to the street address of a shop, not customer access and distribution.", status:"approved"}}, {misconception_id:"MISC_PLACE_UTILITY_DIAGNOSTIC_MISCONCEPTION_147_8620B9", properties:{kc_id:"cbb37df9-c4d5-5086-8fca-41c743883c42", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"place utility: diagnostic misconception 147", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. making goods and/or services physically available or accessible to potential customers", status:"approved", flawed_rule:"Availability at the right time and availability at the right location are identical utilities."}}, {misconception_id:"MISC_POSSESSION_UTILITY_DIAGNOSTIC_MISCONCEPTION_148_A92B26", properties:{kc_id:"35041794-f127-5a1e-a1ef-a592237c7df2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"possession utility: diagnostic misconception 148", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. the amount of usefulness or perceived value from owning a product", status:"approved", flawed_rule:"Merely displaying a product gives the customer ownership benefits."}}, {misconception_id:"MISC_PRICE_DIAGNOSTIC_MISCONCEPTION_149_0ACC2B", properties:{kc_id:"638d7624-95f1-5a74-b479-371ef1372194", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"price in chapter 12 Critical Thinking Exercises task 3: diagnostic misconception 1789", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 12, Critical Thinking Exercises, task 3. the exchange of something of value between a buyer and seller", status:"approved", flawed_rule:"Price represents the seller's production cost rather than the customer's exchange sacrifice."}}, {misconception_id:"MISC_PRODUCT_DIAGNOSTIC_MISCONCEPTION_150_6DAE6E", properties:{kc_id:"2deb6ad9-6e70-5979-b97b-ca7414ce3308", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"product in chapter 1 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1593", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Applied Marketing Knowledge: Discussion Questions, task 4. anything that can be offered to a market that might satisfy a want or need", status:"approved", flawed_rule:"A market offering must be a tangible manufactured object."}}, {misconception_id:"MISC_PRODUCT_CONCEPT_DIAGNOSTIC_MISCONCEPTION_151_2ABEC5", properties:{kc_id:"9b883aec-8ca0-5832-975b-a7dac24868e0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product concept: diagnostic misconception 151", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.4. the orientation that consumers will favor those products that offer the most quality, performance, or innovative features", status:"approved", flawed_rule:"The product concept is the same as researching and prioritizing customer needs."}}, {misconception_id:"MISC_PRODUCTION_CONCEPT_DIAGNOSTIC_MISCONCEPTION_152_AC785B", properties:{kc_id:"0e2bd26f-772e-578e-ae5c-1e702d60a594", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"production concept: diagnostic misconception 152", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.4. the orientation that consumers will always acquire products that are cheaper and more readily available", status:"approved", flawed_rule:"The production concept prioritizes customization and exclusivity over availability and low cost."}}, {misconception_id:"MISC_PROMOTION_DIAGNOSTIC_MISCONCEPTION_153_D9A9E9", properties:{kc_id:"2ed14598-0906-5cb0-a256-337e2067468e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"promotion in chapter 1 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1592", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Applied Marketing Knowledge: Discussion Questions, task 3. any type of marketing communication used to inform audiences of the relative merits or a product, service, or brand", status:"approved", flawed_rule:"Promotion means only temporary price discounts."}}, {misconception_id:"MISC_REAL_NEEDS_DIAGNOSTIC_MISCONCEPTION_154_365781", properties:{kc_id:"605f067b-e693-5935-ae86-a1a0a3481890", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"real needs in chapter 1 Building Your Personal Brand task 3: diagnostic misconception 1602", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Building Your Personal Brand, task 3. the value the customer is going to derive from the stated good or service", status:"approved", flawed_rule:"A customer's stated product specification always reveals the underlying benefit sought."}}, {misconception_id:"MISC_RETAILERS_DIAGNOSTIC_MISCONCEPTION_155_8DCACA", properties:{kc_id:"d1600bab-0621-53e4-95f8-5210c3d7fa2d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"retailers: diagnostic misconception 264", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. businesses that sell goods to consumers in relatively small quantities for personal consumption", status:"approved", flawed_rule:"Retailers primarily sell inputs to other businesses for resale."}}, {misconception_id:"MISC_SALES_CONCEPT_DIAGNOSTIC_MISCONCEPTION_156_3D1C4D", properties:{kc_id:"338f1c5e-71ec-5e17-9cc1-707f1c2e4182", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"sales concept: diagnostic misconception 156", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.4. orientation that analyzes buying and selling effects to place the focus primarily on generating sales transactions", status:"approved", flawed_rule:"An aggressive selling orientation automatically produces long-term customer satisfaction."}}, {misconception_id:"MISC_SECRET_NEEDS_DIAGNOSTIC_MISCONCEPTION_157_353576", properties:{kc_id:"e80d91ba-76df-5086-b27b-9cd479032073", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"secret needs in chapter 1 Critical Thinking Exercises task 2: diagnostic misconception 1596", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Critical Thinking Exercises, task 2. the needs that the consumer feels reluctant to admit", status:"approved", flawed_rule:"Needs that customers hesitate to disclose are irrelevant to purchase behavior."}}, {misconception_id:"MISC_SELLER_DIAGNOSTIC_MISCONCEPTION_158_6B1351", properties:{kc_id:"da894d75-69b0-5324-9c7c-94956b1f52d8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"seller: diagnostic misconception 158", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.5. the individual or organization that supplies the need-satisfying product, service, or experience", flawed_rule:"Only a manufacturer can be the seller in an exchange.", status:"approved"}}, {misconception_id:"MISC_SOCIETAL_MARKETING_CONCEPT_DIAGNOSTIC_MISCONCEPT_74385C", properties:{kc_id:"3115ff13-7645-5808-9f59-76e256edeec2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"societal marketing concept: diagnostic misconception 159", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.4. philosophy that a company should make marketing decisions by considering not only consumers’ wants and the company’s capabilities but also society’s long-term interests", status:"approved", flawed_rule:"Satisfying current customer wants always safeguards society's long-term interests."}}, {misconception_id:"MISC_STATED_NEEDS_DIAGNOSTIC_MISCONCEPTION_160_496C31", properties:{kc_id:"18597db8-9067-5a5e-8bab-7475a7a8f64c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"stated needs: diagnostic misconception 160", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.5. those product or service needs that are clearly specified by the customer", status:"approved", flawed_rule:"A customer's explicit request captures all expected and latent needs."}}, {misconception_id:"MISC_SUPPLIERS_DIAGNOSTIC_MISCONCEPTION_161_2919C9", properties:{kc_id:"2afd342a-db72-5991-973d-08ce30e51519", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"suppliers: diagnostic misconception 161", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.3. sometimes also called vendors, these are partners from whom we receive the parts and products necessary for our business", status:"approved", flawed_rule:"Suppliers influence production but cannot affect the firm's marketing promises."}}, {misconception_id:"MISC_TIME_UTILITY_DIAGNOSTIC_MISCONCEPTION_162_D828FF", properties:{kc_id:"d5b9e9ad-bde7-5af8-a704-c9a8567f923e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"time utility: diagnostic misconception 162", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. adding value to the consumer by having the product or service available when the consumer needs it", status:"approved", flawed_rule:"A product available after the customer's deadline provides the same time utility."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_UNSTATED_NEEDS_DIAGNOSTIC_MISCONCEPTION_163_1F8ACD", properties:{kc_id:"411a6b0f-e0ad-5a38-bdd7-19e2971c819a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"unstated needs: diagnostic misconception 163", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.5. those needs that are not obvious but are expected by the customer", status:"approved", flawed_rule:"A service feature matters only if the customer requested it aloud."}}, {misconception_id:"MISC_UTILITY_DIAGNOSTIC_MISCONCEPTION_164_609EF7", properties:{kc_id:"9198bcc1-0fe8-5521-b88b-37452f508039", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"utility: diagnostic misconception 164", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1 Key Terms, printed page 38, and section 1.1. how a product can be useful to customers in a way that convinces them to make a purchase", status:"approved", flawed_rule:"Utility means product functionality alone and excludes access and ownership."}}, {misconception_id:"MISC_VALUE_DIAGNOSTIC_MISCONCEPTION_165_3F161D", properties:{kc_id:"04cead77-2a79-5ebc-875f-8eb3b344ff7c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.34Z'), name:"value in chapter 1 Building Your Personal Brand task 2: diagnostic misconception 1601", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Building Your Personal Brand, task 2. the difference between a customer’s evaluation of the benefits and costs of one product when compared with others", status:"approved", flawed_rule:"Value is an objective price tag shared identically by every customer."}}, {misconception_id:"MISC_VALUE_PROPOSITION_DIAGNOSTIC_MISCONCEPTION_166_2C510A", properties:{kc_id:"7fbbd90c-8620-5f8b-b906-8f864d4a3a6d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"value proposition in chapter 1 Closing Company Case task 3: diagnostic misconception 1616", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 1, Closing Company Case, task 3. a promise of value to be delivered, communicated, and acknowledged", status:"approved", flawed_rule:"A value proposition is a slogan that needs no credible customer benefit."}}, {misconception_id:"MISC_WHOLESALERS_DIAGNOSTIC_MISCONCEPTION_167_A5F31C", properties:{kc_id:"74e3eb7b-1730-5c41-91e8-5df9077c52b6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"wholesalers: diagnostic misconception 270", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. businesses that typically purchase larger quantities from producers and then resell them to retailers", status:"approved", flawed_rule:"Wholesalers and retailers serve exactly the same immediate buyers."}}, {misconception_id:"MISC_BCG_MATRIX_DIAGNOSTIC_MISCONCEPTION_168_0382C6", properties:{kc_id:"0d320565-733c-5b32-a46c-709751c776c3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"BCG matrix in chapter 2 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1618", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Applied Marketing Knowledge: Discussion Questions, task 1. Boston Consulting Group’s framework for analyzing an organization’s strategic business units", status:"approved", flawed_rule:"A business with high market share must be a star regardless of market growth."}}, {misconception_id:"MISC_BUSINESS_PORTFOLIO_DIAGNOSTIC_MISCONCEPTION_169_AC4FC3", properties:{kc_id:"03fa0fb2-fa07-5130-a9e8-dd74a58c4b65", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"business portfolio: diagnostic misconception 169", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.2. the group of products, services, and business units that a company possesses", status:"approved", flawed_rule:"The business portfolio is just the company's best-selling product."}}, {misconception_id:"MISC_BUSINESS_LEVEL_STRATEGY_DIAGNOSTIC_MISCONCEPTION_81561F", properties:{kc_id:"6fd7461d-a0db-54b1-8497-bfac2d998f2f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"business-level strategy: diagnostic misconception 170", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.1. outline of the actions and decisions a company plans to take to reach its goals and objectives", status:"approved", flawed_rule:"Business-level strategy chooses the entire corporation's business portfolio."}}, {misconception_id:"MISC_BUYER_PERSONA_DIAGNOSTIC_MISCONCEPTION_171_80431D", properties:{kc_id:"9df1546c-e12d-5fff-b077-40e7de93b765", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"buyer persona: diagnostic misconception 275", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.5. semi-fictional representation of an organization’s ideal customers based on data and research", status:"approved", flawed_rule:"A buyer persona can be invented from executive stereotypes without customer evidence."}}, {misconception_id:"MISC_CONCENTRIC_DIVERSIFICATION_DIAGNOSTIC_MISCONCEPT_910E3D", properties:{kc_id:"8f535029-2166-595b-81b0-b99b1452a915", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"concentric diversification in chapter 2 Applied Marketing Knowledge: Discussion Questions task 3: diagnostic misconception 1620", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Applied Marketing Knowledge: Discussion Questions, task 3. the addition of similar products or services to an existing business", status:"approved", flawed_rule:"Adding unrelated products is concentric diversification."}}, {misconception_id:"MISC_CONGLOMERATE_DIVERSIFICATION_DIAGNOSTIC_MISCONCE_FF3320", properties:{kc_id:"73dc7f8f-a3ae-5078-8105-5bf6fd3780ff", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"conglomerate diversification: diagnostic misconception 173", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.2. the development and addition of new products or services that are significantly unrelated to a company’s current offerings", status:"approved", flawed_rule:"Conglomerate diversification depends on close similarity to existing offerings."}}, {misconception_id:"MISC_CORPORATE_SOCIAL_RESPONSIBILITY_CSR_DIAGNOSTIC_M_1886E9", properties:{kc_id:"7d99e5b1-0744-5c93-b4a8-7efdd582291b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.173Z'), name:"corporate social responsibility (CSR): diagnostic misconception 878", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 19 Key Terms, printed page 665, and section 19.2. sustainable business strategy where companies use their platform to do good, improve the world, and be socially accountable to their customers and other interested parties", status:"approved", flawed_rule:"Corporate responsibility consists only of charitable donations unrelated to operations."}}, {misconception_id:"MISC_CORPORATE_LEVEL_STRATEGY_DIAGNOSTIC_MISCONCEPTIO_E88324", properties:{kc_id:"d23e2701-a911-598a-aba2-3e65002f30f1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"corporate-level strategy: diagnostic misconception 175", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.1. strategy that establishes the overall value of a business through setting strategic goals and motivating employees to achieve them", status:"approved", flawed_rule:"Corporate strategy is a departmental advertising schedule."}}, {misconception_id:"MISC_CUSTOMER_ACQUISITION_COST_DIAGNOSTIC_MISCONCEPTI_F8834A", properties:{kc_id:"3eaf0de3-4b9d-5a2c-8e96-4299a25a3af5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"customer acquisition cost in chapter 6 Closing Company Case task 4: diagnostic misconception 1693", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 6, Closing Company Case, task 4. the total expenses a company spends to gain a new customer", status:"approved", flawed_rule:"Acquisition cost equals advertising spend per impression."}}, {misconception_id:"MISC_CUSTOMER_LIFETIME_VALUE_CLV_DIAGNOSTIC_MISCONCEP_AC0141", properties:{kc_id:"8ceb2948-e3d2-53a3-8965-faf790dd6ad6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"customer lifetime value (CLV) in chapter 2 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1619", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Applied Marketing Knowledge: Discussion Questions, task 2. an estimate of how much a single customer is worth to a company over their customer life span", status:"approved", flawed_rule:"Customer lifetime value is identical to the customer's first purchase revenue."}}, {misconception_id:"MISC_EXECUTIVE_SUMMARY_DIAGNOSTIC_MISCONCEPTION_178_531743", properties:{kc_id:"d325ea51-db3c-56e9-a72d-8d7c6bd0776e", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"executive summary in chapter 2 Marketing Plan Exercise task 1: diagnostic misconception 1627", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Marketing Plan Exercise, task 1. a brief overview of a marketing plan", status:"approved", flawed_rule:"The executive summary should substitute for the analysis and evidence in a marketing plan."}}, {misconception_id:"MISC_FUNCTIONAL_STRATEGY_DIAGNOSTIC_MISCONCEPTION_179_6C5BDE", properties:{kc_id:"b5ff9040-39c4-5e23-84b4-3d8ea68cca8c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"functional strategy: diagnostic misconception 179", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.1. actions and goals assigned to business units that support the overall business strategy", status:"approved", flawed_rule:"A function's strategy can be chosen independently of business-level goals."}}, {misconception_id:"MISC_GAP_ANALYSIS_DIAGNOSTIC_MISCONCEPTION_180_54738B", properties:{kc_id:"1ad3b2cc-8d83-54c4-9e5c-c3cfa147c4d7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"gap analysis: diagnostic misconception 180", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.1. an internal analysis of a company or organization to identify and review its inherent deficiencies that may hinder its ability to meet its goals", status:"approved", flawed_rule:"Gap analysis lists competitors without comparing current and desired performance."}}, {misconception_id:"MISC_GOALS_DIAGNOSTIC_MISCONCEPTION_181_EAE14C", properties:{kc_id:"90286492-c187-5b90-9566-0e0d0b5b01a1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"goals in chapter 2 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1621", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Applied Marketing Knowledge: Discussion Questions, task 4. the outcomes one intends to achieve", status:"approved", flawed_rule:"Broad goals automatically specify measurable deadlines."}}, {misconception_id:"MISC_HORIZONTAL_DIVERSIFICATION_DIAGNOSTIC_MISCONCEPT_D845B7", properties:{kc_id:"7a732b2a-5d0f-50fc-94f6-195734e513a9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"horizontal diversification: diagnostic misconception 182", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.2. the development of new and perhaps even unrelated products or services to market to existing customers so that a company can garner a larger customer base", status:"approved", flawed_rule:"Selling existing products in a new country is horizontal diversification."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_KEY_PERFORMANCE_INDICATORS_KPIS_DIAGNOSTIC_MISCO_66D7FF", properties:{kc_id:"9e19e1b9-0f4a-5a09-9f65-fed003424ff0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"key performance indicators (KPIs) in chapter 2 Closing Company Case task 4: diagnostic misconception 1631", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Closing Company Case, task 4. quantifiable measure gauging a company’s performance against a set of targets, objectives, or competitors", status:"approved", flawed_rule:"Every available metric is equally important regardless of the objective."}}, {misconception_id:"MISC_MARKET_DEVELOPMENT_STRATEGY_DIAGNOSTIC_MISCONCEP_446AF8", properties:{kc_id:"9c0b843f-8977-50e5-b482-300731a59d7f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"market development strategy: diagnostic misconception 184", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.2. a growth strategy that identifies and develops new market segments for current products", status:"approved", flawed_rule:"Selling new products to existing customers is market development."}}, {misconception_id:"MISC_MARKET_PENETRATION_STRATEGY_DIAGNOSTIC_MISCONCEP_9E70DF", properties:{kc_id:"5bee8e1b-704f-576e-a221-bff7176178dc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"market penetration strategy in chapter 2 Closing Company Case task 3: diagnostic misconception 1630", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Closing Company Case, task 3. a strategy used when a company focuses on growing its market share in its existing markets", status:"approved", flawed_rule:"Entering a new market is market penetration."}}, {misconception_id:"MISC_MARKETING_DASHBOARD_DIAGNOSTIC_MISCONCEPTION_186_253DEA", properties:{kc_id:"8e13c0e1-229c-58c3-93ad-4852548dafae", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"marketing dashboard in chapter 2 What Do Marketers Do? task 1: diagnostic misconception 1626", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, What Do Marketers Do?, task 1. summarizes important marketing metrics and key performance indicators into easy- to-understand measurements", status:"approved", flawed_rule:"A dashboard improves decisions merely by displaying as many metrics as possible."}}, {misconception_id:"MISC_MARKETING_ETHICS_DIAGNOSTIC_MISCONCEPTION_187_D98D22", properties:{kc_id:"f7187a54-2aa8-5bdf-9bdb-66389207cdf6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing ethics: diagnostic misconception 187", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.5. area of applied ethics dealing with the moral principles behind the operation and regulation of marketing", status:"approved", flawed_rule:"Legal compliance alone resolves every ethical marketing question."}}, {misconception_id:"MISC_MARKETING_METRICS_DIAGNOSTIC_MISCONCEPTION_188_5FF66D", properties:{kc_id:"99224684-3ef9-572c-9d69-32c094aae126", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"marketing metrics: diagnostic misconception 188", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.4. what marketers use to monitor, record, and measure progress over time; are varied and can change from platform to platform", status:"approved", flawed_rule:"Higher activity counts necessarily demonstrate progress toward business objectives."}}, {misconception_id:"MISC_MISSION_STATEMENT_DIAGNOSTIC_MISCONCEPTION_189_06BDB5", properties:{kc_id:"d566bfcd-1cfc-5fe6-a6bd-626165856d90", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"mission statement in chapter 2 Closing Company Case task 1: diagnostic misconception 1628", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Closing Company Case, task 1. action-based statement declaring the purpose of an organization", status:"approved", flawed_rule:"A mission statement is only a distant picture of what the organization hopes to become."}}, {misconception_id:"MISC_OBJECTIVES_DIAGNOSTIC_MISCONCEPTION_190_BFC044", properties:{kc_id:"5de03bab-c8a0-557d-ad82-b19b2dc64e89", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"objectives: diagnostic misconception 190", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.1. specific targets to be achieved within a specified period of time", status:"approved", flawed_rule:"An objective can be evaluated without a target or time period."}}, {misconception_id:"MISC_PRODUCT_DEVELOPMENT_STRATEGY_DIAGNOSTIC_MISCONCE_B73836", properties:{kc_id:"4d4a3e4b-20d7-52e0-af5a-a7de650f4191", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product development strategy: diagnostic misconception 191", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.2. complete process of delivering a new product or improving an existing one for customers", status:"approved", flawed_rule:"Selling an unchanged product to a new market is product development."}}, {misconception_id:"MISC_PRODUCT_DIVERSIFICATION_STRATEGY_DIAGNOSTIC_MISC_A1634E", properties:{kc_id:"03b9e954-c524-596f-b812-c6af873a8f9b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product diversification strategy: diagnostic misconception 192", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.2. strategy to increase profitability and achieve higher sales volume through new products", status:"approved", flawed_rule:"Diversification is simply increasing sales of existing products in existing markets."}}, {misconception_id:"MISC_PRODUCT_POSITIONING_DIAGNOSTIC_MISCONCEPTION_193_1AD32E", properties:{kc_id:"0957ef85-0174-5bdb-a051-2e9693a45e48", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product positioning: diagnostic misconception 290", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.6. the process of deciding and communicating how an organization wants its market to think and feel about a product or service", status:"approved", flawed_rule:"Positioning is the product's physical location on a store shelf."}}, {misconception_id:"MISC_STRATEGIC_BUSINESS_UNIT_DIAGNOSTIC_MISCONCEPTION_73B78F", properties:{kc_id:"12259664-c2e9-59a2-8c3d-9d28007a0ef2", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"strategic business unit in chapter 2 Critical Thinking Exercises task 3: diagnostic misconception 1624", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Critical Thinking Exercises, task 3. a relatively autonomous division of a large company that operates as an independent enterprise with responsibility for a particular range of products or activities", status:"approved", flawed_rule:"Every internal department is an independent strategic business unit."}}, {misconception_id:"MISC_STRATEGY_DIAGNOSTIC_MISCONCEPTION_195_1BE47B", properties:{kc_id:"d503d6ef-859e-560f-a269-cd0d743c0721", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"strategy in chapter 2 Building Your Personal Brand task 1: diagnostic misconception 1625", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Building Your Personal Brand, task 1. set of plans, actions, and goals that outlines how a business will compete", status:"approved", flawed_rule:"Strategy and individual promotional tactics are interchangeable."}}, {misconception_id:"MISC_SWOT_ANALYSIS_DIAGNOSTIC_MISCONCEPTION_196_3CBF77", properties:{kc_id:"b97971ab-2e32-53e5-84cd-14c25dad8bd7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"SWOT analysis in chapter 2 Critical Thinking Exercises task 2: diagnostic misconception 1623", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2, Critical Thinking Exercises, task 2. identification of internal strengths and weaknesses and external opportunities and threats impacting a business", status:"approved", flawed_rule:"Opportunities and threats are internal attributes controlled by the firm."}}, {misconception_id:"MISC_VISION_STATEMENT_DIAGNOSTIC_MISCONCEPTION_197_1F4203", properties:{kc_id:"c88b8633-1785-5254-9974-6506008e6083", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"vision statement: diagnostic misconception 197", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 2 Key Terms, printed page 84, and section 2.1. aspirational statement that articulates what an organization aims to achieve", status:"approved", flawed_rule:"A vision statement only describes the company's current activities."}}, {misconception_id:"MISC_4PS_DIAGNOSTIC_MISCONCEPTION_198_7A443A", properties:{kc_id:"6b1c64a9-b7d8-5a20-89ef-ae4324840177", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"4Ps: diagnostic misconception 198", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.1. the “marketing mix”—product, price, promotion, and place", status:"approved", flawed_rule:"The 4Ps describe promotional media rather than coordinated marketing decisions."}}, {misconception_id:"MISC_ATTITUDES_DIAGNOSTIC_MISCONCEPTION_199_F55505", properties:{kc_id:"5ad91224-b302-573e-ba2f-f1421d3d30e3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"attitudes: diagnostic misconception 199", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. a learned set of emotions, beliefs, and behaviors developed toward a particular brand, object, person, thing, or event", status:"approved", flawed_rule:"A favorable attitude guarantees a purchase regardless of context and constraints."}}, {misconception_id:"MISC_BELIEFS_DIAGNOSTIC_MISCONCEPTION_200_121510", properties:{kc_id:"0a5575d3-71e1-533d-b3e1-e3a966779dfb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"beliefs: diagnostic misconception 200", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. ideas that a person holds as being true", status:"approved", flawed_rule:"A belief held by consumers must be factually correct."}}, {misconception_id:"MISC_BUYER_S_BLACK_BOX_DIAGNOSTIC_MISCONCEPTION_201_B94EDE", properties:{kc_id:"eead67ac-9065-5425-92ac-6f5ec0e66912", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"buyer’s black box: diagnostic misconception 201", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.1. a model used in the study of the buying behavior of consumers", status:"approved", flawed_rule:"Identical marketing stimuli produce identical decisions in all consumers."}}, {misconception_id:"MISC_COGNITIVE_DISSONANCE_DIAGNOSTIC_MISCONCEPTION_20_B894FD", properties:{kc_id:"79aaa815-d5ec-591c-a85e-38e392c735a3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cognitive dissonance: diagnostic misconception 202", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.3. the mental conflict that occurs when a person’s behaviors and beliefs do not align; also referred to as buyer’s remorse", status:"approved", flawed_rule:"A completed purchase eliminates all doubt about the choice."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_COMPLEX_BUYING_BEHAVIOR_DIAGNOSTIC_MISCONCEPTION_AAB59B", properties:{kc_id:"8b44b484-60d8-500a-8cda-34ef2c1ded62", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"complex buying behavior: diagnostic misconception 203", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.1. the consumer buying behavior that occurs when the consumer is highly involved with the purchase and perceives significant differences between brands", status:"approved", flawed_rule:"All expensive purchases involve little deliberation and no perceived brand differences."}}, {misconception_id:"MISC_CONSUMER_BUYING_BEHAVIOR_DIAGNOSTIC_MISCONCEPTIO_8DA05F", properties:{kc_id:"c3c50dfc-192c-5c25-b105-17ce522ce6dc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"consumer buying behavior in chapter 3 Closing Company Case task 1: diagnostic misconception 1642", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Closing Company Case, task 1. the actions taken by consumers before buying a product or service", status:"approved", flawed_rule:"Consumer behavior consists only of the final payment transaction."}}, {misconception_id:"MISC_CONSUMER_DECISION_PROCESS_DIAGNOSTIC_MISCONCEPTI_638C89", properties:{kc_id:"fbc8550e-b99b-5ae2-bca9-c95a23e03b19", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"consumer decision process in chapter 3 Closing Company Case task 4: diagnostic misconception 1645", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Closing Company Case, task 4. the process through which consumers become aware of and identify their needs, collect information on how to best solve those needs, evaluate alternative options, make a purchasing decision, and evaluate their purchase", status:"approved", flawed_rule:"All purchases require equal effort in every decision stage."}}, {misconception_id:"MISC_CONSUMER_MARKET_DIAGNOSTIC_MISCONCEPTION_206_8E2437", properties:{kc_id:"d8f115fc-e821-5bbe-b0a9-6f57772e7ed8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"consumer market in chapter 3 Critical Thinking Exercises task 2: diagnostic misconception 1638", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Critical Thinking Exercises, task 2. a market where consumers purchase products and/or services for consumption", status:"approved", flawed_rule:"Purchases for industrial production belong to the consumer market."}}, {misconception_id:"MISC_CULTURAL_FACTORS_DIAGNOSTIC_MISCONCEPTION_207_8CB68B", properties:{kc_id:"87a0d2af-90e0-5286-a2ff-3b484dc30fc0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"cultural factors: diagnostic misconception 207", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. a set of values or ideologies of a particular community or group of individuals that include culture, subcultures, social class, and gender", status:"approved", flawed_rule:"Culture affects food choices but not broader consumer decisions."}}, {misconception_id:"MISC_CULTURE_DIAGNOSTIC_MISCONCEPTION_208_554484", properties:{kc_id:"295336ee-9e18-5baf-93d9-b03a0b24becb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"culture: diagnostic misconception 407", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 8 Key Terms, printed page 298, and section 8.3. objective and subjective elements like social norms, beliefs, behaviors, accomplishments, customs, arts, language, foods, and skills that characterize a particular group of individuals’ way of life", status:"approved", flawed_rule:"Culture is inherited biologically and cannot be learned or changed."}}, {misconception_id:"MISC_DISSONANCE_REDUCING_BUYING_BEHAVIOR_DIAGNOSTIC_M_F465C4", properties:{kc_id:"c0aeeb45-ac70-5729-8aa6-376052533df0", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"dissonance-reducing buying behavior: diagnostic misconception 209", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.1. any activity aimed at decreasing the tension or feelings of discomfort and unease that accompany an unfamiliar purchase", status:"approved", flawed_rule:"Dissonance-reducing buying is a low-involvement search for variety."}}, {misconception_id:"MISC_ECONOMIC_SITUATION_DIAGNOSTIC_MISCONCEPTION_210_2DF1B9", properties:{kc_id:"14123556-8489-5f17-bd96-1b3bad69da5f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"economic situation: diagnostic misconception 210", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. a measure of a consumer’s income and financial situation", status:"approved", flawed_rule:"Two consumers with different budgets can act on identical preferences equally easily."}}, {misconception_id:"MISC_ENVIRONMENTAL_FACTORS_DIAGNOSTIC_MISCONCEPTION_2_8482BB", properties:{kc_id:"20116b3b-692b-5563-9f22-b2f82ecec66d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"environmental factors in chapter 3 Critical Thinking Exercises task 3: diagnostic misconception 1639", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Critical Thinking Exercises, task 3. factors such as music, lighting, ambient noise, and smell that can either discourage or encourage a consumer’s purchase decision", status:"approved", flawed_rule:"Lighting, music, and smell cannot influence purchase behavior."}}, {misconception_id:"MISC_FAMILY_DIAGNOSTIC_MISCONCEPTION_212_2EAAAB", properties:{kc_id:"da857466-7bed-57c9-b138-7e440a4c522f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"family in chapter 3 Critical Thinking Exercises task 1: diagnostic misconception 1637", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Critical Thinking Exercises, task 1. a group of persons united by ties of marriage, blood, or adoption, or those who live in the same household", status:"approved", flawed_rule:"Only an individual buyer matters; household members do not influence the decision."}}, {misconception_id:"MISC_GENDER_DIAGNOSTIC_MISCONCEPTION_213_3ED303", properties:{kc_id:"a045782c-d386-5e80-9c8d-3f7bd30815f9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"gender: diagnostic misconception 213", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the socially constructed roles, behaviors, and norms of individuals, which vary between societies and over time", flawed_rule:"Gender predicts identical preferences for every person in a category.", status:"approved"}}, {misconception_id:"MISC_HABITUAL_BUYING_BEHAVIOR_DIAGNOSTIC_MISCONCEPTIO_B326B7", properties:{kc_id:"39b38f56-4d73-5857-a5da-b0d6823ed4c3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"habitual buying behavior: diagnostic misconception 214", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.1. consumer buying decisions made out of “habit” and without much deliberation or product comparison", status:"approved", flawed_rule:"Repeated purchases always reflect a deliberate comparison of all brands."}}, {misconception_id:"MISC_HEURISTICS_DIAGNOSTIC_MISCONCEPTION_215_6667E0", properties:{kc_id:"2d385689-6047-577f-adaa-7355c9ee90bc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"heuristics: diagnostic misconception 215", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.3. mental shortcuts that allow people to solve problems and make judgments quickly and efficiently", status:"approved", flawed_rule:"Mental shortcuts guarantee fully accurate purchase decisions."}}, {misconception_id:"MISC_LEARNING_DIAGNOSTIC_MISCONCEPTION_216_474BE0", properties:{kc_id:"01d3299a-7388-5cea-b55d-1b7c3b28b2b6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"learning: diagnostic misconception 216", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the acquisition of knowledge or skills through experience, study, or being taught", status:"approved", flawed_rule:"Previous product experiences cannot change future purchasing behavior."}}, {misconception_id:"MISC_LIFE_CYCLE_STAGES_DIAGNOSTIC_MISCONCEPTION_217_96950A", properties:{kc_id:"0df32088-b42d-5ae9-9556-31a701c55534", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"life cycle stages: diagnostic misconception 217", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. various stages in a human’s life, including fetus, baby, childhood, adolescence, adulthood, and elderly", status:"approved", flawed_rule:"Age-related needs stay constant from childhood through retirement."}}, {misconception_id:"MISC_LIFESTYLE_DIAGNOSTIC_MISCONCEPTION_218_E7BA9E", properties:{kc_id:"fd58ab6f-f9c3-5158-9485-e0ba49cfe94c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"lifestyle: diagnostic misconception 383", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 7 Key Terms, printed page 250, and section 7.2. the way a person or group lives", status:"approved", flawed_rule:"Consumers with the same income necessarily share the same lifestyle."}}, {misconception_id:"MISC_MASLOW_S_HIERARCHY_OF_NEEDS_DIAGNOSTIC_MISCONCEP_5E1AD2", properties:{kc_id:"015edd43-9ee7-58f6-8b79-26ab6fc57056", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"Maslow’s hierarchy of needs in chapter 3 Applied Marketing Knowledge: Discussion Questions task 5: diagnostic misconception 1636", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Applied Marketing Knowledge: Discussion Questions, task 5. a theory of motivation by Abraham Maslow which states that five categories of human needs dictate an individual’s behavior", status:"approved", flawed_rule:"A single need category explains all customers' motives in all circumstances."}}, {misconception_id:"MISC_MOTIVATION_DIAGNOSTIC_MISCONCEPTION_220_CB8C59", properties:{kc_id:"21a087c6-2790-5be6-9a9d-ac7dede45fa6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"motivation: diagnostic misconception 220", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the process that initiates, guides, and maintains goal-oriented behaviors", status:"approved", flawed_rule:"A need automatically produces the same action in every consumer."}}, {misconception_id:"MISC_OCCUPATION_DIAGNOSTIC_MISCONCEPTION_221_ACB7A7", properties:{kc_id:"bf490bbd-554c-57be-ac36-0d5530d73568", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"occupation: diagnostic misconception 221", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. an activity or task with which one occupies oneself, usually the productive activity, service, trade, or craft for which one is regularly paid", status:"approved", flawed_rule:"Occupation is irrelevant to product requirements and purchase priorities."}}, {misconception_id:"MISC_PERCEPTION_DIAGNOSTIC_MISCONCEPTION_222_6D507D", properties:{kc_id:"93f6befe-072d-5978-932b-d6bbbd74eb0f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"perception: diagnostic misconception 222", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the manner in which sensory information is organized, interpreted, and consciously experienced", status:"approved", flawed_rule:"Consumers passively register marketing messages exactly as the sender intended."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_PERSONALITY_DIAGNOSTIC_MISCONCEPTION_223_F0CE97", properties:{kc_id:"e9ec1776-8341-58a1-b024-8ed3722c2a18", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"personality in chapter 3 Building Your Personal Brand task 1: diagnostic misconception 1640", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Building Your Personal Brand, task 1. the combination of characteristics or qualities that form an individual’s distinctive character", status:"approved", flawed_rule:"People in the same demographic category have identical personalities."}}, {misconception_id:"MISC_PRODUCT_DIFFERENTIATION_DIAGNOSTIC_MISCONCEPTION_1AE5B4", properties:{kc_id:"56a8ce97-bb7e-5cf1-8c72-ab571ecc8278", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"product differentiation: diagnostic misconception 224", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.4. a marketing strategy in which a brand identifies the one thing that makes it genuinely different from competitors", status:"approved", flawed_rule:"Any technical difference will necessarily matter to target buyers."}}, {misconception_id:"MISC_REFERENCE_GROUPS_DIAGNOSTIC_MISCONCEPTION_225_48ECB4", properties:{kc_id:"882b021e-21a4-57db-9a16-632e106ad508", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"reference groups in chapter 3 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1633", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Applied Marketing Knowledge: Discussion Questions, task 2. groups that consumers compare themselves to or associate with", status:"approved", flawed_rule:"Only groups a consumer formally belongs to can influence purchases."}}, {misconception_id:"MISC_ROLES_DIAGNOSTIC_MISCONCEPTION_226_56A498", properties:{kc_id:"7e8c3b26-5a25-5bbb-84e0-24d9cf926110", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"roles: diagnostic misconception 226", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the set of norms, values, behaviors, and personality characteristics attached to a status", flawed_rule:"A person's role and relative status are the same concept.", status:"approved"}}, {misconception_id:"MISC_SELECTIVE_ATTENTION_DIAGNOSTIC_MISCONCEPTION_227_844C7F", properties:{kc_id:"0ed7d359-41e9-59ed-bfcc-7634684d5d81", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"selective attention: diagnostic misconception 227", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the process of directing one’s awareness to relevant stimuli while ignoring irrelevant stimuli in the environment", status:"approved", flawed_rule:"Consumers notice every promotional stimulus they encounter."}}, {misconception_id:"MISC_SELECTIVE_DISTORTION_DIAGNOSTIC_MISCONCEPTION_22_CE2AC3", properties:{kc_id:"f073bf90-ee4a-5f26-a763-c16a67daf923", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"selective distortion: diagnostic misconception 228", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. a tendency of people to interpret information in a manner that supports what they already believe", status:"approved", flawed_rule:"Consumers interpret all new information independently of existing beliefs."}}, {misconception_id:"MISC_SELECTIVE_RETENTION_DIAGNOSTIC_MISCONCEPTION_229_61213F", properties:{kc_id:"288ba33b-d932-5fb8-b20e-2364e8203ebd", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"selective retention: diagnostic misconception 229", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the tendency of people to retain only part of the information to which they are exposed", status:"approved", flawed_rule:"Consumers remember every part of an advertisement equally well."}}, {misconception_id:"MISC_SOCIAL_CLASS_DIAGNOSTIC_MISCONCEPTION_230_7B612A", properties:{kc_id:"babb9135-7eab-5d81-81da-9cda10636f13", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"social class in chapter 3 Closing Company Case task 2: diagnostic misconception 1643", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Closing Company Case, task 2. a group of people within a society that possesses the same or similar socioeconomic status", status:"approved", flawed_rule:"Social class is determined solely by a single recent purchase."}}, {misconception_id:"MISC_SOCIAL_FACTORS_DIAGNOSTIC_MISCONCEPTION_231_AC75E4", properties:{kc_id:"9ab58cad-6f42-5f9b-aeb9-14ecaf42e397", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"social factors in chapter 3 Closing Company Case task 3: diagnostic misconception 1644", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Closing Company Case, task 3. factors that are prevalent in the society where a consumer lives", status:"approved", flawed_rule:"Purchases are isolated individual decisions unaffected by others."}}, {misconception_id:"MISC_STATUS_DIAGNOSTIC_MISCONCEPTION_232_54CE03", properties:{kc_id:"c1264d51-7ec8-554a-a8cb-1a3030a0eb53", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"status: diagnostic misconception 232", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. the relative social, professional, or other standing of an individual", flawed_rule:"Status refers to the duties a role requires rather than relative standing.", status:"approved"}}, {misconception_id:"MISC_SUBCULTURE_DIAGNOSTIC_MISCONCEPTION_233_9E0976", properties:{kc_id:"53e65cfc-5591-5183-b569-a042340f2ffb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"subculture: diagnostic misconception 233", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3 Key Terms, printed page 120, and section 3.2. a cultural group within a larger culture, often having beliefs or interests at variance with those in the larger culture", status:"approved", flawed_rule:"Members of a larger culture cannot also belong to distinct subcultures."}}, {misconception_id:"MISC_VARIETY_SEEKING_BUYING_BEHAVIOR_DIAGNOSTIC_MISCO_CC6784", properties:{kc_id:"7b194f65-b823-5f5c-ab92-e5c9a75bd5e9", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"variety-seeking buying behavior in chapter 3 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1632", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 3, Applied Marketing Knowledge: Discussion Questions, task 1. the buying tendencies of consumers who do not have a high involvement with a product when there are significant differences between brands", status:"approved", flawed_rule:"Switching brands always signals dissatisfaction with the previous brand."}}, {misconception_id:"MISC_AUTHORITY_DIAGNOSTIC_MISCONCEPTION_235_A6E606", properties:{kc_id:"2a818560-7359-5b1d-8129-67950a461884", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"authority: diagnostic misconception 235", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. the right to give orders, supervise the work of others, and make certain decisions", status:"approved", flawed_rule:"The most knowledgeable buying-center member necessarily has final approval authority."}}, {misconception_id:"MISC_B2B_BUYING_PROCESS_DIAGNOSTIC_MISCONCEPTION_236_F48F0F", properties:{kc_id:"683ca285-be29-5516-9d65-5c6e03acf330", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"B2B buying process in chapter 4 Closing Company Case task 4: diagnostic misconception 1664", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Closing Company Case, task 4. encompasses 8 stages: problem recognition, need description, product specification, supplier search, proposal selection, supplier selection, order-routine specification, performance review", status:"approved", flawed_rule:"Organizational purchasing ends with selecting a supplier and needs no performance review."}}, {misconception_id:"MISC_BILL_OF_MATERIALS_DIAGNOSTIC_MISCONCEPTION_237_CD7296", properties:{kc_id:"e7e813dc-63cd-5840-a30e-b7bf592ea4a5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"bill of materials: diagnostic misconception 237", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.4. a comprehensive inventory of the raw materials, assemblies, subassemblies, parts, and components", status:"approved", flawed_rule:"A bill of materials is simply the supplier's payment invoice."}}, {misconception_id:"MISC_BROKERS_DIAGNOSTIC_MISCONCEPTION_238_9417B0", properties:{kc_id:"e516fd62-21d5-5b5f-8da5-60f938c2bafa", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"brokers: diagnostic misconception 238", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. individuals or businesses that bring buyers and sellers together, usually for a commission", status:"approved", flawed_rule:"Brokers must buy and own every product whose sale they arrange."}}, {misconception_id:"MISC_BUSINESS_OBJECTIVES_AND_GOALS_DIAGNOSTIC_MISCONC_6E03B2", properties:{kc_id:"e6fff05e-98a5-547b-b64b-b735d601a68c", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"business objectives and goals in chapter 4 What Do Marketers Do? task 1: diagnostic misconception 1655", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, What Do Marketers Do?, task 1. achievable outcomes that provide a framework for achieving success", status:"approved", flawed_rule:"Organizational purchasing is unrelated to the buying firm's performance goals."}}, {misconception_id:"MISC_BUSINESS_TO_BUSINESS_B2B_DIAGNOSTIC_MISCONCEPTIO_E8F699", properties:{kc_id:"37a5a6c6-bb64-5eb5-94c9-835962801fe3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"business-to-business (B2B) in chapter 4 Building Your Personal Brand task 1: diagnostic misconception 1654", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Building Your Personal Brand, task 1. a transaction or business conducted between one business and another", status:"approved", flawed_rule:"B2B transactions are defined by product size rather than who buys and why."}}, {misconception_id:"MISC_BUY_CLASSES_DIAGNOSTIC_MISCONCEPTION_241_82403C", properties:{kc_id:"8fac20af-6f91-545d-8557-299b0a0cdaf8", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"buy classes in chapter 4 Closing Company Case task 2: diagnostic misconception 1662", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Closing Company Case, task 2. buying situations that are distinguished on four characteristics: newness to decision makers, number of alternatives to be considered, uncertainty inherent in the buying situation, and the amount of information needed for making a buying decision", status:"approved", flawed_rule:"Every repeat purchase requires the same decision effort as a first-time purchase."}}, {misconception_id:"MISC_BUYERS_DIAGNOSTIC_MISCONCEPTION_242_5B8228", properties:{kc_id:"01712ec5-cf8e-515f-a047-f8aeac0b5a19", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"buyers in chapter 4 Closing Company Case task 4: diagnostic misconception 1659", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Closing Company Case, task 4. the people in the buying center who handle the paperwork of the actual purchase", status:"approved", flawed_rule:"The buying-center member completing paperwork always makes the final choice alone."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_BUYING_CENTER_DIAGNOSTIC_MISCONCEPTION_243_BEAA23", properties:{kc_id:"c953315f-0754-5b04-aa2a-93ea089500f5", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"buying center in chapter 4 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1649", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Applied Marketing Knowledge: Discussion Questions, task 4. groups of people within organizations who make purchasing decisions", status:"approved", flawed_rule:"A buying center is a physical procurement office with a single decision maker."}}, {misconception_id:"MISC_COMPETITION_DIAGNOSTIC_MISCONCEPTION_244_12F564", properties:{kc_id:"0ba18286-8ebe-505b-9823-52b472e7ef9d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"competition: diagnostic misconception 244", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.3. the rivalry between companies selling similar products and services with the goal of achieving revenue, profit and market share growth", status:"approved", flawed_rule:"Only firms selling an identical branded product create competitive pressure."}}, {misconception_id:"MISC_DECIDERS_DIAGNOSTIC_MISCONCEPTION_245_8DBAE0", properties:{kc_id:"54301af1-3258-5ed9-98bb-9d16baab06b7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"deciders in chapter 4 Critical Thinking Exercises task 1: diagnostic misconception 1651", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Critical Thinking Exercises, task 1. the people in the buying center who ultimately determine any part of the entire buying decision", status:"approved", flawed_rule:"The person using the product is always the final decision maker."}}, {misconception_id:"MISC_DERIVED_DEMAND_DIAGNOSTIC_MISCONCEPTION_246_61C38C", properties:{kc_id:"6c31b559-e926-5ef0-b61d-8f7093f6a54f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"derived demand in chapter 4 Closing Company Case task 1: diagnostic misconception 1661", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Closing Company Case, task 1. market demand for a good or service that results from a demand for a related good or service", status:"approved", flawed_rule:"Demand for business inputs is independent of demand for downstream products."}}, {misconception_id:"MISC_DIRECT_DEMAND_DIAGNOSTIC_MISCONCEPTION_247_D8595B", properties:{kc_id:"a3386d12-f952-5ee1-a22d-13cdb3e9ed16", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"direct demand: diagnostic misconception 247", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.1. the demand for a commodity for direct consumption purposes", status:"approved", flawed_rule:"Demand for manufacturing inputs is direct final-consumption demand."}}, {misconception_id:"MISC_ECONOMIC_FACTORS_DIAGNOSTIC_MISCONCEPTION_248_40D1D3", properties:{kc_id:"15ca22a6-d126-51d3-99e1-852608afe363", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"economic factors: diagnostic misconception 248", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.3. factors that affect the economy, such as interest rates, tax rates, laws, policies, wages, and government actions", status:"approved", flawed_rule:"Interest rates and wages cannot affect organizational procurement."}}, {misconception_id:"MISC_EXPERTISE_DIAGNOSTIC_MISCONCEPTION_249_1E7422", properties:{kc_id:"e3f758d3-4129-50af-bf26-5f38df6f27ed", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"expertise: diagnostic misconception 249", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.3. expert skill or knowledge in a particular field", status:"approved", flawed_rule:"Technical expertise always confers formal purchasing authority."}}, {misconception_id:"MISC_FOREIGN_CORRUPT_PRACTICES_ACT_FCPA_DIAGNOSTIC_MI_AEC366", properties:{kc_id:"e05d7798-6986-581e-93f4-8c9526867a90", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"Foreign Corrupt Practices Act (FCPA) in chapter 4 Critical Thinking Exercises task 2: diagnostic misconception 1652", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Critical Thinking Exercises, task 2. a US statute that prohibits firms and individuals from paying bribes to foreign officials", status:"approved", flawed_rule:"Bribery of foreign officials becomes acceptable whenever it is locally customary."}}, {misconception_id:"MISC_GATEKEEPERS_DIAGNOSTIC_MISCONCEPTION_251_B66797", properties:{kc_id:"7af6a648-fc41-5e14-a85c-f8c1854b95a7", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"gatekeepers: diagnostic misconception 251", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. individuals in the buying center who control information and/or access to decision makers and influencers", status:"approved", flawed_rule:"Gatekeepers make the final purchase decision simply because they control access."}}, {misconception_id:"MISC_GOVERNMENT_MARKETS_DIAGNOSTIC_MISCONCEPTION_252_D8C75B", properties:{kc_id:"4ed011b2-62c2-56d6-bc28-ab9b5096d803", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"government markets: diagnostic misconception 252", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. purchases made by the governing bodies of nations, states, or communities", status:"approved", flawed_rule:"Government purchasing follows exactly the same priorities as private consumer purchasing."}}, {misconception_id:"MISC_INFLUENCE_DIAGNOSTIC_MISCONCEPTION_253_3E4D96", properties:{kc_id:"a4487939-b0af-5adf-8c16-052cee271cfc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"influence in chapter 4 Closing Company Case task 1: diagnostic misconception 1656", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Closing Company Case, task 1. the capacity to have an effect on the character, development, or behavior of someone or something", status:"approved", flawed_rule:"Only formal job authority gives a buying-center member influence."}}, {misconception_id:"MISC_INFLUENCERS_DIAGNOSTIC_MISCONCEPTION_254_481412", properties:{kc_id:"69c0119c-3c69-5957-9abc-ab3b1f4bb80d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"influencers: diagnostic misconception 254", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. individuals whose views influence other members of the buying center in making the final decision", status:"approved", flawed_rule:"Influencers must personally approve or pay for the order."}}, {misconception_id:"MISC_INITIATOR_DIAGNOSTIC_MISCONCEPTION_255_428237", properties:{kc_id:"0ea15e6c-a73a-5680-9941-c3ed8aa02317", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"initiator: diagnostic misconception 255", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. the person in the buying center who first suggests or thinks of the idea of buying the product or service", status:"approved", flawed_rule:"The person identifying a need must also be the authorized buyer."}}, {misconception_id:"MISC_INSTITUTIONS_DIAGNOSTIC_MISCONCEPTION_256_E8B6B6", properties:{kc_id:"55cfc922-8301-5485-807a-f12b8dd4087a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"institutions: diagnostic misconception 256", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. organizations, establishments, foundations, societies, or the like devoted to the promotion of a particular cause or program, especially one of a public, educational, or charitable character", status:"approved", flawed_rule:"Nonprofit institutions do not participate in business markets."}}, {misconception_id:"MISC_MODIFIED_REBUY_DIAGNOSTIC_MISCONCEPTION_257_363982", properties:{kc_id:"c2b92c28-99ab-58d3-8af0-1d6a291a816b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"modified rebuy: diagnostic misconception 257", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. a buying situation in which an individual or organization buys goods that have been purchased previously but changes either the supplier or some element of the previous order", status:"approved", flawed_rule:"Changing supplier or specifications still constitutes an unchanged straight rebuy."}}, {misconception_id:"MISC_NEW_TASK_BUY_DIAGNOSTIC_MISCONCEPTION_258_AD931C", properties:{kc_id:"621e2ed9-2c3d-506e-9de0-29c6f42cc7fc", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"new-task buy in chapter 4 Closing Company Case task 3: diagnostic misconception 1658", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Closing Company Case, task 3. a complex B2B buying situation in which the organization buys a product or service for the first time", status:"approved", flawed_rule:"A first-time organizational purchase can always use the routine of a straight rebuy."}}, {misconception_id:"MISC_POLITICAL_AND_LEGAL_FACTORS_DIAGNOSTIC_MISCONCEP_784E76", properties:{kc_id:"6b4bab4d-5941-5254-8714-d9b5891bbc02", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"political and legal factors: diagnostic misconception 260", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.3. factors such as the political system, the political situation, and government policies that influence B2B buying decisions", status:"approved", flawed_rule:"Procurement choices are insulated from public policy and political conditions."}}, {misconception_id:"MISC_PRODUCERS_DIAGNOSTIC_MISCONCEPTION_261_B9D964", properties:{kc_id:"7239f00f-4d4f-5dff-841a-b3c8c9c8004d", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"producers: diagnostic misconception 261", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. those individuals or businesses who buy raw goods to use in the creation of goods or services", status:"approved", flawed_rule:"Producers buy primarily for resale without transformation."}}, {misconception_id:"MISC_PRODUCT_SPECIFICATIONS_DIAGNOSTIC_MISCONCEPTION__7EC573", properties:{kc_id:"99e96cfc-9fd9-50f5-a5ab-4ddcd61fc53f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"product specifications in chapter 4 Applied Marketing Knowledge: Discussion Questions task 5: diagnostic misconception 1650", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Applied Marketing Knowledge: Discussion Questions, task 5. a document carrying essential information to keep teams on track when designing and developing a product", status:"approved", flawed_rule:"A product specification merely states the total purchasing budget."}}, {misconception_id:"MISC_RESELLERS_DIAGNOSTIC_MISCONCEPTION_263_DD3E32", properties:{kc_id:"73024c70-4cec-5d60-8836-9e00d14e7fd3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"resellers in chapter 4 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1647", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Applied Marketing Knowledge: Discussion Questions, task 2. companies or individuals (merchants) that purchase goods or services with the intention of selling, leasing, or renting rather than consuming or using them", status:"approved", flawed_rule:"Resellers purchase goods mainly for their own final consumption."}}] AS row
CREATE (n:Misconception{misconception_id: row.misconception_id}) SET n += row.properties;
UNWIND [{misconception_id:"MISC_SOCIAL_ENVIRONMENT_DIAGNOSTIC_MISCONCEPTION_265_31C937", properties:{kc_id:"481ebc53-d42a-59c1-b73a-e3bfe1fb316b", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"social environment: diagnostic misconception 265", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.3. the values, attitudes, beliefs, wants, and desires of the consuming public", status:"approved", flawed_rule:"Shared social values have no influence on business customers."}}, {misconception_id:"MISC_STRAIGHT_REBUYS_DIAGNOSTIC_MISCONCEPTION_266_0C80DD", properties:{kc_id:"172f3a24-fc18-541a-a406-f2ee8f560b58", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"straight rebuys: diagnostic misconception 266", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. purchases in which the business customer buys the same goods from the same supplier in the same quantity at the same terms and requires minimal decision making", status:"approved", flawed_rule:"Every repeat purchase is a straight rebuy even when supplier and terms change."}}, {misconception_id:"MISC_SYSTEMS_SELLING_DIAGNOSTIC_MISCONCEPTION_267_3F5339", properties:{kc_id:"7a572b16-e665-5927-acf2-18652aa03837", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"systems selling in chapter 4 Critical Thinking Exercises task 3: diagnostic misconception 1653", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Critical Thinking Exercises, task 3. selling a complete solution to a problem or need rather than one or more of the component parts", status:"approved", flawed_rule:"Systems selling means offering unrelated components without an integrated solution."}}, {misconception_id:"MISC_TECHNOLOGY_DIAGNOSTIC_MISCONCEPTION_268_05E702", properties:{kc_id:"ef11a491-dea4-5795-b6f3-7b836acb407a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"technology in chapter 4 Closing Company Case task 5: diagnostic misconception 1660", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4, Closing Company Case, task 5. applications of science, data, engineering, and information for business purposes", status:"approved", flawed_rule:"Technology influences product design but not procurement decisions."}}, {misconception_id:"MISC_USERS_DIAGNOSTIC_MISCONCEPTION_269_FF91EC", properties:{kc_id:"8c8fe9f4-d77a-5bd9-9492-905220bbddcb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"users: diagnostic misconception 269", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.2. the people who consume or use the product or service", flawed_rule:"Product users always control purchasing budgets and supplier selection.", status:"approved"}}, {misconception_id:"MISC_WORKFORCE_SKILLS_DIAGNOSTIC_MISCONCEPTION_271_AB8736", properties:{kc_id:"4a39e618-e5b5-58bb-9356-eb8d13873b4f", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"workforce skills: diagnostic misconception 271", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 4 Key Terms, printed page 148, and section 4.3. also called employability skills, the basic skills a person must have to succeed in any workplace", status:"approved", flawed_rule:"Employee capability cannot constrain an organization's purchase choices."}}, {misconception_id:"MISC_ADAMS_DIAGNOSTIC_MISCONCEPTION_272_1D8F88", properties:{kc_id:"a4fb8733-42da-53ce-b43c-e3e6d005f98a", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"ADAMS: diagnostic misconception 272", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.4. the essential factors in effective market segmentation—accessible, differentiable, actionable, measurable, and substantial", status:"approved", flawed_rule:"A segment is useful as soon as it can be named, even if it is inaccessible or too small."}}, {misconception_id:"MISC_AFFINITY_AUDIENCE_DIAGNOSTIC_MISCONCEPTION_273_CADBF6", properties:{kc_id:"cadd38f6-188e-5009-bfc4-8f05c1eb5a22", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"affinity audience in chapter 5 Applied Marketing Knowledge: Discussion Questions task 4: diagnostic misconception 1668", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Applied Marketing Knowledge: Discussion Questions, task 4. a group of potential customers who have interests or hobbies in common", status:"approved", flawed_rule:"People sharing an interest necessarily share age, income, and purchasing power."}}, {misconception_id:"MISC_BEHAVIORAL_SEGMENTATION_DIAGNOSTIC_MISCONCEPTION_A9E6D4", properties:{kc_id:"2b03de80-65ed-5320-9938-5d02179935b1", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"behavioral segmentation: diagnostic misconception 274", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.1. method of grouping customers by their behavior patterns or interactions with a brand", status:"approved", flawed_rule:"Grouping by age and income is behavioral segmentation."}}, {misconception_id:"MISC_CONCENTRATED_MARKETING_DIAGNOSTIC_MISCONCEPTION__C0B96C", properties:{kc_id:"9c4f441c-6700-5389-b356-e81a43ee35f6", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"concentrated marketing in chapter 5 Applied Marketing Knowledge: Discussion Questions task 2: diagnostic misconception 1666", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Applied Marketing Knowledge: Discussion Questions, task 2. marketing segmentation strategy in which the firm concentrates its efforts and resources on serving one segment of the market", status:"approved", flawed_rule:"Concentrated marketing means targeting everyone with the same message."}}, {misconception_id:"MISC_DEMOGRAPHIC_SEGMENTATION_DIAGNOSTIC_MISCONCEPTIO_A286D2", properties:{kc_id:"afb9f82c-f751-5d47-84de-dae3deaf1bfb", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"demographic segmentation: diagnostic misconception 277", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.1. grouping customers and potential customers together by focusing on certain traits such as age, gender, income, occupation, and family status", status:"approved", flawed_rule:"Demographics directly reveal each customer's motivations and values."}}, {misconception_id:"MISC_DETERMINANT_ATTRIBUTES_DIAGNOSTIC_MISCONCEPTION__B2635C", properties:{kc_id:"af6f0de3-ccde-5ec5-a2f5-11d463dd5694", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:37.999Z'), name:"determinant attributes: diagnostic misconception 278", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5 Key Terms, printed page 190, and section 5.6. those attributes of a product or service that consumers rely upon when making a purchase decision", status:"approved", flawed_rule:"Every product feature carries equal weight in the purchase decision."}}, {misconception_id:"MISC_DIFFERENTIATED_MARKETING_DIAGNOSTIC_MISCONCEPTIO_C560F2", properties:{kc_id:"3e87a5c4-5e75-5b5d-a7c6-985c702388c3", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"differentiated marketing in chapter 5 Applied Marketing Knowledge: Discussion Questions task 1: diagnostic misconception 1665", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Applied Marketing Knowledge: Discussion Questions, task 1. marketing strategy that involves creating marketing campaigns that appeal to two or more different target audiences, demographics, or marketing segments", status:"approved", flawed_rule:"Differentiated marketing uses one unchanged offer for every segment."}}, {misconception_id:"MISC_DIFFERENTIATION_POSITIONING_DIAGNOSTIC_MISCONCEP_E43E3D", properties:{kc_id:"b5420677-6dec-5ef5-90e4-2fb1ee308023", course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", updated_at:datetime('2026-09-20T10:16:38.609Z'), name:"differentiation positioning in chapter 5 Closing Company Case task 3: diagnostic misconception 1677", created_at:datetime('2026-09-20T10:16:37.999Z'), remediation_hint:"Use chapter 5, Closing Company Case, task 3. product/service positioning based on the differentiating characteristics or qualities that make an organization better than its competitors in the mind of the target audience", status:"approved", flawed_rule:"A positioning claim needs no meaningful customer-perceived difference."}}] AS row
