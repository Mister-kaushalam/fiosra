UNWIND [{concept_id:"64e9c5d5-6fce-578a-842f-cf7ab4451d38", kc_id:"64e9c5d5-6fce-578a-842f-cf7ab4451d38", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Explain how consumers may consider environmental, social, and organizational conduct alongside price and functionality. Source: section 3.4, printed page 116.", label:"Evaluate ethical consumerism", canonical_key:"evaluate_ethical_consumerism", status:"approved"}}, {concept_id:"c2ca922e-3bc5-54b0-9722-5977f321937d", kc_id:"c2ca922e-3bc5-54b0-9722-5977f321937d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze buyer numbers and size, geographic concentration, derived and fluctuating demand, buying professionalism, relationships, and decision complexity. Source: section 4.1, printed page 128.", label:"Compare B2B and B2C market structures", canonical_key:"compare_b2b_and_b2c_market_structures", status:"approved"}}, {concept_id:"19b406fb-94c9-5086-bfbd-e370f9b8f0c2", kc_id:"19b406fb-94c9-5086-bfbd-e370f9b8f0c2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Trace problem recognition, general need description, product specification, supplier search, proposal solicitation, supplier selection, order-routine specification, and performance review; note variation by buy class. Source: section 4.4, printed page 141.", label:"Sequence the eight-stage B2B buying process", canonical_key:"sequence_the_eight_stage_b2b_buying_process", status:"approved"}}, {concept_id:"1a79b48c-d08d-5306-bc82-2a30baad0614", kc_id:"1a79b48c-d08d-5306-bc82-2a30baad0614", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Assess time constraints, financial conditions, and product availability alongside organizational and interpersonal factors. Source: section 4.3, printed page 138.", label:"Analyze conditional influences on procurement", canonical_key:"analyze_conditional_influences_on_procurement", status:"approved"}}, {concept_id:"c2dc0db1-7d7d-5d12-9626-2f361c183256", kc_id:"c2dc0db1-7d7d-5d12-9626-2f361c183256", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Combine geographic, demographic, behavioral, and psychographic information to form actionable segments. Source: section 5.1, printed page 156.", label:"Combine segmentation bases", canonical_key:"combine_segmentation_bases", status:"approved"}}, {concept_id:"0717294d-8a6a-5952-be46-e2c759c57c0c", kc_id:"0717294d-8a6a-5952-be46-e2c759c57c0c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Apply AIO information to psychographic segmentation and distinguish it from purely demographic classification. Source: section 5.1, printed page 156.", label:"Use activities, interests, and opinions", canonical_key:"use_activities_interests_and_opinions", status:"approved"}}, {concept_id:"99bee53e-717e-585d-b5f6-4a2a620b2044", kc_id:"99bee53e-717e-585d-b5f6-4a2a620b2044", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Segment across geographic, economic, political-legal, and cultural conditions rather than assuming national borders uniquely define needs. Source: section 5.3, printed page 169.", label:"Compare international segmentation bases", canonical_key:"compare_international_segmentation_bases", status:"approved"}}, {concept_id:"ed6c50a8-ded4-5bad-8eb2-856bd669e523", kc_id:"ed6c50a8-ded4-5bad-8eb2-856bd669e523", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess accessibility, differentiability, actionability, measurability, and substantiality before selecting a segment. Source: section 5.4, printed page 174.", label:"Test all five ADAMS criteria", canonical_key:"test_all_five_adams_criteria", status:"approved"}}, {concept_id:"a755be23-e0ad-51b2-adb3-e45751401a7f", kc_id:"a755be23-e0ad-51b2-adb3-e45751401a7f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Examine ethnic profiling and targeting of children, older adults, and low-income consumers, distinguishing relevant service from manipulation. Source: section 5.7, printed page 186.", label:"Evaluate targeting of vulnerable groups", canonical_key:"evaluate_targeting_of_vulnerable_groups", status:"approved"}}, {concept_id:"224ed7c1-c69c-5581-8d9a-368697bf12cc", kc_id:"224ed7c1-c69c-5581-8d9a-368697bf12cc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Move from problem definition through research design, collection method, sampling, collection, analysis and interpretation, to reporting actionable findings. Source: section 6.3, printed page 203.", label:"Design the seven-stage research plan", canonical_key:"design_the_seven_stage_research_plan", status:"approved"}}, {concept_id:"42d3302b-3978-5c35-84e4-e819e41fa52e", kc_id:"42d3302b-3978-5c35-84e4-e819e41fa52e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Match research design to discovery, measurement, or causal inference and distinguish association from causation. Source: section 6.3, printed page 203.", label:"Compare exploratory, descriptive, and causal research", canonical_key:"compare_exploratory_descriptive_and_causal_resea", status:"approved"}}, {concept_id:"226d111d-60b6-58b4-9b5e-eae74940b9fc", kc_id:"226d111d-60b6-58b4-9b5e-eae74940b9fc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Use clear wording and appropriate response options; evaluate how leading, ambiguous, or double-barreled questions distort answers. Source: section 6.3, printed page 203.", label:"Construct an unbiased questionnaire", canonical_key:"construct_an_unbiased_questionnaire", status:"approved"}}, {concept_id:"2bef14c7-f069-557b-aa64-dd1f30fcca14", kc_id:"2bef14c7-f069-557b-aa64-dd1f30fcca14", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Distinguish target population, sampling frame, sample design, and achieved respondents when judging representativeness. Source: section 6.3, printed page 203.", label:"Audit sample coverage and nonresponse", canonical_key:"audit_sample_coverage_and_nonresponse", status:"approved"}}, {concept_id:"b36af02e-306e-57c7-81ca-9b0fa94a8d7b", kc_id:"b36af02e-306e-57c7-81ca-9b0fa94a8d7b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Translate quantitative results and qualitative observations into evidence-supported recommendations with clear limitations. Source: section 6.3, printed page 203.", label:"Report research for a business decision", canonical_key:"report_research_for_a_business_decision", status:"approved"}}, {concept_id:"a924f1de-9f74-552d-8f8b-23f9d6d8cbf1", kc_id:"a924f1de-9f74-552d-8f8b-23f9d6d8cbf1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Compare revenue, growth, competition, risk diversification, and surplus disposal against regulatory, cultural, and operating challenges. Source: section 7.1, printed page 228.", label:"Evaluate benefits and risks of international trade", canonical_key:"evaluate_benefits_and_risks_of_international_tra", status:"approved"}}, {concept_id:"5d8a69c3-127c-5811-9066-6b720e54c156", kc_id:"5d8a69c3-127c-5811-9066-6b720e54c156", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess organizational capabilities and resources before comparing external foreign-market opportunities. Source: section 7.2, printed page 232.", label:"Conduct an internal global-readiness assessment", canonical_key:"conduct_an_internal_global_readiness_assessment", status:"approved"}}, {concept_id:"ab8daaad-3009-562a-8c6b-a9c1055d9660", kc_id:"ab8daaad-3009-562a-8c6b-a9c1055d9660", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Distinguish corruption-risk information, international trade institutions, and regional trade agreements when assessing international market access. Source: section 7.2, printed page 232.", label:"Compare the CPI, WTO, and trade blocs", canonical_key:"compare_the_cpi_wto_and_trade_blocs", status:"approved"}}, {concept_id:"c81ed0d5-29e7-5fcd-8393-5bc38cfdfc12", kc_id:"c81ed0d5-29e7-5fcd-8393-5bc38cfdfc12", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Evaluate exporting, licensing, franchising, alliances, joint ventures, and direct investment in terms of control, resources, and exposure. Source: section 7.3, printed page 241.", label:"Compare international entry commitments", canonical_key:"compare_international_entry_commitments", status:"approved"}}, {concept_id:"12d02a88-857b-566a-8f5c-9fd8b76e6f4b", kc_id:"12d02a88-857b-566a-8f5c-9fd8b76e6f4b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Coordinate product, price, place, and promotion with local markets, exchange rates, whole-channel conditions, and cultural meanings. Source: section 7.4, printed page 243.", label:"Adapt the international marketing mix", canonical_key:"adapt_the_international_marketing_mix", status:"approved"}}, {concept_id:"d7bf1645-d7ff-5765-864d-38577066690b", kc_id:"d7bf1645-d7ff-5765-864d-38577066690b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Evaluate working conditions, child labor, equal opportunity, outsourcing, bribery, and corruption using the textbook's international examples. Source: section 7.5, printed page 247.", label:"Assess global labor and sourcing ethics", canonical_key:"assess_global_labor_and_sourcing_ethics", status:"approved"}}] AS row
