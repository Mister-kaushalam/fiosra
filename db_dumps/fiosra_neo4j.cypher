UNWIND [{concept_id:"af6f0de3-ccde-5ec5-a2f5-11d463dd5694", kc_id:"af6f0de3-ccde-5ec5-a2f5-11d463dd5694", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain determinant attributes: those attributes of a product or service that consumers rely upon when making a purchase decision Source: chapter 5 Key Terms, printed page 190; related section 5.6.", label:"Explain determinant attributes", canonical_key:"explain_determinant_attributes", status:"approved"}}, {concept_id:"3e87a5c4-5e75-5b5d-a7c6-985c702388c3", kc_id:"3e87a5c4-5e75-5b5d-a7c6-985c702388c3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain differentiated marketing: marketing strategy that involves creating marketing campaigns that appeal to two or more different target audiences, demographics, or marketing segments Source: chapter 5 Key Terms, printed page 190; related section 5.5.", label:"Explain differentiated marketing", canonical_key:"explain_differentiated_marketing", status:"approved"}}, {concept_id:"b5420677-6dec-5ef5-90e4-2fb1ee308023", kc_id:"b5420677-6dec-5ef5-90e4-2fb1ee308023", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain differentiation positioning: product/service positioning based on the differentiating characteristics or qualities that make an organization better than its competitors in the mind of the target audience Source: chapter 5 Key Terms, printed page 190; related section 5.6.", label:"Explain differentiation positioning", canonical_key:"explain_differentiation_positioning", status:"approved"}}, {concept_id:"f9d75454-5973-5ffe-834e-5e18cf3a11b2", kc_id:"f9d75454-5973-5ffe-834e-5e18cf3a11b2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain firmographics: a grouping of B2B customers based on shared company attributes; includes five categories: industry, location, size, legal structure, and performance Source: chapter 5 Key Terms, printed page 190; related section 5.2.", label:"Explain firmographics", canonical_key:"explain_firmographics", status:"approved"}}, {concept_id:"44457c5a-a785-5077-9550-3da6a29d7a0f", kc_id:"44457c5a-a785-5077-9550-3da6a29d7a0f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply geographic segmentation: marketing strategy used to target products or services at people who live in or shop at a particular location Source: chapter 5 Key Terms, printed page 190; related section 5.1.", label:"Apply geographic segmentation", canonical_key:"apply_geographic_segmentation", status:"approved"}}, {concept_id:"ae3dd4d0-2554-5029-926c-a73a1c93a3b5", kc_id:"ae3dd4d0-2554-5029-926c-a73a1c93a3b5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain head-to-head positioning: directly competing with competitors on similar product attributes in the same market Source: chapter 5 Key Terms, printed page 190; related section 5.6.", label:"Explain head-to-head positioning", canonical_key:"explain_head_to_head_positioning", status:"approved"}}, {concept_id:"e29b92a6-d6f2-5b3d-b934-47c8913af29c", kc_id:"e29b92a6-d6f2-5b3d-b934-47c8913af29c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply market segmentation: the process of dividing a broad consumer or business market into subgroups based on shared characteristics Source: chapter 5 Key Terms, printed page 190; related section 5.1.", label:"Apply market segmentation", canonical_key:"apply_market_segmentation", status:"approved"}}, {concept_id:"0f16cf98-4365-55f8-8d02-fb655ea7aabd", kc_id:"0f16cf98-4365-55f8-8d02-fb655ea7aabd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain micromarketing: marketing strategy used on a targeted group of customers in a niche market Source: chapter 5 Key Terms, printed page 190; related section 5.5.", label:"Explain micromarketing", canonical_key:"explain_micromarketing", status:"approved"}}, {concept_id:"dd7dc97c-401c-5f90-906d-cb11f879f531", kc_id:"dd7dc97c-401c-5f90-906d-cb11f879f531", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain multi-segment marketing: marketing strategy in which the firm targets several different market segments simultaneously Source: chapter 5 Key Terms, printed page 190; related section 5.1.", label:"Explain multi-segment marketing", canonical_key:"explain_multi_segment_marketing", status:"approved"}}, {concept_id:"ca779e7b-25c2-5ab9-bccf-305ec617dc78", kc_id:"ca779e7b-25c2-5ab9-bccf-305ec617dc78", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply needs-based segmentation: dividing the market up into smaller groups of people who have approximately the same needs Source: chapter 5 Key Terms, printed page 190; related section 5.2.", label:"Apply needs-based segmentation", canonical_key:"apply_needs_based_segmentation", status:"approved"}}, {concept_id:"c13fa394-2589-534e-80c5-83ee7c493d03", kc_id:"c13fa394-2589-534e-80c5-83ee7c493d03", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain perceptual map: visual depiction of how target customers view and feel about a given brand or product Source: chapter 5 Key Terms, printed page 190; related section 5.6.", label:"Explain perceptual map", canonical_key:"explain_perceptual_map", status:"approved"}}, {concept_id:"87999874-6766-538a-b0b3-57e062baa16c", kc_id:"87999874-6766-538a-b0b3-57e062baa16c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain positioning statement: short description of an organization’s target market(s) and the product(s) provided to them Source: chapter 5 Key Terms, printed page 190; related section 5.6.", label:"Explain positioning statement", canonical_key:"explain_positioning_statement", status:"approved"}}, {concept_id:"501c46d7-bac5-5dba-a5d1-86984c914af8", kc_id:"501c46d7-bac5-5dba-a5d1-86984c914af8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain product positioning: the process of deciding and communicating how an organization wants its market to think and feel about a product or service Source: chapter 5 Key Terms, printed page 190; related section 5.6.", label:"Explain product positioning", canonical_key:"explain_product_positioning", status:"approved"}}, {concept_id:"0e481d7e-c6be-5405-83d3-aac4dcc4c2de", kc_id:"0e481d7e-c6be-5405-83d3-aac4dcc4c2de", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply psychographic segmentation: dividing consumers into subgroups based on shared psychological characteristics, including beliefs, motivations, and priorities Source: chapter 5 Key Terms, printed page 190; related section 5.1.", label:"Apply psychographic segmentation", canonical_key:"apply_psychographic_segmentation", status:"approved"}}, {concept_id:"7417cf0f-60cb-581e-9e14-47b3f8f8d38b", kc_id:"7417cf0f-60cb-581e-9e14-47b3f8f8d38b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply STP model: three-step marketing framework in which an organization segments the market, selects target market(s), and positions its products or services Source: chapter 5 Key Terms, printed page 190; related section 5.6.", label:"Apply STP model", canonical_key:"apply_stp_model", status:"approved"}}, {concept_id:"57ab7f12-112f-5aca-8f87-e6d306f83319", kc_id:"57ab7f12-112f-5aca-8f87-e6d306f83319", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain target market: group of people with some shared characteristics that a company has identified as potential customers for its products Source: chapter 5 Key Terms, printed page 190; related section 5.5.", label:"Explain target market", canonical_key:"explain_target_market", status:"approved"}}, {concept_id:"f74fcbde-b631-5e21-9ef3-1fac452d7908", kc_id:"f74fcbde-b631-5e21-9ef3-1fac452d7908", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply technographic segmentation: organizing B2B prospects by their technology ownership and usage Source: chapter 5 Key Terms, printed page 190; related section 5.2.", label:"Apply technographic segmentation", canonical_key:"apply_technographic_segmentation", status:"approved"}}, {concept_id:"aa9f3442-2665-5fdf-891b-9d8ded0c60ba", kc_id:"aa9f3442-2665-5fdf-891b-9d8ded0c60ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"process", definition:"Explain undifferentiated marketing: also called mass marketing, a strategy that entails creating one message for an entire audience Source: chapter 5 Key Terms, printed page 190; related section 5.5.", label:"Explain undifferentiated marketing", canonical_key:"explain_undifferentiated_marketing", status:"approved"}}, {concept_id:"52f0d837-2677-5216-8e8e-e18439541cd0", kc_id:"52f0d837-2677-5216-8e8e-e18439541cd0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"method", definition:"Apply value-based segmentation: evaluating groups of customers in terms of the revenue they generate and the costs of establishing and maintaining relationships with them Source: chapter 5 Key Terms, printed page 190; related section 5.2.", label:"Apply value-based segmentation", canonical_key:"apply_value_based_segmentation", status:"approved"}}, {concept_id:"c8ec6836-0750-55b8-a673-402eb7726c5d", kc_id:"c8ec6836-0750-55b8-a673-402eb7726c5d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"understand", updated_at:datetime('2026-09-20T10:16:37.476Z'), level:"atomic_concept", concept_type:"domain", definition:"Explain aided awareness: when a product, brand, or company list is provided to select from to measure awareness Source: chapter 6 Key Terms, printed page 219; related section 6.3.", label:"Explain aided awareness", canonical_key:"explain_aided_awareness", status:"approved"}}] AS row
