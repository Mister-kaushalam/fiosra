UNWIND [{concept_id:"6d60d254-9214-587b-9891-18e63f18d52c", kc_id:"6d60d254-9214-587b-9891-18e63f18d52c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"relationship", definition:"Connect purchasing, operations, logistics, resource management, and information workflow with customer demand. Source: section 17.5, printed page 597.", label:"Coordinate supply-chain functions", canonical_key:"coordinate_supply_chain_functions", status:"approved"}}, {concept_id:"5bac480e-bd1a-53a6-9287-3bc2523e151a", kc_id:"5bac480e-bd1a-53a6-9287-3bc2523e151a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Assess speed, accessibility, cost, warehousing, inventory, information integration, and third-party logistics rather than transportation alone. Source: section 17.6, printed page 599.", label:"Compare transportation and logistics trade-offs", canonical_key:"compare_transportation_and_logistics_trade_offs", status:"approved"}}, {concept_id:"a05d6cab-c523-525f-a86a-27ceccddee84", kc_id:"a05d6cab-c523-525f-a86a-27ceccddee84", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.59Z'), level:"atomic_concept", concept_type:"method", definition:"Analyze the environmental consequences of expedited delivery alongside customer service expectations and sustainable sourcing. Source: section 17.7, printed page 603.", label:"Evaluate shipping speed versus carbon footprint", canonical_key:"evaluate_shipping_speed_versus_carbon_footprint", status:"approved"}}, {concept_id:"61e79652-74e5-5e9e-bdf1-1f693b9dc907", kc_id:"61e79652-74e5-5e9e-bdf1-1f693b9dc907", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"threshold", definition:"Separate cost-based markup from selling-price-based margin; a cost of 50 and selling price of 100 imply 100 percent markup and 50 percent gross margin. Source: section 18.3, printed page 626.", label:"Calculate and distinguish markup and margin", canonical_key:"calculate_and_distinguish_markup_and_margin", status:"approved"}}, {concept_id:"3666959e-0481-58e7-b4a9-3c84917a2246", kc_id:"3666959e-0481-58e7-b4a9-3c84917a2246", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"method", definition:"Compare central business districts, regional malls, strip malls, and freestanding sites against target customers, merchandise, access, and cost. Source: section 18.3, printed page 626.", label:"Choose retail location and assortment", canonical_key:"choose_retail_location_and_assortment", status:"approved"}}, {concept_id:"2e90018e-29ad-57db-856a-1c9d0c34e83d", kc_id:"2e90018e-29ad-57db-856a-1c9d0c34e83d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"method", definition:"Assess online brands entering physical locations, same-day delivery, social commerce, and digital wallets as responses to customer behavior. Source: section 18.4, printed page 632.", label:"Evaluate emerging retail formats and delivery", canonical_key:"evaluate_emerging_retail_formats_and_delivery", status:"approved"}}, {concept_id:"721c53b0-2724-56b3-bf51-6642d6048be4", kc_id:"721c53b0-2724-56b3-bf51-6642d6048be4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"method", definition:"Assess global competition, regulation, information systems, and product traceability through the supply chain. Source: section 18.6, printed page 638.", label:"Evaluate wholesale technology and traceability", canonical_key:"evaluate_wholesale_technology_and_traceability", status:"approved"}}, {concept_id:"8c5b5922-f1c7-5da7-b08b-741d505421d3", kc_id:"8c5b5922-f1c7-5da7-b08b-741d505421d3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"method", definition:"Assess truthful claims, fair billing, supplier and customer treatment, and transparent terms. Source: section 18.7, printed page 641.", label:"Evaluate retail and wholesale consumer protection", canonical_key:"evaluate_retail_and_wholesale_consumer_protectio", status:"approved"}}, {concept_id:"2f425db7-7947-5258-ad62-679688598374", kc_id:"2f425db7-7947-5258-ad62-679688598374", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"relationship", definition:"Explain environmental, social, and economic dimensions and the textbook's related ESG framing without assuming economic performance and governance are identical measures. Source: section 19.1, printed page 652.", label:"Distinguish sustainability pillars and ESG terminology", canonical_key:"distinguish_sustainability_pillars_and_esg_termi", status:"approved"}}, {concept_id:"6d70ba2a-cca5-59a5-85ab-edcfa1dc912d", kc_id:"6d70ba2a-cca5-59a5-85ab-edcfa1dc912d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"relationship", definition:"Analyze how customer, employee, supplier, investor, community, and environmental interests affect sustainable marketing objectives. Source: section 19.2, printed page 655.", label:"Compare shareholder and stakeholder approaches", canonical_key:"compare_shareholder_and_stakeholder_approaches", status:"approved"}}, {concept_id:"e562eee2-4b39-5225-9423-6b5d9e27f034", kc_id:"e562eee2-4b39-5225-9423-6b5d9e27f034", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"method", definition:"Examine brand recognition, cost reduction, effectiveness, compliance, waste minimization, and return while requiring evidence for each claimed benefit. Source: section 19.3, printed page 656.", label:"Evaluate sustainability's business benefits", canonical_key:"evaluate_sustainability_s_business_benefits", status:"approved"}}, {concept_id:"8d32021e-f290-5569-bf93-aa471b765b41", kc_id:"8d32021e-f290-5569-bf93-aa471b765b41", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"apply", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"method", definition:"Integrate consumer orientation, customer value, innovation, mission, and societal responsibility across actual business decisions. Source: section 19.4, printed page 660.", label:"Apply five sustainable marketing principles", canonical_key:"apply_five_sustainable_marketing_principles", status:"approved"}}, {concept_id:"cf9f6813-7040-524f-9013-e44a9f703ce6", kc_id:"cf9f6813-7040-524f-9013-e44a9f703ce6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"method", definition:"Compare stated purpose with decisions, actions, stakeholder effects, and measurable outcomes to assess authenticity. Source: section 19.5, printed page 662.", label:"Test brand-purpose credibility", canonical_key:"test_brand_purpose_credibility", status:"approved"}}, {concept_id:"bb9a3b35-518e-5da6-96fd-1abde46334e5", kc_id:"bb9a3b35-518e-5da6-96fd-1abde46334e5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify 7-Eleven and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 98. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/3-2-factors-that-influence- consumer-buying-behavior) Also check out this CNBC video about why 7-Eleven failed in Indonesia.", label:"Analyze 7-Eleven in its marketing context", canonical_key:"analyze_7_eleven_in_its_marketing_context", status:"approved"}}, {concept_id:"4b43a206-bd81-5288-a3fd-b7d358c554bb", kc_id:"4b43a206-bd81-5288-a3fd-b7d358c554bb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify A&E Networks and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 544. Evidence excerpt: Every year, MailCon brings together marketing professionals, brands, and agencies to discuss the latest trends in email technology, strategy, and automation. Major brands like Wayfair, Girl Scouts of the USA, Ford Motor Company, and A&E Networks gather to network and learn about advancements in the email marketing space.6", label:"Analyze A&E Networks in its marketing context", canonical_key:"analyze_a_e_networks_in_its_marketing_context", status:"approved"}}, {concept_id:"1c3712e9-af18-5075-880e-eec08e4021ed", kc_id:"1c3712e9-af18-5075-880e-eec08e4021ed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Abercrombie & Fitch and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 109. Evidence excerpt: Watch this video on Abercrombie & Fitch’s brand transformation for further insight on how A&F has positioned its retail brand Hollister as a global iconic teen brand and modernized the A&F brand to focus on young millennial consumers.", label:"Analyze Abercrombie & Fitch in its marketing context", canonical_key:"analyze_abercrombie_fitch_in_its_marketing_conte", status:"approved"}}, {concept_id:"b05b18ab-f367-53df-b2b5-93d1a6d60e55", kc_id:"b05b18ab-f367-53df-b2b5-93d1a6d60e55", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Accenture and analyze its role in the textbook's treatment of understanding consumer markets and buying behavior. Source: printed page 96. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/3-1-understanding- consumer-markets-and-buying-behavior) A survey from Accenture (https://openstax.org/r/insightsstrategy), one of the top-ranked consulting firms in the world, found that the pandemic caused 50 percent of consumers to evaluate their purpose and what’s important to them. Read more about the findings in this article.", label:"Analyze Accenture in its marketing context", canonical_key:"analyze_accenture_in_its_marketing_context", status:"approved"}}, {concept_id:"4a13a040-72fa-5912-8c02-f8d5479f8246", kc_id:"4a13a040-72fa-5912-8c02-f8d5479f8246", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ace Hardware and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 582. Evidence excerpt: In some cases, manufacturers or producers sell to retailers without the use of wholesalers or distributors, called the producer to retailer to consumer channel. A local Ace Hardware, for example, sells fishing lures made by the local scout troop. The troop purchases the supplies necessary to make the lures then sells them to Ace Hardware, which sells them to customers.", label:"Analyze Ace Hardware in its marketing context", canonical_key:"analyze_ace_hardware_in_its_marketing_context", status:"approved"}}, {concept_id:"b2e1dca9-c19f-51fe-a31b-3f986a112a99", kc_id:"b2e1dca9-c19f-51fe-a31b-3f986a112a99", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ad Council and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 104. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/3-2-factors-that-influence- consumer-buying-behavior) Consider this public service announcement (PSA) from the Ad Council that is dedicated to fostering a more welcoming nation where everyone can belong. How does it appeal to the human need for community and belonging?", label:"Analyze Ad Council in its marketing context", canonical_key:"analyze_ad_council_in_its_marketing_context", status:"approved"}}, {concept_id:"fb8c0bbd-d169-5217-bdb5-0d4ed25a90fd", kc_id:"fb8c0bbd-d169-5217-bdb5-0d4ed25a90fd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Adidas and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 98. Evidence excerpt: A subculture is a group of people, such as environmentalists or bodybuilders, who share a set of values. Ethnic and racial groups share the language, food, and culture of their heritage. Other subcultures, like the biker culture, which revolves around a dedication to motorcycles, are united by shared experiences. The Amish subculture is known for its conservative beliefs and reluctance to adapt to modern technology. Think about what subculture(s) you may belong to and how they influence your buying behavior. For example, hip-hop music has long been associated with fashion, particularly sneakers. Run DMC’s 1986 hit “My Adidas” led to the first endorsement deal between a fashion…", label:"Analyze Adidas in its marketing context", canonical_key:"analyze_adidas_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"f4aea888-67f5-5b55-9b08-5159a3a63b01", kc_id:"f4aea888-67f5-5b55-9b08-5159a3a63b01", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Adobe and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 99. Evidence excerpt: For more success stories, check out these videos about numerous companies that got it right (https://openstax.org/r/examplesofbrands). Examples include stories from Rihanna’s Fenty beauty line, Adobe’s “When I See Black” ad, Bumble’s “Find Me on Bumble” campaign, and many more!", label:"Analyze Adobe in its marketing context", canonical_key:"analyze_adobe_in_its_marketing_context", status:"approved"}}, {concept_id:"e53aebda-abc9-5905-b34a-265566f6dd66", kc_id:"e53aebda-abc9-5905-b34a-265566f6dd66", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Advancement Project and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze Advancement Project in its marketing context", canonical_key:"analyze_advancement_project_in_its_marketing_con", status:"approved"}}, {concept_id:"a8105cd8-8854-5c8a-b591-3ad44b3b0380", kc_id:"a8105cd8-8854-5c8a-b591-3ad44b3b0380", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify AdWeek and analyze its role in the textbook's treatment of ethical concerns in advertising and public relations. Source: printed page 496. Evidence excerpt: marketers as well. Many companies changed their marketing strategies from selling goods and services to creating feelings of goodwill and solidarity. IKEA, the Swedish furniture manufacturer, was no exception. In a marketing campaign launched early in the pandemic, the company offered six ways to build a furniture fort, giving the public ways to cope with being quarantined. The campaign earned a nod in AdWeek’s most notable advertisements.29 Read more about the campaign, and see the forts, here. (https://openstax.org/r/ ikeafurnitureforts)", label:"Analyze AdWeek in its marketing context", canonical_key:"analyze_adweek_in_its_marketing_context", status:"approved"}}, {concept_id:"33bb2384-796a-5ba7-a555-516c601ad98b", kc_id:"33bb2384-796a-5ba7-a555-516c601ad98b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Aetna and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 582. Evidence excerpt: For some industries, the distribution network is complex, and agents represent the manufacturer in marketing channel negotiations. Health insurance agents, for example, represent major insurance carriers such as Aetna and Blue Cross by providing consumers with information about health plans in their state. In these situations, the agent does not take ownership of the product like other intermediaries but rather is paid a fee by the insurance carrier.", label:"Analyze Aetna in its marketing context", canonical_key:"analyze_aetna_in_its_marketing_context", status:"approved"}}, {concept_id:"e6956a1d-3488-5df2-8ae7-4bad406fc595", kc_id:"e6956a1d-3488-5df2-8ae7-4bad406fc595", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Airbus and analyze its role in the textbook's treatment of the business-to-business (b2b) market. Source: printed page 129. Evidence excerpt: • Nature of the buying decision. It may seem a little obvious, but it’s important to remember that B2C buyers generally make buying decisions for themselves or their households, whereas B2B buyers make buying decisions for their companies, which serve either consumers or other companies. When you go grocery shopping, you’re buying a loaf of bread, a gallon of milk, and a dozen eggs for yourself or your household. However, if you are buying food to be prepared and served at a large hospital or a university, the complexity and volume of that purchase will be far greater. • Fewer buyers, higher volume. Another difference between the two markets is that B2B markets deal with fewer…", label:"Analyze Airbus in its marketing context", canonical_key:"analyze_airbus_in_its_marketing_context", status:"approved"}}, {concept_id:"7ccabdbb-f3d1-5c2f-897c-18cc6a2fa58c", kc_id:"7ccabdbb-f3d1-5c2f-897c-18cc6a2fa58c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Alba and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 284. Evidence excerpt: Hispanic consumers support brands that demonstrate cultural authenticity, transparency, and honesty. After all, openness and having meaningful connections are at the heart of these consumers’ values. In terms of factors, the concept of product quality and service quality is deeply desirable to Hispanic consumers. Have you heard of Hispanic actress Jessica Alba? Alba, who is of Mexican descent, founded The Honest Company (see Figure 8.16) in 2012 with the mission of formulating safe, high-quality personal and beauty products for the family. Other factors that influence Hispanic consumers include companies’ pledges to sustainability and social responsibility. Indeed, these are…", label:"Analyze Alba in its marketing context", canonical_key:"analyze_alba_in_its_marketing_context", status:"approved"}}, {concept_id:"1a17db8b-1264-5aee-89f4-df912d2c2afc", kc_id:"1a17db8b-1264-5aee-89f4-df912d2c2afc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Alfred Sargent & Sons and analyze its role in the textbook's treatment of entering the global arena. Source: printed page 241. Evidence excerpt: The most basic and least involved method to enter global markets is through exporting. Exporting is when a company makes a product or service in one country and sells it in others. Many companies choose this method of entry into global markets because it requires the least amount of m risk and allows the firm’s managers to learn the ins and outs of international business. For example, in the UK’s East Midlands, the county of Northampton is home to Alfred Sargent & Sons, Church’s, John Lobb, and other shoemakers. An increased emphasis on exporting allowed these dying businesses to see new life because people in other countries wanted a piece of traditional “English cobbling.”58", label:"Analyze Alfred Sargent & Sons in its marketing context", canonical_key:"analyze_alfred_sargent_sons_in_its_marketing_con", status:"approved"}}, {concept_id:"26595d63-dc3c-5ad6-9a56-61cd67bc652b", kc_id:"26595d63-dc3c-5ad6-9a56-61cd67bc652b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Alibaba and analyze its role in the textbook's treatment of buyers and buying situations in a b2b market. Source: printed page 132. Evidence excerpt: Founded in 1999 by Jack Ma, Alibaba.com is an online B2B marketplace (see Figure 4.3). In this virtual marketplace, buyers and sellers have the ability to connect with one another and carry out purchase/sale transactions. Alibaba is sort of like a giant variety store for B2B buyers. The company has hundreds of millions of products in over 40 different categories, including machinery, consumer electronics, and apparel.5", label:"Analyze Alibaba in its marketing context", canonical_key:"analyze_alibaba_in_its_marketing_context", status:"approved"}}, {concept_id:"64938c01-f910-5f84-a1e1-9310cbeb7c48", kc_id:"64938c01-f910-5f84-a1e1-9310cbeb7c48", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Alice + Olivia and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Alice + Olivia in its marketing context", canonical_key:"analyze_alice_olivia_in_its_marketing_context", status:"approved"}}, {concept_id:"a271b830-d46e-5fec-9937-88141e0cc9dc", kc_id:"a271b830-d46e-5fec-9937-88141e0cc9dc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Allbirds and analyze its role in the textbook's treatment of ethical issues in supply chain management. Source: printed page 604. Evidence excerpt: For decades, the footwear industry has missed the opportunity to look to Mother Nature for more sustainable footwear materials. Tim Brown, the founder of Allbirds, believed it was time to think differently (see Figure 17.15). With most shoe companies using petroleum-based raw materials, Brown sought to think more sustainably about offering a shoe that was both comfortable and environmentally friendly. Along with Joey Zwillinger, a product engineer and renewables guru, Brown developed a revolutionary wool fabric designed for footwear. Allbirds uses SweetFoam, a shoe sole material made from plant-based leather. To increase the durability of the shoe, it also uses recycled…", label:"Analyze Allbirds in its marketing context", canonical_key:"analyze_allbirds_in_its_marketing_context", status:"approved"}}, {concept_id:"4883174f-14d5-5820-8dcd-0d6c89a4bf0c", kc_id:"4883174f-14d5-5820-8dcd-0d6c89a4bf0c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Allegiant Air and analyze its role in the textbook's treatment of pricing strategies and tactics for existing products. Source: printed page 426. Evidence excerpt: Another example of economy pricing is used in the airline industry. Allegiant Air strives to offer no-frills air travel that is priced considerably lower than its competitors. But you have to get your seats fast at the lowest prices because the price increases as seats fill up. Oh, and if you want to travel with any luggage, you’ll need to pay extra; Allegiant charges for any luggage other than one personal item.", label:"Analyze Allegiant Air in its marketing context", canonical_key:"analyze_allegiant_air_in_its_marketing_context", status:"approved"}}, {concept_id:"8af63885-889d-5bdd-a2f2-8242124bb300", kc_id:"8af63885-889d-5bdd-a2f2-8242124bb300", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify AllHeart and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 159. Evidence excerpt: Marketers can also segment the market based on occupation or job type. Focusing on a smaller segment of the market enables a company to make better use of its limited resources. For example, AllHeart is a producer of medical scrubs, nursing uniforms, shoes, and medical accessories, so it has segmented the market to focus on medical professionals. Another example can be found with Saf-Gard, a producer of safety shoes and work boots that meet or exceed safety standards. This company targets workers in the construction and farming industries.", label:"Analyze AllHeart in its marketing context", canonical_key:"analyze_allheart_in_its_marketing_context", status:"approved"}}, {concept_id:"60b758a5-54f8-50fb-9436-e308f8ce8041", kc_id:"60b758a5-54f8-50fb-9436-e308f8ce8041", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Allstate and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 104. Evidence excerpt: The second level is safety and security, the need to be safe from physical and psychological harm. Once again, consider just a few successful marketing campaigns that have focused on safety—“You’re in Good Hands with Allstate” and Lysol’s “Practice Healthy Habits” campaign with its tagline “What It Takes to Protect.”", label:"Analyze Allstate in its marketing context", canonical_key:"analyze_allstate_in_its_marketing_context", status:"approved"}}, {concept_id:"734f30d0-04bb-5dbd-86d9-1a8a9ddbc25f", kc_id:"734f30d0-04bb-5dbd-86d9-1a8a9ddbc25f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Alphabet and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 55. Evidence excerpt: Business Portfolio Definition As noted above, many businesses have a single product or business unit. However, larger organizations such as Apple, Alphabet, General Electric, Meta, and Microsoft often have multiple diverse business units called strategic business units. Despite the fact that these SBUs report directly to the parent company’s headquarters, they typically develop their own vision statements, mission statements, objectives, and goals, and the strategic planning for these SBUs is performed separately and apart from other SBUs within the organization.25 When companies have multiple products or business units, these comprise the business", label:"Analyze Alphabet in its marketing context", canonical_key:"analyze_alphabet_in_its_marketing_context", status:"approved"}}, {concept_id:"548adada-2f82-5a7b-9171-1133e533c1e3", kc_id:"548adada-2f82-5a7b-9171-1133e533c1e3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Amazon and analyze its role in the textbook's treatment of customer relationship management (crm). Source: printed page 34. Evidence excerpt: prospective customers so that their experience is a more positive one. For example, you can keep track of important dates such as customer birthdays or purchase anniversaries, and CRM software can send automatic emails to them with coupons or other incentives.50 • Enhanced Customer Communications. CRM software can be programmed to automatically send thank you notes to customers, send newsletters regarding new products, and send customer satisfaction surveys or polls so that you can glean more insight into your customers’ levels of satisfaction with your product or service.51 • Ascertaining Customer Needs. Fostering customer loyalty begins with understanding what your customers…", label:"Analyze Amazon in its marketing context", canonical_key:"analyze_amazon_in_its_marketing_context", status:"approved"}}, {concept_id:"d9206f7b-ea94-5c39-89f9-abdd9dba8e34", kc_id:"d9206f7b-ea94-5c39-89f9-abdd9dba8e34", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Amazon Go and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 619. Evidence excerpt: As the number of store retailers has decreased significantly over the years due to their higher operating costs, some companies have found more innovative ways to provide their products in a similar setting. For example, Amazon Go is a store retailer that allows customers to shop in-store, but has eliminated the use of cashiers (and long lines). As customers choose the products they want, the automated store keeps track of the purchase and charges the customers when they exit the store.10", label:"Analyze Amazon Go in its marketing context", canonical_key:"analyze_amazon_go_in_its_marketing_context", status:"approved"}}, {concept_id:"5727d596-26c1-5ce1-807c-b89b534a31aa", kc_id:"5727d596-26c1-5ce1-807c-b89b534a31aa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Amazon Prime and analyze its role in the textbook's treatment of pricing and its role in the marketing mix. Source: printed page 405. Evidence excerpt: In the Spotlight In February 2005, Amazon launched Amazon Prime, which offered unlimited two-day delivery for millions of items.1 At a time when consumers were accustomed to paying high shipping fees and experiencing slow service, the membership service—$79 per year—offered a new alternative. It was a first-of-its-kind pricing structure that has sparked many companies to do the same. Today’s subscription services cover everything from toilet paper to dog toys. Amazon Prime is still arguably the most prevalent subscription service in history. In 2021, Amazon reported its Amazon Prime members had reached 200 million worldwide.2", label:"Analyze Amazon Prime in its marketing context", canonical_key:"analyze_amazon_prime_in_its_marketing_context", status:"approved"}}, {concept_id:"a386def7-8648-57b0-be02-cef467742f25", kc_id:"a386def7-8648-57b0-be02-cef467742f25", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify AMC and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 576. Evidence excerpt: The film industry provides a great example of the distribution decisions that marketers must make. Before a production company releases a new movie, it must decide which channels are best for distributing the movie to consumers. In today’s market, movie producers have a slew of distribution options, including Netflix, HBOMax, and YouTube, to name a few. They also have the option of distributing through traditional movie theaters, such as AMC or Regal. Regardless of the marketing channel they pursue, their goal is to distribute their movie to the right customers at the right place and at the right time. Production companies will choose the marketing channel that is most efficient…", label:"Analyze AMC in its marketing context", canonical_key:"analyze_amc_in_its_marketing_context", status:"approved"}}, {concept_id:"06dfe7bf-7e51-56ac-9f34-be86fe9c4a4e", kc_id:"06dfe7bf-7e51-56ac-9f34-be86fe9c4a4e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify American Airlines and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 583. Evidence excerpt: Much like the business-to-consumer (B2C) space, when a company sells products or services directly to a final consumer or end user, the B2B marketing channel can be direct without the use of intermediaries. The direct channel is typically used when the nature of the product is complex, is expensive, or requires intensive resources to move the product from the manufacturer to the business customer. Airplane manufacturers like Boeing and Airbus produce and sell aircraft directly to airlines like Delta Air Lines and American Airlines, who then offer flights to consumers. Given the expense and complexity of distributing airplanes, the direct channel makes the most sense.", label:"Analyze American Airlines in its marketing context", canonical_key:"analyze_american_airlines_in_its_marketing_conte", status:"approved"}}, {concept_id:"e7f54cac-bb99-5e51-a7e2-29fdeb1ff83f", kc_id:"e7f54cac-bb99-5e51-a7e2-29fdeb1ff83f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify American Association for Retired Persons (AARP) and analyze its role in the textbook's treatment of marketing to sociodemographic groups. Source: printed page 293. Evidence excerpt: While this is not a new trend, it is certainly one that will continue through the 2030s as the baby boomer population ages out. The American Association for Retired Persons (AARP) reports that American workers over 65 years of age have a median income of $78,000 per year, while workers under age 65 have a median income that is only $55,000.70 Keep in mind that this statistic is about individuals who are actively working, meaning not yet retired. Couple it with the wealth accumulation information you read about earlier. The baby boomer population certainly exerts outsized economic and purchasing influence, making this an important current and future market segment.", label:"Analyze American Association for Retired Persons (AARP) in its marketing context", canonical_key:"analyze_american_association_for_retired_persons", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"b7d3314c-be53-5136-b40c-84c36f3a0984", kc_id:"b7d3314c-be53-5136-b40c-84c36f3a0984", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify American Civil Liberties Union (ACLU) and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze American Civil Liberties Union (ACLU) in its marketing context", canonical_key:"analyze_american_civil_liberties_union_aclu_in_i", status:"approved"}}, {concept_id:"06a9d9aa-9d0e-53e6-9b89-f0c96f0ab782", kc_id:"06a9d9aa-9d0e-53e6-9b89-f0c96f0ab782", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify American Girl and analyze its role in the textbook's treatment of creating value through packaging and labeling. Source: printed page 331. Evidence excerpt: Packaging can display the value of a product. A well-designed, attractive package demonstrates value instead of a package that frustrates a consumer. For example, American Girl dolls are packaged in a box with a window to show the doll’s face and serve as a keepsake for the owner. The packaging is so popular that some collectors purchase the package without a doll.", label:"Analyze American Girl in its marketing context", canonical_key:"analyze_american_girl_in_its_marketing_context", status:"approved"}}, {concept_id:"0089e712-9497-5270-8bb1-607827b670b6", kc_id:"0089e712-9497-5270-8bb1-607827b670b6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify American Hospital Association and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: For example, in 2020, the National Association of Realtors was the top lobbying association in the United States, followed by the US Chamber of Commerce, Pharmaceutical Research and Manufacturers of America, and the American Hospital Association. Together, these associations spent over $200 million lobbying to impact local, state, and federal legislation.18", label:"Analyze American Hospital Association in its marketing context", canonical_key:"analyze_american_hospital_association_in_its_mar", status:"approved"}}, {concept_id:"7a677bb8-bc83-5bc5-bbc8-bb1933f5f955", kc_id:"7a677bb8-bc83-5bc5-bbc8-bb1933f5f955", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify American Marketing Association (AMA) and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 41. Evidence excerpt: What Do Marketers Do? The American Marketing Association (AMA) has teamed up with the Digital Marketing Institute to offer specialized training within the marketing discipline. You can set yourself apart from other marketers with additional certifications. Are there other benefits you can take advantage of? Take a look at one of the 65 chapters located across the country. Is there one located in your city? Not only is membership a great way to volunteer, it’s also an effective way to market yourself to potential employers. For instance, the Minnesota", label:"Analyze American Marketing Association (AMA) in its marketing context", canonical_key:"analyze_american_marketing_association_ama_in_it", status:"approved"}}, {concept_id:"318022c1-7bf3-5e26-8c0a-60df637fab0f", kc_id:"318022c1-7bf3-5e26-8c0a-60df637fab0f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify American Society for the Prevention of Cruelty to Animals (ASPCA) and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: In 2021, Subaru celebrated 14 years of its Share the Love event.19 To celebrate this event, it debuted a national ad campaign highlighting the people, places, and pets that have been impacted by its social responsibility. Charities supported by Subaru include the American Society for the Prevention of Cruelty to Animals (ASPCA), Make-A-Wish Foundation, Meals on Wheels America, and the National Park Foundation. In its advertising, Subaru also showcases some of the local charities—selected by Subaru retailers—that benefit from the Subaru Share the Love event, as well as the impact of the automaker’s work with Feeding America to help address food insecurity.20", label:"Analyze American Society for the Prevention of Cruelty to Animals (ASPCA) in its marketing context", canonical_key:"analyze_american_society_for_the_prevention_of_c", status:"approved"}}, {concept_id:"6e5e8e63-9b61-56d4-b65f-59f61bd0ea25", kc_id:"6e5e8e63-9b61-56d4-b65f-59f61bd0ea25", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Android and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 61. Evidence excerpt: The automobile industry provides a good illustration of the product development strategy. Car makers generally refresh their models every few years to encourage car owners to trade in their old vehicles and buy the redesigned cars with the latest tech features such as driver assist, Wi-Fi hotspots, and Apple CarPlay and Android Auto.43 At the same time, all the manufacturers are spending billions of dollars developing new electric vehicle models to meet ambitious goals for phasing out gasoline-powered engines.", label:"Analyze Android in its marketing context", canonical_key:"analyze_android_in_its_marketing_context", status:"approved"}}, {concept_id:"1628a758-8367-5391-a40f-d62dabcacce9", kc_id:"1628a758-8367-5391-a40f-d62dabcacce9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Anheuser-Busch and analyze its role in the textbook's treatment of advertising in the promotion mix. Source: printed page 476. Evidence excerpt: Unlike product advertisements that focus on one product or brand in an organization’s product mix, institutional advertisements focus on the organization. This differs also from public relations—discussed next—in that it is a paid form of communication. The goal of institutional advertising is to create a positive image or support for the entire organization. Institutional ads also have the advantage of creating a positive impact by attracting potential candidates and increasing employee engagement within the organization. At the start of the COVID-19 pandemic, many companies stepped up to help mitigate the effects the pandemic had on the country. Early on, Anheuser-Busch…", label:"Analyze Anheuser-Busch in its marketing context", canonical_key:"analyze_anheuser_busch_in_its_marketing_context", status:"approved"}}, {concept_id:"8d67d000-544d-5f4a-b98f-8dd2beb9ed8f", kc_id:"8d67d000-544d-5f4a-b98f-8dd2beb9ed8f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Anya Hindmarch and analyze its role in the textbook's treatment of the benefits of sustainable marketing. Source: printed page 658. Evidence excerpt: Anya Hindmarch and Antidote Anya Hindmarch’s “I Am Not a Plastic Bag” campaign was a collaboration with Antidote, a creative agency, that gained loads of press coverage. That publicity contributed to the U.K. decision to charge for plastic bags. Read more about the campaign from the Anya Hindmarch website (https://openstax.org/r/ imnotaplasticbag) and Antidote’s website (https://openstax.org/r/antidote). When you’re finished, take a moment to be inspired by Anya Hindmarch and her recent sustainability fashion product, a collection of biodegradable leather bags (https://openstax.org/r/hindmarchlaunches).", label:"Analyze Anya Hindmarch in its marketing context", canonical_key:"analyze_anya_hindmarch_in_its_marketing_context", status:"approved"}}, {concept_id:"c9b4cdd3-02c2-53e2-9f7e-247a08a032a4", kc_id:"c9b4cdd3-02c2-53e2-9f7e-247a08a032a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Apple and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 50. Evidence excerpt: • BMW: “The BMW Group is the world’s leading provider of premium products and premium services for individual mobility”9 • Tesla: “To accelerate the advent of sustainable transport by bringing compelling mass-market electric cars to market as soon as possible”10 • Apple: “To bring the best personal computing products and support to students, educators, designers, scientists, engineers, businesspersons and consumers in over 140 countries around the world”11", label:"Analyze Apple in its marketing context", canonical_key:"analyze_apple_in_its_marketing_context", status:"approved"}}, {concept_id:"00c21892-0cbb-5e6e-b75d-d983ef21983a", kc_id:"00c21892-0cbb-5e6e-b75d-d983ef21983a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Apple iPhone and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 108. Evidence excerpt: Learning is still another important factor in consumer buying behavior. The fact is that consumer behavior is learned, and much of what you buy is based on your previous experiences with particular brands. This is commonly known as the Law of Effect, which asserts that, if an action is followed by a pleasant consequence, you’re likely to repeat it; if the action is followed by an unpleasant consequence, you’re less likely to repeat it. For example, let’s say you buy an Apple iPhone. If your experience with the iPhone is positive, you’ll probably be more inclined to buy another Apple product when you’re looking for a tablet or wearable. On the other hand, if you’ve had a…", label:"Analyze Apple iPhone in its marketing context", canonical_key:"analyze_apple_iphone_in_its_marketing_context", status:"approved"}}, {concept_id:"cfe3c7b7-fc28-5a8d-9b64-8a3d27049216", kc_id:"cfe3c7b7-fc28-5a8d-9b64-8a3d27049216", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Apple Store and analyze its role in the textbook's treatment of products, services, and experiences. Source: printed page 309. Evidence excerpt: For example, if you have ever visited an Apple Store, you probably have experienced one of the most lauded customer experiences there is. From the moment you walk in, you are surrounded by products and transported into a world of technology. Each touchpoint, from the check-in on an iPad to the latest products that are available for use, reinforces the brand through customer experience. Brands with strong customer experience tend to have more loyal customers who become brand advocates.", label:"Analyze Apple Store in its marketing context", canonical_key:"analyze_apple_store_in_its_marketing_context", status:"approved"}}, {concept_id:"7471fb70-3df4-5a42-9ca1-845c7c1422c5", kc_id:"7471fb70-3df4-5a42-9ca1-845c7c1422c5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Applied Educational Systems (AES) and analyze its role in the textbook's treatment of determining consumer needs and wants. Source: printed page 31. Evidence excerpt: • Bill Ragan Roofing: “Let us take the stress of roof repairs or a roof replacement off your shoulders.”41 • Applied Educational Systems (AES): “Spend your time connecting with students, not planning and grading”42 • DuckDuckGo: “Tired of being tracked online? We can help.”43 • HelloFresh: “Take the stress out of mealtime.”44", label:"Analyze Applied Educational Systems (AES) in its marketing context", canonical_key:"analyze_applied_educational_systems_aes_in_its_m", status:"approved"}}, {concept_id:"b66a3463-de16-5c59-be1e-b054cb9cc45a", kc_id:"b66a3463-de16-5c59-be1e-b054cb9cc45a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Arby’s and analyze its role in the textbook's treatment of major influences on b2b buyer behavior. Source: printed page 139. Evidence excerpt: Competition also affects B2B buying behavior. It stands to reason that, when a competitor changes its product offering and garners more market share, a business will want to respond by going on the defensive and changing its product offering as well, triggering one or more B2B buying situations. The fast-food industry is just one example of this. Wendy’s was the first national fast-food chain to introduce salads in response to consumers’ desires for healthier food options.15 Shortly thereafter, many other competitors, including Arby’s, McDonald’s, Chick-fil-A, and Burger King, followed suit.", label:"Analyze Arby’s in its marketing context", canonical_key:"analyze_arby_s_in_its_marketing_context", status:"approved"}}, {concept_id:"399845af-b3d1-51bb-9378-7ff63cad1c46", kc_id:"399845af-b3d1-51bb-9378-7ff63cad1c46", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify ASO and analyze its role in the textbook's treatment of factors influencing channel choice. Source: printed page 609. Evidence excerpt: Strategically headquartered along the US-Mexico border in El Paso, Texas, Global Containers and Custom Packaging offers local packaging distribution services that provide value and solutions to the retail and maquiladora market. Customers include companies like Amazon.com, Hewlett Packard, Honeywell, Align Technology (the makers of Invisalign system for straightening teeth), and ASO (a leader in consumer first-aid products).", label:"Analyze ASO in its marketing context", canonical_key:"analyze_aso_in_its_marketing_context", status:"approved"}}, {concept_id:"454a396b-06d6-56df-97df-790e5f01d5ab", kc_id:"454a396b-06d6-56df-97df-790e5f01d5ab", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify AstraZeneca and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 577. Evidence excerpt: Wholesalers are similar to distributors in that they take ownership of products; however, they buy a variety of products in large quantities and bulk-break for the purpose of distributing an assortment of products to retailers in a quantity aimed at meeting the needs of end users or consumers. Let’s examine how the different types of intermediaries depend on one another. AstraZeneca manufactures prescription medications that are made available to consumers by way of pharmacies such as CVS and Walgreens. Pharmacies are retailers in the marketing channel because they sell a wide variety of consumer products, from toothpaste to milk to medications.", label:"Analyze AstraZeneca in its marketing context", canonical_key:"analyze_astrazeneca_in_its_marketing_context", status:"approved"}}, {concept_id:"80ce3176-3915-52d9-8102-5f4926cea95f", kc_id:"80ce3176-3915-52d9-8102-5f4926cea95f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify AT&T and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 297. Evidence excerpt: Culturally Sensitive and Socially Inclusive Marketing Multinational industry leaders like Coca-Cola, Google, Adidas, Unilever, AT&T, Marriott International, and Microsoft are just a few of the companies that, like P&G, are focusing their marketing efforts on being more culturally sensitive and socially inclusive. Even niche players, partnerships, and private companies such as Bumble, Fenty Beauty, and ThirdLove are also championing diversity as a core value through equal cultural and sociodemographic representation rather than just chasing a trend in marketing.72", label:"Analyze AT&T in its marketing context", canonical_key:"analyze_at_t_in_its_marketing_context", status:"approved"}}, {concept_id:"fe1ff2eb-48ca-56d6-83e0-af1358bc3bdc", kc_id:"fe1ff2eb-48ca-56d6-83e0-af1358bc3bdc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Athleta and analyze its role in the textbook's treatment of sustainable marketing principles. Source: printed page 661. Evidence excerpt: Societal Marketing Societal marketing is most akin to the sustainability strategies discussed in this chapter. A societal marketing strategy fulfills social responsibility obligations while satisfying customer needs. Athleta, a Gap company, sells premium-priced performance apparel to female athletes. Its product is designed for a target audience of women in motion. Athleta launched a Power of She campaign to celebrate the diversity of women and serve as a societal marketing effort. Additionally, approximately 70 percent of Athleta’s apparel is manufactured from recycled and sustainable materials.26", label:"Analyze Athleta in its marketing context", canonical_key:"analyze_athleta_in_its_marketing_context", status:"approved"}}, {concept_id:"b11382f5-4773-506a-b72c-c32adee8a4a2", kc_id:"b11382f5-4773-506a-b72c-c32adee8a4a2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Audi and analyze its role in the textbook's treatment of ethical considerations in pricing. Source: printed page 428. Evidence excerpt: Price fixing occurs when two or more competitors agree to set prices at a specific level. The practice of price fixing force customers to pay higher prices than normal with no substitute alternatives. Consumers who purchased or leased certain automobiles were part of a class-action lawsuit involving several automobile manufactures. The brands, including Audi, BMW, Buick, Chevrolet, and many others agreed to pay into the settlement after being accused of conspiring together to artificially inflate the prices of various auto parts.34", label:"Analyze Audi in its marketing context", canonical_key:"analyze_audi_in_its_marketing_context", status:"approved"}}, {concept_id:"6a96f995-1189-535d-8ae9-faf291f9d79f", kc_id:"6a96f995-1189-535d-8ae9-faf291f9d79f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Audible and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 555. Evidence excerpt: typically made available on a weekly or monthly basis. Podcasts are distributed through applications such as Apple’s Podcasts, Google Podcasts, Spotify, and Audible, but they can also be published on a company’s website. Podcasting has been growing at a “hockey stick” rate—200 percent year-on-year growth.23 Recognizing a huge opportunity, Spotify acquired podcasting company Megaphone in 2020.24 The acquisition positions Spotify as the “go-to” platform for premium podcast content, which offers new opportunities for advertisers. In a world where people question information they are given, podcast hosts stand out because 52 percent of listeners trust advertising when endorsed by the…", label:"Analyze Audible in its marketing context", canonical_key:"analyze_audible_in_its_marketing_context", status:"approved"}}, {concept_id:"4cf1dcf3-44f3-5058-b0a6-db453750e4af", kc_id:"4cf1dcf3-44f3-5058-b0a6-db453750e4af", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify AutoZone and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 619. Evidence excerpt: Specialty stores focus on selling a single type of product or a single product line. The employees of specialty stores are often very knowledgeable about the products they sell and offer high levels of customer service. For example, when you need a new battery in your car, you may head straight to AutoZone, a retailer specializing in vehicle parts. When you arrive, an associate will be able to assist you in choosing the correct battery for the make and model of your car, and sometimes, they may be able to install it for you.", label:"Analyze AutoZone in its marketing context", canonical_key:"analyze_autozone_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"519e27f0-69c7-5a7f-ada7-69f102d19eb9", kc_id:"519e27f0-69c7-5a7f-ada7-69f102d19eb9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Aviation Gin and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 501. Evidence excerpt: The other element of the ad’s storyline is that it sparked a parody ad produced by Maximum Effort, a film production and digital marketing agency.36 The agency was founded by the actor Ryan Reynolds, and the parody ad featured a voice-over by Reynolds himself. Although the ad was for Aviation Gin, a brand owned by Reynolds, the ad featured the “wife” from the Peloton Christmas ad. The parody ad did three things—kept people talking about Peloton, created a memorable story for Aviation Gin, and connected Reynolds and the Peloton brand.37", label:"Analyze Aviation Gin in its marketing context", canonical_key:"analyze_aviation_gin_in_its_marketing_context", status:"approved"}}, {concept_id:"9506863b-ba8d-5e68-be65-c54eedad8e56", kc_id:"9506863b-ba8d-5e68-be65-c54eedad8e56", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Avis and analyze its role in the textbook's treatment of product positioning. Source: printed page 182. Evidence excerpt: A classic example is when Avis (the car rental company) launched an advertising campaign that went head-to- head with Hertz, the market leader. Avis made a point of comparing itself to Hertz and made its position in the market a selling point using the slogan “When you’re only No. 2, you try harder. Or else.” This campaign positioned Avis as a direct competitor of Hertz and also did something unique: it highlighted its underdog status, turning it from a liability into an asset. The results? Prior to the ads, Avis was losing $3.2 million a year; after the ads, Avis improved its performance and earned $1.2 million. Remarkably, that was the first time in over a decade that Avis had…", label:"Analyze Avis in its marketing context", canonical_key:"analyze_avis_in_its_marketing_context", status:"approved"}}, {concept_id:"a373ca06-1417-5731-a87a-937476cdd302", kc_id:"a373ca06-1417-5731-a87a-937476cdd302", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Axe and analyze its role in the textbook's treatment of pricing strategies and tactics for existing products. Source: printed page 425. Evidence excerpt: Many large companies offer multiple products and product lines in their product mix. One strategy for pricing products is to price products in a product line the same or similar. For example, Unilever is the manufacturer of many brands that you’ve likely heard of: Dove, Axe, and Hellman’s to name a few. Within its host of products, Unilever has divided its products into price categories; higher priced items have a higher perception of value and so on. (Recall that a product line is a group of related products differentiated by features and price.) Unilever sets a higher price for some of its product lines and lower price points for others in order to capture various target…", label:"Analyze Axe in its marketing context", canonical_key:"analyze_axe_in_its_marketing_context", status:"approved"}}, {concept_id:"27b226c5-c321-5138-a9d8-51238120164a", kc_id:"27b226c5-c321-5138-a9d8-51238120164a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify B2B Business International Market Research and analyze its role in the textbook's treatment of segmentation of b2b markets. Source: printed page 168. Evidence excerpt: The Importance of Segmentation For more information on the importance of segmenting B2B customers, check out this video, The Importance of Segmenting Your Customers. This video is from B2B Business International Market Research, a market research company, and it speaks to the importance and value of knowing your customers.", label:"Analyze B2B Business International Market Research in its marketing context", canonical_key:"analyze_b2b_business_international_market_resear", status:"approved"}}, {concept_id:"6fea5581-913c-5351-95c2-bfb651318033", kc_id:"6fea5581-913c-5351-95c2-bfb651318033", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Baby boomers and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 101. Evidence excerpt: • Baby boomers (born between 1946 and 1964) are currently in their 60s and 70s. This generational cohort is approximately 70 million people strong in the United States and accounts for $2.6 trillion in buying", label:"Analyze Baby boomers in its marketing context", canonical_key:"analyze_baby_boomers_in_its_marketing_context", status:"approved"}}, {concept_id:"4e0fabbd-4164-5c09-b0bb-b333e7e3e8fa", kc_id:"4e0fabbd-4164-5c09-b0bb-b333e7e3e8fa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bad Bunny and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 267. Evidence excerpt: Modelo Especial is a good example. Modelo Especial is a Mexican beer that has successfully capitalized on its heritage to target the Hispanic population while also appealing to the general market. Marketed by Constellation Brands, the beer has had strong sales in the United States since the 1990s.17 In 2019, Hispanic consumers captured close to 70 percent of the brand’s national sales, but Hispanic people are only about half of the customer base.18 Over the course of several decades, various aspects of Hispanic culture have been widely embraced in the United States. Have you heard of artists like Jennifer Lopez, Pitbull, Bad Bunny, and J Balvin? The marketing team at…", label:"Analyze Bad Bunny in its marketing context", canonical_key:"analyze_bad_bunny_in_its_marketing_context", status:"approved"}}, {concept_id:"f3e37014-b793-51f8-8f64-4bd9f51bcbe1", kc_id:"f3e37014-b793-51f8-8f64-4bd9f51bcbe1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bain & Company and analyze its role in the textbook's treatment of understanding consumer markets and buying behavior. Source: printed page 96. Evidence excerpt: Continually trying to understand environmental influences will keep you on the cutting edge and ahead of the competition. It’s a great practice to always be looking for the latest information so that you can shift your strategies as needed. Bain & Company is an example of one company that wanted to understand how the pandemic changed consumer behavior. The company ran a survey in 2021 to better understand the impact of the pandemic, and it found five trends from the data.", label:"Analyze Bain & Company in its marketing context", canonical_key:"analyze_bain_company_in_its_marketing_context", status:"approved"}}, {concept_id:"4573eda3-3e64-5b9c-b2c4-da7af29273f7", kc_id:"4573eda3-3e64-5b9c-b2c4-da7af29273f7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Balance Careers and analyze its role in the textbook's treatment of the consumer purchasing decision process. Source: printed page 115. Evidence excerpt: The Balance Careers site also provides a wealth of resources (https://openstax.org/r/freecareeraptitude) on additional aptitude, personality, talent, and preemployment tests. It’s worth your time to dive into this information to help you identify which career might be your best fit.", label:"Analyze Balance Careers in its marketing context", canonical_key:"analyze_balance_careers_in_its_marketing_context", status:"approved"}}, {concept_id:"eb6ca895-4ecf-55be-ad0c-e86420fadda1", kc_id:"eb6ca895-4ecf-55be-ad0c-e86420fadda1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Balvin and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 267. Evidence excerpt: Modelo Especial is a good example. Modelo Especial is a Mexican beer that has successfully capitalized on its heritage to target the Hispanic population while also appealing to the general market. Marketed by Constellation Brands, the beer has had strong sales in the United States since the 1990s.17 In 2019, Hispanic consumers captured close to 70 percent of the brand’s national sales, but Hispanic people are only about half of the customer base.18 Over the course of several decades, various aspects of Hispanic culture have been widely embraced in the United States. Have you heard of artists like Jennifer Lopez, Pitbull, Bad Bunny, and J Balvin? The marketing team at…", label:"Analyze Balvin in its marketing context", canonical_key:"analyze_balvin_in_its_marketing_context", status:"approved"}}, {concept_id:"96ec3f9d-dc6a-5e82-a43f-aa4aff7fe25d", kc_id:"96ec3f9d-dc6a-5e82-a43f-aa4aff7fe25d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Banana Republic and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 327. Evidence excerpt: Split loyals are customers who have a consideration set of two to three products or services in the category. The split loyal is willing to buy this select set of brands on any occasion without hard-core loyalty to any in the group. However, brands can convert split loyals into hard-core loyals with product/service consistency, loyalty programs, and marketing efforts. For example, customers may have loyalty to Gap, Banana Republic, and J.Crew for workwear.", label:"Analyze Banana Republic in its marketing context", canonical_key:"analyze_banana_republic_in_its_marketing_context", status:"approved"}}, {concept_id:"2fdbb12c-27ee-5ec8-aa75-fff794555480", kc_id:"2fdbb12c-27ee-5ec8-aa75-fff794555480", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Barnes & Noble and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 500. Evidence excerpt: If you have ever taken a class at your local gym, you know the excitement of the camaraderie and competition that takes place when you are in a class of like-minded individuals all sharing the same goal and passion for performance. Former Barnes & Noble e-commerce executive John Foley liked riding his stationary bike but wanted to bring the gym class experience to his at-home riding sessions. And in 2012, the idea for Peloton was born.34", label:"Analyze Barnes & Noble in its marketing context", canonical_key:"analyze_barnes_noble_in_its_marketing_context", status:"approved"}}, {concept_id:"7769d379-6383-53a6-b3bb-4f6a11385c40", kc_id:"7769d379-6383-53a6-b3bb-4f6a11385c40", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Barrios and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 99. Evidence excerpt: You can also watch this Gaby Barrios TED Talk. Barrios is a marketing expert who speaks about how targeting consumers based on gender is bad for business.", label:"Analyze Barrios in its marketing context", canonical_key:"analyze_barrios_in_its_marketing_context", status:"approved"}}, {concept_id:"351bc2bd-87cf-50be-8988-9c984e2a98e5", kc_id:"351bc2bd-87cf-50be-8988-9c984e2a98e5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Batdorf & Bronson Coffee Roasters and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 43. Evidence excerpt: With a love for coffee and the thoughts of goats dancing in their heads, husband and wife Larry and Cherie Challain opened their first coffee bar—Dancing Goats in Olympia, Washington, in 1988. But as any coffee entrepreneur knows, a coffee bar is only as good as the coffee it serves. In a quest to serve the freshest coffee in the world, the duo acquired Batdorf & Bronson Coffee Roasters.", label:"Analyze Batdorf & Bronson Coffee Roasters in its marketing context", canonical_key:"analyze_batdorf_bronson_coffee_roasters_in_its_m", status:"approved"}}, {concept_id:"7ec24843-4fd3-530c-a739-72aa8924ba7c", kc_id:"7ec24843-4fd3-530c-a739-72aa8924ba7c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bayer and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 346. Evidence excerpt: • Repositioned Products: Another reminder: product positioning is the process that defines how your product is different from others on the market.7 Repositioned products are those that are retargeted for a new use or application. For example, Bayer repositioned its aspirin from treating headaches, fever, and inflammation to also safeguarding against heart attacks.8", label:"Analyze Bayer in its marketing context", canonical_key:"analyze_bayer_in_its_marketing_context", status:"approved"}}, {concept_id:"3ecf5005-629f-5d29-a26e-55734a2c6526", kc_id:"3ecf5005-629f-5d29-a26e-55734a2c6526", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify BBC and analyze its role in the textbook's treatment of purpose and structure of the marketing plan. Source: printed page 68. Evidence excerpt: live off their art and billions of fans the opportunity to enjoy and be inspired by it”53 • BBC: “To act in the public interest, serving all audiences through the provision of impartial, high-quality and distinctive output and services which inform, educate and entertain”54", label:"Analyze BBC in its marketing context", canonical_key:"analyze_bbc_in_its_marketing_context", status:"approved"}}, {concept_id:"7e70312b-1a6a-53a7-b0b1-6e3d2eed3c82", kc_id:"7e70312b-1a6a-53a7-b0b1-6e3d2eed3c82", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ben & Jerry’s and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 281. Evidence excerpt: These multicultural consumers also feel relatively well connected to the broader Black community and prioritize social activities that offer support to the group as a whole. To show solidarity with the BLM movement, popular ice cream brand Ben & Jerry’s (see Figure 8.14) named one of its flavors “Justice ReMix’d” to raise awareness of racism and criminal justice reform. The company worked with the Advancement Project national office to advocate for social change and civil rights. Ben & Jerry’s also enacted a multipoint corporate plan challenging other companies to champion the cause and join the conversation about racial inequalities.", label:"Analyze Ben & Jerry’s in its marketing context", canonical_key:"analyze_ben_jerry_s_in_its_marketing_context", status:"approved"}}, {concept_id:"2317f9be-132a-5401-8467-68d09dd2d2b5", kc_id:"2317f9be-132a-5401-8467-68d09dd2d2b5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bendet and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Bendet in its marketing context", canonical_key:"analyze_bendet_in_its_marketing_context", status:"approved"}}, {concept_id:"b191bd08-d52d-52f3-b62d-bb2e8cd573f4", kc_id:"b191bd08-d52d-52f3-b62d-bb2e8cd573f4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Best Buy and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 177. Evidence excerpt: • Name. It may seem silly to include a made-up persona name like Best Buy did, but it’s done so that the marketing team can more easily discuss their customers and plan how to reach them. • Age. The age (or age range) of a persona allows for understanding generation-specific characteristics. As we pointed out in our earlier discussion of using age as a way to segment the market, consumers within the same age group tend to share characteristics and purchase preferences. • Interests. The interests of the buyer persona describe things like hobbies or what they do in their spare time. • Media Usage. What media platforms does the buyer persona use? Television, radio, the Internet?…", label:"Analyze Best Buy in its marketing context", canonical_key:"analyze_best_buy_in_its_marketing_context", status:"approved"}}, {concept_id:"b548f34a-1a1d-5d94-bd35-b1a6d18ebd64", kc_id:"b548f34a-1a1d-5d94-bd35-b1a6d18ebd64", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Better Chicken Commitment (BCC) and analyze its role in the textbook's treatment of the advantages and disadvantages of public relations. Source: printed page 492. Evidence excerpt: Another advantage of public relations is that of sales and leads. Again, because public relations is considered a more credible source of information, various tools in public relations can help to increase sales and leads for the organization. Imagine you are attending an event that is raising money for the local animal shelter because you are a huge animal advocate. You see signs that an organization unfamiliar to you is the lead sponsor. While you may never have heard of this organization, let alone considered buying from this company in the past, the fact that it is helping raising money for the local animal shelter sways your decision to do business with them. For example,…", label:"Analyze Better Chicken Commitment (BCC) in its marketing context", canonical_key:"analyze_better_chicken_commitment_bcc_in_its_mar", status:"approved"}}, {concept_id:"f26efdaa-646b-5903-a659-92ec86268b11", kc_id:"f26efdaa-646b-5903-a659-92ec86268b11", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Beyoncé and analyze its role in the textbook's treatment of the communication process. Source: printed page 447. Evidence excerpt: The sender is the source of the message. This can be the company, the marketer, or the hired talent for a commercial. For example, when PepsiCo signed a multiyear contract with Beyoncé to be a brand ambassador, Pepsi made Beyoncé the sender of its messaging.16", label:"Analyze Beyoncé in its marketing context", canonical_key:"analyze_beyonc_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"3f427ca8-2533-526c-acfe-8bbc90383ff9", kc_id:"3f427ca8-2533-526c-acfe-8bbc90383ff9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bill Ragan Roofing and analyze its role in the textbook's treatment of determining consumer needs and wants. Source: printed page 31. Evidence excerpt: • Bill Ragan Roofing: “Let us take the stress of roof repairs or a roof replacement off your shoulders.”41 • Applied Educational Systems (AES): “Spend your time connecting with students, not planning and grading”42 • DuckDuckGo: “Tired of being tracked online? We can help.”43 • HelloFresh: “Take the stress out of mealtime.”44", label:"Analyze Bill Ragan Roofing in its marketing context", canonical_key:"analyze_bill_ragan_roofing_in_its_marketing_cont", status:"approved"}}, {concept_id:"606f50e2-67df-58b6-a392-f74f2a84f01a", kc_id:"606f50e2-67df-58b6-a392-f74f2a84f01a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bing and analyze its role in the textbook's treatment of metrics used to evaluate the success of online marketing. Source: printed page 561. Evidence excerpt: Paid search is a type of digital advertising where marketers pay search engines like Google and Bing to place their ads in sponsored spots at the top or bottom of a search engine results page (SERP). A SERP (Search Engine Results Pages) is the list of search results that displays on a search engine’s page after someone enters key search terms into a search query box. Say, for example, a consumer is looking for a local company to investigate and fix a leak in their ceiling. That customer would likely visit Google and type in the search terms “plumbers near me.” Google then displays the SERP featuring sponsored companies in top positions on the page. Companies bid on key search…", label:"Analyze Bing in its marketing context", canonical_key:"analyze_bing_in_its_marketing_context", status:"approved"}}, {concept_id:"eb4bf92c-9ae2-506e-b452-ad23988fcbf8", kc_id:"eb4bf92c-9ae2-506e-b452-ad23988fcbf8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Birchbox and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 99. Evidence excerpt: Behind the Gender Differences Gender differences lead to different buying behaviors. Read this article about one such example, Birchbox (https://openstax.org/r/men-vs-women), a hair care and skin care subscription service. For even more information, check out this article about the reasons for the differences (https://openstax.org/r/women-vs- men), which include purpose, experience, brain make-up, and more. Interesting reads!", label:"Analyze Birchbox in its marketing context", canonical_key:"analyze_birchbox_in_its_marketing_context", status:"approved"}}, {concept_id:"1e145da6-6a4d-54c2-901a-bbb72dd6f386", kc_id:"1e145da6-6a4d-54c2-901a-bbb72dd6f386", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Biteable and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 547. Evidence excerpt: Online video marketing involves creating videos that tell a story about a product, company, or brand that is designed to drive consumer engagement through activities such as liking, sharing, and retweeting. Video marketing is becoming increasingly popular as a marketing tool because the cost of creating video campaigns has dropped significantly in the last decade due to technological advancements. Biteable, for example, offers marketers a cost-effective way to create brand videos that are quick, simple, and customizable.", label:"Analyze Biteable in its marketing context", canonical_key:"analyze_biteable_in_its_marketing_context", status:"approved"}}, {concept_id:"619452b9-4ba5-51d7-ba1b-85ac8d44a1c4", kc_id:"619452b9-4ba5-51d7-ba1b-85ac8d44a1c4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bitly and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 557. Evidence excerpt: There are a number of applications, such as TinyURL and Bitly, that are capable of turning long URLs into shorter ones; however, the jury is still out on whether search engines perceive these URLs as trustworthy.", label:"Analyze Bitly in its marketing context", canonical_key:"analyze_bitly_in_its_marketing_context", status:"approved"}}, {concept_id:"8d635977-1d5c-5e4f-9b5b-5d3be2bd23c2", kc_id:"8d635977-1d5c-5e4f-9b5b-5d3be2bd23c2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify BJ’s and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Warehouse Bulk items at discount for paid membership Sam’s Club, BJ’s, Costco club", label:"Analyze BJ’s in its marketing context", canonical_key:"analyze_bj_s_in_its_marketing_context", status:"approved"}}, {concept_id:"747c71c4-53f6-5cc7-b9a5-0e3f51f7bde7", kc_id:"747c71c4-53f6-5cc7-b9a5-0e3f51f7bde7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Black Lives Matter and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 266. Evidence excerpt: When diversity marketing efforts fall short, as the Tarte Cosmetics case shows, it is often the result of racially or socially charged insensitivities and missteps. The outcome can have costly repercussions for companies. In 2017, PepsiCo (see Figure 8.5) received heavy backlash for its “Live for Now Moments Anthem” campaign featuring Kendall Jenner. The commercial was criticized for trivializing the Black Lives Matter (BLM) movement and undermining protesters’ real-life hardships in pursuit of peace and justice.12 It was described as insensitive and offensive.", label:"Analyze Black Lives Matter in its marketing context", canonical_key:"analyze_black_lives_matter_in_its_marketing_cont", status:"approved"}}, {concept_id:"d281ac63-4968-5ceb-b3b3-9f2ad30a8fbb", kc_id:"d281ac63-4968-5ceb-b3b3-9f2ad30a8fbb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Blakely and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 444. Evidence excerpt: Digital marketing is geared toward very specific market segments and is primarily interactive. Think of digital marketing as the mechanism that produces the immediate interaction with the customer and produces some type of feedback. Digital is considered two-way communication between the company and the customer. During the early stages of launching the SPANX brand, Sara Blakely primarily used digital marketing with a", label:"Analyze Blakely in its marketing context", canonical_key:"analyze_blakely_in_its_marketing_context", status:"approved"}}, {concept_id:"4c090da7-7e17-5044-a82b-2877add98f43", kc_id:"4c090da7-7e17-5044-a82b-2877add98f43", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Blue Beyond Consulting and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 666. Evidence excerpt: Building Your Personal Brand A workplace study by Blue Beyond Consulting shows that 8 in 10 employees say that it’s important that their employer’s values align with their values. Furthermore, more than 75 percent of respondents indicated that they expect their employer and business to be a force for good.31", label:"Analyze Blue Beyond Consulting in its marketing context", canonical_key:"analyze_blue_beyond_consulting_in_its_marketing_", status:"approved"}}, {concept_id:"fe23d90d-feab-55d8-bf2f-159888edc9d8", kc_id:"fe23d90d-feab-55d8-bf2f-159888edc9d8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Blue Cross and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 582. Evidence excerpt: For some industries, the distribution network is complex, and agents represent the manufacturer in marketing channel negotiations. Health insurance agents, for example, represent major insurance carriers such as Aetna and Blue Cross by providing consumers with information about health plans in their state. In these situations, the agent does not take ownership of the product like other intermediaries but rather is paid a fee by the insurance carrier.", label:"Analyze Blue Cross in its marketing context", canonical_key:"analyze_blue_cross_in_its_marketing_context", status:"approved"}}, {concept_id:"7ecdad2f-5dfe-573a-8717-25c144b4db7b", kc_id:"7ecdad2f-5dfe-573a-8717-25c144b4db7b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify BMW and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 50. Evidence excerpt: • BMW: “The BMW Group is the world’s leading provider of premium products and premium services for individual mobility”9 • Tesla: “To accelerate the advent of sustainable transport by bringing compelling mass-market electric cars to market as soon as possible”10 • Apple: “To bring the best personal computing products and support to students, educators, designers, scientists, engineers, businesspersons and consumers in over 140 countries around the world”11", label:"Analyze BMW in its marketing context", canonical_key:"analyze_bmw_in_its_marketing_context", status:"approved"}}, {concept_id:"7dd2d6f6-2c08-5d3f-84c6-ba946972164d", kc_id:"7dd2d6f6-2c08-5d3f-84c6-ba946972164d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Boar’s Head and analyze its role in the textbook's treatment of main types of sales promotion. Source: printed page 528. Evidence excerpt: Advertising can be expensive for retailers. Typically, they advertise products they have in stock in an effort to induce consumers to come in and make a purchase. Cooperative advertising is a way for manufacturers to help with the cost of the advertising, in exchange for the retailer to advertise the products produced by the manufacturer. When supermarket chain Publix advertises Boar’s Head meats and cheeses, Publix is using cooperative advertising from Boar’s Head to run the ads featuring Boar’s Head products.", label:"Analyze Boar’s Head in its marketing context", canonical_key:"analyze_boar_s_head_in_its_marketing_context", status:"approved"}}, {concept_id:"6b058697-3487-5d20-8e13-177b6de1415a", kc_id:"6b058697-3487-5d20-8e13-177b6de1415a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Boeing and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 583. Evidence excerpt: Much like the business-to-consumer (B2C) space, when a company sells products or services directly to a final consumer or end user, the B2B marketing channel can be direct without the use of intermediaries. The direct channel is typically used when the nature of the product is complex, is expensive, or requires intensive resources to move the product from the manufacturer to the business customer. Airplane manufacturers like Boeing and Airbus produce and sell aircraft directly to airlines like Delta Air Lines and American Airlines, who then offer flights to consumers. Given the expense and complexity of distributing airplanes, the direct channel makes the most sense.", label:"Analyze Boeing in its marketing context", canonical_key:"analyze_boeing_in_its_marketing_context", status:"approved"}}, {concept_id:"aa95a426-75ff-55a9-8017-8cb4eb8973fb", kc_id:"aa95a426-75ff-55a9-8017-8cb4eb8973fb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bombas and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 344. Evidence excerpt: New Product Defined You’ve probably watched at least one episode of the popular television show Shark Tank, where budding entrepreneurs pitch their business plans to a panel of investors in return for funding. To date, over 1,000 sales pitches have been made on the show—some forgettable, others memorable—and some pitches have resulted in wildly successful businesses. Some of Shark Tank’s most successful products include the Squatty Potty (over $200 million in sales since appearing on Shark Tank), Bombas Socks (over $225 million), and Scrub Daddy (over $330 million).2", label:"Analyze Bombas in its marketing context", canonical_key:"analyze_bombas_in_its_marketing_context", status:"approved"}}, {concept_id:"822f5f40-424c-5436-88e1-1b34ec8f4b23", kc_id:"822f5f40-424c-5436-88e1-1b34ec8f4b23", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Boston Consulting Group and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 57. Evidence excerpt: The BCG matrix is a model developed by Boston Consulting Group that can be used to analyze a business’s product lines or SBUs and make decisions about which to invest in in the future and which they should try to minimize further investment in or even eliminate. The bottom line is that no business has unlimited funds to invest in its product lines, and the BCG matrix is a useful model in determining how to allocate money in terms of marketing, research and development (R&D), etc. to that portfolio.", label:"Analyze Boston Consulting Group in its marketing context", canonical_key:"analyze_boston_consulting_group_in_its_marketing", status:"approved"}}, {concept_id:"a4c02559-7a89-569d-9aa1-f78e2a0bba88", kc_id:"a4c02559-7a89-569d-9aa1-f78e2a0bba88", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bottomless Closet and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 653. Evidence excerpt: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", label:"Analyze Bottomless Closet in its marketing context", canonical_key:"analyze_bottomless_closet_in_its_marketing_conte", status:"approved"}}, {concept_id:"9d51c54b-015d-5497-928f-85c03442c027", kc_id:"9d51c54b-015d-5497-928f-85c03442c027", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Brach’s and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze Brach’s in its marketing context", canonical_key:"analyze_brach_s_in_its_marketing_context", status:"approved"}}, {concept_id:"57d0364e-b708-5d7d-b33e-468477017628", kc_id:"57d0364e-b708-5d7d-b33e-468477017628", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Breast Cancer Foundation and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: Organizations are increasingly sponsoring or hosting special events to show support for various causes. Such events are also a way to showcase the company, products/services, and/or brands to the public. Often, companies use special events to show the public that their values and ideals are part of their business model. For example, Kroger has sponsored and volunteered for the Susan G. Komen Central Indiana Race for a Cure for many years. With one of its division offices located in Indianapolis, Indiana, the company has been covered by media for its involvement in the local chapter of the Breast Cancer Foundation.19 The events not only", label:"Analyze Breast Cancer Foundation in its marketing context", canonical_key:"analyze_breast_cancer_foundation_in_its_marketin", status:"approved"}}, {concept_id:"729af0f2-a071-5ca6-b140-4cf4a6c641d6", kc_id:"729af0f2-a071-5ca6-b140-4cf4a6c641d6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Buick and analyze its role in the textbook's treatment of ethical considerations in pricing. Source: printed page 428. Evidence excerpt: Price fixing occurs when two or more competitors agree to set prices at a specific level. The practice of price fixing force customers to pay higher prices than normal with no substitute alternatives. Consumers who purchased or leased certain automobiles were part of a class-action lawsuit involving several automobile manufactures. The brands, including Audi, BMW, Buick, Chevrolet, and many others agreed to pay into the settlement after being accused of conspiring together to artificially inflate the prices of various auto parts.34", label:"Analyze Buick in its marketing context", canonical_key:"analyze_buick_in_its_marketing_context", status:"approved"}}, {concept_id:"5bebaf04-908c-5789-aad6-39b395ab9b45", kc_id:"5bebaf04-908c-5789-aad6-39b395ab9b45", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bumble and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 99. Evidence excerpt: For more success stories, check out these videos about numerous companies that got it right (https://openstax.org/r/examplesofbrands). Examples include stories from Rihanna’s Fenty beauty line, Adobe’s “When I See Black” ad, Bumble’s “Find Me on Bumble” campaign, and many more!", label:"Analyze Bumble in its marketing context", canonical_key:"analyze_bumble_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"87ead1d6-95f1-575b-873a-12eea8971f6d", kc_id:"87ead1d6-95f1-575b-873a-12eea8971f6d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Bumble Bee and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 146. Evidence excerpt: Price fixing is illegal because it’s considered anticompetitive and hurts both consumers and businesses. Let’s illustrate with a real-life example with a company you’re likely familiar with—StarKist. In 2019, a San Francisco federal judge ordered the company to pay a fine in the amount of $100 million in connection with a canned tuna price-fixing conspiracy that involved StarKist, Bumble Bee Foods, and Chicken of the Sea, who regularly exchanged information about their sales and plans for pricing. The lawsuit alleged that, under the scheme, consumers were forced to pay more for canned tuna than they would have otherwise.21", label:"Analyze Bumble Bee in its marketing context", canonical_key:"analyze_bumble_bee_in_its_marketing_context", status:"approved"}}, {concept_id:"15d87a26-8d5d-5c38-aa80-cb8ffd3786de", kc_id:"15d87a26-8d5d-5c38-aa80-cb8ffd3786de", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Burch and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Burch in its marketing context", canonical_key:"analyze_burch_in_its_marketing_context", status:"approved"}}, {concept_id:"37e6967c-d786-5e88-a43d-36097cb9e6e3", kc_id:"37e6967c-d786-5e88-a43d-36097cb9e6e3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Burger King and analyze its role in the textbook's treatment of buyers and buying situations in a b2b market. Source: printed page 131. Evidence excerpt: Producers are companies that purchase goods and services that are transformed into other products, and they include both manufacturers and service providers. For example, in one of its divisions, Emerson Electric produces electronic controls for the heating, ventilating, and air conditioning (HVAC) industry. Its buyers need to purchase capacitors, printed circuit boards, resistors, diodes, and dozens of other components in order to build those controls. Burger King needs beef patties, buns, lettuce, pickles, and other ingredients to make its sandwiches. Your local tattoo shop needs tattoo ink and needles. You’ve likely bought a smartphone. Imagine", label:"Analyze Burger King in its marketing context", canonical_key:"analyze_burger_king_in_its_marketing_context", status:"approved"}}, {concept_id:"eb0f90e3-721d-5cab-ae3d-eeccc8e86ebd", kc_id:"eb0f90e3-721d-5cab-ae3d-eeccc8e86ebd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Burnett and analyze its role in the textbook's treatment of advertising in the promotion mix. Source: printed page 473. Evidence excerpt: In the Spotlight Leo Burnett was a journalist for the Peoria Times in Illinois when he decided to start his own advertising firm with the same name in 1935.1 His strategies were fairly simple: to utilize models who looked like ordinary people instead of Hollywood stars. His motto: “What helps people, helps business.” That strategy paid off big for Philip Morris with the introduction of the iconic—albeit now considered unethical—Marlboro Man. In 1952, the ageless Tony the Tiger cartoon icon for Kellogg’s Frosted Flakes was also born from the Leo Burnett ad agency. Other notable companies that have utilized the Leo Burnett ad agency include Procter & Gamble, McDonald’s, and Fiat,…", label:"Analyze Burnett in its marketing context", canonical_key:"analyze_burnett_in_its_marketing_context", status:"approved"}}, {concept_id:"3f8ef720-d073-5777-8ef7-a8109be124a4", kc_id:"3f8ef720-d073-5777-8ef7-a8109be124a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Butterball and analyze its role in the textbook's treatment of products, services, and experiences. Source: printed page 311. Evidence excerpt: The third level of a product is the augmented product: warranties, customer service, product support, etc. The augmented product is the unseen aspects of the product essential to its service to you. For example, Butterball launches a turkey talk-line that provides tips on cooking the perfect Thanksgiving turkey each Thanksgiving. So if you have turkey roasting questions, the talk-line is ready and waiting to answer your", label:"Analyze Butterball in its marketing context", canonical_key:"analyze_butterball_in_its_marketing_context", status:"approved"}}, {concept_id:"92763935-748f-5e66-bcba-c47c25e43a1c", kc_id:"92763935-748f-5e66-bcba-c47c25e43a1c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Buzzfeed and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 546. Evidence excerpt: Buzzfeed provides another great example of a company that optimizes email marketing to reach subscribers. According to Campaign Monitor, it has created a collection of diverse and audience-catered newsletters that are tailored to the preferences of Buzzfeed’s subscribers.10 Emails feature relevant articles and funny GIFs that prompt subscribers to visit the site to read more. On average, subscribers who visit the site via email spend more time on the site than those website visitors who have come from other channels.", label:"Analyze Buzzfeed in its marketing context", canonical_key:"analyze_buzzfeed_in_its_marketing_context", status:"approved"}}, {concept_id:"94cc9487-c969-55d8-a06a-53a0e88d4529", kc_id:"94cc9487-c969-55d8-a06a-53a0e88d4529", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify C.H. Robinson and analyze its role in the textbook's treatment of retailing strategy decisions. Source: printed page 645. Evidence excerpt: • How does technology impact the supply chain? • What is the biggest industry you work with that depends on supply chain partners? • How has the COVID-19 pandemic impacted product availability and distribution efforts? • What does a typical day at C.H. Robinson consist of? • What special training do I need to work in supply chain logistics? • What is a typical salary for a professional new to C.H. Robinson?", label:"Analyze C.H. Robinson in its marketing context", canonical_key:"analyze_c_h_robinson_in_its_marketing_context", status:"approved"}}, {concept_id:"3417d6e0-0268-54f4-bcfa-c8de17456c0d", kc_id:"3417d6e0-0268-54f4-bcfa-c8de17456c0d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Campaign for a Commercial-Free Childhood (CCFC) and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 187. Evidence excerpt: Now let’s consider gender stereotypes. At approximately age 2, children become conscious of the physical differences between boys and girls, and according to the Campaign for a Commercial-Free Childhood (CCFC), gender-stereotyped messages can interfere with that process. Consider the number of gender-stereotyped toys on the market today (or go to the toy section of any big-box store). For example, there are approximately 40,000 Disney Princess items on the market today, typically aimed at girls, whereas toys like Transformers are typically marketed to boys.79", label:"Analyze Campaign for a Commercial-Free Childhood (CCFC) in its marketing context", canonical_key:"analyze_campaign_for_a_commercial_free_childhood", status:"approved"}}, {concept_id:"37e6f94c-272c-5e31-8c99-659a82f805a0", kc_id:"37e6f94c-272c-5e31-8c99-659a82f805a0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Campfire Treats and analyze its role in the textbook's treatment of the advantages and disadvantages of public relations. Source: printed page 492. Evidence excerpt: Another advantage of public relations is that of sales and leads. Again, because public relations is considered a more credible source of information, various tools in public relations can help to increase sales and leads for the organization. Imagine you are attending an event that is raising money for the local animal shelter because you are a huge animal advocate. You see signs that an organization unfamiliar to you is the lead sponsor. While you may never have heard of this organization, let alone considered buying from this company in the past, the fact that it is helping raising money for the local animal shelter sways your decision to do business with them. For example,…", label:"Analyze Campfire Treats in its marketing context", canonical_key:"analyze_campfire_treats_in_its_marketing_context", status:"approved"}}, {concept_id:"2c18db49-ff93-5194-aaf5-2d817806b80c", kc_id:"2c18db49-ff93-5194-aaf5-2d817806b80c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify CAN-SPAM Act and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: • CAN-SPAM Act. This regulation monitors commercial email practices and is one of the prominent regulations that affect many marketers across industries.", label:"Analyze CAN-SPAM Act in its marketing context", canonical_key:"analyze_can_spam_act_in_its_marketing_context", status:"approved"}}, {concept_id:"c37951ee-90f4-5d4c-bc72-9b6e7b25286e", kc_id:"c37951ee-90f4-5d4c-bc72-9b6e7b25286e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify CareerBuilder and analyze its role in the textbook's treatment of management of the sales force. Source: printed page 518. Evidence excerpt: Most recruiting starts with a job description detailing the requirements and the necessary skills that are needed to do the job. Finding the right candidates often starts through listing available job openings on many of the digital job boards, such as Indeed, CareerBuilder, and LinkedIn. Executive recruiting firms can also be instrumental in finding and matching the right job candidates.", label:"Analyze CareerBuilder in its marketing context", canonical_key:"analyze_careerbuilder_in_its_marketing_context", status:"approved"}}, {concept_id:"3cf24efa-de1e-5d13-a3b9-1661407246f4", kc_id:"3cf24efa-de1e-5d13-a3b9-1661407246f4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Carvana and analyze its role in the textbook's treatment of stages in the consumer adoption process for new products. Source: printed page 362. Evidence excerpt: • Relative Advantage: How much is the new product “better than” what it replaces? This is, of course, based entirely on a consumer’s perception, but as a general rule, the easier it is to recognize the advantages of using the product, the more quickly it will be adopted. • Compatibility: This is the level at which the innovation fits into a specific society due to economic, lifestyle, and cultural reasons. For example, PCs were very compatible with middle-class lifestyles, so the product was quickly adopted. On the other hand, the diffusion of birth control in parts of the world is not compatible with social mores due to religious beliefs and cultural values. • Complexity: How…", label:"Analyze Carvana in its marketing context", canonical_key:"analyze_carvana_in_its_marketing_context", status:"approved"}}, {concept_id:"388be238-f9d0-5fb2-b05b-961d2439b935", kc_id:"388be238-f9d0-5fb2-b05b-961d2439b935", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Casper and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 541. Evidence excerpt: Direct mail has some key advantages over other forms of promotion. First, as consumers are inundated with digital messages, direct mail offers the opportunity to stand out and capture attention. Even mostly digital- facing companies like Warby Parker (see Figure 16.3) and Casper (mattresses) have added direct mail to their promotion portfolios in an attempt to stand out from other brands.", label:"Analyze Casper in its marketing context", canonical_key:"analyze_casper_in_its_marketing_context", status:"approved"}}, {concept_id:"e85eab44-83e2-5648-97d8-903feaf0dfb2", kc_id:"e85eab44-83e2-5648-97d8-903feaf0dfb2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Centers for Disease Control and Prevention (CDC) and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 187. Evidence excerpt: Another ethical issue is childhood obesity. According to the Centers for Disease Control and Prevention (CDC),", label:"Analyze Centers for Disease Control and Prevention (CDC) in its marketing context", canonical_key:"analyze_centers_for_disease_control_and_preventi", status:"approved"}}, {concept_id:"c8c40348-6cc5-5a0e-a58a-2604073ce475", kc_id:"c8c40348-6cc5-5a0e-a58a-2604073ce475", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chanel and analyze its role in the textbook's treatment of pricing and its role in the marketing mix. Source: printed page 407. Evidence excerpt: For example, if a consumer purchases a high-end designer Chanel handbag for $11,000, they might equate the value to a beautiful, high-end, well-made handbag that will last for many years. They may also subconsciously believe the bag will portray a certain social status while carrying it. For them, there is value and quality in the product, and they are willing to pay the high price.", label:"Analyze Chanel in its marketing context", canonical_key:"analyze_chanel_in_its_marketing_context", status:"approved"}}, {concept_id:"e8ddf110-fa63-57f4-ba1a-76b3f43bd850", kc_id:"e8ddf110-fa63-57f4-ba1a-76b3f43bd850", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Charity: Water and analyze its role in the textbook's treatment of sustainable marketing principles. Source: printed page 661. Evidence excerpt: Charity: Water is an outstanding example of a mission-driven organization that uses marketing to inspire its audience. Its mission is to bring clean water to communities that face a clean water crisis. The founder, Scott Harrison, has his own story that inspires the mission, and storytelling is integral to implementing charity: water’s marketing strategy.", label:"Analyze Charity: Water in its marketing context", canonical_key:"analyze_charity_water_in_its_marketing_context", status:"approved"}}, {concept_id:"b1b02fd0-8d62-5879-a773-af22eaf9b69a", kc_id:"b1b02fd0-8d62-5879-a773-af22eaf9b69a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Cheerios and analyze its role in the textbook's treatment of marketing strategies at each stage of the product life cycle. Source: printed page 319. Evidence excerpt: Products in the maturity stage may engage in market modification, an extension of the product to new customers. For example, Cheerios adopted a market modification strategy when it positioned its cereal to the aging baby boomer demographic as a heart-healthy breakfast. This strategy opened a new market for Cheerios to increase its market share.", label:"Analyze Cheerios in its marketing context", canonical_key:"analyze_cheerios_in_its_marketing_context", status:"approved"}}, {concept_id:"f068a3bb-b8ec-5368-8216-ea854f470ab3", kc_id:"f068a3bb-b8ec-5368-8216-ea854f470ab3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chevrolet and analyze its role in the textbook's treatment of ethical considerations in pricing. Source: printed page 428. Evidence excerpt: Price fixing occurs when two or more competitors agree to set prices at a specific level. The practice of price fixing force customers to pay higher prices than normal with no substitute alternatives. Consumers who purchased or leased certain automobiles were part of a class-action lawsuit involving several automobile manufactures. The brands, including Audi, BMW, Buick, Chevrolet, and many others agreed to pay into the settlement after being accused of conspiring together to artificially inflate the prices of various auto parts.34", label:"Analyze Chevrolet in its marketing context", canonical_key:"analyze_chevrolet_in_its_marketing_context", status:"approved"}}, {concept_id:"727e9e7f-059c-50f6-b322-4a0d8dd37468", kc_id:"727e9e7f-059c-50f6-b322-4a0d8dd37468", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chevy and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 100. Evidence excerpt: Let’s first consider the influence of family. It is generally believed that most people pass through two families: a family of orientation (i.e., the family to which you were born or with whom you grew up) and a family of procreation (the family formed through marriage or cohabitation, including your spouse, partner, and/or children). Consider first the family of orientation. When you were growing up, whether or not you recognized it, you likely developed some degree of buying behavior through watching adult members of your household and probably tend to buy the same products or services as you grow older. Was your father a die-hard Chevy driver? If so, the chances are good that…", label:"Analyze Chevy in its marketing context", canonical_key:"analyze_chevy_in_its_marketing_context", status:"approved"}}, {concept_id:"15439554-e17b-5f00-9b53-0e3604060a12", kc_id:"15439554-e17b-5f00-9b53-0e3604060a12", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chick-fil-A and analyze its role in the textbook's treatment of major influences on b2b buyer behavior. Source: printed page 139. Evidence excerpt: Competition also affects B2B buying behavior. It stands to reason that, when a competitor changes its product offering and garners more market share, a business will want to respond by going on the defensive and changing its product offering as well, triggering one or more B2B buying situations. The fast-food industry is just one example of this. Wendy’s was the first national fast-food chain to introduce salads in response to consumers’ desires for healthier food options.15 Shortly thereafter, many other competitors, including Arby’s, McDonald’s, Chick-fil-A, and Burger King, followed suit.", label:"Analyze Chick-fil-A in its marketing context", canonical_key:"analyze_chick_fil_a_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"59cc756f-a308-59c4-829c-f94817b05d4d", kc_id:"59cc756f-a308-59c4-829c-f94817b05d4d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chicken of the Sea and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 146. Evidence excerpt: Price fixing is illegal because it’s considered anticompetitive and hurts both consumers and businesses. Let’s illustrate with a real-life example with a company you’re likely familiar with—StarKist. In 2019, a San Francisco federal judge ordered the company to pay a fine in the amount of $100 million in connection with a canned tuna price-fixing conspiracy that involved StarKist, Bumble Bee Foods, and Chicken of the Sea, who regularly exchanged information about their sales and plans for pricing. The lawsuit alleged that, under the scheme, consumers were forced to pay more for canned tuna than they would have otherwise.21", label:"Analyze Chicken of the Sea in its marketing context", canonical_key:"analyze_chicken_of_the_sea_in_its_marketing_cont", status:"approved"}}, {concept_id:"a672e187-ebee-5d6f-b3f6-3d20eacd4199", kc_id:"a672e187-ebee-5d6f-b3f6-3d20eacd4199", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chipotle and analyze its role in the textbook's treatment of ethical issues in consumer buying behavior. Source: printed page 116. Evidence excerpt: Like many fast-food chains, Chipotle (see Figure 3.13) focuses on the quality of its ingredients above all else. One of the brand’s hallmarks is that it works with family farmers within a 130-mile radius of each of its locations and attempts whenever possible to source local and sustainably raised ingredients. Additionally, Chipotle eliminated genetically modified (GMO) foods from its menu, citing public concerns about the safety of genetically modified ingredients.23", label:"Analyze Chipotle in its marketing context", canonical_key:"analyze_chipotle_in_its_marketing_context", status:"approved"}}, {concept_id:"d00fbb07-46ae-522d-8acf-2177be80561c", kc_id:"d00fbb07-46ae-522d-8acf-2177be80561c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chips Ahoy and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 326. Evidence excerpt: Multibrands are new brand names within a company’s existing product category. For example, Nabisco manufactures various cookies within a product line but is marketed with different brand names. In this case, Chips Ahoy, Oreo, and Teddy Grahams all have brand equity on their own and do not need the benefit of the Nabisco brand. Each of these brands has a significant market share, so there is a benefit to retaining a multibranding approach. However, a multibranding approach does not work when the products have a small market share or fail to gain favorable retail shelf space to encourage sales.", label:"Analyze Chips Ahoy in its marketing context", canonical_key:"analyze_chips_ahoy_in_its_marketing_context", status:"approved"}}, {concept_id:"1556b865-c508-5783-9992-bb43c43f0178", kc_id:"1556b865-c508-5783-9992-bb43c43f0178", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Chobani and analyze its role in the textbook's treatment of marketing strategies at each stage of the product life cycle. Source: printed page 319. Evidence excerpt: Products in the maturity stage may also engage in product modification, altering products to fit the market. Modifications may be made to the function of the product, the quality of the product, and/or the style of the product. For example, Chobani modified its yogurt product in 2015 by altering the container, allowing the customer to flip toppings into yogurt, and changing the functionality of the yogurt and topping product.5", label:"Analyze Chobani in its marketing context", canonical_key:"analyze_chobani_in_its_marketing_context", status:"approved"}}, {concept_id:"c0be893e-9b3e-5862-82b7-6fa71bb92698", kc_id:"c0be893e-9b3e-5862-82b7-6fa71bb92698", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Church’s and analyze its role in the textbook's treatment of entering the global arena. Source: printed page 241. Evidence excerpt: The most basic and least involved method to enter global markets is through exporting. Exporting is when a company makes a product or service in one country and sells it in others. Many companies choose this method of entry into global markets because it requires the least amount of m risk and allows the firm’s managers to learn the ins and outs of international business. For example, in the UK’s East Midlands, the county of Northampton is home to Alfred Sargent & Sons, Church’s, John Lobb, and other shoemakers. An increased emphasis on exporting allowed these dying businesses to see new life because people in other countries wanted a piece of traditional “English cobbling.”58", label:"Analyze Church’s in its marketing context", canonical_key:"analyze_church_s_in_its_marketing_context", status:"approved"}}, {concept_id:"368189d4-c267-5b63-a368-df58d459d22f", kc_id:"368189d4-c267-5b63-a368-df58d459d22f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Cirque du Soleil and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 63. Evidence excerpt: Blue Ocean Strategy Learn about market-creating strategies known as the Blue Ocean strategy from Harvard Business Review, where it uses Cirque du Soleil as an example.", label:"Analyze Cirque du Soleil in its marketing context", canonical_key:"analyze_cirque_du_soleil_in_its_marketing_contex", status:"approved"}}, {concept_id:"7f0dab11-526b-5d26-9676-adce9b8f2f36", kc_id:"7f0dab11-526b-5d26-9676-adce9b8f2f36", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Civil Rights Act and analyze its role in the textbook's treatment of strategic marketing: standardization versus adaptation. Source: printed page 259. Evidence excerpt: After the Civil Rights Act was signed in 1964 and the Equal Employment Opportunity Commission (EEOC) was formed in 1965, P&G proactively launched its own affirmative action plans across all its business units. P&G instituted the changes even before the EEOC was fully functional. That same year, P&G also conducted product research with Hispanic consumers in Miami, focusing on the scent used in its Secret deodorant line. This commitment to diversity in business practices has remained strong through the years.", label:"Analyze Civil Rights Act in its marketing context", canonical_key:"analyze_civil_rights_act_in_its_marketing_contex", status:"approved"}}, {concept_id:"0c4d17e6-a33e-579d-98ee-988a1e04001d", kc_id:"0c4d17e6-a33e-579d-98ee-988a1e04001d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify CJ Affiliate and analyze its role in the textbook's treatment of metrics used to evaluate the success of online marketing. Source: printed page 561. Evidence excerpt: Affiliates are people or companies that earn a commission for driving traffic to another person’s or company’s website where they make a purchase. CJ Affiliate, formerly known as Commission Junction, provides affiliate marketers with a marketplace to connect with brands who pay affiliates for driving traffic and purchases online.", label:"Analyze CJ Affiliate in its marketing context", canonical_key:"analyze_cj_affiliate_in_its_marketing_context", status:"approved"}}, {concept_id:"67c59125-ca23-56fb-aa54-8c44bc128714", kc_id:"67c59125-ca23-56fb-aa54-8c44bc128714", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Claritas and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 268. Evidence excerpt: • The Hispanic population is the largest multicultural group in the nation and makes up about 19 percent of the total population. According to data-driven marketing company Claritas, the Hispanic population is one of the fastest-growing groups, with over 63 million individuals, and is also responsible for 59 percent of the country’s population growth between 2010 and 2021.20 Plus, by 2026, business strategists believe that nearly two out of every three consumers in the United States will belong to this ethnic group.21 With a median age of 29, this group also has the youngest population in the country. • The Black population is also a growing segment with 46.9 million…", label:"Analyze Claritas in its marketing context", canonical_key:"analyze_claritas_in_its_marketing_context", status:"approved"}}, {concept_id:"ed56f339-d7a9-558e-ac48-baed7aba7259", kc_id:"ed56f339-d7a9-558e-ac48-baed7aba7259", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Classic Cleaners and analyze its role in the textbook's treatment of marketing plan progress using metrics. Source: printed page 78. Evidence excerpt: Classic Cleaners is a provider of dry cleaning and laundry services based in Indianapolis, Indiana (see Figure 2.15). The company has 17 locations.75 Like many businesses, Classic Cleaners always struggled with the question, What does my customer really want? The company wanted an easy solution to using real-time marketing to track and measure results and obtain insights that would aid it in making data-driven decisions.", label:"Analyze Classic Cleaners in its marketing context", canonical_key:"analyze_classic_cleaners_in_its_marketing_contex", status:"approved"}}, {concept_id:"4332c407-07a7-5c1f-935b-05d6d8e58f57", kc_id:"4332c407-07a7-5c1f-935b-05d6d8e58f57", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify CNN and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 489. Evidence excerpt: Consider CNN’s Blackfish, which aired in 2013. The documentary shed light on the consequences of keeping orcas in captivity, forcing them to perform for sightseers at sea parks. It takes a deep dive into the lives of these captive marine mammals and how sometimes such animals can be deadly, as was witnessed at SeaWorld in 2014.14 The results of the negative publicity created by the documentary caused SeaWorld’s park attendance, as well as its market value, to drop.15", label:"Analyze CNN in its marketing context", canonical_key:"analyze_cnn_in_its_marketing_context", status:"approved"}}, {concept_id:"30295692-b22c-5614-8f37-a9303ba95ff5", kc_id:"30295692-b22c-5614-8f37-a9303ba95ff5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Coach and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 621. Evidence excerpt: In some ways, factory outlets are similar to off-price retailers (see Figure 18.6). The goods found in factory outlets are typically over-manufactured and sold at lower prices. However, factory outlet goods are sold directly from the manufacturer rather than through a third party. Many clothing manufacturers have factory outlets, which are typically clustered together in a factory outlet mall, a space where numerous factory outlets are located. For example, you may see Coach, Gap, or Lands’ End stores in outlet malls. Sawgrass Mills Factory Outlet, located in Sunrise, Florida, is the largest factory outlet mall in the United States. It houses over 350 factory outlet stores,…", label:"Analyze Coach in its marketing context", canonical_key:"analyze_coach_in_its_marketing_context", status:"approved"}}, {concept_id:"7481217f-4af0-5810-8298-091d244cd684", kc_id:"7481217f-4af0-5810-8298-091d244cd684", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Coca-Cola and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 98. Evidence excerpt: Failures and Inspirations Cultural factors play a major role in determining how best to market to consumers. There are numerous examples of company efforts that failed because they did not reflect an understanding of the culture in a particular market. Watch this CNBC video on why Starbucks failed in Australia and read this article about how Coca-Cola and PepsiCo failed (https://openstax.org/r/examplescompanyfailure) when they first moved into the Chinese market.", label:"Analyze Coca-Cola in its marketing context", canonical_key:"analyze_coca_cola_in_its_marketing_context", status:"approved"}}, {concept_id:"ccf895b0-16c2-5d9d-bb8b-839570a5d7dc", kc_id:"ccf895b0-16c2-5d9d-bb8b-839570a5d7dc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Conscious Coffees and analyze its role in the textbook's treatment of ethical issues in consumer buying behavior. Source: printed page 117. Evidence excerpt: Ethics and Corporations Hundreds of companies are known for being ethical, including Patagonia (more information later in this chapter), TOMS, and Conscious Coffees, among others. Read about five examples of truly ethical companies (https://openstax.org/r/trulyethicalcompanies) and how they are working to make an impact in their markets.", label:"Analyze Conscious Coffees in its marketing context", canonical_key:"analyze_conscious_coffees_in_its_marketing_conte", status:"approved"}}, {concept_id:"21088c51-437c-5227-ae33-228140fc0ccc", kc_id:"21088c51-437c-5227-ae33-228140fc0ccc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Constellation Brands and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 267. Evidence excerpt: Modelo Especial is a good example. Modelo Especial is a Mexican beer that has successfully capitalized on its heritage to target the Hispanic population while also appealing to the general market. Marketed by Constellation Brands, the beer has had strong sales in the United States since the 1990s.17 In 2019, Hispanic consumers captured close to 70 percent of the brand’s national sales, but Hispanic people are only about half of the customer base.18 Over the course of several decades, various aspects of Hispanic culture have been widely embraced in the United States. Have you heard of artists like Jennifer Lopez, Pitbull, Bad Bunny, and J Balvin? The marketing team at…", label:"Analyze Constellation Brands in its marketing context", canonical_key:"analyze_constellation_brands_in_its_marketing_co", status:"approved"}}, {concept_id:"390b0af8-9c82-5e7c-9e48-efeb79f30625", kc_id:"390b0af8-9c82-5e7c-9e48-efeb79f30625", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Converse and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 98. Evidence excerpt: A subculture is a group of people, such as environmentalists or bodybuilders, who share a set of values. Ethnic and racial groups share the language, food, and culture of their heritage. Other subcultures, like the biker culture, which revolves around a dedication to motorcycles, are united by shared experiences. The Amish subculture is known for its conservative beliefs and reluctance to adapt to modern technology. Think about what subculture(s) you may belong to and how they influence your buying behavior. For example, hip-hop music has long been associated with fashion, particularly sneakers. Run DMC’s 1986 hit “My Adidas” led to the first endorsement deal between a fashion…", label:"Analyze Converse in its marketing context", canonical_key:"analyze_converse_in_its_marketing_context", status:"approved"}}, {concept_id:"39873997-e804-59e0-bf54-6073b55166c7", kc_id:"39873997-e804-59e0-bf54-6073b55166c7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Corruption Perceptions Index (CPI) and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 235. Evidence excerpt: Transparency International publishes an annual survey called the Corruption Perceptions Index (CPI). Marketers use this survey for insights into country dynamics and can evaluate market viability of their product or service offering. This guide helps company leadership determine how much work they may have in understanding a country’s way of operating and what kind of work it would take to make their product or service successful.", label:"Analyze Corruption Perceptions Index (CPI) in its marketing context", canonical_key:"analyze_corruption_perceptions_index_cpi_in_its_", status:"approved"}}, {concept_id:"ffee351a-0cde-5b0d-ac32-8cc9302a8067", kc_id:"ffee351a-0cde-5b0d-ac32-8cc9302a8067", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Costco and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 179. Evidence excerpt: One of the biggest advantages of undifferentiated marketing is the scope and cost-efficiency of advertising on a much larger scale. Every single marketing message can be deployed across a variety of media channels and can potentially reach millions of consumers. This is where economies of scale come into play: with high- volume sales, production becomes less expensive because costs can be spread out over a larger amount of goods. That’s a huge advantage compared to companies that produce products for smaller, more precisely targeted audiences. It’s like buying in bulk at Sam’s Club or Costco—because you buy so much of a product, the cost is lower. Companies that use…", label:"Analyze Costco in its marketing context", canonical_key:"analyze_costco_in_its_marketing_context", status:"approved"}}, {concept_id:"45b720ec-ddd9-595c-856b-f144a013c82b", kc_id:"45b720ec-ddd9-595c-856b-f144a013c82b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Council of Better Business Bureaus and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze Council of Better Business Bureaus in its marketing context", canonical_key:"analyze_council_of_better_business_bureaus_in_it", status:"approved"}}, {concept_id:"2d7ada30-36f8-5714-b13e-e29b68673a02", kc_id:"2d7ada30-36f8-5714-b13e-e29b68673a02", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Creminelli Fine Meats and analyze its role in the textbook's treatment of main types of sales promotion. Source: printed page 526. Evidence excerpt: volume during the early stages of the product life cycle and to help with better distribution. Samples can be given out in stores, at events, or through the mail. This is an expensive form of sales promotion but can be highly effective at inducing purchase. Costco regularly has samples within its aisles and at the immediate point of sale as consumers are shopping. Another example is from the 2022 SXSW conference in Austin, Texas, when Creminelli Fine Meats distributed free mini packs of salami to showcase the company’s line of “charcuterie- grade snacking” products. The makers of White Claw Hard Seltzer were corporate sponsors of the event; conference-goers were treated to free…", label:"Analyze Creminelli Fine Meats in its marketing context", canonical_key:"analyze_creminelli_fine_meats_in_its_marketing_c", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"cbbeb970-c30d-5b9f-97a4-a2c0df91a2a2", kc_id:"cbbeb970-c30d-5b9f-97a4-a2c0df91a2a2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Cumberland Farms and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 442. Evidence excerpt: For National Ice Cream Day (see Figure 13.4), Cumberland Farms wanted to increase the sales of its house brand of ice cream, Ultimate Scoop.8 It offered consumers a digital coupon for $1 off a pint of the ice cream. Cumberland Farms’ existing customers received their coupon via text message, and new customers could text in to get the coupon.", label:"Analyze Cumberland Farms in its marketing context", canonical_key:"analyze_cumberland_farms_in_its_marketing_contex", status:"approved"}}, {concept_id:"97459fd2-e5c4-5178-9803-7c6ba62f5ad5", kc_id:"97459fd2-e5c4-5178-9803-7c6ba62f5ad5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Cupshe and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 555. Evidence excerpt: In addition, because of the billions of active users on social media, brands can increase awareness of their existence with targeted consumers. For example, a five-year-old swimsuit and beachwear company, Cupshe, had little to no brand recognition among US consumers until it launched campaigns on Facebook and Instagram. In 2020, the company boasted $150 million in sales without a single storefront.26 Consumers were exposed to the brand via social media ads, which then drove them to the company’s website to browse styles and make purchases.", label:"Analyze Cupshe in its marketing context", canonical_key:"analyze_cupshe_in_its_marketing_context", status:"approved"}}, {concept_id:"90379314-3ede-569a-9955-cd8f1acc3454", kc_id:"90379314-3ede-569a-9955-cd8f1acc3454", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Curves and analyze its role in the textbook's treatment of product positioning. Source: printed page 183. Evidence excerpt: For instance, Curves, the largest women’s fitness franchise in the world, succeeded by offering a fitness alternative to both home-based exercise routines and traditional health clubs. The experience of a Curves facility was entirely different from that of a typical health club. Instead of machines arranged in rows facing a TV, Curves arranged its machines in a circle to facilitate interaction among members. There were few (if any) mirrors and no men staring. The result was that Curves did not compete head-to-head with other health and exercise concepts; rather, it created new demand.65", label:"Analyze Curves in its marketing context", canonical_key:"analyze_curves_in_its_marketing_context", status:"approved"}}, {concept_id:"1f3f25c3-245b-5396-bd80-829e775965a6", kc_id:"1f3f25c3-245b-5396-bd80-829e775965a6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Cutco and analyze its role in the textbook's treatment of classifications of salespeople involved in personal selling. Source: printed page 536. Evidence excerpt: In 1949, Cutco began manufacturing knives in Olean, New York. At the time, Cutco was making products for Wear-Ever Aluminum, a division of Alcoa. In 1982, the company went through a management buyout that made it a private company. The Cutco name was derived from the time under Alcoa, when it existed as the Cooking Utensil Company.", label:"Analyze Cutco in its marketing context", canonical_key:"analyze_cutco_in_its_marketing_context", status:"approved"}}, {concept_id:"d4d14aa5-839e-5f80-ae7e-07d9b0cf0bc0", kc_id:"d4d14aa5-839e-5f80-ae7e-07d9b0cf0bc0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify CVS and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 489. Evidence excerpt: The Role of Public Relations in the Promotion Mix In many organizations, public relations has been an afterthought or a sidebar to marketing, something used only when a crisis has occurred. However, public relations is more important than ever as the public seeks brands that have values aligned with their own and are not hesitant to boycott those who don’t. In fact, according to a 2017 survey, 86 percent of consumers say that authenticity is a key factor when deciding which companies and brands they will support.13 For example, in the past several years, the public has become more aware and vocal about the use of Photoshop in advertisements. In fact, many celebrities have spoken…", label:"Analyze CVS in its marketing context", canonical_key:"analyze_cvs_in_its_marketing_context", status:"approved"}}, {concept_id:"927b6159-26ba-573f-b15c-cbc71d78172e", kc_id:"927b6159-26ba-573f-b15c-cbc71d78172e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify D Rose and analyze its role in the textbook's treatment of the five-step procedure for establishing pricing policy. Source: printed page 417. Evidence excerpt: One pricing strategy that negates the demand curve is prestige pricing. Prestige pricing is a strategy that marketers use to set high prices knowing that demand will increase with higher prices because the higher price increases the perceived value of the product. Prestige pricing is closely tied to brand image and appeals to buyers who see value in elevated status. Consider these brands of shoes. The Adidas Yeezy Boost 750 costs around $76 to produce but sometimes sells for over $1,000, while the D Rose 5 Boost costs around $43 and sells for around $100. So why the large price difference? The Yeezy Boost 750 pricing strategy is that of", label:"Analyze D Rose in its marketing context", canonical_key:"analyze_d_rose_in_its_marketing_context", status:"approved"}}, {concept_id:"0c227987-95bc-57c3-82f7-81daffd6190d", kc_id:"0c227987-95bc-57c3-82f7-81daffd6190d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Data & Marketing Association (DMA) and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 444. Evidence excerpt: In 2019, the Data & Marketing Association (DMA) reported that the direct mail industry was valued at $44.2 billion.13 It’s the second largest channel for ad spend in the United States, and it continues to grow. Transformed by technology, direct marketing is finding new methods to connect with the customer. Most connection includes a call to action that provides for immediate feedback on the effectiveness of the method.", label:"Analyze Data & Marketing Association (DMA) in its marketing context", canonical_key:"analyze_data_marketing_association_dma_in_its_ma", status:"approved"}}, {concept_id:"6af091b6-a63f-5ca3-806b-a1b6749e0f13", kc_id:"6af091b6-a63f-5ca3-806b-a1b6749e0f13", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dave’s Killer Bread (DKB) and analyze its role in the textbook's treatment of the supply chain and its functions. Source: printed page 597. Evidence excerpt: For example, Dave’s Killer Bread (DKB) has positioned itself as the maker of “the best bread you’ve ever tasted, power-packed with organic whole grain nutrition.” The promise to consumers starts with selecting suppliers who are certified organic and who can consistently deliver high-quality ingredients. DKB’s promise to consumers starts as far back as the grains selected by DKB’s suppliers.", label:"Analyze Dave’s Killer Bread (DKB) in its marketing context", canonical_key:"analyze_dave_s_killer_bread_dkb_in_its_marketing", status:"approved"}}, {concept_id:"e90d7260-94c9-5cc4-a8e2-7ebbc5064445", kc_id:"e90d7260-94c9-5cc4-a8e2-7ebbc5064445", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Del Webb and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 26. Evidence excerpt: California to Texas, following similar announcements by Hewlett Packard Enterprise (HPE) and Oracle, citing such things as lower housing costs and tax rates and fewer regulations, making it easier for companies to operate in Texas. • Economic Factors. Economic factors play a huge role in terms of a company’s prospects in a market. For example, economic factors affect pricing and can even influence the supply/demand curve for a product or service. For example, high inflation causes consumers to have less spending power, which translates into lower sales and revenue. In 2022, consumers experienced both product shortages and higher prices, blamed largely on COVID-19, Russia’s war on…", label:"Analyze Del Webb in its marketing context", canonical_key:"analyze_del_webb_in_its_marketing_context", status:"approved"}}, {concept_id:"a68665b1-7e1e-567c-ac91-6946223775ba", kc_id:"a68665b1-7e1e-567c-ac91-6946223775ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dell and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 237. Evidence excerpt: In 2019, President Donald Trump increased the tariffs on Chinese goods to 25 percent. Several companies subsequently opted to pull their production facilities out of China. For example, Apple and Dell moved some of their production to Vietnam and other parts of Asia to avoid these tariffs.41", label:"Analyze Dell in its marketing context", canonical_key:"analyze_dell_in_its_marketing_context", status:"approved"}}, {concept_id:"f6838709-715f-54af-bf07-3adf0bf27b35", kc_id:"f6838709-715f-54af-bf07-3adf0bf27b35", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Delta Air Lines and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 236. Evidence excerpt: For example, in 2014, Delta Air Lines, a major US passenger airline carrier (see Figure 7.3), made a big stereotype blunder with its social media marketing. The company sent out a congratulatory tweet to the US team for its win over the Ghanaian team in the World Cup in which it used a photo of a giraffe to represent Ghana.39 Unfortunately, Delta marketers failed to realize that there is not one wild giraffe in Ghana; this is a frequent stereotype about the entire continent of Africa. In fact, there are over 50 countries in Africa, but only around 20 have naturally wild giraffes.40 The Twitter market caught on to this error quickly and proceeded to tease Delta for its stereotype…", label:"Analyze Delta Air Lines in its marketing context", canonical_key:"analyze_delta_air_lines_in_its_marketing_context", status:"approved"}}, {concept_id:"ebc2a48a-edff-52f6-87f4-f2de13b4bc2a", kc_id:"ebc2a48a-edff-52f6-87f4-f2de13b4bc2a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Department of Justice and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 146. Evidence excerpt: The Securities and Exchange Commission (SEC) and the Department of Justice work cooperatively to enforce the FCPA. Sanctions for violations can be significant, including both civil and criminal penalties. The SEC can bring civil enforcement actions against companies (along with their officers, directors, employees, stockholders, and agents) for violations or for bribery, and if found guilty under the act, the company may have to pay back its “ill-gotten gains” as well as paying prejudgment interest and civil penalties. For example, one of its most recent cases involved KT Corporation, a South Korean telecommunications company, in which the SEC alleged that the company had…", label:"Analyze Department of Justice in its marketing context", canonical_key:"analyze_department_of_justice_in_its_marketing_c", status:"approved"}}, {concept_id:"fb2ed663-66bc-57c7-84f5-9a3ea2301a06", kc_id:"fb2ed663-66bc-57c7-84f5-9a3ea2301a06", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Designer Shoe Warehouse (DSW) and analyze its role in the textbook's treatment of customer relationship management (crm). Source: printed page 33. Evidence excerpt: Before we can explore how CRM impacts customer loyalty and retention, it’s probably a good time for a few definitions. Customer loyalty is an ongoing positive relationship between a customer and a business. Customer loyalty is at the crux of repeat purchases of your product versus those of your competitors. One common way to accomplish this is to offer reward/loyalty cards. For example, you may have a frequent flyer card from an airline or a loyalty card from Starbucks or a retailer like Designer Shoe Warehouse (DSW), which rewards VIP customers with points for each purchase.", label:"Analyze Designer Shoe Warehouse (DSW) in its marketing context", canonical_key:"analyze_designer_shoe_warehouse_dsw_in_its_marke", status:"approved"}}, {concept_id:"e47d4c54-2c6d-5b72-9863-41d842ad8fbb", kc_id:"e47d4c54-2c6d-5b72-9863-41d842ad8fbb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dick’s Sporting Goods and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 546. Evidence excerpt: Email boasts over 4 billion daily users; 99 percent of people report checking their email on a daily basis.9 Given the low cost and high usage rate, email marketing can be a profitable way to connect with customers. Marketers generally send two types of emails: transactional emails and marketing emails. A transactional email is a type of email that is sent to customers following a commercial transaction, such as a purchase or a return. When online shoppers purchase athletic apparel from Dick’s Sporting Goods, they receive an email confirmation confirming the order.", label:"Analyze Dick’s Sporting Goods in its marketing context", canonical_key:"analyze_dick_s_sporting_goods_in_its_marketing_c", status:"approved"}}, {concept_id:"b08d6e1f-3769-5010-a39d-312f9b9ed015", kc_id:"b08d6e1f-3769-5010-a39d-312f9b9ed015", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Digital Marketing Institute and analyze its role in the textbook's treatment of ethical marketing. Source: printed page 41. Evidence excerpt: What Do Marketers Do? The American Marketing Association (AMA) has teamed up with the Digital Marketing Institute to offer specialized training within the marketing discipline. You can set yourself apart from other marketers with additional certifications. Are there other benefits you can take advantage of? Take a look at one of the 65 chapters located across the country. Is there one located in your city? Not only is membership a great way to volunteer, it’s also an effective way to market yourself to potential employers. For instance, the Minnesota", label:"Analyze Digital Marketing Institute in its marketing context", canonical_key:"analyze_digital_marketing_institute_in_its_marke", status:"approved"}}, {concept_id:"a06ab911-fc9f-5339-b90a-ae1e05c355ed", kc_id:"a06ab911-fc9f-5339-b90a-ae1e05c355ed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Disney and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 187. Evidence excerpt: Now let’s consider gender stereotypes. At approximately age 2, children become conscious of the physical differences between boys and girls, and according to the Campaign for a Commercial-Free Childhood (CCFC), gender-stereotyped messages can interfere with that process. Consider the number of gender-stereotyped toys on the market today (or go to the toy section of any big-box store). For example, there are approximately 40,000 Disney Princess items on the market today, typically aimed at girls, whereas toys like Transformers are typically marketed to boys.79", label:"Analyze Disney in its marketing context", canonical_key:"analyze_disney_in_its_marketing_context", status:"approved"}}, {concept_id:"8d5fd557-c50a-5548-8fc9-ddda06b45303", kc_id:"8d5fd557-c50a-5548-8fc9-ddda06b45303", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Disney Channel and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 155. Evidence excerpt: Market research also revealed that its target audience was interested in superheroes and enjoyed watching videos and playing video games centered around these superheroes, so the company used psychographic and lifestyle segmentation to appeal to this segment.2 For example, Mattel created a Disney Channel cartoon for Max Steel so that, months before the relaunch of the product in the United States, its target market was", label:"Analyze Disney Channel in its marketing context", canonical_key:"analyze_disney_channel_in_its_marketing_context", status:"approved"}}, {concept_id:"6fc249d5-5c0a-582e-8bbe-aab0f498f36a", kc_id:"6fc249d5-5c0a-582e-8bbe-aab0f498f36a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Disneyland Hong Kong and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 238. Evidence excerpt: When the Walt Disney Company decided to open Disneyland Hong Kong in 2005, the company struggled to gain momentum with its Chinese target market. Among other blunders, such as its high admission price, the company assumed that its Chinese market would love the Disney brand as much as Americans do. The company failed to realize that, unlike Americans, the Chinese did not grow up with the Disney brands and characters. Imagine walking into a fantasy theme park with characters you had never heard of or seen before. Unlike Americans, the Chinese do not view Disney characters as cultural icons. The fantasy aspect of the brand and park was another issue Disney faced. Its closest…", label:"Analyze Disneyland Hong Kong in its marketing context", canonical_key:"analyze_disneyland_hong_kong_in_its_marketing_co", status:"approved"}}, {concept_id:"9eef6f18-fd7d-5c5b-80b8-fab02af8e13b", kc_id:"9eef6f18-fd7d-5c5b-80b8-fab02af8e13b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dollar General and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 621. Evidence excerpt: During the 2008 recession, many retailers began closing their doors. But Dollar General was one retailer that saw exponential growth during this time.13 Dollar General and competitor Dollar Tree are discount stores—stores that sell a broad range of products at lower prices than competitors. While discount stores offer lower prices and often less variety than competitors, they often also offer fewer services and little customer service. As inflation put pressure on household budgets in 2022, shoppers from a range of income levels turned to dollar stores to save money on everyday necessities.", label:"Analyze Dollar General in its marketing context", canonical_key:"analyze_dollar_general_in_its_marketing_context", status:"approved"}}, {concept_id:"1e08ff62-fe60-545e-9ab2-14a89771b757", kc_id:"1e08ff62-fe60-545e-9ab2-14a89771b757", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dollar Shave Club and analyze its role in the textbook's treatment of factors contributing to the success or failure of new products. Source: printed page 356. Evidence excerpt: What Factors Contribute to the Success of New Products? The story about how the Dollar Shave Club was started is more than just urban legend. Founders Mark Levin and Michael Dubin met at a party and commiserated about how expensive razor blades were. After that party, using their own money and investments from start-up incubator Science Inc., they launched their website that sold razor blades much more cheaply starting in April 2011. These founders seized an opportunity based on several insights: that prices for blades charged by market leader Gillette were perceived as too high; that most men do not want to shop in stores for shaving supplies; and lastly, that the move to…", label:"Analyze Dollar Shave Club in its marketing context", canonical_key:"analyze_dollar_shave_club_in_its_marketing_conte", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"d69e0664-cb7b-546c-bdd4-a5be98073f7f", kc_id:"d69e0664-cb7b-546c-bdd4-a5be98073f7f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dollar Stores and analyze its role in the textbook's treatment of retailing strategy decisions. Source: printed page 628. Evidence excerpt: Success in Small Towns With the rise of large retailers such as Walmart, smaller mom-and-pop stores have struggled to compete in the last few decades. In small towns and rural areas, this has presented an economic problem. However, some retailers are finding new success in locating in these areas. Watch this clip on how Dollar Stores is finding its niche in towns where many other retailers have closed their doors.", label:"Analyze Dollar Stores in its marketing context", canonical_key:"analyze_dollar_stores_in_its_marketing_context", status:"approved"}}, {concept_id:"4f7dda08-76c4-5502-a0cc-4b38301c1ed4", kc_id:"4f7dda08-76c4-5502-a0cc-4b38301c1ed4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dollar Tree and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 621. Evidence excerpt: During the 2008 recession, many retailers began closing their doors. But Dollar General was one retailer that saw exponential growth during this time.13 Dollar General and competitor Dollar Tree are discount stores—stores that sell a broad range of products at lower prices than competitors. While discount stores offer lower prices and often less variety than competitors, they often also offer fewer services and little customer service. As inflation put pressure on household budgets in 2022, shoppers from a range of income levels turned to dollar stores to save money on everyday necessities.", label:"Analyze Dollar Tree in its marketing context", canonical_key:"analyze_dollar_tree_in_its_marketing_context", status:"approved"}}, {concept_id:"e38de5e2-944e-5d2a-b192-088a4b6edcdd", kc_id:"e38de5e2-944e-5d2a-b192-088a4b6edcdd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Domino’s Pizza and analyze its role in the textbook's treatment of product items, product lines, and product mixes. Source: printed page 313. Evidence excerpt: Product Line Length and Depth Companies typically sell many products, some of which are singular and some of which are part of a larger category of offerings. So let’s start with a product item, a particular good that a company sells. For example, Domino’s Pizza sells its original hand-tossed pizza as a product item on its menu.", label:"Analyze Domino’s Pizza in its marketing context", canonical_key:"analyze_domino_s_pizza_in_its_marketing_context", status:"approved"}}, {concept_id:"90cdf419-9cde-574a-9854-a04dd70cbd56", kc_id:"90cdf419-9cde-574a-9854-a04dd70cbd56", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Doritos and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: Finally, two or more brands may collaborate to co-brand; a product. Co-branding brings the equity of each brand together for greater value. For example, Doritos and Taco Bell developed Doritos Locos Tacos, a co- branded line of tacos that feature Doritos as the shell and Taco Bell ingredients as the toppings. In this case, the two brands had a similar target audience and could benefit from the awareness and equity of the other. However, co-branding necessitates a revenue split, which could impact financial results for each brand. Table 9.2 lists the advantages and", label:"Analyze Doritos in its marketing context", canonical_key:"analyze_doritos_in_its_marketing_context", status:"approved"}}, {concept_id:"eeba5086-7214-51f9-b975-afae76b62056", kc_id:"eeba5086-7214-51f9-b975-afae76b62056", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dotdash Meredith and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 547. Evidence excerpt: Websites, email, and other forms of online marketing are only as good as the content they carry. Content marketing involves creating and distributing content that is valuable and relevant to a company’s target customers. New York–based Dotdash Meredith is a good example of this. The company’s digital brands include Verywell, The Spruce, Byrdie, and others. Dotdash Meredith is a unit of Barry Diller’s IAC. Company policy: no pop-up ads!", label:"Analyze Dotdash Meredith in its marketing context", canonical_key:"analyze_dotdash_meredith_in_its_marketing_contex", status:"approved"}}, {concept_id:"3b18c433-1717-5d2c-b9fe-43a7bf05d9d2", kc_id:"3b18c433-1717-5d2c-b9fe-43a7bf05d9d2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dove and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 105. Evidence excerpt: When Bombarding Backfires Bombarding consumers with marketing messages can cause more harm than good. According to this article from Marketing Dive (https://openstax.org/r/studyadoverload), bombarding people with ads would negatively impact a brand. This article from the Advertising Association (https://openstax.org/r/newcredos) shares data that indicates bombardment and intrusiveness negatively impact perceptions of advertising.", label:"Analyze Dove in its marketing context", canonical_key:"analyze_dove_in_its_marketing_context", status:"approved"}}, {concept_id:"175cc8d3-2642-582d-b607-bbc3d75f6081", kc_id:"175cc8d3-2642-582d-b607-bbc3d75f6081", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Drake’s Cakes and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 470. Evidence excerpt: Among the company’s brands are Little Debbie, Sunbelt Bakery, Drake’s Cakes, and Fieldstone Bakery. The largest brand is Little Debbie, with a wide range of favorites from Apple Fruit Pies to Zebra Cakes. Little Debbie offers seasonal items in rotation, such as Christmas Tree Cakes. Distribution extends to all 50 states, Mexico, and Canada.", label:"Analyze Drake’s Cakes in its marketing context", canonical_key:"analyze_drake_s_cakes_in_its_marketing_context", status:"approved"}}, {concept_id:"9ec638fc-9800-57bd-8742-f78fdc93c81b", kc_id:"9ec638fc-9800-57bd-8742-f78fdc93c81b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify DuckDuckGo and analyze its role in the textbook's treatment of determining consumer needs and wants. Source: printed page 31. Evidence excerpt: • Bill Ragan Roofing: “Let us take the stress of roof repairs or a roof replacement off your shoulders.”41 • Applied Educational Systems (AES): “Spend your time connecting with students, not planning and grading”42 • DuckDuckGo: “Tired of being tracked online? We can help.”43 • HelloFresh: “Take the stress out of mealtime.”44", label:"Analyze DuckDuckGo in its marketing context", canonical_key:"analyze_duckduckgo_in_its_marketing_context", status:"approved"}}, {concept_id:"a965f928-3eaf-5c89-b378-d0d48249965d", kc_id:"a965f928-3eaf-5c89-b378-d0d48249965d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Dunkin’ and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 327. Evidence excerpt: Hard-core loyals are the customers that every brand wants. They are tried-and-true customers who will generally only purchase one brand in a category. For example, when purchasing from a catalog, they tend to make a purchase with less concern about price. In addition, hard-core loyals often tell friends and family about their purchases, extending word-of-mouth marketing for the brand. Brands need to retain hard-core loyal customers. For example, Dunkin’ knows that loyalty is essential to its business, so it rewards its loyal customers with free food and coffee through its DD Perks program.", label:"Analyze Dunkin’ in its marketing context", canonical_key:"analyze_dunkin_in_its_marketing_context", status:"approved"}}, {concept_id:"305c320c-a120-5835-beb0-fbc2e0fb256f", kc_id:"305c320c-a120-5835-beb0-fbc2e0fb256f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Easy Jet and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/14-4-public-relations-and-its- role-in-the-promotion-mix) You can find numerous examples of bad publicity on the Internet. Check out this article that identifies (https://openstax.org/r/mediatoolkit) many from companies such as Easy Jet, Tinder, and Tesla.", label:"Analyze Easy Jet in its marketing context", canonical_key:"analyze_easy_jet_in_its_marketing_context", status:"approved"}}, {concept_id:"32f23194-cec4-5684-9c77-8d3dcfd5f654", kc_id:"32f23194-cec4-5684-9c77-8d3dcfd5f654", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify eBay and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 50. Evidence excerpt: • eBay: “To be the world’s favorite destination for discovering great value and unique selection”14 • Genentech: “To develop drugs to address significant unmet medical needs”15", label:"Analyze eBay in its marketing context", canonical_key:"analyze_ebay_in_its_marketing_context", status:"approved"}}, {concept_id:"c128316e-8bb2-5a0d-bfad-4d8e205972ce", kc_id:"c128316e-8bb2-5a0d-bfad-4d8e205972ce", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Eggo and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 322. Evidence excerpt: The second method of positioning is benefiting the consumer—how the product or service solves the consumer’s problem. For example, the Eggo brand’s positioning is convenience. The brand solves the consumer’s morning rush issue by providing a convenient breakfast solution. The benefits positioning works well for convenience products.", label:"Analyze Eggo in its marketing context", canonical_key:"analyze_eggo_in_its_marketing_context", status:"approved"}}, {concept_id:"79d29cc6-720d-5f1a-a4c0-ed8cf6c3ac33", kc_id:"79d29cc6-720d-5f1a-a4c0-ed8cf6c3ac33", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Element Fleet Management and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 584. Evidence excerpt: For more complex industrial marketing channels with global business users, producers will work with agents who partner directly with distributors to move products. For example, the automobile industry relies on agents and distributors to reach business users. According to Global Fleet, the largest fleet vehicle management company in the world, of the 313 million vehicles driven in the United States and Canada, about 9 million are corporate cars.4 Element Fleet Management, based out of Toronto, Ontario, manages corporate vehicle fleets across the United States, Canada, and Mexico. Companies whose operations reach global markets typically rely on a much more complex channel that…", label:"Analyze Element Fleet Management in its marketing context", canonical_key:"analyze_element_fleet_management_in_its_marketin", status:"approved"}}, {concept_id:"3c970405-c717-5461-bfa9-860cd6d2796c", kc_id:"3c970405-c717-5461-bfa9-860cd6d2796c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Emerson Electric and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 56. Evidence excerpt: Emerson Electric, headquartered in St. Louis, Missouri, has five business segments: Network Power, Process Management, Industrial Automation, Climate Technologies, and Commercial and Residential Solutions (i.e., tools and storage). These business segments provide products as diverse as hardware and software technologies; motors; fluid control systems; heating and air-conditioning products and services; and tools, storage products, and appliances for residential, health care, and food services.28 When you consider divisions", label:"Analyze Emerson Electric in its marketing context", canonical_key:"analyze_emerson_electric_in_its_marketing_contex", status:"approved"}}, {concept_id:"65bc60e8-1a27-546b-b6a3-82b6d792c619", kc_id:"65bc60e8-1a27-546b-b6a3-82b6d792c619", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Equal Employment Opportunity Commission (EEOC) and analyze its role in the textbook's treatment of strategic marketing: standardization versus adaptation. Source: printed page 259. Evidence excerpt: After the Civil Rights Act was signed in 1964 and the Equal Employment Opportunity Commission (EEOC) was formed in 1965, P&G proactively launched its own affirmative action plans across all its business units. P&G instituted the changes even before the EEOC was fully functional. That same year, P&G also conducted product research with Hispanic consumers in Miami, focusing on the scent used in its Secret deodorant line. This commitment to diversity in business practices has remained strong through the years.", label:"Analyze Equal Employment Opportunity Commission (EEOC) in its marketing context", canonical_key:"analyze_equal_employment_opportunity_commission_", status:"approved"}}, {concept_id:"6a2ff558-a79e-55de-ae37-70c5d14e38d1", kc_id:"6a2ff558-a79e-55de-ae37-70c5d14e38d1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Equal Justice Initiative (EJI) and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze Equal Justice Initiative (EJI) in its marketing context", canonical_key:"analyze_equal_justice_initiative_eji_in_its_mark", status:"approved"}}, {concept_id:"88fdd8a3-f903-5faa-9270-18eea0a03b5b", kc_id:"88fdd8a3-f903-5faa-9270-18eea0a03b5b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify ESPN and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 12. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/1-in-the-spotlight) In 2020 Gatorade launched an impactful digital strategy. When NBA games were canceled due to the pandemic, ESPN aired a 10-part documentary, “The Last Dance,” about Michael Jordan’s last year with the Chicago Bulls. Because Gatorade wasn’t an official sponsor, it partnered with the NBA to stream 1998’s Game 6 featuring the Jazz versus the Bulls in what would be superstar Jordan’s last game with the Bulls. Gatorade sponsored a “watch party” keyed to the hashtag #Game6Live.5 Review Gatorade’s strategy on Twitter’s Marketing website (https://openstax.org/r/gatoradegame6live), which…", label:"Analyze ESPN in its marketing context", canonical_key:"analyze_espn_in_its_marketing_context", status:"approved"}}, {concept_id:"f95c51bd-a34e-5413-946b-55c9016378da", kc_id:"f95c51bd-a34e-5413-946b-55c9016378da", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ethos and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 326. Evidence excerpt: New brands are an entirely different entity from the parent company. A new brand strategy can be effective if the new product or service is markedly different from the existing offering and benefits from its own branding. For example, the Starbucks brand owns Ethos Water. Ethos is in a beverage category other than Starbucks’s primary offering and retains its name. A new brand strategy works well when the new brand is distinct from the parent brand and has a defined target market and positioning; however, a marketing strategy for a new brand can be expensive to maintain over time.", label:"Analyze Ethos in its marketing context", canonical_key:"analyze_ethos_in_its_marketing_context", status:"approved"}}, {concept_id:"95da69da-0eca-55f8-b8fc-60bbab704a43", kc_id:"95da69da-0eca-55f8-b8fc-60bbab704a43", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Etsy and analyze its role in the textbook's treatment of the global market and advantages of international trade. Source: printed page 228. Evidence excerpt: Many companies have a presence in the global marketplace at some level. Consider a small Etsy shop that sells custom-printed T-shirts. While the T-shirts may be printed in the United States (maybe even in someone’s garage), the T-shirts may be purchased in foreign markets, such as China. While Etsy is a small-scale example, larger companies may have a greater presence in the global marketplace. Consider that Nike, founded in 1964, now sells its products in 170 countries that serve more than 30 major sports and consumer lifestyles.7 While there are considerable risks to entering global markets, there are numerous advantages as well.", label:"Analyze Etsy in its marketing context", canonical_key:"analyze_etsy_in_its_marketing_context", status:"approved"}}, {concept_id:"c66e59f2-5a62-56c8-a451-ee0d71b838eb", kc_id:"c66e59f2-5a62-56c8-a451-ee0d71b838eb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Eyebuydirect and analyze its role in the textbook's treatment of classification of services. Source: printed page 381. Evidence excerpt: Savvy marketers reduce this uncertainty by creating physical “evidence” that allows the consumer to picture the service before it is purchased. For example, a hair salon may have imaging software that predicts how you would look with different hairstyles or colors. Companies like Zenni and Eyebuydirect have a virtual mirror that allows you to “try on eyeglasses” and see how the selected frames look on your face before you purchase.7", label:"Analyze Eyebuydirect in its marketing context", canonical_key:"analyze_eyebuydirect_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"c16112a1-57d8-538f-9ef8-27e02ba7e75e", kc_id:"c16112a1-57d8-538f-9ef8-27e02ba7e75e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Facebook and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 62. Evidence excerpt: Facebook is a great example of a market development strategy. It’s difficult to remember when Facebook wasn’t a household word, but Facebook started out as a small platform that enabled Harvard University students to compare headshots. The popularity of the platform spread to other college campuses, and eventually Facebook allowed nonstudents to join. It looks like the strategy worked—Facebook is now the largest social network in the world, with nearly 3 billion users!45", label:"Analyze Facebook in its marketing context", canonical_key:"analyze_facebook_in_its_marketing_context", status:"approved"}}, {concept_id:"60afd5c4-3800-5447-859d-afe9ee07fda7", kc_id:"60afd5c4-3800-5447-859d-afe9ee07fda7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Family Dollar and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Discount Dollar General, Dollar Tree, Broad range of products with few or no services store Family Dollar", label:"Analyze Family Dollar in its marketing context", canonical_key:"analyze_family_dollar_in_its_marketing_context", status:"approved"}}, {concept_id:"79e35080-a3ab-57dc-8c2b-855710a5222a", kc_id:"79e35080-a3ab-57dc-8c2b-855710a5222a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fanatics and analyze its role in the textbook's treatment of metrics used to evaluate the success of online marketing. Source: printed page 563. Evidence excerpt: For example, let’s look at CPA for a paid search campaign. Fanatics uses paid search to reach customers interested in buying athletic apparel. Let’s assume that Fanatics runs a search campaign for one month that costs the company $20,000. The campaign was responsible for driving over 1 million visits to the website and 32,000 conversions. 32,000 conversions at $20,000 would result in a CPA of $0.63, meaning that each customer conversion cost the company $0.63.", label:"Analyze Fanatics in its marketing context", canonical_key:"analyze_fanatics_in_its_marketing_context", status:"approved"}}, {concept_id:"37916c38-320c-5c3e-8e0c-920929e3e433", kc_id:"37916c38-320c-5c3e-8e0c-920929e3e433", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Farmer Direct Organic and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: Farmer Direct Organic This group of farmers in Canada and the United States banded together to provide better food and better prices. The mission of Farmer Direct Organic is not only to grow better food but to change the way consumers think about food and how they eat. The farmers who participate in the cooperative are focused on quality and transparency. All of their food is 100 percent organic and 100 percent farmer owned.", label:"Analyze Farmer Direct Organic in its marketing context", canonical_key:"analyze_farmer_direct_organic_in_its_marketing_c", status:"approved"}}, {concept_id:"f0ef3797-73d3-508f-9153-9d7fdd74b303", kc_id:"f0ef3797-73d3-508f-9153-9d7fdd74b303", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Federal Communications Commission (FCC) and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 464. Evidence excerpt: • Federal Trade Commission (FTC). The FTC maintains oversight of commercial speech, unfair methods of competition, and deceptive advertising. • Federal Communications Commission (FCC). The FCC regulates broadcast communication and has jurisdiction over the radio, television, and telephone sectors. • Food and Drug Administration (FDA). This organization has authority over labeling, packaging, branding, ingredients lists, and advertising of packaged foods, pharmaceutical products, and cosmetics.", label:"Analyze Federal Communications Commission (FCC) in its marketing context", canonical_key:"analyze_federal_communications_commission_fcc_in", status:"approved"}}, {concept_id:"1659d90e-fe12-5288-90f6-243ba8aa8fed", kc_id:"1659d90e-fe12-5288-90f6-243ba8aa8fed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Federal Food, Drug, and Cosmetic Act (FFDCA) and analyze its role in the textbook's treatment of ethical concerns in advertising and public relations. Source: printed page 495. Evidence excerpt: Have you ever noticed in a prescription drug commercial, there is considerable time spent on the side effects of the medication? Or that at the bottom of the screen there is a disclosure that the actor is not an actual patient? These are all required by the Federal Food, Drug, and Cosmetic Act (FFDCA), the Food and Drug Administration (FDA), and the FTC to adhere to truth in advertising expectations.", label:"Analyze Federal Food, Drug, and Cosmetic Act (FFDCA) in its marketing context", canonical_key:"analyze_federal_food_drug_and_cosmetic_act_ffdca", status:"approved"}}, {concept_id:"6c9b38d6-89c1-5338-8d82-3e3bce924839", kc_id:"6c9b38d6-89c1-5338-8d82-3e3bce924839", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Federal Trade Commission (FTC) and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 146. Evidence excerpt: Price fixing—an agreement among competitors (either written, verbal, or inferred from the parties’ conduct) that affects prices or competitive terms—is prohibited by the Federal Trade Commission (FTC).20 Keep in mind that, despite the term, price fixing isn’t confined to an agreement to set the same price. Companies can also be involved in price fixing if they offer or withhold the same discounts or shipping terms or set a production amount or quota.", label:"Analyze Federal Trade Commission (FTC) in its marketing context", canonical_key:"analyze_federal_trade_commission_ftc_in_its_mark", status:"approved"}}, {concept_id:"d5755e23-e765-5630-96ec-255afd4d8350", kc_id:"d5755e23-e765-5630-96ec-255afd4d8350", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Feeding America and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: In 2021, Subaru celebrated 14 years of its Share the Love event.19 To celebrate this event, it debuted a national ad campaign highlighting the people, places, and pets that have been impacted by its social responsibility. Charities supported by Subaru include the American Society for the Prevention of Cruelty to Animals (ASPCA), Make-A-Wish Foundation, Meals on Wheels America, and the National Park Foundation. In its advertising, Subaru also showcases some of the local charities—selected by Subaru retailers—that benefit from the Subaru Share the Love event, as well as the impact of the automaker’s work with Feeding America to help address food insecurity.20", label:"Analyze Feeding America in its marketing context", canonical_key:"analyze_feeding_america_in_its_marketing_context", status:"approved"}}, {concept_id:"defa8ef0-adee-50e4-b304-3e67c94cb733", kc_id:"defa8ef0-adee-50e4-b304-3e67c94cb733", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fenty and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 99. Evidence excerpt: For more success stories, check out these videos about numerous companies that got it right (https://openstax.org/r/examplesofbrands). Examples include stories from Rihanna’s Fenty beauty line, Adobe’s “When I See Black” ad, Bumble’s “Find Me on Bumble” campaign, and many more!", label:"Analyze Fenty in its marketing context", canonical_key:"analyze_fenty_in_its_marketing_context", status:"approved"}}, {concept_id:"4091b58a-4cc3-5bb6-97a3-495d86f9e9d8", kc_id:"4091b58a-4cc3-5bb6-97a3-495d86f9e9d8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fenty Beauty and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 266. Evidence excerpt: Fenty Beauty Rihanna did more than just lend her name to the brand Fenty Beauty—she also developed products that increased diversity in the beauty business with its 40-shade foundation range and a wide range of sizes, making $100 million in sales the first 40 days! The company has been criticized for use of child labor by some of its suppliers, and has made what its founder described as careless choices during a fashion show. But it remains known for continuing to reflect a more inclusive approach to beauty and clothing products. Read more about Fenty Beauty from this Latana article (https://openstax.org/r/buildbrandawareness) or this article from Newsweek…", label:"Analyze Fenty Beauty in its marketing context", canonical_key:"analyze_fenty_beauty_in_its_marketing_context", status:"approved"}}, {concept_id:"f4c63618-cce2-5f1e-8d41-89e7cd26948a", kc_id:"f4c63618-cce2-5f1e-8d41-89e7cd26948a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fiat and analyze its role in the textbook's treatment of advertising in the promotion mix. Source: printed page 473. Evidence excerpt: In the Spotlight Leo Burnett was a journalist for the Peoria Times in Illinois when he decided to start his own advertising firm with the same name in 1935.1 His strategies were fairly simple: to utilize models who looked like ordinary people instead of Hollywood stars. His motto: “What helps people, helps business.” That strategy paid off big for Philip Morris with the introduction of the iconic—albeit now considered unethical—Marlboro Man. In 1952, the ageless Tony the Tiger cartoon icon for Kellogg’s Frosted Flakes was also born from the Leo Burnett ad agency. Other notable companies that have utilized the Leo Burnett ad agency include Procter & Gamble, McDonald’s, and Fiat,…", label:"Analyze Fiat in its marketing context", canonical_key:"analyze_fiat_in_its_marketing_context", status:"approved"}}, {concept_id:"12913e26-269f-5613-9a55-2cf5773cccc8", kc_id:"12913e26-269f-5613-9a55-2cf5773cccc8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fieldstone Bakery and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 470. Evidence excerpt: Among the company’s brands are Little Debbie, Sunbelt Bakery, Drake’s Cakes, and Fieldstone Bakery. The largest brand is Little Debbie, with a wide range of favorites from Apple Fruit Pies to Zebra Cakes. Little Debbie offers seasonal items in rotation, such as Christmas Tree Cakes. Distribution extends to all 50 states, Mexico, and Canada.", label:"Analyze Fieldstone Bakery in its marketing context", canonical_key:"analyze_fieldstone_bakery_in_its_marketing_conte", status:"approved"}}, {concept_id:"506540d2-8711-5c94-be45-ef5f3c6c291b", kc_id:"506540d2-8711-5c94-be45-ef5f3c6c291b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fingerhut and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Direct mail Tiffany & Co.’s Blue Book, Limited product lines advertised through the mail and catalogs L.L.Bean, Fingerhut", label:"Analyze Fingerhut in its marketing context", canonical_key:"analyze_fingerhut_in_its_marketing_context", status:"approved"}}, {concept_id:"79dd2bdb-6a1d-54c8-a98f-5b8e64f5fb76", kc_id:"79dd2bdb-6a1d-54c8-a98f-5b8e64f5fb76", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify FINN Partners and analyze its role in the textbook's treatment of major influences on b2b buyer behavior. Source: printed page 139. Evidence excerpt: Individual Factors Just as with consumers, B2B buying decisions are influenced by the characteristics of the individuals in the buying center. Consider just one factor: age. FINN Partners compiled its B2B Buyer’s Influence Report and discovered several interesting statistics. Millennials (i.e., those born between 1981 and 1995) are generally the most optimistic about purchase decisions. A whopping 83% are confident that they are paying a reasonable price, and 97% believed that the vendor would deliver as promised. This compares to only single digits for baby boomers (those born between 1946 and 1964).16", label:"Analyze FINN Partners in its marketing context", canonical_key:"analyze_finn_partners_in_its_marketing_context", status:"approved"}}, {concept_id:"a2321934-1e17-5af1-ab76-08fdf2abc5e0", kc_id:"a2321934-1e17-5af1-ab76-08fdf2abc5e0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Food and Drug Administration (FDA) and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 464. Evidence excerpt: • Federal Trade Commission (FTC). The FTC maintains oversight of commercial speech, unfair methods of competition, and deceptive advertising. • Federal Communications Commission (FCC). The FCC regulates broadcast communication and has jurisdiction over the radio, television, and telephone sectors. • Food and Drug Administration (FDA). This organization has authority over labeling, packaging, branding, ingredients lists, and advertising of packaged foods, pharmaceutical products, and cosmetics.", label:"Analyze Food and Drug Administration (FDA) in its marketing context", canonical_key:"analyze_food_and_drug_administration_fda_in_its_", status:"approved"}}, {concept_id:"cdbcb853-e5c2-5418-b739-acc63bf5a5d0", kc_id:"cdbcb853-e5c2-5418-b739-acc63bf5a5d0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Foot Locker and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 586. Evidence excerpt: A multichannel distribution system is where a single company sets up multiple distribution channels to reach customers. For example, Nike has brick-and-mortar stores across major cities. Customers can visit the store, try on shoes and apparel, and make a purchase. In addition to physical stores, Nike also distributes its shoes and apparel through its online store Nike.com, through e-tailers like Amazon.com, and through other brick-and-mortar stores like Kohl’s and Foot Locker.", label:"Analyze Foot Locker in its marketing context", canonical_key:"analyze_foot_locker_in_its_marketing_context", status:"approved"}}, {concept_id:"a81226ea-7da8-5904-8bc8-74feb703684c", kc_id:"a81226ea-7da8-5904-8bc8-74feb703684c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ford and analyze its role in the textbook's treatment of ethical issues in developing a marketing strategy. Source: printed page 81. Evidence excerpt: During the American Industrial Revolution in the early 1900s, the United States saw the rise of iconic business enterprises like Ford, US Steel, J.P. Morgan, Union Pacific Railroad, and many others. Some (a few) gave generously to charitable causes. Others made their wealth using unscrupulous means, exploiting labor and using questionable business practices.", label:"Analyze Ford in its marketing context", canonical_key:"analyze_ford_in_its_marketing_context", status:"approved"}}, {concept_id:"db96e6d6-7e3b-5838-96de-7c3377f61204", kc_id:"db96e6d6-7e3b-5838-96de-7c3377f61204", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ford Motor Company and analyze its role in the textbook's treatment of strategic marketing: standardization versus adaptation. Source: printed page 261. Evidence excerpt: Why do companies consider modifying products when doing so generally entails additional costs? The reason is that adaptations are useful to create unique market offerings, generate interest, or provide a competitive differentiation. In other words, this strategy is advisable when the outcome of the change results in reduced risks to the business. Companies can also adapt an existing product, instead of creating a new one, to reduce costs associated with producing new goods. For example, Ford Motor Company adapts the D4 automobile platform for chassis design and engine configuration to its Ford and Lincoln models to save money and offer cars at competitive price points.", label:"Analyze Ford Motor Company in its marketing context", canonical_key:"analyze_ford_motor_company_in_its_marketing_cont", status:"approved"}}, {concept_id:"ebf9820a-cf5d-5357-9150-af8761c502a8", kc_id:"ebf9820a-cf5d-5357-9150-af8761c502a8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fortune and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 654. Evidence excerpt: Governance structures can be examined to ensure diversity of leadership that aligns with the company’s various interested and influential groups. Fortune and Refinitiv partnered to develop a Measure Up initiative that aims to bring transparency to businesses diversity, equity, and inclusion work of the Fortune 500. The initiative reviewed measures such as policies, employee resource groups, percentage of minorities in board or leadership positions, and salary parity to determine a score for companies. Companies such as Microsoft, Target, and Gap rated highly on the criteria, demonstrating advanced diversity, equity, and inclusion.15 Amazon publishes its representation statistics…", label:"Analyze Fortune in its marketing context", canonical_key:"analyze_fortune_in_its_marketing_context", status:"approved"}}, {concept_id:"2b5c8679-904f-5f8b-b6fd-c223a6a011ec", kc_id:"2b5c8679-904f-5f8b-b6fd-c223a6a011ec", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Frito-Lay and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 47. Evidence excerpt: In the Spotlight Frito-Lay, the producer of Doritos, Lay’s, and Cheetos, is a $13 billion business division of PepsiCo.1 If you’re a snack food fan, you might have noticed how Frito-Lay seems to constantly come up with new flavors for its chips—dill pickle, Chesapeake Bay Crab Spice, Chile Limón, and more. You might picture nutritionists and scientists working in labs, trying recipe after recipe in order to come up with a winner. But Frito-Lay has a unique way of including customers in its strategic decision-making process.2", label:"Analyze Frito-Lay in its marketing context", canonical_key:"analyze_frito_lay_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"68061d54-6da6-58c1-afca-deff47d74910", kc_id:"68061d54-6da6-58c1-afca-deff47d74910", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Fujitsu and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 50. Evidence excerpt: • Volkswagen: “To make this world a mobile, sustainable place with access to all the citizens”7 • Fujitsu: “Understanding you better—serving you best”8", label:"Analyze Fujitsu in its marketing context", canonical_key:"analyze_fujitsu_in_its_marketing_context", status:"approved"}}, {concept_id:"2b83d2e6-280d-5fc1-9635-88583cac6fe2", kc_id:"2b83d2e6-280d-5fc1-9635-88583cac6fe2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gallup Organization and analyze its role in the textbook's treatment of ethical issues in marketing research. Source: printed page 218. Evidence excerpt: The Gallup Organization (https://openstax.org/r/gallup) is a market research firm that specializes in understanding market sentiment (see Figure 6.11). Every year among its numerous polls, Gallup completes an assessment of the honesty and ethical approach of different professions. In the 2021 survey, nursing was the top profession regarding these two measures.26", label:"Analyze Gallup Organization in its marketing context", canonical_key:"analyze_gallup_organization_in_its_marketing_con", status:"approved"}}, {concept_id:"1c7d2764-e56a-5f30-85ea-9836354b833e", kc_id:"1c7d2764-e56a-5f30-85ea-9836354b833e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify GameStop and analyze its role in the textbook's treatment of major decisions in developing an advertising plan. Source: printed page 479. Evidence excerpt: GameStop GameStop is a great example of a company with push and pull strategies. Check out its website for", label:"Analyze GameStop in its marketing context", canonical_key:"analyze_gamestop_in_its_marketing_context", status:"approved"}}, {concept_id:"d1eb9819-57af-5c2b-a244-f7589090c24b", kc_id:"d1eb9819-57af-5c2b-a244-f7589090c24b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gap and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 327. Evidence excerpt: Split loyals are customers who have a consideration set of two to three products or services in the category. The split loyal is willing to buy this select set of brands on any occasion without hard-core loyalty to any in the group. However, brands can convert split loyals into hard-core loyals with product/service consistency, loyalty programs, and marketing efforts. For example, customers may have loyalty to Gap, Banana Republic, and J.Crew for workwear.", label:"Analyze Gap in its marketing context", canonical_key:"analyze_gap_in_its_marketing_context", status:"approved"}}, {concept_id:"4c7d6cda-5e05-51da-9be9-a36660fdde2f", kc_id:"4c7d6cda-5e05-51da-9be9-a36660fdde2f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gartner and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 445. Evidence excerpt: According to a 2020 chief marketing officer (CMO) survey from Gartner, two-thirds of promotional budgets are being spent on digital.15 Because of the tremendous analytics available, marketers are able to assess the effectiveness immediately. Messages can be tested for effectiveness and quickly changed if they are not producing results. It is very difficult to get the same quick feedback with any of the other forms of promotion. Through careful tracking and robust customer relationship management (CRM) systems, marketers are quickly able to promote products, increase brand awareness, and move consumers down the sales funnel to instantly purchase through online e-commerce sites.", label:"Analyze Gartner in its marketing context", canonical_key:"analyze_gartner_in_its_marketing_context", status:"approved"}}, {concept_id:"5f536fae-7ca8-5e50-baba-810c071b2947", kc_id:"5f536fae-7ca8-5e50-baba-810c071b2947", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gatorade and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 11. Evidence excerpt: First, let’s consider its approach to the product itself. Gatorade managers saw the exercise boom coming as baby boomers began to age and wanted to be the performance and thirst quencher for everyone from kids to pros. The product, which was intended to replace electrolytes lost in sweat, was scientifically formulated first at the University of Florida and later at the Gatorade Sports Science Institute. But Gatorade didn’t rest on its laurels when it comes to product innovation. For example, in order to lure back “lapsed” consumers with concerns over sugar, it launched Gatorade Zero, a thirst quencher without sugar. It also launched its G Series Performance, a new line of food…", label:"Analyze Gatorade in its marketing context", canonical_key:"analyze_gatorade_in_its_marketing_context", status:"approved"}}, {concept_id:"a10dcdd7-f246-540f-a273-72da57f53572", kc_id:"a10dcdd7-f246-540f-a273-72da57f53572", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gatorade Sports Science Institute and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 11. Evidence excerpt: First, let’s consider its approach to the product itself. Gatorade managers saw the exercise boom coming as baby boomers began to age and wanted to be the performance and thirst quencher for everyone from kids to pros. The product, which was intended to replace electrolytes lost in sweat, was scientifically formulated first at the University of Florida and later at the Gatorade Sports Science Institute. But Gatorade didn’t rest on its laurels when it comes to product innovation. For example, in order to lure back “lapsed” consumers with concerns over sugar, it launched Gatorade Zero, a thirst quencher without sugar. It also launched its G Series Performance, a new line of food…", label:"Analyze Gatorade Sports Science Institute in its marketing context", canonical_key:"analyze_gatorade_sports_science_institute_in_its", status:"approved"}}, {concept_id:"033c6e31-3bbd-58d6-86c3-016ff5457aa9", kc_id:"033c6e31-3bbd-58d6-86c3-016ff5457aa9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gazelle Bikes and analyze its role in the textbook's treatment of the five critical cs of pricing. Source: printed page 413. Evidence excerpt: Competition Every company and product faces competition. Even the most unique products are competing for buyer dollars. Buyers’ perception of one product in comparison to that of alternatives has an important impact on pricing decisions. Gazelle Bikes is a top-tier manufacturer of bicycles. The bikes offered by Gazelle have a starting price point of $1,499.16 One of Gazelle’s competitors, Giant, has a starting price point of $1,720.17 For bicycle enthusiasts, these price points are important when comparing one brand with another; an enthusiast who comes across a new brand of bicycles with a starting price of just $200 would not position it with Gazelle and Giant bicycles.", label:"Analyze Gazelle Bikes in its marketing context", canonical_key:"analyze_gazelle_bikes_in_its_marketing_context", status:"approved"}}, {concept_id:"2f80d1d3-4d68-5f36-923c-5c09dc18aa6b", kc_id:"2f80d1d3-4d68-5f36-923c-5c09dc18aa6b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Geico and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 577. Evidence excerpt: An agent or broker is someone who acts as an extension to the manufacturer. While they never take possession of the product or service they represent, they earn a commission or collect a fee for facilitating the transaction between the customer and the manufacturer. Auto insurance agents, for example, may sell Geico or Allstate auto insurance policies to consumers. The agent serves as a representative who answers questions, gathers information, and provides a quote on behalf of the insurance company.", label:"Analyze Geico in its marketing context", canonical_key:"analyze_geico_in_its_marketing_context", status:"approved"}}, {concept_id:"51ee7fbc-857b-5ab3-bd67-711fc58d7fd3", kc_id:"51ee7fbc-857b-5ab3-bd67-711fc58d7fd3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Genentech and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 50. Evidence excerpt: • eBay: “To be the world’s favorite destination for discovering great value and unique selection”14 • Genentech: “To develop drugs to address significant unmet medical needs”15", label:"Analyze Genentech in its marketing context", canonical_key:"analyze_genentech_in_its_marketing_context", status:"approved"}}, {concept_id:"0d6ae7fc-5879-5734-96fb-c8434cc55a5d", kc_id:"0d6ae7fc-5879-5734-96fb-c8434cc55a5d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify General Electric and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 55. Evidence excerpt: Business Portfolio Definition As noted above, many businesses have a single product or business unit. However, larger organizations such as Apple, Alphabet, General Electric, Meta, and Microsoft often have multiple diverse business units called strategic business units. Despite the fact that these SBUs report directly to the parent company’s headquarters, they typically develop their own vision statements, mission statements, objectives, and goals, and the strategic planning for these SBUs is performed separately and apart from other SBUs within the organization.25 When companies have multiple products or business units, these comprise the business", label:"Analyze General Electric in its marketing context", canonical_key:"analyze_general_electric_in_its_marketing_contex", status:"approved"}}, {concept_id:"d28b42fe-2fc7-5388-955d-f09e2624a46d", kc_id:"d28b42fe-2fc7-5388-955d-f09e2624a46d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Generation Alpha and analyze its role in the textbook's treatment of marketing to sociodemographic groups. Source: printed page 289. Evidence excerpt: You read earlier in the chapter about these categories: Silent Generation, baby boomers, Generation X, millennials, Generation Z, and Generation Alpha. Figure 8.20 shows these generations based on their percentage among the American population. Think about this. A member of Generation Alpha (people born between 2010 and 2025) is born every nine seconds in the United States. This generation is expected to account for 2 billion individuals worldwide by 2025!66 Grouping consumers into generational segments helps maximize marketing efforts and reach a larger portion of the total market.", label:"Analyze Generation Alpha in its marketing context", canonical_key:"analyze_generation_alpha_in_its_marketing_contex", status:"approved"}}, {concept_id:"c722e2ba-d470-5ae0-be95-30649d1ebded", kc_id:"c722e2ba-d470-5ae0-be95-30649d1ebded", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Generation X and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 102. Evidence excerpt: power,7 so you can imagine its impact on the consumer market. What types of products would you expect baby boomers to buy? Key categories for this group of buyers include pharmacy and health care products, household goods and appliances, wine, books (both digital and physical), cosmetics, and skin care products.8 • Generation X (born between 1965 and 1979/80) are currently in their 40s and 50s. This cohort is approximately 65 million strong9 and generally has more spending power than younger generational cohorts because they’re at or reaching the peak of their careers, and many Gen Xers are dual-income families.10 This makes them an optimal target for higher-end brands and…", label:"Analyze Generation X in its marketing context", canonical_key:"analyze_generation_x_in_its_marketing_context", status:"approved"}}, {concept_id:"9e3cd342-9264-5825-9c45-8670012fba69", kc_id:"9e3cd342-9264-5825-9c45-8670012fba69", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Generation Y and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 102. Evidence excerpt: power,7 so you can imagine its impact on the consumer market. What types of products would you expect baby boomers to buy? Key categories for this group of buyers include pharmacy and health care products, household goods and appliances, wine, books (both digital and physical), cosmetics, and skin care products.8 • Generation X (born between 1965 and 1979/80) are currently in their 40s and 50s. This cohort is approximately 65 million strong9 and generally has more spending power than younger generational cohorts because they’re at or reaching the peak of their careers, and many Gen Xers are dual-income families.10 This makes them an optimal target for higher-end brands and…", label:"Analyze Generation Y in its marketing context", canonical_key:"analyze_generation_y_in_its_marketing_context", status:"approved"}}, {concept_id:"8974cef4-0da0-5378-81b6-1c38bf526e9e", kc_id:"8974cef4-0da0-5378-81b6-1c38bf526e9e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Generation Z and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 102. Evidence excerpt: power,7 so you can imagine its impact on the consumer market. What types of products would you expect baby boomers to buy? Key categories for this group of buyers include pharmacy and health care products, household goods and appliances, wine, books (both digital and physical), cosmetics, and skin care products.8 • Generation X (born between 1965 and 1979/80) are currently in their 40s and 50s. This cohort is approximately 65 million strong9 and generally has more spending power than younger generational cohorts because they’re at or reaching the peak of their careers, and many Gen Xers are dual-income families.10 This makes them an optimal target for higher-end brands and…", label:"Analyze Generation Z in its marketing context", canonical_key:"analyze_generation_z_in_its_marketing_context", status:"approved"}}, {concept_id:"d7cc9fd6-997a-5e9c-8b88-d528c20ae451", kc_id:"d7cc9fd6-997a-5e9c-8b88-d528c20ae451", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gexpro and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 25. Evidence excerpt: • Suppliers. Suppliers (sometimes also called vendors) are those partners from whom we receive the parts and products necessary for our business. Let’s assume that your company produces microwave ovens. Some of your suppliers may be providers of transformers, the turntable, control panels, magnetrons, etc. As long as you have options in terms of the component suppliers, the bargaining power of each supplier is relatively weak. However, if two suppliers merge and decide to raise the price of the component the new entity supplies, that vendor now wields increased power. • Market Intermediaries. Often, products are distributed by third-party sellers such as retailers, wholesalers,…", label:"Analyze Gexpro in its marketing context", canonical_key:"analyze_gexpro_in_its_marketing_context", status:"approved"}}, {concept_id:"9f9abd16-3246-5fc7-9de5-189b2b8d90aa", kc_id:"9f9abd16-3246-5fc7-9de5-189b2b8d90aa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ghirardelli and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze Ghirardelli in its marketing context", canonical_key:"analyze_ghirardelli_in_its_marketing_context", status:"approved"}}, {concept_id:"1e5f78d9-edeb-51b5-a3af-ace064cea6d8", kc_id:"1e5f78d9-edeb-51b5-a3af-ace064cea6d8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Giant and analyze its role in the textbook's treatment of the five critical cs of pricing. Source: printed page 413. Evidence excerpt: Competition Every company and product faces competition. Even the most unique products are competing for buyer dollars. Buyers’ perception of one product in comparison to that of alternatives has an important impact on pricing decisions. Gazelle Bikes is a top-tier manufacturer of bicycles. The bikes offered by Gazelle have a starting price point of $1,499.16 One of Gazelle’s competitors, Giant, has a starting price point of $1,720.17 For bicycle enthusiasts, these price points are important when comparing one brand with another; an enthusiast who comes across a new brand of bicycles with a starting price of just $200 would not position it with Gazelle and Giant bicycles.", label:"Analyze Giant in its marketing context", canonical_key:"analyze_giant_in_its_marketing_context", status:"approved"}}, {concept_id:"f9c95e5a-53db-579f-b33a-a9d92d591e92", kc_id:"f9c95e5a-53db-579f-b33a-a9d92d591e92", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gillette and analyze its role in the textbook's treatment of stages of the new product development process. Source: printed page 351. Evidence excerpt: The prototype is then put through functional and customer tests to see how well it perform. For example, at carpet manufacturer Shaw Industries, temporary employees are paid to walk on carpet samples for eight hours a day to see how the carpet holds up.20 At Gillette, volunteers come to work unshaven so they can use certain razors, shaving cream, or aftershave and complete questionnaires. (The “motto” of this group is “We bleed so you’ll get a good shave at home.”)21", label:"Analyze Gillette in its marketing context", canonical_key:"analyze_gillette_in_its_marketing_context", status:"approved"}}, {concept_id:"64511396-b5bd-5147-9727-3ce55e3f9d0a", kc_id:"64511396-b5bd-5147-9727-3ce55e3f9d0a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Girl Scouts of the USA and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 544. Evidence excerpt: Every year, MailCon brings together marketing professionals, brands, and agencies to discuss the latest trends in email technology, strategy, and automation. Major brands like Wayfair, Girl Scouts of the USA, Ford Motor Company, and A&E Networks gather to network and learn about advancements in the email marketing space.6", label:"Analyze Girl Scouts of the USA in its marketing context", canonical_key:"analyze_girl_scouts_of_the_usa_in_its_marketing_", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"d57ae29d-d2c9-5e8d-bc8a-4377c31469c6", kc_id:"d57ae29d-d2c9-5e8d-bc8a-4377c31469c6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Glassdoor and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 549. Evidence excerpt: Digital Marketer Digital marketers build and implement a company’s online-related activities and sales. Review this job description (https://openstax.org/r/jobdescriptionsdigitalmarketing) and list of qualifications from Glassdoor for more details. There are several additional resources that will help you better understand the digital marketing job role and what it will take to get a job in this field:", label:"Analyze Glassdoor in its marketing context", canonical_key:"analyze_glassdoor_in_its_marketing_context", status:"approved"}}, {concept_id:"4b8bcfe6-58ef-58dd-b74e-04c45ce21560", kc_id:"4b8bcfe6-58ef-58dd-b74e-04c45ce21560", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Global Containers and Custom Packaging and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 609. Evidence excerpt: Managing all of the pieces of a logistics solution can be tricky, especially in an environment with unprecedented shipping delays. Global Containers and Custom Packaging takes a proactive approach in managing its clients’ business—it will advise customers on upcoming delays on products that it doesn’t currently have in inventory. By staying in constant contact with the client, it has been able to keep delays and bottlenecks because of missing items to a minimum. All this is accomplished while the industry has seen shipping delays skyrocket.", label:"Analyze Global Containers and Custom Packaging in its marketing context", canonical_key:"analyze_global_containers_and_custom_packaging_i", status:"approved"}}, {concept_id:"c9399991-64bb-5c8c-8ae4-7bdb871a42cd", kc_id:"c9399991-64bb-5c8c-8ae4-7bdb871a42cd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Global Fleet and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 584. Evidence excerpt: For more complex industrial marketing channels with global business users, producers will work with agents who partner directly with distributors to move products. For example, the automobile industry relies on agents and distributors to reach business users. According to Global Fleet, the largest fleet vehicle management company in the world, of the 313 million vehicles driven in the United States and Canada, about 9 million are corporate cars.4 Element Fleet Management, based out of Toronto, Ontario, manages corporate vehicle fleets across the United States, Canada, and Mexico. Companies whose operations reach global markets typically rely on a much more complex channel that…", label:"Analyze Global Fleet in its marketing context", canonical_key:"analyze_global_fleet_in_its_marketing_context", status:"approved"}}, {concept_id:"95f4f386-5e6a-5c6e-afc9-b32cdaefaa1a", kc_id:"95f4f386-5e6a-5c6e-afc9-b32cdaefaa1a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify GM and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 179. Evidence excerpt: This type of market targeting is one of the most common. A company identifies several target markets and designs separate, concentrated strategies for each. Separate brands are developed to serve each of the segments. Consider Nike, for example, which (like most apparel companies) offers different products for different segments. When Nike began its business, the founders were both competitive distance runners, so they targeted people like themselves as a segment of the running shoe market and the brand took off. However, in order to grow the business, Nike now focuses on three segments—women, young athletes, and runners.56", label:"Analyze GM in its marketing context", canonical_key:"analyze_gm_in_its_marketing_context", status:"approved"}}, {concept_id:"6a504bb9-02df-59cd-b5ce-40d5cbb47e7d", kc_id:"6a504bb9-02df-59cd-b5ce-40d5cbb47e7d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Godiva and analyze its role in the textbook's treatment of product items, product lines, and product mixes. Source: printed page 315. Evidence excerpt: 1. Stretching Downward. A brand introduces a product line that is less expensive than its current offering. This may open a new target market or change a brand’s positioning in a competitive market. However, it is essential to consider whether stretching down might shift the brand’s perception or take share from other product lines. Tesla introduced its Model 3 following its more expensive Model S, following the stretching downward strategy.4 2. Stretching Upward. A brand introduces a product line that is more expensive than its current offering. This may increase profitability or reposition the brand. First, however, it is essential to determine whether the brand has equity in…", label:"Analyze Godiva in its marketing context", canonical_key:"analyze_godiva_in_its_marketing_context", status:"approved"}}, {concept_id:"19cb32e4-f65d-57de-91db-16c747806196", kc_id:"19cb32e4-f65d-57de-91db-16c747806196", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Google and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 297. Evidence excerpt: Culturally Sensitive and Socially Inclusive Marketing Multinational industry leaders like Coca-Cola, Google, Adidas, Unilever, AT&T, Marriott International, and Microsoft are just a few of the companies that, like P&G, are focusing their marketing efforts on being more culturally sensitive and socially inclusive. Even niche players, partnerships, and private companies such as Bumble, Fenty Beauty, and ThirdLove are also championing diversity as a core value through equal cultural and sociodemographic representation rather than just chasing a trend in marketing.72", label:"Analyze Google in its marketing context", canonical_key:"analyze_google_in_its_marketing_context", status:"approved"}}, {concept_id:"b58becec-6f9e-5ee0-a9d2-3262efc6a1a3", kc_id:"b58becec-6f9e-5ee0-a9d2-3262efc6a1a3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Google Play Store and analyze its role in the textbook's treatment of recent trends in retailing. Source: printed page 634. Evidence excerpt: If you are familiar with the Apple Store or the Google Play Store, you’ve likely used digital wallets. When you purchase online on one of these devices, an automated display will come up asking if you would like to save your log-in and payment information. Once saved, each time you log in to the same website or begin to make a purchase, the digital wallet will auto-fill your information. While digital wallets are a huge time-saver for consumers, they also benefit retailers by capturing a sale that might have been lost due to inconvenience.", label:"Analyze Google Play Store in its marketing context", canonical_key:"analyze_google_play_store_in_its_marketing_conte", status:"approved"}}, {concept_id:"e851347c-2cc6-5e10-8d09-961d245b32f2", kc_id:"e851347c-2cc6-5e10-8d09-961d245b32f2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Google Trends and analyze its role in the textbook's treatment of metrics used to evaluate the success of online marketing. Source: printed page 561. Evidence excerpt: Search trends are data points that indicate how frequently a term is searched. Researching search trends provides insight into who a company’s customers are and what they are currently interested in. Google Trends is a free tool that online marketers can use to gather this information. Monitoring search trends has some predictive benefits to online marketers, who can recommend changes to products, advertising, and budgeting based on what consumers are searching for. For example, marketers utilize keyword tools offered by companies like Semrush to gain insights into customer search activity. Semrush provides customers with information on the value of popular search terms.", label:"Analyze Google Trends in its marketing context", canonical_key:"analyze_google_trends_in_its_marketing_context", status:"approved"}}, {concept_id:"0f03da1a-f722-5590-8778-ee0fd15b3bdc", kc_id:"0f03da1a-f722-5590-8778-ee0fd15b3bdc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify GoPro and analyze its role in the textbook's treatment of products, services, and experiences. Source: printed page 307. Evidence excerpt: But Peloton sees itself as a technology company that facilitates service. Peloton CEO John Foley has said that “we see ourself more akin to an Apple, a Tesla, or a Nest or a GoPro—where it’s a consumer product that has a foundation of sexy hardware technology and sexy software technology.”2 In the case of Peloton, that sexy software technology comes in the form of streaming workout classes including cycling, strength, boot camp, yoga, and meditation taught by charismatic instructors who have become social media influencers. The price tag for Peloton customers is a recurring $39 monthly fee for all access on top of the cost of the product.", label:"Analyze GoPro in its marketing context", canonical_key:"analyze_gopro_in_its_marketing_context", status:"approved"}}, {concept_id:"032eb53d-20d2-55fd-942e-5209be0a389c", kc_id:"032eb53d-20d2-55fd-942e-5209be0a389c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify GoToMeeting and analyze its role in the textbook's treatment of the five-step procedure for establishing pricing policy. Source: printed page 416. Evidence excerpt: customers. Before Jim Semick and his team launched GoToMeeting, a conferencing app, they developed the pricing of $49 “all you can meet flat-rate pricing.” This pricing was unique to the industry, and Semick stated that they determined this pricing structure based on dozens of interviews with potential customers. From these interviews, the GoToMeeting team discovered key areas that would provide value to customers not only through the product itself, but also through the flat-rate price structure that was easy to understand.20 Semick utilized the customer value–based objective, one in which the company has a good understanding of the value-added benefits of a product and sets its…", label:"Analyze GoToMeeting in its marketing context", canonical_key:"analyze_gotomeeting_in_its_marketing_context", status:"approved"}}, {concept_id:"3e77c827-d019-58dc-8e56-4da4a3122eeb", kc_id:"3e77c827-d019-58dc-8e56-4da4a3122eeb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify GQ and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 158. Evidence excerpt: With gender segmentation, the market is divided into men and women. Those who identify as men and those who identify as women have different interests in terms of shopping for various products like apparel, shoes, and food. For example, look at the ad campaigns crafted toward women in fashion magazines such as Vogue or Vanity Fair. You’ll likely see a different ad focus in magazines like GQ or Men’s Health.", label:"Analyze GQ in its marketing context", canonical_key:"analyze_gq_in_its_marketing_context", status:"approved"}}, {concept_id:"2fdbbdc5-e55d-5d68-8ee6-440019a2e0a4", kc_id:"2fdbbdc5-e55d-5d68-8ee6-440019a2e0a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Grassroot Good and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: TOMS shoes has long been a leader in cause marketing (see Figure 13.5). When you buy from TOMS, one-third of the profits go to Grassroot Good.10 TOMS’ annual report highlights the people the company helps and how it helps them. Investors and any interested parties receive the annual report that details the work TOMS does right along with the profits it is making.", label:"Analyze Grassroot Good in its marketing context", canonical_key:"analyze_grassroot_good_in_its_marketing_context", status:"approved"}}, {concept_id:"13c80340-2faa-5582-b477-f7bab96806d6", kc_id:"13c80340-2faa-5582-b477-f7bab96806d6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify GS1 Global Traceability Standard and analyze its role in the textbook's treatment of recent trends in wholesaling. Source: printed page 640. Evidence excerpt: Traceability Standards The GS1 Global Traceability Standard defines what is minimally acceptable for full supply chain traceability. It establishes a full system that traces products end to end. Read more about the standards and see how it’s applied (https://openstax.org/r/howtraceability) to food.", label:"Analyze GS1 Global Traceability Standard in its marketing context", canonical_key:"analyze_gs1_global_traceability_standard_in_its_", status:"approved"}}, {concept_id:"98d7723b-6346-5400-a48a-aa87338dc0e5", kc_id:"98d7723b-6346-5400-a48a-aa87338dc0e5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Gucci and analyze its role in the textbook's treatment of the global market and advantages of international trade. Source: printed page 230. Evidence excerpt: Two examples of companies not readily prepared come from Nivea and Gucci. In 2017, Nivea launched a social media campaigned stating “White Is Purity.” The phrase was perceived by the public as being racially insensitive. To make matters worse, the slogan was then used by white supremacists in their propaganda.17 While the company apologized and removed the campaign, these marketers should never have let the campaign leave the idea room. In 2019, luxury fashion designer Gucci introduced a balaclava knit jumper that had material that went up and around the mouth. The advertisement for this clothing featured a White woman modeling the sweater with bright red lipstick. Many critics…", label:"Analyze Gucci in its marketing context", canonical_key:"analyze_gucci_in_its_marketing_context", status:"approved"}}, {concept_id:"a359c806-cdb4-5897-a75f-1228f7f56c0e", kc_id:"a359c806-cdb4-5897-a75f-1228f7f56c0e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify GWI and analyze its role in the textbook's treatment of the consumer purchasing decision process. Source: printed page 114. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/3-3-the-consumer- purchasing-decision-process) GWI, a company that researches global consumer thinking, published its 2022 consumer trends report (https://openstax.org/r/connectingthedots), which showed that consumers’ needs and priorities have shifted. Read the report and see if you find the same results for yourself. Have your priorities and needs changed since the pandemic hit? What are the other factors influencing your needs assessment?", label:"Analyze GWI in its marketing context", canonical_key:"analyze_gwi_in_its_marketing_context", status:"approved"}}, {concept_id:"25961016-b4ee-516e-83a4-9520bb0a2257", kc_id:"25961016-b4ee-516e-83a4-9520bb0a2257", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hallmark and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 577. Evidence excerpt: The fourth type of intermediary is the retailer. Retailers also take ownership of the product, and their sole focus is on reaching the end user or customer directly. They purchase a wide variety of products in smaller amounts that meet the wants and needs of consumers. Retailers include companies like Rite Aid, Walmart, Target, and Hallmark.", label:"Analyze Hallmark in its marketing context", canonical_key:"analyze_hallmark_in_its_marketing_context", status:"approved"}}, {concept_id:"d692d0de-ac87-53a6-85e1-9713c468b09e", kc_id:"d692d0de-ac87-53a6-85e1-9713c468b09e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hanes Outlet and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Sawgrass Mills Factory Outlet, Overstock or over-manufactured brand-name items, Indiana Premium Outlets, Factory outlet usually clothing; typically in a mall setting with other Osage Outlets; Hanes Outlet, factory outlets L.L.Bean Outlet", label:"Analyze Hanes Outlet in its marketing context", canonical_key:"analyze_hanes_outlet_in_its_marketing_context", status:"approved"}}, {concept_id:"dfdd78b2-8a78-5ac1-a55f-c8650884cd3b", kc_id:"dfdd78b2-8a78-5ac1-a55f-c8650884cd3b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Harappa Education and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 555. Evidence excerpt: eLearning company Harappa Education produces the Habits Matter podcast, which focuses on topics about learning and personal growth. Listeners are attracted to the series because they want to learn something new without the noise of a marketing message. Podcasts are effective at creating value, building relationships, and engaging target audiences in a subtle way.", label:"Analyze Harappa Education in its marketing context", canonical_key:"analyze_harappa_education_in_its_marketing_conte", status:"approved"}}, {concept_id:"4614f54d-c52f-5dec-b31c-cc8c0652418d", kc_id:"4614f54d-c52f-5dec-b31c-cc8c0652418d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Harley-Davidson and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 62. Evidence excerpt: To help you better understand these strategies, let’s consider each one from the perspective of one company—Harley-Davidson. If Harley-Davidson were to adopt a market penetration strategy, the company would focus on selling more Harley-Davidson motorcycles in the US market. If the company were to adopt a product development strategy, it would begin selling a new product such as biker clothing for children under the Harley-Davidson brand in the US market. Harley-Davidson is currently pursuing a market development strategy, with plans to develop a new motorcycle to manufacture and sell in China. Harley-Davidson’s diversification strategy might entail selling new products like…", label:"Analyze Harley-Davidson in its marketing context", canonical_key:"analyze_harley_davidson_in_its_marketing_context", status:"approved"}}, {concept_id:"14dd4fe4-ff0a-585f-834b-4f32edeec58d", kc_id:"14dd4fe4-ff0a-585f-834b-4f32edeec58d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Harlow and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Harlow in its marketing context", canonical_key:"analyze_harlow_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"84dd7da7-e04e-5448-9902-b5b4927245f6", kc_id:"84dd7da7-e04e-5448-9902-b5b4927245f6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Harper Collins and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 62. Evidence excerpt: The concept of concentric diversification revolves around the addition of similar products or services to an existing business.48 If a picture is worth a thousand words, then an example has to be worth even more, particularly an example to which you can easily relate as a student. As you’re reading this chapter, consider book publishers, like Harper Collins, Simon & Schuster, or Penguin/Random House. These book publishers don’t only print the works of one author; rather, they have hundreds or perhaps thousands of authors’ works in their arsenals. These publishers will publish print books, e-books (like the one you’re reading right now), and audiobooks and may even sell the rights…", label:"Analyze Harper Collins in its marketing context", canonical_key:"analyze_harper_collins_in_its_marketing_context", status:"approved"}}, {concept_id:"1ef73c8e-7eab-5351-9280-e031852a56fc", kc_id:"1ef73c8e-7eab-5351-9280-e031852a56fc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Harvard Business Review and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 541. Evidence excerpt: According to a 2020 article published in Harvard Business Review, catalogs are making a comeback. Consumers report being excited to receive a catalog. In fact, response rates for catalogs have jumped 170", label:"Analyze Harvard Business Review in its marketing context", canonical_key:"analyze_harvard_business_review_in_its_marketing", status:"approved"}}, {concept_id:"3232c6a0-79c3-5fef-ac4b-e73bbe0c0f2d", kc_id:"3232c6a0-79c3-5fef-ac4b-e73bbe0c0f2d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify HBO and analyze its role in the textbook's treatment of major decisions in developing an advertising plan. Source: printed page 501. Evidence excerpt: Per HBO Max, the Sex and the City revival starring Sarah Jessica Parker, Cynthia Nixon and Kristin Davis had a strong 24-hour performance that ranks as the most viewed series premiere of a new HBO or HBO Max series on the streaming service. Overall, the AJLT opener ranks in the Top 10 of all HBO Max’s movies and series debuts, including both HBO and Max originals, trailing just some of the tentpole Warner Bros. movies that launched on the platform.38", label:"Analyze HBO in its marketing context", canonical_key:"analyze_hbo_in_its_marketing_context", status:"approved"}}, {concept_id:"c9b715ea-0a82-5186-a2a6-680685434906", kc_id:"c9b715ea-0a82-5186-a2a6-680685434906", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify HBOMax and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 576. Evidence excerpt: The film industry provides a great example of the distribution decisions that marketers must make. Before a production company releases a new movie, it must decide which channels are best for distributing the movie to consumers. In today’s market, movie producers have a slew of distribution options, including Netflix, HBOMax, and YouTube, to name a few. They also have the option of distributing through traditional movie theaters, such as AMC or Regal. Regardless of the marketing channel they pursue, their goal is to distribute their movie to the right customers at the right place and at the right time. Production companies will choose the marketing channel that is most efficient…", label:"Analyze HBOMax in its marketing context", canonical_key:"analyze_hbomax_in_its_marketing_context", status:"approved"}}, {concept_id:"3e19f823-44af-56d9-bd5d-e3b76f480388", kc_id:"3e19f823-44af-56d9-bd5d-e3b76f480388", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Heat and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 265. Evidence excerpt: Another report confirmed that these observations are not restricted to specific populations. Market analysis by Heat agency found that high diversity scores for brands translated into a whopping 83 percent higher preference by consumers.9 Besides improving brand sentiment overall, studies show that companies that build emotional ties through diversity marketing programs generate more revenue, increase stock price performance, and enhance brand perceptions.10", label:"Analyze Heat in its marketing context", canonical_key:"analyze_heat_in_its_marketing_context", status:"approved"}}, {concept_id:"a6f1db29-afcb-58f1-abed-1f738e7bc2ba", kc_id:"a6f1db29-afcb-58f1-abed-1f738e7bc2ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Heinz and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: National brands are the name brands that sell a product or service under its corporate name and identity. Brands like Heinz, Smartwater, and Morton’s Salt are examples of name brands. Brand equity commands higher prices, so national brands typically charge higher prices than their private brand counterparts. National brands often pay for premium retail space, making them a convenient choice for shoppers. However, price- sensitive shoppers may be turned off by the higher prices of national brands.", label:"Analyze Heinz in its marketing context", canonical_key:"analyze_heinz_in_its_marketing_context", status:"approved"}}, {concept_id:"35853df7-8658-5b08-8b5e-727f438fabfe", kc_id:"35853df7-8658-5b08-8b5e-727f438fabfe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hellman’s and analyze its role in the textbook's treatment of pricing strategies and tactics for existing products. Source: printed page 425. Evidence excerpt: Many large companies offer multiple products and product lines in their product mix. One strategy for pricing products is to price products in a product line the same or similar. For example, Unilever is the manufacturer of many brands that you’ve likely heard of: Dove, Axe, and Hellman’s to name a few. Within its host of products, Unilever has divided its products into price categories; higher priced items have a higher perception of value and so on. (Recall that a product line is a group of related products differentiated by features and price.) Unilever sets a higher price for some of its product lines and lower price points for others in order to capture various target…", label:"Analyze Hellman’s in its marketing context", canonical_key:"analyze_hellman_s_in_its_marketing_context", status:"approved"}}, {concept_id:"71722f7a-86e7-5666-8ff0-2a72499ee28b", kc_id:"71722f7a-86e7-5666-8ff0-2a72499ee28b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify HelloFresh and analyze its role in the textbook's treatment of determining consumer needs and wants. Source: printed page 31. Evidence excerpt: • Bill Ragan Roofing: “Let us take the stress of roof repairs or a roof replacement off your shoulders.”41 • Applied Educational Systems (AES): “Spend your time connecting with students, not planning and grading”42 • DuckDuckGo: “Tired of being tracked online? We can help.”43 • HelloFresh: “Take the stress out of mealtime.”44", label:"Analyze HelloFresh in its marketing context", canonical_key:"analyze_hellofresh_in_its_marketing_context", status:"approved"}}, {concept_id:"d7499332-559d-56c1-9cc2-d0e9caa805b8", kc_id:"d7499332-559d-56c1-9cc2-d0e9caa805b8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hertz and analyze its role in the textbook's treatment of product positioning. Source: printed page 182. Evidence excerpt: A classic example is when Avis (the car rental company) launched an advertising campaign that went head-to- head with Hertz, the market leader. Avis made a point of comparing itself to Hertz and made its position in the market a selling point using the slogan “When you’re only No. 2, you try harder. Or else.” This campaign positioned Avis as a direct competitor of Hertz and also did something unique: it highlighted its underdog status, turning it from a liability into an asset. The results? Prior to the ads, Avis was losing $3.2 million a year; after the ads, Avis improved its performance and earned $1.2 million. Remarkably, that was the first time in over a decade that Avis had…", label:"Analyze Hertz in its marketing context", canonical_key:"analyze_hertz_in_its_marketing_context", status:"approved"}}, {concept_id:"19145130-a0d4-509f-8391-743d67211249", kc_id:"19145130-a0d4-509f-8391-743d67211249", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hewlett Packard and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 609. Evidence excerpt: Strategically headquartered along the US-Mexico border in El Paso, Texas, Global Containers and Custom Packaging offers local packaging distribution services that provide value and solutions to the retail and maquiladora market. Customers include companies like Amazon.com, Hewlett Packard, Honeywell, Align Technology (the makers of Invisalign system for straightening teeth), and ASO (a leader in consumer first-aid products).", label:"Analyze Hewlett Packard in its marketing context", canonical_key:"analyze_hewlett_packard_in_its_marketing_context", status:"approved"}}, {concept_id:"740b5dff-5948-5a89-9ed2-dc55882d5f2a", kc_id:"740b5dff-5948-5a89-9ed2-dc55882d5f2a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hewlett Packard Enterprise (HPE) and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 26. Evidence excerpt: California to Texas, following similar announcements by Hewlett Packard Enterprise (HPE) and Oracle, citing such things as lower housing costs and tax rates and fewer regulations, making it easier for companies to operate in Texas. • Economic Factors. Economic factors play a huge role in terms of a company’s prospects in a market. For example, economic factors affect pricing and can even influence the supply/demand curve for a product or service. For example, high inflation causes consumers to have less spending power, which translates into lower sales and revenue. In 2022, consumers experienced both product shortages and higher prices, blamed largely on COVID-19, Russia’s war on…", label:"Analyze Hewlett Packard Enterprise (HPE) in its marketing context", canonical_key:"analyze_hewlett_packard_enterprise_hpe_in_its_ma", status:"approved"}}, {concept_id:"2eb01930-cc35-58d1-b419-caa0a4a2800b", kc_id:"2eb01930-cc35-58d1-b419-caa0a4a2800b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hilfiger and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Hilfiger in its marketing context", canonical_key:"analyze_hilfiger_in_its_marketing_context", status:"approved"}}, {concept_id:"16e06ea3-6090-52c0-81ae-eadb98bf4417", kc_id:"16e06ea3-6090-52c0-81ae-eadb98bf4417", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hilton Grand Vacations (HGV) and analyze its role in the textbook's treatment of personal selling and its role in the promotion mix. Source: printed page 505. Evidence excerpt: Consumers who travel often are able to increase their points through certain purchases and promotions that Hilton will offer to spur more travel. Hilton also connects with customers through Hilton Grand Vacations (HGV). HGV is a time-share within the Hilton portfolio of properties and rooms. When customers join HGV, they are buying ownership in the exclusive club properties.", label:"Analyze Hilton Grand Vacations (HGV) in its marketing context", canonical_key:"analyze_hilton_grand_vacations_hgv_in_its_market", status:"approved"}}, {concept_id:"71b80797-1d5d-52ee-8c53-2a597fcd501c", kc_id:"71b80797-1d5d-52ee-8c53-2a597fcd501c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hilton Hotels and Resorts and analyze its role in the textbook's treatment of personal selling and its role in the promotion mix. Source: printed page 505. Evidence excerpt: In the Spotlight Since 1919, when Conrad Hilton bought his first hotel, Hilton Hotels and Resorts has been providing a good night’s sleep to travelers around the world. With over 6,800 hotels within its portfolio (including several sub- brands), Hilton has a hotel to meet the needs of just about any traveler. Hampton Inn is a beloved brand for road-weary business travelers as well as families. The Conrad is one of the luxury brands for Hilton. And DoubleTree is another favorite brand for business travelers, known for the gooey, warm chocolate chip cookies presented at check-in. To reward travelers, Hilton offers several tiers of Hilton rewards: Silver, Gold, and Diamond. Reward…", label:"Analyze Hilton Hotels and Resorts in its marketing context", canonical_key:"analyze_hilton_hotels_and_resorts_in_its_marketi", status:"approved"}}, {concept_id:"1f966a59-a249-5f8d-b479-2cbe555592a4", kc_id:"1f966a59-a249-5f8d-b479-2cbe555592a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hofstede and analyze its role in the textbook's treatment of multicultural marketing. Source: printed page 276. Evidence excerpt: Values are cultural indicators of a society’s standards for goodness and justice. They are described as basic beliefs that guide behavior and give meaning to actions and attitudes. Dutch social psychologist and diversity thinker Geert Hofstede created a survey to uncover how national culture reflects a society’s values.39 Hofstede summarized the survey’s findings into the following dimensions:", label:"Analyze Hofstede in its marketing context", canonical_key:"analyze_hofstede_in_its_marketing_context", status:"approved"}}, {concept_id:"8c198927-9f66-59f2-b8d4-20d7a18dba4a", kc_id:"8c198927-9f66-59f2-b8d4-20d7a18dba4a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Holiday Inn and analyze its role in the textbook's treatment of managing the distribution channel. Source: printed page 594. Evidence excerpt: A horizontal conflict is when there is disagreement among firms at the same level in the marketing channel. For example, Holiday Inn has a variety of locations in New York City. If one Holiday Inn drives its prices down to outcompete its partners, that could cause conflict among the other Holiday Inn locations that perceive it as stealing customers through pricing tactics.", label:"Analyze Holiday Inn in its marketing context", canonical_key:"analyze_holiday_inn_in_its_marketing_context", status:"approved"}}, {concept_id:"9e7029db-e3fb-5b27-90fa-1cebf269ca14", kc_id:"9e7029db-e3fb-5b27-90fa-1cebf269ca14", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hollister and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 109. Evidence excerpt: Watch this video on Abercrombie & Fitch’s brand transformation for further insight on how A&F has positioned its retail brand Hollister as a global iconic teen brand and modernized the A&F brand to focus on young millennial consumers.", label:"Analyze Hollister in its marketing context", canonical_key:"analyze_hollister_in_its_marketing_context", status:"approved"}}, {concept_id:"d5aabd83-3c73-533e-9787-5b32582afb0e", kc_id:"d5aabd83-3c73-533e-9787-5b32582afb0e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Holmes and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Holmes in its marketing context", canonical_key:"analyze_holmes_in_its_marketing_context", status:"approved"}}, {concept_id:"550e5d31-cbc4-53f6-bab1-13e9bdb8ad2d", kc_id:"550e5d31-cbc4-53f6-bab1-13e9bdb8ad2d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Home Depot and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 551. Evidence excerpt: Social media marketing is defined as using social media platforms to deliver content that drives engagement with your brand. Companies from PepsiCo to Home Depot to the pizza restaurant located in town use social media to connect with users, share content, and, ultimately, generate sales. Marketers can create brand profiles and sponsored content that they pay for.", label:"Analyze Home Depot in its marketing context", canonical_key:"analyze_home_depot_in_its_marketing_context", status:"approved"}}, {concept_id:"2226931a-e4bf-5840-a9ef-03adbcef67b2", kc_id:"2226931a-e4bf-5840-a9ef-03adbcef67b2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Home Run Inn Pizza and analyze its role in the textbook's treatment of marketing strategies at each stage of the product life cycle. Source: printed page 318. Evidence excerpt: Once a product becomes mainstream in the growth stage, expanding distribution channels can increase market share. While expanded distribution adds expense, it also brings the product to more customers in various settings. For example, Chicago-based Home Run Inn Pizza was so famous in the restaurant format that it expanded to grocery stores to increase share.", label:"Analyze Home Run Inn Pizza in its marketing context", canonical_key:"analyze_home_run_inn_pizza_in_its_marketing_cont", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"6cd19e45-6734-5bb9-aefd-2db028be5045", kc_id:"6cd19e45-6734-5bb9-aefd-2db028be5045", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Home Shopping Network (HSN) and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 624. Evidence excerpt: Another example of a non-store retailer is television home shopping. Television home shopping primarily targets women over the age of 40 and is a business practice in which products or services are sold via television. There are some cable network stations that are dedicated solely to home shopping 24 hours a day, 7 days a week. One example is QVC, which stands for Quality, Value, and Convenience. The company was founded in 1986 and purchased its rival Home Shopping Network (HSN) in 2017. It generated $14.1 billion in profits in 2018.17 The 2015 Hollywood movie Joy, starring Jennifer Lawrence, showcases real-life entrepreneur Joy Mangano and the power of QVC as a non-store…", label:"Analyze Home Shopping Network (HSN) in its marketing context", canonical_key:"analyze_home_shopping_network_hsn_in_its_marketi", status:"approved"}}, {concept_id:"ded193c4-1200-5159-9634-8f3375c00eca", kc_id:"ded193c4-1200-5159-9634-8f3375c00eca", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Honda and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 179. Evidence excerpt: The automobile market is another good example of a clearly segmented market. Look around you on any given day, and you’ll clearly see that people want different types of vehicles—small cars, big cars, SUVs, trucks, hybrids, and luxury cars. Many of the car makers like GM, Ford, Toyota, Honda, and others generally offer cars for most or all of the segments. For example, Honda's lineup includes models like the CR-V compact SUV, the Civic compact car, the midsize Honda Accord sedan, larger SUVs, and even a minivan.57", label:"Analyze Honda in its marketing context", canonical_key:"analyze_honda_in_its_marketing_context", status:"approved"}}, {concept_id:"13bca9cc-69fd-561b-8306-e0d5b80a2657", kc_id:"13bca9cc-69fd-561b-8306-e0d5b80a2657", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Honeywell and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 609. Evidence excerpt: Strategically headquartered along the US-Mexico border in El Paso, Texas, Global Containers and Custom Packaging offers local packaging distribution services that provide value and solutions to the retail and maquiladora market. Customers include companies like Amazon.com, Hewlett Packard, Honeywell, Align Technology (the makers of Invisalign system for straightening teeth), and ASO (a leader in consumer first-aid products).", label:"Analyze Honeywell in its marketing context", canonical_key:"analyze_honeywell_in_its_marketing_context", status:"approved"}}, {concept_id:"e654f5a3-2833-5d52-aad9-fecd1e334c12", kc_id:"e654f5a3-2833-5d52-aad9-fecd1e334c12", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Hotels.com and analyze its role in the textbook's treatment of ethical considerations in pricing. Source: printed page 428. Evidence excerpt: During the winter of 2020–2021, Texas experienced much colder and snowier conditions than usual. Millions were left without power, and dozens lost their lives. As hotels began to fill up, prices skyrocketed. A Super 8 motel was shown on Hotels.com at nearly $400/night, exponentially higher than in ordinary times. Identifying price gouging is a bit more complicated than it seems. While basic economics would expect higher demand to equal higher prices, the practice of price gouging is not only unethical but also illegal in many states when a disaster is announced.37", label:"Analyze Hotels.com in its marketing context", canonical_key:"analyze_hotels_com_in_its_marketing_context", status:"approved"}}, {concept_id:"f5fab412-7cd9-53e2-bde1-0006527f3a9f", kc_id:"f5fab412-7cd9-53e2-bde1-0006527f3a9f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Human Rights Campaign Foundation and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze Human Rights Campaign Foundation in its marketing context", canonical_key:"analyze_human_rights_campaign_foundation_in_its_", status:"approved"}}, {concept_id:"baaaa7b8-e0d7-5af0-8f60-6484933d587e", kc_id:"baaaa7b8-e0d7-5af0-8f60-6484933d587e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify IBM and analyze its role in the textbook's treatment of segmentation of international markets. Source: printed page 172. Evidence excerpt: One model that is particularly useful in assessing culture is social psychologist Geert Hofstede’s cultural dimensions, originally published in the 1970s. Hofstede had studied IBM employees in over 50 countries and identified five dimensions that could be used to distinguish one culture from another.44 Four of these dimensions directly affect marketing in different cultures:", label:"Analyze IBM in its marketing context", canonical_key:"analyze_ibm_in_its_marketing_context", status:"approved"}}, {concept_id:"ef876b3c-27e4-5a40-940d-5e1d9a06c0d8", kc_id:"ef876b3c-27e4-5a40-940d-5e1d9a06c0d8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ice Bucket Challenge and analyze its role in the textbook's treatment of the advantages and disadvantages of public relations. Source: printed page 493. Evidence excerpt: As you’ve already learned, public relations is not a paid tool in the promotion mix. A really good brand or company story can be picked up by several media outlets, exposing the promotion to a large audience. Considered the Ice Bucket Challenge that went viral in 2015. The challenge was first promoted by Pat Quinn and Pete Frates as a way for the public to better understand how Lou Gehrig’s disease (amyotrophic lateral sclerosis [ALS]) affects those with the disease. The challenge raised over $115 million worldwide for the disease and was an extremely cost-effective (and fun) way to raise funds when it went viral on social media.22", label:"Analyze Ice Bucket Challenge in its marketing context", canonical_key:"analyze_ice_bucket_challenge_in_its_marketing_co", status:"approved"}}, {concept_id:"81528a74-c904-50a4-bd70-76ab1b59e626", kc_id:"81528a74-c904-50a4-bd70-76ab1b59e626", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify ICONI and analyze its role in the textbook's treatment of steps in the imc planning process. Source: printed page 454. Evidence excerpt: • Aware: The first stage in the customer journey with any product is to be aware that the product exists. It is difficult for a product to be desired by the customer if they don’t know about it. When Angel Johnson launched her activewear company ICONI, she needed to stand out from more popular and well-funded activewear brands. As a Black woman–owned business, Angel wanted to appeal to other women, many of whom needed different types of activewear. Angel found success in creating awareness through running ads on Amazon, where customers could easily find and purchase her products.17", label:"Analyze ICONI in its marketing context", canonical_key:"analyze_iconi_in_its_marketing_context", status:"approved"}}, {concept_id:"1b69d391-a935-5629-899e-64346bbd2e80", kc_id:"1b69d391-a935-5629-899e-64346bbd2e80", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify IKEA and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 50. Evidence excerpt: • IKEA: “To offer a wide range of well-designed, functional home furnishing products at prices so low that as many people as possible will be able to afford them”12 • Netflix: “To entertain the world”13", label:"Analyze IKEA in its marketing context", canonical_key:"analyze_ikea_in_its_marketing_context", status:"approved"}}, {concept_id:"6989c3e9-ff34-583d-b41c-77b42abe66b5", kc_id:"6989c3e9-ff34-583d-b41c-77b42abe66b5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify IMAN Cosmetics and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 159. Evidence excerpt: Race, ethnicity, and religion can be used to segment a market. It’s always dangerous to stereotype, but consumers of different races, ethnicities, and religions have different preferences and needs. Consider a company like Zondervan, a leading bible publisher. It would make sense for the company to segment its market based upon religion because it offers products that complement the religious beliefs of a particular group. Likewise, IMAN Cosmetics is designed for women with darker skin tones, so its target market would likely be women of color.", label:"Analyze IMAN Cosmetics in its marketing context", canonical_key:"analyze_iman_cosmetics_in_its_marketing_context", status:"approved"}}, {concept_id:"64c315dd-ca55-5752-be77-e1420ed048d3", kc_id:"64c315dd-ca55-5752-be77-e1420ed048d3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Indeed and analyze its role in the textbook's treatment of management of the sales force. Source: printed page 518. Evidence excerpt: Most recruiting starts with a job description detailing the requirements and the necessary skills that are needed to do the job. Finding the right candidates often starts through listing available job openings on many of the digital job boards, such as Indeed, CareerBuilder, and LinkedIn. Executive recruiting firms can also be instrumental in finding and matching the right job candidates.", label:"Analyze Indeed in its marketing context", canonical_key:"analyze_indeed_in_its_marketing_context", status:"approved"}}, {concept_id:"3eeedb73-6ac0-59f6-93d9-ae192040b9cd", kc_id:"3eeedb73-6ac0-59f6-93d9-ae192040b9cd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Indiana Premium Outlets and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Sawgrass Mills Factory Outlet, Overstock or over-manufactured brand-name items, Indiana Premium Outlets, Factory outlet usually clothing; typically in a mall setting with other Osage Outlets; Hanes Outlet, factory outlets L.L.Bean Outlet", label:"Analyze Indiana Premium Outlets in its marketing context", canonical_key:"analyze_indiana_premium_outlets_in_its_marketing", status:"approved"}}, {concept_id:"12c62b48-9704-59ae-9841-6d43ba24f433", kc_id:"12c62b48-9704-59ae-9841-6d43ba24f433", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Instacart and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 285. Evidence excerpt: Shared societal values are a trait that influence people’s behaviors. One of these is collectivism. Think about Hofstede’s cultural dimensions, individualism versus collectivism in particular. Collectivism places more emphasis on group activities than on individual ones. Overall, Asian societies are collectivistic, though the degree of collectivism varies among the populations’ countries of origin.64 Cultural celebrations are also a factor linked to identity. Instacart, Target, Wells Fargo, and Toyota are just a few companies marketing to Asian", label:"Analyze Instacart in its marketing context", canonical_key:"analyze_instacart_in_its_marketing_context", status:"approved"}}, {concept_id:"f28eb5eb-310f-58be-9ae9-1f5949401a47", kc_id:"f28eb5eb-310f-58be-9ae9-1f5949401a47", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Instagram and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 101. Evidence excerpt: Reference groups are those groups with which you like to be associated. These can be formal groups, such as members of a country club, church, or professional group, or informal groups of friends or acquaintances. These groups serve as role models and inspirations, and they influence what types of products you buy and which brands you choose. Reference groups are characterized by having opinion leaders—people who influence others. These opinion leaders aren’t necessarily higher-income or better educated, but others view them as having more expertise in a particular area. For example, a teenage girl may look to the opinion leader in her reference group of friends for fashion…", label:"Analyze Instagram in its marketing context", canonical_key:"analyze_instagram_in_its_marketing_context", status:"approved"}}, {concept_id:"362c664e-e32e-52f5-85a2-16868eab9ba2", kc_id:"362c664e-e32e-52f5-85a2-16868eab9ba2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify International Trade Administration and analyze its role in the textbook's treatment of the global market and advantages of international trade. Source: printed page 252. Evidence excerpt: What Do Marketers Do? Part of the International Trade Administration, Export Assistance Centers (found in the United States, Europe, the Middle East, Africa, and Asia) help US-based businesses plan, develop, and execute international strategies to succeed in today’s global marketplace through the. Find the center nearest to you (https://openstax.org/r/ uscommercialservice) and conduct a short interview with an export counselor there to learn more about their job. To learn more about global market opportunities through the International Trade Administration, watch the short video “Discover Global Markets.”", label:"Analyze International Trade Administration in its marketing context", canonical_key:"analyze_international_trade_administration_in_it", status:"approved"}}, {concept_id:"2db739ab-e706-5908-88b5-4fd0837b7e9b", kc_id:"2db739ab-e706-5908-88b5-4fd0837b7e9b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Intuit and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 652. Evidence excerpt: Williams-Sonoma is just one example of a company with a vision and a commitment to sustainability. Other companies known for their sustainability commitments and practices include Microsoft, VMware, Intuit, Apple, and Mastercard.9", label:"Analyze Intuit in its marketing context", canonical_key:"analyze_intuit_in_its_marketing_context", status:"approved"}}, {concept_id:"8604e4cf-8425-5e72-8ee2-35fdc67c2320", kc_id:"8604e4cf-8425-5e72-8ee2-35fdc67c2320", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify iPhone and analyze its role in the textbook's treatment of major decisions in developing an advertising plan. Source: printed page 478. Evidence excerpt: Specific messages of informative advertising will vary depending on the product or service. A simple teaser of a new product is effective for some products, while for others, more detailed information may be necessary so the audience understands the product. For example, when the newest iPhone is about to be launched, Apple often uses a short and simple advertisement with only a photo of the phone and its available date. For an existing brand such as Apple, this works well because consumers are already familiar with the product’s brand. Conversely, when a brand-new product is brought to market that consumers may not be aware of, more information may be necessary in the message.", label:"Analyze iPhone in its marketing context", canonical_key:"analyze_iphone_in_its_marketing_context", status:"approved"}}, {concept_id:"e08666f0-41fd-5290-9fe5-4fa99ad48587", kc_id:"e08666f0-41fd-5290-9fe5-4fa99ad48587", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify iSalus and analyze its role in the textbook's treatment of classifications of salespeople involved in personal selling. Source: printed page 509. Evidence excerpt: The order getter must be able to listen to the customer and respond with solutions that will be mutually beneficial to both companies. In the role of the order getter, it is not uncommon to work with a customer for a year or more before ever making a sale. iSalus is a perfect example of this. In an effort to get the company’s cutting-edge patient engagement software into health systems, the sales force must identify the decision makers within the health system as well as work with those who will be using the software. Educating and engaging with a variety of teams within the health system, as well as waiting on budget approvals, can take anywhere from 6 to 18 months. Laying the…", label:"Analyze iSalus in its marketing context", canonical_key:"analyze_isalus_in_its_marketing_context", status:"approved"}}, {concept_id:"d8256a4a-92d5-559d-9fcd-ec090912272a", kc_id:"d8256a4a-92d5-559d-9fcd-ec090912272a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify J.Crew and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 327. Evidence excerpt: Split loyals are customers who have a consideration set of two to three products or services in the category. The split loyal is willing to buy this select set of brands on any occasion without hard-core loyalty to any in the group. However, brands can convert split loyals into hard-core loyals with product/service consistency, loyalty programs, and marketing efforts. For example, customers may have loyalty to Gap, Banana Republic, and J.Crew for workwear.", label:"Analyze J.Crew in its marketing context", canonical_key:"analyze_j_crew_in_its_marketing_context", status:"approved"}}, {concept_id:"78ff7cc9-f54b-5d3f-9ea8-44665194e022", kc_id:"78ff7cc9-f54b-5d3f-9ea8-44665194e022", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify J.M. Smucker Company and analyze its role in the textbook's treatment of multicultural marketing. Source: printed page 275. Evidence excerpt: Like symbols, language is an important part of culture. Language communicates personal identity. It also shapes how people perceive the world around them. Have you heard of 9Lives? It is a popular brand of cat food in the United States owned by the J.M. Smucker Company. The brand’s name comes from the popular expression that cats have nine lives. However, did you know that in Spanish and Portuguese, the expression is that cats only have seven lives? For these multicultural consumers, such language differences can influence their perceptions of the product.", label:"Analyze J.M. Smucker Company in its marketing context", canonical_key:"analyze_j_m_smucker_company_in_its_marketing_con", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"2af3814a-4969-5907-8feb-f7a16d68dcaf", kc_id:"2af3814a-4969-5907-8feb-f7a16d68dcaf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify J.P. Morgan and analyze its role in the textbook's treatment of ethical issues in developing a marketing strategy. Source: printed page 81. Evidence excerpt: During the American Industrial Revolution in the early 1900s, the United States saw the rise of iconic business enterprises like Ford, US Steel, J.P. Morgan, Union Pacific Railroad, and many others. Some (a few) gave generously to charitable causes. Others made their wealth using unscrupulous means, exploiting labor and using questionable business practices.", label:"Analyze J.P. Morgan in its marketing context", canonical_key:"analyze_j_p_morgan_in_its_marketing_context", status:"approved"}}, {concept_id:"94219e8c-2e06-58cb-849d-1975baae5c11", kc_id:"94219e8c-2e06-58cb-849d-1975baae5c11", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify JanSport and analyze its role in the textbook's treatment of the marketing mix and the 4ps of marketing. Source: printed page 20. Evidence excerpt: Netflix, JanSport, and Stranger Things A real-world promotional example is the recent brand partnership between Netflix and JanSport, the backpack company. These two companies collaborated on a Stranger Things–branded backpack with the", label:"Analyze JanSport in its marketing context", canonical_key:"analyze_jansport_in_its_marketing_context", status:"approved"}}, {concept_id:"5f6bf363-5438-5bb4-ae72-a4bcaa8dfa65", kc_id:"5f6bf363-5438-5bb4-ae72-a4bcaa8dfa65", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify JCPenney and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 617. Evidence excerpt: Department Wide variety of product lines JCPenney, Kohl’s store", label:"Analyze JCPenney in its marketing context", canonical_key:"analyze_jcpenney_in_its_marketing_context", status:"approved"}}, {concept_id:"da6bd50d-bebb-5aec-a2bb-8398cc2a5f98", kc_id:"da6bd50d-bebb-5aec-a2bb-8398cc2a5f98", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Jelly Belly and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze Jelly Belly in its marketing context", canonical_key:"analyze_jelly_belly_in_its_marketing_context", status:"approved"}}, {concept_id:"922c3dab-9250-59c3-b95e-7882f0a1b55c", kc_id:"922c3dab-9250-59c3-b95e-7882f0a1b55c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Jenner and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 101. Evidence excerpt: Reference groups are those groups with which you like to be associated. These can be formal groups, such as members of a country club, church, or professional group, or informal groups of friends or acquaintances. These groups serve as role models and inspirations, and they influence what types of products you buy and which brands you choose. Reference groups are characterized by having opinion leaders—people who influence others. These opinion leaders aren’t necessarily higher-income or better educated, but others view them as having more expertise in a particular area. For example, a teenage girl may look to the opinion leader in her reference group of friends for fashion…", label:"Analyze Jenner in its marketing context", canonical_key:"analyze_jenner_in_its_marketing_context", status:"approved"}}, {concept_id:"3e2b6f88-1a65-5e4f-b029-dd4b3fda2cf4", kc_id:"3e2b6f88-1a65-5e4f-b029-dd4b3fda2cf4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Jirau and analyze its role in the textbook's treatment of marketing to sociodemographic groups. Source: printed page 292. Evidence excerpt: How can marketers best reach consumers with disabilities? By using an approach that ensures the company’s efforts express humanity, authenticity, and inclusivity. Let’s look at a couple of examples. In January 2019, a picture from a bridal boutique’s window display went viral due to its powerful inclusivity message. The display showed a mannequin in a wheelchair dressed in a wedding gown. In February 2022, Hispanic model Sofia Jirau made history as the first person with Down syndrome to become a model for Victoria’s Secret. These examples demonstrate that people with disabilities are not only part of our social fabric but also are an integral part of the overall market.", label:"Analyze Jirau in its marketing context", canonical_key:"analyze_jirau_in_its_marketing_context", status:"approved"}}, {concept_id:"39166207-b639-5caf-b6fe-ebcbdb6cb7b6", kc_id:"39166207-b639-5caf-b6fe-ebcbdb6cb7b6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Jobs and analyze its role in the textbook's treatment of pricing and its role in the marketing mix. Source: printed page 409. Evidence excerpt: The concept of price anchoring relies on the first piece of information that a buyer sees. This acts as an anchor, or a frame of reference for what the buyer expects a price to be. Steve Jobs used this concept in his introduction of the iPad. The anchor price he quoted was $999. This immediately made buyers believe the product should be priced around $999. However, when Jobs showed the actual price, starting at $499, the buyers immediately believed, psychologically, that it was a great deal. Viewers did not know what the worth of the iPad was; they just believed they were saving nearly $500 by having the initial anchor of $999.", label:"Analyze Jobs in its marketing context", canonical_key:"analyze_jobs_in_its_marketing_context", status:"approved"}}, {concept_id:"1d5e5d46-1e15-59a9-8375-7fb88b51398a", kc_id:"1d5e5d46-1e15-59a9-8375-7fb88b51398a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify John Lobb and analyze its role in the textbook's treatment of entering the global arena. Source: printed page 241. Evidence excerpt: The most basic and least involved method to enter global markets is through exporting. Exporting is when a company makes a product or service in one country and sells it in others. Many companies choose this method of entry into global markets because it requires the least amount of m risk and allows the firm’s managers to learn the ins and outs of international business. For example, in the UK’s East Midlands, the county of Northampton is home to Alfred Sargent & Sons, Church’s, John Lobb, and other shoemakers. An increased emphasis on exporting allowed these dying businesses to see new life because people in other countries wanted a piece of traditional “English cobbling.”58", label:"Analyze John Lobb in its marketing context", canonical_key:"analyze_john_lobb_in_its_marketing_context", status:"approved"}}, {concept_id:"89958df8-7529-5ecf-b37e-59c038656b24", kc_id:"89958df8-7529-5ecf-b37e-59c038656b24", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Johnson and analyze its role in the textbook's treatment of steps in the imc planning process. Source: printed page 454. Evidence excerpt: • Aware: The first stage in the customer journey with any product is to be aware that the product exists. It is difficult for a product to be desired by the customer if they don’t know about it. When Angel Johnson launched her activewear company ICONI, she needed to stand out from more popular and well-funded activewear brands. As a Black woman–owned business, Angel wanted to appeal to other women, many of whom needed different types of activewear. Angel found success in creating awareness through running ads on Amazon, where customers could easily find and purchase her products.17", label:"Analyze Johnson in its marketing context", canonical_key:"analyze_johnson_in_its_marketing_context", status:"approved"}}, {concept_id:"d73b6776-1033-5159-b039-30a6c69592c4", kc_id:"d73b6776-1033-5159-b039-30a6c69592c4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Johnson & Johnson and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 444. Evidence excerpt: Public relations can also include crisis communication when negative issues occur. One of the biggest public relations issues happened in 1982 to Tylenol. A malicious person or persons in the Chicago area tampered with a few bottles of Tylenol Extra Strength capsules by replacing the actual capsules with cyanide-laced capsules. Consumers who unwittingly bought the Tylenol ended up dead. Johnson & Johnson, the maker of Tylenol, was facing issues that could easily have destroyed its business. The issue was the leading story for every news outlet.", label:"Analyze Johnson & Johnson in its marketing context", canonical_key:"analyze_johnson_johnson_in_its_marketing_context", status:"approved"}}, {concept_id:"945a1b0e-eb96-5ffb-9c18-8b25db0e83b6", kc_id:"945a1b0e-eb96-5ffb-9c18-8b25db0e83b6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Juul and analyze its role in the textbook's treatment of ethical issues in developing a marketing strategy. Source: printed page 82. Evidence excerpt: According to a Gallup poll in 2021, approximately 6 percent of US adults report that they have used e- cigarettes within the past week87 despite health warnings about vaping. The sale and distribution of e- cigarettes is banned or regulated in a growing number of countries much to the dismay of vaping aficionados. Where do you draw the line? Is vaping a matter of personal choice, or are people influenced by the marketing efforts of e-cigarette producers like Juul?", label:"Analyze Juul in its marketing context", canonical_key:"analyze_juul_in_its_marketing_context", status:"approved"}}, {concept_id:"0587c27c-b5b5-53b0-9bc8-f19c117c0f65", kc_id:"0587c27c-b5b5-53b0-9bc8-f19c117c0f65", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kabbage Funding and analyze its role in the textbook's treatment of buyers and buying situations in a b2b market. Source: printed page 133. Evidence excerpt: Many of Alibaba’s suppliers are businesses that sell raw materials or manufactured goods, and the B2B buyers of these goods are typically retailers, wholesalers, sourcing agents, or manufacturers who source products for reselling for their own businesses (see Figure 4.3). Alibaba.com even has “Pay Later” options (backed by Kabbage Funding) so that buyers can purchase inventory, even if they don’t have immediate funds available. This “Pay Later” option helps B2B buyers avoid more complicated financing options.6", label:"Analyze Kabbage Funding in its marketing context", canonical_key:"analyze_kabbage_funding_in_its_marketing_context", status:"approved"}}, {concept_id:"2146a4c6-831d-595e-bea9-ed8b7ca894f1", kc_id:"2146a4c6-831d-595e-bea9-ed8b7ca894f1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kao and analyze its role in the textbook's treatment of ethical issues in the global marketplace. Source: printed page 248. Evidence excerpt: Founded in 1887 in Tokyo, Japan, Kao is a “16-time Ethisphere World’s Most Ethical Companies honoree and [it has] been honored every year since Ethisphere started recognizing companies.”89 The company’s", label:"Analyze Kao in its marketing context", canonical_key:"analyze_kao_in_its_marketing_context", status:"approved"}}, {concept_id:"4b25c4b8-c0e3-5807-94bf-959a067dbd1b", kc_id:"4b25c4b8-c0e3-5807-94bf-959a067dbd1b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kate Spade and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: Licensed brands provide the likeness of their brand as a fee for use. If you wear eyeglasses, you likely have a licensed brand name on your eyeglasses frame. Brands like Tiffany & Co., Kate Spade, and Tommy Hilfiger do not produce eyeglasses frames. Rather, they license their brand to manufacturers like Luxottica, an Italian eyewear company that makes the product with the licensed brand name. Licensing a brand is a quick way to gain recognition and benefit from the brand’s equity. On the other hand, licensing fees can be costly and ultimately reduce profitability for manufacturers.", label:"Analyze Kate Spade in its marketing context", canonical_key:"analyze_kate_spade_in_its_marketing_context", status:"approved"}}, {concept_id:"96cc4fb1-ab0d-5a72-b0dc-94f22489cf43", kc_id:"96cc4fb1-ab0d-5a72-b0dc-94f22489cf43", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Keller and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 322. Evidence excerpt: Kevin Lane Keller developed the brand equity model to illustrate how brands can develop equity. He postulated that if a brand could develop positive associations, it could charge more than its competitors. The model begins with defining a brand through its identity. Brands should answer the question, Who are you and how do you solve the consumers’ needs? The next level of the model determines a brand’s meaning. On one hand, how well does the brand perform, and on the other, how does it meet consumers’ social and psychological needs? The third level of the framework is about feelings and thoughts. In other words, What do consumers think of your brand and what judgements do they…", label:"Analyze Keller in its marketing context", canonical_key:"analyze_keller_in_its_marketing_context", status:"approved"}}, {concept_id:"85ed79a8-1432-5852-82ca-95534552d0a4", kc_id:"85ed79a8-1432-5852-82ca-95534552d0a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kellogg’s and analyze its role in the textbook's treatment of entering the global arena. Source: printed page 242. Evidence excerpt: A joint venture is a business arrangement whereby two or more companies create one single enterprise or project. The joint venture can last for any length of time but typically is not permanent. The advantage of a joint venture is that the two companies share all the risks associated with the venture.64 In 2012, Kellogg’s and Wilmar International Limited announced a joint venture. Kellogg’s wanted to expand its presence in the Chinese market. Creating a joint venture with Wilmar International provided the company with an extensive distribution network. Both companies benefited from this venture: Wilmar International through its financial incentives and Kellogg’s with a way to…", label:"Analyze Kellogg’s in its marketing context", canonical_key:"analyze_kellogg_s_in_its_marketing_context", status:"approved"}}, {concept_id:"17cf81ea-8d55-5111-bdf4-452e305b9de7", kc_id:"17cf81ea-8d55-5111-bdf4-452e305b9de7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kentucky Fried Chicken (KFC) and analyze its role in the textbook's treatment of factors contributing to the success or failure of new products. Source: printed page 358. Evidence excerpt: If you were to ask people what they eat during the holiday season, you’d probably get answers like turkey or ham. It’s not likely that many of them will say fried chicken (see Figure 10.6). That’s less than ideal for Kentucky Fried Chicken (KFC) because despite the fact that consumer spending typically spikes during the last six weeks of the year, KFC’s sales typically falter.", label:"Analyze Kentucky Fried Chicken (KFC) in its marketing context", canonical_key:"analyze_kentucky_fried_chicken_kfc_in_its_market", status:"approved"}}, {concept_id:"afe94cd7-51ca-5f44-bfef-4ca3f188b1e9", kc_id:"afe94cd7-51ca-5f44-bfef-4ca3f188b1e9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kforce and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 147. Evidence excerpt: Instead of idly standing by or focusing solely on getting its business back up and running, Kforce decided to “make lemonade out of lemons” and have a positive impact on the community (see Figure 4.8). The company raised $1 million for the American Red Cross and sponsored private jet missions that flew essential supplies to the Bahamas. It also encouraged users to make donations for hurricane relief, generating several thousand additional dollars for the cause.26", label:"Analyze Kforce in its marketing context", canonical_key:"analyze_kforce_in_its_marketing_context", status:"approved"}}, {concept_id:"103ef6e8-7e76-52b8-9cb9-17246a919d0c", kc_id:"103ef6e8-7e76-52b8-9cb9-17246a919d0c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kindle and analyze its role in the textbook's treatment of the use of metrics in evaluating new products. Source: printed page 355. Evidence excerpt: consumer product companies generally spend less. The percentage is calculated as R&D dollars spent divided by total sales. • Current Year Percentage of Sales: This method calculates cost of goods sold, inventory, cash, and other financial line items as a percentage of sales and then applies that percentage to future sales estimates. It’s a “quick and dirty” way to estimate the product’s future value.26 • Time to Value (TTV): Time to value refers to how long it takes new users to recognize your product’s value (sometimes referred to as the “aha!” moment in marketing). Obviously, the sooner this occurs, the better, although time to value varies widely depending upon the product…", label:"Analyze Kindle in its marketing context", canonical_key:"analyze_kindle_in_its_marketing_context", status:"approved"}}, {concept_id:"b734fc89-7fc6-5f30-92b1-caaaa4f333b5", kc_id:"b734fc89-7fc6-5f30-92b1-caaaa4f333b5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kirby and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 625. Evidence excerpt: Direct selling is selling products and services directly to the consumer in a non-retail setting. Direct selling typically consists of a salesperson attempting to sell a product or service to a potential customer at their residence or place of employment. This practice was very popular in the 1950 and 1960s when women were often stay-at-home mothers and/or homemakers. Salespeople would bring the product—a vacuum, for example—to the consumer’s home and demonstrate its benefits in an attempt to make a sale. With the rise of two-income families and the Internet, direct selling is not used frequently today in the consumer market. It is, however, still a widely used practice in B2B.…", label:"Analyze Kirby in its marketing context", canonical_key:"analyze_kirby_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"ba575055-2842-588f-8bc8-8e4121a29293", kc_id:"ba575055-2842-588f-8bc8-8e4121a29293", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kloss and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Kloss in its marketing context", canonical_key:"analyze_kloss_in_its_marketing_context", status:"approved"}}, {concept_id:"c2f9b03e-e941-5b8a-a96e-4446e73a5c83", kc_id:"c2f9b03e-e941-5b8a-a96e-4446e73a5c83", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kohl’s and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 586. Evidence excerpt: A multichannel distribution system is where a single company sets up multiple distribution channels to reach customers. For example, Nike has brick-and-mortar stores across major cities. Customers can visit the store, try on shoes and apparel, and make a purchase. In addition to physical stores, Nike also distributes its shoes and apparel through its online store Nike.com, through e-tailers like Amazon.com, and through other brick-and-mortar stores like Kohl’s and Foot Locker.", label:"Analyze Kohl’s in its marketing context", canonical_key:"analyze_kohl_s_in_its_marketing_context", status:"approved"}}, {concept_id:"a36df0e4-7f17-5286-a287-52fcbe361192", kc_id:"a36df0e4-7f17-5286-a287-52fcbe361192", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kohlberg & Company and analyze its role in the textbook's treatment of factors influencing channel choice. Source: printed page 588. Evidence excerpt: The first factor that plays an important role in channel choice is target market coverage. Companies must analyze the size of their target market and their budget and ensure they have the appropriate coverage. For example, a small local bakery may only target towns in its area; therefore, its target market coverage is rather small. Kohlberg & Company, the owner of the Sara Lee and Thomas’ brands, on the other hand, reaches global consumers and therefore requires far greater market coverage.", label:"Analyze Kohlberg & Company in its marketing context", canonical_key:"analyze_kohlberg_company_in_its_marketing_contex", status:"approved"}}, {concept_id:"c3f79f09-ea04-5cf2-bcad-98c044d0c6fa", kc_id:"c3f79f09-ea04-5cf2-bcad-98c044d0c6fa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kotler and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 652. Evidence excerpt: Environmental Sustainability Consumers increasingly demand purpose over profits from the brands they work for, shop for, invest in, and allow within their communities. In fact, an IBM study on consumer behavior indicated that 57 percent of consumers would alter consumption habits to be more environmentally conscious, and nearly 80 percent of survey respondents indicated that sustainability is essential.10 Therefore, sustainability is a business imperative. As defined by Philip Kotler, Professor Emeritus at Northwestern University, “the concept of sustainable marketing holds that an organization should meet the needs of its present consumers without compromising the ability of…", label:"Analyze Kotler in its marketing context", canonical_key:"analyze_kotler_in_its_marketing_context", status:"approved"}}, {concept_id:"d896a3bd-2703-566f-b2e3-3747e51ba553", kc_id:"d896a3bd-2703-566f-b2e3-3747e51ba553", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kozmo.com and analyze its role in the textbook's treatment of recent trends in retailing. Source: printed page 634. Evidence excerpt: While most might think of Amazon Prime as the originator of same-day package delivery, the concept has actually been around for decades but was less prevalent in retail. Companies that offer legal and financial services have long had same-day delivery of their documents. In addition, restaurants have been offering guaranteed on-time delivery for some time. Florists have also offered one-day service for many years, particularly for funeral arrangements. And while Amazon Prime made the practice much more widespread throughout retailing, the now-defunct company Kozmo.com likely pioneered the practice in 1998.33", label:"Analyze Kozmo.com in its marketing context", canonical_key:"analyze_kozmo_com_in_its_marketing_context", status:"approved"}}, {concept_id:"8818ad05-fd9a-575f-9fbe-800fc9260962", kc_id:"8818ad05-fd9a-575f-9fbe-800fc9260962", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify KPMG and analyze its role in the textbook's treatment of ethical issues in digital marketing and social media. Source: printed page 566. Evidence excerpt: First, because of the highly targeted capabilities of digital and social media, companies have access to large amounts of personal data, including name, email address, phone number, as well as personal interests, social and political views, and shopping behavior. Consumers are increasingly concerned about data privacy. In a recent survey by KPMG, 86 percent of the respondents have a growing concern about data privacy, and 78 percent fear the amount of data being collected.35", label:"Analyze KPMG in its marketing context", canonical_key:"analyze_kpmg_in_its_marketing_context", status:"approved"}}, {concept_id:"5e7714c2-ece6-5881-a463-68199fb14a08", kc_id:"5e7714c2-ece6-5881-a463-68199fb14a08", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kraft and analyze its role in the textbook's treatment of the product life cycle. Source: printed page 316. Evidence excerpt: The product enters the maturity stage when sales growth slows and profitability levels taper off. The maturity stage is typically the longest stage of the product life cycle, with products remaining in this stage for years or even decades. Profitability may remain if the brand has a solid competitive advantage or decline if too many competitors enter the market. Marketing investment can increase at this stage if the brand has a rival, and product modification can alter the product to meet consumers’ needs. Yet often a brand will retain a low level of marketing during the maturity stage to remind consumers of its benefits. Kraft Macaroni & Cheese is an example of a product that…", label:"Analyze Kraft in its marketing context", canonical_key:"analyze_kraft_in_its_marketing_context", status:"approved"}}, {concept_id:"d40b23da-f55a-5e9f-acd2-6672c9dad920", kc_id:"d40b23da-f55a-5e9f-acd2-6672c9dad920", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Kroger and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: Organizations are increasingly sponsoring or hosting special events to show support for various causes. Such events are also a way to showcase the company, products/services, and/or brands to the public. Often, companies use special events to show the public that their values and ideals are part of their business model. For example, Kroger has sponsored and volunteered for the Susan G. Komen Central Indiana Race for a Cure for many years. With one of its division offices located in Indianapolis, Indiana, the company has been covered by media for its involvement in the local chapter of the Breast Cancer Foundation.19 The events not only", label:"Analyze Kroger in its marketing context", canonical_key:"analyze_kroger_in_its_marketing_context", status:"approved"}}, {concept_id:"961ff10f-e5d3-5a62-9f17-1d7d1af09a96", kc_id:"961ff10f-e5d3-5a62-9f17-1d7d1af09a96", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify L.L.Bean and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Sawgrass Mills Factory Outlet, Overstock or over-manufactured brand-name items, Indiana Premium Outlets, Factory outlet usually clothing; typically in a mall setting with other Osage Outlets; Hanes Outlet, factory outlets L.L.Bean Outlet", label:"Analyze L.L.Bean in its marketing context", canonical_key:"analyze_l_l_bean_in_its_marketing_context", status:"approved"}}, {concept_id:"88e9b387-b590-5705-bc91-d19136399e8e", kc_id:"88e9b387-b590-5705-bc91-d19136399e8e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify L.L.Bean Outlet and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Sawgrass Mills Factory Outlet, Overstock or over-manufactured brand-name items, Indiana Premium Outlets, Factory outlet usually clothing; typically in a mall setting with other Osage Outlets; Hanes Outlet, factory outlets L.L.Bean Outlet", label:"Analyze L.L.Bean Outlet in its marketing context", canonical_key:"analyze_l_l_bean_outlet_in_its_marketing_context", status:"approved"}}, {concept_id:"d8ef15e4-e2fd-5681-bea5-2fe340728bbe", kc_id:"d8ef15e4-e2fd-5681-bea5-2fe340728bbe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify L’Oréal and analyze its role in the textbook's treatment of managing the distribution channel. Source: printed page 593. Evidence excerpt: The qualities of an effective channel relationship include collaboration, transparency, and cohesion. When members work together toward a common goal of delivering value to the consumer, the channel is more effective. Companies like L’Oréal and Procter & Gamble must work harmoniously to build mutually beneficial relationships with their distribution network because it's critical to meeting the needs of their consumers. Failure to do so could be detrimental to channel members if customer value declines because of conflict.", label:"Analyze L’Oréal in its marketing context", canonical_key:"analyze_l_or_al_in_its_marketing_context", status:"approved"}}, {concept_id:"f541524c-c49f-5605-ab0f-4c03f94a133c", kc_id:"f541524c-c49f-5605-ab0f-4c03f94a133c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify LaCroix and analyze its role in the textbook's treatment of creating value through packaging and labeling. Source: printed page 330. Evidence excerpt: Additionally, the package reflects the brand, cuing the customer in to the brand feeling. For example, LaCroix is flavored carbonated water sold in brightly colored cans. The cans, as seen below, attempt to make the customer feel the excitement of opening a tasty carbonated beverage (see Figure 9.11).", label:"Analyze LaCroix in its marketing context", canonical_key:"analyze_lacroix_in_its_marketing_context", status:"approved"}}, {concept_id:"15ca5f3a-4fb9-5b48-b6e9-9d63a7bca953", kc_id:"15ca5f3a-4fb9-5b48-b6e9-9d63a7bca953", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lands’ End and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 541. Evidence excerpt: Companies such as Lands’ End and IKEA have long used catalogs to entice consumers to call the phone number or visit the website displayed on the catalog. The call to action is precisely what makes catalog marketing direct marketing. Consumers are presented with vivid product images and an offer such as free delivery or 20 percent off if the consumer responds to the call to action.", label:"Analyze Lands’ End in its marketing context", canonical_key:"analyze_lands_end_in_its_marketing_context", status:"approved"}}, {concept_id:"2e8e1a15-f43c-5aa0-878a-dcebc0f02459", kc_id:"2e8e1a15-f43c-5aa0-878a-dcebc0f02459", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lapaas Digital and analyze its role in the textbook's treatment of ethical marketing. Source: printed page 35. Evidence excerpt: What are the principles of ethical marketing? According to Lapaas Digital, a digital marketing agency based in Delhi, India, some of those principles include the following:", label:"Analyze Lapaas Digital in its marketing context", canonical_key:"analyze_lapaas_digital_in_its_marketing_context", status:"approved"}}, {concept_id:"9bc30966-2dc2-5745-b41c-66470ab119a9", kc_id:"9bc30966-2dc2-5745-b41c-66470ab119a9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Law of Effect and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 108. Evidence excerpt: Learning is still another important factor in consumer buying behavior. The fact is that consumer behavior is learned, and much of what you buy is based on your previous experiences with particular brands. This is commonly known as the Law of Effect, which asserts that, if an action is followed by a pleasant consequence, you’re likely to repeat it; if the action is followed by an unpleasant consequence, you’re less likely to repeat it. For example, let’s say you buy an Apple iPhone. If your experience with the iPhone is positive, you’ll probably be more inclined to buy another Apple product when you’re looking for a tablet or wearable. On the other hand, if you’ve had a…", label:"Analyze Law of Effect in its marketing context", canonical_key:"analyze_law_of_effect_in_its_marketing_context", status:"approved"}}, {concept_id:"286ce7f5-54f5-56ab-8efd-277def91cab0", kc_id:"286ce7f5-54f5-56ab-8efd-277def91cab0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lay’s and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 442. Evidence excerpt: medium one-topping pizza, this BOGO deal is used to get an immediate increase in sales for Domino’s pizza. Consumers may buy Domino’s over other pizza brands because they can get more pizza for their money. • Enter to Win. PepsiCo needed to gain traction with the millennial audience. It needed to boost the Lay’s brand of potato chips and compete with new flavorful organic chips that were getting market share in the category once dominated by Lay’s. To generate new interest in its brand, Lay’s launched a campaign for consumers to create a new flavor. New flavors could be entered, Lay’s would create samples, and the winner of the new chip flavor would win $1 million. • Coupons.…", label:"Analyze Lay’s in its marketing context", canonical_key:"analyze_lay_s_in_its_marketing_context", status:"approved"}}, {concept_id:"f3ccefd0-d591-582e-8b58-cdc90f36f3b4", kc_id:"f3ccefd0-d591-582e-8b58-cdc90f36f3b4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lear and analyze its role in the textbook's treatment of types of marketing channels. Source: printed page 584. Evidence excerpt: With producer to industrial distributor to business/industrial user channels, car manufacturers like Toyota and Honda rely on tens of thousands of different parts, which are manufactured by parts producers. Producers are companies that supply the raw materials that manufacturers need to create consumer products. Parts producers such as the car seating and E-Systems engineering company Lear rely on distributors to move their products and technology to automobile manufacturers. Using a distributor allows Lear to focus on its center of excellence—researching, designing, and building innovative seating technology solutions for vehicles.", label:"Analyze Lear in its marketing context", canonical_key:"analyze_lear_in_its_marketing_context", status:"approved"}}, {concept_id:"58212f2f-af53-567d-badf-239d1d5d3e74", kc_id:"58212f2f-af53-567d-badf-239d1d5d3e74", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify LEGO and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 176. Evidence excerpt: Keep in mind that the target market isn’t the same as the target audience. The target audience is narrower in that it refers to the group of consumers you expect to actually purchase the product. The audience may or may not overlap with the target market. For example, a children’s toy may have a target market of boys between the ages of 6 and 12, but it’s the boys’ parents (who actually purchase the toy) who are the target audience. Let’s take a look at how LEGO has mastered this concept.", label:"Analyze LEGO in its marketing context", canonical_key:"analyze_lego_in_its_marketing_context", status:"approved"}}, {concept_id:"61aa94a8-3e89-5e1e-9963-b5f582160e49", kc_id:"61aa94a8-3e89-5e1e-9963-b5f582160e49", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lemonhead and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze Lemonhead in its marketing context", canonical_key:"analyze_lemonhead_in_its_marketing_context", status:"approved"}}, {concept_id:"f7cea612-228f-5084-b08c-02653a044894", kc_id:"f7cea612-228f-5084-b08c-02653a044894", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify LendingTree and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 544. Evidence excerpt: A consumer who searches the web and lands on LendingTree’s website is invited to compare quotes and plans that are tailored to their age, income level, and location by filling out an online form. LendingTree then displays consumer-relevant plans and quotes based on their demographics and follows up with an email inviting consumers to view offers from financial institutions. If the customer is a Gmail user, consumers may then see digital ads later on sites like YouTube and in their Gmail inbox.", label:"Analyze LendingTree in its marketing context", canonical_key:"analyze_lendingtree_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"0d73b245-5a34-5f59-9157-bd7bd75569bd", kc_id:"0d73b245-5a34-5f59-9157-bd7bd75569bd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Leo Burnett and analyze its role in the textbook's treatment of advertising in the promotion mix. Source: printed page 473. Evidence excerpt: In the Spotlight Leo Burnett was a journalist for the Peoria Times in Illinois when he decided to start his own advertising firm with the same name in 1935.1 His strategies were fairly simple: to utilize models who looked like ordinary people instead of Hollywood stars. His motto: “What helps people, helps business.” That strategy paid off big for Philip Morris with the introduction of the iconic—albeit now considered unethical—Marlboro Man. In 1952, the ageless Tony the Tiger cartoon icon for Kellogg’s Frosted Flakes was also born from the Leo Burnett ad agency. Other notable companies that have utilized the Leo Burnett ad agency include Procter & Gamble, McDonald’s, and Fiat,…", label:"Analyze Leo Burnett in its marketing context", canonical_key:"analyze_leo_burnett_in_its_marketing_context", status:"approved"}}, {concept_id:"3bbd7f60-d6c9-5e8a-b0d7-067926af1e2e", kc_id:"3bbd7f60-d6c9-5e8a-b0d7-067926af1e2e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Levi’s and analyze its role in the textbook's treatment of ethical issues in the global marketplace. Source: printed page 247. Evidence excerpt: Unlike most developed countries, those countries still developing often have much lower standards for working conditions. This has been a topic of hot debate for many years in the United States and around the world as companies have moved some or all of their operations to countries with lower standards. In Xinjiang, China, more than half a million people from ethnic minority groups are forced to pick cotton for the fashion industry.82 Well-known companies such as Nike, Apple, and Levi’s have come under the same scrutiny in more recent years. While cheaper production costs will provide the company with more profits, more often than not, lower standards, working conditions, and…", label:"Analyze Levi’s in its marketing context", canonical_key:"analyze_levi_s_in_its_marketing_context", status:"approved"}}, {concept_id:"5c380605-10f2-54a9-9cbd-401936090c7d", kc_id:"5c380605-10f2-54a9-9cbd-401936090c7d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lexus and analyze its role in the textbook's treatment of the five critical cs of pricing. Source: printed page 412. Evidence excerpt: Customers Customers are another key element to pricing decisions, as you’ve learned already in this chapter. Marketers must determine not only what customers expect a product or service to be priced at but also what those customers are willing to pay. Toyota manufactures cars and markets them toward the middle class. Through research, it has determined what its target market is willing and able to pay for a particular vehicle. Alternatively, Lexus, which is marketed as more of a luxury car, has a higher price point and is marketed to a different market than that of Toyota.", label:"Analyze Lexus in its marketing context", canonical_key:"analyze_lexus_in_its_marketing_context", status:"approved"}}, {concept_id:"32534024-21f9-5ecb-ba88-0ca165123ffc", kc_id:"32534024-21f9-5ecb-ba88-0ca165123ffc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lineout and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 301. Evidence excerpt: On the opposite spectrum, young women had much different needs for facial fillers. Younger women primarily wanted lips that looked like the Kardashians and “line”-free foreheads, similar to what they were seeing from favorite celebrities and Instagram influencers. Media choices for women in their late teens and early twenties were primarily focused on TikTok and Instagram along with some select YouTube channels and reality shows. Lineout was able to connect with this audience by targeting messaging specific to the bigger, beautiful lip craze.", label:"Analyze Lineout in its marketing context", canonical_key:"analyze_lineout_in_its_marketing_context", status:"approved"}}, {concept_id:"c66e8d4b-0333-5fb0-ba77-ed3cd7fec902", kc_id:"c66e8d4b-0333-5fb0-ba77-ed3cd7fec902", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify LinkedIn and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 56. Evidence excerpt: To give you a better sense of what a business portfolio entails, look at Figure 2.5, which illustrates the products and services of Microsoft and how each offering contributes to the overall strategic plan of the company.26 Microsoft reported $168 billion in revenue in fiscal year 2021, and each of its product lines (or strategic business units) contributes to this revenue in differing amounts.27 It’s easy to see from this breakdown why each of these businesses under the Microsoft “umbrella” would have different strategic plans to execute within the markets they serve. You likely wouldn’t have one overarching marketing or business strategy for all of these SBUs because the…", label:"Analyze LinkedIn in its marketing context", canonical_key:"analyze_linkedin_in_its_marketing_context", status:"approved"}}, {concept_id:"6cf23423-5754-5b7c-bc3a-d88f5ffbb8f1", kc_id:"6cf23423-5754-5b7c-bc3a-d88f5ffbb8f1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Little Debbie and analyze its role in the textbook's treatment of steps in the imc planning process. Source: printed page 470. Evidence excerpt: For the 2021 holiday season, Little Debbie launched a new Christmas treat, Christmas Tree Cake Ice Cream. To create this new confection, Little Debbie partnered with Hudsonville Ice Cream, a Michigan-based company that has been in business for over 90 years. The new product launched with a great deal of media attention. Public relations were in full swing with articles in newspapers across the country as well as trial of the product on live news broadcasts. Additional headlines appeared in digital media outlets to amplify the message that this new treat was available in stores for the holidays “while supplies last.”22", label:"Analyze Little Debbie in its marketing context", canonical_key:"analyze_little_debbie_in_its_marketing_context", status:"approved"}}, {concept_id:"96726d82-47e9-586b-be32-ea9d08ae8978", kc_id:"96726d82-47e9-586b-be32-ea9d08ae8978", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Living Essentials, LLC and analyze its role in the textbook's treatment of ethical marketing. Source: printed page 36. Evidence excerpt: • Don’t overemphasize or exaggerate. In marketing, this is sometimes referred to as “puffery.” Of course, you want to convey the features and benefits of the product or service to the customer, but these need to be stated clearly and accurately. Don’t promise something you can’t deliver— doing so is unethical and not beneficial in the long run. • Don’t make false or unverified claims. One case illustrates the importance of honesty in advertising: Living Essentials, LLC, the makers of 5-Hour Energy shots, advertised its product as “doctor-recommended” and superior to traditional caffeine. Those claims were found to be misleading, and Living Essentials, LLC was ordered to pay $4.3…", label:"Analyze Living Essentials, LLC in its marketing context", canonical_key:"analyze_living_essentials_llc_in_its_marketing_c", status:"approved"}}, {concept_id:"0b60c68e-5842-5729-a418-6c5005e21a7c", kc_id:"0b60c68e-5842-5729-a418-6c5005e21a7c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lopez and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 267. Evidence excerpt: Modelo Especial is a good example. Modelo Especial is a Mexican beer that has successfully capitalized on its heritage to target the Hispanic population while also appealing to the general market. Marketed by Constellation Brands, the beer has had strong sales in the United States since the 1990s.17 In 2019, Hispanic consumers captured close to 70 percent of the brand’s national sales, but Hispanic people are only about half of the customer base.18 Over the course of several decades, various aspects of Hispanic culture have been widely embraced in the United States. Have you heard of artists like Jennifer Lopez, Pitbull, Bad Bunny, and J Balvin? The marketing team at…", label:"Analyze Lopez in its marketing context", canonical_key:"analyze_lopez_in_its_marketing_context", status:"approved"}}, {concept_id:"397c8963-29f5-5ebf-94c6-7d218e0cd596", kc_id:"397c8963-29f5-5ebf-94c6-7d218e0cd596", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lowe’s and analyze its role in the textbook's treatment of factors influencing channel choice. Source: printed page 588. Evidence excerpt: Selective distribution is a strategy that includes choosing more than one, but fewer than all possible intermediaries to distribute a company’s market offering. Companies choose selective distribution when they don’t need the expansive coverage that intensive distribution provides but still need to reach their target market at specific retail outlets. Large appliance companies such as Whirlpool and General Electric use selective distribution by making their products available through their dealer networks and at selective large retailers like Lowe’s and Home Depot.", label:"Analyze Lowe’s in its marketing context", canonical_key:"analyze_lowe_s_in_its_marketing_context", status:"approved"}}, {concept_id:"e6d85818-9406-56c2-837c-42d9a72832da", kc_id:"e6d85818-9406-56c2-837c-42d9a72832da", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lululemon and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 162. Evidence excerpt: Values are the principles and important things that influence the way you live and work. As one example, environmental concerns are becoming a value issue for consumers, and they are looking for products from companies that are better for the earth. Knowing this, IKEA has incorporated a furniture buyback and resale program in the United States. If you have a piece of IKEA furniture that’s an oldie but still a goody and you want to retire it, IKEA will buy it back and help you pave the way toward sustainable living.14 Another great example is Lululemon’s Like New program. You can bring in any used Lululemon gear, trade it in at the store, get an eGift card for use at a Lululemon…", label:"Analyze Lululemon in its marketing context", canonical_key:"analyze_lululemon_in_its_marketing_context", status:"approved"}}, {concept_id:"77582005-5500-5255-92a2-f3a4a69a581a", kc_id:"77582005-5500-5255-92a2-f3a4a69a581a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify LUSH and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 179. Evidence excerpt: A good example of concentrated marketing is the eco-friendly cosmetics retailer LUSH. LUSH advocates for ethical buying and purity of handmade products and doesn’t use animals in testing its products. As a matter of fact, at least half of its website is dedicated to fighting animal testing and overuse of plastic packaging and creating environmental awareness. The company also differentiates itself from its competitors with eco- friendly packaging and organic ingredients.59", label:"Analyze LUSH in its marketing context", canonical_key:"analyze_lush_in_its_marketing_context", status:"approved"}}, {concept_id:"25bf8c43-9c90-5750-b4ba-5c4fa57e7908", kc_id:"25bf8c43-9c90-5750-b4ba-5c4fa57e7908", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Luxottica and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: Licensed brands provide the likeness of their brand as a fee for use. If you wear eyeglasses, you likely have a licensed brand name on your eyeglasses frame. Brands like Tiffany & Co., Kate Spade, and Tommy Hilfiger do not produce eyeglasses frames. Rather, they license their brand to manufacturers like Luxottica, an Italian eyewear company that makes the product with the licensed brand name. Licensing a brand is a quick way to gain recognition and benefit from the brand’s equity. On the other hand, licensing fees can be costly and ultimately reduce profitability for manufacturers.", label:"Analyze Luxottica in its marketing context", canonical_key:"analyze_luxottica_in_its_marketing_context", status:"approved"}}, {concept_id:"06ef1df4-28b0-52cd-910a-fa84eb4b8645", kc_id:"06ef1df4-28b0-52cd-910a-fa84eb4b8645", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Lysol and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 104. Evidence excerpt: The second level is safety and security, the need to be safe from physical and psychological harm. Once again, consider just a few successful marketing campaigns that have focused on safety—“You’re in Good Hands with Allstate” and Lysol’s “Practice Healthy Habits” campaign with its tagline “What It Takes to Protect.”", label:"Analyze Lysol in its marketing context", canonical_key:"analyze_lysol_in_its_marketing_context", status:"approved"}}, {concept_id:"63b7af99-6ddb-5421-bafb-bd1a994b0370", kc_id:"63b7af99-6ddb-5421-bafb-bd1a994b0370", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Macy’s and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 445. Evidence excerpt: When a consumer completes a Google search for shoes and then jumps to Facebook to scroll their feed and are served shoe ads from Nordstrom, Macy’s, and Steve Madden, they have been targeted by these shoe companies. The targeting, immediacy, and changeability of the messaging makes digital a quick and efficient method of reaching consumers. Digital promotional tools are extremely effective and can cut through the clutter and reach the consumer when they are in the demand phase of the buying process and have signaled an intent to purchase.", label:"Analyze Macy’s in its marketing context", canonical_key:"analyze_macy_s_in_its_marketing_context", status:"approved"}}, {concept_id:"2aa3bd41-7143-540d-a194-fb60a021ff71", kc_id:"2aa3bd41-7143-540d-a194-fb60a021ff71", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mailchimp and analyze its role in the textbook's treatment of segmentation of b2b markets. Source: printed page 166. Evidence excerpt: • Improved Campaign Performance. Similar to the previous example of a company using specialty magazines to reach the right target audience with the right message, B2B marketers can do the same. For example, Mailchimp, a marketing automation platform and email marketing service, examined user data to compare segmented marketing campaigns with non-segmented campaigns. The statistics based upon a comparison of 18 million email recipients were eye-opening. Campaigns directed toward defined market segments saw increases in a number of areas, including a 14.3 percent higher email open rate.21 • Improved Customer Loyalty and Retention. In our discussion of consumer market segmentation,…", label:"Analyze Mailchimp in its marketing context", canonical_key:"analyze_mailchimp_in_its_marketing_context", status:"approved"}}, {concept_id:"6994d7e7-1b0a-568b-ac82-bcdae44c14fa", kc_id:"6994d7e7-1b0a-568b-ac82-bcdae44c14fa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Make-A-Wish Foundation and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: In 2021, Subaru celebrated 14 years of its Share the Love event.19 To celebrate this event, it debuted a national ad campaign highlighting the people, places, and pets that have been impacted by its social responsibility. Charities supported by Subaru include the American Society for the Prevention of Cruelty to Animals (ASPCA), Make-A-Wish Foundation, Meals on Wheels America, and the National Park Foundation. In its advertising, Subaru also showcases some of the local charities—selected by Subaru retailers—that benefit from the Subaru Share the Love event, as well as the impact of the automaker’s work with Feeding America to help address food insecurity.20", label:"Analyze Make-A-Wish Foundation in its marketing context", canonical_key:"analyze_make_a_wish_foundation_in_its_marketing_", status:"approved"}}, {concept_id:"c2c5388f-67a8-5dff-b016-e4e9f013e6bd", kc_id:"c2c5388f-67a8-5dff-b016-e4e9f013e6bd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mall of America and analyze its role in the textbook's treatment of retailing strategy decisions. Source: printed page 629. Evidence excerpt: Regional shopping centers, commonly referred to as shopping malls, offer general merchandise or fashion- oriented products and services (see Figure 18.12). They are enclosed buildings with access to retailers through a common walkway. Most regional malls have one to four anchor stores—large, well-known department stores—and numerous smaller specialty stores, as well as restaurants and activities. This blend of shopping and entertainment is sometimes known as retailtainment. For example, the Mall of America, located in Minneapolis, Minnesota, houses not only department and specialty stores, but also numerous restaurants, a cinema, an aquarium, and a theme park.22", label:"Analyze Mall of America in its marketing context", canonical_key:"analyze_mall_of_america_in_its_marketing_context", status:"approved"}}, {concept_id:"34af0c1a-ea24-5b85-bcc6-52fb5e195f1b", kc_id:"34af0c1a-ea24-5b85-bcc6-52fb5e195f1b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Marks & Spencer and analyze its role in the textbook's treatment of segmentation of international markets. Source: printed page 171. Evidence excerpt: In 2022, in response to Russia’s invasion of Ukraine, major sanctions have been put in place against Russia by the United States, the European Union, and the United Kingdom. For example, the United Kingdom imposed a 35 percent tax on some Russian imports, and several international companies like McDonald’s, Coca-Cola, Starbucks and Marks & Spencer have either suspended operations in Russia or have withdrawn altogether. It doesn’t take much to imagine the financial impact on Russia as a result of these sanctions.36", label:"Analyze Marks & Spencer in its marketing context", canonical_key:"analyze_marks_spencer_in_its_marketing_context", status:"approved"}}, {concept_id:"f6a60be1-f62c-5ffc-a863-b4cad4f7881a", kc_id:"f6a60be1-f62c-5ffc-a863-b4cad4f7881a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Marriott and analyze its role in the textbook's treatment of retailing and the role of retailers in the distribution channel. Source: printed page 612. Evidence excerpt: Today, even social media plays a role in the distribution channel. Looking at the above example, Marriott might consider utilizing social media as yet another point of contact for the organization’s employees and customers to interact. Customers can often book a room and receive customer service directly through the company’s social media platforms.4 As you will learn later, the choice of which distribution channel to use depends largely on the type of product and the manufacturer’s strategy.", label:"Analyze Marriott in its marketing context", canonical_key:"analyze_marriott_in_its_marketing_context", status:"approved"}}, {concept_id:"201a14b5-aeb8-5794-b2cd-8046da4fb666", kc_id:"201a14b5-aeb8-5794-b2cd-8046da4fb666", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Marriott International and analyze its role in the textbook's treatment of product positioning. Source: printed page 181. Evidence excerpt: For example, Marriott International owns several different hotel chains that target specific consumer groups:", label:"Analyze Marriott International in its marketing context", canonical_key:"analyze_marriott_international_in_its_marketing_", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"f3598dc5-60d3-5b0e-b5cc-178ff8e9ece8", kc_id:"f3598dc5-60d3-5b0e-b5cc-178ff8e9ece8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Maslow and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 104. Evidence excerpt: Abraham Maslow asserted that all individuals have five needs, arranged from the most basic lower-level deficiency needs to the highest-level growth needs. As Figure 3.8 shows, physiological needs are at the most basic level and include things like adequate food, water, and shelter. Think about how marketers may try to appeal to consumers based on physiological needs. For example, Snickers ran a very successful ad campaign based on the slogan “You’re not you when you’re hungry.”", label:"Analyze Maslow in its marketing context", canonical_key:"analyze_maslow_in_its_marketing_context", status:"approved"}}, {concept_id:"632aa0dc-dea9-5639-9c65-483c8c8c217e", kc_id:"632aa0dc-dea9-5639-9c65-483c8c8c217e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mastercard and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 161. Evidence excerpt: • Activities. Activities focus on a person’s daily routine and/or hobbies. For instance, if you’re an urban dweller who rides your bike to work and works out regularly, your buying patterns are probably going to be vastly different from someone who drives to work and doesn’t work out. • Interests. Interests drive passions. What are your interests? Crypto investing? Gaming? Photography? That’s important information to marketers because by identifying your interests (assuming you’re a target consumer), they can more easily determine what marketing messages will appeal to you. • Opinions. Opinions matter, and especially in the age of social media, opinions spread fast. Companies…", label:"Analyze Mastercard in its marketing context", canonical_key:"analyze_mastercard_in_its_marketing_context", status:"approved"}}, {concept_id:"5181e75f-55e0-5109-b84c-1c9991b8b9dc", kc_id:"5181e75f-55e0-5109-b84c-1c9991b8b9dc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mattel Inc. and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 155. Evidence excerpt: Mattel Inc. is the producer of popular children’s toys like Hot Wheels, Barbie, and Max Steel. Its action figure Max Steel was introduced in 1999 to only modest success in the United States, but it was enormously popular in South America, even outselling the company’s top lines—Hot Wheels and Barbie. Nearly a decade later, marketers decided to revive the brand in the United States, hoping for a second chance at success.1", label:"Analyze Mattel Inc. in its marketing context", canonical_key:"analyze_mattel_inc_in_its_marketing_context", status:"approved"}}, {concept_id:"437f2056-7fe0-5e21-977e-b6dbe57e69ee", kc_id:"437f2056-7fe0-5e21-977e-b6dbe57e69ee", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Maxwell House and analyze its role in the textbook's treatment of stages of the new product development process. Source: printed page 351. Evidence excerpt: It’s important to note that sometimes the company realizes in this stage that the product concept simply can’t be translated into a commercially feasible product. For example, through market research, Maxwell House determined that consumers wanted a coffee that was “bold, vigorous, and deep tasting.” However, after working with coffee blends for four months, the company determined that it was too expensive to commercially produce the formula, so Maxwell House changed the blend to meet its targeted manufacturing cost. Unfortunately, the taste of the new blend didn’t meet consumers’ expectations, and the new product flopped.19", label:"Analyze Maxwell House in its marketing context", canonical_key:"analyze_maxwell_house_in_its_marketing_context", status:"approved"}}, {concept_id:"6f5a5042-4e5e-57c0-bb9c-62d4c53eef0f", kc_id:"6f5a5042-4e5e-57c0-bb9c-62d4c53eef0f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Meals on Wheels America and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: In 2021, Subaru celebrated 14 years of its Share the Love event.19 To celebrate this event, it debuted a national ad campaign highlighting the people, places, and pets that have been impacted by its social responsibility. Charities supported by Subaru include the American Society for the Prevention of Cruelty to Animals (ASPCA), Make-A-Wish Foundation, Meals on Wheels America, and the National Park Foundation. In its advertising, Subaru also showcases some of the local charities—selected by Subaru retailers—that benefit from the Subaru Share the Love event, as well as the impact of the automaker’s work with Feeding America to help address food insecurity.20", label:"Analyze Meals on Wheels America in its marketing context", canonical_key:"analyze_meals_on_wheels_america_in_its_marketing", status:"approved"}}, {concept_id:"227fe185-81bd-53ab-9769-9b90b0f9d68e", kc_id:"227fe185-81bd-53ab-9769-9b90b0f9d68e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Medallia and analyze its role in the textbook's treatment of the business-to-business (b2b) market. Source: printed page 127. Evidence excerpt: In the Spotlight Say hello to RingCentral, a company that provides businesses with cloud-based business communications solutions that include messaging, video meetings, phone, and an omnichannel cloud contact center. RingCentral, a business-to-business (B2B) company, partnered with Medallia, a customer feedback management software platform. Soon after implementing Medallia, RingCentral was able to obtain important insights about product innovation and was able to turn that feedback into product features and customer retention.", label:"Analyze Medallia in its marketing context", canonical_key:"analyze_medallia_in_its_marketing_context", status:"approved"}}, {concept_id:"e091f1fc-daaa-54ad-a134-776151a822ec", kc_id:"e091f1fc-daaa-54ad-a134-776151a822ec", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Men’s Health and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 158. Evidence excerpt: With gender segmentation, the market is divided into men and women. Those who identify as men and those who identify as women have different interests in terms of shopping for various products like apparel, shoes, and food. For example, look at the ad campaigns crafted toward women in fashion magazines such as Vogue or Vanity Fair. You’ll likely see a different ad focus in magazines like GQ or Men’s Health.", label:"Analyze Men’s Health in its marketing context", canonical_key:"analyze_men_s_health_in_its_marketing_context", status:"approved"}}, {concept_id:"e3c78e46-bb91-5972-9c25-b41bb2a0e16e", kc_id:"e3c78e46-bb91-5972-9c25-b41bb2a0e16e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mercedes-Benz and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 158. Evidence excerpt: Income segmentation involves segmenting the market on the basis of monthly or yearly income. With income data, a company can determine how its potential consumer base spends money on both the high and low ends of the spectrum. Mercedes-Benz is a classic example of this as it markets different car models at different price points: A-Class vehicles starting in the low $30,000 range, C-Class in the $40,000–$55,000 range, E-Class in the $55,000–$72,000 range, and, finally, its S-Class vehicles, which are priced at $95,000 and up.9", label:"Analyze Mercedes-Benz in its marketing context", canonical_key:"analyze_mercedes_benz_in_its_marketing_context", status:"approved"}}, {concept_id:"a73b2f26-70c2-5b38-987d-341b8c26f784", kc_id:"a73b2f26-70c2-5b38-987d-341b8c26f784", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Messi and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 101. Evidence excerpt: Reference groups are those groups with which you like to be associated. These can be formal groups, such as members of a country club, church, or professional group, or informal groups of friends or acquaintances. These groups serve as role models and inspirations, and they influence what types of products you buy and which brands you choose. Reference groups are characterized by having opinion leaders—people who influence others. These opinion leaders aren’t necessarily higher-income or better educated, but others view them as having more expertise in a particular area. For example, a teenage girl may look to the opinion leader in her reference group of friends for fashion…", label:"Analyze Messi in its marketing context", canonical_key:"analyze_messi_in_its_marketing_context", status:"approved"}}, {concept_id:"392c0be6-b267-59cb-b218-809d2f0dbe93", kc_id:"392c0be6-b267-59cb-b218-809d2f0dbe93", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Meta and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 55. Evidence excerpt: Business Portfolio Definition As noted above, many businesses have a single product or business unit. However, larger organizations such as Apple, Alphabet, General Electric, Meta, and Microsoft often have multiple diverse business units called strategic business units. Despite the fact that these SBUs report directly to the parent company’s headquarters, they typically develop their own vision statements, mission statements, objectives, and goals, and the strategic planning for these SBUs is performed separately and apart from other SBUs within the organization.25 When companies have multiple products or business units, these comprise the business", label:"Analyze Meta in its marketing context", canonical_key:"analyze_meta_in_its_marketing_context", status:"approved"}}, {concept_id:"02703dab-1199-5434-8ef1-d258110d2ee6", kc_id:"02703dab-1199-5434-8ef1-d258110d2ee6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Meta Platforms and analyze its role in the textbook's treatment of ethical issues in the global marketplace. Source: printed page 247. Evidence excerpt: Outsourcing refers to a business moving some of its operations to a foreign country for the purpose of saving money and time or to increase volume and quality. WhatsApp, an encrypted communication app owned by Meta Platforms (formerly Facebook), has been used globally for several years. Based out of California, the company realized that it would have difficulty growing if it did not outsource. In 2012, the company began utilizing Russian companies for a small fraction of what it would have had to pay within the United States.81 While outsourcing has its advantages, many will argue that outsourcing eliminates jobs in the home country.", label:"Analyze Meta Platforms in its marketing context", canonical_key:"analyze_meta_platforms_in_its_marketing_context", status:"approved"}}, {concept_id:"a369659b-be5f-5278-94e7-0dfe49f02b20", kc_id:"a369659b-be5f-5278-94e7-0dfe49f02b20", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify MeTime Drop-In Child Care and analyze its role in the textbook's treatment of classification of services. Source: printed page 375. Evidence excerpt: Sara Bullock, who has a background in early childhood education and four children of her own, owned a childcare business in Maryland for more than 10 years. When her husband was required to move to Tennessee for his job, she closed her business and started a new childcare business using a different business model. She changed it from a conventional daycare center to a “drop-in” center, allowing parents to bring in their children for short periods of time (anywhere from one to seven hours) without requiring them to make a monthly commitment. That was the birth of MeTime Drop-In Child Care. The concept has been so successful that Bullock has already begun plans to open a second…", label:"Analyze MeTime Drop-In Child Care in its marketing context", canonical_key:"analyze_metime_drop_in_child_care_in_its_marketi", status:"approved"}}, {concept_id:"ccab6c45-bf64-517a-aa2f-81a78975d977", kc_id:"ccab6c45-bf64-517a-aa2f-81a78975d977", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Microsoft and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 55. Evidence excerpt: Business Portfolio Definition As noted above, many businesses have a single product or business unit. However, larger organizations such as Apple, Alphabet, General Electric, Meta, and Microsoft often have multiple diverse business units called strategic business units. Despite the fact that these SBUs report directly to the parent company’s headquarters, they typically develop their own vision statements, mission statements, objectives, and goals, and the strategic planning for these SBUs is performed separately and apart from other SBUs within the organization.25 When companies have multiple products or business units, these comprise the business", label:"Analyze Microsoft in its marketing context", canonical_key:"analyze_microsoft_in_its_marketing_context", status:"approved"}}, {concept_id:"8a82807e-8fd6-57e8-ac96-c3666a89c478", kc_id:"8a82807e-8fd6-57e8-ac96-c3666a89c478", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mike and Ike and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze Mike and Ike in its marketing context", canonical_key:"analyze_mike_and_ike_in_its_marketing_context", status:"approved"}}, {concept_id:"56fdce3e-c70a-5ee6-8119-bd813b4dda92", kc_id:"56fdce3e-c70a-5ee6-8119-bd813b4dda92", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Millennials and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 102. Evidence excerpt: power,7 so you can imagine its impact on the consumer market. What types of products would you expect baby boomers to buy? Key categories for this group of buyers include pharmacy and health care products, household goods and appliances, wine, books (both digital and physical), cosmetics, and skin care products.8 • Generation X (born between 1965 and 1979/80) are currently in their 40s and 50s. This cohort is approximately 65 million strong9 and generally has more spending power than younger generational cohorts because they’re at or reaching the peak of their careers, and many Gen Xers are dual-income families.10 This makes them an optimal target for higher-end brands and…", label:"Analyze Millennials in its marketing context", canonical_key:"analyze_millennials_in_its_marketing_context", status:"approved"}}, {concept_id:"10880fcd-98a7-58a9-a895-3b056716d881", kc_id:"10880fcd-98a7-58a9-a895-3b056716d881", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mintel and analyze its role in the textbook's treatment of ethical marketing. Source: printed page 35. Evidence excerpt: Ask yourself a question: how important are a company’s ethics to you when you decide to purchase a product or service? According to new research by Mintel, 56 percent of US consumers stop buying from companies they believe are unethical. Perhaps even more importantly, approximately one-third of consumers are inclined to tell others when they perceive a brand to be taking actions that they perceive to be honest, fair, and responsible. Taking this one step further, 29 percent of them will share their support of ethical companies via social media.56", label:"Analyze Mintel in its marketing context", canonical_key:"analyze_mintel_in_its_marketing_context", status:"approved"}}, {concept_id:"13116d6c-a9c4-511b-ab07-b8e71b6c6538", kc_id:"13116d6c-a9c4-511b-ab07-b8e71b6c6538", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Mirror and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 162. Evidence excerpt: fitness tool Mirror. This interactive home trainer has performed well in the market since its inception in 2018 because it targets those people who want to work out but can’t find the time to go to the gym.", label:"Analyze Mirror in its marketing context", canonical_key:"analyze_mirror_in_its_marketing_context", status:"approved"}}, {concept_id:"f47fbe71-7fc8-5a88-a8a0-aeb941ef0ef9", kc_id:"f47fbe71-7fc8-5a88-a8a0-aeb941ef0ef9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Modelo Especial and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 267. Evidence excerpt: Modelo Especial is a good example. Modelo Especial is a Mexican beer that has successfully capitalized on its heritage to target the Hispanic population while also appealing to the general market. Marketed by Constellation Brands, the beer has had strong sales in the United States since the 1990s.17 In 2019, Hispanic consumers captured close to 70 percent of the brand’s national sales, but Hispanic people are only about half of the customer base.18 Over the course of several decades, various aspects of Hispanic culture have been widely embraced in the United States. Have you heard of artists like Jennifer Lopez, Pitbull, Bad Bunny, and J Balvin? The marketing team at…", label:"Analyze Modelo Especial in its marketing context", canonical_key:"analyze_modelo_especial_in_its_marketing_context", status:"approved"}}, {concept_id:"74d66b1f-fd42-590d-ade8-0545816142fe", kc_id:"74d66b1f-fd42-590d-ade8-0545816142fe", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Morton’s Salt and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: National brands are the name brands that sell a product or service under its corporate name and identity. Brands like Heinz, Smartwater, and Morton’s Salt are examples of name brands. Brand equity commands higher prices, so national brands typically charge higher prices than their private brand counterparts. National brands often pay for premium retail space, making them a convenient choice for shoppers. However, price- sensitive shoppers may be turned off by the higher prices of national brands.", label:"Analyze Morton’s Salt in its marketing context", canonical_key:"analyze_morton_s_salt_in_its_marketing_context", status:"approved"}}, {concept_id:"c792c082-b067-56d6-80e2-cc2ce3810a5c", kc_id:"c792c082-b067-56d6-80e2-cc2ce3810a5c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify MyPillow and analyze its role in the textbook's treatment of steps in the imc planning process. Source: printed page 461. Evidence excerpt: For example, let’s consider the television commercial for MyPillow. Throughout a broadcast, the MyPillow commercial plays two or three times. The commercial plays every night on one broadcast station. However, during holiday seasons, the commercial plays more often. The commercial is often accompanied by a special code. With the code, viewers can receive a discount on the pillows. The viewer gets a discount, and MyPillow receives analytics to determine if its budget for this commercial television time is effective. In this example,", label:"Analyze MyPillow in its marketing context", canonical_key:"analyze_mypillow_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"8e70356c-25c5-5d75-b003-2299394d314e", kc_id:"8e70356c-25c5-5d75-b003-2299394d314e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nabisco and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 326. Evidence excerpt: Multibrands are new brand names within a company’s existing product category. For example, Nabisco manufactures various cookies within a product line but is marketed with different brand names. In this case, Chips Ahoy, Oreo, and Teddy Grahams all have brand equity on their own and do not need the benefit of the Nabisco brand. Each of these brands has a significant market share, so there is a benefit to retaining a multibranding approach. However, a multibranding approach does not work when the products have a small market share or fail to gain favorable retail shelf space to encourage sales.", label:"Analyze Nabisco in its marketing context", canonical_key:"analyze_nabisco_in_its_marketing_context", status:"approved"}}, {concept_id:"72f3159f-e8c3-5104-853f-a928773de0f0", kc_id:"72f3159f-e8c3-5104-853f-a928773de0f0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Naked Wines and analyze its role in the textbook's treatment of pricing and its role in the marketing mix. Source: printed page 433. Evidence excerpt: The Naked Wines business model allows the winemakers to have access to funding and market research, while the investors have access to great wines. As Naked Wines continues to grow from an initial start in the United Kingdom to operations in the United States, it continues to add winemakers and investors. Small winemakers who would otherwise not have had an opportunity to grow their business have found success and community through Naked Wines.", label:"Analyze Naked Wines in its marketing context", canonical_key:"analyze_naked_wines_in_its_marketing_context", status:"approved"}}, {concept_id:"bfbf5b9d-db15-5972-a823-15e37adc0630", kc_id:"bfbf5b9d-db15-5972-a823-15e37adc0630", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nasco Gulf and analyze its role in the textbook's treatment of ethical considerations in providing services. Source: printed page 396. Evidence excerpt: You may not be familiar with Nasco Gulf, a leading insurance agent in Dubai, but the company stands out in its Customer Service Code of Conduct (see Figure 11.13). The “customer service mission is to provide", label:"Analyze Nasco Gulf in its marketing context", canonical_key:"analyze_nasco_gulf_in_its_marketing_context", status:"approved"}}, {concept_id:"c6129496-1d00-556a-bb37-f05262caa352", kc_id:"c6129496-1d00-556a-bb37-f05262caa352", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify National Association for the Advancement of Colored People (NAACP) and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze National Association for the Advancement of Colored People (NAACP) in its marketing context", canonical_key:"analyze_national_association_for_the_advancement", status:"approved"}}, {concept_id:"7eaef56a-391a-562c-b33e-23036033c0e9", kc_id:"7eaef56a-391a-562c-b33e-23036033c0e9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify National Association of Realtors and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: For example, in 2020, the National Association of Realtors was the top lobbying association in the United States, followed by the US Chamber of Commerce, Pharmaceutical Research and Manufacturers of America, and the American Hospital Association. Together, these associations spent over $200 million lobbying to impact local, state, and federal legislation.18", label:"Analyze National Association of Realtors in its marketing context", canonical_key:"analyze_national_association_of_realtors_in_its_", status:"approved"}}, {concept_id:"f098e737-327d-5371-8231-59a3ff001973", kc_id:"f098e737-327d-5371-8231-59a3ff001973", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify National Geographic and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 559. Evidence excerpt: Instagram has served as an effective vehicle for sharing these images globally. National Geographic has utilized the platform to drive engagement with followers. Its famous “Wanderlust” social media campaign invites amateur photographers from around the world to post the best photographs they’ve taken while traveling.33 Followers use the #wanderlustcontest hashtag to connect with the National Geographic community of travelers. Its strategy to promote user-generated content was a great way to connect with followers and build continuous engagement.", label:"Analyze National Geographic in its marketing context", canonical_key:"analyze_national_geographic_in_its_marketing_con", status:"approved"}}, {concept_id:"83bfd483-0fb9-5675-a72c-cdd33276e45e", kc_id:"83bfd483-0fb9-5675-a72c-cdd33276e45e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify National Immigration Law Center and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze National Immigration Law Center in its marketing context", canonical_key:"analyze_national_immigration_law_center_in_its_m", status:"approved"}}, {concept_id:"bd3dd352-4ba9-5c02-8615-d73ac1d12335", kc_id:"bd3dd352-4ba9-5c02-8615-d73ac1d12335", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify National Organization on Disability and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze National Organization on Disability in its marketing context", canonical_key:"analyze_national_organization_on_disability_in_i", status:"approved"}}, {concept_id:"49e694d2-dfb2-535d-996d-90ef8d3f9642", kc_id:"49e694d2-dfb2-535d-996d-90ef8d3f9642", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify National Park Foundation and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: In 2021, Subaru celebrated 14 years of its Share the Love event.19 To celebrate this event, it debuted a national ad campaign highlighting the people, places, and pets that have been impacted by its social responsibility. Charities supported by Subaru include the American Society for the Prevention of Cruelty to Animals (ASPCA), Make-A-Wish Foundation, Meals on Wheels America, and the National Park Foundation. In its advertising, Subaru also showcases some of the local charities—selected by Subaru retailers—that benefit from the Subaru Share the Love event, as well as the impact of the automaker’s work with Feeding America to help address food insecurity.20", label:"Analyze National Park Foundation in its marketing context", canonical_key:"analyze_national_park_foundation_in_its_marketin", status:"approved"}}, {concept_id:"177607fa-f4e5-5490-a282-392886cf2f10", kc_id:"177607fa-f4e5-5490-a282-392886cf2f10", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify National Urban League and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze National Urban League in its marketing context", canonical_key:"analyze_national_urban_league_in_its_marketing_c", status:"approved"}}, {concept_id:"4cb43010-40a4-5041-8d3d-346543d748a4", kc_id:"4cb43010-40a4-5041-8d3d-346543d748a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Natural Grocers and analyze its role in the textbook's treatment of ethical issues in retailing and wholesaling. Source: printed page 642. Evidence excerpt: There are other supermarkets known for ethical practices. These include Natural Grocers, Sprouts, Costco, and Whole Foods.47", label:"Analyze Natural Grocers in its marketing context", canonical_key:"analyze_natural_grocers_in_its_marketing_context", status:"approved"}}, {concept_id:"29d3bdae-29d5-5a96-b4fb-d1315f881d64", kc_id:"29d3bdae-29d5-5a96-b4fb-d1315f881d64", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nature Valley and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 345. Evidence excerpt: • New-to-the-World Products: New-to-the-world products essentially are new inventions that create new markets. Some examples from products recently introduced include biomagnetic ear stickers for weight loss, cat self-groomers, and portable blenders.3 • New-to-the-Firm Products: These are products that are new to a company but not to the world. It’s likely that marketers have seen a gap in the market and their product line and attempted to fill that void by adding a “me-too” type of product to their product line. For example, Nature Valley originally only made granola cereal but later introduced granola bars that could be eaten “on the go.”4 There’s a perfect example of a company…", label:"Analyze Nature Valley in its marketing context", canonical_key:"analyze_nature_valley_in_its_marketing_context", status:"approved"}}, {concept_id:"c9188bac-e59d-542d-be96-8a858e32966c", kc_id:"c9188bac-e59d-542d-be96-8a858e32966c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify NBA and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 12. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/1-in-the-spotlight) In 2020 Gatorade launched an impactful digital strategy. When NBA games were canceled due to the pandemic, ESPN aired a 10-part documentary, “The Last Dance,” about Michael Jordan’s last year with the Chicago Bulls. Because Gatorade wasn’t an official sponsor, it partnered with the NBA to stream 1998’s Game 6 featuring the Jazz versus the Bulls in what would be superstar Jordan’s last game with the Bulls. Gatorade sponsored a “watch party” keyed to the hashtag #Game6Live.5 Review Gatorade’s strategy on Twitter’s Marketing website (https://openstax.org/r/gatoradegame6live), which…", label:"Analyze NBA in its marketing context", canonical_key:"analyze_nba_in_its_marketing_context", status:"approved"}}, {concept_id:"f2c4da35-41c0-52c5-a23c-29c1db6c1b46", kc_id:"f2c4da35-41c0-52c5-a23c-29c1db6c1b46", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nest and analyze its role in the textbook's treatment of products, services, and experiences. Source: printed page 307. Evidence excerpt: But Peloton sees itself as a technology company that facilitates service. Peloton CEO John Foley has said that “we see ourself more akin to an Apple, a Tesla, or a Nest or a GoPro—where it’s a consumer product that has a foundation of sexy hardware technology and sexy software technology.”2 In the case of Peloton, that sexy software technology comes in the form of streaming workout classes including cycling, strength, boot camp, yoga, and meditation taught by charismatic instructors who have become social media influencers. The price tag for Peloton customers is a recurring $39 monthly fee for all access on top of the cost of the product.", label:"Analyze Nest in its marketing context", canonical_key:"analyze_nest_in_its_marketing_context", status:"approved"}}, {concept_id:"4abd1ac6-c3b8-5fce-b5e9-9798e1faa645", kc_id:"4abd1ac6-c3b8-5fce-b5e9-9798e1faa645", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nestlé and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 239. Evidence excerpt: It may seem obvious, but even language differences play a large role in the marketer’s job as products and services are rolled out in international markets. Brands and product names may have one meaning in the home country and a completely different meaning in another language. For example, Nestlé had problems when rolling out its Gerber baby food in France because “Gerber” translates to “puke” in French. For obvious reasons, this didn’t appeal to French parents choosing food for their infants.53", label:"Analyze Nestlé in its marketing context", canonical_key:"analyze_nestl_in_its_marketing_context", status:"approved"}}, {concept_id:"af5a4c3c-9998-55c9-b360-f1c70c0c3375", kc_id:"af5a4c3c-9998-55c9-b360-f1c70c0c3375", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Netflix and analyze its role in the textbook's treatment of the marketing mix and the 4ps of marketing. Source: printed page 20. Evidence excerpt: Netflix, JanSport, and Stranger Things A real-world promotional example is the recent brand partnership between Netflix and JanSport, the backpack company. These two companies collaborated on a Stranger Things–branded backpack with the", label:"Analyze Netflix in its marketing context", canonical_key:"analyze_netflix_in_its_marketing_context", status:"approved"}}, {concept_id:"422ad941-4dbb-589d-aef4-813990758ce3", kc_id:"422ad941-4dbb-589d-aef4-813990758ce3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify New Balance and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 554. Evidence excerpt: For businesses, Pinterest offers a host of benefits as a social marketing tool. First, 97 percent of searches are unbranded.20 Simply put, consumers aren’t looking for brand-specific content when browsing the platform. This is music to the ears of companies that can place their ads in Pinterest feeds near relevant content. For example, a user may search for “image of vintage running shoes” on Pinterest, which would result in a host of profiles featuring content related to the search terms. A well-placed New Balance advertisement featuring its vintage 720 sneaker would be a strategic marketing move in this situation (see Figure 16.8).", label:"Analyze New Balance in its marketing context", canonical_key:"analyze_new_balance_in_its_marketing_context", status:"approved"}}, {concept_id:"009ead92-42cc-5882-b497-0ad324102c2c", kc_id:"009ead92-42cc-5882-b497-0ad324102c2c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify New Belgium Brewery and analyze its role in the textbook's treatment of the benefits of sustainable marketing. Source: printed page 656. Evidence excerpt: Businesses have always been required to comply with environmental laws, but sustainable companies put the environment in the center, designing for the environment. New Belgium Brewery in Fort Collins, Colorado, is a foremost example of a company designed around the environment. The brand is committed to clean energy to combat climate change. New Belgium Brewery has three principles woven into its business model to keep management accountable for its sustainability goal of becoming carbon neutral by 2030. Those principles are to", label:"Analyze New Belgium Brewery in its marketing context", canonical_key:"analyze_new_belgium_brewery_in_its_marketing_con", status:"approved"}}, {concept_id:"bf308806-b50b-54a8-8f07-ec9f80d9e959", kc_id:"bf308806-b50b-54a8-8f07-ec9f80d9e959", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify New York Times and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 87. Evidence excerpt: The Blue Zones became a New York Times best seller. Media attention followed, and soon there was increased interest in the lifestyles within the Blue Zones. People began to recognize the Blue Zones as the happiest places to live. Communities were looking for ways to emulate the lifestyles and successes of these regions and in turn boost their longevity.", label:"Analyze New York Times in its marketing context", canonical_key:"analyze_new_york_times_in_its_marketing_context", status:"approved"}}, {concept_id:"0f8c1793-c9b8-5242-a630-661cb3980c71", kc_id:"0f8c1793-c9b8-5242-a630-661cb3980c71", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify NewVantage Partners and analyze its role in the textbook's treatment of marketing research and big data. Source: printed page 199. Evidence excerpt: “Big data has become one of the most valuable assets held by enterprises, and virtually every large organization is making investments in big data initiatives.”4 This statement was based on a 2021 NewVantage Partners survey of senior C-level executives at Fortune 1000 companies regarding their perceptions of big data and their utilization of its resources. NewVantage Partners learned that many companies are already pursuing this data, with 96 percent reporting that their companies have already had success using big data and artificial intelligence programs. Additionally, 99 percent of the executives surveyed are pursuing either new or existing big data programs. Why are companies…", label:"Analyze NewVantage Partners in its marketing context", canonical_key:"analyze_newvantage_partners_in_its_marketing_con", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"6ef87826-a0d6-5b94-8cd1-d93cb03f6b10", kc_id:"6ef87826-a0d6-5b94-8cd1-d93cb03f6b10", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify NFL and analyze its role in the textbook's treatment of the global market and advantages of international trade. Source: printed page 229. Evidence excerpt: A final major advantage to international trade is the ability to dispose of surplus goods. For example, prior to each Super Bowl, the NFL makes clothing for both teams that states each is the winner so that supply is available immediately after the game. However, only the winning team’s clothing is sold after the game. Rather than the losing team’s clothing going to the landfills, it is donated to other countries, decreasing the waste of the unsold product.14 Do not confuse the disposal of surplus goods with the concept of dumping, an illegal practice that will be discussed later in the chapter.", label:"Analyze NFL in its marketing context", canonical_key:"analyze_nfl_in_its_marketing_context", status:"approved"}}, {concept_id:"61b7cf57-4f7d-5d5e-9e5f-9204c9ae375b", kc_id:"61b7cf57-4f7d-5d5e-9e5f-9204c9ae375b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify NFLshop.com and analyze its role in the textbook's treatment of metrics used to evaluate the success of online marketing. Source: printed page 563. Evidence excerpt: Let’s suppose that you wanted to purchase a Tampa Bay NFL jersey. You are interested in finding one at the lowest price possible. You’re also interested in the team’s home jersey. You may type in the search engine bar: Tampa Jersey in white. Retailers like Fanatics and NFLshop.com will appear at the top of the search results page next to the word “Ad.” If NFLshop.com appears first, it won the auction over the search keywords you entered.", label:"Analyze NFLshop.com in its marketing context", canonical_key:"analyze_nflshop_com_in_its_marketing_context", status:"approved"}}, {concept_id:"679ed5a9-6e2c-5804-a882-acc8f03e876d", kc_id:"679ed5a9-6e2c-5804-a882-acc8f03e876d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nickelodeon and analyze its role in the textbook's treatment of ethical concerns in advertising and public relations. Source: printed page 495. Evidence excerpt: The vape company Juul found itself in hot water in 2019 when it was accused of marketing to teens. The company advertised its product—intended for adults only—on websites such as Nickelodeon, the Cartoon Network, and Seventeen, all sites directed toward youth.27", label:"Analyze Nickelodeon in its marketing context", canonical_key:"analyze_nickelodeon_in_its_marketing_context", status:"approved"}}, {concept_id:"2fe25854-cf57-559f-93f3-f0d04c1a1d7d", kc_id:"2fe25854-cf57-559f-93f3-f0d04c1a1d7d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nielsen Company and analyze its role in the textbook's treatment of the use of metrics to measure advertising campaign effectiveness. Source: printed page 486. Evidence excerpt: Nielsen If you’re going to be a marketer, you’re going to need to know Nielsen Company, a “global leader in audience measurement, data and analytics, shaping the future of media.”10 To better understand what the Nielsen Company is about, read this Investopedia article. (https://openstax.org/r/investopedia)", label:"Analyze Nielsen Company in its marketing context", canonical_key:"analyze_nielsen_company_in_its_marketing_context", status:"approved"}}, {concept_id:"46284759-c35e-563d-8171-f72fd8519023", kc_id:"46284759-c35e-563d-8171-f72fd8519023", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nike and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 98. Evidence excerpt: A subculture is a group of people, such as environmentalists or bodybuilders, who share a set of values. Ethnic and racial groups share the language, food, and culture of their heritage. Other subcultures, like the biker culture, which revolves around a dedication to motorcycles, are united by shared experiences. The Amish subculture is known for its conservative beliefs and reluctance to adapt to modern technology. Think about what subculture(s) you may belong to and how they influence your buying behavior. For example, hip-hop music has long been associated with fashion, particularly sneakers. Run DMC’s 1986 hit “My Adidas” led to the first endorsement deal between a fashion…", label:"Analyze Nike in its marketing context", canonical_key:"analyze_nike_in_its_marketing_context", status:"approved"}}, {concept_id:"4937204b-80f1-556f-abaa-067be1101ed7", kc_id:"4937204b-80f1-556f-abaa-067be1101ed7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nivea and analyze its role in the textbook's treatment of the global market and advantages of international trade. Source: printed page 230. Evidence excerpt: Two examples of companies not readily prepared come from Nivea and Gucci. In 2017, Nivea launched a social media campaigned stating “White Is Purity.” The phrase was perceived by the public as being racially insensitive. To make matters worse, the slogan was then used by white supremacists in their propaganda.17 While the company apologized and removed the campaign, these marketers should never have let the campaign leave the idea room. In 2019, luxury fashion designer Gucci introduced a balaclava knit jumper that had material that went up and around the mouth. The advertisement for this clothing featured a White woman modeling the sweater with bright red lipstick. Many critics…", label:"Analyze Nivea in its marketing context", canonical_key:"analyze_nivea_in_its_marketing_context", status:"approved"}}, {concept_id:"7eb4fe67-df6c-5d17-a14a-554b7ecaf9d0", kc_id:"7eb4fe67-df6c-5d17-a14a-554b7ecaf9d0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nordstrom and analyze its role in the textbook's treatment of steps in a successful marketing research plan. Source: printed page 223. Evidence excerpt: From customer interactions, observation, online data, and careful marketing research, Nordstrom Local emerged. One key piece of information was that 35 percent of customers who place an online order first visited a store to help guide the purchase decision.33 With Los Angeles and New York as the top markets, Nordstrom needed methods to connect with and help ease the purchase process for its customers in these locations.", label:"Analyze Nordstrom in its marketing context", canonical_key:"analyze_nordstrom_in_its_marketing_context", status:"approved"}}, {concept_id:"afbbdf38-994f-58b4-a491-a8a5084c2d39", kc_id:"afbbdf38-994f-58b4-a491-a8a5084c2d39", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Nothing Bundt Cakes and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 558. Evidence excerpt: Mobile marketing presents clear opportunities for digital marketers. First, mobile device usage continues to grow as consumers stratify their time across various devices at once. In addition, mobile devices allow people to experience almost constant connectivity that ignores the boundaries that traditional marketing channels must observe, such as time and place. For example, Nothing Bundt Cakes’ store hours of operation might be 10:00 a.m. to 6:00 p.m. However, accessing its website to place an order can happen at any time of day from any location.", label:"Analyze Nothing Bundt Cakes in its marketing context", canonical_key:"analyze_nothing_bundt_cakes_in_its_marketing_con", status:"approved"}}, {concept_id:"6ac926dc-52ee-5e67-a390-fbd7743ad224", kc_id:"6ac926dc-52ee-5e67-a390-fbd7743ad224", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ocean Park and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 238. Evidence excerpt: When the Walt Disney Company decided to open Disneyland Hong Kong in 2005, the company struggled to gain momentum with its Chinese target market. Among other blunders, such as its high admission price, the company assumed that its Chinese market would love the Disney brand as much as Americans do. The company failed to realize that, unlike Americans, the Chinese did not grow up with the Disney brands and characters. Imagine walking into a fantasy theme park with characters you had never heard of or seen before. Unlike Americans, the Chinese do not view Disney characters as cultural icons. The fantasy aspect of the brand and park was another issue Disney faced. Its closest…", label:"Analyze Ocean Park in its marketing context", canonical_key:"analyze_ocean_park_in_its_marketing_context", status:"approved"}}, {concept_id:"ccf9f384-ce69-516b-9f08-2292cf2ce112", kc_id:"ccf9f384-ce69-516b-9f08-2292cf2ce112", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Office Depot and analyze its role in the textbook's treatment of the business-to-business (b2b) market. Source: printed page 128. Evidence excerpt: Many businesses have both B2B and B2C components. For example, consider Office Depot. You may have stopped into an Office Depot store before the semester to stock up on pens, a ream of paper for your printer, or notebooks. That’s a B2C transaction. However, a large law firm or an accounting firm might order hundreds of reams of copy paper, folders, and print cartridges from Office Depot. That’s a B2B transaction.", label:"Analyze Office Depot in its marketing context", canonical_key:"analyze_office_depot_in_its_marketing_context", status:"approved"}}, {concept_id:"2a58e712-b2ef-5fd8-a006-c571c1ec8a63", kc_id:"2a58e712-b2ef-5fd8-a006-c571c1ec8a63", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Old Navy and analyze its role in the textbook's treatment of marketing strategies at each stage of the product life cycle. Source: printed page 318. Evidence excerpt: A rapid penetration pricing strategy is appropriate when volume sales will increase market share quickly, and a lower-priced strategy is employed. Rapid penetration pricing strategies encourage customers to try a product and switch to a new brand. This strategy works well with product categories with many competitors and price-sensitive customers. For example, Old Navy used a rapid penetration pricing strategy when it opened its stores in 1994 with an $8 jeans promotion under the assumption that if customers tried its jeans, they would be hooked and become brand advocates.", label:"Analyze Old Navy in its marketing context", canonical_key:"analyze_old_navy_in_its_marketing_context", status:"approved"}}, {concept_id:"46b04d51-6b0e-5a99-8f75-8fe24b39c999", kc_id:"46b04d51-6b0e-5a99-8f75-8fe24b39c999", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Oracle and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 26. Evidence excerpt: California to Texas, following similar announcements by Hewlett Packard Enterprise (HPE) and Oracle, citing such things as lower housing costs and tax rates and fewer regulations, making it easier for companies to operate in Texas. • Economic Factors. Economic factors play a huge role in terms of a company’s prospects in a market. For example, economic factors affect pricing and can even influence the supply/demand curve for a product or service. For example, high inflation causes consumers to have less spending power, which translates into lower sales and revenue. In 2022, consumers experienced both product shortages and higher prices, blamed largely on COVID-19, Russia’s war on…", label:"Analyze Oracle in its marketing context", canonical_key:"analyze_oracle_in_its_marketing_context", status:"approved"}}, {concept_id:"313c00c8-47c2-5ca6-995d-e76d817e810d", kc_id:"313c00c8-47c2-5ca6-995d-e76d817e810d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Oreo and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 325. Evidence excerpt: Line extensions create new opportunities for an existing product and brand to serve customers. For example, the Oreo brand adds flavors to its product line for holidays. These line extensions provide the existing brand with an extension of its current product. As a result, a line extension may sell more products to already-aware and interested customers without many risks. However, sometimes brands may overextend their product lines and products may be too similar, failing to increase sales.", label:"Analyze Oreo in its marketing context", canonical_key:"analyze_oreo_in_its_marketing_context", status:"approved"}}, {concept_id:"86fcdd94-3a66-56fb-a20b-9d2c5ce1e74b", kc_id:"86fcdd94-3a66-56fb-a20b-9d2c5ce1e74b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Osage Outlets and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Sawgrass Mills Factory Outlet, Overstock or over-manufactured brand-name items, Indiana Premium Outlets, Factory outlet usually clothing; typically in a mall setting with other Osage Outlets; Hanes Outlet, factory outlets L.L.Bean Outlet", label:"Analyze Osage Outlets in its marketing context", canonical_key:"analyze_osage_outlets_in_its_marketing_context", status:"approved"}}, {concept_id:"3f45635d-e035-50e2-bf3f-6e956be48de5", kc_id:"3f45635d-e035-50e2-bf3f-6e956be48de5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify OSI and analyze its role in the textbook's treatment of buyers and buying situations in a b2b market. Source: printed page 132. Evidence excerpt: the dozens of components that go into the product’s manufacturing—circuit boards, LCDs, speakers, microphones, batteries, etc. The producer needs to purchase these components from various vendors. This is a large market for B2B sellers, because producers don’t typically buy in small quantities. For example, OSI supplies 45 million pounds of steak, salsa, beans, and other food products for Chipotle and has been supplying meat to McDonald’s for over 50 years. From a marketing perspective, that’s the kind of B2B relationship you want to pursue!4", label:"Analyze OSI in its marketing context", canonical_key:"analyze_osi_in_its_marketing_context", status:"approved"}}, {concept_id:"42d5dbd4-9354-5f38-910f-cc9d212fcc92", kc_id:"42d5dbd4-9354-5f38-910f-cc9d212fcc92", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Outstanding Foods and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 575. Evidence excerpt: After testing their product, they opted for a nationwide launch and distribution strategy. Using a broker network, they selected distribution channels that aligned with both natural and mainstream grocery stores. This strategy would help secure the national target market coverage they were looking for. The product strategy of natural ingredients gave Outstanding Foods the green light it needed to meet Whole Foods’ strict food standards. Through their partnership, Whole Foods and Outstanding Foods are able to create and deliver value to their vegan customer base who appreciate access to food products that are tasty and bring delight.", label:"Analyze Outstanding Foods in its marketing context", canonical_key:"analyze_outstanding_foods_in_its_marketing_conte", status:"approved"}}, {concept_id:"ea3af1a9-73dc-539c-9638-85b4b63a9caa", kc_id:"ea3af1a9-73dc-539c-9638-85b4b63a9caa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify OXO and analyze its role in the textbook's treatment of marketing strategies at each stage of the product life cycle. Source: printed page 318. Evidence excerpt: Brands may improve product quality or add new features in the growth stage based on early lessons from the introduction stage and to fend off competitors. Products with a first-mover advantage may find competitors who replicate their products entering the market, so product improvement is essential. For example, OXO is a brand that uses universal design to innovate products to make them easier to use. This continuous product improvement makes it a leader in the kitchenware market.", label:"Analyze OXO in its marketing context", canonical_key:"analyze_oxo_in_its_marketing_context", status:"approved"}}, {concept_id:"bbf33ffb-b2c1-57c9-baa8-18385a3ebeda", kc_id:"bbf33ffb-b2c1-57c9-baa8-18385a3ebeda", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Panama City Beach and analyze its role in the textbook's treatment of the five critical cs of pricing. Source: printed page 413. Evidence excerpt: Compatibility Panama City Beach has been one of the most popular spring break destinations of college students for decades. In fact, it is considered the “Spring Break Capital of the World.”18 It is well-known for its late-night parties, concerts, and celebrity sightings. Hotels and clubs along the beach of Panama City drive their marketing efforts toward this segment of the market: college-aged spring break–goers. The prices they set for the weeks of spring break are compatible with both this segment of the market’s ability to pay and the businesses’ profitability. Conversely, hotels in areas of Florida that are more family-friendly set prices that are considered a value for…", label:"Analyze Panama City Beach in its marketing context", canonical_key:"analyze_panama_city_beach_in_its_marketing_conte", status:"approved"}}, {concept_id:"4a2ea057-8ace-547a-b318-3a484f94c70b", kc_id:"4a2ea057-8ace-547a-b318-3a484f94c70b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Panera Bread and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 60. Evidence excerpt: Now we’ll switch over to external factors that affect the business. Opportunities are openings for something positive to happen if (and only if) you can capitalize on them. Opportunities can be moving into a new market segment that offers improved profits (like a snack food manufacturer moving into the health foods sector), competitors that have quality or delivery problems, or impending legislation that would favorably affect your organization if you’re able to capitalize on it. Once again, let’s go back to Starbucks. If you were preparing a SWOT analysis for Starbucks, some of its opportunities might be expansion in developing markets, a coffee subscription service similar to…", label:"Analyze Panera Bread in its marketing context", canonical_key:"analyze_panera_bread_in_its_marketing_context", status:"approved"}}, {concept_id:"bc1345af-3164-5ea6-91c2-1e1189357428", kc_id:"bc1345af-3164-5ea6-91c2-1e1189357428", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Partnership for a Healthier America (PHA) and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 189. Evidence excerpt: But Subway didn’t stop there. The company also teamed up with the Partnership for a Healthier America (PHA), a nonprofit organization that works with the private sector to help advance the goals of Mrs. Obama’s Let’s Move! initiative.", label:"Analyze Partnership for a Healthier America (PHA) in its marketing context", canonical_key:"analyze_partnership_for_a_healthier_america_pha_", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"5ff3fdf0-8813-5ef2-b506-15006d1ea632", kc_id:"5ff3fdf0-8813-5ef2-b506-15006d1ea632", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Patagonia and analyze its role in the textbook's treatment of ethical issues in consumer buying behavior. Source: printed page 117. Evidence excerpt: Ethics and Corporations Hundreds of companies are known for being ethical, including Patagonia (more information later in this chapter), TOMS, and Conscious Coffees, among others. Read about five examples of truly ethical companies (https://openstax.org/r/trulyethicalcompanies) and how they are working to make an impact in their markets.", label:"Analyze Patagonia in its marketing context", canonical_key:"analyze_patagonia_in_its_marketing_context", status:"approved"}}, {concept_id:"75747009-6cce-5f8b-9ad8-72f03bfcb33f", kc_id:"75747009-6cce-5f8b-9ad8-72f03bfcb33f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Paychex and analyze its role in the textbook's treatment of management of the sales force. Source: printed page 519. Evidence excerpt: Quantitative assessments focus on the items that can be measured. They are less subjective and allow the sales manager to focus on the goals and objectives set for the sales force. A quantitative assessment may include a scale to rank activities of the sales force. For example, Paychex may evaluate the sales force based on", label:"Analyze Paychex in its marketing context", canonical_key:"analyze_paychex_in_its_marketing_context", status:"approved"}}, {concept_id:"425f022a-c50d-57e1-aca3-b596cf9259ea", kc_id:"425f022a-c50d-57e1-aca3-b596cf9259ea", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify PEEPS and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze PEEPS in its marketing context", canonical_key:"analyze_peeps_in_its_marketing_context", status:"approved"}}, {concept_id:"052c4af5-0292-5889-94b1-fa71c25b186f", kc_id:"052c4af5-0292-5889-94b1-fa71c25b186f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Peloton and analyze its role in the textbook's treatment of products, services, and experiences. Source: printed page 307. Evidence excerpt: But Peloton sees itself as a technology company that facilitates service. Peloton CEO John Foley has said that “we see ourself more akin to an Apple, a Tesla, or a Nest or a GoPro—where it’s a consumer product that has a foundation of sexy hardware technology and sexy software technology.”2 In the case of Peloton, that sexy software technology comes in the form of streaming workout classes including cycling, strength, boot camp, yoga, and meditation taught by charismatic instructors who have become social media influencers. The price tag for Peloton customers is a recurring $39 monthly fee for all access on top of the cost of the product.", label:"Analyze Peloton in its marketing context", canonical_key:"analyze_peloton_in_its_marketing_context", status:"approved"}}, {concept_id:"45aa5df3-741d-506d-a5c3-23e9433c1ac9", kc_id:"45aa5df3-741d-506d-a5c3-23e9433c1ac9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Penguin/Random House and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 62. Evidence excerpt: The concept of concentric diversification revolves around the addition of similar products or services to an existing business.48 If a picture is worth a thousand words, then an example has to be worth even more, particularly an example to which you can easily relate as a student. As you’re reading this chapter, consider book publishers, like Harper Collins, Simon & Schuster, or Penguin/Random House. These book publishers don’t only print the works of one author; rather, they have hundreds or perhaps thousands of authors’ works in their arsenals. These publishers will publish print books, e-books (like the one you’re reading right now), and audiobooks and may even sell the rights…", label:"Analyze Penguin/Random House in its marketing context", canonical_key:"analyze_penguin_random_house_in_its_marketing_co", status:"approved"}}, {concept_id:"aeca74ec-730a-5b66-ab99-4a6209ee559c", kc_id:"aeca74ec-730a-5b66-ab99-4a6209ee559c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pepperidge Farm and analyze its role in the textbook's treatment of main types of sales promotion. Source: printed page 526. Evidence excerpt: Contests make consumers use their skills to compete for prizes. Using contests allows customers to engage with products and become invested in the process of trying to win something of value. Companies often use contests in coordination with other sales promotion tactics, such as coupons. Doritos regularly includes a contest as part of its advertising. Pepperidge Farm challenged consumers to #GoForTheHandful and create an Instagram duet with pro basketball player Boban Marjanović. The goal was to see if consumers could hold more Goldfish crackers in their tiny hands compared to the large hands of the pro basketball player. Winners were treated to Goldfish for a year and the title…", label:"Analyze Pepperidge Farm in its marketing context", canonical_key:"analyze_pepperidge_farm_in_its_marketing_context", status:"approved"}}, {concept_id:"44b31665-027c-57a9-8120-b1fdba19367c", kc_id:"44b31665-027c-57a9-8120-b1fdba19367c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify PepsiCo and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 11. Evidence excerpt: In the Spotlight Since its launch in 1967, Gatorade has been a power player in the sports drink beverage category. Gatorade dominates the US sports drink market, garnering 67.7 percent of the market, followed distantly by the Coca- Cola Company’s Powerade and BodyArmor brands at 13.7 percent and 9.3 percent, respectively.1 The fact that Gatorade has maintained such a large market share demonstrates parent company PepsiCo’s understanding of the marketing mix (i.e., product, price, place, and promotion), how to integrate these elements for its target market, and how to continually adapt its marketing mix to meet changing consumer demands.", label:"Analyze PepsiCo in its marketing context", canonical_key:"analyze_pepsico_in_its_marketing_context", status:"approved"}}, {concept_id:"9948bca3-381a-5053-a2e2-01ea0b0bfeb3", kc_id:"9948bca3-381a-5053-a2e2-01ea0b0bfeb3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Personalized Media Communications LLC and analyze its role in the textbook's treatment of ethical considerations in new product development. Source: printed page 364. Evidence excerpt: For example, in March 2021, a jury ruled against Apple for patent infringement and ordered it to pay over $300 million to Personalized Media Communications LLC. That same year, a judge ruled that Google had infringed on five patents owned by Sonos, and if the ruling is upheld, it may result in the ban of imports of products like Google Home and Pixel smartphones.47", label:"Analyze Personalized Media Communications LLC in its marketing context", canonical_key:"analyze_personalized_media_communications_llc_in", status:"approved"}}, {concept_id:"831ac25c-36bc-59b7-978e-d8c553e4ea57", kc_id:"831ac25c-36bc-59b7-978e-d8c553e4ea57", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Petco and analyze its role in the textbook's treatment of factors influencing channel choice. Source: printed page 589. Evidence excerpt: Companies must also consider how their target market values variety. Imagine walking into a pet supply store and only seeing one type of pet food. Buyers generally have a desire to choose from a variety of competing products. Petco and PetSmart recognize that consumers appreciate variety in everything from pet food to pet supplies such as toys, leashes, and bedding. For companies who compete in a crowded market where buyers have many options, selecting outlets that offer a variety of similar and competing products makes the most sense.", label:"Analyze Petco in its marketing context", canonical_key:"analyze_petco_in_its_marketing_context", status:"approved"}}, {concept_id:"f31be9cb-e6fe-511b-872d-8e08087c11a3", kc_id:"f31be9cb-e6fe-511b-872d-8e08087c11a3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify PetSmart and analyze its role in the textbook's treatment of factors influencing channel choice. Source: printed page 589. Evidence excerpt: Companies must also consider how their target market values variety. Imagine walking into a pet supply store and only seeing one type of pet food. Buyers generally have a desire to choose from a variety of competing products. Petco and PetSmart recognize that consumers appreciate variety in everything from pet food to pet supplies such as toys, leashes, and bedding. For companies who compete in a crowded market where buyers have many options, selecting outlets that offer a variety of similar and competing products makes the most sense.", label:"Analyze PetSmart in its marketing context", canonical_key:"analyze_petsmart_in_its_marketing_context", status:"approved"}}, {concept_id:"65271ed7-2dbe-5a70-b97c-412e87e844c1", kc_id:"65271ed7-2dbe-5a70-b97c-412e87e844c1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify PetVivo and analyze its role in the textbook's treatment of managing the distribution channel. Source: printed page 593. Evidence excerpt: The channel members that a company selects depends entirely on the company’s evaluation of the channel member alternatives. Manufacturers should examine each channel member’s years in business and experience carrying product lines. They should also evaluate each member’s reputation and its profitability. PetVivo, maker of biomedical devices for pets, selected Vetcove to distribute a device for pets with osteoporosis. Because PetVivo needed to reach veterinary hospitals and clinics across all 50 states, Vetcove was the right choice because of its experience serving over 13,000 veterinary hospitals and clinics. Its expertise and reputation were attractive characteristics for…", label:"Analyze PetVivo in its marketing context", canonical_key:"analyze_petvivo_in_its_marketing_context", status:"approved"}}, {concept_id:"e32e8c1f-9e21-52be-8cb2-9d699a5f4603", kc_id:"e32e8c1f-9e21-52be-8cb2-9d699a5f4603", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pew Research Center and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 281. Evidence excerpt: A 2019 survey by the Pew Research Center shows that nearly 75 percent of Black people believe that race is at the center of their identity.54 Race is deeply tied to how people perceive themselves. When it comes to defining the Black identity further, the community is also facing a unique challenge. There is a growing argument in the United States over differences between Black people who emigrated from Africa and those who did not. The debate is caused by the ancestral link to slavery that many American-born Black people have but immigrants do not. Plus, Black people can also have other subethnicities such as Black Hispanic and multiracial (White, Asian, or Native American).…", label:"Analyze Pew Research Center in its marketing context", canonical_key:"analyze_pew_research_center_in_its_marketing_con", status:"approved"}}, {concept_id:"b5b613af-7991-5995-91d4-846491036caa", kc_id:"b5b613af-7991-5995-91d4-846491036caa", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pfizer and analyze its role in the textbook's treatment of management of the sales force. Source: printed page 517. Evidence excerpt: For example, Pfizer has a neuroscience product and structures its sales force by product, customer type/size, and geography. The Pfizer pharmaceutical sales representative for the neuroscience product calls on neurologists, represents only one or two products so that they are an expert on the efficacy and uses, and has a very tight geographical territory, usually focused on a few zip codes depending on the number of neurological medical practices in a given area.", label:"Analyze Pfizer in its marketing context", canonical_key:"analyze_pfizer_in_its_marketing_context", status:"approved"}}, {concept_id:"24102392-a1d6-547d-841a-41fef4405e23", kc_id:"24102392-a1d6-547d-841a-41fef4405e23", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pharmaceutical Research and Manufacturers of America and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: For example, in 2020, the National Association of Realtors was the top lobbying association in the United States, followed by the US Chamber of Commerce, Pharmaceutical Research and Manufacturers of America, and the American Hospital Association. Together, these associations spent over $200 million lobbying to impact local, state, and federal legislation.18", label:"Analyze Pharmaceutical Research and Manufacturers of America in its marketing context", canonical_key:"analyze_pharmaceutical_research_and_manufacturer", status:"approved"}}, {concept_id:"66ddeb84-5b5e-55c2-a4e1-54e1a0cd64a4", kc_id:"66ddeb84-5b5e-55c2-a4e1-54e1a0cd64a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pinterest and analyze its role in the textbook's treatment of purpose and structure of the marketing plan. Source: printed page 67. Evidence excerpt: • Pinterest: “Help people discover the things they love, and inspire them to go do those things in their daily lives”52 • Spotify: “To unlock the potential of human creativity by giving a million creative artists the opportunity to", label:"Analyze Pinterest in its marketing context", canonical_key:"analyze_pinterest_in_its_marketing_context", status:"approved"}}, {concept_id:"be685265-8eb5-57b4-9407-13be5b535df6", kc_id:"be685265-8eb5-57b4-9407-13be5b535df6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pitbull and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 267. Evidence excerpt: Modelo Especial is a good example. Modelo Especial is a Mexican beer that has successfully capitalized on its heritage to target the Hispanic population while also appealing to the general market. Marketed by Constellation Brands, the beer has had strong sales in the United States since the 1990s.17 In 2019, Hispanic consumers captured close to 70 percent of the brand’s national sales, but Hispanic people are only about half of the customer base.18 Over the course of several decades, various aspects of Hispanic culture have been widely embraced in the United States. Have you heard of artists like Jennifer Lopez, Pitbull, Bad Bunny, and J Balvin? The marketing team at…", label:"Analyze Pitbull in its marketing context", canonical_key:"analyze_pitbull_in_its_marketing_context", status:"approved"}}, {concept_id:"f9095d53-d89a-5566-b86c-2b01a789fad8", kc_id:"f9095d53-d89a-5566-b86c-2b01a789fad8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pop-Tarts and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 322. Evidence excerpt: A brand name should also translate effectively into a variety of languages. Finally, a brand name should be unique to that product. For example, we all know that the brand Pop-Tarts is a toaster pastry that pops out of a toaster. This is a distinctive element of the Pop-Tarts brand that is exemplified by its name.", label:"Analyze Pop-Tarts in its marketing context", canonical_key:"analyze_pop_tarts_in_its_marketing_context", status:"approved"}}, {concept_id:"c076f37f-3859-5449-bb21-7ea6d65692cc", kc_id:"c076f37f-3859-5449-bb21-7ea6d65692cc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Precycle and analyze its role in the textbook's treatment of retailing and the role of retailers in the distribution channel. Source: printed page 611. Evidence excerpt: Precycle is a grocery store in the Bushwick neighborhood of Brooklyn, New York. In order to differentiate her store from other local shops, Precycle owner Katerina Bogatireva decided to focus her efforts on serving a niche market of consumers who are committed to protecting the environment. Shoppers at Precycle can find a wide variety of spices, fruits, grains, pastas, toothbrushes, and many household basics. But what shoppers won’t find at Precycle is plastic. Bogatireva opened the store in an effort to reduce the amount of plastic that is used in retailing. All the items in Precycle are not only free from plastic and sold in bulk, they are locally sourced.1", label:"Analyze Precycle in its marketing context", canonical_key:"analyze_precycle_in_its_marketing_context", status:"approved"}}, {concept_id:"a243d2d7-0209-535e-b18b-0ce15ef5b0cd", kc_id:"a243d2d7-0209-535e-b18b-0ce15ef5b0cd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Pritchard and analyze its role in the textbook's treatment of strategic marketing: standardization versus adaptation. Source: printed page 260. Evidence excerpt: Diversity in marketing is often shortsightedly thought of as simply featuring people, objects, or situations linked to various cultural or sociodemographic groups in marketing efforts. These are important components, but diversity marketing goes much deeper than that. In a 2021 keynote presentation about advancing diversity in advertising and business, P&G Chief Brand Officer Marc Pritchard emphasized that the company’s commitment to consumers extends to race, ethnicity, and gender representation equal to the American population.3", label:"Analyze Pritchard in its marketing context", canonical_key:"analyze_pritchard_in_its_marketing_context", status:"approved"}}, {concept_id:"e139ff7a-cbaa-5b96-a4b3-697092dd65de", kc_id:"e139ff7a-cbaa-5b96-a4b3-697092dd65de", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Proactiv and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 543. Evidence excerpt: Infomercials often feature a spokesperson promoting the benefits of a product. In many cases, there is a persuasive demonstration of the product, and viewers are called to “act now.” Some of the most well- remembered infomercial products include the Snuggie, Magic Bullet, and Proactiv. A carefully executed commercial coupled with the right product can generate billions of dollars for companies. Proactiv, for example, which was rebranded as Alchemee in 2022, generated $1 billion in sales in 2020 from its famous acne skin-care line.5", label:"Analyze Proactiv in its marketing context", canonical_key:"analyze_proactiv_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"f16bf25e-8c65-55d3-ad35-bc174a122657", kc_id:"f16bf25e-8c65-55d3-ad35-bc174a122657", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Procter & Gamble and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 49. Evidence excerpt: Consider, for example, Procter & Gamble. The producer of such diverse products as diapers, Tide detergent, and Oral-B toothpaste has five industry-based strategic business units—baby, feminine, and family care; beauty; health care; grooming; and fabric and home care, family care, and new ventures. Each of these SBUs has its own chief executive officer and functions essentially as a standalone business under the corporate “umbrella.”5", label:"Analyze Procter & Gamble in its marketing context", canonical_key:"analyze_procter_gamble_in_its_marketing_context", status:"approved"}}, {concept_id:"1cffafda-6bd3-5fb1-a818-9097674946bc", kc_id:"1cffafda-6bd3-5fb1-a818-9097674946bc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Prospanica and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze Prospanica in its marketing context", canonical_key:"analyze_prospanica_in_its_marketing_context", status:"approved"}}, {concept_id:"732b575d-11c3-577e-b2da-c1cf38525b0e", kc_id:"732b575d-11c3-577e-b2da-c1cf38525b0e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Publishers Clearing House and analyze its role in the textbook's treatment of main types of sales promotion. Source: printed page 526. Evidence excerpt: Where contests are based on skill, sweepstakes are based on chance. Companies use sweepstakes in order to increase sales volume in the short term. Sweepstakes ask contestants to submit their names for inclusion in a drawing for prizes. Publishers Clearing House conducts one of the most well-known sweepstakes. The company ultimately wants consumers to order magazines; however, the purchase of a magazine is not necessary to enter and win the $1 million cash prize. However, Publishers Clearing House is able to add to its mailing list when consumers enter to win.", label:"Analyze Publishers Clearing House in its marketing context", canonical_key:"analyze_publishers_clearing_house_in_its_marketi", status:"approved"}}, {concept_id:"dda623c2-abde-539b-918f-d919f9bf91ce", kc_id:"dda623c2-abde-539b-918f-d919f9bf91ce", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Publix and analyze its role in the textbook's treatment of main types of sales promotion. Source: printed page 528. Evidence excerpt: Advertising can be expensive for retailers. Typically, they advertise products they have in stock in an effort to induce consumers to come in and make a purchase. Cooperative advertising is a way for manufacturers to help with the cost of the advertising, in exchange for the retailer to advertise the products produced by the manufacturer. When supermarket chain Publix advertises Boar’s Head meats and cheeses, Publix is using cooperative advertising from Boar’s Head to run the ads featuring Boar’s Head products.", label:"Analyze Publix in its marketing context", canonical_key:"analyze_publix_in_its_marketing_context", status:"approved"}}, {concept_id:"240a214f-8372-51fa-953a-a2f926f04ba8", kc_id:"240a214f-8372-51fa-953a-a2f926f04ba8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Purina and analyze its role in the textbook's treatment of logistics and its functions. Source: printed page 602. Evidence excerpt: Imagine if pet food maker Purina had to purchase its own warehousing and trucking business to store and move its goods all over the United States. It would be very costly and require a large capital commitment. In addition, 3PL providers offer the advantage of strategic location. They often market themselves as being located in the precisely right zones that a supply chain needs to reach targeted consumers.", label:"Analyze Purina in its marketing context", canonical_key:"analyze_purina_in_its_marketing_context", status:"approved"}}, {concept_id:"1461baf9-381b-5bdb-be0d-e4701784a1b4", kc_id:"1461baf9-381b-5bdb-be0d-e4701784a1b4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify QVC and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 624. Evidence excerpt: Another example of a non-store retailer is television home shopping. Television home shopping primarily targets women over the age of 40 and is a business practice in which products or services are sold via television. There are some cable network stations that are dedicated solely to home shopping 24 hours a day, 7 days a week. One example is QVC, which stands for Quality, Value, and Convenience. The company was founded in 1986 and purchased its rival Home Shopping Network (HSN) in 2017. It generated $14.1 billion in profits in 2018.17 The 2015 Hollywood movie Joy, starring Jennifer Lawrence, showcases real-life entrepreneur Joy Mangano and the power of QVC as a non-store…", label:"Analyze QVC in its marketing context", canonical_key:"analyze_qvc_in_its_marketing_context", status:"approved"}}, {concept_id:"d0100200-3599-5320-b24f-a8ae3c1990d7", kc_id:"d0100200-3599-5320-b24f-a8ae3c1990d7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ramblewood and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 341. Evidence excerpt: Zach and Riley quickly realized that every event they managed was in fact their “calling card.” Guests who attended Ramblewood events talked about the experience. Guests discussed the beauty of the flowers, the exceptional food, the layout and decor, and most importantly, how well the event flowed. Each event had elements that created “oohs” and “ahs” that prompted the question, Who created this event? Marketing through word of mouth and social media seemed to be creating the growth engine Zach and Riley were seeking.", label:"Analyze Ramblewood in its marketing context", canonical_key:"analyze_ramblewood_in_its_marketing_context", status:"approved"}}, {concept_id:"748ccf28-d085-5480-b822-c1355b32aaa5", kc_id:"748ccf28-d085-5480-b822-c1355b32aaa5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Red Bull and analyze its role in the textbook's treatment of purpose and structure of the marketing plan. Source: printed page 86. Evidence excerpt: Building Your Personal Brand There are many brands that recognize the benefits of hiring brand ambassadors. Red Bull is one of these brands. Because college students constitute a major portion of its target market, Red Bull relies on student ambassadors (also called Marketeers) to interact with customers. According to Red Bull’s Student Marketeer website, “student Marketeers are in direct contact with various consumers and customers, inviting product trial, helping establish Red Bull consumption in diverse occasions, supporting our sales teams, working with renowned athletes and of course ensuring an unforgettable brand experience for consumers at Red Bull events. Based on your…", label:"Analyze Red Bull in its marketing context", canonical_key:"analyze_red_bull_in_its_marketing_context", status:"approved"}}, {concept_id:"89c6a968-413d-5336-834a-5ea55e60cbb9", kc_id:"89c6a968-413d-5336-834a-5ea55e60cbb9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Reebok and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 98. Evidence excerpt: A subculture is a group of people, such as environmentalists or bodybuilders, who share a set of values. Ethnic and racial groups share the language, food, and culture of their heritage. Other subcultures, like the biker culture, which revolves around a dedication to motorcycles, are united by shared experiences. The Amish subculture is known for its conservative beliefs and reluctance to adapt to modern technology. Think about what subculture(s) you may belong to and how they influence your buying behavior. For example, hip-hop music has long been associated with fashion, particularly sneakers. Run DMC’s 1986 hit “My Adidas” led to the first endorsement deal between a fashion…", label:"Analyze Reebok in its marketing context", canonical_key:"analyze_reebok_in_its_marketing_context", status:"approved"}}, {concept_id:"5ac84116-8762-5aaa-b979-5fbf63577e95", kc_id:"5ac84116-8762-5aaa-b979-5fbf63577e95", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Refinitiv and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 654. Evidence excerpt: Governance structures can be examined to ensure diversity of leadership that aligns with the company’s various interested and influential groups. Fortune and Refinitiv partnered to develop a Measure Up initiative that aims to bring transparency to businesses diversity, equity, and inclusion work of the Fortune 500. The initiative reviewed measures such as policies, employee resource groups, percentage of minorities in board or leadership positions, and salary parity to determine a score for companies. Companies such as Microsoft, Target, and Gap rated highly on the criteria, demonstrating advanced diversity, equity, and inclusion.15 Amazon publishes its representation statistics…", label:"Analyze Refinitiv in its marketing context", canonical_key:"analyze_refinitiv_in_its_marketing_context", status:"approved"}}, {concept_id:"80f30947-3a8d-5224-953f-2f87635a29c0", kc_id:"80f30947-3a8d-5224-953f-2f87635a29c0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Regal and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 576. Evidence excerpt: The film industry provides a great example of the distribution decisions that marketers must make. Before a production company releases a new movie, it must decide which channels are best for distributing the movie to consumers. In today’s market, movie producers have a slew of distribution options, including Netflix, HBOMax, and YouTube, to name a few. They also have the option of distributing through traditional movie theaters, such as AMC or Regal. Regardless of the marketing channel they pursue, their goal is to distribute their movie to the right customers at the right place and at the right time. Production companies will choose the marketing channel that is most efficient…", label:"Analyze Regal in its marketing context", canonical_key:"analyze_regal_in_its_marketing_context", status:"approved"}}, {concept_id:"40fa9d70-d3f6-509c-a88f-7de89a02451e", kc_id:"40fa9d70-d3f6-509c-a88f-7de89a02451e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify RetailMeNot and analyze its role in the textbook's treatment of integrated marketing communications. Source: printed page 450. Evidence excerpt: When Taco Bell (see Figure 13.7) wants to tell the consumer that the Grilled Steak Burrito is only available for a limited time, it can send the message many different ways. The consumer soon knows the Grilled Steak Burrito is only available for a limited time. They have received the same message through ads on television and radio, an email, a photo and reminder on Instagram, and a billboard on their way to work. After receiving the same message in many different ways, the consumer realizes there is some urgency in getting to Taco Bell to try the new Grilled Steak Burrito. When the customer is in physical proximity to their local Taco Bell, apps such as RetailMeNot can send push…", label:"Analyze RetailMeNot in its marketing context", canonical_key:"analyze_retailmenot_in_its_marketing_context", status:"approved"}}, {concept_id:"a6785be6-a0d2-5f47-b06d-b80a068d7e92", kc_id:"a6785be6-a0d2-5f47-b06d-b80a068d7e92", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify RetailWire and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 541. Evidence excerpt: Finally, direct mail has the characteristic of lingering. Other forms of promotion, such as advertising and email marketing, don’t have as long a life span as direct mail. According to RetailWire, the average life span of a direct mail piece is 17 days, which means that a household may review that message repeatedly over the life of the mail piece.2", label:"Analyze RetailWire in its marketing context", canonical_key:"analyze_retailwire_in_its_marketing_context", status:"approved"}}, {concept_id:"d86e68c8-1e03-55cb-bd3a-17b70f946185", kc_id:"d86e68c8-1e03-55cb-bd3a-17b70f946185", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ries and analyze its role in the textbook's treatment of product positioning. Source: printed page 181. Evidence excerpt: This third and final step is contained in what’s known as the segmenting, targeting, and positioning model, the STP model. With the STP model, a company segments the market, selects the target market, and positions its products and services into the existing marketplace (see Figure 5.12). In their book Positioning: The Battle for Your Mind, marketing gurus Al Ries and Jack Trout write, “The basic approach of positioning is not to create something new and different, but to manipulate what’s already up there in the mind.”61", label:"Analyze Ries in its marketing context", canonical_key:"analyze_ries_in_its_marketing_context", status:"approved"}}, {concept_id:"166cd4ad-21f5-5a13-b759-73cf08e09b03", kc_id:"166cd4ad-21f5-5a13-b759-73cf08e09b03", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify RingCentral and analyze its role in the textbook's treatment of the business-to-business (b2b) market. Source: printed page 127. Evidence excerpt: How did it do that? First, with direct access to customer feedback, the product teams at RingCentral can use that feedback to spur product feature innovations that meet customers’ needs. Second, the company’s sales and support teams were able to use that same customer feedback to tweak their training programs and support processes. The results? After rolling out the dashboards (visual displays of the information captured), the company’s support team reached an average customer satisfaction (CSAT) score of 9/10 in two key market segments. “Without real time customer feedback and the opportunity to close the loop with the customer when the feedback is fresh, this score would have…", label:"Analyze RingCentral in its marketing context", canonical_key:"analyze_ringcentral_in_its_marketing_context", status:"approved"}}, {concept_id:"fa8035aa-b1ca-597f-9757-4ab04c8d523c", kc_id:"fa8035aa-b1ca-597f-9757-4ab04c8d523c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Rite Aid and analyze its role in the textbook's treatment of the use and value of marketing channels. Source: printed page 577. Evidence excerpt: The fourth type of intermediary is the retailer. Retailers also take ownership of the product, and their sole focus is on reaching the end user or customer directly. They purchase a wide variety of products in smaller amounts that meet the wants and needs of consumers. Retailers include companies like Rite Aid, Walmart, Target, and Hallmark.", label:"Analyze Rite Aid in its marketing context", canonical_key:"analyze_rite_aid_in_its_marketing_context", status:"approved"}}, {concept_id:"b35564da-a322-5291-b02f-fc8a88692fe9", kc_id:"b35564da-a322-5291-b02f-fc8a88692fe9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ritz-Carlton and analyze its role in the textbook's treatment of product positioning. Source: printed page 182. Evidence excerpt: amenities; they just want a basic, clean hotel in which to stay during their trip. • Ritz-Carlton hotels are by their nature more luxurious and target those travelers who don’t mind paying a premium price for more luxury and amenities. • Marriott ExecuStay hotels are aimed at professionals who need a longer-term place to stay (i.e., an extended stay hotel).", label:"Analyze Ritz-Carlton in its marketing context", canonical_key:"analyze_ritz_carlton_in_its_marketing_context", status:"approved"}}, {concept_id:"c4b65625-d6b2-52cc-82fe-6955f11f8777", kc_id:"c4b65625-d6b2-52cc-82fe-6955f11f8777", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Rolex and analyze its role in the textbook's treatment of factors influencing channel choice. Source: printed page 588. Evidence excerpt: In direct contrast to an intensive distribution strategy, some companies intentionally use an exclusive distribution strategy. Exclusive distribution is a strategy that involves allowing a limited number of intermediaries to distribute a company’s market offering. Luxury brand Rolex, for example, allows a limited number of retailers to sell its luxury watches. The exclusivity of these retailers reinforces Rolex’s distinctive position of being a luxurious, hard-to-get brand.", label:"Analyze Rolex in its marketing context", canonical_key:"analyze_rolex_in_its_marketing_context", status:"approved"}}, {concept_id:"83f10895-9134-5564-b704-42ffbd6206e5", kc_id:"83f10895-9134-5564-b704-42ffbd6206e5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ronald McDonald House Charities and analyze its role in the textbook's treatment of buyers and buying situations in a b2b market. Source: printed page 133. Evidence excerpt: Institutions is a rather broad term for nonprofit organizations such as the Wounded Warrior Project and Ronald McDonald House Charities, charities, and churches, as well as educational institutions, hospitals, museums, nursing homes, and civic clubs. Like the government, these institutions often purchase large quantities of products and services. For example, a large nursing home buys food, beverages, linens, janitorial supplies, medications, and a host of other products and services to serve its residents. Similarly, a church may purchase candles, vestments, furniture, and much more.", label:"Analyze Ronald McDonald House Charities in its marketing context", canonical_key:"analyze_ronald_mcdonald_house_charities_in_its_m", status:"approved"}}, {concept_id:"c4578e9d-5d35-5580-8d46-545f3e2bb726", kc_id:"c4578e9d-5d35-5580-8d46-545f3e2bb726", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ross and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 618. Evidence excerpt: Off-price Brand name overstock, irregulars, and closeouts T.J.Maxx, Ross retailer", label:"Analyze Ross in its marketing context", canonical_key:"analyze_ross_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"ea68188b-b6f0-566b-9641-2a938c27b44e", kc_id:"ea68188b-b6f0-566b-9641-2a938c27b44e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Royal Caribbean Group and analyze its role in the textbook's treatment of ethical considerations in providing services. Source: printed page 396. Evidence excerpt: Royal Caribbean Group is another company that takes its ethical behavior seriously. It has a Code of Business Conduct and Ethics decree that connects its core values (fairness, integrity, honesty, and trustworthiness) to all of its actions. Chairman and CEO Richard Fain reaffirms its commitment to integrity and an ethical culture and states, “Simply complying with the law is not enough; we need to be ABC (Above and Beyond Compliance).”46 Beyond just words, however, the company has established an ethics hotline managed by The Network, a leading third-party hotline provider. Through the use of this ethics hotline, employees can anonymously report their concerns about ethics…", label:"Analyze Royal Caribbean Group in its marketing context", canonical_key:"analyze_royal_caribbean_group_in_its_marketing_c", status:"approved"}}, {concept_id:"3e8cc964-5c59-5222-bdb8-a1e8d442e43f", kc_id:"3e8cc964-5c59-5222-bdb8-a1e8d442e43f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Run DMC and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 99. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/3-2-factors-that-influence- consumer-buying-behavior) Failures are always important because they come with learned knowledge, and if you understand the WHY behind the failure, the learning can lead to shifts in strategy and possible success. Read the inspiring story (https://openstax.org/r/inspiringstory) behind Run DMC’s revolutionary market deal with Adidas and how it opened the door for current artists like 50 Cent, Jay-Z, and Puffy.", label:"Analyze Run DMC in its marketing context", canonical_key:"analyze_run_dmc_in_its_marketing_context", status:"approved"}}, {concept_id:"46b9307a-e159-591f-b540-6aae381efe4c", kc_id:"46b9307a-e159-591f-b540-6aae381efe4c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Saf-Gard and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 159. Evidence excerpt: Marketers can also segment the market based on occupation or job type. Focusing on a smaller segment of the market enables a company to make better use of its limited resources. For example, AllHeart is a producer of medical scrubs, nursing uniforms, shoes, and medical accessories, so it has segmented the market to focus on medical professionals. Another example can be found with Saf-Gard, a producer of safety shoes and work boots that meet or exceed safety standards. This company targets workers in the construction and farming industries.", label:"Analyze Saf-Gard in its marketing context", canonical_key:"analyze_saf_gard_in_its_marketing_context", status:"approved"}}, {concept_id:"e3460653-d1eb-5a98-a19f-37e7eb8fb913", kc_id:"e3460653-d1eb-5a98-a19f-37e7eb8fb913", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Saldana and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Saldana in its marketing context", canonical_key:"analyze_saldana_in_its_marketing_context", status:"approved"}}, {concept_id:"bbcc9a34-30c6-5814-b55a-84a9fd597505", kc_id:"bbcc9a34-30c6-5814-b55a-84a9fd597505", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Salesforce and analyze its role in the textbook's treatment of customer relationship management (crm). Source: printed page 33. Evidence excerpt: There are a number of CRM software systems available in the marketplace, and most accomplish the same thing. They basically track and work with data about customers. For example, they link and analyze customer contact information. They store and track contact with company representatives, such as phone calls, emails, live chat conversations, service requests, purchases, and returns. One good example of CRM software is Salesforce, which is the market leader for CRM software in North America, Western Europe, Latin America, and the Asia-Pacific region.46", label:"Analyze Salesforce in its marketing context", canonical_key:"analyze_salesforce_in_its_marketing_context", status:"approved"}}, {concept_id:"6779b0e1-79da-5cc2-82a0-6844942767ff", kc_id:"6779b0e1-79da-5cc2-82a0-6844942767ff", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sam’s Club and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 179. Evidence excerpt: One of the biggest advantages of undifferentiated marketing is the scope and cost-efficiency of advertising on a much larger scale. Every single marketing message can be deployed across a variety of media channels and can potentially reach millions of consumers. This is where economies of scale come into play: with high- volume sales, production becomes less expensive because costs can be spread out over a larger amount of goods. That’s a huge advantage compared to companies that produce products for smaller, more precisely targeted audiences. It’s like buying in bulk at Sam’s Club or Costco—because you buy so much of a product, the cost is lower. Companies that use…", label:"Analyze Sam’s Club in its marketing context", canonical_key:"analyze_sam_s_club_in_its_marketing_context", status:"approved"}}, {concept_id:"6d79f325-bc32-5d74-94b1-a4882963692a", kc_id:"6d79f325-bc32-5d74-94b1-a4882963692a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Samsung and analyze its role in the textbook's treatment of the five-step procedure for establishing pricing policy. Source: printed page 416. Evidence excerpt: A market share–oriented objective is one in which the company’s pricing objective is to set prices based on those of the competition. This strategy involves comparing similar products being offered in the market and pricing at, below, or above those prices depending on the products offering. The cell phone market is one example of an industry that leans on market share orientation. The biggest suppliers of cell phones—Apple, Google, and Samsung —take their pricing cues from one another and are priced very similarly.22", label:"Analyze Samsung in its marketing context", canonical_key:"analyze_samsung_in_its_marketing_context", status:"approved"}}, {concept_id:"6e50aafb-3453-5c22-a98a-03b7857c0691", kc_id:"6e50aafb-3453-5c22-a98a-03b7857c0691", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify San Francisco Batkid and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 491. Evidence excerpt: The San Francisco Batkid took social media by storm when the campaign was rolled out by Make-A-Wish Foundation. A boy fighting leukemia wished to be Batman, and the campaign went viral with the hashtag #SFBatman. People everywhere took time to volunteer and take part in the boy’s dream.", label:"Analyze San Francisco Batkid in its marketing context", canonical_key:"analyze_san_francisco_batkid_in_its_marketing_co", status:"approved"}}, {concept_id:"f7261318-5b56-5f69-9b12-7bb9592b5f73", kc_id:"f7261318-5b56-5f69-9b12-7bb9592b5f73", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sargento and analyze its role in the textbook's treatment of sales promotion and its role in the promotion mix. Source: printed page 521. Evidence excerpt: When products are at the introductory stage of the product life cycle, sales promotion can be effective at inducing trial of a product. The greater the competition, the more a sales promotion strategy becomes important for getting consumers to switch or try a new or different product. Product manufacturers often use sales promotion in-store to set apart the brand or product at the time of purchase. As you walk past the cheese aisle at the grocery store, you might see Sargento offering a buy-one-get-one (BOGO) deal. This is a sales promotion geared toward getting the customer to buy more of Sargento or possibly try Sargento for the", label:"Analyze Sargento in its marketing context", canonical_key:"analyze_sargento_in_its_marketing_context", status:"approved"}}, {concept_id:"ec1b685f-8304-50b8-b8c2-bef968397725", kc_id:"ec1b685f-8304-50b8-b8c2-bef968397725", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Save A Lot and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 617. Evidence excerpt: Multiple product lines; focused mostly on grocery with Supermarket Publix, Kroger, Save A Lot limited services", label:"Analyze Save A Lot in its marketing context", canonical_key:"analyze_save_a_lot_in_its_marketing_context", status:"approved"}}, {concept_id:"ee94dfaf-035f-5af2-aae7-2d1265b043f4", kc_id:"ee94dfaf-035f-5af2-aae7-2d1265b043f4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Scale Finance and analyze its role in the textbook's treatment of the five critical cs of pricing. Source: printed page 412. Evidence excerpt: The Five Critical Cs of Pricing Scale Finance has provided an excellent article (https://openstax.org/r/the5criticalcs) that may help you get your mind around the five Cs of pricing.", label:"Analyze Scale Finance in its marketing context", canonical_key:"analyze_scale_finance_in_its_marketing_context", status:"approved"}}, {concept_id:"63956f2e-5e24-522e-af9b-5583774181eb", kc_id:"63956f2e-5e24-522e-af9b-5583774181eb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Schultz and analyze its role in the textbook's treatment of steps in the imc planning process. Source: printed page 462. Evidence excerpt: ROCI IMC is centered on data-driven decision-making to drive organizational value. So it’s no surprise that the founder of IMC, Don Schultz, determined a way to measure IMC campaigns. Schultz calls this metric return on customer investment (ROCI). ROCI is a marginal analysis that shows the efficiency of marketing communications spending. We often think of effectiveness as the key measure of a campaign’s success. But equally important is the efficiency of how we spend resources. We should consider how hard our resource works for us.", label:"Analyze Schultz in its marketing context", canonical_key:"analyze_schultz_in_its_marketing_context", status:"approved"}}, {concept_id:"592711db-7b41-52a6-8e50-3ea5294bbb44", kc_id:"592711db-7b41-52a6-8e50-3ea5294bbb44", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Scrub Daddy and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 344. Evidence excerpt: New Product Defined You’ve probably watched at least one episode of the popular television show Shark Tank, where budding entrepreneurs pitch their business plans to a panel of investors in return for funding. To date, over 1,000 sales pitches have been made on the show—some forgettable, others memorable—and some pitches have resulted in wildly successful businesses. Some of Shark Tank’s most successful products include the Squatty Potty (over $200 million in sales since appearing on Shark Tank), Bombas Socks (over $225 million), and Scrub Daddy (over $330 million).2", label:"Analyze Scrub Daddy in its marketing context", canonical_key:"analyze_scrub_daddy_in_its_marketing_context", status:"approved"}}, {concept_id:"855e5273-f7f1-57b7-b6c4-6ed78c242337", kc_id:"855e5273-f7f1-57b7-b6c4-6ed78c242337", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sears Roebuck and Co. and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 623. Evidence excerpt: Direct mail involves solicited or unsolicited advertising of products and services to prospective customers through the mail (Figure 18.9). Direct mail and catalogs are likely the oldest form of non-store retailing. The first mail-order catalog in the United States was Tiffany & Co.’s Blue Book in 1845.16 The company still uses catalogs in addition to store retail locations, and the catalogs feature some of the rarest diamonds and jewels in the world. A more popular mail-order catalog that began in the 1800s was the Sears Roebuck and Co. catalog, the “big book,” which came to feature hundreds of pages of products offered by the company; the last was published in 1993. With the…", label:"Analyze Sears Roebuck and Co. in its marketing context", canonical_key:"analyze_sears_roebuck_and_co_in_its_marketing_co", status:"approved"}}, {concept_id:"d4b1fe19-2b0b-5002-99b3-12d6bf9345c3", kc_id:"d4b1fe19-2b0b-5002-99b3-12d6bf9345c3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify SeaWorld and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 489. Evidence excerpt: Consider CNN’s Blackfish, which aired in 2013. The documentary shed light on the consequences of keeping orcas in captivity, forcing them to perform for sightseers at sea parks. It takes a deep dive into the lives of these captive marine mammals and how sometimes such animals can be deadly, as was witnessed at SeaWorld in 2014.14 The results of the negative publicity created by the documentary caused SeaWorld’s park attendance, as well as its market value, to drop.15", label:"Analyze SeaWorld in its marketing context", canonical_key:"analyze_seaworld_in_its_marketing_context", status:"approved"}}, {concept_id:"b3a91aec-19d7-5623-b906-c413d475cccd", kc_id:"b3a91aec-19d7-5623-b906-c413d475cccd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Securities and Exchange Commission (SEC) and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 146. Evidence excerpt: The Securities and Exchange Commission (SEC) and the Department of Justice work cooperatively to enforce the FCPA. Sanctions for violations can be significant, including both civil and criminal penalties. The SEC can bring civil enforcement actions against companies (along with their officers, directors, employees, stockholders, and agents) for violations or for bribery, and if found guilty under the act, the company may have to pay back its “ill-gotten gains” as well as paying prejudgment interest and civil penalties. For example, one of its most recent cases involved KT Corporation, a South Korean telecommunications company, in which the SEC alleged that the company had…", label:"Analyze Securities and Exchange Commission (SEC) in its marketing context", canonical_key:"analyze_securities_and_exchange_commission_sec_i", status:"approved"}}, {concept_id:"74393ca7-80ff-5f3d-8305-89a0d1bf843e", kc_id:"74393ca7-80ff-5f3d-8305-89a0d1bf843e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Seeds of Peace and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 653. Evidence excerpt: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", label:"Analyze Seeds of Peace in its marketing context", canonical_key:"analyze_seeds_of_peace_in_its_marketing_context", status:"approved"}}, {concept_id:"1475146b-8918-5eae-9181-f578921f3771", kc_id:"1475146b-8918-5eae-9181-f578921f3771", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Semick and analyze its role in the textbook's treatment of the five-step procedure for establishing pricing policy. Source: printed page 416. Evidence excerpt: customers. Before Jim Semick and his team launched GoToMeeting, a conferencing app, they developed the pricing of $49 “all you can meet flat-rate pricing.” This pricing was unique to the industry, and Semick stated that they determined this pricing structure based on dozens of interviews with potential customers. From these interviews, the GoToMeeting team discovered key areas that would provide value to customers not only through the product itself, but also through the flat-rate price structure that was easy to understand.20 Semick utilized the customer value–based objective, one in which the company has a good understanding of the value-added benefits of a product and sets its…", label:"Analyze Semick in its marketing context", canonical_key:"analyze_semick_in_its_marketing_context", status:"approved"}}, {concept_id:"fb4cc4d5-8b0f-5a51-8ef5-6add9cd13f85", kc_id:"fb4cc4d5-8b0f-5a51-8ef5-6add9cd13f85", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Semrush and analyze its role in the textbook's treatment of metrics used to evaluate the success of online marketing. Source: printed page 561. Evidence excerpt: Search trends are data points that indicate how frequently a term is searched. Researching search trends provides insight into who a company’s customers are and what they are currently interested in. Google Trends is a free tool that online marketers can use to gather this information. Monitoring search trends has some predictive benefits to online marketers, who can recommend changes to products, advertising, and budgeting based on what consumers are searching for. For example, marketers utilize keyword tools offered by companies like Semrush to gain insights into customer search activity. Semrush provides customers with information on the value of popular search terms.", label:"Analyze Semrush in its marketing context", canonical_key:"analyze_semrush_in_its_marketing_context", status:"approved"}}, {concept_id:"6615a5ae-95d7-5ce6-bddf-095fd0796fdf", kc_id:"6615a5ae-95d7-5ce6-bddf-095fd0796fdf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Seventeen and analyze its role in the textbook's treatment of ethical concerns in advertising and public relations. Source: printed page 495. Evidence excerpt: The vape company Juul found itself in hot water in 2019 when it was accused of marketing to teens. The company advertised its product—intended for adults only—on websites such as Nickelodeon, the Cartoon Network, and Seventeen, all sites directed toward youth.27", label:"Analyze Seventeen in its marketing context", canonical_key:"analyze_seventeen_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"395473a7-c14c-5076-b6be-c3dd134ee18d", kc_id:"395473a7-c14c-5076-b6be-c3dd134ee18d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Shark Tank and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 344. Evidence excerpt: • Shark Tank Tales: “12 Most Successful Shark Tank Products” (https://openstax.org/r/ bestsellingsharktank) • Good Housekeeping: “Top 42 Gifts That Got Their Start on Shark Tank” (https://openstax.org/r/ homeproducts) • Entrepreneur: “Shark Tank” (https://openstax.org/r/sharktanktopic) • Vulture: “Shark Tank Contestant Who Pitched Face Masks in 2009 Has No Regrets” (https://openstax.org/r/sharktankirina) • Looper: “The Most Expensive Deals on Shark Tank” (https://openstax.org/r/themostexpensivedeals) • Hustle Story: “21 Most Famous Shark Tank Failures in 2022” (https://openstax.org/r/ the21mostfamoussharktank) • Failory: “Shark Tank: 7 Products That Failed & Their 3 Biggest…", label:"Analyze Shark Tank in its marketing context", canonical_key:"analyze_shark_tank_in_its_marketing_context", status:"approved"}}, {concept_id:"556d389f-14c1-55f8-a294-561bf8659373", kc_id:"556d389f-14c1-55f8-a294-561bf8659373", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Shaw Industries and analyze its role in the textbook's treatment of stages of the new product development process. Source: printed page 351. Evidence excerpt: The prototype is then put through functional and customer tests to see how well it perform. For example, at carpet manufacturer Shaw Industries, temporary employees are paid to walk on carpet samples for eight hours a day to see how the carpet holds up.20 At Gillette, volunteers come to work unshaven so they can use certain razors, shaving cream, or aftershave and complete questionnaires. (The “motto” of this group is “We bleed so you’ll get a good shave at home.”)21", label:"Analyze Shaw Industries in its marketing context", canonical_key:"analyze_shaw_industries_in_its_marketing_context", status:"approved"}}, {concept_id:"5b28ec86-d6ee-5051-b6d1-da6a8e64cdcb", kc_id:"5b28ec86-d6ee-5051-b6d1-da6a8e64cdcb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Shedd Aquarium and analyze its role in the textbook's treatment of sustainable marketing principles. Source: printed page 661. Evidence excerpt: Innovative Marketing Innovative marketing uses media as a method for capturing shoppers’ attention and converting them into customers. The ever-changing digital landscape offers myriad possibilities to engage an audience in an innovative marketing strategy. For example, Shedd Aquarium in Chicago took its penguins on a field trip to meet their aquatic roommates for a virtual event in 2020. During the field trip, the Aquarium broadcasted on social media and delighted animal lovers worldwide while promoting the aquarium.", label:"Analyze Shedd Aquarium in its marketing context", canonical_key:"analyze_shedd_aquarium_in_its_marketing_context", status:"approved"}}, {concept_id:"34258ac2-f5ac-530a-8d36-b976fc0c8f11", kc_id:"34258ac2-f5ac-530a-8d36-b976fc0c8f11", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sherman Antitrust Act and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 295. Evidence excerpt: Where do business ethics come from? Ethics originate from the need and desire to promote both fair and equitable competition in the market. Ethics are supported by legislation such as the Sherman Antitrust Act from the US Department of Justice. Ethical considerations in diversity marketing have a similar background. They are linked to companies’ fair and equitable outreach and representation of diverse audiences in the market. These include multicultural and sociodemographic consumer segments in particular.", label:"Analyze Sherman Antitrust Act in its marketing context", canonical_key:"analyze_sherman_antitrust_act_in_its_marketing_c", status:"approved"}}, {concept_id:"9ae9a1e2-41fd-5105-823f-b8cee21fdb1d", kc_id:"9ae9a1e2-41fd-5105-823f-b8cee21fdb1d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Shift and analyze its role in the textbook's treatment of stages in the consumer adoption process for new products. Source: printed page 362. Evidence excerpt: • Relative Advantage: How much is the new product “better than” what it replaces? This is, of course, based entirely on a consumer’s perception, but as a general rule, the easier it is to recognize the advantages of using the product, the more quickly it will be adopted. • Compatibility: This is the level at which the innovation fits into a specific society due to economic, lifestyle, and cultural reasons. For example, PCs were very compatible with middle-class lifestyles, so the product was quickly adopted. On the other hand, the diffusion of birth control in parts of the world is not compatible with social mores due to religious beliefs and cultural values. • Complexity: How…", label:"Analyze Shift in its marketing context", canonical_key:"analyze_shift_in_its_marketing_context", status:"approved"}}, {concept_id:"4544ef76-c1ff-5fe6-8019-1ca30535fb5f", kc_id:"4544ef76-c1ff-5fe6-8019-1ca30535fb5f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Shopify and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 545. Evidence excerpt: Amazon.com is designed to allow third-party sellers to share product details, reviews, and product comparisons. Its purpose is to facilitate a purchase transaction in which the consumer buys something directly from the site. Shopify has recently emerged as the “anti-Amazon” by offering sellers more than a dozen services ranging from e-commerce websites to inventory management and payment processing.", label:"Analyze Shopify in its marketing context", canonical_key:"analyze_shopify_in_its_marketing_context", status:"approved"}}, {concept_id:"a0f4d839-d1f1-5e2a-9578-52d1ea4ea3bc", kc_id:"a0f4d839-d1f1-5e2a-9578-52d1ea4ea3bc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Silent Generation and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 269. Evidence excerpt: • LGBTQIA+ population. LGBTQIA+ stands for lesbian, gay, bisexual, transsexual, queer/questioning, intersex, asexual, and other sexual identities. About 5.6 percent of American adults—roughly 14.4 million individuals—identify as LGBTQIA+ according to a 2020 survey.27 In general, LGBTQIA+ consumers spend more at retail stores than other groups and have a higher percentage of online purchases compared to non-LGBTQIA+ households. Not only is this segment part of diversity marketing, but the LGBTQIA+ community is very diverse too. • Generational population. Consumers are grouped into age clusters based on birth year. These populations include 21.7 million Traditionalist or Silent…", label:"Analyze Silent Generation in its marketing context", canonical_key:"analyze_silent_generation_in_its_marketing_conte", status:"approved"}}, {concept_id:"c1a63f99-eee0-53ea-a76a-8f82e70855d0", kc_id:"c1a63f99-eee0-53ea-a76a-8f82e70855d0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Simon & Schuster and analyze its role in the textbook's treatment of the role of marketing in the strategic planning process. Source: printed page 62. Evidence excerpt: The concept of concentric diversification revolves around the addition of similar products or services to an existing business.48 If a picture is worth a thousand words, then an example has to be worth even more, particularly an example to which you can easily relate as a student. As you’re reading this chapter, consider book publishers, like Harper Collins, Simon & Schuster, or Penguin/Random House. These book publishers don’t only print the works of one author; rather, they have hundreds or perhaps thousands of authors’ works in their arsenals. These publishers will publish print books, e-books (like the one you’re reading right now), and audiobooks and may even sell the rights…", label:"Analyze Simon & Schuster in its marketing context", canonical_key:"analyze_simon_schuster_in_its_marketing_context", status:"approved"}}, {concept_id:"903a9551-a033-5dd2-8704-a50f8444eeb1", kc_id:"903a9551-a033-5dd2-8704-a50f8444eeb1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify SMA Marketing and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 53. Evidence excerpt: SMART Goals For more information on establishing SMART Goals, check out this video from SMA Marketing.", label:"Analyze SMA Marketing in its marketing context", canonical_key:"analyze_sma_marketing_in_its_marketing_context", status:"approved"}}, {concept_id:"d89779d2-116b-5c71-83f1-d72471f72799", kc_id:"d89779d2-116b-5c71-83f1-d72471f72799", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Smalls and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Smalls in its marketing context", canonical_key:"analyze_smalls_in_its_marketing_context", status:"approved"}}, {concept_id:"6edd6898-2ef5-52b1-9bb5-005a518524c7", kc_id:"6edd6898-2ef5-52b1-9bb5-005a518524c7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Smartwater and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: National brands are the name brands that sell a product or service under its corporate name and identity. Brands like Heinz, Smartwater, and Morton’s Salt are examples of name brands. Brand equity commands higher prices, so national brands typically charge higher prices than their private brand counterparts. National brands often pay for premium retail space, making them a convenient choice for shoppers. However, price- sensitive shoppers may be turned off by the higher prices of national brands.", label:"Analyze Smartwater in its marketing context", canonical_key:"analyze_smartwater_in_its_marketing_context", status:"approved"}}, {concept_id:"b399040d-c4db-5cc9-a5f9-8aef9bf223bb", kc_id:"b399040d-c4db-5cc9-a5f9-8aef9bf223bb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Snapchat and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 551. Evidence excerpt: As discussed in the previous section, internet and digital technology usage have surged across the globe, creating opportunities for marketers to engage with consumers in real time. Social media marketing has emerged as a powerful online marketing tool as consumer time spent on these platforms (see Figure 16.6) has grown substantially over the last decade. A growing share of Americans report that they use YouTube and Facebook more than any other social media platform. In segments under the age of 30, the most popular platforms are Instagram, Snapchat, and TikTok.", label:"Analyze Snapchat in its marketing context", canonical_key:"analyze_snapchat_in_its_marketing_context", status:"approved"}}, {concept_id:"91bfc985-7f62-51f1-87fe-654a23e4c7c1", kc_id:"91bfc985-7f62-51f1-87fe-654a23e4c7c1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Snickers and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 104. Evidence excerpt: Abraham Maslow asserted that all individuals have five needs, arranged from the most basic lower-level deficiency needs to the highest-level growth needs. As Figure 3.8 shows, physiological needs are at the most basic level and include things like adequate food, water, and shelter. Think about how marketers may try to appeal to consumers based on physiological needs. For example, Snickers ran a very successful ad campaign based on the slogan “You’re not you when you’re hungry.”", label:"Analyze Snickers in its marketing context", canonical_key:"analyze_snickers_in_its_marketing_context", status:"approved"}}, {concept_id:"848ec4e3-0b11-5740-8d94-bc46c9194728", kc_id:"848ec4e3-0b11-5740-8d94-bc46c9194728", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sonic Drive-In and analyze its role in the textbook's treatment of sales promotion and its role in the promotion mix. Source: printed page 522. Evidence excerpt: Sonic Drive-In (see Figure 15.3) offers half-price drinks and slushes every day from 2:00 to 4:00 as a “happy hour” special. The use of this sales promotion tactic does two things: first, it incentivizes consumers to buy drinks, and second, it provides sales during the slow times of the day.", label:"Analyze Sonic Drive-In in its marketing context", canonical_key:"analyze_sonic_drive_in_in_its_marketing_context", status:"approved"}}, {concept_id:"bada2873-3ae3-5272-87e2-e2458a898803", kc_id:"bada2873-3ae3-5272-87e2-e2458a898803", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sonos and analyze its role in the textbook's treatment of ethical considerations in new product development. Source: printed page 364. Evidence excerpt: For example, in March 2021, a jury ruled against Apple for patent infringement and ordered it to pay over $300 million to Personalized Media Communications LLC. That same year, a judge ruled that Google had infringed on five patents owned by Sonos, and if the ruling is upheld, it may result in the ban of imports of products like Google Home and Pixel smartphones.47", label:"Analyze Sonos in its marketing context", canonical_key:"analyze_sonos_in_its_marketing_context", status:"approved"}}, {concept_id:"81198b15-3bc0-55b9-b665-552849f5d525", kc_id:"81198b15-3bc0-55b9-b665-552849f5d525", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sony and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 346. Evidence excerpt: • Discontinuous Innovation: Sometimes referred to as radical or disruptive innovations, discontinuous innovations consist of new-to-the-world products that are so different from products currently existing in the market that they require a significant change in consumer behavior when adopted. For example, think about how cell phones have changed the way we communicate today. Older cell phones did one thing—make and receive phone calls. With a smartphone, you can still make phone calls, but you can also listen to music, send and receive emails, surf the Internet, conduct online banking, and get driving directions, to name just a few. Consider how learning to operate all the…", label:"Analyze Sony in its marketing context", canonical_key:"analyze_sony_in_its_marketing_context", status:"approved"}}, {concept_id:"847fb810-f0b4-5715-98df-1ec085faab54", kc_id:"847fb810-f0b4-5715-98df-1ec085faab54", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Southwest Airlines and analyze its role in the textbook's treatment of ethical marketing. Source: printed page 36. Evidence excerpt: • Ensure transparency. Transparency is key, and marketers should attempt to provide the maximum amount of information to the consumer regarding the product, its usage, and safety concerns. For example, Southwest Airlines ran a clever marketing campaign entitled “Transfarency,” promoting its philosophy that customers should be treated honestly and fares should actually stay low. The result? The campaign garnered nearly 5 million likes on Facebook alone.57 How’s that for earning the trust of potential customers? • Respect data privacy. As we noted in our discussion of CRM above, marketers have the ability to collect vast amounts of data about consumers. Data privacy is the biggest…", label:"Analyze Southwest Airlines in its marketing context", canonical_key:"analyze_southwest_airlines_in_its_marketing_cont", status:"approved"}}, {concept_id:"bef93d31-2c1b-50a9-bf88-781189e354ed", kc_id:"bef93d31-2c1b-50a9-bf88-781189e354ed", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify SPANX and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 444. Evidence excerpt: Digital marketing is geared toward very specific market segments and is primarily interactive. Think of digital marketing as the mechanism that produces the immediate interaction with the customer and produces some type of feedback. Digital is considered two-way communication between the company and the customer. During the early stages of launching the SPANX brand, Sara Blakely primarily used digital marketing with a", label:"Analyze SPANX in its marketing context", canonical_key:"analyze_spanx_in_its_marketing_context", status:"approved"}}, {concept_id:"6cc384c0-311e-5aff-bac2-9fe2a18b9943", kc_id:"6cc384c0-311e-5aff-bac2-9fe2a18b9943", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Speedway and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 617. Evidence excerpt: Convenience Limited range of everyday items 7-Eleven, Speedway Store", label:"Analyze Speedway in its marketing context", canonical_key:"analyze_speedway_in_its_marketing_context", status:"approved"}}, {concept_id:"2c1b85fe-032a-52c9-9427-5601c5b964c7", kc_id:"2c1b85fe-032a-52c9-9427-5601c5b964c7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Spotify and analyze its role in the textbook's treatment of purpose and structure of the marketing plan. Source: printed page 67. Evidence excerpt: • Pinterest: “Help people discover the things they love, and inspire them to go do those things in their daily lives”52 • Spotify: “To unlock the potential of human creativity by giving a million creative artists the opportunity to", label:"Analyze Spotify in its marketing context", canonical_key:"analyze_spotify_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"227b2f2f-3e57-5056-ad11-74ac517c0496", kc_id:"227b2f2f-3e57-5056-ad11-74ac517c0496", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sprouts and analyze its role in the textbook's treatment of ethical issues in retailing and wholesaling. Source: printed page 642. Evidence excerpt: There are other supermarkets known for ethical practices. These include Natural Grocers, Sprouts, Costco, and Whole Foods.47", label:"Analyze Sprouts in its marketing context", canonical_key:"analyze_sprouts_in_its_marketing_context", status:"approved"}}, {concept_id:"73853a60-3f13-5ef9-9700-90e8750e8831", kc_id:"73853a60-3f13-5ef9-9700-90e8750e8831", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Squatty Potty and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 344. Evidence excerpt: New Product Defined You’ve probably watched at least one episode of the popular television show Shark Tank, where budding entrepreneurs pitch their business plans to a panel of investors in return for funding. To date, over 1,000 sales pitches have been made on the show—some forgettable, others memorable—and some pitches have resulted in wildly successful businesses. Some of Shark Tank’s most successful products include the Squatty Potty (over $200 million in sales since appearing on Shark Tank), Bombas Socks (over $225 million), and Scrub Daddy (over $330 million).2", label:"Analyze Squatty Potty in its marketing context", canonical_key:"analyze_squatty_potty_in_its_marketing_context", status:"approved"}}, {concept_id:"4733f82e-bb42-55d9-862c-7ae77ebb7849", kc_id:"4733f82e-bb42-55d9-862c-7ae77ebb7849", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Staples and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 617. Evidence excerpt: Category Very large superstores with wide product lines within a Best Buy, Lowe’s, Home Depot, killer category Staples, Office Depot", label:"Analyze Staples in its marketing context", canonical_key:"analyze_staples_in_its_marketing_context", status:"approved"}}, {concept_id:"1c7bd9cc-fa2e-5b24-a4f2-ff64dc8065d4", kc_id:"1c7bd9cc-fa2e-5b24-a4f2-ff64dc8065d4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Starbucks and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 26. Evidence excerpt: California to Texas, following similar announcements by Hewlett Packard Enterprise (HPE) and Oracle, citing such things as lower housing costs and tax rates and fewer regulations, making it easier for companies to operate in Texas. • Economic Factors. Economic factors play a huge role in terms of a company’s prospects in a market. For example, economic factors affect pricing and can even influence the supply/demand curve for a product or service. For example, high inflation causes consumers to have less spending power, which translates into lower sales and revenue. In 2022, consumers experienced both product shortages and higher prices, blamed largely on COVID-19, Russia’s war on…", label:"Analyze Starbucks in its marketing context", canonical_key:"analyze_starbucks_in_its_marketing_context", status:"approved"}}, {concept_id:"d6484a77-72c3-59c8-830e-ba03a86237bf", kc_id:"d6484a77-72c3-59c8-830e-ba03a86237bf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify StarKist and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 146. Evidence excerpt: Price fixing is illegal because it’s considered anticompetitive and hurts both consumers and businesses. Let’s illustrate with a real-life example with a company you’re likely familiar with—StarKist. In 2019, a San Francisco federal judge ordered the company to pay a fine in the amount of $100 million in connection with a canned tuna price-fixing conspiracy that involved StarKist, Bumble Bee Foods, and Chicken of the Sea, who regularly exchanged information about their sales and plans for pricing. The lawsuit alleged that, under the scheme, consumers were forced to pay more for canned tuna than they would have otherwise.21", label:"Analyze StarKist in its marketing context", canonical_key:"analyze_starkist_in_its_marketing_context", status:"approved"}}, {concept_id:"b504b017-2aec-5ec4-98ce-734ac992cf4e", kc_id:"b504b017-2aec-5ec4-98ce-734ac992cf4e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify State Bags and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 653. Evidence excerpt: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", label:"Analyze State Bags in its marketing context", canonical_key:"analyze_state_bags_in_its_marketing_context", status:"approved"}}, {concept_id:"d01d14f9-67e7-53d9-947d-9f00a8159b80", kc_id:"d01d14f9-67e7-53d9-947d-9f00a8159b80", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Statista and analyze its role in the textbook's treatment of ethical issues in consumer buying behavior. Source: printed page 117. Evidence excerpt: • According to a Statista poll, 90 percent of US survey respondents indicated that they would boycott a brand if they discovered that the company was engaged in irresponsible business practices.24 • Research from Mintel, a market research firm, indicates that 56 percent of US consumers indicate that they would no longer do business with organizations they believe to be unethical.25 • A recent survey showed that consumers seek a match between their beliefs and those exemplified by the organization. According to the survey, an overwhelming 72 percent of respondents indicated that they purchase goods and services from companies with beliefs similar to theirs in terms of…", label:"Analyze Statista in its marketing context", canonical_key:"analyze_statista_in_its_marketing_context", status:"approved"}}, {concept_id:"bdd73edb-1239-5471-8ba7-cd3fb66efd23", kc_id:"bdd73edb-1239-5471-8ba7-cd3fb66efd23", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Steve Madden and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 445. Evidence excerpt: When a consumer completes a Google search for shoes and then jumps to Facebook to scroll their feed and are served shoe ads from Nordstrom, Macy’s, and Steve Madden, they have been targeted by these shoe companies. The targeting, immediacy, and changeability of the messaging makes digital a quick and efficient method of reaching consumers. Digital promotional tools are extremely effective and can cut through the clutter and reach the consumer when they are in the demand phase of the buying process and have signaled an intent to purchase.", label:"Analyze Steve Madden in its marketing context", canonical_key:"analyze_steve_madden_in_its_marketing_context", status:"approved"}}, {concept_id:"9a5c3f17-527a-55a7-974a-b9fa91c8946a", kc_id:"9a5c3f17-527a-55a7-974a-b9fa91c8946a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Stitch Fix and analyze its role in the textbook's treatment of selecting target markets. Source: printed page 180. Evidence excerpt: Stitch Fix is another good example of a company that uses micromarketing. Stitch Fix is an online personal styling service for men, women, and children that sends a selection of clothing and accessories to your door using a mix of machine learning, data, algorithms, and human stylists. The company uses “85 meaningful data points” about each customer, and based on those data points, it predicts clothing choices that the customer will want. If they doesn’t like the product, they can just send it back with a prepaid, printable label within 30 days.60 You can’t get much more personalized than that!", label:"Analyze Stitch Fix in its marketing context", canonical_key:"analyze_stitch_fix_in_its_marketing_context", status:"approved"}}, {concept_id:"06b7b53c-b9e9-53e5-831f-00d8ff60490d", kc_id:"06b7b53c-b9e9-53e5-831f-00d8ff60490d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Stonyfield Organic and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 653. Evidence excerpt: The environmental pillar focuses on reducing a company’s impact on the environment. For example, companies may reduce their environmental impact through recycling, reusing, minimizing waste, and increasing energy efficiency. Stonyfield Organic has a commitment to the environmental pillar with its plans to cut carbon emissions by 30 percent by 2030. In addition, it plans to focus on energy conservation, waste reduction, and sustainable packaging and logistics.12 Additionally, Subaru of Indiana Automotive operates a “green lean” manufacturing facility that is designed as zero landfill. Subaru recycles or composts 98 percent of its manufacturing waste, and the remaining 2 percent is…", label:"Analyze Stonyfield Organic in its marketing context", canonical_key:"analyze_stonyfield_organic_in_its_marketing_cont", status:"approved"}}, {concept_id:"a35cc0c0-a577-5d62-bed2-8a51e1785be0", kc_id:"a35cc0c0-a577-5d62-bed2-8a51e1785be0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Subaru and analyze its role in the textbook's treatment of ethical issues in marketing communication. Source: printed page 465. Evidence excerpt: In 2021, Subaru celebrated 14 years of its Share the Love event.19 To celebrate this event, it debuted a national ad campaign highlighting the people, places, and pets that have been impacted by its social responsibility. Charities supported by Subaru include the American Society for the Prevention of Cruelty to Animals (ASPCA), Make-A-Wish Foundation, Meals on Wheels America, and the National Park Foundation. In its advertising, Subaru also showcases some of the local charities—selected by Subaru retailers—that benefit from the Subaru Share the Love event, as well as the impact of the automaker’s work with Feeding America to help address food insecurity.20", label:"Analyze Subaru in its marketing context", canonical_key:"analyze_subaru_in_its_marketing_context", status:"approved"}}, {concept_id:"01548929-315b-55a1-819c-801622f07fc3", kc_id:"01548929-315b-55a1-819c-801622f07fc3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Subaru of Indiana Automotive and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 653. Evidence excerpt: The environmental pillar focuses on reducing a company’s impact on the environment. For example, companies may reduce their environmental impact through recycling, reusing, minimizing waste, and increasing energy efficiency. Stonyfield Organic has a commitment to the environmental pillar with its plans to cut carbon emissions by 30 percent by 2030. In addition, it plans to focus on energy conservation, waste reduction, and sustainable packaging and logistics.12 Additionally, Subaru of Indiana Automotive operates a “green lean” manufacturing facility that is designed as zero landfill. Subaru recycles or composts 98 percent of its manufacturing waste, and the remaining 2 percent is…", label:"Analyze Subaru of Indiana Automotive in its marketing context", canonical_key:"analyze_subaru_of_indiana_automotive_in_its_mark", status:"approved"}}, {concept_id:"34c26541-606b-513a-871b-77c880dc8119", kc_id:"34c26541-606b-513a-871b-77c880dc8119", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Subway and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 189. Evidence excerpt: Back in 2014, Subway aligned itself with then–First Lady Michelle Obama’s Let’s Move! initiative. The company vowed to spend $41 million over a three-year period to promote a healthy-eating program aimed specifically toward children. The ad campaign bore the slogan “Playtime: Powered by Veggies.”", label:"Analyze Subway in its marketing context", canonical_key:"analyze_subway_in_its_marketing_context", status:"approved"}}, {concept_id:"3c2802f6-484e-5f43-b8f7-9fcd86b6b53f", kc_id:"3c2802f6-484e-5f43-b8f7-9fcd86b6b53f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sunbelt Bakery and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 470. Evidence excerpt: Among the company’s brands are Little Debbie, Sunbelt Bakery, Drake’s Cakes, and Fieldstone Bakery. The largest brand is Little Debbie, with a wide range of favorites from Apple Fruit Pies to Zebra Cakes. Little Debbie offers seasonal items in rotation, such as Christmas Tree Cakes. Distribution extends to all 50 states, Mexico, and Canada.", label:"Analyze Sunbelt Bakery in its marketing context", canonical_key:"analyze_sunbelt_bakery_in_its_marketing_context", status:"approved"}}, {concept_id:"b0632fa7-d2e7-59bf-8c24-b906449eb009", kc_id:"b0632fa7-d2e7-59bf-8c24-b906449eb009", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Super Bowl and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 297. Evidence excerpt: For the 2014 Super Bowl and the Winter Olympics in Sochi, Russia, Coca-Cola launched the “America Is Beautiful” campaign.74 Recognizing the growth of multicultural consumers in the United States, the campaign’s commercial featured seven young bilingual American women singing in different languages. It also showed culturally diverse consumers from all walks of life. Although the campaign was subject to severe criticism and sparked outrage and boycotts by some people, Coca-Cola was applauded by others for its commitment to a more inclusive marketing communication. That is what diversity marketing is all about.", label:"Analyze Super Bowl in its marketing context", canonical_key:"analyze_super_bowl_in_its_marketing_context", status:"approved"}}, {concept_id:"fd5500ea-15a0-5604-8658-b0572b8542da", kc_id:"fd5500ea-15a0-5604-8658-b0572b8542da", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Susan G. Komen and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: Organizations are increasingly sponsoring or hosting special events to show support for various causes. Such events are also a way to showcase the company, products/services, and/or brands to the public. Often, companies use special events to show the public that their values and ideals are part of their business model. For example, Kroger has sponsored and volunteered for the Susan G. Komen Central Indiana Race for a Cure for many years. With one of its division offices located in Indianapolis, Indiana, the company has been covered by media for its involvement in the local chapter of the Breast Cancer Foundation.19 The events not only", label:"Analyze Susan G. Komen in its marketing context", canonical_key:"analyze_susan_g_komen_in_its_marketing_context", status:"approved"}}, {concept_id:"f1c6f4b1-deb8-59f1-82ce-ce667039f5ad", kc_id:"f1c6f4b1-deb8-59f1-82ce-ce667039f5ad", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Swarovski and analyze its role in the textbook's treatment of new products from a customer’s perspective. Source: printed page 343. Evidence excerpt: In the Spotlight Swarovski, a well-known company that specializes in crystal cutting, developed a campaign around diversity and acceptance a few years ago in an effort to reach worldwide customers. One such campaign that was launched during the holiday season in China focused on the Advent calendar despite the fact that the observance of Advent is primarily a Western tradition. If you’re not familiar with Advent calendars, they’re a type of calendar that counts down the days from December 1 to December 25, Christmas day. On each day in December, you open a pouch or flap on the calendar where a small candy or toy is included. Swarovski took the concept to a whole new level.", label:"Analyze Swarovski in its marketing context", canonical_key:"analyze_swarovski_in_its_marketing_context", status:"approved"}}, {concept_id:"f4aefcad-ae3c-5ad0-ba4d-269647523576", kc_id:"f4aefcad-ae3c-5ad0-ba4d-269647523576", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Sysco and analyze its role in the textbook's treatment of wholesaling. Source: printed page 637. Evidence excerpt: focus on a limited line of products. For example, Sysco, one of the country’s largest food-service wholesalers, focuses on limited product lines, such as food and food-service supplies.38 The company’s target market includes hospitals and nursing homes, schools and colleges, and other entities that offer food service on a large scale. You might be surprised to learn that your high school cafeteria or college commons is served by Sysco.39 The company offers a host of services to its customers, such as financing, consultation, menu assistance, and food production.", label:"Analyze Sysco in its marketing context", canonical_key:"analyze_sysco_in_its_marketing_context", status:"approved"}}, {concept_id:"0148d0ca-c7d5-5016-8c47-03d036aed0d2", kc_id:"0148d0ca-c7d5-5016-8c47-03d036aed0d2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify T.J.Maxx and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 621. Evidence excerpt: Retailers that provide high-quality, name-brand goods at deeply discounted prices are considered off-price retailers. These retailers often purchase brand names that are irregular, closeouts, overstock, and off-season. While these retailers offer goods within more than one product line, often consumers cannot be guaranteed to find the same brand or item(s) in a store twice. T.J.Maxx, one of the largest clothing retailers in the country, utilizes this strategy. The company’s buyers purchase over-ordered or over-manufactured products from distributors at deeply discounted prices. This merchandise is then offered to the consumer at lower prices than can be found in department stores.", label:"Analyze T.J.Maxx in its marketing context", canonical_key:"analyze_t_j_maxx_in_its_marketing_context", status:"approved"}}, {concept_id:"a628f468-c2eb-5575-a82c-588ab9c89085", kc_id:"a628f468-c2eb-5575-a82c-588ab9c89085", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Taco Bell and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 322. Evidence excerpt: Building a strong brand begins with brand positioning, or the way the brand signals emotions in consumers’ minds. Brands can position themselves based on an attribute—one aspect of the product or service. For example, Taco Bell has positioned itself as the option for late-night cravings. This singular aspect defines its positioning. The problem with positioning based on an attribute is that it is easily replicable by competitors.", label:"Analyze Taco Bell in its marketing context", canonical_key:"analyze_taco_bell_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"854f7129-fefd-555d-9ecd-0c9fc38b9787", kc_id:"854f7129-fefd-555d-9ecd-0c9fc38b9787", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify TalEx and analyze its role in the textbook's treatment of personal selling and its role in the promotion mix. Source: printed page 506. Evidence excerpt: Relationship Selling Relationship selling is a method of personal selling used to better understand the needs and wants of the buyer. If the product is relatively high in price and has some customizable attributes, the salesperson will strive to become a trusted advisor to the customer. This allows the salesperson to develop a relationship that will create trust and ultimately fit the best product with the customer to fulfill their needs and wants and solve a problem they are having that put them in the market for the product. TalEx, a fast-growing human resource company, works with its clients to find the right talent for open positions at a variety of companies. Sales…", label:"Analyze TalEx in its marketing context", canonical_key:"analyze_talex_in_its_marketing_context", status:"approved"}}, {concept_id:"0dcc9664-13f3-5f7d-b89f-773fb951ca7c", kc_id:"0dcc9664-13f3-5f7d-b89f-773fb951ca7c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Target and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 25. Evidence excerpt: • Suppliers. Suppliers (sometimes also called vendors) are those partners from whom we receive the parts and products necessary for our business. Let’s assume that your company produces microwave ovens. Some of your suppliers may be providers of transformers, the turntable, control panels, magnetrons, etc. As long as you have options in terms of the component suppliers, the bargaining power of each supplier is relatively weak. However, if two suppliers merge and decide to raise the price of the component the new entity supplies, that vendor now wields increased power. • Market Intermediaries. Often, products are distributed by third-party sellers such as retailers, wholesalers,…", label:"Analyze Target in its marketing context", canonical_key:"analyze_target_in_its_marketing_context", status:"approved"}}, {concept_id:"a965ea43-0028-578a-9e6a-c80c110dd835", kc_id:"a965ea43-0028-578a-9e6a-c80c110dd835", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.676Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tarte Cosmetics and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 265. Evidence excerpt: In early 2018, Tarte Cosmetics introduced to the market its highly anticipated Shape Tape Foundation. The launch featured 15 shades of makeup, almost all light tones. However, the product was not well received. Loyal customers were furious because of the lack of shades for people with darker skin. Tarte Cosmetics was accused of being a whitewashed brand and even making deeper skin-toned people feel inadequate.11 The company quickly apologized for alienating customers and changed its product and marketing communication.", label:"Analyze Tarte Cosmetics in its marketing context", canonical_key:"analyze_tarte_cosmetics_in_its_marketing_context", status:"approved"}}, {concept_id:"155b78be-fbba-5ac0-b968-2a2df9ed1b1e", kc_id:"155b78be-fbba-5ac0-b968-2a2df9ed1b1e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify TBH Creative and analyze its role in the textbook's treatment of marketing plan progress using metrics. Source: printed page 78. Evidence excerpt: Enter TBH Creative, which was hired by Classic Cleaners to transform its marketing efforts through automating reporting. TBH Creative worked with the company to set up a marketing dashboard to monitor statistics and analytics, complete an audit to determine which marketing efforts were effective, improve its website, and more.76", label:"Analyze TBH Creative in its marketing context", canonical_key:"analyze_tbh_creative_in_its_marketing_context", status:"approved"}}, {concept_id:"978d34f4-7a04-58be-8cc9-661dd539eacf", kc_id:"978d34f4-7a04-58be-8cc9-661dd539eacf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Teddy Grahams and analyze its role in the textbook's treatment of forms of brand development, brand loyalty, and brand metrics. Source: printed page 326. Evidence excerpt: Multibrands are new brand names within a company’s existing product category. For example, Nabisco manufactures various cookies within a product line but is marketed with different brand names. In this case, Chips Ahoy, Oreo, and Teddy Grahams all have brand equity on their own and do not need the benefit of the Nabisco brand. Each of these brands has a significant market share, so there is a benefit to retaining a multibranding approach. However, a multibranding approach does not work when the products have a small market share or fail to gain favorable retail shelf space to encourage sales.", label:"Analyze Teddy Grahams in its marketing context", canonical_key:"analyze_teddy_grahams_in_its_marketing_context", status:"approved"}}, {concept_id:"d1accb96-c3f1-5910-911e-8f985961dc47", kc_id:"d1accb96-c3f1-5910-911e-8f985961dc47", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Telephone Consumer Protection Act and analyze its role in the textbook's treatment of steps in a successful marketing research plan. Source: printed page 210. Evidence excerpt: Phone surveys are completed during a phone conversation with the respondent. Although the traditional phone survey requires a data collector to talk with the participant, current technology allows for computer- assisted voice surveys or surveys to be completed by asking the respondent to push a specific button for each potential answer. Phone surveys are time intensive but allow the respondent to ask questions and the surveyor to request additional information or clarification on a question if warranted. Phone surveys require the respondent to complete the survey simultaneously with the collector, which is a limitation as there are restrictions for when phone calls are allowed.…", label:"Analyze Telephone Consumer Protection Act in its marketing context", canonical_key:"analyze_telephone_consumer_protection_act_in_its", status:"approved"}}, {concept_id:"be46f861-c949-58ef-a902-019f351dd86a", kc_id:"be46f861-c949-58ef-a902-019f351dd86a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tentree and analyze its role in the textbook's treatment of ethical issues in personal selling and sales promotion. Source: printed page 531. Evidence excerpt: According to Tentree’s Facebook page, “We believe that big change starts small. Small as in bringing your reusable tote to the grocery store, getting your coffee refilled in a thermos, and choosing to wear sustainably made T-shirts. These small choices add up (trust us, we’ve done the math), and we’re here to celebrate each and every one of them. By planting 10 trees for every purchase, we hope to make big change accessible to everybody and show the lasting impact that one small choice can have.”12", label:"Analyze Tentree in its marketing context", canonical_key:"analyze_tentree_in_its_marketing_context", status:"approved"}}, {concept_id:"7168f979-4bfc-58cd-a18e-d0a62494c86a", kc_id:"7168f979-4bfc-58cd-a18e-d0a62494c86a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tesla and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 25. Evidence excerpt: • Political Factors. These factors include environmental and trade restrictions, political stability, and business policy. For example, Tesla announced in late 2021 that it is moving its headquarters out of", label:"Analyze Tesla in its marketing context", canonical_key:"analyze_tesla_in_its_marketing_context", status:"approved"}}, {concept_id:"0de8b5be-3bdc-52e1-bd93-f4fdbbed7fd4", kc_id:"0de8b5be-3bdc-52e1-bd93-f4fdbbed7fd4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify The Honest Company and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 284. Evidence excerpt: Hispanic consumers support brands that demonstrate cultural authenticity, transparency, and honesty. After all, openness and having meaningful connections are at the heart of these consumers’ values. In terms of factors, the concept of product quality and service quality is deeply desirable to Hispanic consumers. Have you heard of Hispanic actress Jessica Alba? Alba, who is of Mexican descent, founded The Honest Company (see Figure 8.16) in 2012 with the mission of formulating safe, high-quality personal and beauty products for the family. Other factors that influence Hispanic consumers include companies’ pledges to sustainability and social responsibility. Indeed, these are…", label:"Analyze The Honest Company in its marketing context", canonical_key:"analyze_the_honest_company_in_its_marketing_cont", status:"approved"}}, {concept_id:"b0709c45-2793-59d9-965a-ecfceeddfd40", kc_id:"b0709c45-2793-59d9-965a-ecfceeddfd40", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify The Insights Association (IA) and analyze its role in the textbook's treatment of ethical issues in marketing research. Source: printed page 217. Evidence excerpt: The Insights Association There is an organization devoted to the support and integrity of quality marketing research. This organization, called The Insights Association (IA), “protects and creates demand for the evolving insights and analytics industry by promoting the indisputable role of insights in driving business impact.”21 Having a solid understanding of ethical practices is critical for any marketing professional. Become familiar with terminology, responsibilities, enforcements, and sanctions of the IA’s code of standards and ethics (https://openstax.org/r/codesofstandards).", label:"Analyze The Insights Association (IA) in its marketing context", canonical_key:"analyze_the_insights_association_ia_in_its_marke", status:"approved"}}, {concept_id:"95e2f96a-2099-5a67-9576-c55935eb0368", kc_id:"95e2f96a-2099-5a67-9576-c55935eb0368", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify The Network and analyze its role in the textbook's treatment of ethical considerations in providing services. Source: printed page 396. Evidence excerpt: Royal Caribbean Group is another company that takes its ethical behavior seriously. It has a Code of Business Conduct and Ethics decree that connects its core values (fairness, integrity, honesty, and trustworthiness) to all of its actions. Chairman and CEO Richard Fain reaffirms its commitment to integrity and an ethical culture and states, “Simply complying with the law is not enough; we need to be ABC (Above and Beyond Compliance).”46 Beyond just words, however, the company has established an ethics hotline managed by The Network, a leading third-party hotline provider. Through the use of this ethics hotline, employees can anonymously report their concerns about ethics…", label:"Analyze The Network in its marketing context", canonical_key:"analyze_the_network_in_its_marketing_context", status:"approved"}}, {concept_id:"79a335dd-619a-5415-ace9-d86d106146ca", kc_id:"79a335dd-619a-5415-ace9-d86d106146ca", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify The PhD Project and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze The PhD Project in its marketing context", canonical_key:"analyze_the_phd_project_in_its_marketing_context", status:"approved"}}, {concept_id:"e58f3a0f-78a0-5036-a1e6-97d3f4fcb50c", kc_id:"e58f3a0f-78a0-5036-a1e6-97d3f4fcb50c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify The Trevor Project and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 300. Evidence excerpt: There are many nonprofit organizations operating in the United States that strive to serve multicultural groups and sociodemographic communities. Some have purposeful objectives like equitable rights and inclusivity. Some national examples include Advancement Project, American Civil Liberties Union (ACLU), Asian Americans Advancing Justice (AAJC), Equal Justice Initiative (EJI), Human Rights Campaign Foundation, League of United Latin American Citizens (LULAC), National Association for the Advancement of Colored People (NAACP), National Immigration Law Center, National Organization on Disability, National Urban League, Prospanica, The Asian American Foundation (TAAF), The PhD…", label:"Analyze The Trevor Project in its marketing context", canonical_key:"analyze_the_trevor_project_in_its_marketing_cont", status:"approved"}}, {concept_id:"57de243a-b4ae-5bf6-9df8-08a20d6911a7", kc_id:"57de243a-b4ae-5bf6-9df8-08a20d6911a7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Thermomix and analyze its role in the textbook's treatment of the gap model of service quality. Source: printed page 394. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/11-3-the-gap-model-of- service-quality) Also look at this article that applies the RATER model (https://openstax.org/r/ratermodel) to Amazon, Thermomix, Apple, and a bank.", label:"Analyze Thermomix in its marketing context", canonical_key:"analyze_thermomix_in_its_marketing_context", status:"approved"}}, {concept_id:"97a65232-8158-589e-b71f-e50092b0adc6", kc_id:"97a65232-8158-589e-b71f-e50092b0adc6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify ThirdLove and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 297. Evidence excerpt: Culturally Sensitive and Socially Inclusive Marketing Multinational industry leaders like Coca-Cola, Google, Adidas, Unilever, AT&T, Marriott International, and Microsoft are just a few of the companies that, like P&G, are focusing their marketing efforts on being more culturally sensitive and socially inclusive. Even niche players, partnerships, and private companies such as Bumble, Fenty Beauty, and ThirdLove are also championing diversity as a core value through equal cultural and sociodemographic representation rather than just chasing a trend in marketing.72", label:"Analyze ThirdLove in its marketing context", canonical_key:"analyze_thirdlove_in_its_marketing_context", status:"approved"}}, {concept_id:"7c1a225a-976d-519f-ba16-290ce751d409", kc_id:"7c1a225a-976d-519f-ba16-290ce751d409", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tide and analyze its role in the textbook's treatment of creating value through packaging and labeling. Source: printed page 331. Evidence excerpt: from harm in transit from manufacturer to customer. Items such as foam and cardboard shield the product from damage and keep it clean. Second, packaging can also serve as convenience and safety for customers to carry items and store them in the home. For example, Tide Pods are sold in a plastic container with a child- locked lid. This packaging is convenient for customers to safely store the pods in their home.", label:"Analyze Tide in its marketing context", canonical_key:"analyze_tide_in_its_marketing_context", status:"approved"}}, {concept_id:"df61d873-e426-58cf-9667-7e3fb5fa54b4", kc_id:"df61d873-e426-58cf-9667-7e3fb5fa54b4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tiffany & Co. and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: Licensed brands provide the likeness of their brand as a fee for use. If you wear eyeglasses, you likely have a licensed brand name on your eyeglasses frame. Brands like Tiffany & Co., Kate Spade, and Tommy Hilfiger do not produce eyeglasses frames. Rather, they license their brand to manufacturers like Luxottica, an Italian eyewear company that makes the product with the licensed brand name. Licensing a brand is a quick way to gain recognition and benefit from the brand’s equity. On the other hand, licensing fees can be costly and ultimately reduce profitability for manufacturers.", label:"Analyze Tiffany & Co. in its marketing context", canonical_key:"analyze_tiffany_co_in_its_marketing_context", status:"approved"}}, {concept_id:"cabfcfd3-4a17-5395-b3c3-8cf0d62bd400", kc_id:"cabfcfd3-4a17-5395-b3c3-8cf0d62bd400", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify TikTok and analyze its role in the textbook's treatment of marketing strategies at each stage of the product life cycle. Source: printed page 319. Evidence excerpt: Finally, brands use promotion to shift their message from awareness to preference. The shift from a niche market to a mass market typically involves an advertising investment. In 2021, TikTok moved from awareness to preference, and its promotion followed suit, reminding users why they enjoy using the platform.", label:"Analyze TikTok in its marketing context", canonical_key:"analyze_tiktok_in_its_marketing_context", status:"approved"}}, {concept_id:"3906ec9c-bf00-5578-88fc-7a88e0bf7bc7", kc_id:"3906ec9c-bf00-5578-88fc-7a88e0bf7bc7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Time’s Up and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 653. Evidence excerpt: The Story behind State Bags There are many examples of companies that work to support their communities. One example is State Bags. State Bags donates a bag filled with school supplies for each bag purchased. It also partners with nonprofits such as Seeds of Peace, Time’s Up, and Bottomless Closet to support women and children from", label:"Analyze Time’s Up in its marketing context", canonical_key:"analyze_time_s_up_in_its_marketing_context", status:"approved"}}, {concept_id:"304f8110-3ed8-511b-967f-65ea8ecf311d", kc_id:"304f8110-3ed8-511b-967f-65ea8ecf311d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Timmy Global Health and analyze its role in the textbook's treatment of ethical issues in the global marketplace. Source: printed page 252. Evidence excerpt: Founded in 1997 by Dr. Charles (Chuck) Dietzen, Timmy Global Health has a mission to empower communities to address health disparities in a sustainable way. For over two decades, Timmy has supported care sites across four countries in Latin America and Africa: Guatemala, Ecuador, the Dominican Republic, and Nigeria. Since its founding, it has served 100,000+ patients through medical service trips and local follow-up care. The most enduring legacy is the trusting relationships it has built with local communities.", label:"Analyze Timmy Global Health in its marketing context", canonical_key:"analyze_timmy_global_health_in_its_marketing_con", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"29698128-8da7-5738-960b-bc054004110e", kc_id:"29698128-8da7-5738-960b-bc054004110e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tinder and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/14-4-public-relations-and-its- role-in-the-promotion-mix) You can find numerous examples of bad publicity on the Internet. Check out this article that identifies (https://openstax.org/r/mediatoolkit) many from companies such as Easy Jet, Tinder, and Tesla.", label:"Analyze Tinder in its marketing context", canonical_key:"analyze_tinder_in_its_marketing_context", status:"approved"}}, {concept_id:"56f3ecdf-2a61-591a-ac50-c37a00645bb7", kc_id:"56f3ecdf-2a61-591a-ac50-c37a00645bb7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify TinyURL and analyze its role in the textbook's treatment of social media and mobile marketing. Source: printed page 557. Evidence excerpt: There are a number of applications, such as TinyURL and Bitly, that are capable of turning long URLs into shorter ones; however, the jury is still out on whether search engines perceive these URLs as trustworthy.", label:"Analyze TinyURL in its marketing context", canonical_key:"analyze_tinyurl_in_its_marketing_context", status:"approved"}}, {concept_id:"b1f951e3-c528-5b2d-ac45-3a81961ce1cd", kc_id:"b1f951e3-c528-5b2d-ac45-3a81961ce1cd", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tommy Hilfiger and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: Licensed brands provide the likeness of their brand as a fee for use. If you wear eyeglasses, you likely have a licensed brand name on your eyeglasses frame. Brands like Tiffany & Co., Kate Spade, and Tommy Hilfiger do not produce eyeglasses frames. Rather, they license their brand to manufacturers like Luxottica, an Italian eyewear company that makes the product with the licensed brand name. Licensing a brand is a quick way to gain recognition and benefit from the brand’s equity. On the other hand, licensing fees can be costly and ultimately reduce profitability for manufacturers.", label:"Analyze Tommy Hilfiger in its marketing context", canonical_key:"analyze_tommy_hilfiger_in_its_marketing_context", status:"approved"}}, {concept_id:"d5698e82-75f6-5d05-a0a8-7c234d6074db", kc_id:"d5698e82-75f6-5d05-a0a8-7c234d6074db", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify TOMS and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 24. Evidence excerpt: • Branding and marketing efforts emanate from the organization’s core values and culture and guide the organization’s marketing message. Therefore, if your marketing message doesn’t match the reality of the business, it’s akin to that old adage of “putting lipstick on a pig.”26 You’re talking the talk but not walking the walk. • A strong culture strengthens your marketing message because it gives prospective customers a better idea of the values of your business, and customers who know what you believe and value are much more likely to do business with you. For example, research has demonstrated that 86 percent of buyers are willing to pay more for a positive customer service…", label:"Analyze TOMS in its marketing context", canonical_key:"analyze_toms_in_its_marketing_context", status:"approved"}}, {concept_id:"ded97b2e-1b8c-5645-bf8b-c7bdfd20093a", kc_id:"ded97b2e-1b8c-5645-bf8b-c7bdfd20093a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Top Design Firms and analyze its role in the textbook's treatment of diversity and inclusion marketing. Source: printed page 264. Evidence excerpt: Leading the marketing strategy with a diversity-driven intention can increase customer satisfaction and build stronger brand loyalty. Top Design Firms surveyed hundreds of consumers in late 2020 and found that 67", label:"Analyze Top Design Firms in its marketing context", canonical_key:"analyze_top_design_firms_in_its_marketing_contex", status:"approved"}}, {concept_id:"bc1ad236-805f-5b15-82ea-dd2679d533c0", kc_id:"bc1ad236-805f-5b15-82ea-dd2679d533c0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Toyota and analyze its role in the textbook's treatment of evolution of the marketing concept. Source: printed page 28. Evidence excerpt: The Reckoning When American cars developed a reputation for not being reliable or dependable, this opened an opportunity for Toyota and other Japanese exporters in the late 1960s and 1970s. Learn more about this issue from David Halberstam’s 1986 book The Reckoning. Read the New York Times 1986 review of this book (https://openstax.org/r/booksofthetimes).", label:"Analyze Toyota in its marketing context", canonical_key:"analyze_toyota_in_its_marketing_context", status:"approved"}}, {concept_id:"58230356-5314-5af5-a9a0-68da38a065d4", kc_id:"58230356-5314-5af5-a9a0-68da38a065d4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Trader Joe’s and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 324. Evidence excerpt: Trader Joe’s prioritized building its culture through empowering its “crew members.” Employees at Trader Joe’s are interviewed for enthusiasm and cross-trained throughout the store’s operations.11 Crew members are Trader Joe’s fans themselves and are known for giving recommendations to customers and are empowered to connect with the customers, adding to the neighborhood feel of the store. The food at Trader Joe’s is interesting to the shopper, much of it convenient and ready to eat. Trader Joe’s leverages social media to put its food front and center with recipes and easy-to-prepare pairings. Trader Joe’s thinks about the in-store experience and stocks about 10 percent of the…", label:"Analyze Trader Joe’s in its marketing context", canonical_key:"analyze_trader_joe_s_in_its_marketing_context", status:"approved"}}, {concept_id:"97e0dfe4-a2ff-5369-8659-5b5863a17957", kc_id:"97e0dfe4-a2ff-5369-8659-5b5863a17957", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Transparency International and analyze its role in the textbook's treatment of ethical issues in b2b marketing. Source: printed page 144. Evidence excerpt: Transparency International, a watchdog group, annually ranks the likelihood of companies from the world’s", label:"Analyze Transparency International in its marketing context", canonical_key:"analyze_transparency_international_in_its_market", status:"approved"}}, {concept_id:"8aba60d5-a575-5f42-a9e6-89a9d3c07d89", kc_id:"8aba60d5-a575-5f42-a9e6-89a9d3c07d89", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Travelers Point and analyze its role in the textbook's treatment of product positioning. Source: printed page 193. Evidence excerpt: As the company considered its branding and value proposition, the founders knew they wanted to have a unique story of production along with a price point that ranked with some of the premium bourbon brands currently on the market. Travelers Point bourbon would sell for around $45–60 per bottle. This would put it in the ranks of some of the sought-after brands with a following among die-hard bourbon drinkers.89", label:"Analyze Travelers Point in its marketing context", canonical_key:"analyze_travelers_point_in_its_marketing_context", status:"approved"}}, {concept_id:"a1bab495-1df6-511a-8bf7-1efef699eb93", kc_id:"a1bab495-1df6-511a-8bf7-1efef699eb93", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tropicana and analyze its role in the textbook's treatment of factors influencing channel choice. Source: printed page 591. Evidence excerpt: Perishability relates to the likelihood that a product will spoil, decay, or expire if not used in a timely manner. A product’s perishability also influences channel decisions. For example, orange-juice maker Tropicana’s marketing channel looks much different than Nabisco’s Ritz Crackers’ channel. Because orange juice must be kept cold throughout the distribution process, Tropicana makes channel decisions that allow it to protect the integrity of the product throughout the distribution process. Working with channel partners who are experts at storing, handling, and moving perishable products is one of the most important factors for companies who manufacture perishable products.", label:"Analyze Tropicana in its marketing context", canonical_key:"analyze_tropicana_in_its_marketing_context", status:"approved"}}, {concept_id:"0f0d944b-0e43-5dcf-9b3b-1f223c66d8de", kc_id:"0f0d944b-0e43-5dcf-9b3b-1f223c66d8de", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Trout and analyze its role in the textbook's treatment of product positioning. Source: printed page 181. Evidence excerpt: This third and final step is contained in what’s known as the segmenting, targeting, and positioning model, the STP model. With the STP model, a company segments the market, selects the target market, and positions its products and services into the existing marketplace (see Figure 5.12). In their book Positioning: The Battle for Your Mind, marketing gurus Al Ries and Jack Trout write, “The basic approach of positioning is not to create something new and different, but to manipulate what’s already up there in the mind.”61", label:"Analyze Trout in its marketing context", canonical_key:"analyze_trout_in_its_marketing_context", status:"approved"}}, {concept_id:"40be358f-778c-59d2-be84-b14b9d035589", kc_id:"40be358f-778c-59d2-be84-b14b9d035589", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Truly Organic and analyze its role in the textbook's treatment of ethical issues in retailing and wholesaling. Source: printed page 641. Evidence excerpt: Although there has been a considerable rise in the number of consumers and advocacy groups calling out unethical business practices, many retailers still attempt to use tactics to sway consumers into purchasing products. Truly Organic, a retailer based in Miami Beach, Florida, came under attack by the Federal Trade Commission (FTC) in 2019 for misleading consumers into believing their products were 100 percent organic, which wasn’t entirely true.45 The case stated that Truly Organic was guilty of false or misleading advertising, an unethical marketing practice by which consumers are given false or misleading information about a product or service.", label:"Analyze Truly Organic in its marketing context", canonical_key:"analyze_truly_organic_in_its_marketing_context", status:"approved"}}, {concept_id:"fa0cfb28-b4e8-51c0-961d-12a3ddab0a6f", kc_id:"fa0cfb28-b4e8-51c0-961d-12a3ddab0a6f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Truth in Advertising and analyze its role in the textbook's treatment of ethical concerns in advertising and public relations. Source: printed page 495. Evidence excerpt: Ethical Issues Related to Advertising Marketers must be keenly aware of not only the legal implications of advertising, but also the ethical ramifications. The Federal Trade Commission (FTC) has a number of laws that help to protect consumers against false claims in advertisements. The watchdog group Truth in Advertising is an independent, nonprofit organization that “empower[s] consumers to protect themselves and one another against false advertising and deceptive marketing.”24", label:"Analyze Truth in Advertising in its marketing context", canonical_key:"analyze_truth_in_advertising_in_its_marketing_co", status:"approved"}}, {concept_id:"0200f79d-3662-5455-9b70-00e5639b6036", kc_id:"0200f79d-3662-5455-9b70-00e5639b6036", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Twitter and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 470. Evidence excerpt: Little Debbie featured the product in its social media with release information on all of its channels starting in October, well ahead of the holiday selling season. The company has a robust social media presence with over two million fans on Facebook, 85,000 followers on Instagram, and 200,000 followers on Twitter. The likes, shares, and positive comments had social media buzzing in anticipation of this new product.23", label:"Analyze Twitter in its marketing context", canonical_key:"analyze_twitter_in_its_marketing_context", status:"approved"}}, {concept_id:"0f6d85e1-9a06-559d-bd35-ae215eb1e447", kc_id:"0f6d85e1-9a06-559d-bd35-ae215eb1e447", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Tylenol and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 444. Evidence excerpt: Public relations can also include crisis communication when negative issues occur. One of the biggest public relations issues happened in 1982 to Tylenol. A malicious person or persons in the Chicago area tampered with a few bottles of Tylenol Extra Strength capsules by replacing the actual capsules with cyanide-laced capsules. Consumers who unwittingly bought the Tylenol ended up dead. Johnson & Johnson, the maker of Tylenol, was facing issues that could easily have destroyed its business. The issue was the leading story for every news outlet.", label:"Analyze Tylenol in its marketing context", canonical_key:"analyze_tylenol_in_its_marketing_context", status:"approved"}}, {concept_id:"59e5bcda-27f7-5228-b80d-d266844c2a37", kc_id:"59e5bcda-27f7-5228-b80d-d266844c2a37", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Uber and analyze its role in the textbook's treatment of entering the global arena. Source: printed page 242. Evidence excerpt: A strategic alliance occurs when two companies from different countries agree to invest resources in a mutually beneficial way. For example, Microsoft relies heavily on alliances when entering new markets as a way to optimize the knowledge and market identification of local companies. Uber and Spotify entered into a strategic alliance to allow Uber riders to connect to their Spotify account and stream music while catching a ride.66", label:"Analyze Uber in its marketing context", canonical_key:"analyze_uber_in_its_marketing_context", status:"approved"}}, {concept_id:"17304028-72b6-5d8b-8782-224918641132", kc_id:"17304028-72b6-5d8b-8782-224918641132", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Uber Eats and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 15. Evidence excerpt: • Place utility. Marketing creates place utility when it makes goods or services physically available, convenient, and accessible to customers. Consider the ease a company like Uber Eats adds to your life when you’re craving tacos in the middle of the night and you don’t feel like getting dressed and driving to go get them. You can have your food delivered to you! • Possession utility. Marketers facilitate possession utility by ensuring that a product is relatively easy to acquire. For example, many automobile manufacturers offer low (or sometimes no) interest rates on car loans to make it easy for you to walk out the door with a new set of car keys. Possession utility also…", label:"Analyze Uber Eats in its marketing context", canonical_key:"analyze_uber_eats_in_its_marketing_context", status:"approved"}}, {concept_id:"502bee16-bf34-5f88-b6e9-8435c9b25822", kc_id:"502bee16-bf34-5f88-b6e9-8435c9b25822", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Ultimate Scoop and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 442. Evidence excerpt: For National Ice Cream Day (see Figure 13.4), Cumberland Farms wanted to increase the sales of its house brand of ice cream, Ultimate Scoop.8 It offered consumers a digital coupon for $1 off a pint of the ice cream. Cumberland Farms’ existing customers received their coupon via text message, and new customers could text in to get the coupon.", label:"Analyze Ultimate Scoop in its marketing context", canonical_key:"analyze_ultimate_scoop_in_its_marketing_context", status:"approved"}}, {concept_id:"0e1fd7b2-e6e2-5084-a2cc-da29d6621b9e", kc_id:"0e1fd7b2-e6e2-5084-a2cc-da29d6621b9e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Unilever and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 297. Evidence excerpt: Culturally Sensitive and Socially Inclusive Marketing Multinational industry leaders like Coca-Cola, Google, Adidas, Unilever, AT&T, Marriott International, and Microsoft are just a few of the companies that, like P&G, are focusing their marketing efforts on being more culturally sensitive and socially inclusive. Even niche players, partnerships, and private companies such as Bumble, Fenty Beauty, and ThirdLove are also championing diversity as a core value through equal cultural and sociodemographic representation rather than just chasing a trend in marketing.72", label:"Analyze Unilever in its marketing context", canonical_key:"analyze_unilever_in_its_marketing_context", status:"approved"}}, {concept_id:"1c6b5783-2ca4-5b4e-b94b-c24c68e1efe9", kc_id:"1c6b5783-2ca4-5b4e-b94b-c24c68e1efe9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Union Pacific Railroad and analyze its role in the textbook's treatment of ethical issues in developing a marketing strategy. Source: printed page 81. Evidence excerpt: During the American Industrial Revolution in the early 1900s, the United States saw the rise of iconic business enterprises like Ford, US Steel, J.P. Morgan, Union Pacific Railroad, and many others. Some (a few) gave generously to charitable causes. Others made their wealth using unscrupulous means, exploiting labor and using questionable business practices.", label:"Analyze Union Pacific Railroad in its marketing context", canonical_key:"analyze_union_pacific_railroad_in_its_marketing_", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"53cefbd9-afb9-5d0a-8fa5-4243da8559c9", kc_id:"53cefbd9-afb9-5d0a-8fa5-4243da8559c9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify United Nations (UN) and analyze its role in the textbook's treatment of ethical issues in the global marketplace. Source: printed page 247. Evidence excerpt: The use of child labor is seen by most Americans as unethical. The United Nations (UN) has implemented many treaties that establish human rights for children within member nations.87 However, each country has its own standards for child labor and the minimum age at which a child can work.", label:"Analyze United Nations (UN) in its marketing context", canonical_key:"analyze_united_nations_un_in_its_marketing_conte", status:"approved"}}, {concept_id:"24135df5-7e7b-5340-9667-80596be003da", kc_id:"24135df5-7e7b-5340-9667-80596be003da", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify United States Patent and Trademark Office and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 322. Evidence excerpt: Brands use trademarks (service marks) to ensure that they are protected under the law. According to the United States Patent and Trademark Office, a trademark can be any “word, phrase, symbol, design or a", label:"Analyze United States Patent and Trademark Office in its marketing context", canonical_key:"analyze_united_states_patent_and_trademark_offic", status:"approved"}}, {concept_id:"5f673503-3627-5bb1-9f12-94a89e0d2847", kc_id:"5f673503-3627-5bb1-9f12-94a89e0d2847", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify University of Florida and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 11. Evidence excerpt: First, let’s consider its approach to the product itself. Gatorade managers saw the exercise boom coming as baby boomers began to age and wanted to be the performance and thirst quencher for everyone from kids to pros. The product, which was intended to replace electrolytes lost in sweat, was scientifically formulated first at the University of Florida and later at the Gatorade Sports Science Institute. But Gatorade didn’t rest on its laurels when it comes to product innovation. For example, in order to lure back “lapsed” consumers with concerns over sugar, it launched Gatorade Zero, a thirst quencher without sugar. It also launched its G Series Performance, a new line of food…", label:"Analyze University of Florida in its marketing context", canonical_key:"analyze_university_of_florida_in_its_marketing_c", status:"approved"}}, {concept_id:"29f748f6-3663-5c13-adf1-d2a0025ee9c2", kc_id:"29f748f6-3663-5c13-adf1-d2a0025ee9c2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Upside and analyze its role in the textbook's treatment of pricing and its role in the marketing mix. Source: printed page 407. Evidence excerpt: Founded in 2016, Upside is an app that promotes itself as saving customers money on purchases at gas stations as well as helping local brick-and-mortar businesses earn more profit. Here’s how it works: Upside", label:"Analyze Upside in its marketing context", canonical_key:"analyze_upside_in_its_marketing_context", status:"approved"}}, {concept_id:"37d6936d-8329-541c-b5aa-508c91608e2e", kc_id:"37d6936d-8329-541c-b5aa-508c91608e2e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Bureau of Labor Statistics and analyze its role in the textbook's treatment of developing a strategic plan. Source: printed page 54. Evidence excerpt: There is growth potential in being a marketing manager. The US Bureau of Labor Statistics projects a 10 percent growth in the job role from 2021 to 2031, and you can read more about the job outlook here (https://openstax.org/r/advertisingpromotions).", label:"Analyze US Bureau of Labor Statistics in its marketing context", canonical_key:"analyze_us_bureau_of_labor_statistics_in_its_mar", status:"approved"}}, {concept_id:"938cacd5-e1cd-57e8-8f1d-b6c1fe7658df", kc_id:"938cacd5-e1cd-57e8-8f1d-b6c1fe7658df", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Census Bureau and analyze its role in the textbook's treatment of marketing to sociodemographic groups. Source: printed page 293. Evidence excerpt: Yet, there are several sources claiming that it will decline globally around the middle of the 21st century.68 The United States has already been in a relatively steady population growth decline—or population stagnation—according to trends from the US Census Bureau. In fact, the American growth rate has slowed to its lowest point in over 120 years. If this trend continues, the United States will see its first net population decrease in the next couple of years.69", label:"Analyze US Census Bureau in its marketing context", canonical_key:"analyze_us_census_bureau_in_its_marketing_contex", status:"approved"}}, {concept_id:"a61975d7-face-581e-80a2-bea5d52d7e32", kc_id:"a61975d7-face-581e-80a2-bea5d52d7e32", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Chamber of Commerce and analyze its role in the textbook's treatment of public relations and its role in the promotion mix. Source: printed page 490. Evidence excerpt: For example, in 2020, the National Association of Realtors was the top lobbying association in the United States, followed by the US Chamber of Commerce, Pharmaceutical Research and Manufacturers of America, and the American Hospital Association. Together, these associations spent over $200 million lobbying to impact local, state, and federal legislation.18", label:"Analyze US Chamber of Commerce in its marketing context", canonical_key:"analyze_us_chamber_of_commerce_in_its_marketing_", status:"approved"}}, {concept_id:"4a575a9f-0f1f-5b1b-9272-8c1448f4648a", kc_id:"4a575a9f-0f1f-5b1b-9272-8c1448f4648a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Department of Agriculture (USDA) and analyze its role in the textbook's treatment of recent trends in wholesaling. Source: printed page 639. Evidence excerpt: For example, on January 6, 2022, the US Department of Agriculture (USDA) announced a recall of over 25,000 pounds of ground beef.44 Because of product traceability, the specific ground beef under the recall was able to be traced to a specific location, production date, and lot. Without product traceability, there may have been no way of knowing where the ground beef came from, forcing consumers to discard purchases of product that was not tainted. Additionally, product traceability helps combat counterfeit products by finding the originating source.", label:"Analyze US Department of Agriculture (USDA) in its marketing context", canonical_key:"analyze_us_department_of_agriculture_usda_in_its", status:"approved"}}, {concept_id:"7023acac-9d44-5021-8d25-bcdcf9658121", kc_id:"7023acac-9d44-5021-8d25-bcdcf9658121", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Department of Justice and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 295. Evidence excerpt: Where do business ethics come from? Ethics originate from the need and desire to promote both fair and equitable competition in the market. Ethics are supported by legislation such as the Sherman Antitrust Act from the US Department of Justice. Ethical considerations in diversity marketing have a similar background. They are linked to companies’ fair and equitable outreach and representation of diverse audiences in the market. These include multicultural and sociodemographic consumer segments in particular.", label:"Analyze US Department of Justice in its marketing context", canonical_key:"analyze_us_department_of_justice_in_its_marketin", status:"approved"}}, {concept_id:"5164abf1-2c88-5a93-bbdc-850d4e5f8bee", kc_id:"5164abf1-2c88-5a93-bbdc-850d4e5f8bee", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Environmental Protection Agency (EPA) and analyze its role in the textbook's treatment of the benefits of sustainable marketing. Source: printed page 658. Evidence excerpt: Easier Compliance with Regulators In addition to returning value to shareholders, companies are also responsible for following international, national, and local laws. A sustainability agenda goes beyond companies’ legal obligations and extends to serving the world better. This strategy eases compliance by going above and beyond what is expected by government agencies. For example, the US Environmental Protection Agency (EPA) provides regulatory information by sector to provide businesses with clear regulatory compliance criteria.", label:"Analyze US Environmental Protection Agency (EPA) in its marketing context", canonical_key:"analyze_us_environmental_protection_agency_epa_i", status:"approved"}}, {concept_id:"333b6b3f-f21f-54c5-846d-8e01845e80be", kc_id:"333b6b3f-f21f-54c5-846d-8e01845e80be", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Postal Service and analyze its role in the textbook's treatment of steps in a successful marketing research plan. Source: printed page 209. Evidence excerpt: Let’s start off with mailed surveys—surveys that are sent to potential respondents through a mail service. Mailed surveys used to be more commonly used due to the ability to reach every household. In some instances, a mailed survey is still the best way to collect data. For example, every 10 years the United States conducts a census of its population (see Figure 6.6). The first step in that data collection is to send every household a survey through the US Postal Service (USPS). The benefit is that respondents can complete and return the survey at their convenience. The downside of mailed surveys are expense and timeliness of responses. A mailed survey requires postage, both when…", label:"Analyze US Postal Service in its marketing context", canonical_key:"analyze_us_postal_service_in_its_marketing_conte", status:"approved"}}, {concept_id:"87e42bd4-ba9b-5838-8995-fe931a7f237c", kc_id:"87e42bd4-ba9b-5838-8995-fe931a7f237c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify US Steel and analyze its role in the textbook's treatment of ethical issues in developing a marketing strategy. Source: printed page 81. Evidence excerpt: During the American Industrial Revolution in the early 1900s, the United States saw the rise of iconic business enterprises like Ford, US Steel, J.P. Morgan, Union Pacific Railroad, and many others. Some (a few) gave generously to charitable causes. Others made their wealth using unscrupulous means, exploiting labor and using questionable business practices.", label:"Analyze US Steel in its marketing context", canonical_key:"analyze_us_steel_in_its_marketing_context", status:"approved"}}, {concept_id:"e7aa8918-2f87-5370-9744-4b7f4d439fca", kc_id:"e7aa8918-2f87-5370-9744-4b7f4d439fca", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Vanity Fair and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 158. Evidence excerpt: With gender segmentation, the market is divided into men and women. Those who identify as men and those who identify as women have different interests in terms of shopping for various products like apparel, shoes, and food. For example, look at the ad campaigns crafted toward women in fashion magazines such as Vogue or Vanity Fair. You’ll likely see a different ad focus in magazines like GQ or Men’s Health.", label:"Analyze Vanity Fair in its marketing context", canonical_key:"analyze_vanity_fair_in_its_marketing_context", status:"approved"}}, {concept_id:"00830c1f-dff4-5369-a5c8-77e5b56b20d6", kc_id:"00830c1f-dff4-5369-a5c8-77e5b56b20d6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Vector Marketing and analyze its role in the textbook's treatment of sales promotion and its role in the promotion mix. Source: printed page 537. Evidence excerpt: Vector Marketing works hard to recruit, educate, train, and incentivize its sales force. The hardworking Vector Marketing sales representatives know that up for grabs is a total of $40,000 to full-time undergraduate students who sell the most—the top 50 students get this award every summer. Vector also gives a guaranteed base pay and even pays the student for the appointment, regardless of whether they make the sale. The company doesn’t want a reputation for high-pressure sales although they do pay commissions. Vector Marketing and Cutco realize only satisfied customers are repeat and referral customers.", label:"Analyze Vector Marketing in its marketing context", canonical_key:"analyze_vector_marketing_in_its_marketing_contex", status:"approved"}}, {concept_id:"732139ce-947d-5822-b30d-80f01b3e02c6", kc_id:"732139ce-947d-5822-b30d-80f01b3e02c6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Vetcove and analyze its role in the textbook's treatment of managing the distribution channel. Source: printed page 593. Evidence excerpt: The channel members that a company selects depends entirely on the company’s evaluation of the channel member alternatives. Manufacturers should examine each channel member’s years in business and experience carrying product lines. They should also evaluate each member’s reputation and its profitability. PetVivo, maker of biomedical devices for pets, selected Vetcove to distribute a device for pets with osteoporosis. Because PetVivo needed to reach veterinary hospitals and clinics across all 50 states, Vetcove was the right choice because of its experience serving over 13,000 veterinary hospitals and clinics. Its expertise and reputation were attractive characteristics for…", label:"Analyze Vetcove in its marketing context", canonical_key:"analyze_vetcove_in_its_marketing_context", status:"approved"}}, {concept_id:"d603b9a8-8347-508f-90f9-1f53d3dd754e", kc_id:"d603b9a8-8347-508f-90f9-1f53d3dd754e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Victoria’s Secret and analyze its role in the textbook's treatment of marketing to sociodemographic groups. Source: printed page 292. Evidence excerpt: How can marketers best reach consumers with disabilities? By using an approach that ensures the company’s efforts express humanity, authenticity, and inclusivity. Let’s look at a couple of examples. In January 2019, a picture from a bridal boutique’s window display went viral due to its powerful inclusivity message. The display showed a mannequin in a wheelchair dressed in a wedding gown. In February 2022, Hispanic model Sofia Jirau made history as the first person with Down syndrome to become a model for Victoria’s Secret. These examples demonstrate that people with disabilities are not only part of our social fabric but also are an integral part of the overall market.", label:"Analyze Victoria’s Secret in its marketing context", canonical_key:"analyze_victoria_s_secret_in_its_marketing_conte", status:"approved"}}, {concept_id:"1efebdfa-91e2-57db-8cad-644b44593ff0", kc_id:"1efebdfa-91e2-57db-8cad-644b44593ff0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Vizio and analyze its role in the textbook's treatment of ethical marketing. Source: printed page 36. Evidence excerpt: • Ensure transparency. Transparency is key, and marketers should attempt to provide the maximum amount of information to the consumer regarding the product, its usage, and safety concerns. For example, Southwest Airlines ran a clever marketing campaign entitled “Transfarency,” promoting its philosophy that customers should be treated honestly and fares should actually stay low. The result? The campaign garnered nearly 5 million likes on Facebook alone.57 How’s that for earning the trust of potential customers? • Respect data privacy. As we noted in our discussion of CRM above, marketers have the ability to collect vast amounts of data about consumers. Data privacy is the biggest…", label:"Analyze Vizio in its marketing context", canonical_key:"analyze_vizio_in_its_marketing_context", status:"approved"}}, {concept_id:"8fb63ea0-c5dd-5645-9049-158bbede1a7b", kc_id:"8fb63ea0-c5dd-5645-9049-158bbede1a7b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify VMware and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 652. Evidence excerpt: Williams-Sonoma is just one example of a company with a vision and a commitment to sustainability. Other companies known for their sustainability commitments and practices include Microsoft, VMware, Intuit, Apple, and Mastercard.9", label:"Analyze VMware in its marketing context", canonical_key:"analyze_vmware_in_its_marketing_context", status:"approved"}}, {concept_id:"d6597db0-90cb-524c-b6ab-9334e40b7756", kc_id:"d6597db0-90cb-524c-b6ab-9334e40b7756", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Vogue and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 158. Evidence excerpt: With gender segmentation, the market is divided into men and women. Those who identify as men and those who identify as women have different interests in terms of shopping for various products like apparel, shoes, and food. For example, look at the ad campaigns crafted toward women in fashion magazines such as Vogue or Vanity Fair. You’ll likely see a different ad focus in magazines like GQ or Men’s Health.", label:"Analyze Vogue in its marketing context", canonical_key:"analyze_vogue_in_its_marketing_context", status:"approved"}}, {concept_id:"48bac6d6-8430-5116-9573-af666347044a", kc_id:"48bac6d6-8430-5116-9573-af666347044a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Volkswagen and analyze its role in the textbook's treatment of marketing and the marketing process. Source: printed page 15. Evidence excerpt: Another way to approach this is to create separate brands and compete in both arenas. Consider Volkswagen. You might immediately think of the VW Beetle or the Jetta, but the company’s brand portfolio extends beyond", label:"Analyze Volkswagen in its marketing context", canonical_key:"analyze_volkswagen_in_its_marketing_context", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"532b06e3-5f90-58f8-80d0-5bf62d1e67da", kc_id:"532b06e3-5f90-58f8-80d0-5bf62d1e67da", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Walgreens and analyze its role in the textbook's treatment of branding and brand development. Source: printed page 323. Evidence excerpt: Private-label brands are store brands that are similar products to a national brand and labeled privately. If you have shopped at a Walgreens, you may have seen its private-label brand of products that begin with the prefix Wal-. A McKinsey study indicates that price accounted for 45 percent of brand switchers from national to private brands, while lack of availability was a secondary reason.10 The same study suggests that customers can develop loyalty to private-label brands. However, the private-label brand must create a point of differentiation relevant to the target audience in the same way that a national brand would.", label:"Analyze Walgreens in its marketing context", canonical_key:"analyze_walgreens_in_its_marketing_context", status:"approved"}}, {concept_id:"889ea8d4-3f35-5dcb-82bb-c31f647104f9", kc_id:"889ea8d4-3f35-5dcb-82bb-c31f647104f9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Walmart and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 25. Evidence excerpt: • Suppliers. Suppliers (sometimes also called vendors) are those partners from whom we receive the parts and products necessary for our business. Let’s assume that your company produces microwave ovens. Some of your suppliers may be providers of transformers, the turntable, control panels, magnetrons, etc. As long as you have options in terms of the component suppliers, the bargaining power of each supplier is relatively weak. However, if two suppliers merge and decide to raise the price of the component the new entity supplies, that vendor now wields increased power. • Market Intermediaries. Often, products are distributed by third-party sellers such as retailers, wholesalers,…", label:"Analyze Walmart in its marketing context", canonical_key:"analyze_walmart_in_its_marketing_context", status:"approved"}}, {concept_id:"a2f22dda-84bf-58c7-a3a9-1d6309cb7f9c", kc_id:"a2f22dda-84bf-58c7-a3a9-1d6309cb7f9c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Walt Disney Company and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 238. Evidence excerpt: When the Walt Disney Company decided to open Disneyland Hong Kong in 2005, the company struggled to gain momentum with its Chinese target market. Among other blunders, such as its high admission price, the company assumed that its Chinese market would love the Disney brand as much as Americans do. The company failed to realize that, unlike Americans, the Chinese did not grow up with the Disney brands and characters. Imagine walking into a fantasy theme park with characters you had never heard of or seen before. Unlike Americans, the Chinese do not view Disney characters as cultural icons. The fantasy aspect of the brand and park was another issue Disney faced. Its closest…", label:"Analyze Walt Disney Company in its marketing context", canonical_key:"analyze_walt_disney_company_in_its_marketing_con", status:"approved"}}, {concept_id:"7fa4792a-5de5-532c-870d-fb498db922e4", kc_id:"7fa4792a-5de5-532c-870d-fb498db922e4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Warby Parker and analyze its role in the textbook's treatment of ethical considerations in pricing. Source: printed page 429. Evidence excerpt: Warby Parker Warby Parker sought to find a solution to the problem of expensive eyeglasses—a medical necessity for many people. The company stated that “the eyewear industry [was] dominated by a single company that has been able to keep prices artificially high while reaping huge profits from consumer who have no other options.”38 Warby Parker set out to change the way in which glasses were offered to consumers. The company’s direct-to-consumer approach and a uniform pricing strategy have made waves in the eyewear industry.", label:"Analyze Warby Parker in its marketing context", canonical_key:"analyze_warby_parker_in_its_marketing_context", status:"approved"}}, {concept_id:"88ec89ea-b2f2-59c9-9462-5ebfbdba66c9", kc_id:"88ec89ea-b2f2-59c9-9462-5ebfbdba66c9", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wayfair and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 544. Evidence excerpt: Every year, MailCon brings together marketing professionals, brands, and agencies to discuss the latest trends in email technology, strategy, and automation. Major brands like Wayfair, Girl Scouts of the USA, Ford Motor Company, and A&E Networks gather to network and learn about advancements in the email marketing space.6", label:"Analyze Wayfair in its marketing context", canonical_key:"analyze_wayfair_in_its_marketing_context", status:"approved"}}, {concept_id:"bf0a4e13-2e08-53c9-a054-f5d936255db6", kc_id:"bf0a4e13-2e08-53c9-a054-f5d936255db6", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Weinreb Group and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 651. Evidence excerpt: In the Spotlight According to Accenture, a global professional services company, “Sustainable organizations are purpose-led businesses which inspire their people and partners to deliver lasting financial performance, equitable impact, and societal value that earns and retains the trust of all stakeholders.”1 Sustainability is about doing business without negatively affecting society. Without sustainable practices, companies may negatively contribute to issues in the environment, inequality, and social injustice.2 Consumers, employees, and other interested parties are now holding businesses to higher standards: 74 percent of consumers agree that conducting ethical practices is an…", label:"Analyze Weinreb Group in its marketing context", canonical_key:"analyze_weinreb_group_in_its_marketing_context", status:"approved"}}, {concept_id:"284504f6-da0a-5013-b97d-366867241c20", kc_id:"284504f6-da0a-5013-b97d-366867241c20", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Welch’s Fruit Snacks and analyze its role in the textbook's treatment of ethical concerns and target marketing. Source: printed page 188. Evidence excerpt: childhood obesity has “more than tripled since the 1970s,” and it’s estimated that one in five school-aged children is obese.81 Yet watch the commercials on children’s TV shows, and you’ll find that they are almost completely dominated by unhealthy food products like candy, sugary cereal, and snacks. To their credit, some forward-thinking companies have made it a practice not to advertise to children under 12 because of the association with childhood obesity. For instance, according to the Council of Better Business Bureaus, Brach’s, Lemonhead, Ghirardelli, Jelly Belly, PEEPS, Mike and Ike, and Welch’s Fruit Snacks avoid advertising to children under 12.82", label:"Analyze Welch’s Fruit Snacks in its marketing context", canonical_key:"analyze_welch_s_fruit_snacks_in_its_marketing_co", status:"approved"}}, {concept_id:"49c174db-0212-5c9e-9723-1965bf7e8a98", kc_id:"49c174db-0212-5c9e-9723-1965bf7e8a98", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wells Fargo and analyze its role in the textbook's treatment of marketing to hispanic, black, and asian consumers. Source: printed page 285. Evidence excerpt: Shared societal values are a trait that influence people’s behaviors. One of these is collectivism. Think about Hofstede’s cultural dimensions, individualism versus collectivism in particular. Collectivism places more emphasis on group activities than on individual ones. Overall, Asian societies are collectivistic, though the degree of collectivism varies among the populations’ countries of origin.64 Cultural celebrations are also a factor linked to identity. Instacart, Target, Wells Fargo, and Toyota are just a few companies marketing to Asian", label:"Analyze Wells Fargo in its marketing context", canonical_key:"analyze_wells_fargo_in_its_marketing_context", status:"approved"}}, {concept_id:"9eca8bde-46dc-592f-a073-d9dc14d905d8", kc_id:"9eca8bde-46dc-592f-a073-d9dc14d905d8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wendy’s and analyze its role in the textbook's treatment of major influences on b2b buyer behavior. Source: printed page 139. Evidence excerpt: Competition also affects B2B buying behavior. It stands to reason that, when a competitor changes its product offering and garners more market share, a business will want to respond by going on the defensive and changing its product offering as well, triggering one or more B2B buying situations. The fast-food industry is just one example of this. Wendy’s was the first national fast-food chain to introduce salads in response to consumers’ desires for healthier food options.15 Shortly thereafter, many other competitors, including Arby’s, McDonald’s, Chick-fil-A, and Burger King, followed suit.", label:"Analyze Wendy’s in its marketing context", canonical_key:"analyze_wendy_s_in_its_marketing_context", status:"approved"}}, {concept_id:"e364d3ea-2740-5a7d-9579-af4d1fc7f7ba", kc_id:"e364d3ea-2740-5a7d-9579-af4d1fc7f7ba", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify WhatsApp and analyze its role in the textbook's treatment of ethical issues in the global marketplace. Source: printed page 247. Evidence excerpt: Outsourcing refers to a business moving some of its operations to a foreign country for the purpose of saving money and time or to increase volume and quality. WhatsApp, an encrypted communication app owned by Meta Platforms (formerly Facebook), has been used globally for several years. Based out of California, the company realized that it would have difficulty growing if it did not outsource. In 2012, the company began utilizing Russian companies for a small fraction of what it would have had to pay within the United States.81 While outsourcing has its advantages, many will argue that outsourcing eliminates jobs in the home country.", label:"Analyze WhatsApp in its marketing context", canonical_key:"analyze_whatsapp_in_its_marketing_context", status:"approved"}}, {concept_id:"873d0b4b-0e58-5c81-b0c8-fbcd4a822fc4", kc_id:"873d0b4b-0e58-5c81-b0c8-fbcd4a822fc4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Whirlpool and analyze its role in the textbook's treatment of buyers and buying situations in a b2b market. Source: printed page 134. Evidence excerpt: The new-task buy occurs when a B2B buyer buys a product or service for the first time. These buying situations are among the most difficult and time-consuming ones because typically the B2B buyer has no previous experience with the product, the service, or perhaps the vendors. This means that, instead of relying on past purchase orders or product specifications, the B2B buyer has to start from scratch and do considerable research in terms of product specifications, find out which firms supply the product, and obtain information on the quality, pricing, delivery, and customer service of each of these vendors. For example, if Whirlpool designs a new microwave oven, the B2B buyer…", label:"Analyze Whirlpool in its marketing context", canonical_key:"analyze_whirlpool_in_its_marketing_context", status:"approved"}}, {concept_id:"f20bc22b-a565-5d75-999f-f95a8dae618c", kc_id:"f20bc22b-a565-5d75-999f-f95a8dae618c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Whole Foods and analyze its role in the textbook's treatment of ethical concerns in advertising and public relations. Source: printed page 496. Evidence excerpt: Whole Foods, known for offering natural foods, faced scrutiny over its mislabeling of genetically engineered foods. The company’s top priority became that of transparency, and it requires every product sold as non-GMO to go through a verification process.30", label:"Analyze Whole Foods in its marketing context", canonical_key:"analyze_whole_foods_in_its_marketing_context", status:"approved"}}, {concept_id:"a7e66708-a168-55e6-9be1-89d8a3e2dbeb", kc_id:"a7e66708-a168-55e6-9be1-89d8a3e2dbeb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wilde and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Wilde in its marketing context", canonical_key:"analyze_wilde_in_its_marketing_context", status:"approved"}}, {concept_id:"6091006f-bd8f-5d8c-ac09-d2af92bd0caf", kc_id:"6091006f-bd8f-5d8c-ac09-d2af92bd0caf", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Williams-Sonoma and analyze its role in the textbook's treatment of sustainable marketing. Source: printed page 651. Evidence excerpt: Barron’s, a respected source on financial news, creates a 100 Most Sustainable Companies list each year. In 2021, the popular kitchen supply store Williams-Sonoma stood out above others because its board consisted of 67 percent women.6 Williams-Sonoma, Inc.’s 2021 impact report outlined that, at the time of publication, 46 percent of the company’s products supported one or more of its environmental and social initiatives, and the", label:"Analyze Williams-Sonoma in its marketing context", canonical_key:"analyze_williams_sonoma_in_its_marketing_context", status:"approved"}}, {concept_id:"b8055b41-e507-5bad-a308-a289c31232d5", kc_id:"b8055b41-e507-5bad-a308-a289c31232d5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wilmar International Limited and analyze its role in the textbook's treatment of entering the global arena. Source: printed page 242. Evidence excerpt: A joint venture is a business arrangement whereby two or more companies create one single enterprise or project. The joint venture can last for any length of time but typically is not permanent. The advantage of a joint venture is that the two companies share all the risks associated with the venture.64 In 2012, Kellogg’s and Wilmar International Limited announced a joint venture. Kellogg’s wanted to expand its presence in the Chinese market. Creating a joint venture with Wilmar International provided the company with an extensive distribution network. Both companies benefited from this venture: Wilmar International through its financial incentives and Kellogg’s with a way to…", label:"Analyze Wilmar International Limited in its marketing context", canonical_key:"analyze_wilmar_international_limited_in_its_mark", status:"approved"}}, {concept_id:"fececd4e-3d21-568c-9ed4-6d2a667c10a4", kc_id:"fececd4e-3d21-568c-9ed4-6d2a667c10a4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Winfrey and analyze its role in the textbook's treatment of strategic marketing: standardization versus adaptation. Source: printed page 260. Evidence excerpt: Oprah Winfrey strongly praised the campaign’s creative opportunities, since Black creators account for only 6 percent of all films made.2 These types of initiatives are evidence that P&G remains steadfast in its support of cultural and societal values, as well as expanding marketing’s horizons to be more inclusive.", label:"Analyze Winfrey in its marketing context", canonical_key:"analyze_winfrey_in_its_marketing_context", status:"approved"}}, {concept_id:"2447d2e6-aa04-5bf9-8228-830217f65a03", kc_id:"2447d2e6-aa04-5bf9-8228-830217f65a03", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Winter Olympics and analyze its role in the textbook's treatment of ethical issues in diversity marketing. Source: printed page 297. Evidence excerpt: For the 2014 Super Bowl and the Winter Olympics in Sochi, Russia, Coca-Cola launched the “America Is Beautiful” campaign.74 Recognizing the growth of multicultural consumers in the United States, the campaign’s commercial featured seven young bilingual American women singing in different languages. It also showed culturally diverse consumers from all walks of life. Although the campaign was subject to severe criticism and sparked outrage and boycotts by some people, Coca-Cola was applauded by others for its commitment to a more inclusive marketing communication. That is what diversity marketing is all about.", label:"Analyze Winter Olympics in its marketing context", canonical_key:"analyze_winter_olympics_in_its_marketing_context", status:"approved"}}, {concept_id:"242cdded-03eb-524a-ae9d-1662174e0ff8", kc_id:"242cdded-03eb-524a-ae9d-1662174e0ff8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wintour and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 443. Evidence excerpt: When Nordstrom opened its flagship store in Manhattan, it unlocked the doors a few days early for a VIP celebration that included Vogue’s editor, Anna Wintour, along with actresses, models, and designers. Some of the noted attendees included Zoe Saldana, Katie Holmes, Olivia Wilde, Karlie Kloss, Joan Smalls, Winnie Harlow, Tory Burch, Tommy Hilfiger, and Stacey Bendet of Alice + Olivia. Guests formed long lines around the store in an attempt to access the party.9", label:"Analyze Wintour in its marketing context", canonical_key:"analyze_wintour_in_its_marketing_context", status:"approved"}}, {concept_id:"e81fcdb4-3eec-521c-8950-a19c43a45bc5", kc_id:"e81fcdb4-3eec-521c-8950-a19c43a45bc5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wired Coffee Bar and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 124. Evidence excerpt: Just as Wired Coffee Bar was hitting its stride, new coffee shops started to enter the once-dormant community. Each new coffee location offered a drive-through, something Wired Coffee Bar never wants to be—fast-food coffee. As Lisa looked at ways to create more business, provide good coffee, and differentiate from the masses, she wondered if her concept could survive the hustle and the need for quicker service and a less laid- back atmosphere.", label:"Analyze Wired Coffee Bar in its marketing context", canonical_key:"analyze_wired_coffee_bar_in_its_marketing_contex", status:"approved"}}, {concept_id:"1acdcf1f-5ba1-5cb9-83e0-dd5bdfa0af76", kc_id:"1acdcf1f-5ba1-5cb9-83e0-dd5bdfa0af76", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wisconsin Department of Agriculture and analyze its role in the textbook's treatment of ethical considerations in pricing. Source: printed page 428. Evidence excerpt: Predatory Pricing Another unethical (and usually illegal) pricing strategy is that of predatory pricing. Predatory pricing occurs when a company prices goods or services so low that other companies cannot compete. Predatory pricing often entails a company selling products below its cost with the intent of driving out competition and creating a monopoly situation. Once competition is eliminated, the company will often increase the prices exponentially—not only to recuperate losses from the lower prices, but also to make more profit. Under various antitrust laws, this practice is illegal when it seeks to drive out competition and makes a market susceptible to monopolies.35 In 2000,…", label:"Analyze Wisconsin Department of Agriculture in its marketing context", canonical_key:"analyze_wisconsin_department_of_agriculture_in_i", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"963f585b-f652-51e8-b0af-e075b0a644af", kc_id:"963f585b-f652-51e8-b0af-e075b0a644af", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify World Food Championships and analyze its role in the textbook's treatment of steps in the imc planning process. Source: printed page 460. Evidence excerpt: For example, when World Food Championships wanted to reach home cooks, professional chefs, and aspiring chefs to participate in its Food Sport events, it enticed them with the opportunity for a big payout in winnings. And it created a connection with them through smaller local qualifying events. When the winners of smaller events received a Golden Ticket to compete, they were instantly excited. Then they realized the competition would allow them to meet with even bigger food celebrities and increase their chances of television fame (see Figure 13.15).", label:"Analyze World Food Championships in its marketing context", canonical_key:"analyze_world_food_championships_in_its_marketin", status:"approved"}}, {concept_id:"a43a31e2-449b-51c5-a866-3e2a633db6ee", kc_id:"a43a31e2-449b-51c5-a866-3e2a633db6ee", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify World Trade Organization (WTO) and analyze its role in the textbook's treatment of assessment of global markets for opportunities. Source: printed page 235. Evidence excerpt: Tariffs are taxes that governments impose on imports coming into the country. Tariffs can be imposed as a percentage (most common) or dollar amount. Tariffs are generally used by governments to bring more money into a country. Japan, for example, has one of the lowest tariffs in the world at 2.5 percent for nonagricultural products.31 Conversely, the East African nation of Seychelles once had a much higher tariff rate, averaging well over 50 percent prior to joining the World Trade Organization (WTO) in 2015.32 After joining the WTO, tariffs were reduced to under 25 percent.33", label:"Analyze World Trade Organization (WTO) in its marketing context", canonical_key:"analyze_world_trade_organization_wto_in_its_mark", status:"approved"}}, {concept_id:"b7a85b6e-a7ce-5b0d-a027-bf53a4a68627", kc_id:"b7a85b6e-a7ce-5b0d-a027-bf53a4a68627", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wounded Warrior Project and analyze its role in the textbook's treatment of buyers and buying situations in a b2b market. Source: printed page 131. Evidence excerpt: Types of Buyers in the B2B Market The B2B marketplace is populated by many different types of buyers, each with their own requirements, policies, and procedures. Some B2B buyers (known as producers) purchase goods in the B2B market so they can produce other goods to be sold to other businesses or consumers. Other B2B buyers (known as resellers) purchase goods in the B2B market so they can resell, rent, or lease those goods or services. Still other B2B customers, such as the government and nonprofit institutions such as the Wounded Warrior Project, the Salvation Army, churches, and charities, purchase goods to serve the public in some way.3 These types of buyers are shown in…", label:"Analyze Wounded Warrior Project in its marketing context", canonical_key:"analyze_wounded_warrior_project_in_its_marketing", status:"approved"}}, {concept_id:"bdf839e9-2726-5dd5-b791-8804b5abbbc0", kc_id:"bdf839e9-2726-5dd5-b791-8804b5abbbc0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Wyzowl and analyze its role in the textbook's treatment of traditional direct marketing. Source: printed page 547. Evidence excerpt: Along with the drop in cost to produce online videos, consumer demand for videos has increased. Because of this demand, Instagram, Facebook, and Twitter have pivoted to video-first platforms. Wyzowl’s annual State of Video Marketing Survey revealed in 2021 that online video watching has doubled since 2018 and that online marketers “feel positive about the return on investment offered by video more than ever as it continues to strongly influence traffic, leads, sales, and audience understanding.”12", label:"Analyze Wyzowl in its marketing context", canonical_key:"analyze_wyzowl_in_its_marketing_context", status:"approved"}}, {concept_id:"24aa973d-b826-5ade-86f3-7b88b7aee25b", kc_id:"24aa973d-b826-5ade-86f3-7b88b7aee25b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Yankelovich Inc. and analyze its role in the textbook's treatment of the promotion mix and its elements. Source: printed page 438. Evidence excerpt: According to the marketing firm Yankelovich Inc., the average digitally connected person is exposed to around 5,000 ads per day.4 Among the biggest promotional spenders in the United States is Disney.5 Disney produces ads for everything from its movies and toys to its vacation clubs and theme parks. While we should be flattered that these companies are thinking of us and trying to figure out how to reach us and what messages they should send, many consumers are busy trying to figure out how to shut out the messages.", label:"Analyze Yankelovich Inc. in its marketing context", canonical_key:"analyze_yankelovich_inc_in_its_marketing_context", status:"approved"}}, {concept_id:"1c71d34a-bf73-59d7-8ebc-c20b456d1d2e", kc_id:"1c71d34a-bf73-59d7-8ebc-c20b456d1d2e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify YouTube and analyze its role in the textbook's treatment of understanding consumer markets and buying behavior. Source: printed page 96. Evidence excerpt: Click to view content (https://openstax.org/books/principles-marketing/pages/3-1-understanding- consumer-markets-and-buying-behavior) As mentioned, environmental factors have an impact on consumer behavior. Can you think of a recent environmental influence that has had a significant impact? The coronavirus pandemic has probably been the most influential in recent years, and for many reasons! We still have a lot to learn about the impacts of the pandemic, and new information is being released daily about changing human behavior and the impact on marketing. For example, in this Google article, the author shares a cultural anthropologist’s insights…", label:"Analyze YouTube in its marketing context", canonical_key:"analyze_youtube_in_its_marketing_context", status:"approved"}}, {concept_id:"43a95be8-22b3-57a3-9a8b-b133d7340470", kc_id:"43a95be8-22b3-57a3-9a8b-b133d7340470", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Zales and analyze its role in the textbook's treatment of major types of retailers. Source: printed page 621. Evidence excerpt: In some ways, factory outlets are similar to off-price retailers (see Figure 18.6). The goods found in factory outlets are typically over-manufactured and sold at lower prices. However, factory outlet goods are sold directly from the manufacturer rather than through a third party. Many clothing manufacturers have factory outlets, which are typically clustered together in a factory outlet mall, a space where numerous factory outlets are located. For example, you may see Coach, Gap, or Lands’ End stores in outlet malls. Sawgrass Mills Factory Outlet, located in Sunrise, Florida, is the largest factory outlet mall in the United States. It houses over 350 factory outlet stores,…", label:"Analyze Zales in its marketing context", canonical_key:"analyze_zales_in_its_marketing_context", status:"approved"}}, {concept_id:"ba202f75-7fdc-5d74-9293-8494124d5703", kc_id:"ba202f75-7fdc-5d74-9293-8494124d5703", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Zappos and analyze its role in the textbook's treatment of factors comprising and affecting the marketing environment. Source: printed page 23. Evidence excerpt: For an example of a positive organizational culture, consider Zappos, where happiness is at the core. Founder Tony Hsieh wrote a book on the topic and has said, “We’re willing to give up short-term profits or revenue growth to make sure we have the best culture.”23 Hsieh was not afraid to put his money where his mouth was, either. In support of maintaining an outstanding company culture and a productive workforce, he instituted a policy that would pay new, unhappy employees $2,000 to quit following their four-week training period.24", label:"Analyze Zappos in its marketing context", canonical_key:"analyze_zappos_in_its_marketing_context", status:"approved"}}, {concept_id:"97d3a566-a43c-5309-88c6-6ef85817e16e", kc_id:"97d3a566-a43c-5309-88c6-6ef85817e16e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Zenni and analyze its role in the textbook's treatment of classification of services. Source: printed page 381. Evidence excerpt: Savvy marketers reduce this uncertainty by creating physical “evidence” that allows the consumer to picture the service before it is purchased. For example, a hair salon may have imaging software that predicts how you would look with different hairstyles or colors. Companies like Zenni and Eyebuydirect have a virtual mirror that allows you to “try on eyeglasses” and see how the selected frames look on your face before you purchase.7", label:"Analyze Zenni in its marketing context", canonical_key:"analyze_zenni_in_its_marketing_context", status:"approved"}}, {concept_id:"71ff2da2-dea4-51f1-a862-d06502a733e8", kc_id:"71ff2da2-dea4-51f1-a862-d06502a733e8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Zondervan and analyze its role in the textbook's treatment of market segmentation and consumer markets. Source: printed page 159. Evidence excerpt: Race, ethnicity, and religion can be used to segment a market. It’s always dangerous to stereotype, but consumers of different races, ethnicities, and religions have different preferences and needs. Consider a company like Zondervan, a leading bible publisher. It would make sense for the company to segment its market based upon religion because it offers products that complement the religious beliefs of a particular group. Likewise, IMAN Cosmetics is designed for women with darker skin tones, so its target market would likely be women of color.", label:"Analyze Zondervan in its marketing context", canonical_key:"analyze_zondervan_in_its_marketing_context", status:"approved"}}, {concept_id:"93b145be-5513-56b2-bf46-d4b250abd2f3", kc_id:"93b145be-5513-56b2-bf46-d4b250abd2f3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Zoom and analyze its role in the textbook's treatment of strategic marketing: standardization versus adaptation. Source: printed page 261. Evidence excerpt: Sometimes businesses need adaptation strategies because of market disruptions caused by socioeconomic issues, natural disasters, or health concerns like the COVID-19 pandemic. Zoom, the video conferencing company, was forced to adjust its practices at lightning speed to meet the unexpected demand uptick caused by the pandemic. In only five months (December 2019 to April 2020), Zoom’s customer base grew from 10 million to 300 million users.4 Zoom’s adaptation strategy included new data centers, extended partnerships, price and service changes, and platform updates to serve all types of customers.", label:"Analyze Zoom in its marketing context", canonical_key:"analyze_zoom_in_its_marketing_context", status:"approved"}}, {concept_id:"36eb3fd1-460a-54d4-961c-dcb0347ea449", kc_id:"36eb3fd1-460a-54d4-961c-dcb0347ea449", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"entity", definition:"Identify Zoomers and analyze its role in the textbook's treatment of factors that influence consumer buying behavior. Source: printed page 102. Evidence excerpt: power,7 so you can imagine its impact on the consumer market. What types of products would you expect baby boomers to buy? Key categories for this group of buyers include pharmacy and health care products, household goods and appliances, wine, books (both digital and physical), cosmetics, and skin care products.8 • Generation X (born between 1965 and 1979/80) are currently in their 40s and 50s. This cohort is approximately 65 million strong9 and generally has more spending power than younger generational cohorts because they’re at or reaching the peak of their careers, and many Gen Xers are dual-income families.10 This makes them an optimal target for higher-end brands and…", label:"Analyze Zoomers in its marketing context", canonical_key:"analyze_zoomers_in_its_marketing_context", status:"approved"}}, {concept_id:"c9f2882a-e47e-5924-aee6-0e3a6f52cef3", kc_id:"c9f2882a-e47e-5924-aee6-0e3a6f52cef3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Applied Marketing Knowledge: Discussion Questions, task 1. Learner task: Why is capturing customer lifetime value so important? Choose a retailer, and apply this concept as a way to explain, in part, its profitability and long-term viability in the marketplace.", label:"Ch. 1 Discussion Questions, task 1: Why is capturing customer lifetime value so important", canonical_key:"ch_1_discussion_questions_task_1_why_is_capturin", status:"approved"}}, {concept_id:"c883353d-5b7a-5738-a828-ce95fb245eff", kc_id:"c883353d-5b7a-5738-a828-ce95fb245eff", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Applied Marketing Knowledge: Discussion Questions, task 2. Learner task: The marketing mix has been compared to a toolbelt. In other words, successful marketers can devise an appropriate marketing mix by combining the right blend of tools: product, price, place, and promotion. Describe a recent product that you purchased on Amazon.com or some other online retailer (place), how you located it (promotion), and whether the price was competitive when compared to similar products.", label:"Ch. 1 Discussion Questions, task 2: The marketing mix has been compared to a toolbelt", canonical_key:"ch_1_discussion_questions_task_2_the_marketing_m", status:"approved"}}, {concept_id:"3965d1ae-fa37-5c4d-874e-a26484eebd02", kc_id:"3965d1ae-fa37-5c4d-874e-a26484eebd02", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Applied Marketing Knowledge: Discussion Questions, task 3. Learner task: Why do some marketers prefer to follow the 4Ps (product, price, place, and promotion) of marketing and others might prefer to follow the new pattern of the 5Ms (minds, minutes, machinery, materials, and money)?", label:"Ch. 1 Discussion Questions, task 3: Why do some marketers prefer to follow the 4Ps (product, price, place, and promotion)…", canonical_key:"ch_1_discussion_questions_task_3_why_do_some_mar", status:"approved"}}, {concept_id:"e34b9334-bf80-5248-98de-a397a9681b1d", kc_id:"e34b9334-bf80-5248-98de-a397a9681b1d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Applied Marketing Knowledge: Discussion Questions, task 4. Learner task: A person can be a product. Please give an example of this.", label:"Ch. 1 Discussion Questions, task 4: A person can be a product", canonical_key:"ch_1_discussion_questions_task_4_a_person_can_be", status:"approved"}}, {concept_id:"d7471fcc-e7fe-5aa4-9a79-656094b2f6d0", kc_id:"d7471fcc-e7fe-5aa4-9a79-656094b2f6d0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Applied Marketing Knowledge: Discussion Questions, task 5. Learner task: According to the US Centers for Disease Control and Prevention, the birthrate is falling in communities around the world. In the United States, the birthrate fell by 4 percent in 2020, an all-time low. Describe why dwindling population is a demographic concern in the macroenvironment all businesses must contend with.", label:"Ch. 1 Discussion Questions, task 5: According to the US Centers for Disease Control and Prevention, the birthrate is…", canonical_key:"ch_1_discussion_questions_task_5_according_to_th", status:"approved"}}, {concept_id:"53340110-19d0-55a9-a586-491ea5a5b3a2", kc_id:"53340110-19d0-55a9-a586-491ea5a5b3a2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Critical Thinking Exercises, task 1. Learner task: Your roommate in the dorm talks on his cell phone incessantly while you’re trying to study. Since you’re a broke college student and it’s too cold to walk to the library, you decide to explore the marketplace for used noise-canceling headphones. How will you locate the best, most-affordable market offering to meet your needs? Describe how marketing messages may guide your steps in this process.", label:"Ch. 1 Critical Thinking Exercises, task 1: Your roommate in the dorm talks on his cell phone incessantly while you’re trying to…", canonical_key:"ch_1_critical_thinking_exercises_task_1_your_roo", status:"approved"}}, {concept_id:"d0e427ae-7f2d-5548-a8a8-c2cb9d12bc28", kc_id:"d0e427ae-7f2d-5548-a8a8-c2cb9d12bc28", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Critical Thinking Exercises, task 2. Learner task: All consumers have needs and wants. You likely felt a state of deprivation this morning—hunger—and decided what you wanted to eat for breakfast. Do a bit of research to discover how your breakfast preference (want) compares to what a college student living in Osaka, Japan, might want to satisfy their need for sustenance.", label:"Ch. 1 Critical Thinking Exercises, task 2: All consumers have needs and wants", canonical_key:"ch_1_critical_thinking_exercises_task_2_all_cons", status:"approved"}}, {concept_id:"277ba594-1b0c-578a-ad28-47b94c3446ff", kc_id:"277ba594-1b0c-578a-ad28-47b94c3446ff", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Critical Thinking Exercises, task 3. Learner task: Because relationships are so important in marketing, multiple tools have been developed to help manage customer relationships. Many technological advances assist marketers in their efforts. Promotional strategies include utilizing social media posts, websites, advertising, public relations, and sponsorships to communicate with the target audience. One of the most effective tools in planning/calendaring these promotional contacts or touch points is a Gantt chart. Do a bit of research on Gantt charts so you better understand this scheduling tool that also visually illustrates linkages between promotional activities and progress toward a marketing goal. List and discuss five benefits of using this CRM planning tool. Finally, in your research, did you…", label:"Ch. 1 Critical Thinking Exercises, task 3: Because relationships are so important in marketing, multiple tools have been…", canonical_key:"ch_1_critical_thinking_exercises_task_3_because_", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"a85ceea0-cebd-5683-bb6d-e8d7403c1fcc", kc_id:"a85ceea0-cebd-5683-bb6d-e8d7403c1fcc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Critical Thinking Exercises, task 4. Learner task: In 2016, Amazon announced it was building its own logistics and shipping business in an effort to put the brakes on rising delivery costs. The overall goal was to deliver Amazon packages as well other packages from retailers and consumers in order to cut delivery costs in half. By 2021, Amazon was shipping 72 percent of its own packages as well as packages for Walmart and eBay. Read more about the effort (https://openstax.org/r/amazondeliveryfedex). With this new shipping venture in mind, answer the following questions: a. How is Amazon’s decision to enter the logistics and shipping industry a move toward improving customer loyalty and equity? b. How will Amazon’s new delivery service benefit Amazon? c. How do you predict Amazon’s rivals in this…", label:"Ch. 1 Critical Thinking Exercises, task 4: In 2016, Amazon announced it was building its own logistics and shipping business in…", canonical_key:"ch_1_critical_thinking_exercises_task_4_in_2016_", status:"approved"}}, {concept_id:"d8cc3788-f6c5-50ed-83a7-0fda54416a11", kc_id:"d8cc3788-f6c5-50ed-83a7-0fda54416a11", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Critical Thinking Exercises, task 5. Learner task: Is it OK for companies to profile customers and predict their purchase behavior? Every time you, as a consumer, visit a website, your “cookies” are gathered and used to better understand your shopping behavior. Several years ago, Target’s analysts developed an algorithm based upon Target customer buying behavior that predicted pregnancy. Those predicted to be pregnant—based upon the products they bought—were sent targeted marketing materials. The angry father of a high school student accused Target of erroneously sending his daughter a sales flyer for baby products. Supposedly, the daughter was pregnant. Read more about the incident (https://openstax.org/r/researchcompanyblog). How do you feel about companies gathering intimate details about you…", label:"Ch. 1 Critical Thinking Exercises, task 5: Is it OK for companies to profile customers and predict their purchase behavior", canonical_key:"ch_1_critical_thinking_exercises_task_5_is_it_ok", status:"approved"}}, {concept_id:"e5199156-e3a7-52fe-88a1-2d91e2e7fca5", kc_id:"e5199156-e3a7-52fe-88a1-2d91e2e7fca5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Building Your Personal Brand, task 1. Case context: Taking college courses is a huge step forward in your professional development. But there are additional activities that can also impact your self-awareness and provide credentials sought by employers. Campus career center directors, employers, and internship coordinators repeatedly stress the following suggestions…. Learner task: Take free online courses through LinkedIn, Coursera, Google, or Microsoft. Completion of courses offers evidence of skill development. For instance, Google Analytics for Beginners, Advanced Google Analytics, and Fundamentals of Digital Marketing are all available for free since they boost online education linked to Google’s technology products. Some courses even offer badges you can add to your LinkedIn profile, resume, and cover letters. You can find more information about these programs by reading these two articles from The Report, a source for trends on online education: [2022] 800+ Hours of Free LinkedIn Learning Courses with Free Certification (https://openstax.org/r/linkedinlearningfree) and [2022] 600+ Google Free Certificates and Badges…", label:"Ch. 1 Building Your Personal Brand, task 1: Take free online courses through LinkedIn, Coursera, Google, or Microsoft", canonical_key:"ch_1_building_your_personal_brand_task_1_take_fr", status:"approved"}}, {concept_id:"33034f2c-964c-5fca-a930-00f0f6caf744", kc_id:"33034f2c-964c-5fca-a930-00f0f6caf744", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Building Your Personal Brand, task 2. Case context: Taking college courses is a huge step forward in your professional development. But there are additional activities that can also impact your self-awareness and provide credentials sought by employers. Campus career center directors, employers, and internship coordinators repeatedly stress the following suggestions…. Learner task: Join campus clubs and organizations where you can be part of a giving-back project, hone your project- management skills, or simply gain leadership experience. Employers value your initiative.", label:"Ch. 1 Building Your Personal Brand, task 2: Join campus clubs and organizations where you can be part of a giving-back project,…", canonical_key:"ch_1_building_your_personal_brand_task_2_join_ca", status:"approved"}}, {concept_id:"d9a651b1-2896-5f51-b2e5-24e018e13a21", kc_id:"d9a651b1-2896-5f51-b2e5-24e018e13a21", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Building Your Personal Brand, task 3. Case context: Taking college courses is a huge step forward in your professional development. But there are additional activities that can also impact your self-awareness and provide credentials sought by employers. Campus career center directors, employers, and internship coordinators repeatedly stress the following suggestions…. Learner task: Keep up with current events—read newspapers, blogs, and other news sources that are pertinent to your field—because you’ll need to carry on a conversation and because what we do requires a good sense of what’s going on in the world.", label:"Ch. 1 Building Your Personal Brand, task 3: Keep up with current events—read newspapers, blogs, and other news sources that are…", canonical_key:"ch_1_building_your_personal_brand_task_3_keep_up", status:"approved"}}, {concept_id:"456fb84c-1224-542b-881a-6f9c475c3193", kc_id:"456fb84c-1224-542b-881a-6f9c475c3193", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Building Your Personal Brand, task 4. Case context: Taking college courses is a huge step forward in your professional development. But there are additional activities that can also impact your self-awareness and provide credentials sought by employers. Campus career center directors, employers, and internship coordinators repeatedly stress the following suggestions…. Learner task: Take advantage of campus services. Does your career center offer mock interviews? Will the staff help you develop a resume or edit one you’ve already written? Some colleges even offer short courses on etiquette.", label:"Ch. 1 Building Your Personal Brand, task 4: Take advantage of campus services", canonical_key:"ch_1_building_your_personal_brand_task_4_take_ad", status:"approved"}}, {concept_id:"d0790571-15ba-51b0-b2cb-e680ec34803a", kc_id:"d0790571-15ba-51b0-b2cb-e680ec34803a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Building Your Personal Brand, task 5. Case context: Taking college courses is a huge step forward in your professional development. But there are additional activities that can also impact your self-awareness and provide credentials sought by employers. Campus career center directors, employers, and internship coordinators repeatedly stress the following suggestions…. Learner task: Put together a list of possible references. Was your work in a particular course memorable? If so, ask your professor if they would refer you. Does your list of summer jobs indicate increasing responsibility or use of your education? Be certain that all of your references are on board; they must agree to give you an excellent reference and then should be kept in the loop about jobs you’ve applied for or, better yet, been offered.", label:"Ch. 1 Building Your Personal Brand, task 5: Put together a list of possible references", canonical_key:"ch_1_building_your_personal_brand_task_5_put_tog", status:"approved"}}, {concept_id:"214b9fb4-e1a0-58de-99fc-4c5d1b9c7f00", kc_id:"214b9fb4-e1a0-58de-99fc-4c5d1b9c7f00", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Building Your Personal Brand, task 6. Case context: Taking college courses is a huge step forward in your professional development. But there are additional activities that can also impact your self-awareness and provide credentials sought by employers. Campus career center directors, employers, and internship coordinators repeatedly stress the following suggestions…. Learner task: Obtain a certification from HubSpot Academy, a well-known marketing website. Learn about the various certifications it offers by checking out its website (https://openstax.org/r/certificationoverview).", label:"Ch. 1 Building Your Personal Brand, task 6: Obtain a certification from HubSpot Academy, a well-known marketing website", canonical_key:"ch_1_building_your_personal_brand_task_6_obtain_", status:"approved"}}, {concept_id:"906ee511-5774-51de-9d5c-8bde7835bb26", kc_id:"906ee511-5774-51de-9d5c-8bde7835bb26", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, What Do Marketers Do?, task 1. Learner task: The American Marketing Association (AMA) has teamed up with the Digital Marketing Institute to offer specialized training within the marketing discipline. You can set yourself apart from other marketers with additional certifications. Are there other benefits you can take advantage of? Take a look at one of the 65 chapters located across the country. Is there one located in your city? Not only is membership a great way to volunteer, it’s also an effective way to market yourself to potential employers. For instance, the Minnesota Marketing Association (https://openstax.org/r/amaminnesota) welcomes students and professionals who are willing to help plan programs and organize mentorship programs. You can reach out to your state’s AMA executive…", label:"Ch. 1 What Do Marketers Do?, task 1: The American Marketing Association (AMA) has teamed up with the Digital Marketing…", canonical_key:"ch_1_what_do_marketers_do_task_1_the_american_ma", status:"approved"}}, {concept_id:"dab52b87-47a1-5f52-bce6-87fe1337a75d", kc_id:"dab52b87-47a1-5f52-bce6-87fe1337a75d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Marketing Plan Exercise, task 1. Case context: MARKETING PLAN PROJECT—PART I During this course, you will develop a marketing plan as part of a semester-long project. The marketing plan that you develop will build throughout the course over nine chapters of this textbook. The purpose of Part I of this marketing plan project is twofold: • To become familiar with…. Learner task: Download the Marketing Plan Template (https://openstax.org/r/marketingplantemp) and SAVE THIS DOCUMENT where you can easily access it again, because you will be completing additional sections of the plan throughout the course.", label:"Ch. 1 Marketing Plan Exercise, task 1: Download the Marketing Plan Template (https://openstax.org/r/marketingplantemp) and…", canonical_key:"ch_1_marketing_plan_exercise_task_1_download_the", status:"approved"}}, {concept_id:"99888631-9c8c-5a1b-a9b1-b5e81d36f9a7", kc_id:"99888631-9c8c-5a1b-a9b1-b5e81d36f9a7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Marketing Plan Exercise, task 2. Case context: MARKETING PLAN PROJECT—PART I During this course, you will develop a marketing plan as part of a semester-long project. The marketing plan that you develop will build throughout the course over nine chapters of this textbook. The purpose of Part I of this marketing plan project is twofold: • To become familiar with…. Learner task: Select a company or product which will form the basis of your marketing plan. When selecting a company, please be sure to select a company or product that will (a) be of interest to you throughout the course and (b) have sufficient information available about the company on the internet for you to conduct research and make informed decisions in your marketing plan.", label:"Ch. 1 Marketing Plan Exercise, task 2: Select a company or product which will form the basis of your marketing plan", canonical_key:"ch_1_marketing_plan_exercise_task_2_select_a_com", status:"approved"}}, {concept_id:"c9367805-3e6e-5e71-92fb-e4584e0a41be", kc_id:"c9367805-3e6e-5e71-92fb-e4584e0a41be", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Marketing Plan Exercise, task 3. Case context: MARKETING PLAN PROJECT—PART I During this course, you will develop a marketing plan as part of a semester-long project. The marketing plan that you develop will build throughout the course over nine chapters of this textbook. The purpose of Part I of this marketing plan project is twofold: • To become familiar with…. Learner task: When selecting a company, please be sure NOT to choose a company that is so huge that it serves many diverse markets. For example, General Electric produces electrical and electronic equipment, aircraft engines, medical electronics; it also provides financial services and more. Procter & Gamble also has diverse product lines, including beauty, grooming, health care, fabric and home care, and feminine and family care. In the “real world,” you would not prepare a single marketing plan for the entire company; instead, each division and/or product line would develop its own marketing plan. Therefore, if you want to use a large company, select a brand or product line for the purpose of your marketing plan.", label:"Ch. 1 Marketing Plan Exercise, task 3: When selecting a company, please be sure NOT to choose a company that is so huge that…", canonical_key:"ch_1_marketing_plan_exercise_task_3_when_selecti", status:"approved"}}, {concept_id:"a20dba70-39aa-5872-a164-fb21b4493bc5", kc_id:"a20dba70-39aa-5872-a164-fb21b4493bc5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Marketing Plan Exercise, task 4. Case context: MARKETING PLAN PROJECT—PART I During this course, you will develop a marketing plan as part of a semester-long project. The marketing plan that you develop will build throughout the course over nine chapters of this textbook. The purpose of Part I of this marketing plan project is twofold: • To become familiar with…. Learner task: On the Marketing Plan Template, add your name and course number to the header.", label:"Ch. 1 Marketing Plan Exercise, task 4: On the Marketing Plan Template, add your name and course number to the header.", canonical_key:"ch_1_marketing_plan_exercise_task_4_on_the_marke", status:"approved"}}, {concept_id:"a82382a3-8a88-55e0-8258-5d21e1df8b87", kc_id:"a82382a3-8a88-55e0-8258-5d21e1df8b87", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Marketing Plan Exercise, task 5. Case context: MARKETING PLAN PROJECT—PART I During this course, you will develop a marketing plan as part of a semester-long project. The marketing plan that you develop will build throughout the course over nine chapters of this textbook. The purpose of Part I of this marketing plan project is twofold: • To become familiar with…. Learner task: Complete the Company Profile Information on the Marketing Plan Template for the company you have selected.", label:"Ch. 1 Marketing Plan Exercise, task 5: Complete the Company Profile Information on the Marketing Plan Template for the…", canonical_key:"ch_1_marketing_plan_exercise_task_5_complete_the", status:"approved"}}, {concept_id:"e9a25eb6-f341-5eb1-b6d7-2d80704c7d8d", kc_id:"e9a25eb6-f341-5eb1-b6d7-2d80704c7d8d", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Marketing Plan Exercise, task 6. Case context: MARKETING PLAN PROJECT—PART I During this course, you will develop a marketing plan as part of a semester-long project. The marketing plan that you develop will build throughout the course over nine chapters of this textbook. The purpose of Part I of this marketing plan project is twofold: • To become familiar with…. Learner task: Save the template with a new name using this naming convention: Course_First/LastName/Project Title. Example, MKTG101_JohnSmith_Marketing Plan.", label:"Ch. 1 Marketing Plan Exercise, task 6: Save the template with a new name using this naming convention:…", canonical_key:"ch_1_marketing_plan_exercise_task_6_save_the_tem", status:"approved"}}, {concept_id:"c6cdb2f5-48ef-5be8-beeb-9e24279f300f", kc_id:"c6cdb2f5-48ef-5be8-beeb-9e24279f300f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Marketing Plan Exercise, task 7. Case context: MARKETING PLAN PROJECT—PART I During this course, you will develop a marketing plan as part of a semester-long project. The marketing plan that you develop will build throughout the course over nine chapters of this textbook. The purpose of Part I of this marketing plan project is twofold: • To become familiar with…. Learner task: Submit this document to your instructor as directed.", label:"Ch. 1 Marketing Plan Exercise, task 7: Submit this document to your instructor as directed.", canonical_key:"ch_1_marketing_plan_exercise_task_7_submit_this_", status:"approved"}}, {concept_id:"2cc284db-6a2b-5b53-bb62-c2737d42e4ac", kc_id:"2cc284db-6a2b-5b53-bb62-c2737d42e4ac", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Closing Company Case, task 1. Case context: Batdorf & Bronson Coffee is a global drink loved by so many. From the simple espresso in Italy to the cinnamon added in Mexico, coffee is a global beverage. The origins of coffee date back to the ninth century. Legend has it that in a remote part of Ethiopia, a goat herder noticed his goats dancing about and full of…. Learner task: Batdorf & Bronson is a coffee roasting facility. Dancing Goats Coffee Bars are retail stores. How does the ownership of a retail store help the supplier (Batdorf & Bronson) understand its customer?", label:"Ch. 1 Closing Company Case, task 1: Batdorf & Bronson is a coffee roasting facility", canonical_key:"ch_1_closing_company_case_task_1_batdorf_bronson", status:"approved"}}, {concept_id:"d7e8cf10-091c-5e77-9b48-0a439eea5c30", kc_id:"d7e8cf10-091c-5e77-9b48-0a439eea5c30", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Closing Company Case, task 2. Case context: Batdorf & Bronson Coffee is a global drink loved by so many. From the simple espresso in Italy to the cinnamon added in Mexico, coffee is a global beverage. The origins of coffee date back to the ninth century. Legend has it that in a remote part of Ethiopia, a goat herder noticed his goats dancing about and full of…. Learner task: Batdorf & Bronson has direct relationships with the family farms that grow the beans it buys, roasts, and distributes nationwide. How does this relationship with the coffee growers benefit its retail partners?", label:"Ch. 1 Closing Company Case, task 2: Batdorf & Bronson has direct relationships with the family farms that grow the beans…", canonical_key:"ch_1_closing_company_case_task_2_batdorf_bronson", status:"approved"}}, {concept_id:"45954caa-fbe1-5100-97c1-59ee74c8f5d2", kc_id:"45954caa-fbe1-5100-97c1-59ee74c8f5d2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Closing Company Case, task 3. Case context: Batdorf & Bronson Coffee is a global drink loved by so many. From the simple espresso in Italy to the cinnamon added in Mexico, coffee is a global beverage. The origins of coffee date back to the ninth century. Legend has it that in a remote part of Ethiopia, a goat herder noticed his goats dancing about and full of…. Learner task: When Batdorf & Bronson provides a master barista to help train and educate retail partners, what is the value proposition it provides to the coffee bars that buy beans from it?", label:"Ch. 1 Closing Company Case, task 3: When Batdorf & Bronson provides a master barista to help train and educate retail…", canonical_key:"ch_1_closing_company_case_task_3_when_batdorf_br", status:"approved"}}, {concept_id:"7b4c7e35-9628-50bf-8b25-695c87da6a7c", kc_id:"7b4c7e35-9628-50bf-8b25-695c87da6a7c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 1, Closing Company Case, task 4. Case context: Batdorf & Bronson Coffee is a global drink loved by so many. From the simple espresso in Italy to the cinnamon added in Mexico, coffee is a global beverage. The origins of coffee date back to the ninth century. Legend has it that in a remote part of Ethiopia, a goat herder noticed his goats dancing about and full of…. Learner task: How is Batdorf & Bronson fulfilling the marketing concept?", label:"Ch. 1 Closing Company Case, task 4: How is Batdorf & Bronson fulfilling the marketing concept", canonical_key:"ch_1_closing_company_case_task_4_how_is_batdorf_", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"e78d2b4f-c92c-5257-9414-a7cf3d99b78f", kc_id:"e78d2b4f-c92c-5257-9414-a7cf3d99b78f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Applied Marketing Knowledge: Discussion Questions, task 1. Learner task: Your university annually evaluates the current and possible value of its strategic business units (SBUs). The university may examine its majors as SBUs, or it may examine each college, school, or division’s performance while recruiting students. Use a Boston Consulting Group (BCG) matrix to examine the university’s business portfolio—majors may be stars, cash cows, question marks, or dogs due to past and current enrollment in those majors. (Chances are good that underperforming “dog” majors will be phased out and financial support shifted from majors that serve as cash cows to fund growth of stars or question marks.) List two majors that fit into each of the growth-share matrix quadrants.", label:"Ch. 2 Discussion Questions, task 1: Your university annually evaluates the current and possible value of its strategic…", canonical_key:"ch_2_discussion_questions_task_1_your_university", status:"approved"}}, {concept_id:"bc17c34f-4310-5917-976c-e40d6679c32c", kc_id:"bc17c34f-4310-5917-976c-e40d6679c32c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Applied Marketing Knowledge: Discussion Questions, task 2. Learner task: Why is perceived value important in price setting?", label:"Ch. 2 Discussion Questions, task 2: Why is perceived value important in price setting", canonical_key:"ch_2_discussion_questions_task_2_why_is_perceive", status:"approved"}}, {concept_id:"182cf7a8-1490-5448-b43f-cca8999cc43c", kc_id:"182cf7a8-1490-5448-b43f-cca8999cc43c", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Applied Marketing Knowledge: Discussion Questions, task 3. Learner task: Personas are especially helpful as marketers consider the ________ for their products and are most commonly used when developing promotional materials.", label:"Ch. 2 Discussion Questions, task 3: Personas are especially helpful as marketers consider the ________ for their products…", canonical_key:"ch_2_discussion_questions_task_3_personas_are_es", status:"approved"}}, {concept_id:"8bce25b4-8298-5408-83e4-3cb699b80547", kc_id:"8bce25b4-8298-5408-83e4-3cb699b80547", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Applied Marketing Knowledge: Discussion Questions, task 4. Learner task: What are SMART goals, and why are they important in strategic planning?", label:"Ch. 2 Discussion Questions, task 4: What are SMART goals, and why are they important in strategic planning", canonical_key:"ch_2_discussion_questions_task_4_what_are_smart_", status:"approved"}}, {concept_id:"c1744347-8886-5cee-b6e1-4e37ec7a4e7b", kc_id:"c1744347-8886-5cee-b6e1-4e37ec7a4e7b", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Critical Thinking Exercises, task 1. Learner task: Like Clorox and Zoom, Peloton was poised to the seize market opportunities created by the COVID-19 pandemic and stay-home mandates ordered by cities and states. Research Peloton and construct a timeline of key Peloton events from 2020 through 2022. What key strategic decisions did Peloton make in the exercise-at-home market? (Be sure to include Peloton’s summer 2021 decision to lower the price of its original bike by 20 percent.) What opportunities and challenges did Peloton face during the pandemic? How did consumer behavior change during the first year of COVID-19? How well did Peloton predict consumer demand for its exercise products? Now that you’ve seen the challenges a growth strategy presents, what do you see as the long-term business growth…", label:"Ch. 2 Critical Thinking Exercises, task 1: Like Clorox and Zoom, Peloton was poised to the seize market opportunities created by…", canonical_key:"ch_2_critical_thinking_exercises_task_1_like_clo", status:"approved"}}, {concept_id:"dccc80b2-81cc-5600-9f6a-4e5b24eb94d1", kc_id:"dccc80b2-81cc-5600-9f6a-4e5b24eb94d1", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Critical Thinking Exercises, task 2. Learner task: Go to Clorox’s website and review the company’s primary products (https://openstax.org/r/clorox). Complete a SWOT matrix for Clorox that lists at least three strengths, weaknesses, opportunities, and threats. The first level in the SWOT has been provided for you below.", label:"Ch. 2 Critical Thinking Exercises, task 2: Go to Clorox’s website and review the company’s primary products…", canonical_key:"ch_2_critical_thinking_exercises_task_2_go_to_cl", status:"approved"}}, {concept_id:"0f161899-3449-54ec-8e22-4c6e8bdcd4a3", kc_id:"0f161899-3449-54ec-8e22-4c6e8bdcd4a3", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Critical Thinking Exercises, task 3. Learner task: Disney is an example of a diversified company. Its success is based upon founder Walt Disney’s artistic abilities and years of successful strategic planning. Answer the following questions: A. Why has it been important for Disney to identify new products and markets? B. How has Disney leveraged its strengths to pursue new opportunities? C. In addition to parks and resorts, list three products/services Disney has expanded into. D. In your opinion, is Disney an example of an ethical company that practices a double bottom line?", label:"Ch. 2 Critical Thinking Exercises, task 3: Disney is an example of a diversified company", canonical_key:"ch_2_critical_thinking_exercises_task_3_disney_i", status:"approved"}}, {concept_id:"47d73c5f-0f7d-5346-9c1a-3c47b39b753a", kc_id:"47d73c5f-0f7d-5346-9c1a-3c47b39b753a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Building Your Personal Brand, task 1. Learner task: There are many brands that recognize the benefits of hiring brand ambassadors. Red Bull is one of these brands. Because college students constitute a major portion of its target market, Red Bull relies on student ambassadors (also called Marketeers) to interact with customers. According to Red Bull’s Student Marketeer website, “student Marketeers are in direct contact with various consumers and customers, inviting product trial, helping establish Red Bull consumption in diverse occasions, supporting our sales teams, working with renowned athletes and of course ensuring an unforgettable brand experience for consumers at Red Bull events. Based on your skills, knowledge, experience and availability, your focus will be either on your campus or you’ll…", label:"Ch. 2 Building Your Personal Brand, task 1: There are many brands that recognize the benefits of hiring brand ambassadors", canonical_key:"ch_2_building_your_personal_brand_task_1_there_a", status:"approved"}}, {concept_id:"ba65cf40-81e6-5af0-9433-d6ee2c4b34b4", kc_id:"ba65cf40-81e6-5af0-9433-d6ee2c4b34b4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, What Do Marketers Do?, task 1. Learner task: Consider the city where you live. Why do you live there? Why have businesses chosen to locate there? Call your Chamber of Commerce and ask to speak to the chamber director or marketing director. Ask the following questions: • Have you used strategic planning to explore growth opportunities? • What are the strengths of our city that you express to Chamber members or businesses considering relocating here? • Have there been any changes in politics, culture, ecology, or technology that offer opportunities to attract businesses to this community? • Are there weaknesses or threats that our city must overcome to improve its growth and viability? • How do college students contribute to the strengths of our city or overcome workforce threats?", label:"Ch. 2 What Do Marketers Do?, task 1: Consider the city where you live", canonical_key:"ch_2_what_do_marketers_do_task_1_consider_the_ci", status:"approved"}}, {concept_id:"9354f5c3-e512-5cde-8d1a-cc3251006450", kc_id:"9354f5c3-e512-5cde-8d1a-cc3251006450", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Marketing Plan Exercise, task 1. Learner task: Complete the following information about the company and products/services you chose to focus on as you develop the marketing plan throughout the course. You may need to conduct research in order to obtain necessary information. Instructions: Using the Marketing Plan Template file you created from the Marketing and Customer Value assignment, complete the following sections of your marketing plan: • Executive Summary • Mission Statement • SWOT Analysis • Marketing Goals and Objectives Submit the marketing plan to your instructor for grading and feedback.", label:"Ch. 2 Marketing Plan Exercise, task 1: Complete the following information about the company and products/services you chose…", canonical_key:"ch_2_marketing_plan_exercise_task_1_complete_the", status:"approved"}}, {concept_id:"9ce69c03-7b37-5475-8453-87bf8e3da4e7", kc_id:"9ce69c03-7b37-5475-8453-87bf8e3da4e7", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Closing Company Case, task 1. Case context: Blue Zones When adventurer Dan Buettner set off around the world, riding his bike and visiting far-off destinations, he put a way of living into motion. Through the study of various communities around the world, Dan discovered pockets where populations of older people seemed to be living longer than anywhere else on…. Learner task: What is the mission and purpose of Blue Zones?", label:"Ch. 2 Closing Company Case, task 1: What is the mission and purpose of Blue Zones", canonical_key:"ch_2_closing_company_case_task_1_what_is_the_mis", status:"approved"}}, {concept_id:"b8039157-5ce2-5574-b255-36d30cbfa7f8", kc_id:"b8039157-5ce2-5574-b255-36d30cbfa7f8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Closing Company Case, task 2. Case context: Blue Zones When adventurer Dan Buettner set off around the world, riding his bike and visiting far-off destinations, he put a way of living into motion. Through the study of various communities around the world, Dan discovered pockets where populations of older people seemed to be living longer than anywhere else on…. Learner task: Marketers use strategies such as market penetration, market development, product development, and diversification. What is the optimal strategy for Blue Zones to pursue as it seeks to gain a foothold in the United States?", label:"Ch. 2 Closing Company Case, task 2: Marketers use strategies such as market penetration, market development, product…", canonical_key:"ch_2_closing_company_case_task_2_marketers_use_s", status:"approved"}}, {concept_id:"a230f218-3c55-52d6-8678-a933dde135d8", kc_id:"a230f218-3c55-52d6-8678-a933dde135d8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Closing Company Case, task 3. Case context: Blue Zones When adventurer Dan Buettner set off around the world, riding his bike and visiting far-off destinations, he put a way of living into motion. Through the study of various communities around the world, Dan discovered pockets where populations of older people seemed to be living longer than anywhere else on…. Learner task: What is the market segmentation and target market for Blue Zones?", label:"Ch. 2 Closing Company Case, task 3: What is the market segmentation and target market for Blue Zones", canonical_key:"ch_2_closing_company_case_task_3_what_is_the_mar", status:"approved"}}, {concept_id:"1c04f7a1-6fbc-5084-8f42-4a0587d47f55", kc_id:"1c04f7a1-6fbc-5084-8f42-4a0587d47f55", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 2, Closing Company Case, task 4. Case context: Blue Zones When adventurer Dan Buettner set off around the world, riding his bike and visiting far-off destinations, he put a way of living into motion. Through the study of various communities around the world, Dan discovered pockets where populations of older people seemed to be living longer than anywhere else on…. Learner task: Blue Zones works to create healthier communities. With this goal in mind, what are some of the KPIs Blue Zones might work to implement?", label:"Ch. 2 Closing Company Case, task 4: Blue Zones works to create healthier communities", canonical_key:"ch_2_closing_company_case_task_4_blue_zones_work", status:"approved"}}, {concept_id:"327f913f-5cb1-5b9d-b17c-49272f2b5696", kc_id:"327f913f-5cb1-5b9d-b17c-49272f2b5696", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Applied Marketing Knowledge: Discussion Questions, task 1. Learner task: What sort of purchasing behavior do you, as a student, exhibit? Do you stop by a convenience store and buy a soda on the way to class? This is convenience shopping behavior, and the business is located, conveniently, in your daily pathway. Do you sometimes buy a different beverage, perhaps an energy drink or a bottled iced tea? You’re exhibiting variety-seeking behavior. When the time came for you to choose your college, what sort of shopping behavior did you engage in?", label:"Ch. 3 Discussion Questions, task 1: What sort of purchasing behavior do you, as a student, exhibit", canonical_key:"ch_3_discussion_questions_task_1_what_sort_of_pu", status:"approved"}}, {concept_id:"4a859c5f-0659-5f9c-82db-681a44067cf5", kc_id:"4a859c5f-0659-5f9c-82db-681a44067cf5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Applied Marketing Knowledge: Discussion Questions, task 2. Learner task: You belong to many membership groups. You might be a member of the college soccer team or sing in a choir. Right now, you likely aspire to join the group of college graduates. Why is it so important for marketers to know which groups consumers have joined or refer to when making purchases?", label:"Ch. 3 Discussion Questions, task 2: You belong to many membership groups", canonical_key:"ch_3_discussion_questions_task_2_you_belong_to_m", status:"approved"}}, {concept_id:"12eae4df-4149-554a-9b19-a3db0ed989d4", kc_id:"12eae4df-4149-554a-9b19-a3db0ed989d4", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Applied Marketing Knowledge: Discussion Questions, task 3. Learner task: Businesses send you thousands of marketing messages each day through the radio, TV, Internet, billboards, and bus benches. You sort through these messages, perhaps unconsciously, and decide which ones to pay attention to. This is called selective attention. Which messages are most influential right now in your life as a student? Messages regarding your social life? Personal life? Psychological factors relating to your motivation to try a new product? Cultural factors such as gender-related products? A situational factor such as a flat tire? Where would you find an example of each message?", label:"Ch. 3 Discussion Questions, task 3: Businesses send you thousands of marketing messages each day through the radio, TV,…", canonical_key:"ch_3_discussion_questions_task_3_businesses_send", status:"approved"}}, {concept_id:"3d7ec8d2-50f9-5e58-8aff-b510ac3b7d52", kc_id:"3d7ec8d2-50f9-5e58-8aff-b510ac3b7d52", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Applied Marketing Knowledge: Discussion Questions, task 4. Learner task: Provide a recent example of a purchase you made and describe your progress through the stages of the consumer decision process model.", label:"Ch. 3 Discussion Questions, task 4: Provide a recent example of a purchase you made and describe your progress through the…", canonical_key:"ch_3_discussion_questions_task_4_provide_a_recen", status:"approved"}}, {concept_id:"3289823c-d30c-5e55-80bb-19380da5dc1f", kc_id:"3289823c-d30c-5e55-80bb-19380da5dc1f", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Applied Marketing Knowledge: Discussion Questions, task 5. Learner task: You just locked your door and are heading out to get a haircut. How do these two needs—safety through the locked door and esteem through the haircut—fit with Maslow’s hierarchy of needs? Why is this hierarchy helpful for marketers in understanding human needs and resulting buying behavior?", label:"Ch. 3 Discussion Questions, task 5: You just locked your door and are heading out to get a haircut", canonical_key:"ch_3_discussion_questions_task_5_you_just_locked", status:"approved"}}, {concept_id:"30ca6ce1-37f1-5d34-ba55-d679ac5b6560", kc_id:"30ca6ce1-37f1-5d34-ba55-d679ac5b6560", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Critical Thinking Exercises, task 1. Learner task: Research has shown that consumers’ buying behavior changes over time, reflecting their age or stage of the family life cycle. Visit Salesfloor.com and read the summaries (https://openstax.org/r/shoppinghabits) this site offers on age-based shopping habits. Do you agree with research findings that despite being bombarded with digital content, Zoomers still prefer to stop in store? Do you research products thoroughly through search engines, reviews, and social media before purchasing? Explain why you agree or disagree with this study’s conclusions about generational buying behavior.", label:"Ch. 3 Critical Thinking Exercises, task 1: Research has shown that consumers’ buying behavior changes over time, reflecting their…", canonical_key:"ch_3_critical_thinking_exercises_task_1_research", status:"approved"}}] AS row
CREATE (n:Concept{concept_id: row.concept_id, kc_id: row.kc_id}) SET n += row.properties SET n:KnowledgeComponent;
UNWIND [{concept_id:"eefe8992-b6b3-5b2b-8529-15744e87ddcb", kc_id:"eefe8992-b6b3-5b2b-8529-15744e87ddcb", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Critical Thinking Exercises, task 2. Learner task: One way consumers evaluate alternatives is by identifying the “bundle of attributes” of a product or service. Assume that you’re in the market for a new smartphone. What would that bundle of attributes look like? In other words, what attributes do you consider important, and how would you rank the importance of these features on a scale of 1 to 5, with 5 being the attribute of greatest importance and 1 being the attribute of lowest importance? Some attributes are already listed, but you can add your own attributes as well. Complete Table 3.2 with your rankings. Attributes Importance of Considered Attribute Storage Battery Life Processing Price Ease of Use Durability Camera Quality Table 3.2 The Bundle of Attributes", label:"Ch. 3 Critical Thinking Exercises, task 2: One way consumers evaluate alternatives is by identifying the “bundle of attributes”…", canonical_key:"ch_3_critical_thinking_exercises_task_2_one_way_", status:"approved"}}, {concept_id:"a5b63169-ec46-5977-939b-7eda65894a35", kc_id:"a5b63169-ec46-5977-939b-7eda65894a35", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Critical Thinking Exercises, task 3. Learner task: Delve into McDonald’s, a company mentioned at the beginning of this chapter. Does McDonald’s have an environmental sustainability statement? If so, list evidence showing how McDonald’s carries out this policy.", label:"Ch. 3 Critical Thinking Exercises, task 3: Delve into McDonald’s, a company mentioned at the beginning of this chapter", canonical_key:"ch_3_critical_thinking_exercises_task_3_delve_in", status:"approved"}}, {concept_id:"1f13daf3-24fb-5cf9-85ff-a0c4624ba713", kc_id:"1f13daf3-24fb-5cf9-85ff-a0c4624ba713", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Building Your Personal Brand, task 1. Learner task: Knowing yourself well is essential to helping you identify your personal brand. How would you characterize your personal brand right now? Is it what you want it to be? There are numerous free tools to help you gain self-awareness. The Careers in Marketing section earlier in this chapter lists numerous resources that you could try. Or you can try this short personality assessment (https://openstax.org/r/humanmetrics) that is similar to the Myers-Briggs Type Indicator. After you complete the assessment, your personality information will be revealed. You’ll learn if you’re extroverted or introverted, thinking or feeling, sensing or intuitive, and judging or perceiving. The results are shown as a four-letter acronym (for example, ENFP or ISTJ), and…", label:"Ch. 3 Building Your Personal Brand, task 1: Knowing yourself well is essential to helping you identify your personal brand", canonical_key:"ch_3_building_your_personal_brand_task_1_knowing", status:"approved"}}, {concept_id:"45164c57-f58c-5572-93f9-dea769281f47", kc_id:"45164c57-f58c-5572-93f9-dea769281f47", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, What Do Marketers Do?, task 1. Learner task: Have you ever wondered where analysts gather consumer behavior data and how they make sense of it? One way to find out is to ask someone who currently does this job. Using LinkedIn, conduct a search for data analysts in your geographic area and invite one or more to connect with you through the LinkedIn platform. Once connected, send a message to each one telling them who you are and that you’re a marketing student. Request a 15-minute phone conversation with them to ask them about their job. Come prepared to the phone conversation with a list of questions you want to ask. Be prepared to go off script and ask questions that come to mind on the spot. You can learn a lot about various marketing careers, and you can make great contacts by simply…", label:"Ch. 3 What Do Marketers Do?, task 1: Have you ever wondered where analysts gather consumer behavior data and how they make…", canonical_key:"ch_3_what_do_marketers_do_task_1_have_you_ever_w", status:"approved"}}, {concept_id:"daf2adb6-eb3b-581b-8217-fadaf7bcb783", kc_id:"daf2adb6-eb3b-581b-8217-fadaf7bcb783", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Closing Company Case, task 1. Case context: Wired Coffee Bar Figure 3.15 Recognizing an opportunity to open a coffee shop in a small community where none existed, Wired Coffee Bar was launched. (credit: reproduced with permission of Wired Coffee Bar) During high school and college, Lisa worked in an upscale retail boutique. On the mornings Lisa opened the…. Learner task: What type of consumer buying behavior are consumers exhibiting when they are buying coffee?", label:"Ch. 3 Closing Company Case, task 1: What type of consumer buying behavior are consumers exhibiting when they are buying…", canonical_key:"ch_3_closing_company_case_task_1_what_type_of_co", status:"approved"}}, {concept_id:"69cab706-3c22-5d62-af3c-030368de0ede", kc_id:"69cab706-3c22-5d62-af3c-030368de0ede", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Closing Company Case, task 2. Case context: Wired Coffee Bar Figure 3.15 Recognizing an opportunity to open a coffee shop in a small community where none existed, Wired Coffee Bar was launched. (credit: reproduced with permission of Wired Coffee Bar) During high school and college, Lisa worked in an upscale retail boutique. On the mornings Lisa opened the…. Learner task: Consumers are faced with many different influences when they are making purchasing decisions. What social influences have the greatest impact on the decision to purchase coffee from Wired Coffee Bar? What personal influences have the greatest impact?", label:"Ch. 3 Closing Company Case, task 2: Consumers are faced with many different influences when they are making purchasing…", canonical_key:"ch_3_closing_company_case_task_2_consumers_are_f", status:"approved"}}, {concept_id:"60b44470-8bef-5113-b2f3-6a8da1f63c84", kc_id:"60b44470-8bef-5113-b2f3-6a8da1f63c84", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Closing Company Case, task 3. Case context: Wired Coffee Bar Figure 3.15 Recognizing an opportunity to open a coffee shop in a small community where none existed, Wired Coffee Bar was launched. (credit: reproduced with permission of Wired Coffee Bar) During high school and college, Lisa worked in an upscale retail boutique. On the mornings Lisa opened the…. Learner task: What situational factors may influence consumers to purchase from Wired Coffee Bar versus Starbucks?", label:"Ch. 3 Closing Company Case, task 3: What situational factors may influence consumers to purchase from Wired Coffee Bar…", canonical_key:"ch_3_closing_company_case_task_3_what_situationa", status:"approved"}}, {concept_id:"4e1e6427-e587-5f04-938b-b5e9fbc4f10e", kc_id:"4e1e6427-e587-5f04-938b-b5e9fbc4f10e", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 3, Closing Company Case, task 4. Case context: Wired Coffee Bar Figure 3.15 Recognizing an opportunity to open a coffee shop in a small community where none existed, Wired Coffee Bar was launched. (credit: reproduced with permission of Wired Coffee Bar) During high school and college, Lisa worked in an upscale retail boutique. On the mornings Lisa opened the…. Learner task: How might Wired Coffee Bar further differentiate itself from other coffee bars as consumers search for alternatives in their buyer decision-making process?", label:"Ch. 3 Closing Company Case, task 4: How might Wired Coffee Bar further differentiate itself from other coffee bars as…", canonical_key:"ch_3_closing_company_case_task_4_how_might_wired", status:"approved"}}, {concept_id:"cd85973c-2fe4-5633-8954-206084222d10", kc_id:"cd85973c-2fe4-5633-8954-206084222d10", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Applied Marketing Knowledge: Discussion Questions, task 1. Learner task: Go to the Tesla corporate website (https://openstax.org/r/tesla). Which market(s)—consumer, business, institutional, resellers, producers/suppliers—does Tesla serve? Why did Tesla decide to serve these markets? When reading Tesla’s 2021 Impact Report (https://openstax.org/r/2021teslaimpactreport), what main goal does the company say it is “driven” by?", label:"Ch. 4 Discussion Questions, task 1: Go to the Tesla corporate website (https://openstax.org/r/tesla)", canonical_key:"ch_4_discussion_questions_task_1_go_to_the_tesla", status:"approved"}}, {concept_id:"446c9cfb-f099-53e7-9186-b9866edeacc0", kc_id:"446c9cfb-f099-53e7-9186-b9866edeacc0", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Applied Marketing Knowledge: Discussion Questions, task 2. Learner task: Manufacturers work with resellers primarily to move large amounts of inventory quickly, thus limiting stagnant inventory that can limit cash flow. Which two types of businesses historically have contributed to moving manufacturers’ products to end consumers?", label:"Ch. 4 Discussion Questions, task 2: Manufacturers work with resellers primarily to move large amounts of inventory…", canonical_key:"ch_4_discussion_questions_task_2_manufacturers_w", status:"approved"}}, {concept_id:"6faa9ffa-94a8-5547-b90a-2f3a5b6f32d8", kc_id:"6faa9ffa-94a8-5547-b90a-2f3a5b6f32d8", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Applied Marketing Knowledge: Discussion Questions, task 3. Learner task: Visit your college’s website, and look through academics, sports, organizations, and campus life. When looking at the photos, which items do you see depicted that are likely straight rebuys? Do you see sports uniforms, test tubes, musical instruments, computers, desks, library books? Which items are likely modified rebuys, new task situations, and systems selling?", label:"Ch. 4 Discussion Questions, task 3: Visit your college’s website, and look through academics, sports, organizations, and…", canonical_key:"ch_4_discussion_questions_task_3_visit_your_coll", status:"approved"}}, {concept_id:"33fe1d64-abb6-5198-b46a-81dd73d3bd14", kc_id:"33fe1d64-abb6-5198-b46a-81dd73d3bd14", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Applied Marketing Knowledge: Discussion Questions, task 4. Learner task: What segmentation tools do you have at your disposal when marketing in a B2B setting? Are there challenges associated with using social media platforms in marketing to other businesses rather than individual consumers? If so, one of these challenges might be that members of the buying center are more experienced and less emotional purchasers. Can you identify additional challenges?", label:"Ch. 4 Discussion Questions, task 4: What segmentation tools do you have at your disposal when marketing in a B2B setting", canonical_key:"ch_4_discussion_questions_task_4_what_segmentati", status:"approved"}}, {concept_id:"2f43c16b-30e8-58ea-a4b5-9a2faa246272", kc_id:"2f43c16b-30e8-58ea-a4b5-9a2faa246272", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Applied Marketing Knowledge: Discussion Questions, task 5. Learner task: City, county, state, and federal governments are heavily engaged in the B2B market. List one product each governmental entity might purchase directly from a producer/supplier.", label:"Ch. 4 Discussion Questions, task 5: City, county, state, and federal governments are heavily engaged in the B2B market", canonical_key:"ch_4_discussion_questions_task_5_city_county_sta", status:"approved"}}, {concept_id:"8276fe46-10c1-5947-bb3b-a77a18149d65", kc_id:"8276fe46-10c1-5947-bb3b-a77a18149d65", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Critical Thinking Exercises, task 1. Learner task: Compose a paragraph of 250–500 words using all of the following terms as they relate to B2B. The goal is to prove you understand the meaning of each term. Terms: business markets institutions business culture competitors internal factors gatekeeper deciders problem recognition buying center economic factors personal selling derived demand product specifications reseller performance review", label:"Ch. 4 Critical Thinking Exercises, task 1: Compose a paragraph of 250–500 words using all of the following terms as they relate…", canonical_key:"ch_4_critical_thinking_exercises_task_1_compose_", status:"approved"}}, {concept_id:"c924215b-562a-5f26-ba0f-41084e7b6bf2", kc_id:"c924215b-562a-5f26-ba0f-41084e7b6bf2", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Critical Thinking Exercises, task 2. Learner task: Explain the Foreign Corrupt Practices Act and why it is important as US businesses compete in the international marketplace.", label:"Ch. 4 Critical Thinking Exercises, task 2: Explain the Foreign Corrupt Practices Act and why it is important as US businesses…", canonical_key:"ch_4_critical_thinking_exercises_task_2_explain_", status:"approved"}}, {concept_id:"49609a71-b8d7-520d-8379-0251985c8b55", kc_id:"49609a71-b8d7-520d-8379-0251985c8b55", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Critical Thinking Exercises, task 3. Learner task: Tesla is building a 10 million square-foot “Gigafactory” (https://openstax.org/r/teslagigafactory) in Nevada. While Tesla didn’t rely on systems selling in building the manufacturing facility, the company did contract with many suppliers, such as Anning-Johnson (https://openstax.org/r/projecttesla), to provide vital elements such as decking. For Tesla, this was a new task situation. List the various phases Tesla went through to arrive at the construction and operation of this lithium-ion battery Gigafactory.", label:"Ch. 4 Critical Thinking Exercises, task 3: Tesla is building a 10 million square-foot “Gigafactory”…", canonical_key:"ch_4_critical_thinking_exercises_task_3_tesla_is", status:"approved"}}, {concept_id:"a9754622-7d95-59df-995f-f33251618ffc", kc_id:"a9754622-7d95-59df-995f-f33251618ffc", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"create", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Building Your Personal Brand, task 1. Learner task: Your personal brand is the skills and talents you bring to future employers or to your own business. Think about how businesses market to other businesses. How can you adopt some of those same marketing techniques and develop a plan to market yourself for an internship or employment? Visit LinkedIn, and look at the profiles of a handful of marketing managers. Examine how each marketing manager depicts their brand within their profile. What do they say about themselves that’s unique? Now write a one-page summary of your brand.", label:"Ch. 4 Building Your Personal Brand, task 1: Your personal brand is the skills and talents you bring to future employers or to your…", canonical_key:"ch_4_building_your_personal_brand_task_1_your_pe", status:"approved"}}, {concept_id:"93826e5e-f2f9-503e-9b52-cf3aea29493a", kc_id:"93826e5e-f2f9-503e-9b52-cf3aea29493a", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"analyze", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, What Do Marketers Do?, task 1. Learner task: Utilize LinkedIn to find brand managers in your geographic area, and invite one or more to connect with you. It’s best to go beyond the suggested LinkedIn request message and be more inviting and clearer on why you are reaching out to them. Once linked, “interview” the professional by asking questions. A few questions to begin with might be: Was there a particular class in college that resonated with you and your career goals? How did you find your first internship? Do you have suggestions that can help me improve my LinkedIn profile? Additional questions may explore their education, their experience, their career goals, and how they spend their days and weeks.", label:"Ch. 4 What Do Marketers Do?, task 1: Utilize LinkedIn to find brand managers in your geographic area, and invite one or…", canonical_key:"ch_4_what_do_marketers_do_task_1_utilize_linkedi", status:"approved"}}, {concept_id:"a71b5a9e-f714-5046-8bda-15b6f0792fe5", kc_id:"a71b5a9e-f714-5046-8bda-15b6f0792fe5", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Closing Company Case, task 1. Case context: Corporate Medical Services Corporate Medical Services (CMS) was established in Tennessee on October 1, 1995, with one person, one computer, and one client.28 The company was started with the goal of providing Department of Transportation (DOT) customers with a resource to meet new drug testing requirements. “The…. Learner task: Unrivaled Experience “CMS has been helping companies manage the complexities of regulations and requirements for over 25 years. During that time, we have helped over 15,000 companies significantly reduce the hassle of managing their drug testing programs.”", label:"Ch. 4 Closing Company Case, task 1: Unrivaled Experience “CMS has been helping companies manage the complexities of…", canonical_key:"ch_4_closing_company_case_task_1_unrivaled_exper", status:"approved"}}, {concept_id:"61c2f80a-f812-5db0-92ca-3639f0930a14", kc_id:"61c2f80a-f812-5db0-92ca-3639f0930a14", properties:{course_id:"8a9fefac-e5b9-49dd-935c-88cfd1929e26", bloom_level:"evaluate", updated_at:datetime('2026-09-20T10:16:37.749Z'), level:"atomic_concept", concept_type:"method", definition:"Source assessment in chapter 4, Closing Company Case, task 2. Case context: Corporate Medical Services Corporate Medical Services (CMS) was established in Tennessee on October 1, 1995, with one person, one computer, and one client.28 The company was started with the goal of providing Department of Transportation (DOT) customers with a resource to meet new drug testing requirements. “The…. Learner task: Concierge Level Personal Service “Concierge level service is not a term frequently used in our industry, but we believe in it and actively demonstrate it to our clients daily. When you are miles from home and need support, it’s what you want. It is always a good day at CMS, and we hope to make your day better by helping you in any way we can.”", label:"Ch. 4 Closing Company Case, task 2: Concierge Level Personal Service “Concierge level service is not a term frequently…", canonical_key:"ch_4_closing_company_case_task_2_concierge_level", status:"approved"}}] AS row
