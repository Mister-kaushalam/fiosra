# Environment Configuration Template for Fiosra MVP

# App Settings
APP_NAME="Fiosra Reasoning Infrastructure"
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-token-key

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL 16 with pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fiosra_db

# Neo4j 5 (Concept Graph & Misconception Hierarchy)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fiosra_neo4j_password

# LiteLLM provider configuration
# Default is deterministic. Set FIOSRA_LLM_PROVIDER to openrouter, openai, gemini,
# or ollama only after configuring the corresponding server-side credential/runtime.
FIOSRA_LLM_PROVIDER=deterministic
FIOSRA_LLM_FAILURES_BEFORE_COOLDOWN=3
FIOSRA_LLM_COOLDOWN_SECONDS=60
# Proactive question policy. These limits are enforced server-side after a
# document save; the browser cannot widen, advance, or bypass them.
FIOSRA_PROBE_QUIET_SECONDS=5
FIOSRA_PROBE_MIN_MATERIAL_CHARACTERS=100
FIOSRA_PROBE_SESSION_BUDGET=6
FIOSRA_PROBE_COOLDOWN_SECONDS=90
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Model strings use LiteLLM's `openrouter/` prefix. This free model supports
# high-quality structured authoring responses.
OPENROUTER_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_API_KEY=your_openai_api_key_here
# Optional for an OpenAI-compatible proxy endpoint rather than api.openai.com.
OPENAI_API_BASE=
# Default for brief, structured, answer-blind Socratic turns. Move to
# gpt-4.1-mini only when higher-quality generation is required.
OPENAI_MODEL=gpt-4.1-nano
OPENAI_TIMEOUT_SECONDS=30
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-2.5-flash
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.2
# Local structured-generation requests need a larger budget than hosted calls.
OLLAMA_TIMEOUT_SECONDS=150
# Free OpenRouter routes can queue before generating a structured authoring draft.
OPENROUTER_TIMEOUT_SECONDS=90
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Verifier Settings
ENABLE_MATH_CAS=true
ENABLE_NLI_VERIFIER=false
DEFAULT_MAX_HINT_LEVEL=3
